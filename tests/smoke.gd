	_check(sim.dot_stacks("poison", false) == int(Data.DOTS["poison"]["stacks"]) and is_equal_approx(sim.dot_seconds("poison", false), float(Data.DOTS["poison"]["s"])), "the overalls shaped the poison on you too")
