	_check(range(5).all(func(c): return yt.tile("bunkhouse", c, "b")["look"] == "shut" and yt.tile("bunkhouse", c, "b")["stub"]) and yt._tiles[1][0]["state"].text == Words.REPEAT["stub"], "the Bunkhouse's line B tiles: '%s'" % yt._tiles[1][0]["state"].text)
