## Over the cap (12 Oct, docs/design/over_the_cap.md): a resist past 75 is its element's damage, a point a point, to
## 50; all resists count; physical never; the Water cannon soaks it; the new lines roll where they should.
func _over_cap_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	for s in Data.SLOTS:
		sim.equipped[s] = null
	sim.equipped["Primary"] = sim._plain("Primary", "Army SMG")
	var inc0: float = sim.increased("fire")
	var coat: Dictionary = sim._plain("Armour", "Stab vest")
	coat["affixes"] = [{"stat": "fire_res", "value": 60}]
	var hat: Dictionary = sim._plain("Helmet", "Hard hat")
	hat["affixes"] = [{"stat": "fire_res", "value": 50}]
	sim._stats_dirty()
	sim.equipped["Armour"] = coat
	sim.equipped["Helmet"] = hat
	_check(is_equal_approx(sim.resist("fire"), 0.75) and is_equal_approx(sim.resist_raw("fire"), 110.0) and is_equal_approx(sim.over_cap("fire"), 35.0), "110 fire resist is not 75%% and 35 over: %.2f / %.0f" % [sim.resist("fire"), sim.over_cap("fire")])
	_check(is_equal_approx(sim.increased("fire") - inc0, 35.0), "35 over the cap is not +35%% fire: +%.0f" % (sim.increased("fire") - inc0))
	hat["affixes"] = [{"stat": "fire_res", "value": 200}]
	sim._stats_dirty()
	_check(is_equal_approx(sim.over_cap("fire"), Data.OVER_CAP), "over the cap is not held at %d" % int(Data.OVER_CAP))
	hat["affixes"] = [{"stat": "all_res", "value": 80}]
	sim._stats_dirty()
	coat["affixes"] = []
	sim._stats_dirty()
	_check(is_equal_approx(sim.over_cap("frost"), 5.0) and is_equal_approx(sim.over_cap("poison"), 5.0) and sim.over_cap("physical") == 0.0, "all resists did not go over the cap on each, or physical did")
	hat["affixes"] = [{"stat": "fire_proofed", "value": 20}]
	sim._stats_dirty()
	_check(is_equal_approx(sim.resist("fire"), 0.2) and is_equal_approx(sim.increased("fire") - inc0, 20.0), "the -proofed line is not resist and damage")
	# the Water cannon: a run's resists down
	sim.equipped["Charm"] = Items.roll_unique(sim._unique_named("A Blue Plaque"), sim.rng)
	coat["affixes"] = [{"stat": "fire_res", "value": 100}]
	_check(sim.over_cap("fire") == 0.0, "the Blue Plaque went over the cap")
	sim.equipped["Charm"] = null
	coat["affixes"] = []
	hat["affixes"] = [{"stat": "fire_res", "value": 100}]
	sim.hp = sim.max_hp()
	sim.words[3] = []
	sim.deploy(3)
	_check(sim.mission != null, "the over-the-cap run did not set off")
	if sim.mission == null:
		sim.load_dict(saved)
		return
	sim.mission["t"]["soaked"] = 0.3
	sim._dry_memo.clear()                 # the run's memo read the resists at the gate
	_check(is_equal_approx(sim.resist_raw("fire"), 70.0) and is_equal_approx(sim.resist("fire"), 0.7) and sim.over_cap("fire") == 0.0, "soaked did not take 30 off: %.0f" % sim.resist_raw("fire"))
	sim.extract_now()
	_check(sim.word_words("Water cannon", 1)[0].contains("your resist"), "the Water cannon's bite has no words: %s" % str(sim.word_words("Water cannon", 1)))
	# where the lines roll
	var on := func(slot: String, stat: String) -> bool: return Items.allowed_affixes(slot).any(func(a): return a["stat"] == stat)
	_check(on.call("Rig", "fire_res") and on.call("Rig", "all_res") and on.call("Armour", "fire_proofed") and on.call("Helmet", "bleed_proofed") and not on.call("Charm", "fire_proofed") and not on.call("Primary", "fire_proofed"), "the resists or the -proofed lines roll in the wrong slots")
	# every element tree's notable over the cap, and Knuckles' armour one
	for et in Data.ELEMENT_TREES:
		var want: String = "thick_skinned" if et["element"] == "physical" else "proof_" + str(et["element"])
		_check(et["nodes"].any(func(n): return n["effect"] == want and int(n.get("col", 0)) == 5 and int(n.get("row", 0)) == 1), "%s has no over-the-cap node" % et["name"])
	sim.load_dict(saved)
	print("over the cap ok: 110 is 75 and +35, held at 50, all resists, never physical, -proofed, soaked, the lines' slots, the six nodes")


## Guard (12 Oct, docs/design/shields.md): their fire comes off Guard first; the cap; the Paramedic's overheal and a
## med's overflow; each class's node at its moment; Transfusion fills it; gone at the extract.
func _guard_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	for s in Data.SLOTS:
		sim.equipped[s] = null
	sim.equipped["Primary"] = sim._plain("Primary", "Army SMG")
	_set_cls(sim, "Doorman")
	sim.respec()
	sim.tree = []                    # the Pitch's too: a respec keeps the camp's (21 Oct), the fixture wants it bare
	sim.words[3] = []
	sim.hp = sim.max_hp()
	sim.deploy(3)
	var m: Dictionary = sim.mission
	_check(sim.guard() == 0.0 and is_equal_approx(sim.guard_cap(), sim.max_hp() * Data.GUARD_SHARE), "a bare Doorman starts with Guard, or its cap is off: %.0f of %.0f" % [sim.guard(), sim.guard_cap()])
	sim._guard_add(m, 1000000.0)
	_check(is_equal_approx(sim.guard(), sim.guard_cap()), "Guard went past its cap")
	m["guard"] = 50.0
	var hp0: float = sim.hp
	sim._take(m, 10.0)
	_check(is_equal_approx(sim.guard(), 40.0) and is_equal_approx(sim.hp, hp0), "Guard did not take the hit first")
	sim._take(m, 100.0)
	_check(sim.guard() == 0.0 and is_equal_approx(sim.hp, hp0 - 60.0), "what Guard couldn't take did not come off HP: %.0f" % (hp0 - sim.hp))
	sim.hp = sim.max_hp()
	sim._heal(m, 30.0)
	_check(sim.guard() == 0.0, "a Doorman's overflow became Guard")
	sim._heal(m, 30.0, true, 0.5)
	_check(is_equal_approx(sim.guard(), 15.0), "a med's overflow line did not make Guard: %.0f" % sim.guard())
	# the class nodes, at their moments
	var node_id := func(_tree_name: String, effect: String) -> String:     # by effect, in whichever class tree the web put it (3 Nov)
		for t in Data.TREES:
			for k in range(t["nodes"].size()):
				if t["nodes"][k]["effect"] == effect:
					return "%s/%d" % [t["name"], k]
		return ""
	m["guard"] = 0.0
	sim.tree.append(node_id.call("The door", "squared_up"))
	_check(sim.has_node("squared_up"), "Squared up did not take")
	sim._gang_arrives(m)
	_check(is_equal_approx(sim.guard(), minf(sim.guard_cap(), sim.max_hp() * 0.15)), "Squared up gave %.0f, not 15%% of max HP to the cap" % sim.guard())
	m["guard"] = 0.0
	var coat: Dictionary = sim._plain("Armour", "Stab vest")
	coat["affixes"] = [{"stat": "guard_gang", "value": 8}]
	sim.equipped["Armour"] = coat
	sim._gang_arrives(m)
	_check(is_equal_approx(sim.guard(), minf(sim.guard_cap(), sim.max_hp() * 0.23)), "Squared up and the guard line did not add to the cap: %.0f" % sim.guard())
	sim.extract_now()
	sim.equipped["Armour"] = null
	sim.tree.erase(node_id.call("The door", "squared_up"))
	sim.hp = sim.max_hp()
	sim.deploy(3)
	_check(sim.mission != null and sim.guard() == 0.0, "the next run started with Guard")
	if sim.mission != null:
		sim.extract_now()
	# the other three classes' nodes at their moments, through the run's own code
	for cd in [["Poacher", "Stalking", "in_the_hide"], ["Scrapper", "Stripping", "sheet_metal"], ["Drifter", "Moving on", "breather"]]:
		_set_cls(sim, cd[0])
		sim.tree.append(node_id.call(cd[1], cd[2]))
		_check(sim.has_node(cd[2]), "%s did not take" % cd[2])
		sim.hp = sim.max_hp()
		sim.deploy(3)
		if sim.mission == null:
			_check(false, "the %s run did not set off" % cd[2])
			continue
		m = sim.mission
		m["guard"] = 0.0
		match cd[2]:
			"in_the_hide":
				m["fresh"] = true
				m["remaining"] = 3
				m["target_hp"] = -1.0
			_:
				m["remaining"] = 0
				m["target_hp"] = 0.0
				m["cleared"] = true
				m["search"] = sim.search_s(m["t"])
		sim.advance(0.05)
		_check(sim.guard() > 0.0, "%s gave no Guard at its moment" % cd[2])
		sim.extract_now()
		sim.tree.erase(node_id.call(cd[1], cd[2]))
	sim.load_dict(saved)
	saved = sim.to_dict()
	_set_cls(sim, "Paramedic")
	sim.respec()
	sim.tree = []                    # the Pitch's too: a respec keeps the camp's (21 Oct), the fixture wants it bare
	for s_ in Data.SLOTS:
		sim.equipped[s_] = null                 # a bare runner: no Guard line on the kit (they roll now)
	sim.equipped["Primary"] = sim._plain("Primary", "Army SMG")
	sim.words[3] = []
	sim.hp = sim.max_hp()
	sim.deploy(3)
	m = sim.mission
	m["guard"] = 0.0
	var half: float = sim.guard_cap() * 0.5
	sim._heal(m, half)
	_check(is_equal_approx(sim.guard(), half), "the Paramedic's overheal did not make Guard: %.0f of %.0f" % [sim.guard(), half])
	sim.tree.append(node_id.call("Shifts", "overtime"))
	_check(is_equal_approx(sim.guard_cap(), sim.max_hp() * Data.GUARD_SHARE * 1.5), "Overtime did not grow Guard's cap by half")
	sim.tree.erase(node_id.call("Shifts", "overtime"))
	sim.tree.append(node_id.call("Shifts", "cap_transfusion"))
	_check(sim.has_node("cap_transfusion") and is_equal_approx(sim.guard_cap(), sim.max_hp() * Data.GUARD_SHARE * 2.0), "Transfusion did not double Guard's cap")
	m["using"] = {"name": "Bandage", "left": 0.0, "heal": 5.0}
	sim._patch(m, 0.1)
	_check(is_equal_approx(sim.guard(), sim.guard_cap()), "Transfusion's med did not fill Guard to the top: %.0f of %.0f" % [sim.guard(), sim.guard_cap()])
	# what Guard takes is Guard's on the run screen, not red: the red figures count only what reached HP
	var taken0: float = float(m.get("taken", 0.0))
	var by0: float = 0.0
	for ty in m.get("taken_by", {}):
		by0 += float(m["taken_by"][ty])
	m["t"]["dps"] = 1.0
	m["remaining"] = maxi(1, int(m["remaining"]))
	sim.advance(1.0)
	var by1: float = 0.0
	for ty in m.get("taken_by", {}):
		by1 += float(m["taken_by"][ty])
	_check(sim.mission == null or (float(m.get("guarded", 0.0)) > 0.0 and absf((by1 - by0) - (float(m.get("taken", 0.0)) - taken0)) < 0.5), "Guard's share went into the red figures: by type +%.1f, to HP +%.1f, guarded %.1f" % [by1 - by0, float(m.get("taken", 0.0)) - taken0, float(m.get("guarded", 0.0))])
	# the Stats sheet says where Guard comes from, in its colour
	main.show_room(main.RUNNER)
	main.refresh()
	var gnote: Label = main._stats.cards["defence"]["note"]
	_check(gnote.text.begins_with("Guard ") and gnote.text.contains("overheal"), "the Stats sheet's defence does not say where Guard comes from: '%s'" % gnote.text)
	_check_fit(main, "Stats (Guard)")
	if sim.mission != null:
		sim.extract_now()
	sim.load_dict(saved)
	print("Guard ok: first off Guard, the cap, overheal and a med's overflow, Squared up, Transfusion's cap, gone at the extract")


## Uniques by tier (12 Oct, docs/design/uniques.md): every unique but the paper has a band and a range; it rolls held
## inside its range on its slot's best base there, name, rule and art kept; a higher copy beats a lower; the melee
## secondary past the Cosh is lifted; the bands pick by tier; the shelf keeps the best tier; the mate's offer has one;
## the four gap uniques' rules.
func _unique_tier_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	for u in Data.UNIQUES:
		if u["slot"] == Data.PAPER:
			_check(not u.has("range"), "the paper has a range")
			continue
		_check(u.has("range") and Data.UNIQUE_BAND_WEIGHT.has(str(u.get("band", ""))), "%s has no band or range" % u["name"])
		var lo: int = int(u["range"][0])
		var hi: int = int(u["range"][1])
		var low: Dictionary = Items.roll_unique(u, sim.rng, -1, 1)
		var high: Dictionary = Items.roll_unique(u, sim.rng, -1, 99)
		_check(int(low["tier"]) == lo and int(high["tier"]) == hi, "%s did not hold inside %d-%d: T%d / T%d" % [u["name"], lo, hi, int(low["tier"]), int(high["tier"])])
		_check(low["unique"] == u["name"] and high["unique"] == u["name"] and high["rule"] == u["rule"] and Items.full_name(high) == u["name"], "%s lost its name or rule at its top" % u["name"])
		_check(Items.base_of(high).get("type", "") == Items.base_named(u["slot"], u["base"]).get("type", ""), "%s changed its gun type at its top: %s" % [u["name"], high["base"]])
		for k in high["attachments"]:
			_check(str(k).begins_with("socket") or str(k) in Items.base_of(high).get("attachments", []), "%s has a mount its body hasn't: %s on %s" % [u["name"], k, high["base"]])
		if hi > lo:
			_check(Items.score(high) > Items.score(low), "%s at T%d does not beat itself at T%d: %.1f vs %.1f" % [u["name"], hi, lo, Items.score(high), Items.score(low)])
	# the sign past the melee secondaries' top (T4 since the itemisation, 29 Oct): still a blade or a bar, lifted to the slot's curve
	var sgn: Dictionary = sim._unique_named("The Lollipop Lady's Sign")
	var s4: Dictionary = Items.roll_unique(sgn, sim.rng, -1, 5)
	var s9: Dictionary = Items.roll_unique(sgn, sim.rng, -1, 9)
	var mel_top := 0
	for b in Data.BASES["Secondary"]:
		if str(b.get("type", "")) == "melee":
			mel_top = maxi(mel_top, int(b["tier"]))
	_check(str(Items.base_of(s9).get("type", "")) == "melee" and int(Items.base_named("Secondary", s9["base"])["tier"]) == mel_top and float(s9.get("lift", 1.0)) > float(s4.get("lift", 1.0)) and float(s4.get("lift", 1.0)) > 1.0 and Items.dps(s9) > Items.dps(s4), "the sign is not a lifted top blade: %s ×%.2f" % [s9["base"], float(s9.get("lift", 1.0))])
	# a worn copy and a better one: the better reads as an upgrade
	for s in Data.SLOTS:
		sim.equipped[s] = null
	var steel: Dictionary = sim._unique_named("The Butcher's Steel")
	sim.equipped["Primary"] = Items.roll_unique(steel, sim.rng, -1, 4)
	var better: Dictionary = Items.roll_unique(steel, sim.rng, -1, 9)
	_check(sim.compare(better) == 1, "a T9 steel does not read better than the T4 worn")
	# the bands: a levelling one never at T9, a chase one never at T2, the levelling ones most at T3
	var loose: Array = sim.loose_uniques(99)
	var by_band := {"levelling": 0, "core": 0, "chase": 0}
	for k in range(300):
		var at9: Dictionary = sim.pick_unique(loose, 9)
		_check(at9.is_empty() or str(at9["band"]) != "levelling", "a levelling unique came at T9: %s" % at9.get("name", ""))
		var at2: Dictionary = sim.pick_unique(loose, 2)
		_check(not at2.is_empty() and str(at2["band"]) == "levelling", "a %s unique came at T2: %s" % [str(at2.get("band", "")), at2.get("name", "")])
		var at4: Dictionary = sim.pick_unique(loose, 3)     # T3 since the itemisation (29 Oct): the levelling ones' top
		by_band[str(at4["band"])] += 1
	_check(by_band["levelling"] > by_band["core"] and by_band["chase"] == 0, "the bands' weights did not pick at T3: %s" % str(by_band))
	_check(sim.pick_unique(loose, 0).is_empty() and not sim.pick_unique(loose, 0, true).is_empty(), "a find outside every range dropped one, or a shop came up empty")
	# the shelf keeps the best tier found, through a save
	var hold_shelf: Array = sim.shelf.duplicate()
	sim.shelf = []
	sim.shelf_tier = {}
	sim._read(Items.roll_unique(steel, sim.rng, -1, 7))
	sim._read(Items.roll_unique(steel, sim.rng, -1, 5))
	_check(int(sim.shelf_tier.get(steel["name"], 0)) == 7, "the shelf did not keep the best tier: %s" % str(sim.shelf_tier))
	var round_trip = Sim.new()
	round_trip.start()
	round_trip.load_dict(sim.to_dict())
	_check(int(round_trip.shelf_tier.get(steel["name"], 0)) == 7, "the shelf's tiers did not save")
	# the mate: an offer with a tier, and what he sells is that tier
	sim.mate = sim.roll_mate()
	_check(sim.mate.has("tier") and int(sim.mate["notes"]) == Data.MATE_NOTES * int(sim.mate["tier"]), "the mate's offer has no tier: %s" % str(sim.mate))
	_check(int(sim._mate_item()["tier"]) == int(sim.mate["tier"]), "the mate's unique is not the tier he offered")
	sim.mate = {"unique": "Lucky Cap", "notes": 400}      # a save from before the tiers
	_check(int(sim._mate_item()["tier"]) == 1, "an old mate's offer did not roll at its own base's tier")
	sim.shelf = hold_shelf
	# the four gaps' rules
	var t: Dictionary = sim.effective(3)
	var search0: float = sim.search_s(t)
	sim.equipped["Helmet"] = Items.roll_unique(sim._unique_named("The Miner's Lamp"), sim.rng)
	_check(sim.search_s(t) < search0 * 0.5 + 0.01, "the Miner's Lamp did not halve the search: %.1f vs %.1f" % [sim.search_s(t), search0])
	sim.equipped["Helmet"] = null
	var med: Dictionary = sim._plain(Data.MEDICAL, Data.BASES[Data.MEDICAL][0]["name"])
	var heal0: float = sim.med_heal(med)
	var fire0: float = sim.dot_seconds("fire")
	var depth0: float = sim.dot_depth()
	sim.equipped["Rig"] = Items.roll_unique(sim._unique_named("The Paramedic's Bum Bag"), sim.rng)
	_check(is_equal_approx(sim.med_heal(med), heal0 * 1.5), "the Bumbag's meds do not heal half again: %.1f vs %.1f" % [sim.med_heal(med), heal0])
	sim.rig = [med.duplicate()]
	sim.words[3] = []                    # no Rationed on the site: the med is allowed
	sim.deploy(3)
	var m: Dictionary = sim.mission
	sim.hp = sim.max_hp() * 0.3
	sim.advance(0.1)
	_check(m["using"] != null or sim.rig.is_empty(), "the Bumbag did not use a med under 40%")
	sim.extract_now()
	sim.equipped["Rig"] = Items.roll_unique(sim._unique_named("The Plumber's Belt"), sim.rng)
	_check(is_equal_approx(sim.dot_seconds("fire"), fire0) and is_equal_approx(sim.dot_depth(), depth0 * 2.0) and is_equal_approx(sim.dot_depth(false), 1.0) and is_equal_approx(sim.status_s(1.0), 2.0), "the Plumber's Belt did not double a dot's depth and a chill's length, or slowed the dot: %.1f s, ×%.1f" % [sim.dot_seconds("fire"), sim.dot_depth()])
	sim.equipped["Rig"] = null
	sim.equipped["Secondary"] = Items.roll_unique(sim._unique_named("The Starting Pistol"), sim.rng)
	sim.rig = [_rmag(sim, "Pistol rounds")]
	sim.deploy(3)
	m = sim.mission
	m["target_hp"] = 100000.0
	sim._starting_shot(m, m["t"])
	var after: float = float(m["target_hp"])
	var shot: float = 100000.0 - after
	_check(shot > 0.0 and m.get("opened", false), "the Starting Pistol's first shot did not land")
	sim.advance(0.05)
	_check(after - float(m["target_hp"]) < shot, "the Starting Pistol fired its first shot twice: %.0f then %.0f" % [shot, after - float(m["target_hp"])])
	sim.extract_now()
	sim.load_dict(saved)
	print("uniques by tier ok: bands and ranges, held in range, the body's mounts, a higher copy better, the sign lifted, the bands by tier, the shelf's best, the mate's tier, the four new rules")


## Sets: pieces roll and have words, the count, the bonuses at two and the
## full set, the rules, the drop by depth, the tint and the panel's line.
func _set_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	for st in Data.SETS:
		for p in st["pieces"]:
			var it := Items.roll_set_piece(st["name"], p, sim.rng)
			_check(it["set"] == st["name"] and it["piece"] == p["name"] and Items.full_name(it) == p["name"] and Words.item_words(p["name"]) != "", "%s does not roll as a piece with words" % p["name"])
			_check(load("res://scripts/ui/item_cell.gd").rarity_tone(it) == "set", "a set piece is not tinted")
	for s in Data.SLOTS:
		sim.equipped[s] = null
	sim.equipped["Primary"] = sim._plain("Primary", "Army SMG")
	var council: Dictionary = Items.set_named("The Council's")
	_check(sim.set_count("The Council's") == 0 and sim.set_bonuses().is_empty(), "a bare runner has set bonuses")
	sim.equipped["Armour"] = Items.roll_set_piece("The Council's", council["pieces"][0], sim.rng)
	sim.equipped["Helmet"] = Items.roll_set_piece("The Council's", council["pieces"][1], sim.rng)
	_check(sim.set_count("The Council's") == 2 and is_equal_approx(sim.set_stat("all_res"), 20.0) and sim.resist("fire") >= 0.2, "two of the Council's did not give all resists +20")
	_check(not sim.has_set_rule("council"), "the Council's rule came at two")
	sim.equipped["Backpack"] = Items.roll_set_piece("The Council's", council["pieces"][2], sim.rng)
	sim.equipped["Charm"] = Items.roll_set_piece("The Council's", council["pieces"][3], sim.rng)
	_check(sim.set_count("The Council's") == 4 and sim.has_set_rule("council") and is_equal_approx(sim.set_stat("regen"), 1.0) and sim._affix_sum("search_pct") >= 30.0 + 8.0, "the full council's did not give it all: rule %s regen %.1f search %.0f" % [str(sim.has_set_rule("council")), sim.set_stat("regen"), sim._affix_sum("search_pct")])
	# the panel's line, in the set's tint
	main.show_room(main.ARMOURY)
	main._armoury._pick_slot("Armour")
	main.refresh()
	_check(main._armoury._head.text_nodes().any(func(r): return r.text.begins_with("The Council's · 4 of 4") or r.text == "4 of 4 worn"), "the panel's set chip is missing: %s" % str(main._armoury._head.text_nodes().map(func(r): return r.text)))
	_check_fit(main, "Armoury (a set)")
	# the Army's: contact down one, more ×1.3 at four
	for s in Data.SLOTS:
		sim.equipped[s] = null
	var army: Dictionary = Items.set_named("The Army's")
	sim.words[3] = []
	sim.weather[1] = ""                  # fog would take the one the set takes
	var t: Dictionary = sim.effective(3)
	var c0: int = sim.contact(t)
	for p in army["pieces"]:
		sim.equipped[p["slot"]] = Items.roll_set_piece("The Army's", p, sim.rng)
	_check(sim.contact(t) == c0 - 1 and is_equal_approx(sim.more("physical"), 1.3), "the Army's full set: contact %d of %d, more %.1f" % [sim.contact(t), c0, sim.more("physical")])
	# the Carpet Man's two: 30% bleed, bleeds last twice
	for s in Data.SLOTS:
		sim.equipped[s] = null
	sim.equipped["Primary"] = sim._plain("Primary", "Army SMG")
	var carpet: Dictionary = Items.set_named("The Carpet Man's")
	for p in carpet["pieces"]:
		sim.equipped[p["slot"]] = Items.roll_set_piece("The Carpet Man's", p, sim.rng)
	sim.rig = sim.rig.filter(func(x): return not Items.is_ammo(x) and not Items.is_mag(x))     # a graded box's conversion reads in through the gun; a loaded magazine's too (31 Oct: hollow point in the rig on another seed's camp)
	sim._dry_memo.clear()
	_check(is_equal_approx(sim.conversion()["bleed"], 0.3) and is_equal_approx(sim.dot_seconds("bleed"), 12.0), "the Carpet Man's: bleed %.2f seconds %.0f" % [sim.conversion()["bleed"], sim.dot_seconds("bleed")])
	# drops by depth: nothing at depth 1, pieces by depth 12, no army's before 15
	# (the Fire Crew's three at depth 9 join the count from 12 on)
	_check(sim.set_pieces_at(1).is_empty() and sim.set_pieces_at(5).size() == 6 and sim.set_pieces_at(12).size() == 15 and sim.set_pieces_at(15).size() == 19, "the sets' depth gates are off: %d / %d / %d / %d" % [sim.set_pieces_at(1).size(), sim.set_pieces_at(5).size(), sim.set_pieces_at(12).size(), sim.set_pieces_at(15).size()])
	sim.load_dict(saved)
	print("sets ok: the pieces, the count, the bonuses, the rules, the tint, the panel, the gates")
	_atlas_checks(main)


## The map: a point a new depth past the first, the passives, their effects.
func _atlas_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	_finish_campaign(sim)
	sim.atlas = {}
	sim.atlas_points = 0
	_open_map(main)
	_check(main._radio.view == "map" and main._radio._atlas.visible, "the map did not open on the Radio after the campaign")
	_check_fit(main, "Radio (the map, empty)")
	# a clear at depth 2 earns a point; depth 1 does not
	sim.set_depth(3, 1)
	var t1: Dictionary = sim.effective(3)
	sim.best_depth[3] = 0
	sim.deploy(3)
	sim._clear(sim.mission, t1)
	sim.extract_now()
	_check(sim.atlas_points == 0, "a depth-1 clear put a point on the map")
	sim.set_depth(3, 2)
	var t2: Dictionary = sim.effective(3)
	sim.deploy(3)
	sim._clear(sim.mission, t2)
	sim.extract_now()
	_check(sim.atlas_points == 1 and sim.atlas_free() == 1, "a depth-2 clear did not earn a point: %d" % sim.atlas_points)
	sim.deploy(3)
	sim._clear(sim.mission, t2)
	sim.extract_now()
	_check(sim.atlas_points == 1, "clearing the same depth again earned a point")
	# the ranks and their effects
	var patrol0: float = sim.patrol_s(t2)
	var search0: float = sim.search_s(t2)
	var cost0: int = sim.word_craft_cost(3, "retune")
	var notes0: int = sim.notes_a_kill(t2)
	# the Map's web (22 Oct): a region's entry is open, the rest by pathing - a branch's first node past a filler off
	# the entry; the other regions' nodes don't open on this one's points
	_check(sim.atlas_open("picked_over") and not sim.atlas_open("deeper_pockets") and not sim.atlas_open("quiet_roads") and not sim.can_rank_atlas("quiet_roads"), "the sites' branches are open with nothing ranked: '%s'" % sim.atlas_block("quiet_roads"))
	_check(sim.atlas_block("quiet_roads").begins_with("wants a path") and sim.atlas_path_next("quiet_roads") == Data.map_id("picked_over"), "the path hint to Quiet roads isn't the entry: '%s'" % sim.atlas_path_next("quiet_roads"))
	_check(sim.rank_atlas("picked_over") and sim.atlas_rank("picked_over") == 1, "a rank did not take")
	_check(not sim.rank_atlas("deeper_pockets"), "a rank took with no point free")
	sim.atlas_points += 10
	_check(not sim.atlas_open("heads_up") and sim.atlas_open("paid_in_notes"), "the crews' region reads the sites' ranks")
	var f_quiet: String = str(Data.map_node(sim.atlas_path_next("quiet_roads"))["key"])
	_check(Data.atlas_of(f_quiet).get("filler", false) and sim.rank_atlas(f_quiet) and sim.atlas_open("quiet_roads") and sim.rank_atlas("quiet_roads") and sim.atlas_rank("quiet_roads") == 1, "the branch did not open past its filler: %s" % f_quiet)
	_check(not sim.atlas_open("easy_pickings") and sim.atlas_open("second_look"), "the rich way opened off the quiet one, or the spine's next is shut")
	_check(sim.atlas_block("lie_of_the_land").begins_with("wants a path"), "the keystone's block isn't the path first: '%s'" % sim.atlas_block("lie_of_the_land"))
	var f_deep: String = str(Data.map_node(sim.atlas_path_next("deeper_pockets"))["key"])
	_check(Data.atlas_of(f_deep).get("filler", false) and sim.rank_atlas(f_deep) and sim.atlas_open("deeper_pockets") and sim.rank_atlas("deeper_pockets"), "the rich way did not open past its filler: %s" % f_deep)
	_check(is_equal_approx(sim.atlas_level("deeper_pockets"), 0.3) or is_equal_approx(sim.atlas_level("quiet_roads"), 1.3) or is_equal_approx(sim.atlas_level("easy_pickings"), 0.3) or is_equal_approx(sim.atlas_level("every_penny"), 0.3), "a filler's share did not read into its ranked node's figure: %s / %s" % [f_quiet, f_deep])
	_check(sim.patrol_s(t2) > patrol0 * 1.09, "Quiet roads did not slow the gangs")
	sim.atlas_points += 10
	for i in range(2):
		_rank_to(sim, "deeper_pockets")
	_check(sim.atlas_rank("deeper_pockets") == 3 and not sim.can_rank_atlas("deeper_pockets"), "Deeper pockets went past its max")
	_check(sim.search_s(t2) < search0 * 0.75, "Deeper pockets did not quicken searches")
	_check(_rank_to(sim, "good_reception") and sim.word_craft_cost(3, "retune") <= int(ceil(cost0 * 0.85)) and sim.word_craft_cost(3, "retune") < cost0 + 1, "Good reception did not cheapen the crafts: %d from %d" % [sim.word_craft_cost(3, "retune"), cost0])
	# a note more a kill - doubled by the Traffic Warden's Hat when the camp's kit is wearing it (17 Oct: the check read
	# +1 and failed whenever the smoke's earlier runs had left the hat on)
	var hat: int = int(Data.FX["rule/wardens_hat.notes"]) if sim.has_rule("wardens_hat") else 1
	_check(_rank_to(sim, "paid_in_notes") and sim.notes_a_kill(t2) == notes0 + hat, "Paid in notes did not add a note: %d from %d (the hat x%d)" % [sim.notes_a_kill(t2), notes0, hat])
	_check(_rank_to(sim, "two_of_everything"), "Two of everything did not take")
	# the boss drops two with it
	sim.notes += 1000
	sim.arm_boss(5, true)
	sim.set_depth(5, 1)
	sim.deploy(5)
	var m: Dictionary = sim.mission
	m["boss"] = {"name": sim.boss_of(5)["name"], "zone": 0, "alive": true, "hp": 1.0, "started": true}
	var found_before: int = m["found"].size() + m.get("floor", []).size()
	sim._boss_down(m, sim.effective(5))
	var drops_n: int = (m["found"] + m.get("floor", [])).filter(func(x): return not Items.is_mag(x) and not Items.is_material(x)).size()     # a head's gun brings its magazine too (30 Oct): the drops counted without them; his handful of material too (1 Nov: a pack item)
	_check(drops_n == found_before + 2, "Two of everything did not drop a second: %d" % (drops_n - found_before))
	sim.extract_now()
	_open_map(main)
	_check_fit(main, "Radio (the map, ranked)")
	_map_screen_checks(main)
	_site_level_checks(main)
	main._radio._reset_map()
	_check(sim.atlas_spent() == 0 and sim.atlas_free() == sim.atlas_points, "starting the map again did not refund")
	main._radio._pick_view("air")
	# the round trip keeps it
	sim.rank_atlas("picked_over")
	var pts_held: int = sim.atlas_points
	var d: Dictionary = sim.to_dict()
	sim.load_dict(d)
	_check(sim.atlas_rank("picked_over") == 1 and sim.atlas_points == pts_held, "the map did not survive a save")
	_map_nodes_checks(main)
	sim.load_dict(saved)
	print("the map ok: points, ranks, effects, two of everything, reset")
	_exchange_checks(main)


## The exchange (28 Oct, Matt: "contracts should be replaced by currency conversion - notes, tins, scrap with varying
## rates for each"): the Fence's third tab in the grid's place, a trade moving what the rate says, the spread both
## ways, a new day of rates every run home and the same rates all day, the Yard's Contacts and Fixer, notes off the
## board after the Issue, nothing on a run, the screen's buttons; the mate as before.
func _exchange_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	if not sim.room_open("fence"):
		_check(false, "the Fence was not open for the exchange's checks")
		return
	var saved: Dictionary = sim.to_dict()
	var fv = main._fence
	_yard_ids(sim, ["shopfront", "contacts"], "")
	_yard_ids(sim, ["back_room", "fixer"], "")
	_check(is_equal_approx(sim.exchange_spread(), Data.EXCHANGE_SPREAD) and is_equal_approx(sim.exchange_fixer(), 1.0), "the exchange's spread or Fixer is off without the picks: %.2f / %.2f" % [sim.exchange_spread(), sim.exchange_fixer()])
	var on: Array = sim.exchange_offered()
	_check(on.slice(0, 3) == ["tins", "notes", "scrap"], "the exchange's board does not start tins, notes, scrap: %s" % str(on))
	for k in sim.salvage_kinds():
		_check(on.has(k), "a salvage dug to its depth is not on the exchange: %s" % k)
	for k in sim.materials_met():
		_check(on.has(k), "a material met is not on the exchange: %s" % k)
	# the rules behind them pinned (28 Oct, the tools review: the loops above pass with none; the old contracts' checks
	# pinned these): the Outskirts alone give none, the Town's first at SALVAGE_DEPTH steel, a site cleared its material, the
	# rebuild open the fuses
	var pin: Dictionary = sim.to_dict()
	for i in range(sim.best_depth.size()):
		sim.best_depth[i] = 1 if i < 3 else 0
		sim.depth[i] = 1
	sim.salvage = {"copper": 0, "steel": 0, "army": 0}
	sim.materials = {}
	_check(sim.salvage_kinds().is_empty() and sim.materials_met().filter(func(m): return m != "fuses").all(func(m): return Data.SITE_MATERIAL.slice(0, 3).has(m)), "the Outskirts alone give salvage or another site's material: %s, %s" % [str(sim.salvage_kinds()), str(sim.materials_met())])
	var town_site: int = int(Data.ZONES[2]["tiers"][0])     # the Town's first: steel, ZONE_SALVAGE's
	var dug_d := 1
	sim.best_depth[town_site] = dug_d
	while sim.dug_depth(town_site) < Data.SALVAGE_DEPTH and dug_d < 40:
		_check(sim.salvage_kinds().is_empty(), "salvage drops dug %d, short of SALVAGE_DEPTH" % sim.dug_depth(town_site))
		dug_d += 1
		sim.best_depth[town_site] = dug_d
	_check(sim.salvage_kinds() == [Data.ZONE_SALVAGE[2]] and sim.exchange_offered().has(Data.ZONE_SALVAGE[2]), "dug %d at %s doesn't put %s on the exchange: %s" % [sim.dug_depth(town_site), Data.TIERS[town_site]["name"], Data.ZONE_SALVAGE[2], str(sim.salvage_kinds())])
	var mat_site: int = -1
	for i in range(3, mini(Data.SITE_MATERIAL.size(), sim.best_depth.size())):
		if str(Data.SITE_MATERIAL[i]) != "" and mat_site < 0:
			mat_site = i
	_check(mat_site >= 0, "the fixture: no site past the Outskirts gives a material")
	if mat_site >= 0:
		var mk: String = str(Data.SITE_MATERIAL[mat_site])
		_check(not sim.materials_met().has(mk) or Data.SITE_MATERIAL.slice(0, 3).has(mk), "a material on the board before its site's cleared: %s" % mk)
		sim.best_depth[mat_site] = 1
		_check(sim.materials_met().has(mk) and sim.exchange_offered().has(mk), "%s cleared doesn't put %s on the exchange" % [Data.TIERS[mat_site]["name"], mk])
	_check(sim.materials_met().has("fuses") == sim.rebuild_open(), "the fuses' place on the board doesn't follow the rebuild")
	sim.load_dict(pin)
	_check(Data.EXCHANGE_BASE.has("notes") and Data.SALVAGE.all(func(k): return Data.EXCHANGE_BASE.has(k)) and Data.MATERIAL_ORDER.all(func(k): return Data.EXCHANGE_BASE.has(k)), "a currency has no base worth on the exchange")
	# a rate: worth over worth, less the spread; the worth by the day's prices and its drift
	var w_notes: float = sim.exchange_worth("notes")
	_check(is_equal_approx(w_notes, Data.NOTE_TINS * sim.inflation() * sim.exchange_drift("notes")), "a note's worth on the exchange is off: %.2f" % w_notes)
	_check(is_equal_approx(sim.exchange_rate("notes", "tins"), Data.NOTE_TINS * sim.inflation() * minf(1.0, sim.exchange_drift("notes")) * (1.0 - Data.EXCHANGE_SPREAD)), "the notes-to-tins rate is not the worth (its drift only against you) less the spread: %.4f" % sim.exchange_rate("notes", "tins"))
	# notes to tins, and tins to scrap: exactly what the rate says, rounded down
	sim.notes = 120
	sim.cash = 100000.0
	sim.scrap = 0
	var r_nt: float = sim.exchange_rate("notes", "tins")
	var want_t: int = int(floor(120 * r_nt))
	var cash0: float = sim.cash
	_check(sim.exchange("notes", "tins", 120) and sim.notes == 0 and sim.cash == cash0 + want_t, "120 notes to tins did not get %d: notes %d, tins +%.0f" % [want_t, sim.notes, sim.cash - cash0])
	var r_ts: float = sim.exchange_rate("tins", "scrap")
	var want_s: int = int(floor(1000 * r_ts))
	cash0 = sim.cash
	_check(sim.exchange("tins", "scrap", 1000) and sim.scrap == want_s and sim.cash == cash0 - 1000.0, "1,000 tins to scrap did not get %d: scrap %d, tins %.0f" % [want_s, sim.scrap, sim.cash - cash0])
	_check(not sim.exchange("notes", "tins", 1) and sim.exchange_block("notes", "tins", 1) != "", "a trade took notes not held")
	_check(not sim.exchange("tins", "tins", 10) and not sim.exchange("notes", "tins", 0), "a trade took with the same currency both sides, or nothing given")
	_check(not sim.can_exchange("tins", "notes", 1) and sim.exchange_get("tins", "notes", 1) == 0, "a tin bought a note")
	# scrap buy-only (28 Oct, Matt, the review's A1: scrapped with Strip for parts and Salvage and sold it beat the Fence
	# 2.8x, and the Clinic's shelf was a pump): bought, never given - nothing on the board takes it
	var s0: int = sim.scrap
	cash0 = sim.cash
	_check(s0 > 0 and not sim.exchange_gives().has("scrap") and sim.exchange_offered().has("scrap"), "scrap is offered as a give, or not to buy: gives %s" % str(sim.exchange_gives()))
	for c in sim.exchange_offered():
		_check(sim.exchange_rate("scrap", c) == 0.0 and sim.exchange_get("scrap", c, s0) == 0 and not sim.exchange("scrap", c, s0), "scrap sold for %s" % c)
	_check(sim.scrap == s0 and sim.cash == cash0 and sim.exchange_block("scrap", "tins", s0).contains("never sold"), "a scrap trade moved something, or says '%s'" % sim.exchange_block("scrap", "tins", s0))
	# a scrap-then-exchange loop can't make money: with every boost on (Strip for parts, Salvage, Contacts, the Fixer),
	# the Clinic's dearest med bought, scrapped, and its scrap can't come back as tins or anything that sells
	var loop_was: Dictionary = sim.to_dict()
	sim.unlock_all()
	sim.yard_picks["fence"] = ["", "b", "b", "", ""]
	sim._yard_dirty = true
	var bench_sides: Array = sim.yard_picks.get("bench", ["", "", "", "", ""]).duplicate()
	for c in range(Data.yard_building("bench")["picks"].size()):
		for k in range(2):
			if str(Data.yard_building("bench")["picks"][c][k]["id"]) == "strip_for_parts" and not str(bench_sides[c]).contains("a" if k == 0 else "b"):
				bench_sides[c] = str(bench_sides[c]) + ("a" if k == 0 else "b")
	sim.yard_picks["bench"] = bench_sides
	sim._yard_dirty = true
	_set_cls(sim, "Scrapper")
	var sal_id: String = Data.node_id_named("Stripping/Salvage")
	if not sim.tree.has(sal_id):
		sim.tree.append(sal_id)
	sim._rules_key = []
	_check(sim.has_node("salvage"), "the fixture: Salvage isn't on")
	_check(sim.yard_has("strip_for_parts") and sim.yard_has("contacts") and sim.yard_has("fixer"), "the fixture: the boosts aren't built")
	sim.cash = 1e6
	sim.scrap = 0
	while not sim.stash_room(4) and not sim.stash.is_empty():
		sim.stash.pop_back()
	sim._restock_clinic()
	var dear: Dictionary = {}
	for it in sim.clinic:
		if dear.is_empty() or sim.clinic_price(it) > sim.clinic_price(dear):
			dear = it
	var spent: int = sim.clinic_price(dear)
	var cash_l0: float = sim.cash
	var bought_ok: bool = not dear.is_empty() and sim.buy_clinic(int(dear["id"]))
	var scrapped_ok: bool = bought_ok and sim.scrap_item(int(dear["id"]))
	if scrapped_ok and sim.scrap == 0:
		var suit: Dictionary = sim._plain("Armour", "Riot suit")     # her shelf this low gives no scrap: a dearer piece's
		sim.stash.append(suit)
		scrapped_ok = sim.scrap_item(int(suit["id"]))
	_check(scrapped_ok and sim.scrap > 0, "the fixture: her dearest med not bought (%s) and scrapped (%s): %d on her shelf, clinic %s, workshop %s, scrap %d" % [str(bought_ok), str(scrapped_ok), sim.clinic.size(), str(sim.room_open("clinic")), str(sim.room_open("workshop")), sim.scrap])
	var best_back := 0
	for c in sim.exchange_offered():
		best_back = maxi(best_back, sim.exchange_get("scrap", c, sim.scrap))
	_check(best_back == 0 and sim.cash == cash_l0 - spent and sim.exchange_get("scrap", "tins", sim.scrap) * 1 <= 0, "scrap from her %s (%d tins) came back as %d of something" % [dear["base"], spent, best_back])
	sim.load_dict(loop_was)
	sim.notes = 100
	cash0 = sim.cash
	sim.exchange("notes", "tins", 100)
	sim.exchange("tins", "notes", int(sim.cash - cash0))
	_check(sim.notes < 100, "a round trip notes-tins-notes did not lose the spread: %d from 100" % sim.notes)
	# salvage and the materials trade too
	var sv_k: String = Data.SALVAGE[0]
	sim.salvage[sv_k] = 1
	_check(sim.exchange_offered().has(sv_k), "a salvage held is not on the exchange")
	var sv0: int = int(sim.salvage[sv_k])
	var want_sv: int = sim.exchange_get("tins", sv_k, 5000)
	_check(want_sv > 0 and sim.exchange("tins", sv_k, 5000) and int(sim.salvage[sv_k]) == sv0 + want_sv, "tins to %s did not pay %d" % [sv_k, want_sv])
	var mat_k: String = Data.MATERIAL_ORDER[0]
	sim.materials[mat_k] = int(sim.materials.get(mat_k, 0)) + 3
	var m0: int = sim.held_of(mat_k)
	cash0 = sim.cash
	var want_m: int = sim.exchange_get(mat_k, "tins", 3)
	_check(sim.exchange(mat_k, "tins", 3) and sim.held_of(mat_k) == m0 - 3 and sim.cash == cash0 + want_m, "3 %s to tins did not get %d" % [mat_k, want_m])
	# the day's rates: the same all day (a save keeps the day), new after a run home; a drift inside its band
	var day0: int = sim.exchange_day
	var drifts0: Dictionary = {}
	for c in ["notes", "scrap", sv_k, mat_k]:
		drifts0[c] = sim.exchange_drift(c)
	var r_sn0: float = sim.exchange_rate("notes", "scrap")
	_check(r_sn0 > 0.0 and is_equal_approx(sim.exchange_rate("notes", "scrap"), r_sn0), "the same day read two rates")
	sim.load_dict(sim.to_dict())
	_check(sim.exchange_day == day0 and is_equal_approx(sim.exchange_rate("notes", "scrap"), r_sn0), "a save moved the exchange's day or its rate: day %d from %d" % [sim.exchange_day, day0])
	var out_of_band := 0
	for dd in range(60):
		for c in Data.EXCHANGE_BASE:
			if absf(sim.exchange_drift(c, dd) - 1.0) > Data.EXCHANGE_DRIFT + 1e-6:
				out_of_band += 1
	_check(out_of_band == 0 and sim.exchange_drift("tins") == 1.0, "a drift left its ±%.2f band %d times" % [Data.EXCHANGE_DRIFT, out_of_band])
	var rng_state: int = sim.rng.state
	sim.exchange_rate("notes", "tins", day0 + 7)
	_check(sim.rng.state == rng_state, "reading a rate drew the sim's dice")
	sim.hp = sim.max_hp()
	sim.deploy(3)
	_check(sim.on_mission() and not sim.exchange("tins", "scrap", 100) and sim.exchange_block("tins", "scrap", 100) == "The runner is out", "a trade went through on a run: '%s'" % sim.exchange_block("tins", "scrap", 100))
	sim.extract_now()
	if sim.on_mission():
		sim._extract()
	_check(sim.exchange_day == day0 + 1, "a run home did not move the exchange's day: %d from %d" % [sim.exchange_day, day0])
	var moved := false
	for c in drifts0:
		_check(is_equal_approx(sim.exchange_drift(c, day0), float(drifts0[c])), "yesterday's %s drift read differently today" % c)
		moved = moved or not is_equal_approx(sim.exchange_drift(c), float(drifts0[c]))
	_check(moved, "a run home did not move a rate: %s" % str(drifts0))
	_check(is_equal_approx(sim.exchange_rate("notes", "scrap", day0), r_sn0), "yesterday's rate is not the one the day had")
	# the Yard's two (28 Oct, Orders and the old Fixer out): Contacts the spread, Fixer 5% more
	var base_r: float = sim.exchange_rate("notes", "tins")
	_yard_ids(sim, ["shopfront", "contacts"], "contacts")
	_check(sim.yard_has("contacts") and is_equal_approx(sim.exchange_rate("notes", "tins"), base_r / (1.0 - Data.EXCHANGE_SPREAD) * (1.0 - Data.FX["yard/contacts"])), "Contacts did not narrow the spread to %.2f" % Data.FX["yard/contacts"])
	var cont_r: float = sim.exchange_rate("notes", "tins")
	_yard_ids(sim, ["back_room", "fixer"], "fixer")
	_check(sim.yard_has("fixer") and is_equal_approx(sim.exchange_rate("notes", "tins"), cont_r * Data.FX["yard/fixer"]) and is_equal_approx(Data.FX["yard/fixer"], 1.05), "the Fixer did not add 5%%: %.4f from %.4f" % [sim.exchange_rate("notes", "tins"), cont_r])
	var fence_b: Dictionary = Data.yard_building("fence")
	_check(fence_b["picks"][1][1]["id"] == "contacts" and fence_b["picks"][2][1]["id"] == "fixer" and not str(fence_b["picks"][1][1]["words"]).to_lower().contains("contract") and not str(fence_b["picks"][2][1]["words"]).to_lower().contains("contract"), "the Fence's Yard picks still talk contracts")
	_yard_ids(sim, ["shopfront", "contacts"], "")
	_yard_ids(sim, ["back_room", "fixer"], "")
	# the screen: the third tab reads Exchange and shows its panel, not the stash grid; the rates and the mate down the left
	_check(main._rail_status(main.MARKET).get("badge", "") == "", "the rail flags the Fence with no contracts: %s" % str(main._rail_status(main.MARKET)))
	main.show_room(main.MARKET)
	fv.selected = {}
	fv._show("exchange")
	main.refresh()
	_check(fv._tabs[2].visible and fv._tabs[2].text == "Exchange", "the Fence's third tab reads '%s'" % fv._tabs[2].text)
	_check(fv._exchange.visible and not fv._stash.visible and not fv._shelf.visible and not fv._panel.visible and fv._list.visible and not fv._sell.visible, "the exchange tab did not show its panel alone: stash %s, shelf %s" % [fv._stash.visible, fv._shelf.visible])
	var rows_on := 0
	for k in range(fv._list.ROWS):
		if fv._list.row_of(k)["panel"].visible:
			rows_on += 1
	_check(rows_on == sim.exchange_offered().size() - 1, "the rates list has %d rows for %d currencies besides tins" % [rows_on, sim.exchange_offered().size() - 1])
	_check(fv._list.row_of(0)["worth"].text.ends_with(Fmt.unit()) and fv._list.row_of(0)["move"].text != "", "the first rate's row reads '%s' / '%s'" % [fv._list.row_of(0)["worth"].text, fv._list.row_of(0)["move"].text])
	# the list says what a trade gives (28 Oct, the review: it showed the mid worth, 590 beside the panel's 501): a note's
	# row is what one sells for, scrap's (bought only) what one costs
	var notes_row: Dictionary = {}
	var scrap_row: Dictionary = {}
	for k in range(fv._list.ROWS):
		var rr: Dictionary = fv._list.row_of(k)
		if rr["cur"] == "notes":
			notes_row = rr
		elif rr["cur"] == "scrap":
			scrap_row = rr
	_check(not notes_row.is_empty() and notes_row["worth"].text == fv._list.worth_words(sim.exchange_rate("notes", "tins")), "the list's note reads '%s', a trade gives %.1f" % [notes_row.get("worth", fv._list._head).text, sim.exchange_rate("notes", "tins")])
	_check(not scrap_row.is_empty() and scrap_row["worth"].text == fv._list.worth_words(1.0 / sim.exchange_rate("tins", "scrap")), "the list's scrap reads '%s', one costs %.1f" % [scrap_row.get("worth", fv._list._head).text, 1.0 / maxf(0.0001, sim.exchange_rate("tins", "scrap"))])
	_check_fit(main, "Fence (the exchange)")
	# the amount buttons and Trade through the screen: notes to tins (scrap's never given, 28 Oct)
	var ex = fv._exchange
	_check(ex.button_of(0, "scrap") == null and ex.button_of(1, "scrap") != null, "You give offers scrap, or You get doesn't")
	sim.notes = 400
	main.refresh()
	ex.button_of(0, "notes").pressed.emit()
	ex.button_of(1, "tins").pressed.emit()
	ex.amount_buttons()[1].pressed.emit()             # 25%
	_check(ex.give == "notes" and ex.get_cur == "tins" and ex.amount() == 100, "the give, get or 25%% is off: %s, %s, %d" % [ex.give, ex.get_cur, ex.amount()])
	_check(ex.preview_text().begins_with("Give 100 notes · Get ") and ex.rate_text() != "", "the preview reads '%s'" % ex.preview_text())
	_check(ex.button_of(0, "tins").disabled and ex.button_of(1, "notes").disabled and not ex.button_of(1, "scrap").disabled, "the get side's pick can still be picked to give, or the other way")
	_check(ex.rate_text().contains(fv._list._num(sim.exchange_rate("notes", "tins"))) or ex.rate_text().contains(Fmt.group(int(round(sim.exchange_rate("notes", "tins"))))), "the panel's rate '%s' isn't the list's %.1f" % [ex.rate_text(), sim.exchange_rate("notes", "tins")])
	var get_100: int = sim.exchange_get("notes", "tins", 100)
	cash0 = sim.cash
	_check(not ex.trade_button().disabled, "Trade is off with 400 notes: '%s'" % ex.trade_button().text)
	ex.trade_button().pressed.emit()
	main.refresh()
	_check(sim.notes == 300 and sim.cash == cash0 + get_100, "Trade through the screen did not move 100 notes for %d tins: notes %d" % [get_100, sim.notes])
	_check_fit(main, "Fence (the exchange, traded)")
	ex.amount_buttons()[0].pressed.emit()             # 10%
	_check(ex.amount() == 30, "10%% of 300 notes is not 30: %d" % ex.amount())
	ex.amount_buttons()[3].pressed.emit()             # All
	_check(ex.amount() == 300, "All of 300 notes is not 300: %d" % ex.amount())
	ex.trade_button().pressed.emit()
	main.refresh()
	_check(sim.notes == 0 and ex.trade_button().disabled and ex.trade_button().text != "Trade", "with no notes left Trade is not off with a reason: '%s'" % ex.trade_button().text)
	_check_fit(main, "Fence (the exchange, nothing to give)")
	# notes are off the board after the Issue (they're read out of the fiat then)
	var pre_issue: Dictionary = sim.to_dict()
	var fx_d: Dictionary = sim.to_dict()
	fx_d["issued"] = true
	sim.load_dict(fx_d)
	main.refresh()
	_check(sim.issued and not sim.exchange_offered().has("notes") and not sim.can_exchange("notes", "tins", 1) and not sim.can_exchange("tins", "notes", 1), "notes are on the exchange after the Issue: %s" % str(sim.exchange_offered()))
	fv._show("exchange")
	main.refresh()
	_check(ex.button_of(0, "notes") == null and ex.button_of(1, "notes") == null and ex.give != "notes", "the screen offers notes after the Issue")
	_check(fv._list.row_of(0)["worth"].text.ends_with("fiat"), "the rates don't read in fiat after the Issue: '%s'" % fv._list.row_of(0)["worth"].text)
	_check_fit(main, "Fence (the exchange, after the Issue)")
	sim.load_dict(pre_issue)
	main.refresh()
	# the mate: his box and his Buy, as before
	fv._show("exchange")
	main.refresh()
	_check(not sim.mate.is_empty() and sim.mate["notes"] > 0, "the Fence's mate has nothing: %s" % str(sim.mate))
	sim.notes = int(sim.mate["notes"]) - 1
	main.refresh()
	_check(not sim.can_buy_mate() and fv._list._mate_buy.visible and fv._list._mate_buy.disabled, "the mate sold with a note short")
	while not sim.stash_room(4) and not sim.stash.is_empty():
		sim.sell(sim.stash[0])
	sim.notes = int(sim.mate["notes"])
	var want: String = sim.mate["unique"]
	main.refresh()
	_check(fv._list._mate.visible and not fv._list._mate_buy.disabled, "the mate's Buy is off with the notes there")
	fv._list._mate_buy.pressed.emit()
	_check(sim.notes == 0 and sim.stash.back().get("unique", "") == want, "the mate did not sell %s through the screen" % want)
	var runs0: int = sim.runs_total
	var ex_day0: int = sim.exchange_day
	for i in range(Data.MATE_RUNS):
		sim.hp = sim.max_hp()
		sim.deploy(3)
		sim.extract_now()
	_check(sim.runs_total == runs0 + Data.MATE_RUNS and sim.exchange_day == ex_day0 + Data.MATE_RUNS, "runs_total or the exchange's day did not count the runs: day %d from %d" % [sim.exchange_day, ex_day0])     # a day a run home, no more (the tools review)
	_check(Words.FENCE.has("exchange") and not Words.NEXT.has("contract") and not Words.FENCE.has("contract"), "the Fence's words still talk contracts")
	sim.load_dict(saved)
	fv._show("shelf")
	main.refresh()
	# never a money pump (the review): with Contacts and the Fixer, a round trip across any two days' drifts, at one day's
	# prices, returns less than went in (a rise in prices between the legs is Matt's call, the tools review's F2)
	var picks_was = sim.yard_picks.duplicate(true)
	sim.yard_picks["fence"] = ["", "b", "b", "", ""]
	sim._yard_dirty = true
	_check(sim.yard_has("contacts") and sim.yard_has("fixer"), "the fixture: Contacts and the Fixer aren't built")
	var worst := 0.0
	for cur in sim.exchange_offered():
		if cur == "tins":
			continue
		for d1 in range(12):
			for d2 in range(12):
				worst = maxf(worst, sim.exchange_rate("tins", cur, d1) * sim.exchange_rate(cur, "tins", d2))
	_check(worst < 1.0, "a round trip through the exchange pays at one day's prices: x%.3f" % worst)
	sim.yard_picks = picks_was
	sim._yard_dirty = true
	print("the exchange ok: the tab and its panel, a trade at its rate both ways, the spread, a day's rates a run home, Contacts and the Fixer, no notes after the Issue, none on a run, the buttons, the mate")
	_fence_ab_checks(main)
	_events_checks(main)


## The run's events (1 Nov, run events; docs/design/run_events.md; the fix round's checks): the dice (EVENT_ODDS of
## runs, one a run, never the last run's family, the weights and the pools' zones), the lull after the first search, the
## pause, every option's cost and reward, the time a choice needs, the dogs as a normal gang and their odds against the
## fight, the Scrap man (paid from the pack's stacks, run-only, his standing), the default standing orders on a run
## nobody's watching, the bot's answer, the panels' fit and words, the odds' dice untouched, and a save mid event.
func _events_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	var asks_was: bool = Sim.asks
	Sim.asks = false
	for i in range(Data.TIERS.size()):
		sim.best_depth[i] = maxi(1, int(sim.best_depth[i]))
	for z in range(sim.bosses_beaten.size()):
		sim.bosses_beaten[z] = true
	var charm_was = sim.equipped["Charm"]
	sim.equipped["Charm"] = null              # no Caretaker's Keys under the odds (T11: an event every run)
	sim.event_last = ""
	sim.event_threads = {}                    # BUILD46-E: no tip or robbed crew from the bot's runs steering these
	var fired := 0
	for i in range(200):
		sim.deploy(3)
		var m0: Dictionary = sim.mission
		if m0["event"] != "":
			fired += 1
			_check(m0["event_at"] >= Data.EVENT_WINDOW[0] and m0["event_at"] <= Data.EVENT_WINDOW[1], "an event is timed outside its window")
		sim.extract_now()
		sim.event_last = ""
	_check(fired > 40 and fired < 80, "events on %d of 200 runs; 30%% was the aim" % fired)
	# no threat in the first runs; the others still come, the threat once past them; never the family the last had
	var runs_was: int = sim.runs_total
	var early := {}
	var later := {}
	var after_need := {}
	sim.runs_total = 0
	for k in range(300):
		early[sim.roll_event(3, 1)] = true
	sim.runs_total = Data.CONVOY_FROM_RUN
	for k in range(300):
		later[sim.roll_event(3, 1)] = true
	sim.event_last = "need"
	for k in range(300):
		after_need[sim.roll_event(3, 1)] = true
	sim.event_last = ""
	_check(not early.has("threat") and early.has("need") and early.has("locked") and later.has("threat") and later.has("trader"), "a threat can pass in the first %d runs, or the families stopped coming: early %s, later %s" % [Data.CONVOY_FROM_RUN, str(early.keys()), str(later.keys())])
	_check(not after_need.has("need") and after_need.has("locked"), "the same family came two runs running: %s" % str(after_need.keys()))
	# the weights lean (T12): a threat's share at a farm by night over a retail site's by day; the pools keep to their zone
	var elapsed_was: float = sim.elapsed
	sim.elapsed = (Data.NIGHT_FROM + 1.0 - Data.CLOCK_START) * 3600.0
	var all_w := func(i: int) -> float:       # BUILD46-E: every family's weight
		return Data.EVENT_ORDER.reduce(func(acc, f): return acc + sim.event_weight(f, i, 1), 0.0)
	var farm_night: float = sim.event_weight("threat", 2, 1) / all_w.call(2)
	sim.elapsed = (12.0 - Data.CLOCK_START) * 3600.0
	var retail_day: float = sim.event_weight("threat", 5, 1) / all_w.call(5)
	sim.elapsed = elapsed_was
	_check(farm_night > retail_day * 1.5, "the threat's weight doesn't lean to a farm at night: %.2f against %.2f" % [farm_night, retail_day])
	# the slice's four keep EVENT_SLICE_MIN of every site's events, day and night, whichever came last (fix 46, E7); the six still come
	var share_low := []
	var six_any := false
	for night in [false, true]:
		sim.elapsed = ((Data.NIGHT_FROM + 1.0) if night else 12.0) * 3600.0 - Data.CLOCK_START * 3600.0
		for i in range(Data.TIERS.size()):
			for last in [""] + Data.EVENT_SLICE:
				sim.event_last = last
				var tot: float = all_w.call(i)
				var four: float = Data.EVENT_SLICE.reduce(func(acc, f): return acc + sim.event_weight(f, i, 1), 0.0)
				six_any = six_any or tot - four > 0.0
				if tot > 0.0 and four / tot < Data.EVENT_SLICE_MIN - 0.001:
					share_low.append("%s %s after '%s': %.2f" % [Data.TIERS[i]["name"], "night" if night else "day", last, four / tot])
	sim.event_last = ""
	sim.elapsed = elapsed_was
	_check(share_low.is_empty() and six_any, "the slice's four fall under %.0f%% of the events: %s (the six come: %s)" % [Data.EVENT_SLICE_MIN * 100.0, str(share_low.slice(0, 4)), str(six_any)])
	var bad_who: Array = []
	for k in range(60):
		var who: Dictionary = sim._pool_pick("need_who", 0)
		if who.has("zones") and not (0 in who["zones"]):
			bad_who.append(who["w"])
	_check(bad_who.is_empty(), "the pools put someone from another zone at the Allotments: %s" % str(bad_who))
	sim.runs_total = runs_was
	# a new camp's spare bandages in the stash (17 Oct, Matt), on top of the two in the rig
	var fresh = Sim.new()
	fresh.start()
	var spares: int = fresh.stash.filter(func(it): return str(it["base"]) == "Bandage").size()
	_check(spares == Data.START_STASH_BANDAGES and fresh.rig.size() == 2, "a new camp has %d bandages in the stash (not %d) and %d in the rig" % [spares, Data.START_STASH_BANDAGES, fresh.rig.size()])
	# it comes in the lull after the first search (G1), never mid-volley, never on a Ghost's pending clear (G10), once a run
