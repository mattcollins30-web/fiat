	sim.expeditions = [{"id": 999, "place": 0, "lead": lead_cls, "hands": [int(sim.hands[1]["id"])], "cargo": [], "worth": 1.0, "odds": 1.0, "risk": 0.0, "hold": 0.0, "t0": sim.elapsed, "dur": 600.0, "state": "out", "res": {}, "seen": false}]
	main.show_room(main.OVERVIEW)
