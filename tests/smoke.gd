## The bench's crafting, in cash: add, re-roll, lock one, re-roll one, a
## socket, strip; the level in notes. And the tiers behind it.
func _craft_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	sim.notes = 100000
	sim.cash = 10000000.0
	# tiers: the cap by level, the ranges, the roll
	_check(Items.tier_cap(0) == 1 and Items.tier_cap(3) == 2 and Items.tier_cap(6) == 3 and Items.tier_cap(10) == 4 and Items.tier_cap(15) == 5 and Items.tier_cap(40) == 5, "the tier cap by level is wrong")
	var d: Dictionary = Items.affix_def("damage_pct")
	var r1: Array = Items.tier_range(d, 1)
	var r5: Array = Items.tier_range(d, 5)
	_check(r1[0] == d["min"] and r5[1] == d["max"] and r1[1] < r5[0], "the tier ranges don't cut the span: T1 %s, T5 %s" % [str(r1), str(r5)])
	for t in range(1, 5):
		_check(Items.tier_range(d, t)[1] < Items.tier_range(d, t + 1)[0], "tier %d overlaps tier %d" % [t, t + 1])
	# rarity as quality (the pass, Matt, 6 Oct): the rarity caps the tier, the level floors it
	_check(Items.tier_floor(0) == 1 and Items.tier_floor(5) == 1 and Items.tier_floor(6) == 2 and Items.tier_floor(10) == 3 and Items.tier_floor(14) == 4 and Items.tier_floor(40) == 4, "the tier floor by level is wrong")
	_check(Data.RARITIES.size() == Data.AFFIX_TIERS and Data.RARITIES.back()["name"] == "Legendary", "five rarities to the five tiers: %s" % str(Data.RARITIES.map(func(r): return r["name"])))
	for k in range(Data.RARITIES.size()):
		_check(int(Data.RARITIES[k]["affixes"]) == k + 1 and int(Data.RARITIES[k]["tier"]) == k + 1, "%s is not %d affixes to T%d" % [Data.RARITIES[k]["name"], k + 1, k + 1])
	var shallow_top := 0
	var deep_low := 0
	for i in range(400):
		var g: Dictionary = Items.roll("Primary", 1, sim.rng, 2.0, true, false, "", "", 0.33, 0)
		var cap_g: int = int(Data.RARITIES[int(g["rarity"])]["tier"])
		_check(g["affixes"].size() == int(g["rarity"]) + 1, "a %s rolled %d affixes" % [Data.RARITIES[int(g["rarity"])]["name"], g["affixes"].size()])
		for a in g["affixes"]:
			_check(a.has("tier") and a["tier"] >= 1 and a["tier"] <= cap_g, "a shallow %s rolled T%d past its cap T%d" % [Data.RARITIES[int(g["rarity"])]["name"], a.get("tier", 0), cap_g])
			shallow_top += 1 if (a["tier"] == 5) else 0
		var deep: Dictionary = Items.roll("Primary", 6, sim.rng, 2.0, true, false, "", "", 0.33, 20)
		_check(deep["ilvl"] == deep["tier"] + 20, "the item level is not the base's tier plus the depth")
		var cap_d: int = int(Data.RARITIES[int(deep["rarity"])]["tier"])
		var floor_d: int = mini(Items.tier_floor(int(deep["ilvl"])), cap_d)
		for a in deep["affixes"]:
			_check(a["tier"] >= floor_d and a["tier"] <= cap_d, "a deep %s rolled T%d outside T%d..T%d" % [Data.RARITIES[int(deep["rarity"])]["name"], a["tier"], floor_d, cap_d])
			deep_low += 1 if (a["tier"] == 1 and int(deep["rarity"]) > 0) else 0
	_check(shallow_top > 0, "four hundred shallow rolls at +200% quality never made a T5: a Legendary from the first site is five T5s")
	_check(deep_low == 0, "a deep find above Common rolled T1s: %d" % deep_low)
	# the Bench
	var it: Dictionary = sim._plain("Helmet", "Hard hat")
	it["attachments"] = {}
	it["ilvl"] = 16
	sim.stash.append(it)
	_check(sim.craft_cost(it, "affixes") < 0 and sim.craft_cost(it, "values") < 0 and sim.craft_cost(it, "strip") < 0, "a plain item re-rolls or strips")
	var add_cost: int = sim.craft_cost(it, "add")
	_check(add_cost == sim._inf(Data.CRAFT["add"]["cash"] * 16), "adding to a plain level-16 piece costs %d, not %d" % [add_cost, sim._inf(Data.CRAFT["add"]["cash"] * 16)])
	var cash0: float = sim.cash
	_check(sim.craft(it["id"], "add") and it["rarity"] == 1 and it["affixes"].size() == 1 and is_equal_approx(sim.cash, cash0 - add_cost), "Add an affix did not take, or wasn't paid in cash")
	var stat0: String = it["affixes"][0]["stat"]
	var val0: int = it["affixes"][0]["value"]
	var changed := false
	for k in range(12):
		sim.craft(it["id"], "affixes")
		changed = changed or it["affixes"][0]["stat"] != stat0 or it["affixes"][0]["value"] != val0
	_check(changed and it["affixes"].size() == 1, "twelve re-rolls changed nothing, or the count")
	while sim.craft_cost(it, "add") >= 0:
		sim.craft(it["id"], "add")
	var top: int = Data.RARITIES.size() - 1
	_check(it["rarity"] == top and it["affixes"].size() == top, "adding to the top did not make a %s with %d: %d, %d" % [Data.RARITIES[top]["name"], top, it["rarity"], it["affixes"].size()])
	var stats := []
	for a in it["affixes"]:
		_check(not (a["stat"] in stats), "an affix doubled: %s" % a["stat"])
		stats.append(a["stat"])
	# the padlocks (20 Oct, Matt: one, the Pitch's Two locks a second): a locked affix stays through both re-rolls
	var keep: Dictionary = it["affixes"][0].duplicate()
	var plain_cost: int = sim.craft_cost(it, "affixes")
	_check(plain_cost == sim._inf(Data.CRAFT["affixes"]["cash"] * 16 * (top + 1)), "new affixes on a level-16 %s cost %d, not %d" % [Data.RARITIES[top]["name"], plain_cost, sim._inf(Data.CRAFT["affixes"]["cash"] * 16 * (top + 1))])
	_check(sim.lock_max() == Data.LOCKS + (1 if sim.yard_has("two_locks") else 0), "the padlocks: %d" % sim.lock_max())
	it["locks"] = []
	_check(sim.toggle_lock(it["id"], keep["stat"]) and sim.locks_of(it) == [keep["stat"]], "a padlock didn't go on: %s" % str(it.get("locks")))
	var lock_cost: int = sim.craft_cost(it, "affixes")
	_check(absi(lock_cost - int(round(plain_cost * (1.0 + Data.LOCK_PRICE)))) <= 2, "a padlock on new affixes: %d, not %d" % [lock_cost, int(round(plain_cost * (1.0 + Data.LOCK_PRICE)))])
	var over := 0
	for a in it["affixes"]:
		if not sim.toggle_lock(it["id"], a["stat"]) and not (a["stat"] in sim.locks_of(it)):
			over += 1
	_check(sim.locks_of(it).size() == mini(sim.lock_max(), it["affixes"].size() - 1) and over > 0, "the padlocks went past their cap or every affix: %s of %d" % [str(sim.locks_of(it)), sim.lock_max()])
	it["locks"] = [keep["stat"]]
	_check(sim.craft(it["id"], "affixes") and it["affixes"].size() == top and it["affixes"][0] == keep and sim.locks_of(it) == [keep["stat"]], "new affixes didn't keep the locked one: %s vs %s" % [str(it["affixes"][0]), str(keep)])
	# new values: every stat stays, the locked one's figure too, the tiers move sometimes, dearer the better the tiers
	var stats_before: Array = it["affixes"].map(func(a): return a["stat"])
	var tiers_seen := {}
	for k in range(240):                  # a T4 at the floor moves only up, one in sixteen: enough rolls that it does
		sim.craft(it["id"], "values")
		_check(it["affixes"].map(func(a): return a["stat"]) == stats_before and it["affixes"][0] == keep, "new values changed a stat or the locked one: %s" % str(it["affixes"]))
		tiers_seen[int(it["affixes"][1]["tier"])] = true
	_check(tiers_seen.size() >= 2, "240 new values never moved a tier: %s" % str(tiers_seen.keys()))
	it["locks"] = []
	for a in it["affixes"]:
		a["tier"] = 1
	var cheap: int = sim.craft_cost(it, "values")
	for a in it["affixes"]:
		a["tier"] = 5
	_check(absi(sim.craft_cost(it, "values") - cheap * 5) <= 3, "new values on T5s are not five times T1s: %d vs %d" % [sim.craft_cost(it, "values"), cheap])
	# the level, in notes
	var notes0: int = sim.notes
	var bump_cost: int = sim.craft_cost(it, "bump")
	_check(sim.craft(it["id"], "bump") and it["ilvl"] == 19 and sim.notes == notes0 - bump_cost, "the bump did not raise the level by %d in notes" % Data.BUMP_LEVELS)
	while sim.craft_cost(it, "bump") >= 0:
		sim.craft(it["id"], "bump")
	_check(it["ilvl"] == it["tier"] + Data.BUMP_CAP, "the level went past its cap: %d" % it["ilvl"])
	sim.cash = maxf(sim.cash, 1e9)              # 240 re-rolls can spend the cash an earlier test left (12 Oct: the flake)
	_check(sim.craft(it["id"], "socket") and sim.craft(it["id"], "socket") and Items.sockets(it) == 2 and (sim.craft_cost(it, "socket") < 0) == (sim.socket_max() <= 2), "two sockets did not cut, or a third would (cash £%.0f, socket max %d)" % [sim.cash, sim.socket_max()])
	var value_elite: int = it["value"]
	_check(sim.craft(it["id"], "strip") and it["rarity"] == 0 and it["affixes"].is_empty() and it["value"] < value_elite, "Strip did not take it back to plain")
	_check(Items.sockets(it) == 2, "stripping took the sockets")
	# the Bench works as a drop does (the pass, 6 Oct): re-roll one within the rarity's cap, never under the level's floor
	var rare: Dictionary = sim._plain("Helmet", "Hard hat")
	rare["ilvl"] = 16
	rare["rarity"] = 2
	rare["affixes"] = [{"stat": "armour_pct", "value": 10, "tier": 2}, {"stat": "regen", "value": 2, "tier": 3}]
	sim.stash.append(rare)
	var lo_r: int = mini(Items.tier_floor(16), Items.rarity_cap(rare))      # the floor never above the cap: a deep Rare is T3s
	for k in range(80):
		sim.craft(rare["id"], "values")
		var row: int = int(rare["affixes"][0]["tier"])
		_check(row >= lo_r and row <= Items.rarity_cap(rare), "new values left a level-16 Rare's affix at T%d, outside T%d..T%d" % [row, lo_r, Items.rarity_cap(rare)])
	sim.craft(rare["id"], "affixes")
	for a in rare["affixes"]:
		_check(int(a["tier"]) <= Items.rarity_cap(rare) and int(a["tier"]) >= lo_r, "a re-roll on a level-16 Rare gave T%d" % int(a["tier"]))
	# a set piece: no bench job on its affixes, they are the set's
	var set_piece: Dictionary = Items.roll_set_piece(Data.SETS[0]["name"], Data.SETS[0]["pieces"][0], sim.rng)
	sim.stash.append(set_piece)
	for kind in Data.CRAFT:
		if kind == "temper":
			continue                 # tempering lifts its level, never its affixes: the one job a set piece takes (25 Oct, the review)
		_check(sim.craft_cost(set_piece, kind, set_piece["affixes"][0]["stat"] if not set_piece["affixes"].is_empty() else "") < 0, "the Bench offers %s on a set piece" % kind)
	# not on a unique, not on paper, not without a bench, not on a run, not short
	var u := Items.roll_unique(Data.UNIQUES[0], sim.rng)
	sim.stash.append(u)
	_check(sim.craft_cost(u, "affixes") < 0 and sim.lock_block(u, str(u["affixes"][0]["stat"]) if not u["affixes"].is_empty() else "") != "", "a unique re-rolls or takes a padlock")
	sim.cash = 0.0
	_check(not sim.can_craft(it["id"], "add"), "the Bench works with no cash")
	sim.cash = 100000.0
	var ch: Dictionary = sim._plain("Charm", "Lucky penny")
	_check(sim.craft_cost(ch, "add") > 0 and sim.craft_cost(ch, "socket") < 0, "a charm takes no affix at the Bench, or takes a socket")
	# through the screen: the Bench button and the menus
	main.show_room(main.ARMOURY)
	main._armoury.selected = {"kind": "stash", "id": it["id"]}
	main.refresh()
	_check_fit(main, "Armoury (bench button)")
	# the Workshop button opens the Workshop on the piece (9 Oct): the old menu is gone
	_check(not main.has_method("_open_bench") and not main.has_method("_open_bench_picks"), "the old Bench menu is still in the shell")
	var wb: int = -1
	for k in range(main._armoury._pick._buttons.size()):
		if main._armoury._pick._buttons[k].visible and main._armoury._pick._buttons[k].text == "Workshop":
			wb = k
	_check(wb >= 0, "the Runner room has no Workshop button on a stash piece")
	main._menu.close()                   # a Yard arrival's popup can be up from the run before: not the Workshop's
	if wb >= 0:
		main._armoury._pick.press(wb)
	main.refresh()
	_check(main.room == main.WORKSHOP and main._workshop.view == "craft" and main._workshop._selected_item() == it and not main._menu.visible, "the Workshop button did not open the Workshop's Craft view on the piece (%s, %s, %s, %s)" % [main.room, main._workshop.view, str(main._workshop.sel_id), str(main._menu.visible)])
	_check_fit(main, "Workshop (from the Runner room)")
	main._craft(it["id"], "add", "")
	_check(it["rarity"] == 1 and not main._menu.visible, "the menu's Add did not take")
	# the Bench says what it did: a toast with the affix added, the same on the craft panel's line, and in the log
	var added_line: String = Items.affix_lines(it, false, true)[0]
	_check(sim.last_craft.get("id", -1) == it["id"] and str(sim.last_craft["words"]) == "Added " + added_line, "the Bench's words are '%s', not 'Added %s'" % [str(sim.last_craft.get("words", "")), added_line])
	_check(main._juice.lines().has(sim.last_craft["words"]), "the Bench's words did not toast: %s" % str(main._juice.lines()))
	_check(str(sim.events.back()[1]).ends_with(sim.last_craft["words"]), "the log line does not carry the Bench's words: '%s'" % str(sim.events.back()[1]))
	main.show_room(main.WORKSHOP)
	main._workshop._set_view("craft")
	_check(main._workshop._craftable().any(func(c): return c["id"] == it["id"]), "the added-to piece is not in the Craft view")
	var hold_value = it["value"]
	it["value"] = 9999999                                        # the dearest, so it sorts to the first page whatever the stash holds (a flake: it had landed on page two)
	main._workshop._shown = ""
	main.refresh()
	var kc: int = main._workshop._inv.cell_of(it["id"])        # the grid's own cell (two pieces of one value can sort either way)
	_check(kc >= 0, "the added-to piece has no cell in the Craft view's grid")
	if kc >= 0:
		main._workshop._pick_cell(kc)
	main.refresh()
	_check(main._workshop._foot.text.begins_with("Added"), "the jobs' foot does not say what the Bench did: '%s'" % main._workshop._foot.text)
	_check_fit(main, "Workshop (craft, after an add)")
	it["value"] = hold_value
	# a Legendary at the Bench (20 Oct, Matt: "i can only ever see 3 out of the 5 affixes"): five rows, each its tier's
	# range, a row's press its padlock, the two re-rolls priced, all of it fitting
	var leg: Dictionary = sim._plain("Primary", "Army SMG")
	leg["ilvl"] = 12
	var cash_leg: float = sim.cash
	sim.stash.append(leg)
	while sim.craft_cost(leg, "add") >= 0:
		sim.cash = 1e9
		sim.craft(leg["id"], "add")
	var have5: Array = leg["affixes"].map(func(x): return x["stat"])
	for pa in Items.pick_affixes(leg["slot"], 5 - leg["affixes"].size(), sim.rng, have5):
		leg["affixes"].append(Items.roll_affix(pa, Items.ilvl(leg), sim.rng, 0, Items.rarity_cap(leg)))     # a dropped Legendary's fifth (the Bench's adds stop at four)
	leg["value"] = 99999999
	main._workshop._shown = ""
	main.refresh()
	var lc: int = main._workshop._inv.cell_of(leg["id"])
	if lc >= 0:
		main._workshop._pick_cell(lc)
	main.refresh()
	var W = main._workshop
	var shown_rows: int = W._affix_rows.filter(func(r): return r["button"].visible and r["label"].text != "" and r["tag"].text.contains("–")).size()
	_check(leg["affixes"].size() == 5 and shown_rows == 5, "a Legendary shows %d of its %d affixes at the Bench" % [shown_rows, leg["affixes"].size()])
	leg["locks"] = []
	W._toggle_lock(0)
	_check(sim.locks_of(leg) == [leg["affixes"][0]["stat"]] and W._lock_line.text.begins_with("Locked: "), "a row's press didn't padlock it: %s / '%s'" % [str(sim.locks_of(leg)), W._lock_line.text])
	main.refresh()
	_check(W._affix_buttons[0].visible and W._affix_buttons[1].visible and W._affix_buttons[0].text.contains(Fmt.money(sim.craft_cost(leg, "values"))), "the re-rolls aren't up and priced: '%s' / '%s'" % [W._affix_buttons[0].text, W._affix_buttons[1].text])
	_check_fit(main, "Workshop (a Legendary, a padlock on)")
	W._toggle_lock(0)
	_check(sim.locks_of(leg).is_empty(), "a second press didn't take the padlock off")
	sim.stash.erase(leg)
	sim.cash = cash_leg
	main._workshop.sel_id = -1
	main._workshop._shown = ""
	main.refresh()
	# every kind has words: re-roll says before and after, bump the levels, one the swap
	var words_seen := {}
	sim.cash = 999999.0
	sim.notes = 9999
	for kind in ["affixes", "bump"]:
		if sim.craft_cost(it, kind) >= 0 and sim.craft(it["id"], kind):
			words_seen[kind] = str(sim.last_craft["words"])
	_check(words_seen.get("affixes", "").begins_with("New affixes") and (words_seen.get("affixes", "").contains(" → ") or words_seen.get("affixes", "").ends_with("no change")), "new affixes' words: '%s'" % words_seen.get("affixes", ""))
	_check(not words_seen.has("bump") or (words_seen["bump"].begins_with("Item level ") and words_seen["bump"].contains(" → ")), "bump's words: '%s'" % words_seen.get("bump", ""))
	if not it["affixes"].is_empty() and sim.craft_cost(it, "values") >= 0:
		if sim.craft(it["id"], "values"):
			_check(str(sim.last_craft["words"]).begins_with("New values"), "new values' words: '%s'" % str(sim.last_craft["words"]))
	# a worn piece: the Workshop works on it in place, and won't scrap it off the runner
	var worn_gun = sim.equipped["Primary"]
	if worn_gun != null and sim.craft_cost(worn_gun, "add") < 0 and not worn_gun.has("unique") and not worn_gun.has("set"):
		worn_gun = sim._plain("Primary", str(worn_gun["base"]))     # a worn gun at the top rarity takes no affix: a plain one of it worn for the check (the run's dice, 13 Oct)
		sim.equipped["Primary"] = worn_gun
	if worn_gun != null and not worn_gun.has("unique") and not worn_gun.has("set"):
		main._open_workshop(worn_gun["id"])
		_check(main.room == main.WORKSHOP and main._workshop._selected_item() == worn_gun, "the Workshop did not pick the worn gun")
		var sk: int = main._workshop.JOBS.find("scrap")
		_check(main._workshop._job_tiles[sk]["button"].disabled and main._workshop._job_tiles[sk]["price"].text == "", "the Workshop offers to scrap a worn gun")
		_check_fit(main, "Workshop (a worn piece)")
		var r0: int = int(worn_gun["rarity"])
		sim.cash = 999999.0
		_check(sim.craft_cost(worn_gun, "add") >= 0, "the worn gun can't take an affix: the job checks below would skip")
		if sim.craft_cost(worn_gun, "add") >= 0:
			sim._surv_cache[3] = ["held", 0.5]           # odds read before the job
			main._craft(worn_gun["id"], "add", "")
			_check(not sim._surv_cache.has(0), "a job on a worn gun left the odds as they were read before it")
			_check(sim.equipped["Primary"] == worn_gun and int(worn_gun["rarity"]) >= r0 and sim.last_craft.get("id", -1) == worn_gun["id"], "the Workshop's job on a worn gun did not take")
		main._workshop.sel_id = -1
	# a part: the Workshop button opens the Guns view with its mount picked, not Craft (the review, 9 Oct)
	var part_base: Dictionary = {}
	for a in Data.ATTACHMENTS:
		if not str(a.get("mount", "")).begins_with("socket") and a.get("mount", "") != "":
			part_base = a
			break
	if not part_base.is_empty():
		var part: Dictionary = sim._plain(Data.ATTACHMENT, part_base["name"])
		sim.stash.append(part)
		main._open_workshop(part["id"])
		_check(main.room == main.WORKSHOP and main._workshop.view == "guns" and main._workshop.sel_mount == part["mount"] and main._workshop._selected_item() == part, "the Workshop button on a part did not open the Guns view on its mount (%s, '%s')" % [main._workshop.view, main._workshop.sel_mount])
		_check_fit(main, "Workshop (a part from the Runner room)")
		sim.stash.erase(part)
		main._workshop.sel_id = -1
		main._workshop.sel_mount = ""
		main._workshop.sel_slot = ""
	main.show_room(main.ARMOURY)
	# the affix list on the panel, with tiers
	main._armoury.selected = {"kind": "stash", "id": it["id"]}
	main.refresh()
	var ah = main._armoury._head._affixes
	_check(ah.visible and ah._tags[0].visible and ah._tags[0].text.begins_with("T"), "the panel's affix chip has no tier tag: '%s'" % ah._tags[0].text)
	_check_fit(main, "Armoury (affix list)")
	# each affix is a chip in its tier's colour, tag and words; every affix shows, over two rows at most
	# the affixes' chips, and the open-slot chip after them when there is room for more
	var open_chip: int = 1 if it["affixes"].size() < Data.RARITIES.size() - 1 else 0
	_check(ah.shown() == it["affixes"].size() + open_chip and ah.rows_used() <= ah.get_parent().AFFIX_ROWS, "the panel shows %d affix chips for %d affixes over %d rows" % [ah.shown(), it["affixes"].size(), ah.rows_used()])
	for k in range(mini(3, it["affixes"].size())):
		var want: Color = Pal.tier_color(int(it["affixes"][k].get("tier", 1)))
		_check(ah._labels[k].get_theme_color("font_color") == want and ah._tags[k].get_theme_color("font_color") == want, "affix %d (T%d) is not in its tier's colour" % [k, int(it["affixes"][k].get("tier", 1))])
	if it["affixes"].size() < 3:
		_check(ah.words(ah.shown() - 1).contains("open"), "the chip after the affixes is not the open one: '%s'" % ah.words(ah.shown() - 1))
	# a three-affix piece with long words: every affix still a chip, none trailing off
	var three: Dictionary = sim._plain("Armour", "Riot suit")
	three["rarity"] = Data.RARITIES.size() - 1       # at the top: no open chip after the three
	three["affixes"] = [{"stat": "armour_pct", "value": 18, "tier": 4}, {"stat": "loot_pct", "value": 12, "tier": 2}, {"stat": "poison_res", "value": 9, "tier": 3}]
	sim.stash.append(three)
	main._armoury._inv._set_kind(0)
	main.refresh()
	var c3: int = main._armoury._inv.cell_of(three["id"])
	if c3 >= 0:
		main._armoury._pick_cell(c3)
		main.refresh()
		_check(main._armoury._head._affixes.shown() == 3, "a three-affix piece shows %d chips" % main._armoury._head._affixes.shown())
		_check_fit(main, "Armoury (three affix chips)")
	sim.stash.erase(three)
	main.refresh()
	# worn gear can go to the Bench too
	var worn: Dictionary = sim.equipped["Armour"]
	if worn != null and not worn.has("unique") and sim.craft_cost(worn, "socket") >= 0 and is_same(sim.item_by_id(worn["id"]), worn):
		var n0: int = Items.sockets(worn)
		var scost: int = sim.craft_cost(worn, "socket")
		_check(sim.craft(worn["id"], "socket") and Items.sockets(worn) == n0 + 1, "a socket did not cut on the armour worn: cost %d, cash %.0f, can %s, sockets %d, slot %s" % [scost, sim.cash, str(sim.can_craft(worn["id"], "socket")), Items.sockets(worn), worn["slot"]])
	sim.load_dict(saved)
	print("the Bench ok: tiers, add, re-roll, lock, one, the level, sockets, strip, the menus")


## The estate recycles: a dead runner's worn kit and a unique sold to the Fence
## go on the list; a few runs later one of a gang is wearing it, and it comes
## off him when the site's cleared, affixes and all.
## The papers as the book: a paper picked up goes in the drawer by name, in
## the order found, once; the deep ones only past their depth; the Caravan's
## middle column shows the drawer, six a page, a click turning the page; the
## book survives a save and a move.
func _book_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	sim.book = []
	var pages: Array = sim.book_pages()
	_check(pages.size() == 28 and not pages.has("The deeds"), "the book has %d pages, not 28" % pages.size())     # 20, and the Outskirts' and the City's eight (12 Oct)
	# shallow rolls never turn up a deep paper; deep ones do
	var deep_seen := false
	for k in range(200):
		var it: Dictionary = Items.roll(Data.PAPER, 1, sim.rng, 0.0, false, false, "", "", 0.33, 1)
		_check(int(Items.base_of(it).get("depth", 0)) == 0, "a deep paper turned up at depth 1: %s" % it["base"])
	for k in range(300):
		var it: Dictionary = Items.roll(Data.PAPER, 1, sim.rng, 0.0, false, false, "", "", 0.33, 50)
		deep_seen = deep_seen or int(Items.base_of(it).get("depth", 0)) > 0
	_check(deep_seen, "no deep paper in 300 rolls at depth 50")
	for name in ["A ration book", "A council minute", "A bus timetable, amended", "A letter to the Bank", "A list of names", "The Manager's note"]:
		_check(Words.item_words(name) != "" and Words.item_words(name).ends_with("."), "%s has no line" % name)
	# a find is read, once, in order
	sim.words[3] = []
	sim.set_depth(3, 1)
	sim.hp = sim.max_hp()
	sim.deploy(3)
	var m: Dictionary = sim.mission
	m["found"] = []
	var p1: Dictionary = sim._plain(Data.PAPER, "A P45")
	var p2: Dictionary = sim._plain(Data.PAPER, "A betting slip")
	sim._read(p1)
	sim._read(p2)
	sim._read(sim._plain(Data.PAPER, "A P45"))
	_check(sim.book == ["A P45", "A betting slip"], "the book is not the papers in the order found: %s" % str(sim.book))
	sim._read(sim._plain(Data.PAPER, "The deeds"))
	_check(sim.book.size() == 2, "the deeds went in the drawer")
	sim.extract_now()
	# the Caravan's drawer: an Also chip, over the lanes when pressed, three columns of cards
	main.show_room(main.BARRACKS)
	var bk = main._barracks
	_check(bk.also_names().has("The drawer") and bk.also_button("The drawer") != null, "the drawer is not in the Also row")
	bk.pick_also("The drawer")
	main.refresh()
	_check(bk.also_button("The drawer").text.contains("2 of %d" % (pages.size() + Words.GATE_ITEMS.size())), "the drawer's chip is off: %s" % bk.also_button("The drawer").text)
	# the drawer reads in the story's order (12 Oct): every page, the found ones with their words, the rest a gap saying where
	_check(bk._cells[0]["name"].text == "1. %s" % pages[0] and bk._cells[1]["name"].text == "2. A P45" and bk._cells[2]["name"].text == "3. A betting slip", "the drawer's cards are off: %s / %s / %s" % [bk._cells[0]["name"].text, bk._cells[1]["name"].text, bk._cells[2]["name"].text])
	_check(bk._cells[1]["lines"][0].text != "" and not bk._cells[1]["lines"][0].text.begins_with("Not found"), "the paper's words are not under its name")
	_check(bk._cells[0]["lines"][0].text.begins_with("Not found yet") and bk._cells[0]["name"].get_theme_color("font_color") == Pal.TEXT_3, "a paper not found is not a gap: '%s'" % bk._cells[0]["lines"][0].text)
	var seed_k: int = pages.find("A seed order")
	_check(seed_k >= 0 and main._barracks._paper_gap("A seed order").contains("Allotments") and main._barracks._paper_gap("A ration book").contains("level "), "a gap doesn't say where its paper is: '%s' / '%s'" % [main._barracks._paper_gap("A seed order"), main._barracks._paper_gap("A ration book")])
	_check_fit(main, "Caravan (the drawer, two)")
	for name in pages:
		sim._read(sim._plain(Data.PAPER, name))
	_check(sim.book.size() == pages.size(), "the full book is not every page")
	bk._shown = ""
	main.refresh()
	# a page holds what the lanes' area takes; twenty papers are that many pages
	var per_page: int = bk._cells.filter(func(n): return n["button"].visible).size()
	var n_pages: int = ceili(float(pages.size()) / per_page)
	_check(per_page >= 3 and (n_pages == 1 or bk.also_button("The drawer").text.to_lower().contains("page 1 of %d" % n_pages)), "a full drawer's pages are off: %s (%d a page)" % [bk.also_button("The drawer").text, per_page])
	_check_fit(main, "Caravan (the drawer, full)")
	bk._turn_page()
	_check(bk.drawer_page == 1 and (n_pages == 1 or bk._cells[0]["name"].text.begins_with("%d. " % (per_page + 1))), "a click did not turn the page: %d, %s" % [bk.drawer_page, bk._cells[0]["name"].text])
	_check_fit(main, "Caravan (the drawer, page 2)")
	bk.pick_also("The drawer")
	main.refresh()
	_check(bk.alt == "" and bk.web().visible and not bk._cells[0]["button"].visible, "the drawer pressed again did not give the lanes back")
	_check_fit(main, "Caravan (back from the drawer)")
	var d: Dictionary = sim.to_dict()
	sim.load_dict(d)
	_check(sim.book.size() == pages.size(), "the book did not save")
	# the shelf: the uniques found, the same way
	sim.shelf = []
	var u1: Dictionary = Items.roll_unique(sim._unique_named("Lucky Cap"), sim.rng)
	sim._read(u1)
	sim._read(Items.roll_unique(sim._unique_named("Lucky Cap"), sim.rng))
	sim._read(Items.roll_unique(sim._unique_named("Jump Leads"), sim.rng))
	_check(sim.shelf == ["Lucky Cap", "Jump Leads"], "the shelf is not the uniques in the order found: %s" % str(sim.shelf))
	bk.pick_also("The mantelpiece")
	main.refresh()
	_check(bk.also_button("The mantelpiece").text.contains("2 of %d" % Data.UNIQUES.filter(func(u): return not u.get("mythic", false)).size()), "the shelf's chip is off: %s" % bk.also_button("The mantelpiece").text)
	# the chase first (endgame part 3): sixteen gaps in TEXT_3 (the order's three since 18 Oct), where each is under it; then the rest found, in order
	var chase: Array = sim.shelf_chase()
	var n_order_u: int = Data.PINNACLES.reduce(func(acc, pp): return acc + (2 if pp.has("unique2") else 1), 0)     # the order's two each (24 Oct)
	_check(chase.size() == 13 + n_order_u and not chase[0]["found"] and str(chase[0]["where"]).begins_with("Ransacked Streets, from a level"), "the shelf's chase is off: %d rows, '%s'" % [chase.size(), str(chase[0]["where"]) if not chase.is_empty() else ""])
	var row0: Dictionary = bk._cells[0]
	_check(row0["name"].text == "1. %s" % chase[0]["name"] and row0["lines"][0].text.begins_with("Ransacked Streets") and row0["name"].get_theme_color("font_color") == Pal.TEXT_3, "the shelf's first gap is off: '%s' / '%s'" % [row0["name"].text, row0["lines"][0].text])
	var shelf_branch: Dictionary = main._barracks._shelf_branch()
	var all_names: Array = []
	for pg in range(int(shelf_branch["pages"])):
		main._barracks.drawer_page = pg
		for nd in main._barracks._shelf_branch()["nodes"]:
			all_names.append(str(nd["name"]).substr(str(nd["name"]).find(" ") + 1))
	var n_ord: int = n_order_u
	_check(all_names.size() == 15 + n_ord and all_names[13 + n_ord] == "Lucky Cap" and all_names[14 + n_ord] == "Jump Leads" and all_names[12] == Data.CONVOY_UNIQUE and all_names[13] == (str(Data.PINNACLES[0]["unique"]) if sim.order_open(str(Data.PINNACLES[0]["key"])) else Fmt.scramble(str(Data.PINNACLES[0]["unique"]))), "the shelf's order is off: %s" % str(all_names))     # a gap from a place not yet known, scrambled (20 Oct)
	main._barracks.drawer_page = 0
	_check_fit(main, "Caravan (the shelf)")
	# a site's own found fills its gap
	sim._read(Items.roll_unique(sim._unique_named("The Float"), sim.rng))
	chase = sim.shelf_chase()
	_check(chase[4]["found"] and chase[4]["name"] == "The Float" and not chase[3]["found"], "the Float on the shelf did not fill the Shopping Centre's gap")
	main._barracks._shown = ""
	main.refresh()
	_check_fit(main, "Caravan (the shelf, one filled)")
	bk.pick_also("The mantelpiece")
	main.refresh()
	# a paper is read on pickup (Matt, 10 Oct: "where do they actually need to be learned?"): unread it teaches its
	# word; read, the Lock-up says the Radio knows it and it's safe to sell; a rule paper says keep it
	var pw: Dictionary = {}
	for w in Data.WORDS:
		if str(w.get("paper", "")) != "":
			pw = w
			break
	_check(not pw.is_empty(), "no paper with a word to test")
	if not pw.is_empty():
		sim.book.erase(str(pw["paper"]))     # unread for the check; the save comes back after
	if not pw.is_empty():
		var pp: Dictionary = sim._plain(Data.PAPER, str(pw["paper"]))
		sim.stash.append(pp)
		_check(Items.paper_keep(pp, sim.book) == "", "an unread paper says it's spent")
		main.show_room(main.ARMOURY)
		main._armoury.selected = {"kind": "stash", "id": pp["id"]}
		main._armoury._shown = ""
		main.refresh()
		var said := " | ".join(_texts(main._armoury))
		_check(said.contains("the code for %s" % str(pw["name"]).to_lower()) and not said.contains("the Radio has"), "an unread paper's panel doesn't say what it teaches: %s" % said.left(300))
		sim._read(pp)
		main._armoury._shown = ""
		main.refresh()
		said = " | ".join(_texts(main._armoury))
		_check(said.to_lower().contains("read · the radio has %s" % str(pw["name"]).to_lower()) and said.to_lower().contains("carries %s" % str(pw["name"]).to_lower()), "a read paper's panel doesn't say it's known and the code it carries: %s" % said.left(300))
		_check_fit(main, "Lock-up (a read paper)")
		main._armoury.selected = {}
	var log_it: Dictionary = Items.roll_unique(sim._unique_named("The Lorry Driver's Log"), sim.rng)
	sim._read(log_it)
	_check(Items.paper_keep(log_it, sim.book) == "Works from the stash: keep it", "a rule paper doesn't say keep it: '%s'" % Items.paper_keep(log_it, sim.book))
	sim.load_dict(saved)
	print("the book ok: twenty pages, the deep ones gated, read once in order, the drawer, its pages, saved; the shelf of uniques")


## The places changing: a cleared site is picked over and comes back over
## hours; the clock makes every site Night in the small hours; the weather by
## zone puts Rain or Fog on, never rolled by the radio; the Runs card says so.
func _places_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	sim.words[3] = []
	sim.yard_picks.erase("radio")              # the Radio's Weather set and Night set read the sky elsewhere
	sim._yard_changed("")
	for z in range(Data.ZONES.size()):
		sim.weather[z] = ""
	sim.elapsed = 3600.0 * 2.0            # 11:00, day
	_check(not sim.is_night() and sim.clock_words() == "11:00", "the clock reads %s at two hours in" % sim.clock_words())
	sim.site_crates.erase("3")                  # a site nobody's opened (28 Oct: the camp's own runs could leave it picked over)
	var fresh: Dictionary = sim.effective(3)
	_check(not ("Night" in fresh["intel"]) and sim.site_state_forms(3)[0] == Words.SKY["fresh"], "a fresh site at 11:00 is not fresh: %s" % str(fresh["intel"]))
	# the crates kept between runs (27 Oct, Matt): two opened, the rest wait; drops and cash never thin
	sim.site_crates = {}
	sim.hp = sim.max_hp()
	sim.deploy(3)
	var m: Dictionary = sim.mission
	sim._clear(m, m["t"])
	var cs: Array = m["crates"]
	var n_all: int = cs.size()
	_check(n_all >= 3, "the fixture: %d crates" % n_all)
	m["crate_i"] = 2
	cs[2]["done"] = 0
	var third: Dictionary = cs[2].duplicate(true)
	sim.extract_now()
	sim.words[3] = []                     # the extract re-rolled the radio's words; the site alone is read
	var st: Array = sim.site_stock(3)
	var kept_n: int = Array(st[0]).size() if not st.is_empty() else -1
	_check(not st.is_empty() and kept_n <= n_all - 2 and int(st[1]) == 0 and sim.site_state_forms(3)[0] != Words.SKY["fresh"], "the crates left weren't kept: %s, '%s'" % [str(st), sim.site_state_forms(3)[0]])
	var picked: Dictionary = sim.effective(3)
	_check(is_equal_approx(picked["drop"], fresh["drop"]) and is_equal_approx(picked["cash"], fresh["cash"]), "a cleared site still thins its drops and cash: %.2f / %.2f against %.2f / %.2f" % [picked["drop"], picked["cash"], fresh["drop"], fresh["cash"]])
	# a crate back a trickle later; the next run starts with what was left, then what's come back
	sim.elapsed += sim.crate_trickle_s() + 1.0
	_check(int(sim.site_stock(3)[1]) == 1, "no crate came back after a trickle: %s" % str(sim.site_stock(3)))
	sim.hp = sim.max_hp()
	sim.deploy(3)
	m = sim.mission
	sim._clear(m, m["t"])
	_check(m["crates"].size() == kept_n + 1 and str(m["crates"][0]["key"]) == str(third["key"]), "the run didn't start with the crates left, then one back: %d crates, first %s (was %s)" % [m["crates"].size(), str(m["crates"][0]["key"]), str(third["key"])])
	# the player's pick: the clicked one goes next (straight away, nothing started)
	if m["crates"].size() >= 3 and not m["crates"][2].get("locked", false):
		var want: String = str(m["crates"][2]["key"]) + str(m["crates"][2].get("held", {}).hash())
		_check(sim.crate_pick(2) and str(m["crates"][int(m["crate_i"])]["key"]) + str(m["crates"][int(m["crate_i"])].get("held", {}).hash()) == want, "the picked crate isn't next")
	_check(not sim.crate_pick(0), "a crate behind the one in hand could be picked")
	# picked clean: nothing left, a crate's wait on the tile; a full set later, fresh
	m["crate_i"] = m["crates"].size()
	sim.extract_now()
	sim.words[3] = []
	_check(sim.site_state_forms(3)[0].begins_with("Picked clean"), "a picked-clean site doesn't say so: '%s'" % sim.site_state_forms(3)[0])
	sim.hp = sim.max_hp()
	sim.deploy(3)
	sim._clear(sim.mission, sim.mission["t"])
	_check(sim.crates_done(sim.mission) and sim.mission.get("crates_none", false), "a picked-clean site rolled crates straight away")
	sim.mission["ghost_pending"] = true           # a Ghost there: nothing opened is no clear (the review)
	var cleared0: bool = sim.mission["cleared"]
	sim.mission["cleared"] = false
	var said0: int = sim.events_total
	sim.extract_now()
	var said_new: Array = _said(sim).slice(-(sim.events_total - said0)) if sim.events_total > said0 else []
	_check(sim.events_total > said0 and not said_new.any(func(x): return str(x).begins_with("Ghost:")), "a Ghost took a clear off a site already picked clean: %s" % str(said_new))     # the Ghost's clear says so (the worn record went, 30 Oct)
	_check(cleared0, "the fixture: the run wasn't cleared")
	sim.elapsed += sim.crate_trickle_s() * (n_all + 2)
	_check(sim.site_state_forms(3)[0] == Words.SKY["fresh"], "the site didn't come back fresh: '%s'" % sim.site_state_forms(3)[0])
	sim.site_crates = {}
	# night by the clock
	sim.elapsed = 3600.0 * 14.0           # 23:00
	_check(sim.is_night() and sim.clock_words() == "23:00", "23:00 is not night: %s" % sim.clock_words())
	var night: Dictionary = sim.effective(3)
	_check("Night" in night["intel"] and is_equal_approx(night["pace"], fresh["pace"] * 0.8), "the clock's night did not take: %s pace %.2f" % [str(night["intel"]), night["pace"]])
	_check(sim.sky_words(3).begins_with("23:00, night"), "the sky's words are off: %s" % sim.sky_words(3))
	# the weather, by zone; never a word the radio rolls or sells
	sim.weather[1] = "Rain"
	var rain: Dictionary = sim.effective(3)
	_check("Rain" in rain["intel"] and is_equal_approx(rain["search"], fresh["search"] * 1.3) and is_equal_approx(rain["patrol"], fresh["patrol"] * 1.25), "rain did not take: %s search %.2f" % [str(rain["intel"]), rain["search"]])
	_check(sim.sky_words(3).ends_with(", " + Words.SKY["rain"]), "the sky's words do not say rain: %s" % sim.sky_words(3))     # the sky word as the glossary has it (the language pass: "rain")
	sim.weather[1] = "Fog"
	var fog: Dictionary = sim.effective(3)
	_check(fog["contact"] == fresh["contact"] - 1 and is_equal_approx(fog["drop"], fresh["drop"] * 0.9), "fog did not take: %s" % str(fog["intel"]))
	_check(not ("Rain" in sim.call_options(3)) and not ("Fog" in sim.call_options(3)), "the sky's words are for sale at the radio")
	var rolled := false
	for k in range(60):
		var rw: Array = sim._roll_words(4, [], 3)
		rolled = rolled or rw.any(func(wd): return wd["w"] in ["Rain", "Fog", "Night"])
	_check(not rolled, "the radio rolled the sky's words")
	var saw := {}
	for k in range(40):
		sim.elapsed += Data.WEATHER_H * 3600.0
		sim._roll_weather()
		for z in range(Data.ZONES.size()):
			saw[sim.weather[z]] = true
	_check(saw.has("Rain") and saw.has("Fog") and saw.has(""), "forty hours of weather did not bring rain, fog and clear: %s" % str(saw.keys()))
	# the Runs card: the sky's row and the clock line, the site's state; everything fits
	sim.weather[1] = "Rain"
	sim.elapsed = 3600.0 * 14.0
	sim.site_crates = {"3": {"left": [{"key": "safe", "name": "Safe", "searches": 3, "done": 1, "finds": [], "locked": false}, {"key": "cardboard", "name": "Cardboard box", "searches": 1, "done": 0, "finds": [], "locked": false}], "at": sim.elapsed, "full": 6}}
	main.show_room(main.MISSIONS)
	main._missions._shown = ""
	main.refresh()
	var c: Dictionary = main._missions._cols[0]
	var card = c["card"]                      # the site card (BUILD46-S): the sky on the picture's chip, its words at the foot
	_check(card.foot.text.contains("Rain") or card.foot.text.contains("Night"), "the card does not show the sky's words: '%s'" % card.foot.text)
	_check(card.sky.text.begins_with("23:00") and card.sky.text.to_lower().contains("rain"), "the card's clock chip is off: %s" % card.sky.text)
	_check(card.here_right.text.begins_with("Safe") or card.here_right.text.contains("left"), "the card does not say what's left at the site: '%s'" % card.here_right.text)
	_check_fit(main, "Runs (night, rain, picked over)")
	var d: Dictionary = JSON.parse_string(JSON.stringify(sim.to_dict()))
	sim.load_dict(d)
	_check(sim.weather[1] == "Rain" and sim.site_stock(3).size() == 3 and Array(sim.site_stock(3)[0]).size() == 2, "the sky and the crates left did not save: %s" % str(sim.site_stock(3)))
	sim.load_dict(saved)
	print("the places changing ok: the crates kept and back, the clock's night, rain and fog by zone, never on the radio, the card")


## Faces for the people who matter: a line when a head is armed, his face on
## the run screen while he's out (where the art exists), and the Caravan's
## runners before as a wall of small faces with the line beside it.
func _faces_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	for b in Data.BOSSES:
		_check(Words.BOSSES.has(b["name"]) and Words.BOSSES[b["name"]].has("armed") and str(Words.BOSSES[b["name"]]["armed"]).ends_with("."), "%s has no line for being armed" % b["name"])
	_finish_campaign(sim)
	sim.notes = 1000
	var bt := 5                                  # the Retail Park, the Carpet Man's (index 5 since the Outskirts)
	sim.best_depth[bt] = maxi(sim.best_depth[bt], 1)
	sim.arm_boss(bt, false)
	var armed_line: String = sim.boss_of(bt)["name"] + ": " + Words.BOSSES[sim.boss_of(bt)["name"]]["armed"]
	var n0: int = sim.events.filter(func(ev): return str(ev[1]) == armed_line).size()
	sim.arm_boss(bt, true)
	var n1: int = sim.events.filter(func(ev): return str(ev[1]) == armed_line).size()
	_check(sim.boss_armed.get(bt, false) and n1 == n0 + 1 and str(sim.events.back()[1]) == armed_line, "arming the head had no line: %s" % str(sim.events.back()))
	sim.arm_boss(bt, true)
	_check(sim.events.filter(func(ev): return str(ev[1]) == armed_line).size() == n1, "arming an armed head spoke twice")
	# the run screen's face slot follows the head; the fit holds either way
	sim.words[bt] = []
	sim.hp = sim.max_hp()
	sim.deploy(bt)
	var m: Dictionary = sim.mission
	m["remaining"] = 1
	m["target_hp"] = 0.1                  # the last of the pool drops: the head comes out
	sim.advance(4.0)                      # past a melee wait or an underlay's grace
	_check(m.has("boss") and m["boss"]["started"], "the head did not come out")
	main.show_room(main.MISSIONS)        # on a run, Runs is the run screen
	main.refresh()
	var face_file := "res://art/people/%s.png" % Items.slug(m["boss"]["name"])
	var has_face: bool = ResourceLoader.exists(face_file) or FileAccess.file_exists(face_file)
	_check(not has_face or main._run._fight_face["art"].texture == People.portrait(m["boss"]["name"]), "the fight's face does not show the head where his art is")
	_check(main._run._fight["head"].text == "THE FIGHT · " + str(m["boss"]["name"]).to_upper(), "the head's name is not in the fight's kicker: '%s'" % main._run._fight["head"].text)
	_check_fit(main, "Run (the head out)")
	sim.extract_now()
	# the wall: three runners before, their faces where the art is
	sim.past = [{"class": "Doorman", "level": 9, "runs": 12, "end": "died in the Parade"}, {"class": "Poacher", "level": 14, "runs": 30, "end": "moved on"}, {"class": "Scrapper", "level": 4, "runs": 3, "end": "died in Ransacked Streets"}]
	main.show_room(main.BARRACKS)
	main._barracks._shown = ""
	main._barracks.selected = ""
	main.refresh()
	# the faces went with the strip (8 Oct): the line alone, newest first; the wall is a card in the Runner room
	_check(main._barracks._past.text.begins_with("Before: a Scrapper, 3 runs") or main._barracks._past.text.begins_with("a Scrapper, 3 runs") or main._barracks._past.text.begins_with("Before: Scrapper"), "the line beside the wall is off: %s" % main._barracks._past.text)
	_check_fit(main, "Caravan (the wall)")
	main.show_room(main.RUNNER)
	main.refresh()
	var plates: Array = main._stats.cards["wall"]["plates"]
	_check(plates[0]["name"].text == "Scrapper · 4" and plates[1]["name"].text == "Poacher · 14" and plates[2]["name"].text == "Doorman · 9" and plates[3]["name"].text == "", "the wall's plates are off: %s / %s / %s" % [plates[0]["name"].text, plates[1]["name"].text, plates[2]["name"].text])
	_check(plates[0]["line"].get_theme_color("font_color") == Pal.BAD and plates[1]["line"].get_theme_color("font_color") == Pal.GOOD, "a lost runner's plate does not read as lost, or one moved on as lost")
	_check_fit(main, "Stats (the wall)")
	sim.past = []
	main.show_room(main.BARRACKS)
	main._barracks._shown = ""
	main.refresh()
	_check(not main._barracks._past.text.begins_with("Before"), "the strip names runners before with nobody before: '%s'" % main._barracks._past.text)
	sim.load_dict(saved)
	print("faces ok: the heads' armed lines, the face slot on the run, the wall of runners before")


## Stacks: rounds of a base merge in the stash and the pack to five boxes'
## worth, a bottle onto the bottles to ten; a take tops up the rig's stack
## first and splits the rest; fitting takes one bottle off the stack; a strip
## puts it back on; the value follows what the stack holds.
func _stack_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	sim.stash = sim.stash.filter(func(it): return not Items.is_ammo(it) and not Items.is_socketable(it))
	sim.rig = []
	sim.cash = 100000.0
	var cap_nails: int = 200 * Data.STACK_BOXES
	sim.stash_put(sim._plain(Data.AMMO, "Nails"))
	sim.stash_put(sim._plain(Data.AMMO, "Nails"))
	var nails: Array = sim.stash.filter(func(it): return Items.is_ammo(it) and it["base"] == "Nails")
	_check(nails.size() == 1 and int(nails[0]["rounds"]) == 400 and nails[0]["value"] == 40, "two boxes of nails did not make one stack of 400 worth two boxes: %s" % str(nails))
	for k in range(5):
		sim.stash_put(sim._plain(Data.AMMO, "Nails"))
	nails = sim.stash.filter(func(it): return Items.is_ammo(it) and it["base"] == "Nails")
	_check(nails.size() == 2 and int(nails[0]["rounds"]) == cap_nails and int(nails[1]["rounds"]) == 400, "seven boxes did not make a full stack and a second: %s" % str(nails.map(func(it): return it["rounds"])))
	var shells: Dictionary = sim._plain(Data.AMMO, "Shells")
	sim.stash_put(shells)
	_check(sim.stash.filter(func(it): return Items.is_ammo(it) and it["base"] == "Shells").size() == 1, "shells joined the nails")
	# buying tops the stack, no cell needed when it fits
	var cells: int = sim.stash_used()
	var before: int = int(nails[1]["rounds"])
	_check(sim.buy_ammo("improvised") and int(nails[1]["rounds"]) == before + 200 and sim.stash_used() == cells, "a bought box did not join the stack: %d -> %d, cells %d -> %d" % [before, int(nails[1]["rounds"]), cells, sim.stash_used()])
	# the rig (30 Oct, magazines as items): a box never goes into the rig - the take is refused, the stack stays whole in
	# the stash; a magazine goes in whole, a pouch, and leaving puts it back
	var full: Dictionary = nails[0]
	_check(not sim.take(full["id"]) and sim.rig.is_empty() and int(full["rounds"]) == cap_nails and sim.stash.has(full), "a box went into the rig: rig %s, stash %d" % [str(sim.rig.map(func(x): return x["base"])), int(full["rounds"])])
	var nmag: Dictionary = sim._plain(Data.MAGAZINE, "Nail magazine")
	sim.stash.append(nmag)
	_check(sim.take(nmag["id"]) and sim.rig.size() == 1 and sim.rig[0] == nmag and not sim.stash.has(nmag), "a magazine didn't go into the rig whole")
	_check(sim.leave(nmag["id"]) and sim.rig.is_empty() and sim.stash.has(nmag), "a magazine left didn't go back to the stash")
	sim.stash.erase(nmag)
	# the pack: found rounds join the found stack
	sim.words[3] = []
	sim.set_depth(3, 1)
	sim.hp = sim.max_hp()
	sim.deploy(3)
	var m: Dictionary = sim.mission
	m["found"] = [sim._plain(Data.AMMO, "Shells")]
	var fake: Dictionary = sim._plain(Data.AMMO, "Shells")
	# a find of shells through the pack rule
	if sim.pack_used(m) + 1 <= sim.capacity():
		sim.stash_put(fake)         # not the pack; just to use the roll - the merge below is the real check
	var found_box: Dictionary = sim._plain(Data.AMMO, "Shells")
	# call the pack rule the way _find does
	var it2: Dictionary = found_box
	if Items.stacks(it2):
		for f in m["found"]:
			if Items.same_stack(f, it2) and Items.stack_size(f) < Items.stack_cap(f):
				var moved: int = mini(Items.stack_cap(f) - Items.stack_size(f), Items.stack_size(it2))
				Items.set_stack(f, Items.stack_size(f) + moved)
				Items.set_stack(it2, Items.stack_size(it2) - moved)
	_check(int(m["found"][0]["rounds"]) == 300 and Items.stack_size(it2) == 0, "found shells did not join the found stack")
	sim.extract_now()
	# bottles: ten to a stack, one off for a socket, back on from a strip
	var fluid: Dictionary = sim._plain(Data.ATTACHMENT, "Lighter fluid")
	_check(Items.stacks(fluid) and fluid.get("count", 0) == 1 and fluid["affixes"].is_empty(), "a bottle is not a plain stackable")
	for k in range(3):
		sim.stash_put(sim._plain(Data.ATTACHMENT, "Lighter fluid"))
	var fluids: Array = sim.stash.filter(func(it): return Items.is_socketable(it) and it["base"] == "Lighter fluid")
	_check(fluids.size() == 1 and int(fluids[0]["count"]) == 3 and fluids[0]["value"] == 360, "three bottles did not stack: %s" % str(fluids.map(func(it): return it.get("count", 0))))
	var rolled: Dictionary = Items.roll(Data.ATTACHMENT, 6, sim.rng)
	var tries := 0
	while rolled["mount"] != "socket" and tries < 200:
		rolled = Items.roll(Data.ATTACHMENT, 6, sim.rng)
		tries += 1
	_check(rolled["mount"] != "socket" or (rolled["affixes"].is_empty() and rolled["rarity"] == 0), "a rolled socketable carries affixes: %s" % str(rolled))
	var gun: Dictionary = sim._plain("Primary", "Army SMG")
	gun["attachments"]["socket 1"] = null
	var old_gun = sim.equipped["Primary"]
	sim.equipped["Primary"] = gun
	_check(sim.fit("Primary", fluids[0]["id"]) and gun["attachments"]["socket 1"] != null and int(gun["attachments"]["socket 1"]["count"]) == 1 and int(fluids[0]["count"]) == 2 and sim.stash.has(fluids[0]), "fitting did not take one bottle off the stack: socket %s, stack %d" % [str(gun["attachments"]["socket 1"]), int(fluids[0]["count"])])
	_check(sim.strip("Primary", "socket 1") and int(fluids[0]["count"]) == 3, "the strip did not put the bottle back on the stack: %d" % int(fluids[0]["count"]))
	for k in range(9):
		sim.stash_put(sim._plain(Data.ATTACHMENT, "Lighter fluid"))
	fluids = sim.stash.filter(func(it): return Items.is_socketable(it) and it["base"] == "Lighter fluid")
	_check(fluids.size() == 2 and int(fluids[0]["count"]) == Data.SOCKET_STACK and int(fluids[1]["count"]) == 2, "twelve bottles did not make ten and two: %s" % str(fluids.map(func(it): return it.get("count", 0))))
	main.show_room(main.ARMOURY)
	main.refresh()
	_check_fit(main, "Lock-up (stacks)")
	sim.equipped["Primary"] = old_gun
	var d: Dictionary = sim.to_dict()
	sim.load_dict(d)
	_check(sim.stash.any(func(it): return Items.is_socketable(it) and int(it.get("count", 1)) == Data.SOCKET_STACK), "the stack did not save")
	sim.load_dict(saved)
	print("stacks ok: rounds merge to five boxes, bottles to ten, the buy, a box never in the rig, a magazine in and out, the pack, one off for a socket and back, the save")


## The first ten minutes: what's next, in the voice, on the Runner card and
## in the log when it changes - the past, the first run, the site, the head,
## the campaign done, the move.
func _next_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	var fresh = load("res://scripts/sim/sim.gd").new()
	fresh.start()
	_check(fresh.next_words() == Words.NEXT["past"] and fresh.events.any(func(ev): return str(ev[1]) == Words.NEXT["past"]), "a new pitch does not say to pick a past: %s" % fresh.next_words())
	_set_cls(fresh, "Doorman")
	_check(fresh.next_words() == Words.NEXT["first"] and str(fresh.events.back()[1]) == Words.NEXT["first"], "a runner with a past is not sent out: %s" % str(fresh.events.back()))
	_check(fresh.next_words(true) == Words.NEXT_SHORT["first"], "the short form is off: %s" % fresh.next_words(true))
	# after the first run: the next site; then the head; then the next lot
	fresh.hp = fresh.max_hp()
	fresh.deploy(0)                              # a new yard starts at the Outskirts (12 Oct)
	fresh.extract_now()
	_check(fresh.next_words().begins_with("The Allotments hasn't") or fresh.next_words().begins_with("The Garden Centre hasn't"), "after the first run the next site is not named: %s" % fresh.next_words())
	for i in [0, 1, 2]:
		fresh.best_depth[i] = 1
	_check(fresh.next_words() == Words.NEXT["head"] % ["The Gamekeeper", "Top Farm"], "the Outskirts' head is not named: %s" % fresh.next_words())     # 13 Oct
	fresh.bosses_beaten[0] = true
	for i in [3, 4, 5]:
		fresh.best_depth[i] = 1
	_check(fresh.next_words() == Words.NEXT["head"] % ["The Carpet Man", "the Retail Park"] and fresh.next_words(true) == "Arm the Carpet Man on the Map", "the head is not named: %s / %s" % [fresh.next_words(), fresh.next_words(true)])
	fresh.bosses_beaten[1] = true
	fresh.xp = maxf(fresh.xp, Data.xp_for_level(fresh.zone_gate(2)))     # the Town opens at its level (19 Oct)
	_check(fresh.next_words() == Words.NEXT["site"] % "The Pleasure Park", "the town's first site is not named: %s" % fresh.next_words())
	fresh.hp = fresh.max_hp()
	fresh.deploy(0)
	fresh.extract_now()
	_check(fresh.events.any(func(ev): return str(ev[1]) == Words.NEXT["site"] % "The Pleasure Park"), "the log did not carry the change")
	var n1: int = fresh.events.size()
	fresh.hp = fresh.max_hp()
	fresh.deploy(0)
	fresh.extract_now()
	_check(not fresh.events.slice(n1).any(func(ev): return str(ev[1]).begins_with("The Pleasure Park hasn't")), "the log said the same thing twice")
	_finish_campaign(sim)
	_check(sim.next_words() == Words.NEXT["done"] and sim.next_words().contains("Radio"), "the campaign done doesn't point at the Radio: %s" % sim.next_words())     # signals, 15 Oct
	main.show_room(main.OVERVIEW)
	_check_fit(main, "The Pitch (what's next)")
	sim.load_dict(saved)
	print("what's next ok: the past, the first run, the site, the head, the next lot, once in the log, the campaign done")


## Idle quality of life: two toggles on the Lock-up with nothing selected -
## the best of each slot goes on when a run comes home, and the common gear
## goes to the Fence (never rounds, meds, bottles, papers, uniques or sets).
func _idle_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	main.show_room(main.ARMOURY)
	main._armoury.selected = {}
	main.refresh()
	_check(main._armoury._toggles[0].visible and main._armoury._toggles[1].visible and main._armoury._toggles[2].visible, "the idle toggles and the junk rules are not on the Lock-up")
	_check_fit(main, "Lock-up (idle toggles)")
	main._armoury._toggle(0)
	main._armoury._toggle(1)
	_check(sim.auto_equip and sim.junk_upto >= 0 and main._armoury._toggles[0].text.ends_with("✓"), "the toggles did not turn on")
	_check_fit(main, "Lock-up (idle toggles on)")
	# a run home: the junk goes, the better piece goes on, the rest stays
	while not sim.stash_room(12) and not sim.stash.is_empty():
		sim.sell(sim.stash[0])
	sim.stash = sim.stash.filter(func(x): return x.get("slot", "") != "Armour")     # no armour of the run's own better than the one put in (a 1-in-7 flake, 9 Oct)
	var junk: Dictionary = sim._plain("Helmet", "Hard hat")
	var keep_ammo: Dictionary = sim._plain(Data.AMMO, "Nails")
	var keep_med: Dictionary = sim._plain(Data.MEDICAL, "Bandage")
	var keep_bottle: Dictionary = sim._plain(Data.ATTACHMENT, "Lighter fluid")
	var better: Dictionary = sim._plain("Armour", "Riot suit")
	better["rarity"] = 2
	better["affixes"] = [{"stat": "hp", "value": 40.0, "tier": 3}]
	for it in [junk, keep_ammo, keep_med, keep_bottle, better]:
		sim.stash_put(it)
	sim.equipped["Armour"] = sim._plain("Armour", "Stab vest")
	sim.equipped["Helmet"] = sim._plain("Helmet", "Visored helmet")     # the hard hat junk only when it's no upgrade (the junk rules keep upgrades, 11 Oct)
	sim.words[3] = []
	sim.hp = sim.max_hp()
	sim.deploy(3)
	sim.mission["found"] = sim.mission["found"].filter(func(x): return Items.is_ammo(x))     # the gate's boxes come home (BUILD45: the camp at 1 s odds packs the nails' box for the refills)
	sim.extract_now()
	_check(not sim.stash.has(junk) and (sim.stash.any(func(x): return Items.is_ammo(x) and x["base"] == "Nails") or sim.rig.any(func(x): return str(x.get("ammo", "")) == "Nails")) and (sim.stash.has(keep_med) or sim.rig.has(keep_med)) and sim.stash.has(keep_bottle), "the junk run sold the wrong things: junk %s ammo %s med %s bottle %s" % [sim.stash.has(junk), sim.stash.has(keep_ammo), sim.stash.has(keep_med) or sim.rig.has(keep_med), sim.stash.has(keep_bottle)])     # the gate carries the med now (23 Oct)
	_check(sim.equipped["Armour"] != null and sim.equipped["Armour"]["id"] == better["id"], "the better armour did not go on")
	_check(sim.events.any(func(ev): return str(ev[1]).begins_with("The Fence took the junk")) and sim.events.any(func(ev): return str(ev[1]).begins_with("Put on: ")), "the idle tidy had no lines")
	main._armoury._toggle(0)
	for k in range(3):
		main._armoury._toggle(1)              # the sell rule goes round: to uncommon, to rare, off
	_check(not sim.auto_equip and sim.junk_upto == -1, "the toggles did not turn off")
	var d: Dictionary = sim.to_dict()
	sim.junk_upto = 0
	d = sim.to_dict()
	sim.load_dict(d)
	_check(sim.junk_upto == 0, "the toggle did not save")
	sim.load_dict(saved)
	print("idle ok: the toggles, the junk run, equip if better, the lines, the save")
	_junk_rule_checks(main)
	_upgrade_arrow_checks(main)
	_came_back_checks(main)
	_rig_checks(main)
	_build_rounds_checks(main)
	_skull_checks(main)
	_card_frame_checks(main)


## Juice: the log's best lines as toasts under the top bar, a damage number
## off the run panel as the hits land, a flash on a rare in the pack.
## The run view's gun goes off once, standing (13 Oct: your hits show on its shots): a no-op with no run view.
func _shoot(main) -> void:
	var v = main._run._view
	if v == null:
		return
	v._duck = 0.0
	v._duck_t = 0.0
	v._duck_next = 99.0
	v._process(RunView.POP_S + 0.1)            # anyone coming in is up by now
	if not v._figs.any(func(f): return f["state"] == "up"):
		v._figs[0]["state"] = "up"              # between gangs nobody stands; a swing needs someone to land on (14 Oct, the flaky check)
	if v._target_k >= 0 and v._figs[v._target_k]["state"] == "pop":
		v._figs[v._target_k]["state"] = "up"    # the one you're hitting still coming in: the kick, no hit (19 Oct, the flaky check: 0 shots, 3 up)
	v._firing = true
	v._swing = -1.0
	v._stop_t = 0.0                  # no hit-stop left over from the last hit (27 Oct)
	v._shot_t = 0.0
	v._process(0.01)
	if v._swing >= 0.0:
		v._process(v._swing_len * RunView.SWING_CONTACT)     # a melee swing's hit lands on the chop


## The hit registers (27 Oct, Matt; the canvas's "Hit registers, take 2"): a solid hit holds the frame, knocks the
## figure back, sprays and knocks a chunk off its bar; a light one sprays alone; a kill holds longer; the numbers are
## big, edged and pop; your bar keeps the lost chunk white a moment; a big hit on you jolts, a scratch doesn't.
func _hit_register_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	sim.hp = sim.max_hp()
	sim.deploy(3)
	main.show_room(main.MISSIONS)
	main.refresh()
	var v = main._run._view
	if v == null:
		sim.extract_now()
		sim.load_dict(saved)
		return
	v._duck = 0.0                                 # standing: the duck moves the scene a frame behind the figures (28 Oct, the flaky read)
	v._duck_t = 0.0
	v._duck_next = 99.0
	v._process(RunView.POP_S + 0.1)
	if not v._figs.any(func(f): return f["state"] == "up"):
		v._set_state(0, "up")
	var k: int = range(v._figs.size()).filter(func(i): return v._figs[i]["state"] == "up")[0]
	v._stop_t = 0.0
	v._since_stop = 99.0
	v._target_k = k
	var b0: int = v.bursts
	var i0: int = v.impacts
	v._last_hit = {"k": k, "at": Vector2(300, 150)}
	v.impact("physical", 0.01)
	_check(v.bursts == b0 + 1 and v.impacts == i0 and is_equal_approx(v._stop_t, 0.0), "a light hit held the frame or sprayed nothing: %d bursts, stop %.2f" % [v.bursts - b0, v._stop_t])
	v._last_hit = {"k": k, "at": Vector2(300, 150)}
	v.impact("fire", 0.2)
	_check(v.impacts == i0 + 1 and v._stop_t > 0.0 and float(v._figs[k].get("kick_t", 0.0)) > 0.0, "a solid hit didn't hold, knock or spray: stop %.2f, kick %.2f" % [v._stop_t, float(v._figs[k].get("kick_t", 0.0))])
	v._process(0.02)
	_check(v._stop_t > 0.0 and v._stop_t < RunView.STOP_S, "the hold didn't run down in part: %.3f" % v._stop_t)
	# every figure up stands on its slot: its feet, as drawn, on the slot's foot (28 Oct: a pivot put the far ones off)
	for i in range(v._figs.size()):
		var fr: TextureRect = v._figs[i]["rect"]
		if v._figs[i]["state"] == "up" and fr.texture != null and is_zero_approx(float(v._figs[i].get("kick_x", 0.0))):
			var ub: Rect2 = RunView.used_of(fr.texture)
			var feet: Vector2 = fr.get_transform() * Vector2(ub.get_center().x, ub.end.y)
			var want: Vector2 = v.slot_of(i)["foot"] + Vector2(v._pan * -0.6, -RunView.DUCK_SCENE * v._duck)
			_check(feet.distance_to(want) < 1.5, "figure %d's feet are drawn at %s, its slot at %s (scale %.2f)" % [i, str(feet), str(want), fr.scale.x])
	v._process(RunView.STOP_S + RunView.KICK_S * 0.5)
	# tilted, the feet stay put: the kick's lean is about them, at any scale
	var kr: TextureRect = v._figs[k]["rect"]
	var kub: Rect2 = RunView.used_of(kr.texture)
	var kfeet: Vector2 = kr.get_transform() * Vector2(kub.get_center().x, kub.end.y)
	var kwant: Vector2 = v.slot_of(k)["foot"] + Vector2(v._pan * -0.6 + float(v._figs[k].get("kick_x", 0.0)), -RunView.DUCK_SCENE * v._duck)
	_check(absf(kr.rotation) > 0.0 and kfeet.distance_to(kwant) < 1.5, "a tilted figure's feet left its spot: %s, not %s" % [str(kfeet), str(kwant)])
	_check(absf(float(v._figs[k].get("kick_x", 0.0))) > 1.0 and absf(v._figs[k]["rect"].rotation) > 0.0, "the hit didn't knock the figure back and tilt it: %.1f px" % float(v._figs[k].get("kick_x", 0.0)))
	# the flames lean with the body (28 Oct, the reviewer's follow-up to e3216f5): on its tilted middle, turned as it is
	var fire_was: bool = v._them_fx.get("fire", false)
	v._them_fx["fire"] = true
	v._process(0.001)
	var fp_fx = v._figs[k]["fx"].get("fire")
	_check(fp_fx != null and v._figs[k]["state"] in ["pop", "up"], "the fixture: the kicked figure's flames aren't up (%s, %s)" % [str(fp_fx != null), str(v._figs[k]["state"])])     # 28 Oct, the tools review: the guard was silent
	if fp_fx != null and v._figs[k]["state"] in ["pop", "up"]:
		var on_body: Vector2 = kr.get_transform() * Vector2(kr.size.x * 0.5, kr.size.y * 0.55)
		_check(is_equal_approx(fp_fx.rotation, kr.rotation) and fp_fx.position.distance_to(on_body) < 1.5, "the flames don't lean with a tilted body: %s turned %.2f, the body's middle %s turned %.2f" % [str(fp_fx.position), fp_fx.rotation, str(on_body), kr.rotation])
	v._them_fx["fire"] = fire_was
	v._process(RunView.KICK_S)
	v._last_hit = {"k": k, "at": Vector2(300, 150)}
	v.impact("fire", 0.2)
	_check(is_zero_approx(v._stop_t), "a hit straight after a hold held the frame again (a stream would slow it)")
	v._process(RunView.KICK_S)
	_check(is_zero_approx(float(v._figs[k].get("kick_x", 0.0))) and is_zero_approx(v._figs[k]["rect"].rotation), "the figure didn't spring back: %.1f px" % float(v._figs[k].get("kick_x", 0.0)))
	# the numbers: big ones bigger, edged, popping in
	main._juice.clear_numbers()
	main._juice.number(Vector2(400, 300), "48", "physical", true)
	main._juice._process(0.01)
	var nl: Label = main._juice._numbers.back()["label"]
	_check(nl.get_theme_constant("outline_size") >= 4 and nl.scale.x > 1.1 and not is_zero_approx(nl.rotation), "a big number isn't edged, popping and tilted: outline %d, scale %.2f" % [nl.get_theme_constant("outline_size"), nl.scale.x])
	main._juice.clear_numbers()
	# your bar: the lost chunk white, then drained
	var rb: Dictionary = main._run._runner
	main._run._bar(rb, 1.0, "x", "good")
	main._run._bar(rb, 0.6, "x", "good")
	_check(rb["ghost"].visible and rb["ghost"].size.x > rb["fill"].size.x, "your bar didn't keep the lost chunk")
	rb["ghost_at"] = Time.get_ticks_msec() - 2000
	for n in range(30):
		main._run._bar(rb, 0.6, "x", "good")
	_check(not rb["ghost"].visible, "the lost chunk didn't drain")
	# a scratch on you: red, no jolt; a big one: the jolt
	v._jolt = 0.0
	v._hp_seen = sim.hp
	sim.hp -= sim.max_hp() * 0.02
	v.show_state(sim, sim.mission)
	_check(v._red_a > 0.3 and is_zero_approx(v._jolt), "a scratch jolted the frame or showed no red: jolt %.2f, red %.2f" % [v._jolt, v._red_a])
	v._hp_seen = sim.hp
	sim.hp -= sim.max_hp() * 0.2
	v.show_state(sim, sim.mission)
	_check(v._jolt > 0.0 and v._red_a > 0.9, "a big hit didn't jolt the frame: jolt %.2f, red %.2f" % [v._jolt, v._red_a])
	sim.hp = sim.max_hp()
	sim.extract_now()
	sim.load_dict(saved)
	main.refresh()
	print("the hit registers ok: the hold, the knock, the spray, the chunk; the numbers; your bar's white; the red and the jolt")


func _juice_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	main.refresh()
	sim.log_event("Found: Lucky Cap")
	sim.log_event("Trained: Stance")
	main.refresh()
	var shown: Array = main._juice.toasts()
	_check(not shown.is_empty() and shown[0] == "Found: Lucky Cap" and not shown.has("Trained: Stance"), "the find did not toast, or the training did: %s" % str(shown))
	_check(Words.toast_tone("The Carpet Man comes out. He's brought the whole warehouse.") == "warn" and Words.toast_tone("The Carpet Man is down. x") == "good" and Words.toast_tone("Dead in the Parade. Kit lost (£100).") == "bad" and Words.toast_tone("Out to The Parade, The Estate, depth 1: night") == "none", "the toast tones are off")
	for k in range(5):
		sim.log_event("Level %d: 1 training point" % (k + 50))
	main.refresh()
	_check(main._juice.toasts().size() <= main._juice.TOAST_MAX, "the toasts piled past three")
	for t in main._juice.text_nodes():
		_check(t.text != "" and UI.text_width(t, t.text) <= t.size.x, "a toast does not fit: %s" % t.text)
	# the run: numbers as the hits land, a flash on a rare
	sim.words[3] = []
	sim.hp = sim.max_hp()
	sim.deploy(3)
	main.show_room(main.MISSIONS)
	main.refresh()
	main._juice.clear_numbers()
	var n0: int = 0
	sim.mission["t"]["hp"] = 100000.0        # a lot that takes a while, so the hits are seen landing
	sim.mission["target_hp"] = 100000.0
	for k in range(4):                         # in steps, as the screen sees a run
		sim.advance(0.5)
		main.refresh()
	var pend0: Dictionary = main._run._hit_pending.duplicate()
	var fired := [0]
	var count_shot := func(_at): fired[0] += 1
	if main._run._view != null:
		main._run._view.shot_fired.connect(count_shot)
	_shoot(main)
	if main._run._view != null:
		main._run._view.shot_fired.disconnect(count_shot)
	# what it saw, when it fails (17 Oct, Matt: "change the check" - it failed once and passed on the rerun): the hits
	# waiting before the shot and after, the shots the view fired, who was up, the gun in hand
	var v_n = main._run._view
	_check(main._juice.numbers() > n0, "no number came off the hits: dealt %.0f; waiting %s before the shot, %s after; %d shot(s) fired; %d up, firing %s, swing %.2f, melee %s; gun %s; target %d (%s), duck %.2f" % [
		float(sim.mission.get("dealt", 0.0)), str(pend0), str(main._run._hit_pending), fired[0],
		v_n.figures_up() if v_n != null else -1, str(v_n._firing) if v_n != null else "-", float(v_n._swing) if v_n != null else -1.0,
		str(v_n._melee) if v_n != null else "-", str(RunView.gun_in_hand(sim)["base"]) if RunView.gun_in_hand(sim) != null else "none",
		int(v_n._target_k) if v_n != null else -1, str(v_n._figs[v_n._target_k]["state"]) if v_n != null and v_n._target_k >= 0 else "-", float(v_n._duck) if v_n != null else -1.0])
	# scattered: a run of numbers lands at different places, not one column; no more than one a third of a second
	main._juice.clear_numbers()
	var spots := {}
	for k in range(8):
		sim.advance(0.4)
		main.refresh()
		_shoot(main)
	for n in main._juice._numbers:
		spots["%d,%d" % [int(n["label"].position.x / 20), int(n["from"] / 8)]] = true
	_check(main._juice.numbers() >= 4 and main._juice.numbers() <= 18 and spots.size() >= 3, "the numbers come as one column or too thick: %d numbers in %d places" % [main._juice.numbers(), spots.size()])
	# red for damage taken, green for what came back, counted apart: a helmet's regen shows among the hits
	main._juice.clear_numbers()
	main.refresh()
	sim.mission["elapsed"] += 1.0
	sim.mission["taken"] = float(sim.mission.get("taken", 0.0)) + 20.0
	sim.mission["taken_by"] = sim.mission.get("taken_by", {})
	sim.mission["taken_by"]["physical"] = float(sim.mission["taken_by"].get("physical", 0.0)) + 20.0
	sim.mission["healed"] = float(sim.mission.get("healed", 0.0)) + 3.0
	main._run._they_shot = true                 # in the frame what you took comes out as they fire (27 Oct): one just did
	main.refresh()
	var texts: Array = main._juice._numbers.map(func(n): return n["label"].text)
	_check(texts.any(func(t): return str(t).begins_with("−2")) and texts.any(func(t): return str(t).begins_with("+")), "the red and the green do not both show for a second that took 20 and gave 3 back: %s" % str(texts))
	# the numbers carry their type's colour: a fire hit on them reads red, a physical one white, poison on you green
	main._juice.clear_numbers()
	var hold_gun = sim.equipped["Primary"]
	var torch: Dictionary = sim._plain("Primary", "Nail gun")
	torch["affixes"] = [{"stat": "conv_fire_pct", "value": 50, "tier": 3}]
	sim.equipped["Primary"] = torch
	sim.rig.append(_rmag(sim, "Nails"))
	sim.mission["t"]["types"] = {"physical": 0.2, "poison": 0.8}
	sim.mission["elapsed"] += 1.0
	var colours := {}
	for k in range(8):
		sim.advance(0.5)
		sim.mission["taken"] = float(sim.mission.get("taken", 0.0)) + 4.0     # their poison landing for sure: a gang between shots or a
		sim.mission["taken_by"]["poison"] = float(sim.mission["taken_by"].get("poison", 0.0)) + 4.0     # resisting kit took too little to number (19 Oct, the flaky check)
		main.refresh()
		_shoot(main)
		for n in main._juice._numbers:                      # gathered as they come: twelve show at once, the rest go
			colours[n["label"].get_theme_color("font_color")] = true
	_check(colours.has(Pal.ELEMENT_COLOURS["fire"]) and colours.has(Pal.ELEMENT_COLOURS["physical"]), "the hits did not come in fire and physical colours: dealt_by %s" % str(sim.mission.get("dealt_by", {})))
	_check(colours.has(Pal.ELEMENT_COLOURS["poison"]), "their poison on you did not come up green: taken_by %s, poison resist %.0f" % [str(sim.mission.get("taken_by", {})), sim.resist("poison")])
	# and their typed fire lands as its type (the review: the colour above is fed; this is the sim's own split)
	var sp = Sim.new()
	sp.start()
	sp.mythics_on = false
	sp.deploy(0)
	if sp.on_mission():
		var mm: Dictionary = sp.mission
		mm["t"]["types"] = {"physical": 0.2, "poison": 0.8}
		mm["t"]["dps"] = 2.0
		mm["target_hp"] = 1e9
		mm["t"]["hp"] = 1e9
		mm["guard"] = 0.0
		sp.hp = 1e6                              # can't go down in the seconds read
		for k in range(4):
			sp._tick(1.0)
		var tb: Dictionary = mm.get("taken_by", {})
		_check(float(tb.get("poison", 0.0)) > float(tb.get("physical", 0.0)) and float(tb.get("poison", 0.0)) > 0.0, "a gang firing 80%% poison landed it as: %s" % str(tb))
	else:
		_check(false, "the fixture: no run for the typed fire")
	var dealt_sum := 0.0
	for ty in sim.mission.get("dealt_by", {}):
		dealt_sum += float(sim.mission["dealt_by"][ty])
	_check(absf(dealt_sum - float(sim.mission["dealt"])) < 1.0, "dealt by type (%.0f) does not add up to dealt (%.0f)" % [dealt_sum, float(sim.mission["dealt"])])
	sim.equipped["Primary"] = hold_gun
	# the run view: your hits only on its shots - none while you're down behind the wall, what was held on the first
	# shot back up, nothing lost (Matt, 13 Oct: the white numbers ran on while the gun didn't)
	var v = main._run._view
	if v != null:
		var run = main._run
		_shoot(main)
		run._hit_pending = {}
		main._juice.clear_numbers()
		var white: Color = Pal.ELEMENT_COLOURS["physical"]
		var hits0: float = float(sim.mission["dealt_by"].get("physical", 0.0)) - float(sim.mission.get("ticked_by", {}).get("physical", 0.0))
		v._duck_t = 5.0
		v._process(0.5)
		for k in range(4):
			sim.advance(0.4)
			main.refresh()
			v._process(0.1)
		var whites_down: Array = main._juice._numbers.filter(func(n): return (n["label"].get_theme_color("font_color") == white and not (str(n["label"].text).begins_with("−") or str(n["label"].text).begins_with("+"))))
		var held: float = float(sim.mission["dealt_by"].get("physical", 0.0)) - float(sim.mission.get("ticked_by", {}).get("physical", 0.0)) - hits0
		_check(held >= 1.0 and whites_down.is_empty(), "hits showed while ducked, or none were dealt: %d shown, %.0f dealt" % [whites_down.size(), held])
		_check(absf(float(run._hit_pending.get("physical", 0.0)) - held) < 1.0, "what was dealt ducked isn't all held: %.1f of %.1f" % [float(run._hit_pending.get("physical", 0.0)), held])
		_shoot(main)
		var out: Array = main._juice._numbers.filter(func(n): return (n["label"].get_theme_color("font_color") == white and not (str(n["label"].text).begins_with("−") or str(n["label"].text).begins_with("+"))))
		_check(out.size() == 1 and absi(int(out[0]["label"].text) - int(floor(held))) <= 1 and float(run._hit_pending.get("physical", 0.0)) < 1.0, "the first shot back up didn't bring out what was held: %s against %.0f" % [str(out.map(func(n): return n["label"].text)), held])
		# back after time away: what was dealt unseen isn't saved up for one number
		main._juice.clear_numbers()
		sim.advance(15.0)
		main.refresh()
		_shoot(main)
		_check(main._juice._numbers.filter(func(n): return (n["label"].get_theme_color("font_color") == white and not (str(n["label"].text).begins_with("−") or str(n["label"].text).begins_with("+")))).all(func(n): return int(n["label"].text) < int(held) + 50), "fifteen seconds away came out as one number")
		_check(float(run._hit_pending.get("physical", 0.0)) < 1.0, "time away was held")
		# between shots, standing: hits wait for the gun
		main._juice.clear_numbers()
		v._shot_t = 99.0
		sim.advance(0.4)
		main.refresh()
		_check(main._juice._numbers.filter(func(n): return (n["label"].get_theme_color("font_color") == white and not (str(n["label"].text).begins_with("−") or str(n["label"].text).begins_with("+")))).is_empty(), "a hit showed with no shot")
		v._shot_t = 0.0
	# the counters come from the fight: regen heals, their fire takes
	var hold = sim.equipped["Helmet"]
	var regen_hat: Dictionary = sim._plain("Helmet", "Hard hat")
	regen_hat["affixes"] = [{"stat": "regen", "value": 2.0, "tier": 2}]
	sim.equipped["Helmet"] = regen_hat
	sim.hp = sim.max_hp() * 0.5
	var healed0: float = float(sim.mission.get("healed", 0.0))
	var taken0: float = float(sim.mission.get("taken", 0.0))
	sim.advance(5.0)
	_check(float(sim.mission.get("healed", 0.0)) - healed0 >= 9.0, "five seconds of +2 regen did not count as healed: %.1f" % (float(sim.mission.get("healed", 0.0)) - healed0))
	_check(float(sim.mission.get("taken", 0.0)) > taken0, "their fire did not count as taken")
	sim.equipped["Helmet"] = hold
	var you_y: float = main._run._left.global_position.y + main._run.RUNNER_BAR_Y
	var them_y: float = main._run._left.global_position.y + main._run.FIGHT_BAR_Y
	var reds: Array = main._juice._numbers.filter(func(n): return n["label"].text.begins_with("−") or n["label"].text.begins_with("+"))
	var whites: Array = main._juice._numbers.filter(func(n): return not (n["label"].text.begins_with("−") or n["label"].text.begins_with("+")))
	if main._run._view != null:
		# the run view (13 Oct): yours from the frame's foot, theirs inside the frame; _run_view_checks keeps them off the chips
		var vr: Rect2 = main._run._view.get_global_rect()
		var jy: float = main._juice.global_position.y
		_check(reds.all(func(n): return n["from"] + jy > vr.end.y - 70 and n["from"] + jy < vr.end.y), "the red and green are not at the frame's foot")
		_check(whites.all(func(n): return n["from"] + jy > vr.position.y and n["from"] + jy < vr.end.y), "the hits are not in the frame")
	else:
		_check(reds.all(func(n): return n["from"] > you_y - main._juice.global_position.y - 40 and n["from"] < you_y - main._juice.global_position.y + 40), "the red and green are not on your bar (them %.0f, you %.0f)" % [them_y, you_y])
		_check(whites.all(func(n): return n["from"] > them_y - main._juice.global_position.y - 40 and n["from"] < them_y - main._juice.global_position.y + 40), "the hits are not on their bar")
	var rare: Dictionary = sim._plain("Helmet", "Hard hat")
	rare["rarity"] = 2
	sim.mission["found"].append(rare)
	main.refresh()
	var k: int = main._run._inv.cell_of(rare["id"])
	_check(k >= 0 and main._run._inv.cell_node(k).modulate != Color.WHITE, "the rare did not flash in the pack")
	sim.extract_now()
	main.refresh()
	sim.load_dict(saved)
	main.refresh()
	print("juice ok: the toasts and their tones, the cap, the fit, the numbers, the flash")


## Sound: every placeholder file reads; the zone's ambient while out, rain
## over it, the gun's tick, the sting, the door; off from the pause menu.
## The item's tone dressed (17 Oct, Matt: the item-colours canvas): no dressing on a common; a wash of its tone from
## uncommon; the glow from epic; a sheen on a unique; a mythic's sheen and pulse; a locked piece without the glow. And
## the three colours moved off what they read as.
func _dress_checks(main) -> void:
	var ItemCell := preload("res://scripts/ui/item_cell.gd")
	var sim = main.sim
	var cell = ItemCell.new()
	main.add_child(cell)
	var plain: Dictionary = sim._plain("Primary", "Pump shotgun")
	var cases := []
	for r in range(5):
		var it: Dictionary = plain.duplicate(true)
		it["rarity"] = r
		cases.append([it, r])
	var uq: Dictionary = Items.roll_unique(sim._unique_named("The Keeper's Twelve-Bore"), sim.rng)
	var my: Dictionary = Items.roll_unique(sim._unique_named("The Last Orders"), sim.rng)
	cases.append([uq, 5])
	cases.append([my, 6])
	for c in cases:
		cell.show_item(c[0], false)
		var d: Dictionary = cell.dress()
		var rank: int = c[1]
		var col: Color = Pal.tone_color(ItemCell.rarity_tone(c[0])) if rank > 0 else Color.TRANSPARENT
		_check(d["wash"] == (rank > 0) and (rank == 0 or (d["wash_colour"] as Color).is_equal_approx(Color(col, ItemCell.WASH))), "rank %d's wash: %s" % [rank, str(d)])
		_check(d["glow"] == (rank >= ItemCell.GLOW_FROM), "rank %d's glow: %s" % [rank, str(d)])
		_check(d["sheen"] == (rank >= 5) and d["pulse"] == (rank == 6) and cell.is_processing() == (rank == 6 and cell.is_visible_in_tree()), "rank %d's sheen or pulse: %s" % [rank, str(d)])
	cell.show_item(my, false)
	cell.set_locked(9)
	_check(not cell.dress()["glow"], "a locked mythic kept its glow over its fade")
	cell.queue_free()
	var far := func(a: Color, b: Color) -> float:
		return absf(a.r - b.r) + absf(a.g - b.g) + absf(a.b - b.b)
	_check(far.call(Pal.LEGENDARY, Pal.ACCENT) > 0.4 and far.call(Pal.SET, Pal.GOOD) > 0.4 and far.call(Pal.MYTHIC, Pal.BAD) > 0.3, "a rarity's colour still sits on the one it read as")
	print("the item's tone dressed: the wash from uncommon, the glow from epic, the sheen, the mythic's pulse")


## A mythic's moment (17 Oct): found on a run, the card over everything and the game held; it fits; Take it closes it;
## off the floor with room, it's taken; a loaded camp's own mythics aren't news.
func _mythic_moment_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.hp = sim.max_hp()
	sim.deploy(0)
	var m: Dictionary = sim.mission
	m["event_at"] = -1.0
	main.show_room(main.MISSIONS)
	main.refresh()
	_check(main._mythic_card == null, "a mythic's card up with none found")
	var my: Dictionary = Items.roll_unique(sim._unique_named("The Last Orders"), sim.rng)
	m["found"].append(my)
	main.refresh()
	var card = main._mythic_card
	_check(card != null and is_instance_valid(card) and card.visible, "a mythic found and no card")
	if card == null:
		sim.load_dict(saved)
		return
	var t0: float = sim.elapsed
	main._process(0.5)
	_check(is_equal_approx(sim.elapsed, t0), "the game ran on under a mythic's card: %.2f to %.2f" % [t0, sim.elapsed])
	card._process(1.0)
	_check(card._card.modulate.a > 0.99 and card._take.text == "Take it", "the card isn't up a second in, or its button reads '%s'" % card._take.text)
	_check_nodes(card.text_nodes().filter(func(l): return l != card._words), [], "the mythic's card")     # the words wrap: their lines below
	_check(card._words.text != "" and card._words.get_line_count() <= 3, "the mythic's words: '%s' on %d lines" % [card._words.text, card._words.get_line_count()])
	card._on_take()
	main.refresh()
	_check(main._mythic_card == null, "Take it didn't close the mythic's card")
	main.refresh()
	_check(main._mythic_card == null, "the same mythic came round twice")
	# off the floor: Take it takes it
	if m.has("floor"):
		var my2: Dictionary = Items.roll_unique(sim._unique_named("The Spare Key"), sim.rng)
		sim.stash.clear()
		m["found"].clear()
		m["floor"].append(my2)
		main.refresh()
		var c2 = main._mythic_card
		_check(c2 != null and c2.where() == "floor", "a mythic on the floor: no card, or it isn't on the floor (%s)" % (c2.where() if c2 != null else "none"))
		if c2 != null:
			c2._process(1.0)
			c2._on_take()
			main.refresh()
			_check(m["found"].any(func(x): return int(x["id"]) == int(my2["id"])), "Take it left the mythic on the floor")
	sim.load_dict(saved)
	main._mythic_sim = null
	main.refresh()
	_check(main._mythic_card == null, "a camp loaded showed a mythic it already held")
	print("a mythic's moment: the card, the game held, it fits, Take it, off the floor")


## The early game (17 Oct, Matt's two playtests): the Garden Centre's first clear leaves a gun and its rounds, once; no
## rounds drop for a gun you haven't got, and those that drop fit one you have; no wound before the Clinic; resting at
## camp says so, on the top row and under a site's odds.
func _early_game_checks(main) -> void:
	var fresh = Sim.new()
	fresh.start()
	fresh.mythics_on = false
	fresh.best_tier = maxi(fresh.best_tier, Data.FIRST_GUN_SITE)
	fresh.best_depth[0] = 1
	fresh.hp = fresh.max_hp()
	fresh.deploy(Data.FIRST_GUN_SITE)
	var m = fresh.mission
	_check(m != null, "the fixture: no run to the Garden Centre")
	if m == null:
		return
	m["found"] = []
	fresh._clear(m, m["t"])
	var names: Array = Data.FIRST_GUNS.map(func(g): return str(g[1]))
	var guns: Array = m["found"].filter(func(it): return str(it["base"]) in names)
	var boxes: Array = m["found"].filter(func(it): return Items.is_ammo(it))
	_check(guns.size() == 1 and boxes.size() == 1 and str(Items.base_of(boxes[0])["type"]) == Items.ammo_type(guns[0]), "the Garden Centre's first clear didn't leave one gun and its rounds: %s" % str(m["found"].map(func(it): return str(it["base"]))))
	_check(guns.size() == 1 and fresh._pack_keeps(guns[0]) and fresh._pack_keeps(boxes[0]), "a full pack wouldn't keep the first gun and its rounds")
	m["cleared"] = false
	fresh._clear(m, m["t"])
	_check(m["found"].filter(func(it): return str(it["base"]) in names).size() == 1, "a second gun while the first's still in the pack")
	# lost on the way (out of time): the next clear leaves another; home: never again
	fresh._time_out(m)
	if fresh.on_mission():
		fresh.extract_now()
	fresh.hp = fresh.max_hp()
	fresh.deploy(Data.FIRST_GUN_SITE)
	var m2 = fresh.mission
	if m2 != null:
		m2["found"] = []
		fresh._clear(m2, m2["t"])
		_check(m2["found"].any(func(it): return str(it["base"]) in names), "a first gun lost to a time-out didn't come again")
		fresh.extract_now()
		_check(fresh.seen.has("first_gun_home") and not fresh.stash.any(func(it): return it.has("first_gun")), "the first gun home wasn't marked home, or kept its mark")
		fresh.stash = fresh.stash.filter(func(it): return not Items.is_gun(it))
		fresh.hp = fresh.max_hp()
		fresh.deploy(Data.FIRST_GUN_SITE)
		var m3 = fresh.mission
		if m3 != null:
			m3["found"] = []
			fresh._clear(m3, m3["t"])
			_check(not m3["found"].any(func(it): return str(it["base"]) in names), "a first gun again after one came home")
			fresh.extract_now()
	# the Stash's Bins and a full stash (the review): the first gun comes home whatever, and only then counts as home
	var binned = Sim.new()
	binned.start()
	binned.mythics_on = false
	binned.best_tier = maxi(binned.best_tier, Data.FIRST_GUN_SITE)
	binned.best_depth[0] = 1
	_yard_ids(binned, ["another_unit", "bins"], "bins")          # the Stash's second column, the Bins
	_check(binned.yard_has("bins"), "the fixture: no Bins built")
	while binned.stash_put(binned._plain(Data.MEDICAL, Data.BASES[Data.MEDICAL][0]["name"])):
		pass
	binned.hp = binned.max_hp()
	binned.deploy(Data.FIRST_GUN_SITE)
	var mbn = binned.mission
	if mbn != null:
		mbn["found"] = []
		binned._clear(mbn, mbn["t"])
		binned.extract_now()
		_check(binned.stash.any(func(it): return str(it["base"]) in names) and binned.seen.has("first_gun_home"), "the first gun lost to the bins or a full stash: in the stash %s, home %s (bins %s)" % [str(binned.stash.any(func(it): return str(it["base"]) in names)), str(binned.seen.has("first_gun_home")), str(binned.yard_has("bins"))])
	# no gun, no rounds; then a shotgun in the stash, only shells
	var bare = Sim.new()
	bare.start()
	bare.mythics_on = false
	bare.stash = bare.stash.filter(func(it): return not Items.is_gun(it))
	bare.equipped["Secondary"] = null
	bare.hp = bare.max_hp()
	bare.deploy(0)
	var mb: Dictionary = bare.mission
	_check(bare.owned_ammo_types(mb).is_empty(), "the fixture: a camp with a hammer owns rounds for %s" % str(bare.owned_ammo_types(mb)))
	var ammo_none := 0
	for k in range(400):
		var f: Dictionary = bare._find(mb, mb["t"], k % 2 == 0, {}, true)     # rolled, not landed: a gun found mustn't join the count
		if not f.is_empty() and Items.is_ammo(f["it"]):
			ammo_none += 1
	bare.stash_put(bare._plain("Primary", "Pump shotgun"))
	var shells := 0
	var other := 0
	for k in range(400):
		var f2: Dictionary = bare._find(mb, mb["t"], k % 2 == 0, {}, true)
		if not f2.is_empty() and Items.is_ammo(f2["it"]):
			if str(Items.base_of(f2["it"])["type"]) == "shotgun":
				shells += 1
			else:
				other += 1
	_check(ammo_none == 0 and shells > 0 and other == 0, "rounds without a gun: %d with none; with a shotgun %d shells, %d others" % [ammo_none, shells, other])
	# no wound before the Clinic
	bare.unlocked = bare.unlocked.filter(func(r): return r != "clinic")
	bare.wounds = {}
	mb["wounded"] = false
	bare._wound(mb)
	_check(bare.wounds.is_empty(), "a wound before the Clinic opened: %s" % str(bare.wounds))
	bare.unlocked.append("clinic")
	bare._wound(mb)
	_check(bare.wounds.size() == 1, "no wound with the Clinic open")
	bare.extract_now()
	# resting at camp: said on the top row and under the odds
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var hp_was: float = sim.hp
	sim.hp = sim.max_hp() * 0.4
	main.refresh()
	_check(main.resting_words().begins_with("Resting, full in") and main._top_labels["where"].text.contains("full in"), "resting at camp isn't said on the top row: '%s'" % main._top_labels["where"].text)
	var hp_chip: Array = main._missions.odds_reasons(sim, 0).filter(func(r): return str(r["forms"][0]).begins_with("HP "))
	_check(not hp_chip.is_empty() and str(hp_chip[0]["forms"][0]).contains("full in"), "the HP reason doesn't say when it's full: %s" % str(hp_chip))
	_check_fit(main, "the top row (resting)")
	sim.hp = sim.max_hp()
	main.refresh()
	_check(main.resting_words() == "" and main._top_labels["where"].text == "On the Pitch", "full HP still says resting: '%s'" % main._top_labels["where"].text)
	sim.hp = hp_was
	main.refresh()
	print("the early game: the first gun once, rounds only for guns you have, no wound before the Clinic, resting said")


## Why a site reads low (17 Oct): no meds and HP under half first, chips under the odds at Risky and worse, none above.
func _why_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var M = main._missions
	sim.rig = sim.rig.filter(func(it): return str(it["slot"]) != Data.MEDICAL)
	sim.hp = sim.max_hp() * 0.3
	var why: Array = M.odds_reasons(sim, 0)
	_check(why.size() >= 2 and str(why[0]["forms"][0]) == "No meds" and str(why[1]["forms"][0]).begins_with("HP "), "the reasons don't lead with no meds and the HP: %s" % str(why))
	sim.hp = sim.max_hp() * 0.03         # near dead and no meds: some open site always reads low (18 Oct: at full HP the bot's camp could read all six high; 20 Oct, run 92 and 134: at 30% too)
	main.show_room(main.MISSIONS)
	var lows := 0
	var highs := 0
	for z in range(Data.ZONES.size()):
		for k in range(3):
			var i: int = Data.ZONES[z]["tiers"][k]
			if not sim.tier_open(i):
				continue
			for _n in range(200):                    # read to the end: the odds come in over frames under a time budget (18 Oct: an unsettled read counted as high and flaked this)
				sim.survival(i)
				if sim.odds_settled(i):
					break
			M.select(i)
			main.refresh()
			var card = M._cols[0]["card"]          # the fix chips (BUILD46-S): the reasons, each a button
			var low: bool = sim.odds_settled(i) and sim.odds_now(i) < M.WHY_UNDER and not M.odds_reasons(sim, i).is_empty()
			lows += 1 if low else 0
			highs += 0 if low else 1
			# the green chip leads where there's a site before (23 Oct, Matt: "grind previous level"); No meds first else
			var first_want: String = "No meds" if sim.site_before(i) < 0 else "Grind"
			var shown: Array = card.chips.filter(func(b): return b.visible)
			var texts: Array = shown.map(func(b): return str(b.text))
			var reasons_on: bool = shown.any(func(b): return not b.text.begins_with(Words.SITE_CARD["fix_rounds"]))
			_check(reasons_on == low and (not low or texts.any(func(t): return t.begins_with(first_want))), "site %d at %s: the reasons %s: %s" % [i, str(sim.odds_now(i)), "shown" if reasons_on else "hidden", str(texts)])
			if low and sim.site_before(i) >= 0:
				_check(str(texts.back()).begins_with("Grind"), "the green chip isn't the last on site %d: %s" % [i, str(texts)])     # the mockup's: what's short, then where to grind
			for b in shown:
				_check(b.position.x + b.size.x <= card.PAD + card.INNER + 0.5 and b.position.y >= card.FIX_Y and b.position.y + b.size.y <= card.FIX_Y + card.FIX_H, "a fix chip leaves its row on site %d: '%s'" % [i, b.text])
			# the hints at 0% (23 Oct, parked item 7; Matt: "just hints in the form of chips"): what's short, never a figure or
			# a word of how the odds are read; the green one first
			if sim.odds_settled(i) and sim.odds_now(i) == 0.0:
				var rs: Array = M.odds_reasons(sim, i)
				var hint_n: int = rs.filter(func(r): return str(r["forms"][0]).begins_with("Not enough ") or str(r["forms"][0]).begins_with("HP ")).size()     # the HP's own chip stands for the HP hint (the review)
				_check(hint_n >= 1 and (sim.site_before(i) < 0 or str(rs[0]["colour"]) == "good"), "site %d at 0%% hints %d, first %s" % [i, hint_n, str(rs[0])])
				for r in rs:
					for f in r["forms"]:
						_check(not str(f).to_lower().contains("dry") and not str(f).to_lower().contains("odds") and (not str(f).begins_with("Not enough") or str(f).find("%") < 0), "a hint carries a figure or the method: '%s'" % str(f))
		_check_fit(main, "Map zone %d (the reasons under the odds)" % z)
	_check(lows > 0, "no site read low enough to show its reasons (%d read high)" % highs)
	sim.hp = sim.max_hp()
	sim.load_dict(saved)
	main.refresh()
	print("why the odds read low: no meds and the HP first, under the odds at Risky and worse (%d sites low, %d not)" % [lows, highs])


func _sound_checks(main) -> void:
	var sim = main.sim
	var snd = main._sound
	var saved: Dictionary = sim.to_dict()
	# the old placeholders still read, and every sound the game asks for has a file - new, or the old one it replaces -
	# or is one the ElevenLabs pass hasn't made yet (13 Oct: listed, not failed, until art/sound_new has them)
	for name in ["ambient_estate", "ambient_town", "ambient_city", "rain", "tick_improvised", "tick_shotgun", "tick_rifle", "tick_smg", "tick_pistol", "tick_melee", "sting", "door", "found"]:
		_check(snd.stream(name) != null, "no sound reads for %s" % name)
	var manifest = JSON.parse_string(FileAccess.get_file_as_string("res://tools/sound_manifest.json"))
	var ids := {}
	for jb in manifest["jobs"]:
		ids[str(jb["sound"])] = true
	for id in snd.SOUNDS:
		_check(ids.has(id), "the game asks for %s, which the manifest doesn't make" % id)
	for id in ids:
		_check(snd.SOUNDS.has(id), "the manifest makes %s, which the game never plays" % id)
	var missing: Array = snd.SOUNDS.keys().filter(func(id): return not snd.has_sound(id))
	print("sound: %d of %d have a file (new or old); not made yet: %d" % [snd.SOUNDS.size() - missing.size(), snd.SOUNDS.size(), missing.size()])
	for id in ["gang_arrives", "head_door", "find_rare", "shot_pistol", "swing_melee", "amb_estate", "rain"]:
		_check(snd.has_sound(id), "%s has neither a new file nor its old one" % id)
	# the title: its music, nothing of the world
	snd.set_enabled(true)
	snd.set_music(true)
	snd.title()
	_check(snd.playing()["music"] == "music_title" and snd.playing()["ambient"] == "", "the title's music isn't up: %s" % str(snd.playing()))
	# out on the estate in the rain: its place, the rain, the fight's music; the gun goes off, a gang, a kill, a hit
