	main.next_setting("music")
	var mb := AudioServer.get_bus_index("Music")
	_check(mb >= 0 and absf(AudioServer.get_bus_volume_db(mb) - linear_to_db(0.75)) < 0.01 and not AudioServer.is_bus_mute(mb), "the Music bus didn't follow its volume")
	main._sound.vols["music"] = 1.0
	main._sound.vols["sfx"] = 0.0
	main._sound.apply_volumes()
	var sb := AudioServer.get_bus_index("SFX")
	_check(not main._sound.enabled and sb >= 0 and AudioServer.is_bus_mute(sb), "effects off didn't quiet the world")
	main._sound.vols["sfx"] = 1.0
	main._sound.apply_volumes()
	_check(main._sound.enabled and not AudioServer.is_bus_mute(sb), "effects back on didn't come back")
	var held: Dictionary = main.settings_dict()
	main.apply_settings({"sound": false, "music": true})
	_check(main._sound.vols["sfx"] == 0.0 and main._sound.vols["voice"] == 0.0 and main._sound.vols["music"] == 1.0, "an old file's Sound off doesn't read as the effects and the voice off: %s" % str(main._sound.vols))
	main.apply_settings(held)
	_check(main.settings_dict() == held, "the settings don't come back as they were saved")
	var card = main.RoomIntro.new("map")
	main.add_child(card)
	_check(card._voice.bus == "Voice", "a room's card speaks on the %s bus, not the Voice" % card._voice.bus)
	card.finish()
	main.next_setting("intros")
	_check(not main.room_intros, "Room intros didn't go off")
	main.next_setting("intros")
	_check(main.room_intros, "Room intros didn't come back on")
	main.show_pause()
	_check(main._menu.shape() == "drawer", "the pause is not the drawer: %s" % main._menu.shape())
	_check_fit(main, "Paused (sound)")
	main._menu.close()
	sim.load_dict(saved)
	main.refresh()
	print("sound ok: every id made and played, the title, the place and the rain, the gun, a gang, a kill, a hit, fire, the heartbeat and the watch, the search, a crate, a find, home, a click, the toggles")


## From Matt's playtest (5 Oct): HP never reads past its max; Locked sits
## right-justified; a toast shows once and only for what just happened; a
## long log line shortens by sentence rather than trailing off; a paper picked
## in the Lock-up gets a panel, not a crash.
func _playtest_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	# HP: the same rounding both sides
	sim.hp = sim.max_hp()
	_check(sim.hp_shown() == sim.max_hp_shown(), "full HP reads %d of %d" % [sim.hp_shown(), sim.max_hp_shown()])
	sim.hp = sim.max_hp() - 0.4
	_check(sim.hp_shown() <= sim.max_hp_shown(), "HP a fraction under full reads past the max: %d of %d" % [sim.hp_shown(), sim.max_hp_shown()])
	var worn = sim.equipped["Armour"]
	sim.equipped["Armour"] = sim._plain("Armour", "Stab vest")
	var big: Dictionary = sim._plain("Armour", "Riot suit")
	big["affixes"] = [{"stat": "hp", "value": 200.0, "tier": 5}]
	sim.equipped["Armour"] = big
	sim.hp = sim.max_hp()
	sim.equipped["Armour"] = sim._plain("Armour", "Stab vest")
	sim.advance(0.1)
	_check(sim.hp <= sim.max_hp() + 0.001, "HP stayed past the max when the kit came off: %.0f of %.0f" % [sim.hp, sim.max_hp()])
	sim.equipped["Armour"] = worn
	# Locked, right-justified across the row
	main.show_room(main.MISSIONS)
	main._missions._shown = ""
	main.refresh()
	var c: Dictionary = main._missions._cols[0]
	_check(c["card"].tiles[2]["text"].text.begins_with("Papers: 1 in") or c["card"].tiles[2]["text"].text.begins_with("1 in"), "the papers' tile is off: '%s'" % c["card"].tiles[2]["text"].text)     # 15 Oct, signals_map.png; the bring-home tile since BUILD46-S
	# the Map's sky (23 Oct, parked item 8): the layer under the pins follows the picked site's zone and the clock
	var mv0 = main._missions._map
	var sky_m: Dictionary = mv0._sky.showing()
	var w_sel: String = sim.weather_of(main._missions.selected)
	_check(bool(sky_m["rain"]) == (w_sel == "Rain") and bool(sky_m["fog"]) == (w_sel == "Fog") and bool(sky_m["night"]) == sim.is_night(), "the Map's sky disagrees with the picked zone: %s against %s, night %s" % [str(sky_m), w_sel, str(sim.is_night())])
	_check(mv0._sky.get_index() < mv0._pins.get_index() and (mv0._clouds == null or mv0._pins.get_index() < mv0._clouds.get_index()), "the Map's pins aren't over the sky and under the cloud")
	# the cloud's edge (23 Oct): the noise to wander it by, and a softened mask - a ramp, not a cut
	if mv0._clouds != null:
		var cmat: ShaderMaterial = mv0._clouds.material
		var cmask: Image = (cmat.get_shader_parameter("mask") as Texture2D).get_image()
		var ramp := 0
		for my in range(cmask.get_height()):
			for mx in range(cmask.get_width()):
				var lum: float = cmask.get_pixel(mx, my).r
				if lum > 0.1 and lum < 0.9:
					ramp += 1
		_check(cmat.get_shader_parameter("noise") is NoiseTexture2D and ramp > cmask.get_width(), "the Map's cloud edge has no noise or a hard mask (%d cells on the ramp)" % ramp)
	# rain set on every zone: the Map's layer rains, its streaks counted and emitting; dry again, it stops (the review)
	var held_w0: Array = sim.weather.duplicate()
	var held_at0 = sim.weather_at
	for z in range(Data.ZONES.size()):
		sim.weather[z] = "Rain"
	sim.weather_at = 1e9
	main._missions._shown = ""
	main.refresh()
	_check(bool(mv0._sky.showing()["rain"]) and mv0._sky._light.amount >= 12 and mv0._sky._heavy.amount >= 36 and mv0._sky.is_processing(), "rain on every zone and the Map isn't raining: %s" % str(mv0._sky.showing()))
	for z in range(Data.ZONES.size()):
		sim.weather[z] = ""
	main._missions._shown = ""
	main.refresh()
	_check(not bool(mv0._sky.showing()["rain"]) and not mv0._sky.is_processing(), "dry again and the Map still rains: %s" % str(mv0._sky.showing()))
	# and Godot's ready doesn't turn the tick back on (23 Oct, the fans: it did, every frame, dry). The smoke never
	# runs a frame, so it's done by hand: the engine's set_process(true), then the script's _ready (not the
	# notification - Control's own ready handler would connect twice when the real one comes at the end)
	mv0._sky.set_process(true)
	mv0._sky._ready()
	_check(not mv0._sky.is_processing(), "the Map's sky ticks every frame with no rain")
	# the fog as banks (23 Oct, Matt: "drawing weirdly" - a flat sheet and two hard bands): one layer, its drifting
	# shader on the seamless noise, the Map's figures; nothing ticks on the CPU for it; gone when it lifts
	for z in range(Data.ZONES.size()):
		sim.weather[z] = "Fog"
	main._missions._shown = ""
	main.refresh()
	var fog_mat = mv0._sky._fog.material
