## One area alone (15 Oct, refactor A3): `-- only crates gang_pause fx` sets the camp up and runs those areas'
## checks (each a `_<area>_checks`), with no bot run before them: seconds, not minutes, while working on one thing.
## The whole smoke is still the one before a commit - an area alone starts from a fresh camp, not the bot's.
func _only_areas() -> Array:
	var args := OS.get_cmdline_user_args()
	var i := args.find("only")
	if i < 0:
		return []
	var out: Array = []
	var skip := false
	for w in args.slice(i + 1):
		if skip:
			skip = false
		elif w == "seed":
			skip = true                        # `seed N` isn't an area
		else:
			out.append(w)
	return out


func _run_only(main, only: Array) -> void:
	# a camp some way in, as the bot's run would leave it: every site cleared once, every head down, a runner of some level
	var sim = main.sim
	for i in range(Data.TIERS.size()):
		sim.best_depth[i] = maxi(1, int(sim.best_depth[i]))
	for z in range(sim.bosses_beaten.size()):
		sim.bosses_beaten[z] = true
	sim.depot_cleared = true
	sim.xp = maxf(sim.xp, Data.xp_for_level(15))
	sim.hp = sim.max_hp()
	main.refresh()
	for area in only:
		var fn := "_%s_checks" % str(area)
		var info: Array = get_method_list().filter(func(mi): return mi["name"] == fn)
		if info.is_empty():
			_check(false, "no area called %s (no %s)" % [area, fn])
			continue
		var params: Array = info[0]["args"]
		print("only: %s" % area)
		var what: String = str(params[0]["name"]) if params.size() == 1 else ""
		if params.is_empty():
			call(fn)
		elif what in ["sim", "_sim"]:
			call(fn, main.sim)
		elif what in ["main", "_main"]:
			call(fn, main)
		elif what == "bk":
			main.show_room(main.BARRACKS)
			main.refresh()
			call(fn, main._barracks)
		else:
			_check(false, "%s takes more than the camp; run it in the whole smoke" % fn)
	_finish()


## The end of a run, whole or one area: the player's saves untouched, the smoke's own gone, the verdict.
func _finish() -> void:
	# the player's own saves are as they were, and the smoke's are gone
	_check(_player_saves() == _player_saves_before, "the smoke touched the player's saves: %s -> %s" % [str(_player_saves_before), str(_player_saves())])
	for path in [SMOKE_SAVE, SMOKE_SLOT % 1, SMOKE_SLOT % 2, SMOKE_SLOT % 3]:
		if FileAccess.file_exists(path):
			DirAccess.remove_absolute(path)
	for f in DirAccess.get_files_at("user://"):
		if f.begins_with("smoke_") and f.contains(".record"):
			DirAccess.remove_absolute("user://" + f)
	if _misfits > 0 or _fails > 0:
		print("FAIL: %d labels do not fit their boxes, %d checks failed" % [_misfits, _fails])
		quit(1)
		return
	print("all labels fit, all checks pass")
	quit(0)


## Save slots, no time away, and a hardcore camp lost.
func _slots_offline_hardcore(main) -> void:
	var sim = main.sim
	# a slot round-trip, and the title/slot menus' words
	var slot: String = main.slot_file % 1
	main.save_game(slot)
	_check(FileAccess.file_exists(slot), "save to a slot wrote nothing")
	_check(main._slots_words().begins_with("1 of"), "slots words: " + main._slots_words())
	_check(main._save_words(slot).begins_with("Level %d" % sim.level()), "save words: " + main._save_words(slot))
	var before_cash: float = sim.cash
	main.load_game(slot)
	main.sim.mythics_on = false            # the smoke's camps find no mythics on their own (17 Oct: a full pack keeps one now - a bot's Bomb Disposal Suit stopped the clock, its moment held the game); the mythics' own checks make theirs
	_check(is_equal_approx(main.sim.cash, before_cash), "slot load changed the cash")
	main.show_slots(false, main.show_title)
	main.show_slots(true, main.show_pause)
	main.show_title()
	_check(main._menu.shape() == ("title" if main._menu._picture.texture != null else "card"), "the title's shape is %s" % main._menu.shape())
	_check_fit(main, "Title")
	# nothing lit on opening (Matt, 14 Oct: the top row always looked chosen); a key's first press lights the first row
	_check(main._menu.lit() == -1, "the title opens with row %d lit" % main._menu.lit())
	var down := InputEventAction.new()
	down.action = "ui_down"
	down.pressed = true
	if main._menu.is_inside_tree():
		main._menu._unhandled_input(down)
		_check(main._menu.lit() == main._menu._first, "a key's first press didn't light the first row: %d" % main._menu.lit())
	var behind := Button.new()
	main.add_child(behind)
	if behind.is_inside_tree():
		behind.grab_focus()
	main.show_pause()
	_check(main._menu.lit() == -1, "the pause opens with row %d lit" % main._menu.lit())
	if behind.is_inside_tree():
		_check(main.get_viewport().gui_get_focus_owner() == null, "a button behind the pause kept the keys: %s" % str(main.get_viewport().gui_get_focus_owner()))
	behind.queue_free()
	main._menu.close()
	_opening_checks(main)
	_room_intro_checks(main)
	sim = main.sim
	# no offline (24 Oct, Matt: "remove all offline stuff"): a save two hours old with a run out loads as it was saved -
	# the clock, the cash, the stash and the run all where they were, and no screen about the time away
	sim.set_depth(3, 1)
	for r in range(Data.RARITIES.size()):
		sim.sell_rarity(r)            # room in the stash
	sim.hp = sim.max_hp()
	sim.deploy(3)
	var was := {"elapsed": sim.elapsed, "cash": sim.cash, "stash": sim.stash.size(), "runs": sim.runs_total, "hp": sim.hp, "out": sim.on_mission()}
	var f := FileAccess.open(main.save_file, FileAccess.WRITE)
	f.store_string(JSON.stringify({"version": main.SAVE_VERSION, "saved": Time.get_unix_time_from_system() - 7200.0, "sim": sim.to_dict()}))
	f.close()
	main.load_game()
	main.sim.mythics_on = false            # the smoke's camps find no mythics on their own (17 Oct: a full pack keeps one now - a bot's Bomb Disposal Suit stopped the clock, its moment held the game); the mythics' own checks make theirs
	sim = main.sim
	var now := {"elapsed": sim.elapsed, "cash": sim.cash, "stash": sim.stash.size(), "runs": sim.runs_total, "hp": sim.hp, "out": sim.on_mission()}
	_check(is_equal_approx(float(now["elapsed"]), float(was["elapsed"])) and is_equal_approx(float(now["cash"]), float(was["cash"])) and now["stash"] == was["stash"] and now["runs"] == was["runs"] and now["out"] and was["out"],
			"two hours shut moved the world: %s → %s" % [str(was), str(now)])
	_check(not main._menu.visible, "a two-hour-old save opened a screen: '%s'" % main._menu._title.text)
	_check(not sim.has_method("away_cap_s") and not main.has_method("_settle_away"), "the away settle is still in the game")
	print("no offline: two hours shut, the run still out, nothing moved")
	# the card's line wraps over its four lines without losing a word, and pushes the row down
	var worst: String = "The longest line a card carries: a heading's worth of words, then more, a clause after a clause, with long numbers like %s in it and a place like the north estate, so that it has to wrap over every line the card has, and nothing trails off." % Fmt.money(1234567.0)
	main._menu.open("A long line", worst, [{"name": "Continue", "detail": "", "action": main._menu.close}], main._menu.close)
	_check(main._menu.sub() == worst, "a long card line lost words in the wrap: '%s'" % main._menu.sub())
	_check(main._menu.sub_lines() <= main._menu.SUB_LINES, "a long card line needs %d lines" % main._menu.sub_lines())
	_check(main._menu.sub_lines() < 2 or main._menu._rows[0].position.y > main._menu.ROWS_Y, "a two-line card line did not push the row down")
	_check_fit(main, "A card (a long line)")
	main._menu.close()
	# hardcore: a KIA ends the camp
	main.new_game(true)
	main.sim.mythics_on = false            # the smoke's camps find no mythics on their own (17 Oct: a full pack keeps one now - a bot's Bomb Disposal Suit stopped the clock, its moment held the game); the mythics' own checks make theirs
	sim = main.sim
	_open_camp(sim)
	_check(sim.hardcore, "new_game(true) is not hardcore")
	sim.deploy(0)
	sim._kia()
	_check(sim.camp_lost, "a hardcore KIA did not lose the camp")
	_check(sim.equipped["Primary"] == null, "the hardcore KIA restocked")
	# and a standard KIA hands the new operator a worn rifle
	var std = load("res://scripts/sim/sim.gd").new()
	std.start()
	std.deploy(0)
	std._kia()
	_check(std.equipped["Primary"] != null and std.equipped["Armour"] != null, "a new operator reports without kit")
	var stamp_before: Dictionary = main._read_save(main.save_file)
	main.save_game()
	_check(main._read_save(main.save_file).get("saved", 0.0) == stamp_before.get("saved", 0.0), "a lost camp still saved")
	main.refresh()
	_check_fit(main, "Camp (lost)")
	# the lost camp's screen: the card on the plain ground with its heading and words up (not the title's column, 8 Oct)
	main.show_camp_lost()
	_check(main._menu.visible and main._menu.shape() == "card" and main._menu._title.text == "The Pitch is lost" and main._menu.sub().ends_with("gone with the runner."), "the lost camp's words are not up: %s / '%s' / '%s'" % [main._menu.shape(), main._menu._title.text, main._menu.sub()])
	_check(not main._menu._picture.visible and main._menu._backdrop.visible, "the lost camp's card is not on the plain ground")
	_check_fit(main, "Camp (lost, the screen)")
	main._menu.close()
	main.show_camp_lost()
	_check(not FileAccess.file_exists(main.save_file), "the lost camp's autosave was not removed")
	_check(FileAccess.file_exists(slot), "the slots did not survive the lost camp")
	main._to_title_no_save()
	_check(main.sim == null, "the title after a lost camp still has a sim")
	DirAccess.remove_absolute(slot)
	print("slots, no offline and hardcore ok")


## An elite of this base with every affix it can carry at its top roll.
func _worst_item(slot: String, base: Dictionary, sim) -> Dictionary:
	var it := Items.roll(slot, Data.MAX_TIER, sim.rng)
	it["base"] = base["name"]
	it["tier"] = base["tier"]
	var top: int = Data.RARITIES.size() - 1
	it["rarity"] = top
	it["value"] = int(round(base["value"] * Data.RARITIES[top]["value"]))
	it["affixes"] = []
	for a in Data.AFFIXES:
		if slot in a["slots"] and it["affixes"].size() < int(Data.RARITIES[top]["affixes"]):
			it["affixes"].append({"stat": a["stat"], "value": int(a["max"]), "tier": Data.AFFIX_TIERS})
	if slot == Data.ATTACHMENT:
		it["mount"] = base["mount"]
	else:
		it["attachments"] = {}
		for name in base.get("attachments", []):
			it["attachments"][name] = null
	return it


## The random items the bot found are never the worst. This fills the Yard
## with the worst - elites of every base, every affix at its top roll, every
## mount fitted - and shows every screen and every pick on it.
func _worst_case(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var worst: Array = []
	for slot in Data.SLOTS:
		for b in Data.BASES[slot]:
			worst.append(_worst_item(slot, b, sim))
	for b in Data.BASES[Data.MEDICAL]:
		worst.append(_worst_item(Data.MEDICAL, b, sim))
	for b in Data.BASES[Data.AMMO]:
		worst.append(sim._plain(Data.AMMO, b["name"]))
	for b in Data.ATTACHMENTS:
		worst.append(_worst_item(Data.ATTACHMENT, b, sim))
		# every part has a headline figure and words of its own (Nails through it had neither: its bleed share was not in the lists)
		var plain: Dictionary = sim._plain(Data.ATTACHMENT, b["name"])
		_check(Items.headline(plain)[0] != "" and Items.att_words(plain, true, true) != "", "%s has no headline or words" % b["name"])
	for u in Data.UNIQUES:
		worst.append(Items.roll_unique(u, sim.rng))
	# fitted: the longest-named of each slot, every mount filled
	for slot in Data.SLOTS:
		var pick := {}
		for it in worst:
			if it["slot"] == slot and (pick.is_empty() or it["base"].length() > pick["base"].length()):
				pick = it
		sim.equipped[slot] = pick.duplicate(true)
		for mount in sim.equipped[slot]["attachments"]:
			for it in worst:
				if Items.is_attachment(it) and it["mount"] == mount:
					sim.equipped[slot]["attachments"][mount] = it.duplicate(true)
					break
	for pk in [[["shelving", "racks"], "shelving"], [["another_unit", "bins"], "another_unit"], [["lock_up", "filing_cabinet"], "lock_up"], [["dry_store", "annex"], "annex"], [["stall", "haggling"], "stall"], [["shopfront", "contacts"], "shopfront"]]:
		_yard_ids(sim, pk[0], pk[1])       # the worst case: the biggest stash and shelf there are
	sim.stash = []
	for it in worst:
		if sim.stash_room(Items.size(it)):
			sim.stash.append(it.duplicate(true))
	sim.market = []
	for it in worst:
		if sim.market.size() < sim.market_stock() and not Items.is_medical(it):
			sim.market.append(it.duplicate(true))
	sim.rig = []
	var worst_med: Dictionary = _worst_item(Data.MEDICAL, Data.BASES[Data.MEDICAL].back(), sim)
	while sim.rig_room(Items.size(worst_med)):
		sim.rig.append(_worst_item(Data.MEDICAL, Data.BASES[Data.MEDICAL].back(), sim))
	while sim.rig_room(1):
		sim.rig.append(sim._plain(Data.MEDICAL, "Bandage"))
	sim.cash = 9999999.0
	sim.hp = sim.max_hp()
	for r in main.ROOMS:
		main.show_room(r)
		_check_fit(main, "%s (worst)" % r)
	# a full rig that wraps its rows (seven bandages, then a two-pouch kit that can't cross the row's end): the
	# pouches shrink until its rows fit under the loadout (10 Oct)
	var rig_hold: Array = sim.rig.duplicate(true)
	var pack_hold = sim.equipped["Backpack"]
	var rig_slot_hold = sim.equipped["Rig"]
	sim.equipped["Backpack"] = _worst_item("Backpack", Data.BASES["Backpack"].back(), sim)
	var big_rig: Dictionary = _worst_item("Rig", Data.BASES["Rig"].back(), sim)
	big_rig["affixes"].append({"stat": "capacity", "value": 24.0, "tier": 1})     # the sim's cap: 24 pouches
	sim.equipped["Rig"] = big_rig
	sim.rig = []
	var wraps := true
	while wraps:
		wraps = false
		for i in range(7):
			if sim.rig_room(1):
				sim.rig.append(sim._plain(Data.MEDICAL, "Bandage"))
				wraps = true
		if sim.rig_room(2):
			sim.rig.append(sim._plain(Data.MEDICAL, "First aid kit"))
			wraps = true
	main.show_room(main.ARMOURY)
	main.refresh()
	var ct = main._armoury._containers
	_check(ct.rig_inside() and main._armoury.CONTAINERS_Y + ct.size.y <= Pal.ROOM_H, "a wrapped full rig runs out of its room: pouches %.0f px" % ct.rig_cell())
	_check(ct._rig_zone.size.y >= 3 * ct.rig_cell(), "the wrapped rig is not the crowded case: %.0f px of rows" % ct._rig_zone.size.y)     # three rows or more: the case that ran out
	_check(not ct.has_method("pack_inside") and not ct.has_method("pack_cell"), "the Lock-up still draws the pack's map (Matt, 10 Oct: removed)")
	for rc in ct._rig_cells:
		if rc.visible:
			for l in rc.text_nodes():
				if l.visible and l.text != "":
					_check(Rect2(Vector2.ZERO, rc.size).grow(0.5).encloses(Rect2(l.position, l.size)), "a pouch's words spill out of its %s cell: '%s'" % [str(rc.size), l.text])
	_check_fit(main, "Lock-up (a wrapped rig, the deepest pack)")
	# the worst wrap: four-pouch kits among singles, and rounds in the thousands - the smallest pouches, their words
	# and counts inside them (the reviewer, 10 Oct)
	sim.rig = []
	var more := true
	while more:
		more = false
		for i in range(5):
			if sim.rig_room(1):
				sim.rig.append(sim._plain(Data.MEDICAL, "Bandage"))
				more = true
		var kit: Dictionary = sim._plain(Data.MEDICAL, "Surgeon's kit")
		if sim.rig_room(Items.size(kit)):
			sim.rig.append(kit)
			more = true
	var rounds: Dictionary = sim._plain(Data.AMMO, "Nails")
	rounds["rounds"] = 2500
	if not sim.rig.is_empty():
		sim.rig[0] = rounds
	main.refresh()
	_check(ct.rig_inside(), "the worst wrap runs out of its room at %.0f px pouches" % ct.rig_cell())
	for rc in ct._rig_cells:
		if rc.visible:
			for l in rc.text_nodes():
				if l.visible and l.text != "":
					_check(UI.text_width(l, l.text) <= l.size.x + 0.5 and Rect2(Vector2.ZERO, rc.size).grow(0.5).encloses(Rect2(l.position, l.size)), "a %s pouch's '%s' doesn't fit: %.0f px of text in %s at %s" % [str(rc.size), l.text, UI.text_width(l, l.text), str(l.size), str(l.position)])
	_check_fit(main, "Lock-up (the worst wrap)")
	sim.rig = rig_hold
	sim.equipped["Backpack"] = pack_hold
	sim.equipped["Rig"] = rig_slot_hold
	main.refresh()
	# the Lock-up: every slot picked, then the first cell of every kind
	main.show_room(main.ARMOURY)
	for slot in Data.SLOTS:
		main._armoury._pick_slot(slot)
		main.refresh()
		_check_fit(main, "Lock-up (worst, %s)" % slot)
	for k in range(main._armoury._inv.KINDS.size()):
		main._armoury._inv._set_kind(k)
		main.refresh()
		if main._armoury._inv.items.size() > 0:
			main._armoury._pick_cell(main._armoury._inv.cell_of(main._armoury._inv.items[0]["id"]))
			main.refresh()
			_check_fit(main, "Lock-up (worst, kind %d)" % k)
	main._armoury._inv._set_kind(0)
	# the Bench: every mount of the primary, an attachment picked
	main.show_room(main.WORKSHOP)
	for mount in sim.equipped["Primary"]["attachments"]:
		main._workshop._pick_mount("Primary", mount)
		main.refresh()
		_check_fit(main, "Bench (worst, %s)" % mount)
	# the Fence and the Clinic: every shelf cell, the first stash cell
	sim.clinic = []
	for b in Data.BASES[Data.MEDICAL]:
		sim.clinic.append(_worst_item(Data.MEDICAL, b, sim))
	for pair in [[main.MARKET, main._fence], [main.MEDIC, main._clinic]]:
		main.show_room(pair[0])
		var v = pair[1]
		v._show("shelf")
		main.refresh()
		for it in v._stock():
			var k: int = v._shelf.cell_of(it["id"])
			if k >= 0:
				v._shelf._pick(k)
				main.refresh()
				_check_fit(main, "%s (worst, shelf %s)" % [pair[0], it["base"]])
		v._show("stash")
		main.refresh()
		if v._stash.items.size() > 0:
			v._stash._pick(v._stash.cell_of(v._stash.items[0]["id"]))
			main.refresh()
			_check_fit(main, "%s (worst, stash)" % pair[0])
		v._show("shelf")
	# the run: the pack full of the worst, every cell picked
	sim.set_depth(3, 1)
	sim.deploy(3)
	sim.mission["found"] = []
	for it in worst:
		if sim.pack_used(sim.mission) + Items.size(it) <= sim.capacity():
			sim.mission["found"].append(it.duplicate(true))
	main.show_room(main.MISSIONS)
	main.refresh()
	_check_fit(main, "Run (worst)")
	for it in sim.mission["found"]:
		var k: int = main._run._inv.cell_of(it["id"])
		if k >= 0:
			main._run._inv._pick(k)
			main.refresh()
			_check_fit(main, "Run (worst, %s)" % it["base"])
	sim.extract_now()
	main.refresh()
	print("worst case ok")


## The Clinic as a vendor screen: Treat, Buy off its shelf, Take from your meds, Leave from the rig.
## The two shelves as areas for `only` (23 Oct): `only clinic_shelf fence_shelf`.
func _clinic_shelf_checks(main) -> void:
	_clinic_screen(main)


func _fence_shelf_checks(main) -> void:
	_fence_screen(main)


func _clinic_screen(main) -> void:
	var sim = main.sim
	main.show_room(main.MEDIC)
	_check_fit(main, "Clinic (shelf)")
	sim.hp = sim.max_hp() * 0.5
	sim.cash += 2000.0
	main.refresh()
	main._clinic._body._all.pressed.emit()     # the body's one button: Heal, or Treat everything
	_check(sim.hp >= sim.max_hp() - 0.5, "Treat through the screen did not heal: '%s'" % main._clinic._body._all.text)
	_check(sim.clinic.size() > 0 and sim.clinic.size() <= sim.clinic_stock(), "the Clinic's shelf is empty or over its stock")
	var it: Dictionary = sim.clinic[0]
	main._clinic._shelf._pick(main._clinic._shelf.cell_of(it["id"]))
	main.refresh()
	_check_fit(main, "Clinic (shelf pick)")
	var shelf_before: int = sim.clinic.size()
	main._clinic._press(0)              # Buy
	_check(sim.clinic.size() == shelf_before - 1 or not sim.stash_room(1), "Buy off the Clinic's shelf did not buy, or the shelf did not shrink")
	# Select-many buys the lot (23 Oct, parked item 10, Matt: "single buying at a time is a chore"): Select, two cells,
	# Buy 2 for their prices; All picks the shelf
	if sim.clinic.size() >= 2:
		while not sim.stash_room(4) and not sim.stash.is_empty():
			sim.sell(sim.stash[0])
		var shelf_v = main._clinic._shelf
		shelf_v._toggle_many()
		main.refresh()
		_check(shelf_v.many and shelf_v._sell_button.visible and shelf_v._all_button.visible and shelf_v._sell_button.disabled, "the shelf's Select didn't offer Buy and All: many %s" % str(shelf_v.many))
		var two: Array = [int(sim.clinic[0]["id"]), int(sim.clinic[1]["id"])]
		var cost2: int = sim.clinic_price(sim.clinic[0]) + sim.clinic_price(sim.clinic[1])
		for id in two:
			shelf_v._pick(shelf_v.cell_of(id))
		main.refresh()
		_check(shelf_v.chosen.size() == 2 and shelf_v._sell_button.text.begins_with("Buy 2") and not shelf_v._sell_button.disabled, "two picked on the shelf read '%s' (%d chosen, disabled %s)" % [shelf_v._sell_button.text, shelf_v.chosen.size(), str(shelf_v._sell_button.disabled)])
		_check(main._clinic._hint.text.begins_with("2 picked"), "the Clinic's panel doesn't say what's picked: '%s'" % main._clinic._hint.text)
		_check_fit(main, "Clinic (shelf, two picked)")
		var cash0: float = sim.cash
		var shelf0: int = sim.clinic.size()
		shelf_v._sell_chosen()
		main.refresh()
		_check(sim.clinic.size() == shelf0 - 2 and is_equal_approx(sim.cash, cash0 - cost2) and two.all(func(id): return sim.stash.any(func(x): return int(x["id"]) == id)), "Buy 2 off the shelf: %d left of %d, cash %.0f of %.0f" % [sim.clinic.size(), shelf0, sim.cash, cash0 - cost2])
		if not sim.clinic.is_empty():
			shelf_v._choose_all()
			main.refresh()
			_check(shelf_v.chosen.size() == sim.clinic.size() and shelf_v._all_button.disabled, "All didn't pick the shelf: %d of %d" % [shelf_v.chosen.size(), sim.clinic.size()])
		# a lot the stash can't all hold (the review): the button reads the cells the lot wants; what won't go stays picked
		if sim.clinic.size() >= 2:
			shelf_v.chosen = []
			var pair: Array = [sim.clinic[0], sim.clinic[1]]
			var want: int = Items.size(pair[0]) + Items.size(pair[1])
			var fillers: Array = []
			while sim.stash_room(want) and sim.stash_room(1):
				var fb: Dictionary = sim._plain(Data.MEDICAL, "Bandage")
				fillers.append(fb)
				sim.stash_put(fb)                                       # fill till one cell short of the pair
			for pit in pair:
				shelf_v._pick(shelf_v.cell_of(int(pit["id"])))
			sim.cash += sim.clinic_price(pair[0]) + sim.clinic_price(pair[1])
			main.refresh()
			_check(shelf_v._sell_button.disabled or sim.stash_room(want), "Buy 2 reads enabled with the stash a cell short: room %s" % str(sim.stash_room(want)))
			var shelf1: int = sim.clinic.size()
			shelf_v._sell_chosen()
			main.refresh()
			var went: int = shelf1 - sim.clinic.size()
			_check(went < 2 and shelf_v.chosen.size() == 2 - went, "a lot the stash can't hold: %d bought, %d still picked" % [went, shelf_v.chosen.size()])
			for fb in fillers:
				sim.stash.erase(fb)                                        # the stash as it was (a full stash failed eleven checks after this one)
		shelf_v._toggle_many()
		main.refresh()
	main._clinic._show("stash")
	main.refresh()
	_check_fit(main, "Clinic (your meds)")
	var k: int = main._clinic._stash.cell_of(it["id"])
	if k >= 0 and sim.rig_room(Items.size(it)):
		main._clinic._stash._pick(k)
		main.refresh()
		_check_fit(main, "Clinic (med pick)")
		var rig_before: int = sim.rig.size()
		main._clinic._press(0)          # Take
		_check(sim.rig.size() == rig_before + 1, "Take through the Clinic did not take")
		main.refresh()
		_check_fit(main, "Clinic (rig)")
		# leaving is the Lock-up's (the Clinic's empty panel acts on nothing)
		_check(sim.leave(sim.rig.back()["id"]), "leave from the rig did not leave")
		_check(sim.rig.size() == rig_before, "the rig did not go back down")
	main._clinic._show("shelf")
	print("clinic screen ok")


## The Fence as a vendor screen: their shelf (finite), Buy, your stash's Sell, sell by rarity.
func _fence_screen(main) -> void:
	var sim = main.sim
	main.show_room(main.MARKET)
	_check_fit(main, "Fence (shelf)")
	if sim.market.size() > 0:
		var it: Dictionary = sim.market[0]
		main._fence._shelf._pick(main._fence._shelf.cell_of(it["id"]))
		main.refresh()
		_check_fit(main, "Fence (shelf pick)")
		# the pick's head: the name, the chips, the figure big, the title label away
		var fh = main._fence._head
		_check(fh.visible and not main._fence._left_title.visible and fh._title.text != "" and fh._figure.text != "" and fh._chips[0].visible, "the Fence's pick has no head: %s / %s" % [fh._title.text, fh._figure.text])
		sim.cash += sim.price(it)
		var n_before: int = sim.stash.size()
		var shelf_before: int = sim.market.size()
		main._fence._press(0)
		_check(sim.stash.size() == n_before + 1 or sim.market.size() == shelf_before - 1 or not sim.stash_room(Items.size(it)), "Buy through the screen did not buy: %s at %d, cash %.0f, stash %d" % [it["base"], sim.price(it), sim.cash, sim.stash.size()])     # a box of rounds tops up a stack (19 Oct)
		_check(sim.market.size() == shelf_before - 1 or not sim.stash_room(Items.size(it)), "the shelf did not shrink: finite stock")
		# the Fence's shelf has the many too (23 Oct): Select, two, Buy 2 at his prices
		if sim.market.size() >= 2:
			var fsh = main._fence._shelf
			fsh._toggle_many()
			var two_f: Array = [int(sim.market[0]["id"]), int(sim.market[1]["id"])]
			var cost_f: int = sim.price(sim.market[0]) + sim.price(sim.market[1])
			for id in two_f:
				fsh._pick(fsh.cell_of(id))
			sim.cash += cost_f
			while not sim.stash_room(Items.size(sim.market[0]) + Items.size(sim.market[1])) and not sim.stash.is_empty():
				sim.sell(sim.stash[0])
			main.refresh()
			_check(fsh._sell_button.visible and fsh._sell_button.text.begins_with("Buy 2") and not fsh._sell_button.disabled, "the Fence's shelf many reads '%s' (disabled %s; cash %.0f for %d, room %s for %d+%d, tip '%s')" % [fsh._sell_button.text, str(fsh._sell_button.disabled), sim.cash, cost_f, str(sim.stash_room(Items.size(sim.market[0]) + Items.size(sim.market[1]))), Items.size(sim.market[0]), Items.size(sim.market[1]), fsh._sell_button.tooltip_text])
			_check_fit(main, "Fence (shelf, two picked)")
			var cash_f: float = sim.cash
			var mk0: int = sim.market.size()
			fsh._sell_chosen()
			main.refresh()
			_check(sim.market.size() == mk0 - 2 and is_equal_approx(sim.cash, cash_f - cost_f), "Buy 2 off the Fence's shelf: %d left of %d, cash %.0f of %.0f" % [sim.market.size(), mk0, sim.cash, cash_f - cost_f])
			fsh._toggle_many()
			main.refresh()
	main._fence._show("stash")
	main.refresh()
	_check_fit(main, "Fence (your stash)")
	var sellable: Array = sim.stash.filter(func(x): return not Items.rig_item(x))     # a med or rounds' first button is Take
	if not sellable.is_empty():
		var it: Dictionary = sellable[0]
		main._fence._stash._set_kind(0)
		main._fence._stash._set_rarity(-1)
		main.refresh()
		var k: int = main._fence._stash.cell_of(it["id"])
		if k >= 0:
			main._fence._stash._pick(k)
			main.refresh()
			_check_fit(main, "Fence (stash pick)")
			var cash_before: float = sim.cash
			main._fence._press(0)
			_check(sim.cash > cash_before, "Sell through the screen did not sell")
	# the Fence's word (the gamble, Matt, 6 Oct): the fourth tab, five kinds with a price, Pay through the screen, the last word under them
	main._fence._show("word")
	main.refresh()
	_check(main._fence._word.visible and not main._fence._shelf.visible and not main._fence._list.visible, "the word tab did not show its panel alone")
	_check(main._fence._tabs[3].visible and main._fence._tabs[3].text.begins_with("The word"), "the word tab reads '%s'" % main._fence._tabs[3].text)
	var shown_offers: int = 0
	for o in main._fence._offers:
		if o["pay"].visible:
			shown_offers += 1
			_check(o["pay"].text.contains("tin") and o["kind"].text != "", "an offer tile is blank: '%s' / '%s'" % [o["kind"].text, o["pay"].text])
	_check(shown_offers == sim.gamble.size(), "the offer tiles do not match the offer: %d for %s" % [shown_offers, str(sim.gamble)])
	_check_fit(main, "Fence (the word)")
	if not sim.gamble.is_empty():
		sim.cash = maxf(sim.cash, sim.gamble_price(sim.gamble[0]) * 2.0)
		while not sim.stash_room(12) and not sim.stash.is_empty():
			sim.sell(sim.stash[0])        # room for whatever he gets: a full stash refuses the word
		var kind0: String = sim.gamble[0]
		var n0: int = sim.stash.filter(func(x): return not Items.is_mag(x)).size()     # a gun's magazine comes with it (30 Oct)
		var cash0: float = sim.cash
		main.refresh()
		main._fence._gamble(0)
		main.refresh()
		_check(sim.stash.filter(func(x): return not Items.is_mag(x)).size() == n0 + 1 and sim.cash < cash0 and not (kind0 in sim.gamble), "Pay through the screen did not gamble: stash %d from %d, cash %.0f from %.0f" % [sim.stash.size(), n0, sim.cash, cash0])
		_check(main._fence._last.visible and main._fence._last._title.text != "" and not main._fence._last_none.visible, "the last word is not shown after a gamble: '%s'" % main._fence._last._title.text)
		_check(main._fence._offers[main._fence._offers.size() - 1]["kind"].text == "Taken" or sim.gamble.size() == Data.GAMBLE_SHOWN, "the bought kind did not read as taken")
		_check_fit(main, "Fence (the word, after)")
	main._fence._show("shelf")
	main._fence.selected = {}
	main.refresh()
	var commons := 0
	for it in sim.stash:
		if it["rarity"] == 0 and not Items.is_deeds(it) and not Items.is_paper(it) and not it.get("mythic", false):     # sell_rarity keeps papers and mythics (18 Oct: a P45 in the bot's stash made this flake)
			commons += 1
	if commons > 0:
		main._fence._sell._sell(0)          # Common (Fence A, 19 Oct: an upgrade on what's worn is kept)
		main._fence._sell._sell(0)     # the press asks twice now (25 Oct, the review)
		var left := 0
		for it in sim.stash:
			if sim._spare(it, 0):      # the deeds never go to the Fence (13 Oct: the bot's run had found them); papers and mythics one at a time
				left += 1
		_check(left == 0, "Sell commons through the screen left %d: %s" % [left, str(sim.stash.filter(func(x): return sim._spare(x, 0)).map(func(x): return x["base"]))])
	_check_fit(main, "Fence (after)")
	main._fence._show("shelf")
	print("fence screen ok")


## The live run as a screen: the pack grid, Ditch, Select many, Get out now.
## Every site cleared and every boss beaten: the campaign, done by hand.
func _finish_campaign(sim) -> void:
	sim.depot_cleared = true
	for k in range(Data.TIERS.size()):
		sim.best_depth[k] = maxi(sim.best_depth[k], 1)
	for z in range(Data.ZONES.size()):
		sim.bosses_beaten[z] = true


## The campaign and the endgame: zones gate on bosses, the depth ladder and
## the call-in wait for the campaign, a boss comes out after the pool and
## drops from its own pool, notes come in and pay for the next one, and at
## equal depth every site's fight is within a band while its drops differ.
func _campaign_checks(main) -> void:
	var sim = main.sim
	var save: Dictionary = sim.to_dict()
	# gates
	for z in range(Data.ZONES.size()):
		sim.bosses_beaten[z] = false
	for k in range(Data.TIERS.size()):
		sim.best_depth[k] = 1
	_check(not sim.zone_open(1), "the Estate opened with the Gamekeeper standing")
	sim.bosses_beaten[0] = true                 # the Gamekeeper down (13 Oct): the Estate's is the test
	_check(sim.zone_open(1) and not sim.zone_open(2), "the Town opened with every Estate site cleared but its boss standing")
	_check(not sim.campaign_done(), "the campaign read as done with no boss beaten")
	sim.set_depth(3, 2)
	_check(sim.depth[3] == 1, "depth 2 opened before the campaign")
	sim.hp = sim.max_hp()
	# the Estate's boss, free, from the Retail Park
	_check(sim.boss_cost(5) == 0, "the first boss fight is not free")
	_check(sim.can_arm_boss(5), "the Estate's boss could not be armed")
	sim.arm_boss(5, true)
	var t: Dictionary = sim.effective(5)
	_check(t.has("boss") and t["boss"]["hp"] > t["hp"], "arming the boss did not put them in the fight")
	sim.deploy(5)
	_check(sim.on_mission() and sim.mission.has("boss"), "the boss did not come on the run")
	_check(not sim.boss_armed.get(2, false), "the boss stayed armed past the deploy: arming is one run, like the insurance")
	# through the pool with a big gun, then the boss
	var guard := 0
	while sim.on_mission() and sim.mission["remaining"] > 0 and guard < 20000:
		sim.hp = sim.max_hp()
		sim.mission["clock"] = 900.0            # the test wants the boss, not the clock
		sim.advance(1.0)
		guard += 1
	_check(sim.on_mission() and sim.mission["boss"]["started"], "the boss did not come out when the pool was down")
	guard = 0
	while sim.on_mission() and sim.mission["boss"]["alive"] and guard < 20000:
		sim.hp = sim.max_hp()
		sim.mission["clock"] = 900.0
		sim.advance(1.0)
		guard += 1
	_check(sim.on_mission() and not sim.mission["boss"]["alive"], "the boss did not go down")
	_check(sim.bosses_beaten[1], "beating the boss did not mark the zone")
	var dropped := false
	for it in sim.mission["found"] + sim.mission.get("floor", []):     # by hand, a head's unique lands on the floor (1 Nov)
		if it.has("unique") and it["unique"] in sim.boss_of(5)["uniques"]:
			dropped = true
	_check(dropped, "the boss dropped nothing of their own")
	_check(int(sim.mission.get("notes", 0)) > 0, "the run carried no notes")
	var notes_before: int = sim.notes
	sim.extract_now()
	_check(sim.notes > notes_before, "the notes did not come home")
	_check(sim.zone_open(2), "the Town did not open with the Estate's boss down")
	_check(sim.boss_cost(5) > 0, "the second boss fight is free")
	# the endgame: campaign done, depth 2 everywhere; the sites are nine ladders now (7 Oct): each site's
	# depth 2 harder than the one before it in the campaign's order, the city's a good deal harder than the estate's
	_finish_campaign(sim)
	var last_work := 0.0
	var work_lo := 1e9
	var work_hi := 0.0
	for i in range(Data.TIERS.size()):
		sim.set_depth(i, 2)
		_check(sim.depth[i] == 2, "depth 2 did not open at %s after the campaign" % Data.TIERS[i]["name"])
		sim.words[i] = []                       # the shape alone, without the word on it
		var e: Dictionary = sim.effective(i)
		var work: float = e["hp"] * e["dps"]       # how hard one of them is: the level's curve, bent by the shape
		_check(work >= last_work * 0.8, "at depth 2 %s reads easier than the site before it: %.0f after %.0f" % [Data.TIERS[i]["name"], work, last_work])
		last_work = work
		work_lo = minf(work_lo, work)
		work_hi = maxf(work_hi, work)
	_check(work_hi / work_lo > 3.0, "at depth 2 the sites' fights differ by only ×%.1f; the ladders are not nine" % (work_hi / work_lo))
	# the boss costs notes now
	sim.notes = 0
	_check(not sim.can_arm_boss(5), "a boss was armed with no notes")
	sim.notes = 1000
	_check(sim.can_arm_boss(5), "a boss could not be armed with notes in hand")
	# exclusives: a site's own base drops there and nowhere else
	var seen_at := {}
	for i in range(Data.TIERS.size()):
		var site: Dictionary = Data.TIERS[i]
		for k in range(300):
			for slot in ["Primary", "Secondary", "Helmet", "Armour", "Rig", "Backpack", "Medical", "Ammo", "Attachment", Data.PAPER]:     # papers too (12 Oct)
				var it := Items.roll(slot, Data.MAX_TIER, sim.rng, 0.0, false, false, site["name"], str(site["drops"].get("type", "")))
				var home := Items.exclusive_to(it["base"])
				if home != "":
					_check(home == site["name"] or (str(it["base"]) in Data.ZONE_KIT and Items.site_zone(home) == int(site["zone"])), "%s dropped at %s; it belongs to %s" % [it["base"], site["name"], home])     # a zone's own kit: its zone's sites too (31 Oct)
					seen_at[it["base"]] = true
	for i in range(Data.TIERS.size()):
		for name in Data.TIERS[i]["drops"].get("only", []):
			_check(seen_at.has(name), "%s never dropped at its own site" % name)
	for i in range(Data.TIERS.size()):
		for name in Data.TIERS[i]["drops"].get("only", []):
			_check(Words.item_words(name) != "" , "%s has no words" % name)
	for b in Data.BOSSES:
		_check(Words.BOSSES.has(b["name"]), "%s has no lines" % b["name"])
		for u in b["uniques"]:
			_check(Words.UNIQUES.has(u), "%s has no past" % u)
	sim.load_dict(save)
	print("campaign and endgame ok: gates, the boss and their drop, notes, the depth band, exclusives")


## The narrative's hooks: the site's line once a depth, the clear line once a
## tier, papers among the finds, the deeds from the Bank and the three ends
## of them, the runners' past after a death, the vendors' lines.
func _narrative_checks(main) -> void:
	var sim = main.sim
	# the deeds: a fresh camp walked straight to the Bank
	var save: Dictionary = sim.to_dict()
	_finish_campaign(sim)
	sim.hp = sim.max_hp()
	var bank: int = Data.BANK
	_check(sim.tier_open(bank), "the Bank did not open with every depth cleared")
	sim.seen.erase("%d/1" % bank)              # the bot's run may have walked it already
	sim.deeds_found = false                     # and found the deeds (13 Oct)
	sim.deeds_fate = ""                         # and decided them (19 Oct, the flaky drop: a fate or deeds in the stash from the
	sim.stash = sim.stash.filter(func(x): return not Items.is_deeds(x))     # smoke's earlier play stop a second drop, as they should)
	sim.unlocked.erase("yard")                  # the deeds come off the Manager while the Yard isn't yours (13 Oct)
	sim.boss_armed[bank] = true
	sim.deploy(bank)
	_check(sim.on_mission(), "could not set off for the Bank")
	_check(sim.events.back()[1] == Words.site_line("The Bank", 1), "setting off for the Bank gave no site line: %s" % sim.events.back()[1])
	sim._clear(sim.mission, sim.mission["t"])
	var deeds := {}
	for it in sim.mission["found"]:
		if Items.is_deeds(it):
			deeds = it
	_check(deeds.is_empty(), "clearing the Bank dropped the deeds: they're the Manager's now (13 Oct)")
	if sim.mission.has("boss"):
		sim._boss_down(sim.mission, sim.mission["t"])
	for it in sim.mission["found"]:
		if Items.is_deeds(it):
			deeds = it
	_check(not deeds.is_empty(), "the Manager down did not drop the deeds (found before %s, fate '%s', held %s, convoy %s, a head %s, tier %d, BANK %d, seen %s)" % [str(sim.deeds_found), sim.deeds_fate, str(sim._deeds_held({})), str(sim.mission.get("convoy", false)), str(sim.mission.has("boss")), int(sim.mission["tier"]), Data.BANK, str(sim.seen.keys().filter(func(k): return str(k).begins_with("%d/" % Data.BANK) or str(k).begins_with("cleared/")))])
	if deeds.is_empty():
		sim.extract_now()
		sim.load_dict(save)
		return
	_check(Items.footprint(deeds) == Vector2i(2, 2), "the deeds are not two by two")
	# burned
	sim.ditch(deeds["id"])
	_check(sim.floor_items().has(deeds) and sim.deeds_fate == "", "ditched, the deeds weren't put down on the floor: fate %s" % sim.deeds_fate)
	sim.extract_now()
	_check(sim.deeds_fate == "burned", "the deeds left on the floor did not end: %s" % sim.deeds_fate)     # ditched and left (27 Oct)
	# held: the same again, out with them
	sim.deeds_found = false
	sim.deeds_fate = ""
	sim.hp = sim.max_hp()
	sim.unlocked.erase("yard")
	sim.boss_armed[bank] = true
	sim.deploy(bank)
	sim._clear(sim.mission, sim.mission["t"])
	if sim.mission.has("boss"):
		sim._boss_down(sim.mission, sim.mission["t"])
	sim.extract_now()
	_check(sim.deeds_fate == "held" and sim.room_open("yard"), "bringing the deeds home did not end, or the Pitch isn't open: %s" % sim.deeds_fate)
	var held := {}
	for it in sim.stash:
		if Items.is_deeds(it):
			held = it
	_check(not held.is_empty(), "the deeds did not reach the stash")
	sim.sell_rarity(0)                       # the Fence's Commons button
	_check(sim.stash.has(held), "selling the commons sold the deeds")
	# sold
	sim.deeds_fate = ""
	var cash_before: float = sim.cash
	sim.sell(held)
	_check(sim.deeds_fate == "sold" and sim.cash > cash_before, "selling the deeds did not end, or did not pay")
	# the past: a death writes a runner down
	sim.hp = sim.max_hp()
	sim.deploy(3)
	var lost_before: int = sim.past.size()
	sim._kia()
	_check(sim.past.size() == lost_before + 1 and sim.past.back().has("end"), "a death did not write the runner into the past")
	# a death (21 Oct, the crew): the class stays the class, at level 1; its whole web back as points but the start (3 Nov)
	var fresh2 = load("res://scripts/sim/sim.gd").new()
	fresh2.start()
	_set_cls(fresh2, "Doorman")
	fresh2.training_points = 8
	fresh2.best_level = 5                      # the Pitch's own points: one a level of the crew's best
	var elem_tree: String = Data.ELEMENT_TREES[0]["name"]
	_check(_walk(fresh2, "Muscle/0") and _walk(fresh2, "Muscle/1") and _walk(fresh2, "The Pitch/0") and _walk(fresh2, "%s/0" % elem_tree), "the death test could not train")
	var spent: int = fresh2.points_spent()
	fresh2.deploy(0)
	fresh2._kia()
	_check(fresh2.cls == "Doorman" and fresh2.level() == 1, "a death did not keep the class at level 1: '%s' %d" % [fresh2.cls, fresh2.level()])
	_check(fresh2.tree == [Data.web_start("Doorman")], "a death did not give the runner's web back but the start: %s" % str(fresh2.tree))
	_check(fresh2.points_free() == fresh2.training_points and fresh2.training_points >= 8 and fresh2.points_spent() == 0 and spent > 0, "the refunded points are not free to spend: %d free" % fresh2.points_free())
	_check(fresh2.next_words() != Words.NEXT["past"], "after a death the Pitch says to pick a past: '%s'" % fresh2.next_words())
	_check(str(fresh2.events.back()[1]).contains("point") or str(fresh2.events[-2][1]).contains("point"), "the refund was not logged")
	main.show_room(main.BARRACKS)
	main._barracks.selected = ""
	main.refresh()
	_check(main._barracks._past.visible and main._barracks._past.text != "", "the Caravan does not show the runners before")
	_check_fit(main, "Caravan (past)")
	# papers: enough looks find one
	sim.hp = sim.max_hp()
	sim.deploy(3)
	var papers := 0
	for k in range(400):
		sim._find(sim.mission, sim.mission["t"])
		for it in sim.mission["found"]:
			if Items.is_paper(it):
				papers += 1
		sim.mission["found"] = []
	_check(papers > 0, "four hundred looks found no paper")
	sim.extract_now()
	# every item has its words, and they fit the panels' two rows
	for slot in Data.BASES:
		for b in Data.BASES[slot]:
			_check(Words.item_words(b["name"]) != "", "%s has no words" % b["name"])
	for a in Data.ATTACHMENTS:
		_check(Words.item_words(a["name"]) != "", "%s has no words" % a["name"])
	for u in Data.UNIQUES:
		_check(Words.UNIQUES.has(u["name"]), "%s has no past" % u["name"])
	# the vendors say something on a visit
	main.show_room(main.MARKET)
	main.refresh()
	_check(main._fence._line != "", "the Fence said nothing")
	_check_fit(main, "Fence (said)")
	# the A style on the vendors: the band with the face, the name and the figure; the line under it; the tabs in the band's foot; the sections
	var fv = main._fence
	# the rooms' one band across the top (10 Oct, Bands-U A): the kicker names the vendor, the figure in gold, no title line
	_check(fv._band.title.text == "" and fv._band.unit.text.contains("tin") and fv._band.kicker.text.begins_with("The Fence · ") and fv._band.size == Vector2(Pal.GRID_W, Pal.BAND_H), "the Fence's band is off: '%s' / '%s' / '%s' %s" % [fv._band.kicker.text, fv._band.title.text, fv._band.headline.text, str(fv._band.size)])
	_check(fv._said[0].text != "" and fv._side.position.y + fv._said[0].position.y >= fv.BAND_H, "the Fence's line is not under the band: '%s' at %.0f" % [fv._said[0].text, fv._side.position.y + fv._said[0].position.y])
	var ftab_x := 0.0
	for t in fv._tabs.filter(func(x): return x.visible):     # the Issuer's tab only after the Issue (25 Oct)
		_check(t.position.x >= fv._band.kicker.position.x + Pal.BAND_TEXT_W and t.position.x + t.size.x <= Pal.GRID_W - fv.PAD + 0.5 and t.position.x >= ftab_x, "a fence tab is not at the band's foot, right, in order: %s" % str(Rect2(t.position, t.size)))
		ftab_x = t.position.x + t.size.x
	for t in fv._tabs.slice(0, 4):
		_check(t.position.y + t.size.y <= fv.BAND_H and t.visible, "a fence tab is not in the band's foot")
	# Fence A (19 Oct): a row a rarity, then the boxes; no old tiles
	_check(fv._sell.visible and fv._sell.row_of(0)["name"].text == "Common" and fv._sell.row_of(Data.RARITIES.size() - 1)["name"].text == str(Data.RARITIES[Data.RARITIES.size() - 1]["name"]) and not fv._side_tiles.any(func(t): return t["button"].visible), "the Fence's rarity rows are off: %s" % str(range(Data.RARITIES.size()).map(func(r): return fv._sell.row_of(r)["name"].text)))
	_check(fv._band.kicker.position.x >= fv._face.position.x + fv._face.size.x or not fv._face.visible, "the Fence's words sit on the face")
	main.show_room(main.MEDIC)
	main.refresh()
	_check(main._clinic._line != "", "the medic said nothing")
	_check_fit(main, "Clinic (said)")
	var cv = main._clinic
	_check(cv._band.title.text == "" and cv._band.kicker.text.begins_with("The Clinic") and cv._band.headline.text == "%d" % sim.hp_shown() and cv._band.unit.text.begins_with("of %d HP" % sim.max_hp_shown()), "the Clinic's band is off: '%s' / '%s' / '%s'" % [cv._band.title.text, cv._band.headline.text, cv._band.unit.text])
	var body = cv._body
	_check(body.visible and body._head.text.begins_with("THE RUNNER") and body._bar_left.text == "HP %d of %d" % [sim.hp_shown(), sim.max_hp_shown()], "the Clinic's runner is off: '%s' / '%s'" % [body._head.text, body._bar_left.text])
	# the meds as cards (Clinic B): a card a kind, the stash's and the rig's, each what it heals and a second's
	var med_kinds := {}
	for it in sim.stash + sim.rig:
		if Items.is_medical(it):
			med_kinds[it["base"]] = true
	cv._show("stash")
	main.refresh()
	var mc = cv._meds
	var cards: Array = mc._cards.filter(func(c): return c["button"].visible)
	_check(cards.size() == mini(med_kinds.size(), mc.CARDS), "the Clinic shows %d med cards for %d kinds" % [cards.size(), med_kinds.size()])
	for c in cards:
		var cure: bool = Data.BASES[Data.MEDICAL].any(func(b): return str(b["name"]) == str(c["base"]) and b.has("cure"))     # a cure's card says what it stops (28 Oct)
		_check(str(c["total"].text).contains(" HP ") or (cure and str(c["total"].text).begins_with("Stops")), "a med card does not say what it heals: '%s'" % c["total"].text)
	# a heal node trained elsewhere moves the cards' figures without anything else changing (the reviewer's catch)
	if not cards.is_empty():
		var heal_before: String = cards[0]["total"].text
		var hold_tree: Array = sim.tree.duplicate()
		var heal_node := ""
		for b in Data.TREES:
			for i in range(b["nodes"].size()):
				if b["nodes"][i].get("effect", "") == "heal_pct" and heal_node == "":
					heal_node = "%s/%d" % [b["name"], i]
		if heal_node != "" and not sim.tree.has(heal_node):
			sim.tree.append(heal_node)
			mc._shown = ""
			main.refresh()
			_check(cards[0]["total"].text != heal_before, "a heal node did not move the Clinic's med figure: still '%s'" % heal_before)
			sim.tree = hold_tree
			main.refresh()
	cv._show("shelf")
	sim.load_dict(save)
	print("narrative ok: site lines, the deeds three ways, the past, papers, every item's words, the vendors")


func _run_screen(main) -> void:
	var sim = main.sim
	sim.hp = sim.max_hp()
	sim.set_depth(3, 1)
	var tries := 0
	while tries < 5 and not (sim.on_mission() and sim.mission["found"].size() >= 2):
		if not sim.on_mission():
			sim.hp = sim.max_hp()
			sim.deploy(3)
		var guard := 0
		while sim.on_mission() and sim.mission["found"].size() < 2 and guard < 600:
			sim.mission["clock"] = 900.0         # the test wants the run, not the clock
			sim.advance(1.0)
			if sim.on_mission() and sim.hp < sim.max_hp() * 0.3:
				sim.hp = sim.max_hp()     # the test wants the run, not the risk
			guard += 1
		tries += 1
	if not sim.on_mission():
		_check(false, "run screen: no run reached two finds in five tries")
		return
	main.show_room(main.MISSIONS)
	_check_fit(main, "Run (live)")
	# the run's panel sits level with the pack's; the rig's pouches show in the Runner panel; a med found goes in the rig
	var run_ui = main._run
	_check(run_ui._left.size.y == Pal.ROOM_H and run_ui._band.size.x == run_ui.BODY_W, "the run's column is not the room's height with the band across it")
	var shown_cells := 0
	var shown_outlines := 0
	for c in run_ui._rig_cells:
		if c.visible:
			shown_cells += 1
	for o in run_ui._rig_outlines:
		if o.visible:
			shown_outlines += 1
	# an item takes a cell a pouch (a first aid kit two): the cells and the empty outlines add up to the rig, like the Lock-up's (Matt, 6 Oct)
	_check(shown_cells == mini(sim.rig.size(), run_ui.RIG_MAX) and shown_outlines == mini(sim.med_capacity(), run_ui.RIG_MAX) - mini(sim.rig_used(), run_ui.RIG_MAX), "the rig on the run screen shows %d cells and %d empty pouches for %d items in %d of %d pouches" % [shown_cells, shown_outlines, sim.rig.size(), sim.rig_used(), sim.med_capacity()])
	for c in run_ui._rig_cells:
		if c.visible:
			var it_c: Dictionary = sim.rig.filter(func(x): return x["id"] == c.id)[0]
			_check(Items.size(it_c) == 1 or c.size.x > c.size.y * 1.5, "a %d-pouch item shows as one pouch on the run" % Items.size(it_c))
	for c in run_ui._rig_cells:
		if c.visible:
			var pr := Rect2(Vector2.ZERO, run_ui._left.size)
			_check(pr.encloses(Rect2(c.position, c.size)), "a rig cell on the run screen leaves its panel: cell %s, panel %s" % [str(Rect2(c.position, c.size)), str(pr)])
			# the row's where the screen has it: under the take in a fight, under the crates in the search (14 Oct)
			_check(c.position.y >= run_ui._rig_y and c.position.y + c.size.y <= run_ui._rig_y + Pal.CELL, "a rig cell sits outside the rig's row: %.0f, the row at %.0f" % [c.position.y, run_ui._rig_y])
	# a pouch is the control: pressing a med's cell uses it
	if sim.med_capacity() > 0 and sim.mission["using"] == null:
		while not sim.rig_room(1) and not sim.rig.is_empty():
			sim.rig.pop_back()
		var pouch_med: Dictionary = sim._plain(Data.MEDICAL, "Bandage")
		sim.rig.append(pouch_med)
		sim.hp = sim.max_hp() * 0.5
		main.refresh()
		var kp := -1
		for i in range(run_ui._rig_cells.size()):
			if run_ui._rig_cells[i].visible and run_ui._rig_cells[i].id == pouch_med["id"]:
				kp = i
		_check(kp >= 0, "the med in the rig has no pouch on the run screen")
		if kp >= 0:
			run_ui._rig_pressed(kp)
			_check(sim.mission["using"] != null and sim.mission["using"]["name"] == "Bandage", "pressing the pouch did not use the med")
			main.refresh()
			_check_fit(main, "Run (med in use)")
	if sim.med_capacity() > 0:
		var found_med: Dictionary = sim._plain(Data.MEDICAL, "Bandage")
		sim.mission["found"].append(found_med)
		while not sim.rig_room(1) and not sim.rig.is_empty():
			sim.rig.pop_back()
		main.refresh()
		main._run._inv._pick(main._run._inv.cell_of(found_med["id"]))
		main.refresh()
		_check(main._run._pick.button_texts().has("Take into the rig") and not main._run._pick._buttons[0].disabled, "a med in the pack offers no Take into the rig: %s" % str(main._run._pick.button_texts()))
		_check_fit(main, "Run (a med picked)")
		var rig_n: int = sim.rig.size()
		main._run._take_pick()
		_check(sim.rig.size() == rig_n + 1 and not sim.mission["found"].has(found_med), "Take into the rig did not move the med")
		main.refresh()
		_check_fit(main, "Run (med taken)")
		# rounds top up the rig's stack of the same type
		while not sim.rig_room(1) and not sim.rig.is_empty():
			sim.rig.pop_back()                      # a pouch free: the gate's top-up (16 Oct) can leave the rig full
		# a box found stays a box in the pack (28 Oct, magazines: it fills them at home), and the pick says so
		var box: Dictionary = sim._plain(Data.AMMO, "Nails")
		Items.set_stack(box, 10)
		sim.mission["found"].append(box)
		_check(not sim.take_from_pack(box["id"]), "rounds found went loose into the rig")
		_check(sim.mission["found"].has(box) and Items.stack_size(box) == 10, "the box found didn't stay whole in the pack")
		main.refresh()
		var bk: int = main._run._inv.cell_of(box["id"])
		_check(bk >= 0, "the fixture: the box isn't drawn in the pack")     # 28 Oct, the tools review: a -1 pick passed with nothing tested
		main._run._inv._pick(bk)
		main.refresh()
		_check(bk < 0 or main._run._inv.selected == int(box["id"]), "the box in the pack wasn't picked")
		_check(not main._run._pick.button_texts().has("Take into the rig"), "a box in the pack offers Take into the rig: %s" % str(main._run._pick.button_texts()))
		_check_fit(main, "Run (a box picked)")
		main._run._inv.selected = -1
		main.refresh()
	var m: Dictionary = sim.mission
	# the pack is the bag's own shape (27 Oct): its cells as outlines, every piece where the sim says it lies
	_check_pack_grid(main._run._inv, sim, "the pack")
	var mine: Array = m["found"].filter(func(x): return not x.get("carried", false))     # the gate's box is never ditched (the second review)
	var first: Dictionary = mine[0] if not mine.is_empty() else m["found"][0]
	var n_before: int = m["found"].size()
	main._run._inv._pick(main._run._inv.cell_of(first["id"]))
	main.refresh()
	_check(main._run._pick.button_texts().has("Ditch"), "picking a find did not offer Ditch: %s" % str(main._run._pick.button_texts()))
	_check_fit(main, "Run (pick)")
	var rh = main._run._pick._heads[0]
	_check(rh.visible and not main._run._pick._empty_title.visible and rh._title.text != "" and rh._chips[0].visible and main._run._pick._tag_labels[0].text.contains("tin"), "the run's pick has no head or price tag: %s / %s" % [rh._title.text, main._run._pick._tag_labels[0].text])
	_pick_boxes_check(main._run._pick, "the run's pick")
	main._run._ditch_pick()
	_check(sim.mission["found"].size() == n_before - 1, "Ditch did not drop the find")
	var mine2: Array = sim.mission["found"].filter(func(x): return not x.get("carried", false))     # the gate's box is never ditched (the second review)
	if not mine2.is_empty():
		main._run._inv._toggle_many()
		main.refresh()
		main._run._inv._pick(main._run._inv.cell_of(mine2[0]["id"]))
		main.refresh()
		_check_fit(main, "Run (many)")
		main._run._inv._sell_chosen()
		_check(sim.mission["found"].size() == n_before - 2, "Select many did not ditch")
		main._run._inv._toggle_many()
	var was_clear: bool = sim.mission["cleared"] and not sim.mission.get("ghost_pending", false)
	main._run._get_out()
	if was_clear:
		_check(not sim.on_mission(), "Get out now did not end the run")
	else:
		_check(sim.on_mission() and sim.mission.get("way_out", false), "Get out now before the clear did not take the way out")
		sim.extract_now()
	print("run screen ok")


## The class trees: a class tree node trains, is refunded on a class change, a
## typed node idles without its gun, a keystone changes a rule, the Yard's
## upgrades buy.
func _class_trees(main) -> void:
	var sim = main.sim
	sim.core_gates = false            # Training's 15 Oct gates are _training_gate_checks'; this area tests the mechanics
	_set_cls(sim, "Doorman")
	sim.training_points += 20
	_check(sim.trees().size() == Data.TREES.size() + Data.ELEMENT_TREES.size() + 1 and sim.trees().back()["name"] == Data.RING_TREE, "a Doorman does not see the whole web and the ring")
	_check(_walk(sim, "Muscle/0") and _walk(sim, "Muscle/1") and _walk(sim, "Muscle/2") and _walk(sim, "Muscle/3"), "the Muscle tree did not train")
	var spent_before: int = sim.points_spent()
	_check(not sim.can_train("Stalking/0"), "a Poacher's tree trained for a Doorman")
	# Shotgunner is typed: it counts with a shotgun in hand and idles otherwise
	var gun = sim.equipped["Primary"]
	var shotgun := Items.roll("Primary", 1, sim.rng)
	shotgun["base"] = "Farmer's shotgun"
	shotgun["affixes"] = []
	sim.equipped["Primary"] = shotgun
	_check(sim.gun_type() == "shotgun" and sim.tree_sum("damage_pct") >= 25.0, "Shotgunner did not count with a shotgun in hand: %s" % sim.tree_sum("damage_pct"))
	sim.equipped["Primary"] = sim._plain("Primary", "Nail gun")
	_check(sim.tree_sum("damage_pct") < 25.0, "Shotgunner counted without a shotgun")
	sim.equipped["Primary"] = gun
	main.show_room(main.BARRACKS)
	_check_fit(main, "Caravan (Doorman)")
	# the fixture's class change drops the old class's corner and keeps the rest of the web (the outer ring's cluster under
	# the Doorman's start here: the web's version two has no "join" region, its roads are the centre's)
	var join_id: String = Data.web_of_slot("o4")
	_check(Data.web_region(join_id) == "centre", "the outer ring's cluster under the Doorman isn't the centre's: %s" % Data.web_region(join_id))
	sim.training_points += 1
	_walk(sim, join_id)
	_set_cls(sim, "Drifter")
	_check(not sim.tree.has("Muscle/0") and sim.tree.has(join_id), "changing class did not drop the Doorman's corner and keep the join")
	_check(sim.points_spent() < spent_before, "the refund did not free the points")
	main.show_room(main.BARRACKS)
	_check_fit(main, "Caravan (Drifter)")
	# a keystone: Never there - no lot ever comes (the path up the lane to it: the web, 22 Oct)
	for i in [0, 1, 2, 4, 3, 5, 7, 8, 6]:
		_walk(sim, "Moving on/%d" % i)
	_check(sim.tree.has("Moving on/6"), "the Drifter's keystone did not train: %d points free" % sim.points_free())
	_check(sim.patrol_s(sim.effective(3)) == INF, "Never there still has lots coming")
	main.show_room(main.BARRACKS)
	main._barracks._pick("Moving on/6")
	_check_fit(main, "Caravan (keystone)")
	sim.respec()
	sim.tree = []                    # the Pitch's too: a respec keeps the camp's (21 Oct), the fixture wants it bare
	_set_cls(sim, "Doorman")
	_radio_juice_checks(main)
	_clock_checks(main)
	_way_out_checks(main)
	_purse_checks(main)
	_backdrop_checks(main)
	_room_band_checks(main)
	_panel_words_checks(main)
	_rail_order_checks(main)
	_web47_checks(main)                       # BUILD47 V: the skill web's Training screen
	_web49_checks(main)                       # BUILD49 V: Training's web at version two's size
	_m47_checks(main)                         # merge 47's fix round (the review of build 47)
	_web_art_checks(main)                     # 0.12.1: the web's art back
	_place_art_checks(main)
	# the Yard's upgrades
	sim.cash += 1000000.0                       # whatever inflation has done by now
	for k in ["generator", "lookout", "kennel"]:
		sim.yard_picks.erase(k)                 # the bot may have built them already
	sim._yard_changed("")
	_check(sim.yard_pick("generator", 0, "a") and sim.yard_pick("lookout", 0, "a") and sim.yard_pick("kennel", 0, "a"), "a yard pick did not buy: %s / %s / %s" % [sim.yard_pick_block("generator", 0, "a"), sim.yard_pick_block("lookout", 0, "a"), sim.yard_pick_block("kennel", 0, "a")])
	_check(is_equal_approx(sim.generator_max_energy() - Data.FX["yard_rank/generator"] * sim.yard_rank("generator"), Data.FX["yard/jerry_can"]), "the Jerry can did not add its max energy: %.1f" % sim.generator_max_energy())
	main.show_room(main.OVERVIEW)
	_check_fit(main, "The Pitch (upgrades)")
	# every class's trees on the screen, for the fit check
	for c in Data.CLASSES:
		_set_cls(sim, c["name"])
		main.show_room(main.BARRACKS)
		_check_fit(main, "Caravan (%s)" % c["name"])
	_set_cls(sim, "Doorman")
	sim.core_gates = true
	print("class trees, keystone and pitch upgrades ok")
	_tree_rules_checks(main)
	_tree_effect_checks(main.sim)
	_webs_traits(main)
	_pool_checks(sim)


## The charm: one cell on the body, magic find and cash. Sockets: gear rolls
## up to two, six socketables go in them, each adding what nothing else does.
func _charm_sockets(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	var charm: Dictionary = sim._plain("Charm", "Casino chip")
	charm["affixes"] = [{"stat": "rarity_pct", "value": 10}]
	sim.equipped["Charm"] = null
	var without: float = sim.rarity_bonus()
	sim.stash.append(charm)
	_check(sim.can_equip_item(charm["id"]) and sim.equip_item(charm["id"]), "the charm did not equip from the stash")
	_check(sim.equipped["Charm"] != null and sim.equipped["Charm"]["id"] == charm["id"], "the charm is not on the body")
	_check(is_equal_approx(sim.charm_find(), 18.0 + sim._affix_sum("rarity_pct")), "a Casino chip with +10 magic find reads %.1f, not %.1f" % [sim.charm_find(), 18.0 + sim._affix_sum("rarity_pct")])
	_check(sim.rarity_bonus() > without + 0.27, "the charm's magic find did not reach rarity_bonus: %.2f vs %.2f" % [sim.rarity_bonus(), without])
	_check(sim.charm_cash() >= 15.0, "the charm's cash did not count: %.1f" % sim.charm_cash())
	_check(Items.headline(charm)[0] == "+28%" and Items.headline(charm)[1] == "loot quality", "a charm's headline is not its magic find: %s" % str(Items.headline(charm)))
	# charms roll like gear: rarities and affixes from their own list (they had rolled plain since the stacks)
	var rolled_rare := 0
	var rolled_stats := {}
	for k in range(200):
		var c: Dictionary = Items.roll("Charm", 3, sim.rng, 0.0, false, false, "", "", 0.33, 3)
		if int(c["rarity"]) > 0:
			rolled_rare += 1
		for a in c["affixes"]:
			rolled_stats[a["stat"]] = true
	_check(rolled_rare > 20, "charms roll plain: %d of 200 above common" % rolled_rare)
	_check(rolled_stats.size() >= 6, "charms roll only %s" % str(rolled_stats.keys()))
	# and the Bench can add an affix to one
	if sim.on_mission():
		sim.extract_now()
	var add_cost: int = sim.craft_cost(charm, "add")
	_check(add_cost > 0, "the Bench will not add an affix to a charm")
	sim.cash = maxf(sim.cash, add_cost + 1.0)
	var n_before: int = charm["affixes"].size()
	_check(sim.craft(charm["id"], "add", "") and charm["affixes"].size() == n_before + 1, "adding an affix to the charm did not take (mission %s, cost %d, cash %.0f)" % [str(sim.on_mission()), add_cost, sim.cash])
	# the body shows it in its own cell beside the primary
	main.show_room(main.ARMOURY)
	_check_fit(main, "Armoury (charm)")
	_check(main._armoury._body._boxes["Charm"]["cell"].visible, "the charm's cell is not shown on the body")
	# charms turn up among a site's finds
	var charms := 0
	sim.words[3] = []                          # no codes leaning the drops (19 Oct, the flaky check: 3 of 400)
	sim.deploy(3)
	var m: Dictionary = sim.mission
	var eff: Dictionary = sim.effective(3)
	for i in range(400):
		m["found"] = []
		sim._find(m, eff)
		if not m["found"].is_empty() and Items.is_charm(m["found"][0]):
			charms += 1
	sim.extract_now()
	_check(charms > 4 and charms < 60, "charms are %d of 400 finds; 5%% was the aim (level %d, wearable %d, site words %s, weather %s)" % [charms, sim.level(), sim.wearable_level(), str(sim.words[3]), str(sim.weather_of(3))])
	# sockets: a gun with two, a socketable in each, its effect on the figures
	var gun: Dictionary = sim._plain("Primary", "Army SMG")
	gun["attachments"]["socket 1"] = null
	gun["attachments"]["socket 2"] = null
	_check(Items.sockets(gun) == 2, "a gun given two sockets reads %d" % Items.sockets(gun))
	var old_gun = sim.equipped["Primary"]
	sim.equipped["Primary"] = gun
	var fluid: Dictionary = sim._plain("Attachment", "Lighter fluid")
	var salt: Dictionary = sim._plain("Attachment", "Road salt")
	_check(Items.is_socketable(fluid) and fluid["mount"] == "socket", "Lighter fluid is not a socketable")
	sim.stash.append(fluid)
	sim.stash.append(salt)
	var dps_before: float = sim.dps()
	var armour_before: float = sim.armour()
	var fire_before: float = sim.conversion()["fire"]      # the secondary or the tree may carry some already
	_check(sim.fit(sim.equipped["Primary"]["slot"], fluid["id"]), "fit() did not seat a socketable in the first socket")
	_check(gun["attachments"]["socket 1"] != null and gun["attachments"]["socket 1"]["base"] == "Lighter fluid", "the fluid is not in socket 1")
	_check(sim._fitted_sum("conv_fire_pct") >= 15.0 - 0.001 and sim.conversion()["fire"] > fire_before and sim.type_dps()["fire"] > 0.0 and is_equal_approx(sim.dps(), dps_before), "fire in a socket did not convert 15%% more: %.2f -> %s" % [fire_before, str(sim.conversion())])
	_check(sim.fit_socket("Primary", "socket 2", salt["id"]), "fit_socket() did not seat the salt in socket 2")
	_check(sim.armour() > armour_before, "salt in a socket did not raise armour")
	_check(not sim.stash.has(fluid) and not sim.stash.has(salt), "the socketables did not leave the stash")
	var salt_count_before: int = 0
	for st in sim.stash:
		if st["base"] == "Road salt":
			salt_count_before += Items.stack_size(st)
	var salt_count_after: int = 0
	var stripped: bool = sim.strip("Primary", "socket 2")
	for st in sim.stash:
		if st["base"] == "Road salt":
			salt_count_after += Items.stack_size(st)
	_check(stripped and salt_count_after == salt_count_before + 1, "strip() did not take the salt back (it may merge into a stack): %d -> %d" % [salt_count_before, salt_count_after])
	_check(not sim.fit_socket("Primary", "optic", salt["id"]), "a socketable went on an optic mount")
	# rolled gear carries sockets at the stated odds, never more than SOCKET_MAX
	var with := 0
	var most := 0
	for i in range(300):
		var g: Dictionary = Items.roll(Data.SOCKET_SLOTS[i % 4], 6, sim.rng)
		var n: int = Items.sockets(g)
		most = maxi(most, n - Items.socket_cap(g))     # over its own cap: SOCKET_MAX, an improvised gun's one more (29 Oct)
		if n > 0:
			with += 1
	_check(most <= 0 and with > 100 and with < 240, "sockets rolled on %d of 300, %d over a piece's cap; 55%% with up to %d was the aim" % [with, most, Data.SOCKET_MAX])
	var charm_rolls := Items.roll("Charm", 6, sim.rng)
	_check(Items.sockets(charm_rolls) == 0, "a charm rolled sockets")
	# the Workshop's Sockets view: the gun's two rows, pick one, fit through it
	main.show_room(main.WORKSHOP)
	main._workshop._set_view("sockets")
	_check_fit(main, "Workshop (sockets)")
	main._workshop._pick_mount("Primary", "socket 2")
	_check_fit(main, "Workshop (socket pick)")
	main._workshop._pick_cell(0)
	_check_fit(main, "Workshop (socketable pick)")
	main._workshop._press(0)              # Fit
	_check(gun["attachments"]["socket 2"] != null, "Fit through the Sockets view did not seat the socketable")
	main._workshop._pick_mount("Primary", "socket 2")
	main._workshop._press(0)              # Strip
	_check(gun["attachments"]["socket 2"] == null, "Strip through the Sockets view did not take it back")
	main._workshop._set_view("guns")
	_check(main._workshop._all_attachments(false).filter(func(it): return Items.is_socketable(it)).is_empty(), "the Guns view's grid shows socketables")
	_check_fit(main, "Workshop (guns again)")
	_craft_view_checks(main)
	for base in ["Lighter fluid", "Antifreeze", "Rat poison", "Car battery", "Road salt", "Copper wire", "Lucky penny", "Bank's own pen"]:
		_check(Words.item_words(base) != "" and Words.item_words(base).ends_with("."), "%s has no line" % base)
	sim.equipped["Primary"] = old_gun
	sim.load_dict(saved)
	print("charm and sockets ok: magic find, cash, finds, two sockets, fit/strip, the Sockets view")


## A refresh leaves every showing button showing (9 Oct): the card grid hid all eight cards and showed
## the used ones again ten times a second, and a hidden control drops its hover and any press in
## progress - the Radio's buttons flickered and took a click only now and then. Every room, the Radio
## with a tier open and its buttons up: one refresh, and no showing button - nor any control above it -
## may have lost and regained its visibility. Watched up the chain, not on the button alone: the smoke
## runs before the tree has drawn, where nothing reports visible in the tree and a hidden parent does
## not pass the change on to its buttons; `_showing` walks the flags the same way.
func _refresh_toggle_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	var saved_room: String = main.room
	sim.cash = maxf(sim.cash, 100000.0)
	var items: Array = []
	_all_items_under(main, items)
	var toggled := {}
	var counter := func(n): toggled[n] = true
	for n in items:
		n.visibility_changed.connect(counter.bind(n))
	# the watcher itself: a card hidden and shown must reach the counter here, or every room would pass on nothing
	var probe = main._cards[0]
	var was: bool = probe.visible
	probe.visible = not was
	probe.visible = was
	_check(toggled.has(probe), "the toggle watcher heard nothing from a card hidden and shown: the check would pass on nothing")
	toggled.clear()
	var radio_buttons := 0
	for r in main.ROOMS:
		main.show_room(r)
		main.refresh()
		toggled.clear()
		main.refresh()
		for n in items:
			if not (n is BaseButton) or not _showing(n):
				continue
			var q = n
			while q is CanvasItem and q != main:
				if toggled.has(q):
					_check(false, "%s: a refresh hid and showed '%s'%s (it drops the hover and a press in progress)" % [r, str(n.get("text")) if n.get("text") != null else str(n.name), "" if q == n else " by way of a %s above it" % q.get_class()])
					break
				q = q.get_parent()
		if r == main.COMMS:
			radio_buttons = items.filter(func(n): return n is BaseButton and _showing(n) and main._radio.is_ancestor_of(n)).size()
	for n in items:
		n.visibility_changed.disconnect(counter)
	_check(radio_buttons >= 1, "the Radio showed %d buttons: the check had nothing to look at" % radio_buttons)
	sim.load_dict(saved)
	main.show_room(saved_room)
	print("refresh toggles ok: every room, no showing button (or anything above it) hidden and shown again by a refresh")


## Every CanvasItem under n, shown or not (the toggle check connects them all before it changes room).
static func _all_items_under(n: Node, out: Array) -> void:
	if n is CanvasItem:
		out.append(n)
	for c in n.get_children():
		_all_items_under(c, out)


## The Workshop's Craft view: the stash's gear only, the panel reads the
## piece's tiers and prices, Bench opens the menu, everything fits.
func _craft_view_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	sim.cash = 100000.0
	var piece: Dictionary = Items.roll("Primary", 6, sim.rng, 12)
	piece["affixes"] = [{"stat": "hp", "value": 20.0, "tier": 2}, {"stat": "damage_pct", "value": 10.0, "tier": 1}]
	sim.stash.append(piece)
	main.show_room(main.WORKSHOP)
	main._workshop._set_view("craft")
	var ws = main._workshop
	_check(ws._piece.visible and ws._jobs.visible, "the Craft view's piece card or jobs are hidden")
	# the view buttons read white whichever is on (Guns started as a primary button and kept its dark text, 8 Oct)
	for v in ws._views:
		_check(v.get_theme_color("font_color") == Pal.TEXT, "the %s view button's text is not white" % v.text)
	_check(ws._piece_title.text.begins_with("Pick a piece"), "the Craft view does not ask for a piece first: %s" % ws._piece_title.text)
	_check(ws._job_tiles.all(func(t): return t["price"].text == "" and t["button"].disabled), "the job tiles carry prices with nothing picked")
	_check(ws._build.visible and ws._build.text == "Build for scrap" and not ws._build.disabled, "Build for scrap is not up with nothing picked")
	_check_fit(main, "Workshop (craft, nothing picked)")
	var shown: Array = ws._craftable()
	_check(not shown.is_empty() and shown.all(func(it): return not Items.is_attachment(it) and not Items.is_medical(it) and not it.has("unique")), "the Craft view's grid shows parts, meds or uniques")
	var k: int = shown.find(piece)
	if k < 0:
		for i in range(shown.size()):
			if is_same(shown[i], piece):
				k = i
	_check(k >= 0, "the rolled piece is not in the Craft view's grid")
	main.refresh()
	var piece_cell: int = ws._inv.cell_of(int(piece["id"]))     # its cell, not its place in the list (a bigger stash pages it: 13 Oct)
	if piece_cell < 0:
		for p in range(8):
			ws._inv._turn(1)
			main.refresh()
			piece_cell = ws._inv.cell_of(int(piece["id"]))
			if piece_cell >= 0:
				break
	_check(piece_cell >= 0, "the rolled piece has no cell in the Craft view")
	ws._pick_cell(maxi(0, piece_cell))
	_check(ws._piece_title.text != "Pick a piece", "picking a piece did not fill the piece card")
	_check(ws._piece_chips.words(1) == "Item level %d" % Items.ilvl(piece), "the piece card's level chip is wrong: %s" % ws._piece_chips.words(1))
	_check(ws._affix_rows[0]["tag"].text.begins_with("T2 ") and ws._affix_rows[0]["tag"].text.contains("–") and ws._affix_rows[0]["label"].text.begins_with("+20"), "the first affix row does not read the affix and its tier: '%s' %s" % [ws._affix_rows[0]["label"].text, ws._affix_rows[0]["tag"].text])
	_check(ws._affix_rows[2]["label"].text == "No third affix", "the missing third affix's row is off: %s" % ws._affix_rows[2]["label"].text)
	# regen rolls in tenths (the pass, 20 Oct): T1 0.2, T5 0.9-1.0 at the campaign's levels; the row, its range and a compare read them so
	var rg_def: Dictionary = Items.affix_def("regen")
	var rg_rng := RandomNumberGenerator.new()
	rg_rng.seed = 7
	var rg1: Dictionary = Items.roll_affix(rg_def, 1, rg_rng, 1)
	var rg5: Dictionary = Items.roll_affix(rg_def, 1, rg_rng, 5)
	_check(typeof(rg1["value"]) == TYPE_FLOAT and is_equal_approx(float(rg1["value"]), 0.2) and float(rg5["value"]) >= 0.9 and float(rg5["value"]) <= 1.0, "regen does not roll in tenths: T1 %s, T5 %s" % [str(rg1["value"]), str(rg5["value"])])
	var rg_hold: Array = piece["affixes"].duplicate(true)
	piece["affixes"][0] = {"stat": "regen", "value": 0.4, "tier": 2}
	ws._shown = ""
	ws.show_state(sim)
	_check(ws._affix_rows[0]["label"].text.begins_with("+0.4") and ws._affix_rows[0]["tag"].text.begins_with("T2") and (ws._affix_rows[0]["tag"].text == "T2" or ws._affix_rows[0]["tag"].text.contains(".")), "a regen row does not read in tenths: '%s' %s" % [ws._affix_rows[0]["label"].text, ws._affix_rows[0]["tag"].text])
	var rg_other: Dictionary = piece.duplicate(true)
	rg_other["affixes"][0] = {"stat": "regen", "value": 0.7, "tier": 4}
	_check(PickPanel.deltas_of(rg_other, piece).any(func(d): return str(d[1]) == "0.3 HP/s"), "a regen compare does not read in tenths: %s" % str(PickPanel.deltas_of(rg_other, piece)))
	piece["affixes"] = rg_hold
	ws._shown = ""
	ws.show_state(sim)
	_check(ws._affix_buttons[0].visible and ws._affix_buttons[0].text.contains("tin") and not ws._affix_buttons[0].disabled, "the re-roll values button is not priced and live: %s" % ws._affix_buttons[0].text)
	_check(ws._job_tiles[ws.JOBS.find("bump")]["price"].text.ends_with("notes"), "the level tile is not priced in notes: %s" % ws._job_tiles[ws.JOBS.find("bump")]["price"].text)
	_check(ws._job_tiles[ws.JOBS.find("scrap")]["price"].text.begins_with("+") and ws._job_tiles[ws.JOBS.find("scrap")]["price"].text.ends_with("scrap"), "the scrap tile does not say what it gives: %s" % ws._job_tiles[ws.JOBS.find("scrap")]["price"].text)
	_check(ws._affix_buttons.all(func(b): return b.visible), "the two re-rolls aren't up on a piece with affixes")
	_check_fit(main, "Workshop (craft, piece picked)")
	# a padlock on the first affix (20 Oct): the two re-rolls inside the card, priced, the lock line saying it
	piece["locks"] = []
	ws._toggle_lock(0)
	_check(sim.locks_of(piece) == [piece["affixes"][0]["stat"]] and ws._affix_buttons[0].visible and ws._affix_buttons[1].visible, "a padlock on the first affix: %s" % str(sim.locks_of(piece)))
	_check(ws._affix_buttons[1].position.x + ws._affix_buttons[1].size.x <= ws.BODY_W - ws.PAD + 0.5, "the re-rolls run off the piece card")
	_check(ws._affix_buttons[0].text.contains("tin") and ws._affix_buttons[1].text.contains("tin"), "the re-rolls carry no price")
	_check_fit(main, "Workshop (craft, a padlock on)")
	# the padlocks drawn at 22 px, clear of their row's words (28 Oct, Matt: the padlocks over the affix words)
	for r in ws._affix_rows:
		var lk: TextureRect = r["lock"]
		var lr: Rect2 = lk.get_global_rect()
		_check(lk.size == Vector2(22, 22) and lr.end.x <= r["label"].get_global_rect().position.x + 0.5 and lr.end.y <= r["button"].get_global_rect().end.y + 0.5, "a padlock drawn %s at %s, over its words at %.0f" % [str(lk.size), str(lr.position), r["label"].get_global_rect().position.x])
	# the job runs in the room: new affixes keep the count and the locked one, the foot says what was done
	var before_affixes: int = piece["affixes"].size()
	var kept0: Dictionary = piece["affixes"][0].duplicate()
	ws._press_affix_job(1)
	main.refresh()
	var after: Dictionary = sim.item_by_id(piece["id"])
	_check(after.get("affixes", []).size() == before_affixes and after["affixes"][0] == kept0, "new affixes in the room changed the count or the locked one")
	_check(ws._foot.text.begins_with("Kept") or ws._foot.text.begins_with("New") or ws._foot.get_theme_color("font_color") == Pal.GOOD, "the jobs' foot does not say what the Bench did: %s" % ws._foot.text)
	_check(not main._menu.visible, "a job in the room opened the menu")
	_check_fit(main, "Workshop (craft, after a job)")
	# scrap from the room: the piece goes, the foot says what it gave, nothing stays picked
	var scrap_before: int = sim.scrap
	var gave: int = sim.scrap_of(after)
	ws._press_job(ws.JOBS.find("scrap"))
	_check(sim.item_by_id(piece["id"]).is_empty() and sim.scrap == scrap_before + gave, "the scrap tile did not scrap the piece for %d" % gave)
	_check(ws.sel_id == -1 and ws._piece_title.text.begins_with("Pick a piece") and ws._foot.text.begins_with("Scrapped"), "after scrapping: picked %d, title '%s', foot '%s'" % [ws.sel_id, ws._piece_title.text, ws._foot.text])
	_check_fit(main, "Workshop (craft, after scrapping)")
	ws._set_view("guns")
	_check(not ws._piece.visible and not ws._jobs.visible, "the piece card stayed up on the Guns view")
	sim.load_dict(saved)
	print("craft view ok: stash gear only, the piece card, the priced tiles, the padlocks and the re-rolls, a job in the room")


## Every tree node's effect has a reader (16 Oct: Fumes, Cumulative and Nicked carried dot_pct and nothing read it from
## the tree): the sim's own source names each effect - a tree_sum, a has_node, or one of the element families' patterns
## ("%s_pct", "conv_%s_pct", "proof_" + the element) - and a damage-over-time node grows a burn as the same stat on gear.
func _tree_effect_checks(sim) -> void:
	var src := FileAccess.get_file_as_string("res://scripts/sim/sim.gd") + FileAccess.get_file_as_string("res://scripts/sim/items.gd")
	var els := ["fire", "frost", "poison", "shock", "bleed", "physical"]
	var orphans := []
	for t in Data.TREES + Data.ELEMENT_TREES:
		for n in t["nodes"]:
			var e := str(n.get("effect", ""))
			if e == "":
				continue
			var read := src.contains('tree_sum("%s")' % e) or src.contains('has_node("%s")' % e) or src.contains('node_active("%s")' % e)
			for el in els:
				if e == "%s_pct" % el:
					read = read or src.contains('tree_sum("%s_pct" % ty)')
				if e == "conv_%s_pct" % el:
					read = read or src.contains('tree_sum("conv_%s_pct" % ty)')
				if e == "proof_%s" % el:
					read = read or src.contains('has_node("proof_" + ty)')
				if e == "%s_res" % el:
					read = read or src.contains('tree_sum("%s_res" % ty)')          # the web's resist fillers (22 Oct)
				if e == "%s_last_pct" % el:
					read = read or src.contains('tree_sum("%s_last_pct" % ty)')     # Oil drum, Serrated, Deep freeze, Takes its time
			if e == "skill_" + str(n.get("skill", "")):
				read = read or (Data.SKILLS.has(str(n["skill"])) and src.contains('has_node("skill_" + id)'))     # the skill nodes, through skill_known (milestone 8)
			if not read and not (e in orphans):
				orphans.append("%s (%s)" % [e, n["name"]])
	_check(orphans.is_empty(), "tree effects nothing reads: %s" % ", ".join(orphans))
	# Fumes: +20% to a burn's growth, as 20% dot_pct on gear gives
	var keep_tree: Array = sim.tree.duplicate()
	var keep_cls: String = sim.cls
	sim.cls = "Drifter"
	sim.tree = []
	var a := {}
	sim._dot_add(a, "fire", 100.0, 1.0e9)
	var fumes := -1
	var petrol: Dictionary = Data.tree_named("Petrol")
	for k in range(petrol["nodes"].size()):
		if str(petrol["nodes"][k].get("effect", "")) == "dot_pct":
			fumes = k
	sim.tree = ["Petrol/%d" % fumes]
	var b := {}
	sim._dot_add(b, "fire", 100.0, 1.0e9)
	var gear: float = sim._affix_sum("dot_pct")      # what the kit already carries: the node adds to it, as an affix would
	var want: float = float(a["fire"]) * (1.0 + (gear + float(petrol["nodes"][fumes]["value"])) / 100.0) / (1.0 + gear / 100.0)
	_check(fumes >= 0 and is_equal_approx(float(b["fire"]), want), "Fumes didn't grow the burn: %.2f, wanted %.2f" % [float(b.get("fire", 0.0)), want])
	# and only theirs: a burn on the runner (their fire's, in my_dots) doesn't grow with the runner's own node
	var kept_mission = sim.mission
	var mine: Dictionary = {}
	sim.mission = {"my_dots": mine}            # only the pool's identity is read: no run is started for it
	sim._dot_add(mine, "fire", 100.0, 1.0e9)
	var with_node: float = float(mine.get("fire", 0.0))
	sim.tree = []
	mine.clear()
	sim._dot_add(mine, "fire", 100.0, 1.0e9)
	sim.mission = kept_mission
	_check(with_node > 0.0 and is_equal_approx(with_node, float(mine.get("fire", 0.0))), "Fumes grew a burn on the runner: %.2f against %.2f" % [with_node, float(mine.get("fire", 0.0))])
	# nor the gear's +% dots (17 Oct, Matt): a dot_pct affix grows a burn on them, not one on you
	var plain_on_you: float = float(mine.get("fire", 0.0))
	var dot_slot: String = "Charm" if sim.equipped.get("Charm") != null else "Helmet"
	var dot_kit: Dictionary = (sim.equipped[dot_slot] if sim.equipped[dot_slot] != null else sim._plain(dot_slot, Data.BASES[dot_slot][0]["name"])).duplicate(true)
	dot_kit["affixes"] = dot_kit["affixes"] + [{"stat": "dot_pct", "value": 50, "tier": 1}]
	var kept_kit = sim.equipped[dot_slot]
	sim.equipped[dot_slot] = dot_kit
	sim._dry_memo.clear()
	mine.clear()
	sim.mission = {"my_dots": mine}
	sim._dot_add(mine, "fire", 100.0, 1.0e9)
	var theirs_pool := {}
	sim._dot_add(theirs_pool, "fire", 100.0, 1.0e9)
	sim.mission = kept_mission
	sim.equipped[dot_slot] = kept_kit
	sim._dry_memo.clear()
	_check(is_equal_approx(float(mine.get("fire", 0.0)), plain_on_you) and float(theirs_pool.get("fire", 0.0)) > plain_on_you * 1.4, "the gear's +50%% dots: a burn on you %.2f (plain %.2f), on them %.2f" % [float(mine.get("fire", 0.0)), plain_on_you, float(theirs_pool.get("fire", 0.0))])
	# the one figure (16 Oct, item 14): damage_split's burn is what the pool deals a second once it settles, worked
	# against _dot_add and _dot_tick themselves; and a node's "+N a second" is the figure with it less without it
	var conv := -1
	for k in range(petrol["nodes"].size()):
		if str(petrol["nodes"][k].get("effect", "")) == "conv_fire_pct" and conv < 0:
			conv = k
	sim.tree = ["Petrol/%d" % conv, "Petrol/%d" % fumes]
	sim.mission = null
	var split: Dictionary = sim.damage_split()
	var fire_rate: float = float(sim.type_dps()["fire"])
	var pool := {}
	var dealt := 0.0
	for step in range(4000):
		sim._dot_add(pool, "fire", fire_rate * 0.05, fire_rate)
		dealt = sim._dot_tick(pool, 0.05, {})
	var settled: float = dealt / 0.05
	_check(conv >= 0 and fire_rate > 0.0 and absf(settled - float(split["dots"].get("fire", 0.0))) <= 0.02 * settled, "the split's burn %.1f isn't what the pool settles to, %.1f" % [float(split["dots"].get("fire", 0.0)), settled])
	_check(is_equal_approx(float(split["total"]), float(split["hits"]) + float(split["dot"])) and float(split["hits"]) > 0.0, "the split doesn't add up: %s" % str(split))
	var tree_before: Array = sim.tree.duplicate()
	var gain: Array = sim.node_damage_gain("Petrol/%d" % fumes)
	sim.tree = ["Petrol/%d" % conv]
	var without: float = float(sim.damage_split()["total"])
	sim.tree = tree_before.duplicate()
	_check(sim.tree == tree_before and is_equal_approx(float(gain[0]), float(split["total"]) - without) and float(gain[0]) > 0.0, "Fumes's +N a second isn't the figure with it less without: %s against %.1f" % [str(gain), float(split["total"]) - without])
	var gain2: Array = sim.node_damage_gain("Petrol/%d" % conv)     # untrained the other way: taken on, then put back
	_check(sim.tree == tree_before, "trying a trained node off reordered the tree: %s, was %s" % [str(sim.tree), str(tree_before)])
	sim.tree = ["Petrol/%d" % fumes]
	var gain3: Array = sim.node_damage_gain("Petrol/%d" % conv)
	_check(sim.tree == ["Petrol/%d" % fumes] and float(gain2[0]) > 0.0 and is_equal_approx(float(gain2[0]), float(gain3[0])), "a node's gain reads differently trained (%.1f) and not (%.1f)" % [float(gain2[0]), float(gain3[0])])
	var burn_shown: bool = float(split["dots"].get("fire", 0.0)) < 0.5 or sim.split_words(split).contains("%.0f burning" % float(split["dots"]["fire"]))     # a burn under half a point a second isn't named (a weak kit's)
	var any_dot: bool = split["dots"].values().any(func(v): return float(v) >= 0.5)
	var lead_ok: bool = sim.split_words(split).begins_with("%.0f from hits" % float(split["hits"])) and sim.split_words(split, true).begins_with("Hits ") if any_dot else sim.split_words(split).begins_with("All of it hits")
	_check(burn_shown and lead_ok, "the split's words: %s (burn %.2f)" % [sim.split_words(split), float(split["dots"].get("fire", 0.0))])
	sim.mission = kept_mission
	sim.tree = keep_tree
	sim.cls = keep_cls
	print("tree effects all read; Fumes grows the burn on them, not on you; the split's burn settles as the pool does ok")


## The trees' rules (9 Oct, docs/design/trees.md §8): the lanes match the table; every joint's two halves in
## the fourth column, open on one, closed on both, for its class alone; a class change's price and its two
## presses, free for a new runner; the camp's high-water mark; the save.
func _tree_rules_checks(main) -> void:
	var sim = main.sim
	sim.core_gates = false            # Training's 15 Oct gates are _training_gate_checks'; this area tests the mechanics
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var bk = main._barracks
	var table := {"Drifter": ["Moving on", "Petrol", "Luck", "Live", "The Pitch"], "Scrapper": ["Stripping", "Live", "Fencing", "Petrol", "The Pitch"],
		"Poacher": ["Stalking", "The Rat Man", "Snares", "The cold", "The Pitch"], "Paramedic": ["Triage", "The Rat Man", "Shifts", "The cold", "The Pitch"],
		"Doorman": ["Muscle", "Blades", "The door", "Knuckles", "The Pitch"]}
	main.show_room(main.BARRACKS)
	for c in table:
		_set_cls(sim, c)
		bk.alt = ""
		bk._shown = ""
		main.refresh()
		# the web (22 Oct): every tree of the table's row is a region on the canvas, its class's two reachable at an entry
		var wv = bk.web()
		for tn in table[c]:
			if tn == "":
				continue
			_check(wv.layout.has("%s/0" % tn), "the %s's %s is not on the web" % [c, tn])
		_check(wv.state_of("%s/0" % table[c][0]).get("reach", false) or sim.tree.has("%s/0" % table[c][0]), "the %s's first tree's entry isn't reachable" % c)
	# a runner with no class: nothing takeable (no start yet, the skill web), and the Also row the pages
	sim.cls = ""
	sim.tree = []
	bk._shown = ""
	main.refresh()
	_check(sim.web_frontier(true).is_empty() and not sim.can_train("The Pitch/0") and not bk.also_names().has("Petrol"), "a runner with no class can take a node, or the Also row lists a tree")
	_check_fit(main, "Caravan (no past)")
	# every joint
	for j in Data.JOINTS:
		var halves := []
		for tn in [j["tree"], j["element_tree"]]:
			var t: Dictionary = Data.tree_named(tn)
			var found := -1
			for i in range(t["nodes"].size()):
				if str(t["nodes"][i].get("joint", "")) == j["key"]:
					_check(found < 0, "%s holds two halves of %s" % [tn, j["key"]])
					found = i
			_check(found >= 0 and Data.web_kind("%s/%d" % [tn, found]) == "notable" and t["nodes"][found].get("notable", false), "%s's half of %s is not a notable on the web" % [tn, j["key"]])
			halves.append("%s/%d" % [tn, found])
		_check(Data.tree_named(j["tree"]).get("class", "") == j["class"] and str(sim.node(halves[1]).get("class", "")) == j["class"], "%s's halves are not the %s's" % [j["key"], j["class"]])
		sim.cls = j["class"]
		sim.tree = [halves[0]]
		_check(not sim.has_joint(j["key"]), "%s closed on its class half alone" % j["key"])
		sim.tree = [halves[1]]
		_check(not sim.has_joint(j["key"]), "%s closed on its element half alone" % j["key"])
		sim.tree = [halves[0], halves[1], "%s/6" % j["element_tree"]]
		_check(sim.has_joint(j["key"]) and sim.node_active("%s/6" % j["element_tree"]), "%s did not close with both halves, or its keystone did not work" % j["key"])
		for c in table:
			if c != j["class"]:
				sim.cls = c
				_check(not sim.has_joint(j["key"]), "%s closed for a %s" % [j["key"], c])     # the keystone itself works for any class pathed to it (the web, 22 Oct)
				break
	# the crew (21 Oct): a runner with no class takes the first pick as theirs, one press, free, keeping what's trained
	sim.load_dict(saved)
	sim.cls = ""
	sim.roster = {}
	sim.tree = ["The Pitch/0", "The Rat Man/0"]
	var cash0: float = sim.cash
	bk._shown = ""
	main.refresh()
	bk._pick_class("Poacher")
	_check(sim.cls == "Poacher" and is_equal_approx(sim.cash, cash0) and sim.tree.has("The Pitch/0") and sim.tree.has("The Rat Man/0") and sim.roster.is_empty(), "the first pick did not make this runner the Poacher: %s %s" % [sim.cls, str(sim.tree)])
	# a swap: two presses, free; the Poacher's own kept by the crew; a class not played comes in with the arrival's kit, at the crew's floor (30 Oct)
	sim.xp = Data.xp_for_level(12)
	var poacher_gun = sim.equipped["Primary"]
	bk._shown = ""
	main.refresh()
	bk._pick_class("Doorman")
	_check(sim.cls == "Poacher" and bk._armed == "Doorman" and bk._notice.text.contains("press again"), "the first press swapped, or said nothing: '%s'" % bk._notice.text)
	_check(bk._title.text.begins_with("Doorman") or (bk._swap_card.visible and bk._swap_card.title.text.begins_with("Doorman")), "the armed swap's panel does not show the Doorman: '%s'" % bk._title.text)     # a class not yet run: the swap card (BUILD49 U, item 6)
	_check_fit(main, "Caravan (a swap armed)")
	bk._pick_class("Doorman")
	_check(sim.cls == "Doorman" and sim.level() == 12 - Data.CREW_FLOOR_UNDER and is_equal_approx(sim.cash, cash0) and sim.tree == [Data.web_start("Doorman")] and sim.web_spent() == 0 and sim.equipped["Primary"] != null and sim.equipped["Primary"]["base"] == sim.START_WEAPON, "a swap to a new class is off: %s at level %d, %s" % [sim.cls, sim.level(), str(sim.tree)])
	_check(sim.roster.has("Poacher") and sim.crew_level("Poacher") == 12 and is_same(sim.roster["Poacher"]["equipped"]["Primary"], poacher_gun), "the crew did not keep the Poacher's own: %s" % str(sim.roster.keys()))
	_check(poacher_gun == null or sim.item_by_id(int(poacher_gun["id"])).is_empty(), "the Poacher's gun is still the Doorman's to reach")
	_check(bk._class_cards[Data.CLASSES.map(func(c): return c["name"]).find("Poacher")]["tag"].text.contains("12"), "the Poacher's card does not say his level: '%s'" % bk._class_cards[Data.CLASSES.map(func(c): return c["name"]).find("Poacher")]["tag"].text)
	_check_fit(main, "Caravan (the crew)")
	# not on a run
	sim.hp = sim.max_hp()
	sim.deploy(0)
	_check(sim.on_mission() and not sim.set_class("Poacher") and sim.cls == "Doorman", "a class swapped on a run")
	sim.extract_now()
	# and back: the Poacher's level, tree and kit as he left them, the Doorman's to the crew
	_press_class(main, "Poacher")
	_check(sim.cls == "Poacher" and sim.level() == 12 and sim.tree.has("The Rat Man/0") and sim.tree.has("The Pitch/0") and sim.tree.count("The Pitch/0") == 1 and is_same(sim.equipped["Primary"], poacher_gun) and sim.roster.has("Doorman") and not sim.roster.has("Poacher") and not sim.roster["Doorman"]["tree"].has("The Pitch/0"), "the swap back lost the Poacher's own: %s level %d %s" % [sim.cls, sim.level(), str(sim.tree)])
	# saved and loaded
	var crew_d: Dictionary = JSON.parse_string(JSON.stringify(sim.to_dict()))
	var cfresh = Sim.new()
	cfresh.load_dict(crew_d)
	_check(cfresh.cls == "Poacher" and cfresh.roster.has("Doorman") and cfresh.crew_level("Doorman") == 12 - Data.CREW_FLOOR_UNDER and cfresh.roster["Doorman"]["equipped"]["Primary"] != null, "the crew did not survive a save: %s" % str(cfresh.roster.keys()))
	_check(cfresh.set_class("Doorman") and cfresh.level() == 12 - Data.CREW_FLOOR_UNDER and cfresh.equipped["Primary"] != null and typeof(cfresh.equipped["Primary"]["rarity"]) == TYPE_INT and typeof(cfresh.equipped["Primary"]["id"]) == TYPE_INT, "a loaded crew's runner would not come out, or came out with float figures")
	# one pool (the skill web, 3 Nov): every web node - the centre's, an element's, a class's - from the runner's points
	_check(sim.free_for("The Pitch/1") == sim.points_free() and sim.free_for("The Rat Man/3") == sim.points_free() and sim.free_for("Stalking/3") == sim.points_free() and sim.web_free() == sim.points_free(), "a web node isn't bought from the runner's one pool")
	# a node picked disarms a swap
	bk._pick_class("Doorman")
	bk._pick(Data.COMMON_TREE + "/1")
	_check(bk._armed == "", "picking a node did not disarm the swap")
	_stash_tab_checks(main)
	# the camp's high-water mark: levels under the best earn nothing; past it, a point a level
	sim.load_dict(saved)
	sim.best_level = 10
	sim.xp = Data.xp_for_level(3)
	var pts0: int = sim.training_points
	var before: int = sim.level()
	sim.xp = Data.xp_for_level(9)
	sim._earn_points(before)
	_check(sim.training_points == pts0 and sim.best_level == 10, "a runner re-levelling under the camp's best earned %d points" % (sim.training_points - pts0))
	before = sim.level()
	sim.xp = Data.xp_for_level(12)
	sim._earn_points(before)
	_check(sim.training_points == pts0 + 2 * Data.POINTS_A_LEVEL and sim.best_level == 12, "past the camp's best a level did not earn two points (the web's version two): %d, best %d" % [sim.training_points - pts0, sim.best_level])
	# saves: the tree and the best level go in
	sim.load_dict(saved)
	var next_to: String = str(Data.web_links(Data.web_start(sim.cls))[0])     # one the rule takes: a load makes a tree legal (merge 47)
	sim.tree = [Data.web_start(sim.cls), next_to]
	sim.training_points = maxi(sim.training_points, 1)
	var d: Dictionary = sim.to_dict()
	_check(d.has("best_level"), "the save has no best level")
	sim.load_dict(d)
	_check(sim.tree == [Data.web_start(sim.cls), next_to], "a save's tree did not load as saved: %s" % str(sim.tree))
	sim.load_dict(saved)
	bk.alt = ""
	bk._armed = ""
	bk._shown = ""
	main.refresh()
	sim.core_gates = true
	print("tree rules ok: the lanes, ten joints, a class change's price and presses, the high-water mark, the save")
	_joint_payoff_checks(main)


## Every joint's payoff (trees.md §3), read at the function it lives in, both halves trained straight into the
## tree; with the joint open each reads plain.
func _joint_payoff_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.words[3] = []
	sim.set_depth(3, 1)
	var close := func(key: String) -> void:
		var j: Dictionary = Data.joint(key)
		sim.cls = j["class"]
		sim.tree = []
		for tn in [j["tree"], j["element_tree"]]:
			var t: Dictionary = Data.tree_named(tn)
			for i in range(t["nodes"].size()):
				if str(t["nodes"][i].get("joint", "")) == key:
					sim.tree.append("%s/%d" % [tn, i])
	var fresh_run := func() -> Dictionary:
		if sim.on_mission():
			sim.extract_now()
		sim.hp = sim.max_hp()
		sim.deploy(3)
		sim.mission["dots"] = {}
		return sim.mission
	# the Drifter's fire: an SMG's hit lights them, a burn already there never shrinks, and a burning gang takes a quarter more
	close.call("drifter_fire")
	sim.equipped["Primary"] = sim._plain("Primary", _base_of_type("smg"))
	var m: Dictionary = fresh_run.call()
	_check(is_equal_approx(sim._joint_hit_mult(m, "smg"), 1.0), "the Drifter's joint added to a gang not burning")
	m["dots"]["fire"] = 500.0
	sim._joints_on_hit(m, m["t"], 10.0, "smg", 0.1)
	_check(float(m["dots"]["fire"]) >= 500.0 and is_equal_approx(sim._joint_hit_mult(m, "smg"), 1.25) and is_equal_approx(sim._joint_hit_mult(m, "rifle"), 1.0), "the Drifter's joint shrank the burn or missed the quarter: %.1f" % float(m["dots"]["fire"]))
	# the Drifter's bleed (joints B): a bleeding kill's drop rolls its rarity twice - more rare things over many kills
	close.call("drifter_bleed")
	m = fresh_run.call()
	var counts := [0, 0]
	for shocked in [false, true]:
		sim.rng.seed = 4242
		for k in range(400):
			m["found"] = []
			m["kill_bleeding"] = shocked
			sim._find(m, m["t"], true)
			for it in m["found"]:
				if it["slot"] in Data.SLOTS and int(it.get("rarity", 0)) >= 1:
					counts[1 if shocked else 0] += 1
	_check(counts[1] > counts[0], "a bleeding kill's drops are no rarer: %d against %d" % [counts[1], counts[0]])
	# the Scrapper's shock: every improvised hit shocks
	close.call("scrapper_shock")
	m = fresh_run.call()
	m["shock_t"] = 0.0
	sim._joints_on_hit(m, m["t"], 10.0, "improvised", 0.1)
	_check(float(m["shock_t"]) >= 1.0, "an improvised hit did not shock with the Scrapper's joint")
	# the Scrapper's fire: a kill while it burns drops something, and the Fence pays a fifth more
	var piece: Dictionary = sim._plain("Helmet", "Hard hat")
	sim.tree = []
	var plain_price: int = sim.sell_price(piece)
	close.call("scrapper_fire")
	_check(sim.sell_price(piece) >= int(plain_price * 1.19), "the Scrapper's joint did not lift the Fence's price: %d to %d" % [plain_price, sim.sell_price(piece)])
	m = fresh_run.call()
	var t_dry: Dictionary = m["t"].duplicate()
	t_dry["drop"] = 0.0
	var finds0: int = int(m.get("finds", 0))
	m["kill_burning"] = true
	sim._kill(m, t_dry)
	_check(int(m.get("finds", 0)) == finds0 + 1, "a kill while it burned dropped nothing with the Scrapper's joint")
	# the Scrapper's class: improvised guns do 20% more, nothing else does, and no other class's do (12 Oct)
	var cls_keep: String = sim.cls
	var mission_keep = sim.mission
	sim.mission = null                       # a class changes only at the Yard
	var imp_gun: Dictionary = sim._plain("Primary", _base_of_type("improvised"))
	var smg_gun: Dictionary = sim._plain("Primary", _base_of_type("smg"))
	_set_cls(sim, "Scrapper")
	_check(is_equal_approx(sim._class_gun_mult(imp_gun), 1.2) and is_equal_approx(sim._class_gun_mult(smg_gun), 1.0), "the Scrapper's improvised guns are not 20%% up, or another gun is: %.2f / %.2f" % [sim._class_gun_mult(imp_gun), sim._class_gun_mult(smg_gun)])
	_set_cls(sim, "Doorman")
	_check(sim.cls == "Doorman" and is_equal_approx(sim._class_gun_mult(imp_gun), 1.0), "a Doorman's improvised gun takes the Scrapper's 20%%: %s" % sim.cls)
	_set_cls(sim, cls_keep)
	sim.mission = mission_keep
	# the Poacher's poison: the first shot on a gang lands its poison at full stacks
	close.call("poacher_poison")
	m = fresh_run.call()
	m["fresh"] = true
	m["dots"]["poison"] = 0.01
	sim._joints_on_hit(m, m["t"], 10.0, "rifle", 0.1)
	var full: float = float(m["dots"]["poison"])
	_check(full > 1.0 and m.has("full_dose"), "the first shot's poison is not at full stacks: %.2f" % full)
	m["dots"]["poison"] = 0.01
	sim._joints_on_hit(m, m["t"], 10.0, "rifle", 0.1)
	_check(float(m["dots"]["poison"]) < full, "the full dose landed twice on one gang")
	# the Rat Man's Bag lifts the cap, not the fill (12 Oct, the lorry-fix read: a full dose at 999 stacks was thousands of seconds of the gun)
	var bag_was = sim.equipped["Backpack"]
	sim.equipped["Backpack"] = Items.roll_unique(sim._unique_named("The Rat Man's Bag"), sim.rng)
	sim._dry_memo.clear()
	_check(sim.dot_stacks("poison") >= 999 and sim.dot_fill_stacks("poison") == (15 if sim.has_node("poison_stacks") else int(Data.DOTS["poison"]["stacks"])), "the Rat Man's Bag's uncapped stacks reach the full dose: %d" % sim.dot_fill_stacks("poison"))
	m = fresh_run.call()
	m["fresh"] = true
	m["dots"]["poison"] = 0.01
	sim._joints_on_hit(m, m["t"], 10.0, "rifle", 0.1)
	var bag_full: float = float(m["dots"]["poison"])
	var bag_rate: float = float(sim.type_dps()["poison"]) * (1.0 - float(m["t"].get("res", {}).get("poison", 0.0))) * sim.pace() * float(m["t"]["pace"])
	var bag_cap: float = bag_rate * float(Data.DOTS["poison"]["ratio"]) * sim.dot_seconds("poison") * sim.dot_fill_stacks("poison") * sim.dot_depth() * maxf(sim.dot_grow(), 1.0)     # the cap grows with dot_pct (16 Oct)
	_check(m.has("full_dose") and bag_cap > 1.0 and is_equal_approx(bag_full, bag_cap), "the full dose with the Bag is not the tree's stacks: %.0f against %.0f" % [bag_full, bag_cap])
	sim.equipped["Backpack"] = bag_was
	# the Paramedic's shock (joints B): a med shocks them 3 s; the Paramedic's frost: chilled, they do 30% less and meds heal a fifth more
	close.call("paramedic_shock")
	m = fresh_run.call()
	m["shock_t"] = 0.0
	m["using"] = {"name": "Bandage", "left": 0.0, "heal": 10.0}
	sim._patch(m, 0.1)
	_check(float(m.get("shock_t", 0.0)) >= sim.status_s(3.0) - 0.001 and float(m["dots"].get("poison", 0.0)) <= 0.0, "a med did not shock them with the Paramedic's joint: %.2f" % float(m.get("shock_t", 0.0)))
	close.call("paramedic_frost")
	m = fresh_run.call()
	_check(is_equal_approx(sim._joints_on_incoming(m, true, 0.1), 0.7) and is_equal_approx(sim._joints_on_incoming(m, false, 0.1), 1.0), "chilled gangs do not do 30%% less with the Paramedic's joint")
	sim.hp = sim.max_hp() * 0.2
	var hp0: float = sim.hp
	m["chill_t"] = 1.0
	m["using"] = {"name": "Bandage", "left": 0.0, "heal": 10.0}
	sim._patch(m, 0.1)
	_check(is_equal_approx(sim.hp - hp0, 12.0), "a med did not heal a fifth more while they were chilled: %.1f" % (sim.hp - hp0))
	# Flattened: a kill with the plain staggers the next of them, half their fire for two seconds
	sim.cls = "Doorman"
	sim.tree = ["Knuckles/10"]
	m = fresh_run.call()
	m["target_hp"] = 0.0
	sim._fight(m, m["t"], 0.05)
	_check(float(m.get("flat_t", 0.0)) > 0.0, "a kill with the plain did not flatten the next")
	var flat_on: float = float(maxi(1, mini(int(m.get("remaining", 1)), sim.contact(m["t"]))))     # one man of those on you fires at half, not the gang (25 Oct, the review)
	var flat_x: float = sim._joints_on_incoming(m, false, 0.1)
	_check(flat_x <= 1.0 - 0.5 / flat_on + 0.001 and flat_x < 1.0, "Flattened did not halve the next man's fire: ×%.2f with %d on you" % [flat_x, int(flat_on)])
	if sim.on_mission():
		sim.extract_now()
	# the sum strip's Physical chip, the Doorman's knuckles alone: what it ignores, never a "+0%"
	sim.cls = "Doorman"
	sim.tree = ["Knuckles/5"]
	var phys: Array = main._barracks.sum_items([]).filter(func(it): return str(it.get("tag", "")) == "Physical")
	_check(phys.size() == 1 and phys[0]["forms"].all(func(f): return str(f) != "" and not str(f).contains("+0%")) and phys[0]["forms"].slice(1).all(func(f): return str(f).contains("+") or str(f).contains("ignores")), "the pen-only Physical chip reads a nothing: %s" % str(phys))
	# the sum strip past the cap (31 Oct, the physical floor): the Poacher's poison and frost trees at 75% each read 45% and
	# 45% - nine tenths between them, a tenth of every hit left physical, as the fight's conversion (the Physical chip
	# itself shows only with a physical figure, and the Poacher's two open elements leave Knuckles shut)
	sim.cls = "Poacher"
	sim.tree = []
	for t_name in ["The Rat Man", "The cold"]:
		var et: Dictionary = Data.tree_named(t_name)
		for i in range(et["nodes"].size()):
			if str(et["nodes"][i].get("effect", "")).begins_with("conv_") and not et["nodes"][i].has("class"):
				sim.tree.append("%s/%d" % [t_name, i])
	var raw_p: float = sim.tree_sum("conv_poison_pct")
	var raw_f: float = sim.tree_sum("conv_frost_pct")
	var strip: Array = main._barracks.sum_items_raw()
	var tag_of := func(tag: String) -> String:
		var hit: Array = strip.filter(func(it): return str(it.get("tag", "")) == tag)
		return str(hit[0]["forms"][0]) if not hit.is_empty() else "none"
	var want_p: float = 100.0 * Data.CONV_CAP * raw_p / (raw_p + raw_f)
	var want_f: float = 100.0 * Data.CONV_CAP * raw_f / (raw_p + raw_f)
	_check(raw_p + raw_f > 100.0 and tag_of.call("Poison").begins_with("%.0f%% of hits" % want_p) and tag_of.call("Frost").begins_with("%.0f%% of hits" % want_f),
		"the sum strip past the cap (%.0f%% converted) reads poison '%s', frost '%s', not %.0f%% and %.0f%% (a tenth physical)" % [raw_p + raw_f, tag_of.call("Poison"), tag_of.call("Frost"), want_p, want_f])
	# the plain figures count the notables as the fight does: Spray's quarter with an SMG in hand, none without
	sim.cls = "Drifter"
	sim.tree = ["Moving on/3"]
	sim.equipped["Primary"] = sim._plain("Primary", _base_of_type("smg"))
	var dmg: Array = main._barracks.sum_items([]).filter(func(it): return str(it.get("tag", "")) == "Damage")
	_check(dmg.size() == 1 and str(dmg[0]["forms"][0]) == "+25%", "the strip's Damage leaves out Spray: %s" % str(dmg))
	sim.equipped["Primary"] = sim._plain("Primary", "Nail gun")
	dmg = main._barracks.sum_items([]).filter(func(it): return str(it.get("tag", "")) == "Damage")
	_check(dmg.is_empty(), "the strip counts Spray without an SMG in hand: %s" % str(dmg))
	sim.load_dict(saved)
	main.refresh()
	print("joint payoffs ok: the ten joints and Flattened, each where it lives")


## The trees as webs: a fork at the notable, a branch each way; the second
## past from level 30; two runners turn up when one dies.
func _webs_traits(main) -> void:
	var sim = main.sim
	sim.core_gates = false            # Training's 15 Oct gates are _training_gate_checks'; this area tests the mechanics
	var saved: Dictionary = sim.to_dict()
	_set_cls(sim, "Poacher")
	sim.respec()
	sim.tree = []
	sim._ensure_start(false)
	sim.training_points += 30
	# the skill web (3 Nov, docs/design/skill_web.md): a node is taken joined to one owned - the class's start owned from
	# the first, free - a point each, wherever it sits
	var start: String = Data.web_start("Poacher")
	_check(start == "Stalking/0" and sim.web_owned(start) and sim.tree.has(start) and sim.node_cost(start) == 0 and sim.web_spent() == 0, "the Poacher's start isn't Clean shot, owned and free: %s %s" % [start, str(sim.tree)])
	var near: String = str(Data.web_links(start)[0])
	_check(sim.can_train(near) and not sim.can_train("Stalking/6") and sim.web_can_take("Stalking/6") == Words.WEB_BLOCK["joined"], "pathing is off: the start's neighbour should open, One shot not: '%s'" % sim.web_can_take("Stalking/6"))
	_check(Data.web_links(start).has(sim.path_next("Stalking/6")), "the path to One shot doesn't start beside the start: %s" % sim.path_next("Stalking/6"))
	_check(sim.web_steps("Stalking/6") == sim.web_path("Stalking/6").size() and sim.web_steps("Stalking/6") >= 5, "One shot's steps are off: %d" % sim.web_steps("Stalking/6"))
	_check(_walk(sim, "Stalking/6") and sim.has_node("one_shot"), "One shot did not train along its path (the gates off): '%s'" % sim.train_block("Stalking/6"))
	var night: String = Data.node_id_named("Snares/Night work")
	_check(_walk(sim, night) and sim.has_node("night_work"), "Night work did not take")
	_check(sim.effective(3)["rarity"] > 0.0 and sim.effective(3)["pace"] < 1.0, "Night work did not make the site Night")
	_check(_walk(sim, Data.node_id_named("Snares/Dead quiet")) and sim.has_node("cap_dead_quiet"), "the capstone did not train along its path")
	# the third keystone sits beside the other two (no keystone choice on the web): all three held
	var clocked: String = Data.node_id_named("Stalking/Clocked")
	var snare: String = Data.node_id_named("Stalking/Snare and wait")
	_check(clocked != "" and snare != "" and sim.node(clocked).get("notable", false) and Data.web_kind(snare) == "keystone", "the hung nodes are not on the web")
	_check(_walk(sim, clocked) and sim.has_node("clocked"), "Clocked did not train: '%s'" % sim.train_block(clocked))
	_check(_walk(sim, snare) and sim.has_node("snare_and_wait") and sim.has_node("one_shot"), "taking a second keystone let the first go: '%s'" % sim.train_block(snare))
	# the fillers: one stat each, a small node with its place and links; the web's 1,549 (version two, 4 Nov)
	var fillers := 0
	var stats := {}
	for id in Data.web_ids():
		var nd: Dictionary = sim.node(str(id))
		if nd.get("filler", false):
			fillers += 1
			stats[nd["effect"]] = true
			_check(nd.has("value") and nd.has("at") and nd.has("slot") and not Data.web_links(str(id)).is_empty() and Data.web_kind(str(id)) == "small", "filler %s is malformed" % id)
	_check(fillers >= 95 and stats.size() >= 8, "the web has %d fillers of %d stats" % [fillers, stats.size()])     # 98 since merge 47 put Word of mouth, Long walks and Circuits on three
	_check(Data.web_ids().size() == 1549, "the web has %d nodes, not the layout's 1,549" % Data.web_ids().size())
	# the fillers' stats read: a regen filler heals; a resist filler counts
	var mending: String = ""
	for i in range(Data.tree_named("Petrol")["nodes"].size()):
		var nd: Dictionary = Data.tree_named("Petrol")["nodes"][i]
		if nd.get("effect", "") == "fire_res":
			mending = "Petrol/%d" % i
	var res0: float = sim.resist_raw("fire")
	if mending != "":
		var kept_tree: Array = sim.tree.duplicate()
		sim.tree.append(mending)
		sim._dry_memo.clear()
		_check(sim.resist_raw("fire") > res0 + 2.9, "a fire resist filler did not raise the resist: %.1f -> %.1f" % [res0, sim.resist_raw("fire")])
		sim.tree = kept_tree
		sim._dry_memo.clear()
	main.show_room(main.BARRACKS)
	_check_fit(main, "Caravan (web)")
	# the traits: one on the runner now; a death brings two to choose from
	sim.runner_trait = "Heavy-handed"
	_check(is_equal_approx(sim.trait_mult("damage"), 1.08) and is_equal_approx(sim.trait_mult("pace"), 0.95), "Heavy-handed's figures did not read")
	sim.runner_trait = "Lucky"
	var r0: float = sim.rarity_bonus()
	sim.runner_trait = ""
	_check(sim.rarity_bonus() < r0 - 0.09, "Lucky did not add to rarity_bonus")
	sim.promised = "Wary"
	sim.hardcore = false
	sim.deploy(3)
	sim.mission["hp_start"] = sim.hp
	sim._kia()
	_check(sim.candidates.size() == 2 and sim.candidates[1] == "Wary", "two did not turn up with the promised one among them: %s" % str(sim.candidates))
	_check(sim.runner_trait == sim.candidates[0], "the runner in hand is not the first candidate")
	# the pick is the Map's card column (21 Oct, the canvas): the two as cards, what went and what stays, Set off shut
	var menu_was: bool = main._menu.visible
	main.show_room(main.MISSIONS)
	main.refresh()
	var ms = main._missions
	_check(ms._pick.visible and not ms._cols[0]["panel"].visible and main._menu.visible == menu_was, "the trait pick isn't on the Map")
	_check(ms._pick_cards[1]["name"].text == "Wary" and ms._pick_cards[1]["chips"].shown() >= 1 and ms._pick_go.disabled, "the pick's cards or its shut Set off are off: '%s'" % ms._pick_cards[1]["name"].text)
	_check(ms._pick_kicker.text.to_lower().contains("back at level %d" % sim.level()) and ms._pick_lost.shown() >= 4, "the pick doesn't say what the death took: '%s', %d chips" % [ms._pick_kicker.text, ms._pick_lost.shown()])
	_check(Missions.trait_chips("Tins +15%, max HP −10%").map(func(c): return c["colour"]) == [Pal.GOOD, Pal.BAD], "a trait's cost isn't in the bad tone")
	_check_fit(main, "The Map (back at level 1)")
	# away with a death: the tally's card open doesn't cover the pick (the review); the Radio's Set off waits for it
	ms._came_open = true
	var cb_was: Dictionary = sim.came_back.duplicate(true)
	sim.came_back_seen()
	sim.came_back["runs"] = 1
	sim.came_back["deaths"] = 1
	ms._shown = ""
	main.refresh()
	_check(not ms._came.visible and ms._came_btn.disabled and ms._pick.visible, "the came-back card covers the trait pick")
	sim.came_back = cb_was
	ms._came_open = false
	main._radio.show_state(sim)
	if not sim.signals.is_empty():
		_check(main._radio._set_off.disabled and main._radio._set_off.text.contains("trait"), "the Radio's Set off doesn't wait for the trait: '%s'" % main._radio._set_off.text)
	ms._pick_cards[1]["button"].pressed.emit()
	main.refresh()
	_check(sim.runner_trait == "Wary" and sim.candidates.is_empty(), "picking the second runner did not take")
	_check(not ms._pick.visible and ms._cols[0]["panel"].visible, "the site's card did not come back after the pick")
	_check(sim.trait_mult("patrol") > 1.1, "Wary's gangs come no later")
	sim.load_dict(saved)
	sim.core_gates = true
	print("webs, the second past and traits ok")
	_element_checks(main)
	_element_bot_checks(main)
	_web_rule_checks(main)
	_web_pool_checks(main)


## The skill web's one pool (3 Nov, docs/design/skill_web.md "The one rule for spending"): every node on the web is the
## runner's own, bought from its points - a swap brings the other class's own web, a reset and a death give back all
## but the start, another class's half works for anyone, and a pair is done only for its class with both halves owned.
func _web_pool_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	sim.core_gates = false
	_set_cls(sim, "Scrapper")
	sim.respec()
	sim.tree = []
	sim._ensure_start(false)
	sim.training_points = 20
	sim.rewards_earned = {}                   # the camp's reward points aside: the fixture counts the trained alone (BUILD50-T: the bot's camp earned one)
	var start: String = Data.web_start("Scrapper")
	_check(sim.tree == [start] and sim.web_points() == 20 and sim.web_free() == 20 and sim.web_spent() == 0, "the fixture: the Scrapper with only his start, 20 points: %s" % str(sim.tree))
	# an element's node, the centre's and a class's all from the one pool
	var live: String = Data.node_id_named("Live/Current")
	var centre: String = Data.web_of_slot("C")
	_check(_walk(sim, live) and sim.web_free() == 20 - sim.web_spent() and sim.web_spent() == sim.tree.size() - 1, "an element's node didn't come out of the runner's points: %d spent, %d free" % [sim.web_spent(), sim.web_free()])
	var spent1: int = sim.web_spent()
	_check(_walk(sim, centre) and sim.web_spent() > spent1 and sim.web_free() == sim.web_points() - sim.web_spent(), "the centre didn't come out of the runner's points")
	# a swap: the other class's own web, and back
	var mine: Array = sim.tree.duplicate()
	_check(sim.set_class("Doorman") and sim.tree == [Data.web_start("Doorman")] and not sim.tree.has(live), "a swap kept the Scrapper's web: %s" % str(sim.tree))
	_check(sim.set_class("Scrapper") and sim.tree == mine, "the swap back lost the Scrapper's web: %s" % str(sim.tree))
	# a reset: every point back but the start's, at its price
	var price: int = sim.respec_cost()
	_check(price == sim._inf(sim.web_spent() * Data.RESPEC_CASH), "the reset's price isn't RESPEC_CASH a point spent: %d" % price)
	sim.cash += price
	var cash0: float = sim.cash
	_check(sim.web_reset() and sim.tree == [start] and sim.web_spent() == 0 and is_equal_approx(sim.cash, cash0 - price) and sim.skill_known("ring_main"), "a reset didn't give back all but the start: %s" % str(sim.tree))
	_check(not sim.can_respec() and not sim.web_reset(), "a reset with nothing spent went through")
	# a death: the whole web back to points but the start
	_walk(sim, live)
	sim._refund_runner_trees()
	_check(sim.tree == [start] and sim.web_spent() == 0, "a death kept web nodes: %s" % str(sim.tree))
	# another class's half works for anyone on the web; its pair is that class's alone
	var paddles: String = Data.node_id_named("Live/Paramedic's paddles")
	var shock0: float = sim.tree_sum("shock_pct")
	_check(_walk(sim, paddles) and sim.node_active(paddles) and sim.tree_sum("shock_pct") >= shock0 + 25.0, "the Paramedic's half did nothing for a Scrapper on his own web")
	var defib: String = Data.node_id_named("Shifts/Defib")
	_check(_walk(sim, defib) and sim.web_owned(paddles) and not sim.has_joint("paramedic_shock"), "a Scrapper closed the Paramedic's pair")
	_check(sim.web_pairs().map(func(p): return str(p["key"])) == ["scrapper_shock", "scrapper_fire"], "the Scrapper's pairs aren't his two: %s" % str(sim.web_pairs()))
	sim.load_dict(saved)
	sim.core_gates = true
	print("the web's one pool ok")


## Train up to the nodes touching `id` without taking it (the walk, stopped one short).
func _walk_to_touch(sim, id: String) -> void:
	var path: Array = sim.web_path(id)
	for nxt in path.slice(0, path.size() - 1):
		if sim.points_free() < sim.node_cost(str(nxt)):
			sim.training_points += sim.node_cost(str(nxt))
		if not sim.train_node(str(nxt)):
			return


## The web's new rules (22 Oct, web.md §2a): each keystone and starred notable read where the sim reads it.
func _web_rule_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	sim.core_gates = false
	_set_cls(sim, "Poacher")
	sim.respec()
	sim.tree = []
	var nodes := {}
	for path in ["Stalking/Snare and wait", "Snares/Twine", "The door/Last orders", "Live/Overload", "Muscle/Bin lid", "Triage/Jab", "Triage/Worst first",
			"Moving on/B-roads", "Stripping/Workbench", "Moving on/On a roll", "Petrol/Oil drum", "The cold/Brittle",
			"Blades/Arterial", "Knuckles/Floored", "Live/Capacitor", "Stalking/Clocked", "Shifts/Clocking off", "Fencing/Back pocket", "Stripping/Breaker's yard", "Muscle/Off the canvas"]:
		nodes[path] = Data.node_id_named(path)
		_check(nodes[path] != "", "%s is not on the web" % path)
	var with := func(ids: Array) -> void:
		sim.tree = ids.map(func(k): return nodes[k])
		sim._dry_memo.clear()
	# Snare and wait: the gang one fewer, the first of it at half
	sim.deploy(3)
	var m: Dictionary = sim.mission
	var t: Dictionary = m["t"]
	var plain_pool: int = int(m["remaining"])
