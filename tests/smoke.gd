	m = sim.mission
	var shallow: int = sim.thin_after(m["t"])
	var expect := func(d: int) -> int: return int(roundf(Data.THIN_AFTER + Data.THIN_PER_DEPTH * d))     # quantity is more a search, not more searches (Matt, 26 Oct)
	_check(shallow == expect.call(int(m["t"]["depth"])), "thin_after reads %d, not %d" % [shallow, expect.call(int(m["t"]["depth"]))])
	var heavy: Dictionary = sim._plain("Backpack", Data.BASES["Backpack"][0]["name"])
	heavy["affixes"] = [{"stat": "loot_pct", "value": 100, "tier": 5}]
	sim.equipped["Backpack"] = heavy
	_check(sim.thin_after(m["t"]) == shallow, "+100%% quantity pushed the searches as well as the finds: %d from %d" % [sim.thin_after(m["t"]), shallow])
	var deeper: Dictionary = m["t"].duplicate()
	deeper["depth"] = int(m["t"]["depth"]) + 3
	_check(sim.thin_after(deeper) > sim.thin_after(m["t"]), "depth did not push the searches")
	sim.extract_now()
	sim.equipped["Backpack"] = hold_pack
	_yard_set(sim, "kennel", 4, hold_kennel)
	sim.load_dict(saved)
	main.refresh()
	# the start (13 Oct, Matt): a hammer, no rounds to need, and melee behind the tier's best gun
	var camp = Sim.new()
	camp.start()
	_check(camp.equipped["Primary"] != null and camp.equipped["Primary"]["base"] == "Claw hammer" and not camp.rig.any(func(x): return Items.is_ammo(x)), "a new camp does not start with the hammer and no rounds")
	for b in Data.BASES["Primary"]:
		if b["type"] == "melee" and not b.get("start", false):
			var best_gun := 0.0
			for g in Data.BASES["Primary"]:
				if g["type"] != "melee" and int(g["tier"]) == int(b["tier"]) and not g.get("start", false):
					best_gun = maxf(best_gun, float(g["damage"]) * float(g["rof"]))
			_check(best_gun <= 0.0 or float(b["damage"]) * float(b["rof"]) < best_gun * 0.9, "%s at %.0f a second is not behind its tier's best gun (%.0f)" % [b["name"], float(b["damage"]) * float(b["rof"]), best_gun])
	print("crates ok: the queue, the panel, the opening, the save, picked clean, the leans, the sites' own, the dog's nose, depth and quantity")


## The Kit room's bin (13 Oct, Matt's playtest: the stash full with the Fence and the Workshop shut): a stash pick has
## Bin for its scrap; a unique asks twice; the deeds never; with the Fence shut, Select-many bins the plain things.
func _bin_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var hold_unlocked = sim.unlocked.duplicate()
	sim.unlocked.erase("fence")
	while not sim.stash_room(12) and not sim.stash.is_empty():
		sim.stash.pop_back()
	var junk: Dictionary = sim._plain("Helmet", "Hard hat")
	var prize: Dictionary = Items.roll_unique(Data.UNIQUES[0], sim.rng)
	sim.stash_put(junk)
	sim.stash_put(prize)
	main.show_room(main.ARMOURY)
	main._armoury._inv.kind = 0
	main._armoury._inv.rarity = -1
	main.refresh()
	main._armoury._pick_cell(main._armoury._inv.cell_of(junk["id"]))
	main.refresh()
	var bin_i: int = -1
	for k in range(main._armoury._pick._buttons.size()):
		if main._armoury._pick._buttons[k].visible and main._armoury._pick._buttons[k].text == "Scrap":
			bin_i = k
	_check(bin_i >= 0, "a stash pick has no Bin")
	_check_fit(main, "Lock-up (the bin)")
	var scrap0: int = int(sim.scrap)
	if bin_i >= 0:
		main._armoury._press(bin_i)
		main.refresh()
	_check(not sim.stash.has(junk) and int(sim.scrap) == scrap0 + sim.scrap_of(junk), "Bin did not throw the hard hat out for its scrap")
	# a unique asks twice
	main._armoury._pick_cell(main._armoury._inv.cell_of(prize["id"]))
	main.refresh()
	bin_i = -1
	for k in range(main._armoury._pick._buttons.size()):
		if main._armoury._pick._buttons[k].visible and main._armoury._pick._buttons[k].text == "Scrap":
			bin_i = k
	if bin_i >= 0:
		main._armoury._press(bin_i)
		main.refresh()
		_check(sim.stash.has(prize) and main._armoury._pick._buttons[bin_i].text.begins_with("Scrap for"), "a unique went in the bin on the first press")
		_check_fit(main, "Lock-up (the bin, asked)")
		main._armoury._press(bin_i)
		main.refresh()
		_check(not sim.stash.has(prize), "a unique did not go in the bin on the second press")
	else:
		_check(false, "a unique has no Bin")
	_check(not sim.can_bin(sim._plain(Data.PAPER, "The deeds")), "the deeds can go in the bin")
	# Select-many with the Fence shut: Bin, the plain things only
	var a: Dictionary = sim._plain("Helmet", "Hard hat")
	sim.stash_put(a)
	main._armoury._inv.many = true
	main._armoury._inv.chosen = [a["id"]]
	main.refresh()
	_check(main._armoury._inv._sell_button.text.begins_with("Bin 1") and not main._armoury._inv._sell_button.disabled, "Select-many does not bin with the Fence shut: '%s'" % main._armoury._inv._sell_button.text)
	_check_fit(main, "Lock-up (select many, the bin)")
	main._armoury._inv._sell_chosen()
	_check(not sim.stash.has(a), "Select-many's bin left the hard hat")
	main._armoury._inv.many = false
	sim.unlocked = hold_unlocked
	sim.load_dict(saved)
	main.refresh()
	print("the bin ok: a pick's Bin for scrap, a unique asked twice, never the deeds, Select-many bins with the Fence shut")


## The fight kit's hands (17 Oct): a gun base with its own picture shows it (art/fight/hands/<base>.png), drawn as wide as
## the kind's were, its corner where theirs was; its flash on a drawn pixel of the gun, firing into open air; a base
## without one falls back to its kind's; the secondary's in hand behind a dry primary. Every base picture there is checked.
const WALLS_OPEN := []     # walls with no solid row on purpose (a railing, a fence), placed by their tip: none yet


func _kit_hands_checks(main) -> void:
	var sim = main.sim
	var v = main._run._view
	# the kit's plate and wall where they're there: drawn as the old 688 across, the wall's top at COVER_TOP, its slots
	# under their own key - the old pair's placing their start
	var was_key: String = v._site_key
	if RunView.kit_pair("the_parade"):
		v._site("the_parade")
		var pw: float = v._plate.size.x * v._plate.scale.x
		var cw: float = v._cover.size.x * v._cover.scale.x
		var top: float = v._cover_y + RunView.wall_top(v._cover.texture) * v._cover_s
		_check(v._kit_site and is_equal_approx(pw, RunView.PLATE_VIEW_W) and is_equal_approx(cw, RunView.COVER_VIEW_W) and absf(top - RunView.COVER_TOP) < 0.5 and v.slot_key() == "the_parade@kit",
			"the kit's Parade pair isn't drawn as the old: plate %.0f, wall %.0f, its top %.1f (want %.0f), slots under '%s'" % [pw, cw, top, RunView.COVER_TOP, v.slot_key()])
		var placed: Dictionary = RunView.saved_sites()
		if not placed.has("the_parade@kit"):
			_check(RunView.site_slot("the_parade@kit", 0)["foot"] == RunView.site_slot("the_parade", 0)["foot"], "the kit's Parade unplaced doesn't start where the old pair's were")
		v._site(was_key if was_key != "-" else "")
	# every site's wall with its body's top at COVER_TOP (17 Oct, Matt: only the tips showed): the row there at least
	# WALL_SOLID drawn, never above the picture's highest drawn row
	var tips: Array = []
	for t in Data.TIERS:
		var key: String = RunView.site_key(str(t["name"]))
		var ct: Texture2D = RunView.tex(key + "_cover")
		if ct == null:
			continue
		var wt: float = RunView.wall_top(ct)
		var img: Image = ct.get_image()
		var row := 0
		for x in range(img.get_width()):
			if img.get_pixel(x, int(wt)).a > 0.5:
				row += 1
		if row < RunView.WALL_SOLID * img.get_width() and not (key in WALLS_OPEN):     # no solid row: placed by its tip, the old fault
			tips.append("%s (%d, %d of %d drawn)" % [key, int(wt), row, img.get_width()])
		v._site(key)
		_check(absf(v._cover_y + wt * v._cover_s - RunView.COVER_TOP) < 0.5, "%s's wall body isn't at COVER_TOP: %.1f" % [key, v._cover_y + wt * v._cover_s])
	_check(tips.is_empty(), "walls whose top isn't their body: %s" % ", ".join(tips))
	v._site(was_key if was_key != "-" else "")
	var run = main._run
	for k in run.TILE_ICONS:
		var there: bool = run.icon_tex(run.TILE_ICONS[k]) != null
		_check(run._view == null or not there or run._six[k].has("icon"), "the six's tile %d has its art but no icon" % k)
	_check(RunView.art_slug("Farmer's shotgun") == "farmer_s_shotgun" and RunView.art_slug("Semi-auto .22") == "semi_auto_22" and RunView.art_slug("Courier's SMG") == "courier_s_smg", "the hands' names aren't the manifest's: %s" % RunView.art_slug("Semi-auto .22"))
	var seen := 0
	var bad: Array = []
	for slot in ["Primary", "Secondary"]:
		for b in Data.BASES[slot]:
			var gun: Dictionary = sim._plain(slot, str(b["name"]))
			var slug: String = RunView.art_slug(str(b["name"]))
			var own: Texture2D = RunView.tex("hands/" + slug)
			var ht: Texture2D = RunView.hands_tex(gun)
			if own == null:
				_check(ht == null or ht == RunView.tex_of(["hands_" + RunView._hands_kind(gun), "hands_revolver"]), "%s has no picture but doesn't fall back to its kind's" % b["name"])
				continue
			seen += 1
			_check(ht == own and is_equal_approx(own.get_size().x * RunView.hands_scale(own), RunView.HANDS_VIEW_W), "%s's hands aren't its own picture at the kind's width: %s" % [b["name"], str(own.get_size())])
			if Items.is_melee(gun):
				continue
			var kind: String = RunView._hands_kind(gun)
			var mz: Dictionary = RunView.muzzle_of(own, kind, slug)
			if mz.is_empty():
				continue
			var img: Image = own.get_image()
			if img.is_compressed():
				img = img.duplicate()
				img.decompress()
			var at: Vector2 = mz["at"]
			var drawn := false
			for dx in range(-2, 3):
				for dy in range(-2, 3):
					var q := Vector2i(int(at.x) + dx, int(at.y) + dy)
					if q.x >= 0 and q.y >= 0 and q.x < img.get_width() and q.y < img.get_height() and img.get_pixelv(q).a > 0.5:
						drawn = true
			var ahead: Vector2 = at + (mz["dir"] as Vector2).normalized() * 6.0
			var qa := Vector2i(int(ahead.x), int(ahead.y))
			var clear: bool = qa.x < 0 or qa.y < 0 or qa.x >= img.get_width() or qa.y >= img.get_height() or img.get_pixelv(qa).a < 0.5
			if not (drawn and clear):
				bad.append("%s at %s (drawn %s, clear %s)" % [b["name"], str(at), str(drawn), str(clear)])
	_check(bad.is_empty(), "the kit's hands whose flash isn't at the muzzle: %s" % ", ".join(bad))
	# the secondary in hand behind a dry primary; the primary while it has rounds or needs none
	var kp = sim.equipped["Primary"]
	var ks = sim.equipped["Secondary"]
	var keep_rig: Array = sim.rig.duplicate()
	sim.equipped["Primary"] = sim._plain("Primary", "Pump shotgun")
	sim.equipped["Secondary"] = sim._plain("Secondary", "Service pistol")
	sim.rig = []
	var dry = RunView.gun_in_hand(sim)
	sim.rig = [sim._plain(Data.AMMO, "Shells")]
	var fed = RunView.gun_in_hand(sim)
	sim.equipped["Primary"] = sim._plain("Primary", "Spiked bat")
	var bat = RunView.gun_in_hand(sim)
	_check(str(dry["base"]) == "Service pistol" and str(fed["base"]) == "Pump shotgun" and str(bat["base"]) == "Spiked bat", "the gun in hand: dry %s, fed %s, a bat %s" % [dry["base"], fed["base"], bat["base"]])
	sim.equipped["Primary"] = kp
	sim.equipped["Secondary"] = ks
	sim.rig = keep_rig
	print("the kit's hands: %d base pictures, every flash at its muzzle ok" % seen)


## The run view (13 Oct, Time Crisis; docs/design/fight_art.md): with its art there, the frame takes the two boxes; the
## six figures under it; the gang up as many as are on you; a kill drops one; a hit reddens the edges; the search pans
## to the crates; their bar over the frame in a fight, the search's under the six; it all fits.
## Your muzzle flash (15 Oct, item 9): every gun kind's at its picture's muzzle - a drawn pixel of the gun, in the
## frame - for its moment, then gone; none on a blade or a hammer.
func _flash_checks(main) -> void:
	var v = main._run._view
	for kind in RunView.MUZZLE:
		var ht: Texture2D = RunView.tex("hands_" + kind)
		if ht == null:
			continue
		v._kind = kind
		v._melee = false
		v._hands.texture = ht
		v._hands.size = ht.get_size()
		v._hands.visible = true
		v._hands_at = RunView.HANDS_CORNER - RunView.used_of(ht).end * RunView.HANDS_SCALE
		v._hands.position = v._hands_at
		v._hs = RunView.hands_scale(ht)
		v._mz = RunView.muzzle_of(ht, kind)
		v.fire_flash()
		var fs: Dictionary = v.flash_state()
		var mz: Vector2 = RunView.MUZZLE[kind]["at"]
		var img: Image = ht.get_image()
		var drawn := false
		for dx in range(-3, 4):
			for dy in range(-3, 4):
				var q := Vector2i(int(mz.x) + dx, int(mz.y) + dy)
				if q.x >= 0 and q.y >= 0 and q.x < img.get_width() and q.y < img.get_height() and img.get_pixelv(q).a > 0.5:
					drawn = true
		# and it fires into open air: a few pixels on along its direction, nothing drawn (16 Oct: the new hands moved every
		# muzzle and the old points sat on the arm, in open air behind the gun, and still passed)
		var ahead: Vector2 = mz + (RunView.MUZZLE[kind]["dir"] as Vector2).normalized() * 6.0
		var qa := Vector2i(int(ahead.x), int(ahead.y))
		var clear: bool = qa.x < 0 or qa.y < 0 or qa.x >= img.get_width() or qa.y >= img.get_height() or img.get_pixelv(qa).a < 0.5
		_check(fs["up"] and Rect2(0, 0, RunView.W, RunView.H).has_point(fs["at"]) and drawn and clear and fs["at"].is_equal_approx(v._hands.position + mz * RunView.HANDS_SCALE), "the %s's flash isn't at its muzzle in the frame: %s (drawn there: %s, open air ahead: %s)" % [kind, str(fs["at"]), str(drawn), str(clear)])
		v._flash_step(1.0)
		_check(v.flash_state()["up"], "the %s's flash went before its first frame was drawn" % kind)
		v._flash_step(1.0)
		_check(not v.flash_state()["up"], "the %s's flash stayed up past its moment" % kind)
	v._melee = true
	v.fire_flash()
	_check(not v.flash_state()["up"], "a blade or a hammer flashed")
	v._melee = false
	_kit_hands_checks(main)
	main.refresh()
	print("the muzzle flash ok: each gun at its muzzle, for its moment; none on a blade")


## A bar over each of them (15 Oct, items 11 and 6; hpbars_mockup.png A): a bar a figure up, in the frame, clear of
## the head line and the chips; the one you're hitting its HP (your hits held till their number's out), the rest full;
## none on one falling; a kill drops the one you were hitting; the bar drops by a number as it lands.
func _fig_bar_checks(main) -> void:
	var run = main._run
	var v = run._view
	var sim = main.sim
	var m: Dictionary = sim.mission
	for k in range(8):
		v._process(0.1)
	main.refresh()
	v._process(0.0)
	var bs: Array = v.bars()
	_check(bs.size() == v.figures_up() and bs.size() > 0 and bs.filter(func(b): return b["hit"]).size() == 1, "a bar a figure up, one hit: %d bars, %d up, %d hit" % [bs.size(), v.figures_up(), bs.filter(func(b): return b["hit"]).size()])
	var frame := Rect2(0, 0, RunView.W, RunView.H)
	var keep: Array = run._keep_out()
	for b in bs:
		var rr: Rect2 = b["rect"]
		var on_run := Rect2(v.position + rr.position * run.VIEW_SCALE, rr.size * run.VIEW_SCALE)
		_check(frame.encloses(rr) and keep.all(func(r): return not r.intersects(on_run)), "a figure's bar is out of the frame or on the head line or the chips: %s" % str(rr))
		var of: float = float(m["t"]["hp"])
		var want: float = clampf((float(m["target_hp"]) + run.held_hits()) / of, 0.0, 1.0) if b["hit"] else 1.0
		_check(absf(float(b["share"]) - want) < 0.02, "figure %d's bar reads %.2f, not %.2f" % [b["k"], float(b["share"]), want])
	var tag: Label = v.hp_words()
	_check(tag.visible and tag.text == "%d / %d" % [ceili(clampf(float(m["target_hp"]) + run.held_hits(), 0.0, float(m["t"]["hp"]))), int(round(float(m["t"]["hp"])))] and UI.text_width(tag, tag.text) <= tag.size.x, "the HP over the one you're hitting reads '%s'" % tag.text)
	# a number held, then out: the bar holds it, then drops by it
	run._hit_pending = {"physical": float(m["t"]["hp"]) * 0.25}
	m["target_hp"] = float(m["t"]["hp"]) * 0.6
	run._fig_bars()
	v._process(0.0)
	var held: float = v.bars().filter(func(b): return b["hit"])[0]["share"]
	run._release_hits(Vector2(100, 100))
	v._process(0.0)
	var out: float = v.bars().filter(func(b): return b["hit"])[0]["share"]
	_check(absf(held - 0.85) < 0.02 and absf(out - 0.6) < 0.02, "the bar doesn't hold a hit till its number, then drop by it: %.2f then %.2f" % [held, out])
	# a kill drops the one you were hitting, and its bar goes with it
	var hit_k: int = v._target_k
	m["kills"] = int(m["kills"]) + 1
	main.refresh()
	v._process(0.0)
	_check(v._figs[hit_k]["state"] == "down" and not v.bars().any(func(b): return b["k"] == hit_k), "a kill didn't drop the one you were hitting, or its bar stayed on it")
	print("the bars over them ok: one a figure, the one hit its HP and the rest full, held hits, a kill")


## The bigger frame (15 Oct, Matt: frame_mockup_B, "B it is"): on the run the rail folds to its glyphs and the run and
## the log take the width; the frame drawn at the column's width, its own 588 x 262 space scaled; the band slim over it;
## off the run the rail as it was.
func _frame_checks(main) -> void:
	var run = main._run
	var v = run._view
	main.layout(Vector2(1920, 1080))
	_check(is_equal_approx(run.VIEW_SCALE, float(run.VIEW_W) / RunView.W) and run.VIEW_H == int(round(RunView.H * run.VIEW_SCALE)) and v.scale.is_equal_approx(Vector2(run.VIEW_SCALE, run.VIEW_SCALE)), "the frame's scale: %.3f, %d high, drawn at %s" % [run.VIEW_SCALE, run.VIEW_H, str(v.scale)])
	var fr := Rect2(v.global_position, Vector2(RunView.W, RunView.H) * v.scale)
	var col := Rect2(run._left.global_position, run._left.size)
	_check(col.encloses(fr) and fr.size.x >= 800.0 and fr.position.y >= run._band.global_position.y + run._band.size.y and fr.end.y + 8.0 <= run._six[0]["panel"].global_position.y + 0.5, "the frame %s isn't in the column %s under the band, over the six" % [str(fr), str(col)])
	_check(main.rail_folded and is_equal_approx(main._rail_panel.size.x, Pal.RAIL_FOLDED_W) and main._rail_buttons.values().all(func(b): return b.size.x == Pal.RAIL_FOLDED_W and not b._name.visible and b.tooltip_text.begins_with(b.room)), "on a run the rail isn't folded to its glyphs, names on hover")
	var rail_end: float = main._rail.global_position.x + Pal.RAIL_FOLDED_W
	_check(is_equal_approx(run.global_position.x, rail_end + Pal.MARGIN) and run.global_position.x + run.size.x <= 1920.0 - Pal.MARGIN + 0.5 and is_equal_approx(run.size.x, Pal.RUN_W), "the run isn't beside the folded rail at its width: x %.0f, w %.0f" % [run.global_position.x, run.size.x])
	_check(is_equal_approx(main._events.global_position.x, run.global_position.x) and is_equal_approx(main._events.size.x, Pal.RUN_W), "the log isn't under the run at its width")
	# the slim band at its widest: the way out, a convoy and gangs, capstones - every line fits, nothing on anything
	var bd = run._band
	# the band kept simple (16 Oct, Matt): no depth or zone, one clock - the time left - and no "ticks while they're on you"
	var went_out: bool = not main.sim.on_mission()
	if went_out:
		main.sim.hp = main.sim.max_hp()
		main.sim.deploy(3)
		main.show_room(main.MISSIONS)
	if main.sim.on_mission() and not main.sim.mission.get("way_out", false):
		main.refresh()
		_check(bd.kicker.text == main.sim.sky_words(int(main.sim.mission["tier"])) and bd.unit.text == "left" and not bd.right[0].text.contains("clock") and not bd.right[1].text.contains("clock"), "the run's band says more than the site, the sky and the time left: '%s' / '%s' / '%s', '%s'" % [bd.kicker.text, bd.unit.text, bd.right[0].text, bd.right[1].text])     # the sky on the kicker (23 Oct, parked item 8)
		print("the run's band kept simple: '%s', '%s' %s, '%s'" % [bd.title.text, bd.headline.text, bd.unit.text, bd.right[0].text])
		# nothing on the take's row when all's well (18 Oct, Matt: "remove 'leaving keeps the loot'")
		var mm2: Dictionary = main.sim.mission
		if main.sim.hp / main.sim.max_hp() > 0.35 and not mm2.get("leave_full", false) and main.sim.pack_used(mm2) < main.sim.capacity() and not mm2.has("crates"):
			_check(run._note.text == "", "a plain run still says something under the take: '%s'" % run._note.text)
		# the runner panel (16 Oct, RunPanel mockup): the rig's cells full size (two rows at most) down to the take; the
		# take one strip over the run's line, the line over the button; "Their fire" and the icons on the six
		var rig_bottom := 0.0
		var smallest := 999.0
		for c in run._rig_cells:
			if c.visible:
				rig_bottom = maxf(rig_bottom, c.position.y + c.size.y)
				smallest = minf(smallest, c.size.y)
		for o in run._rig_outlines:
			if o.visible:
				rig_bottom = maxf(rig_bottom, o.position.y + o.size.y)
				smallest = minf(smallest, o.size.y)
		var strip: Panel = run._take_strip["panel"]
		_check(smallest >= 56.0 and rig_bottom <= run._take_head.position.y and run._take_head.position.y + run._take_head.size.y <= strip.position.y and is_equal_approx(run._note.position.y, run._take_head.position.y) and strip.position.y + strip.size.y <= run._button.position.y,
			"the runner panel's rows are off: rig cells %.0f px to %.0f, take head %.0f, strip %.0f-%.0f, note %.0f (on the head's row), button %.0f" % [smallest, rig_bottom, run._take_head.position.y, strip.position.y, strip.position.y + strip.size.y, run._note.position.y, run._button.position.y])
		_check(run._view == null or (run._six[1].has("icon") and run._six[4].has("icon")) or not ResourceLoader.exists("res://art/ui/dps.png"), "the six have no icons where Matt's art is")
	if went_out and main.sim.on_mission():
		main.sim.extract_now()
		main.refresh()
	bd.set_words("The way out", "Ransacked Streets", "12:59", ["to the way out · see them off", "see them off", "left"], Pal.ACCENT)
	bd.set_right(["", "convoy, 12 gangs", "◆◆ Poached, Dead quiet, Spread"])
	for short in ["◆◆ 3 capstones", "◆◆ 3", ""]:
		if UI.text_width(bd.right[2], bd.right[2].text) <= bd.right[2].size.x:
			break
		bd.set_right(["", "convoy, 12 gangs", short])
	var labels: Array = [bd.title, bd.headline, bd.unit, bd.kicker, bd.right[0], bd.right[1], bd.right[2]]
	for l in labels:
		_check(UI.text_width(l, l.text) <= l.size.x + 0.5 and l.position.x >= 0.0 and l.position.x + l.size.x <= bd.size.x + 0.5 and l.position.y + l.size.y <= bd.bar.position.y + 2.0, "the slim band's '%s' doesn't fit its row: %.0f in %.0f at %s" % [l.text, UI.text_width(l, l.text), l.size.x, str(l.position)])
	for i in range(labels.size()):
		for j in range(i + 1, labels.size()):
			var a: Label = labels[i]
			var b: Label = labels[j]
			if (a == bd.headline and b == bd.unit) or a.text == "" or b.text == "":
				continue
			var ra := Rect2(a.position, Vector2(UI.text_width(a, a.text), a.size.y))
			var rb := Rect2(b.position, Vector2(UI.text_width(b, b.text), b.size.y))
			_check(not ra.grow(-2.0).intersects(rb.grow(-2.0)), "the slim band's '%s' sits on '%s'" % [a.text, b.text])
	main.refresh()
	# off the run, the rail as it was
	main.show_room(main.RUNNER)
	main.refresh()
	_check(not main.rail_folded and is_equal_approx(main._rail_panel.size.x, Pal.RAIL_W) and main._rail_buttons.values().all(func(b): return b.size.x == Pal.RAIL_W and b._name.visible) and is_equal_approx(main._events.size.x, Pal.GRID_W), "off the run the rail didn't unfold")
	main.show_room(main.MISSIONS)
	main.refresh()


## The six under the frame (17 Oct, Matt: stat-tile mockup A with C's grouping): THEM and YOU, each tile's icon
## then its key over its figure inside the tile; the figure never the "—" fallback; the tones on what wants acting on.
func _six_checks(main, m: Dictionary) -> void:
	var run = main._run
	var g: Array = run._six_groups
	_check(g.size() == 2 and g[0].position.x >= run.VIEW_X - 0.5 and absf(g[0].position.x + g[0].size.x + run.SIX_GAP - g[1].position.x) < 0.5 and g[1].position.x + g[1].size.x <= run.VIEW_X + run.VIEW_W + 0.5,
		"the six's two groups aren't side by side across the frame's width")
	for k in range(6):
		var t: Dictionary = run._six[k]
		var want = g[0] if k in run.SIX_THEM else g[1]
		_check(t["panel"].get_parent() == want, "the six's tile %d ('%s') is in the wrong group" % [k, t["key"].text])
		var tw: float = t["panel"].size.x
		var left: float = 8.0
		if t.has("icon"):
			_check(is_equal_approx(t["icon"].size.x, run.TILE_ICON), "the six's tile %d icon is %.0f px, not %d" % [k, t["icon"].size.x, run.TILE_ICON])
			left = t["icon"].position.x + t["icon"].size.x
		for l in [t["key"], t["value"]]:
			_check(l.position.x >= left and l.position.x + l.size.x <= tw + 0.5 and UI.text_width(l, l.text) <= l.size.x + 0.5, "the six's '%s' doesn't sit beside its icon in its tile" % l.text)
		_check(t["value"].text != "—", "the six's %s fell back to a dash" % t["key"].text)
	# the tones: their fire red when it'd drop you inside SIX_FAST_S, quiet when it wouldn't
	var sim = main.sim
	m["last_incoming"] = sim.hp
	main.refresh()
	_check(run._six[0]["value"].get_theme_color("font_color") == Pal.BAD, "their fire at your HP a second isn't red")
	m["last_incoming"] = 0.01
	main.refresh()
	_check(run._six[0]["value"].get_theme_color("font_color") == Pal.TEXT, "their fire at a trickle is red")
	# endgame figures (the second review's 8): their fire, kills and rounds in the millions still fit, never cut
	var inc_was: float = float(m["last_incoming"])
	m["last_incoming"] = 1234567.0     # (not the kills: the view counts them to drop a figure)
	main.refresh()
	_check(str(run._six[0]["value"].text) in run.incoming_forms(1234567.0), "their fire at 1.2M reads '%s', none of its forms" % run._six[0]["value"].text)
	for t in run._six:
		var lv: Label = t["value"]
		_check(UI.text_width(lv, lv.text) <= lv.size.x + 0.5 and not lv.text.ends_with("…"), "the six's %s at endgame figures doesn't fit: '%s' (%.0f in %.0f px)" % [t["key"].text, lv.text, UI.text_width(lv, lv.text), lv.size.x])
	m["last_incoming"] = inc_was
	_check(run.incoming_forms(3.25)[0] == "3.2/s" or run.incoming_forms(3.25)[0] == "3.3/s", "a trickle of fire lost its tenth: %s" % str(run.incoming_forms(3.25)))
	# a gang due after the clock runs out says so, not a time that never comes (the first review's 2(b), 15)
	if not sim.has_rule("bomb_suit"):
		_check(run.gang_in_forms({"clock": 10.0}, 600.0) == Words.RUN_GANG_LATE and run.gang_in_forms({"clock": 1e6}, 60.0) == [Fmt.mss(60.0)], "the gang's time past the clock: %s, %s" % [str(run.gang_in_forms({"clock": 10.0}, 600.0)), str(run.gang_in_forms({"clock": 1e6}, 60.0))])
	# the On you chips stay short of the skills' buttons (the second review's 10): skills on, greed and a med in use
	var sk_ids: Dictionary = _skill_node_ids()
	var mine_sk: Array = sk_ids.keys().filter(func(sid): return str(sim.skill(str(sid)).get("cls", "")) == sim.cls)
	if not mine_sk.is_empty():
		var slots_was: Array = sim.skill_slots.duplicate()
		var tree_was: Array = sim.tree.duplicate()
		var cleared_was: bool = bool(m.get("cleared", false))
		var patrols_was: int = int(m.get("patrols", 0))
		var using_was = m["using"]
		var dots_was = m.get("my_dots", {})
		for sid in mine_sk.slice(0, 3):
			if not sim.tree.has(sk_ids[sid]):
				sim.tree.append(sk_ids[sid])
		sim.skill_slots = mine_sk.slice(0, 3).map(func(x): return str(x))
		while sim.skill_slots.size() < 3:
			sim.skill_slots.append("")
		sim._dry_memo.clear()
		m["cleared"] = true
		m["patrols"] = 9
		m["using"] = {"name": "Field surgery kit", "left": 12.0}
		m["my_dots"] = {"fire": 5.0}
		main.refresh()
		var cr: Rect2 = run._runner["chips"].used_rect()
		cr.position += run._runner["chips"].position
		var keeps: Array = run._skills.keep_rects() if run._skills != null else []
		_check(not keeps.is_empty(), "the skills' buttons didn't show for the On you check")
		_check(not keeps.any(func(r): return r.intersects(cr)), "the On you chips run under the skills' buttons: %s against %s" % [str(cr), str(keeps)])
		m["using"] = null
		m["my_dots"] = {}
		main.refresh()
		_check(run._runner["chips"]._panels.any(func(p): return p.visible and p.tooltip_text.begins_with("Greed")), "the greed chip has no hover words")
		# a chip with hover words takes the mouse: it mustn't sit over any button on the screen
		var tipped: Array = run._runner["chips"]._panels.filter(func(p): return p.visible and p.tooltip_text != "")
		var btns: Array = run.find_children("*", "BaseButton", true, false).filter(func(b): return b.is_visible_in_tree())
		for p in tipped:
			var over: Array = btns.filter(func(b): return b.get_global_rect().intersects(p.get_global_rect()))
			_check(over.is_empty(), "a hover chip sits over a button: %s" % str(over.map(func(b): return b.name)))
		sim.skill_slots = slots_was
		sim.tree = tree_was
		sim._dry_memo.clear()
		m["cleared"] = cleared_was
		m["patrols"] = patrols_was
		m["using"] = using_was
		m["my_dots"] = dots_was
		main.refresh()
	# your fire is the top bar's figure (19 Oct, Matt: 510 against 362), the pace beside it
	var top_fire: String = main._top_labels["dps"].text.get_slice(" ", 0)
	_check(run._six[1]["value"].text.begins_with(top_fire + "/s"), "your fire reads '%s', the top bar '%s'" % [run._six[1]["value"].text, main._top_labels["dps"].text])
	_check(absf(sim.pace() - 1.0) < 0.005 or run._six[1]["value"].text.contains("×") or run._six[1]["value"].text == top_fire + "/s", "your fire's pace is off: '%s'" % run._six[1]["value"].text)
	var rows: Array = run.six_rows(m, m["t"], 1.0)
	_check((rows[4][2] == Pal.BAD) == (rows[4][1][0] == "none"), "the meds' tone and its figure disagree: %s" % str(rows[4]))
	# a blade in hand: its rounds read melee, muted, not the dash
	var gun_was = sim.equipped["Primary"]
	sim.equipped["Primary"] = sim._plain("Primary", "Machete")
	main.refresh()
	_check(run._six[5]["value"].text == "melee" and run._six[5]["value"].get_theme_color("font_color") == Pal.TEXT_3, "a machete's rounds read '%s', not melee" % run._six[5]["value"].text)
	# the Weed Burner: a shotgun's base, and it spends rounds as one now (25 Oct, the review: no longer free)
	var wb: Dictionary = Items.roll_unique(sim._unique_named("The Council's Weed Burner"), sim.rng)
	if not wb.is_empty():
		sim.equipped["Primary"] = wb
		main.refresh()
		_check(run._six[5]["value"].get_theme_font("font").has_char(0x221E), "the tiles' font has no ∞ for the Weed Burner")
		_check(run._six[5]["value"].text != "∞" and run._six[5]["value"].text != "melee", "the Weed Burner's rounds read '%s', as if free" % run._six[5]["value"].text)
	sim.equipped["Primary"] = gun_was
	m["last_incoming"] = 0.0
	main.refresh()
	print("the six: THEM and YOU, %d px icons, the tones, a blade's melee" % run.TILE_ICON)


func _run_view_checks(main) -> void:
	var run = main._run
	if run._view == null:
		print("the run view: no art here (art/fight_test), the boxes as they were")
		return
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.hp = sim.max_hp()
	sim.deploy(0)
	var m: Dictionary = sim.mission
	m["event_at"] = -1.0
	m["remaining"] = 3
	main.show_room(main.MISSIONS)
	main.refresh()
	for k in range(4):
		run._view._process(0.2)
	var v = run._view
	_check(v.visible and not run._fight["box"].visible and not run._runner["box"].visible and run._six[0]["panel"].visible, "the run view did not take the two boxes")
	var want: int = mini(3, mini(int(m["remaining"]), maxi(1, sim.contact(m["t"]))))
	_check(v.figures_up() == want, "the frame shows %d up, not %d" % [v.figures_up(), want])
	_check(not v.state()["glass"], "the glass shows in a fight")
	_full_art_checks(main, v)
	_check(not run._fight["track"].visible and run._six[0]["key"].text == "Their fire", "the top bar shows in a fight (their HP is over each of them), or the six don't lead with Incoming")
	_six_checks(main, m)
	_fig_bar_checks(main)
	_flash_checks(main)
	_check_fit(main, "Run (the run view, a gang)")
	_frame_checks(main)
	_check(not run._fight_face["art"].visible and not run._runner_face["art"].visible, "the faces' pictures show over the run view (Matt, 13 Oct)")
	# a kill drops one - any of them, not the first every time (Matt, 13 Oct)
	m["kills"] = int(m["kills"]) + 1
	main.refresh()
	v._process(0.05)
	_check(v._figs.any(func(f): return f["state"] == "down"), "a kill dropped nobody")
	var fallen := {}
	for trial in range(24):
		for k in range(v._figs.size()):
			v._set_state(k, "up")
		v._kills_seen = int(m["kills"])
		m["kills"] = int(m["kills"]) + 1
		main.refresh()
		for k in range(v._figs.size()):
			if v._figs[k]["state"] == "down":
				fallen[k] = true
	_check(fallen.size() >= 2, "only one of them ever goes down: %s" % str(fallen.keys()))
	# under fire you duck behind the wall now and then
	v._duck_next = 0.0
	v._duck_t = 0.0
	for k in range(4):
		v._process(0.1)
	_check(float(v.state()["duck"]) > 0.3, "the runner never ducks: %s" % str(v.state()))
	# down behind the wall, the wall runs to the frame's foot (Matt, 13 Oct: "too short when crouching") - the wall
	# itself, one piece, nothing tiled under it (23 Oct, Matt: "you can see the same tiled wall 3 times")
	v._duck_t = 5.0
	for k in range(10):
		v._process(0.1)
	var cv: TextureRect = v._cover
	_check(v._duck > 0.95 and cv.position.y + cv.size.y * cv.scale.y >= RunView.H, "ducked, the wall stops short of the frame's foot: cover to %.0f" % (cv.position.y + cv.size.y * cv.scale.y))
	# and every site's wall reaches by itself, from art/fight_walls/
	for wkey in RunView.SITE_FAR.keys():
		var wct: Texture2D = RunView.tex(str(wkey) + "_cover")
		_check(wct != null and RunView.tex_from(str(wkey) + "_cover") == RunView.WALLS_DIR and RunView.cover_reaches(wct), "%s's wall isn't the tall one, or stops short ducked (from %s)" % [wkey, RunView.tex_from(str(wkey) + "_cover")])
	v._duck_t = 0.0
	# the far one stands further down the street than the middle one, smaller, wholly in the frame
	# every site's three: the far one above the wall, smaller than the middle one, in frame, clear of the other two
	var keys: Array = [""] + RunView.SITE_FAR.keys()
	# the tables' own (what F3/F5 has saved is Matt's call, checked only for being in the frame, below)
	var placed: Dictionary = RunView.saved_sites().duplicate(true)
	RunView.use_saved({})
	for key in placed:
		for k in range(3):
			var row: Array = placed[key][k]
			_check(float(row[0]) >= 0.0 and float(row[0]) <= RunView.W and float(row[1]) > 0.0 and float(row[1]) <= RunView.H + 40.0 and float(row[2]) > 0.05 and float(row[2]) < 2.0, "%s's placed %d is off the frame: %s" % [key, k, str(row)])
	for key in keys:
		var mid_in: Dictionary = RunView.site_slot(key, 0)
		var nr: Dictionary = RunView.site_slot(key, 1)
		var far: Dictionary = RunView.site_slot(key, 2)
		_check(far["foot"].y < mid_in["foot"].y - 25 and far["foot"].y < RunView.COVER_TOP - 20 and far["scale"] < mid_in["scale"] * 0.8 and far["foot"].x - 64 * far["scale"] >= 0 and far["foot"].y - 192 * far["scale"] >= 0, "%s: the far one isn't down the street: %s against %s" % [key, str(far), str(mid_in)])
		_check(absf(far["foot"].x - mid_in["foot"].x) > 40.0 and absf(far["foot"].x - nr["foot"].x) > 50.0 and absf(mid_in["foot"].x - nr["foot"].x) > 80.0, "%s: two of them stand in front of each other: %s %s %s" % [key, str(mid_in["foot"]), str(nr["foot"]), str(far["foot"])])
	RunView.use_saved(placed)
	var mid: Dictionary = RunView.SLOTS[0]
	# the middle one near the centre; the near one left of your gun - most of him clear of every gun's hands (Matt, 13 Oct)
	_check(absf(mid["foot"].x - RunView.W / 2.0) < 45.0, "the middle one isn't near the centre: %s" % str(mid))
	var near: Dictionary = RunView.SLOTS[1]
	var stand: Texture2D = RunView.tex_of(["gang_the_estate_a_stand", "gang_stand"])
	var su: Rect2 = RunView.used_of(stand)
	var nrect := Rect2(near["foot"] - Vector2(su.get_center().x - su.position.x, su.size.y) * near["scale"], su.size * near["scale"])
	nrect.end.y = minf(nrect.end.y, RunView.COVER_TOP)          # below the wall's top he's behind it anyway
	var hand_pics: Array = []
	for ty in ["pistol", "shotgun", "rifle", "smg", "improvised", "melee", "blade", "revolver"]:
		hand_pics.append([ty, RunView.tex("hands_" + ty)])
	for slot in ["Primary", "Secondary"]:
		for b in Data.BASES[slot]:
			hand_pics.append([str(b["name"]), RunView.tex("hands/" + RunView.art_slug(str(b["name"])))])     # the kit's (17 Oct)
	for pic in hand_pics:
		var ty: String = pic[0]
		var ht: Texture2D = pic[1]
		if ht == null:
			continue
		var hsc: float = RunView.hands_scale(ht)
		# what of him is drawn that the hands' drawn pixels cover, sampled every few pixels (a raised hammer's box is mostly air)
		var hu: Rect2 = RunView.used_of(ht)
		var h_at: Vector2 = RunView.HANDS_CORNER - hu.end * hsc
		var n_at: Vector2 = near["foot"] - Vector2(su.get_center().x, su.end.y) * near["scale"]
		var himg: Image = ht.get_image()
		var nimg: Image = stand.get_image()
		var drawn := 0
		var covered := 0
		var y := nrect.position.y
		while y < nrect.end.y:
			var x := nrect.position.x
			while x < nrect.end.x:
				var np: Vector2 = (Vector2(x, y) - n_at) / near["scale"]
				if np.x >= 0 and np.y >= 0 and np.x < nimg.get_width() and np.y < nimg.get_height() and nimg.get_pixelv(Vector2i(np)).a > 0.5:
					drawn += 1
					var hp: Vector2 = (Vector2(x, y) - h_at) / hsc
					if hp.x >= 0 and hp.y >= 0 and hp.x < himg.get_width() and hp.y < himg.get_height() and himg.get_pixelv(Vector2i(hp)).a > 0.5:
						covered += 1
				x += 3.0
			y += 3.0
		_check(drawn > 50, "the near one's sampling found nothing drawn (%d)" % drawn)
		var hidden: float = float(covered) / maxf(1.0, float(drawn))
		_check(hidden < 0.35, "the %s's hands hide %.0f%% of the near one" % [ty, hidden * 100.0])
	# the numbers keep off the bars, the head, the keys and the chips (Matt, 13 Oct: they sat on "On you"), with
	# something on both sides so both rows of chips show; the keep-out drawn here from the nodes, not run's own list
	# and again with your chips as wide as they get (a med in use too), which leaves the frame's foot no room (the review)
	m["dots"] = {"fire": 50.0, "poison": 50.0, "bleed": 50.0}
	m["my_dots"] = {"fire": 50.0, "poison": 50.0, "bleed": 50.0}
	for wide in [false, true]:
		if wide:
			m["using"] = {"name": "First aid kit", "left": 9.0, "heal": 1.0}
		else:
			m["using"] = null
		main.refresh()
		_check(run._fight["chips"].visible and run._runner["chips"].visible, "the chips did not show for the numbers' check")
		var keep: Array = []
		for c in [run._fight["track"], run._runner["track"]]:
			if c.visible:
				keep.append(c.get_global_rect())     # their top bar's gone in a fight (15 Oct, item 11)
		for d in [run._fight, run._runner]:
			for p in d["chips"]._panels:
				if p.visible:
					keep.append(p.get_global_rect())
		var jz: Vector2 = run.juice.global_position if run.juice != null else Vector2.ZERO
		var crossed: Array = []
		for k in range(60):
			for bar_y in [run.FIGHT_BAR_Y, run.RUNNER_BAR_Y]:
				var at: Vector2 = run._scatter(bar_y) + jz               # back to the screen's space
				var path := Rect2(at.x - 30, at.y - Juice.NUMBER_RISE, 60, 30 + Juice.NUMBER_RISE)
				if keep.any(func(r): return r.intersects(path)):
					crossed.append(at)
		_check(crossed.is_empty(), "%d of 120 numbers rise across a bar or a chip (%s): %s" % [crossed.size(), "wide chips" if wide else "three a side", str(crossed.slice(0, 4))])
	m["using"] = null
	m["dots"] = {}
	m["my_dots"] = {}
	# the elements in engine (13 Oct, Matt): fire on them flames and warms them, poison on you greens the frame's edges
	for k in range(v._figs.size()):
		v._set_state(k, "up")
	m["dots"] = {"fire": 50.0}
	m["my_dots"] = {"poison": 50.0}
	main.refresh()
	for k in range(6):
		v._process(0.1)
	var fx: Dictionary = v.fx()
	_check(fx["them"]["fire"] and not fx["them"]["poison"] and not fx["them"]["frost"] and fx["tint"].r > fx["tint"].b * 1.5, "fire on them did not show as fire: %s" % str(fx))
	_check(fx["you"]["poison"] > 0.3 and fx["you"]["fire"] < 0.05, "poison on you did not edge the frame green: %s" % str(fx["you"]))
	# chilled: blue, flakes, slower; shocked: an arc across them
	m["dots"] = {}
	m["my_dots"] = {}
	m["chill_t"] = 5.0
	main.refresh()
	for k in range(3):
		v._process(0.1)
	fx = v.fx()
	_check(fx["them"]["frost"] and not fx["them"]["fire"] and fx["tint"].b > fx["tint"].r * 1.5, "a chill on them did not show as frost: %s" % str(fx))
	m["chill_t"] = 0.0
	m["shock_t"] = 5.0
	main.refresh()
	var arcs := 0
	for k in range(12):
		v._process(0.05)
		arcs = maxi(arcs, int(v.fx()["arcs"]))
	_check(arcs > 0, "a shock on them never arced")
	# chilled, a pop takes twice as long (the review: the slowness itself checked)
	m["shock_t"] = 0.0
	m["chill_t"] = 5.0
	main.refresh()
	for k in range(v._figs.size()):
		v._set_state(k, "")
	v._set_state(0, "pop")
	# coming in is a fade where it stands, not a rise through the floor (Matt, 13 Oct): half way, half there, feet down
	v._process(RunView.POP_S * 0.5)
	var pr: TextureRect = v._figs[0]["rect"]
	var pu: Rect2 = RunView.used_of(pr.texture)
	var pfeet: float = pr.position.y + pu.end.y * v.slot_of(0)["scale"]
	_check(pr.modulate.a > 0.05 and pr.modulate.a < 0.95 and absf(pfeet - (v.slot_of(0)["foot"].y - RunView.DUCK_SCENE * v._duck)) < 1.5, "a figure coming in doesn't fade in where it stands: alpha %.2f, feet %.0f" % [pr.modulate.a, pfeet])
	v._set_state(0, "pop")
	v._process(RunView.POP_S * 1.2)                # full pace it'd be up by now
	_check(v._figs[0]["state"] == "pop", "a chilled figure popped up at full pace")
	v._process(RunView.POP_S * 1.0)
	_check(v._figs[0]["state"] == "up", "a chilled figure never finished popping up")
	m["chill_t"] = 0.0
	main.refresh()
	# a figure down takes its flames with it; nothing on anyone: nothing shown, the edges gone
	m["shock_t"] = 0.0
	m["dots"] = {"fire": 50.0}
	main.refresh()
	v._process(0.05)
	v._set_state(0, "down")
	v._process(0.05)
	_check(not v._figs[0]["fx"]["fire"].emitting, "a figure going down kept burning")
	m["dots"] = {}
	main.refresh()
	for k in range(10):
		v._process(0.1)
	fx = v.fx()
	_check(fx["them"].values().all(func(b): return not b) and fx["you"].values().all(func(a): return a < 0.01) and fx["arcs"] == 0, "the elements did not clear: %s" % str(fx))
	# and the fight over with fire still on the books: every emitter off
	m["dots"] = {"fire": 50.0, "poison": 50.0, "bleed": 50.0}
	m["chill_t"] = 5.0
	main.refresh()
	v._process(0.1)
	var rem0: int = int(m["remaining"])
	m["remaining"] = 0
	main.refresh()
	v._process(0.1)
	_check(v.fx()["them"].values().all(func(b): return not b), "the elements kept going on them after the fight: %s" % str(v.fx()))
	m["remaining"] = rem0
	m["dots"] = {}
	m["chill_t"] = 0.0
	main.refresh()
	# a hit reddens the edges
	sim.hp -= sim.max_hp() * 0.1
	main.refresh()
	_check(v.state()["red"] > 0.5, "a hit did not redden the frame")
	# the search: panned to the crates, the search bar under the six
	m["remaining"] = 0
	m["cleared"] = true
	m["patrol_timer"] = -1e9
	sim._roll_crates(m, m["t"])
	main.refresh()
	for k in range(10):
		v._process(0.2)
	_check(v.state()["pan_to"] > 0.0 and v.state()["crates"] > 0 and v.figures_up() == 0, "the search did not pan to the crates: %s" % str(v.state()))
	# panned, the cover still spans the frame; the crates stand on the ground, nearer is lower and bigger; the glass over
	# the one being opened, its ring the search so far (Matt, 13 Oct)
	_check(v._cover.position.x <= 0.0 and v._cover.position.x + v._cover.size.x >= RunView.W, "panned to the crates, the cover leaves a gap: %.0f to %.0f" % [v._cover.position.x, v._cover.position.x + v._cover.size.x])
	for k in range(RunView.CRATE_SPOTS.size() - 1):
		_check(RunView.CRATE_SPOTS[k]["foot"].y > RunView.CRATE_SPOTS[k + 1]["foot"].y and RunView.CRATE_SPOTS[k]["scale"] > RunView.CRATE_SPOTS[k + 1]["scale"], "the crates aren't in depth: %d against %d" % [k, k + 1])
	# the crates ride the pan: halfway in, they're half the pan short of their spots, the plate with them
	var pan_end: float = v._pan
	v._pan_to = RunView.PAN * 0.5
	v._pan = RunView.PAN * 0.5
	v._process(0.0)
	var c0m: Vector2 = v._crates[0].get_meta("at")
	_check(absf(v._crates[0].position.x - (c0m.x + RunView.PAN * 0.5)) < 0.5 and absf((v._crates[0].position.x - v._plate.position.x) - (c0m.x - (RunView.PLATE_AT.x - RunView.PAN))) < 2.0, "the crates don't ride the pan: crate %.1f, plate %.1f" % [v._crates[0].position.x, v._plate.position.x])
	v._pan = pan_end
	v._pan_to = RunView.PAN
	v._process(0.0)
	var c0: TextureRect = v._crates[0]
	var gc: Vector2 = v._glass.position + Vector2(RunView.Glass.R, RunView.Glass.R)
	_check(v.state()["glass"] and c0.visible and gc.x >= c0.position.x - 4 and gc.x <= c0.position.x + c0.size.x * c0.scale.x + 24 and gc.y < c0.position.y, "the glass isn't over the crate being opened: glass %s, crate %s" % [str(gc), str(c0.position)])
	m["search"] = sim.search_s(m["t"]) * 0.5
	main.refresh()
	_check(absf(float(v.state()["search_p"]) - 0.5) < 0.01, "the glass's ring isn't the search: %.2f" % float(v.state()["search_p"]))
	# the search's bar in the HP bar's place, the frame's width (14 Oct, Matt); a gang puts their HP bar and yours back
	_check(is_equal_approx(run._fight["track"].position.y, run.OVER_Y) and is_equal_approx(run._fight["track"].size.x, run.INNER) and not run._runner["track"].visible and run._six[0]["key"].text == "Gang in", "the search bar is not at the frame's foot in the HP bar's place")
	_search_layout(main, "the run view, the search")
	_check_fit(main, "Run (the run view, the search)")
	m["remaining"] = 2
	main.refresh()
	_check(run._runner["track"].visible and is_equal_approx(run._runner["track"].position.y, run.OVER_Y) and not run._fight["track"].visible, "a gang did not bring your HP bar back, or the search's stayed over it")
	_search_layout(main, "the run view, a gang in the search")
	_check_fit(main, "Run (the run view, a gang in the search)")
	m["remaining"] = 0
	main.refresh()
	_check(not run._runner["track"].visible and is_equal_approx(run._fight["track"].position.y, run.OVER_Y), "the gang gone, the search bar did not come back in the HP bar's place")
	# a full rig and a floor past a row: nothing on the buttons, the floor's pages clear of its cells
	var rig0: Array = sim.rig.duplicate()
	var floor0: Array = sim.floor_items().duplicate()
	if not sim.rig.is_empty() and Items.size(sim.rig[0]) == 1:
		while sim.rig_used() < mini(sim.med_capacity(), Data.RIG_CAP):
			var one: Dictionary = sim.rig[0].duplicate(true)
			one["id"] = Items._next_id
			Items._next_id += 1
			sim.rig.append(one)
	var proto: Dictionary = sim._plain("Helmet", "Army helmet")
	for k in range(14):
		var f: Dictionary = proto.duplicate(true)
		f["id"] = Items._next_id
		Items._next_id += 1
		m["floor"] = sim.floor_items() + [f]
	main.refresh()
	_check(run._crates._prev.visible, "fourteen things on the floor and no pages")
	_search_layout(main, "a full rig, the floor paged")
	_check_fit(main, "Run (a full rig, the floor paged)")
	sim.rig = rig0
	m["floor"] = floor0
	main.refresh()
	_placement_checks(main, v)
	sim.extract_now()
	sim.load_dict(saved)
	main.refresh()
	print("the run view ok: the frame, the gang up, a kill, a hit, the search, the bars and the six, the fit")


## The opening (14 Oct, docs/design/intro.md): six scenes, the game held while they play, every line fitting its row,
## a press bringing the next line then the next scene, Esc ending it; the art reported, not failed, till it's made.
func _opening_checks(main) -> void:
	var sim = main.sim
	main.play_opening()
	var op = main._opening
	_check(op != null and op.scene == 0, "the opening didn't start on its first scene")
	if op.is_inside_tree() and op._vlen > 0.0 and op.voice_on:
		_check(op._voice.playing, "the first scene's reading isn't playing (the review: it started before the tree)")
	var t0: float = sim.elapsed
	main._process(0.5)
	_check(is_equal_approx(sim.elapsed, t0), "the game ran under the opening")
	var arts := 0
	op._place(Vector2(1920, 1080))
	for i in range(op.scenes.size()):
		var sc: Dictionary = op.scenes[i]
		if ResourceLoader.exists(op.ART % sc["art"]) or FileAccess.file_exists(op.ART % sc["art"]):
			arts += 1
		op._go(i)
		var all: Array = op.lines_of(i)
		_check(all.size() <= op._lines.size(), "scene %d has more lines than rows" % i)
		for k in range(mini(all.size(), op._lines.size())):
			var l: Label = op._lines[k]
			_check(UI.text_width(l, l.text) <= l.size.x - 8.0, "an opening line runs past its row: '%s'" % l.text)
			_check(l.position.y + 48 < op._pips[0].position.y, "scene %d's lines run into the pips" % i)
	op._go(0)
	print("the opening: %d of %d scenes have their picture" % [arts, op.scenes.size()])
	# no white band the generator left shows at the picture's top or foot (14 Oct)
	for i in range(op.scenes.size()):
		op._go(i)
		var tx: Texture2D = op._pic.texture
		if tx == null:
			continue
		var img: Image = tx.get_image()
		for y in [0, img.get_height() - 1]:
			var whites := 0
			for x in range(0, img.get_width(), 8):
				var c: Color = img.get_pixel(x, y)
				if minf(c.r, minf(c.g, c.b)) > 0.94:
					whites += 1
			@warning_ignore("integer_division")
			_check(whites < (img.get_width() / 8) * 0.6, "scene %d's picture shows a white band at row %d" % [i, y])
	# the reading: each scene's cues one a line, in order, inside its take; the lines come up as they're said
	var voiced := 0
	for i in range(op.scenes.size()):
		var sc: Dictionary = op.scenes[i]
		_check(sc.has("cues") and sc["cues"].size() == op.lines_of(i).size(), "scene %d's cues aren't one a line" % i)
		for k in range(1, sc.get("cues", []).size()):
			_check(float(sc["cues"][k]) > float(sc["cues"][k - 1]), "scene %d's cues go backwards" % i)
		op._go(i)
		if op.voiced():
			voiced += 1
			_check(float(sc["cues"].back()) < op._vlen, "scene %d's last cue is past its reading (%.1f s)" % [i, op._vlen])
	print("the opening: %d of %d scenes have their reading" % [voiced, op.scenes.size()])
	op._go(0)
	if op.voiced():
		op._fading = 0.0
		var c0: float = float(op.scenes[0]["cues"][0])
		op._process(c0 - 0.5)
		_check(op.shown == 0, "a line came up before it's said: %d" % op.shown)
		op._process(0.6)
		_check(op.shown == 1, "the first line didn't come up as it's said: %d" % op.shown)
		op.advance()
		_check(op.shown == 2 and is_equal_approx(op._vt, float(op.scenes[0]["cues"][1])), "a press didn't take the reading to the next line: %d, %.2f" % [op.shown, op._vt])
		op._go(0)
	# presses: every line of the first scene, then on to the second
	op.size = Vector2(1920, 1080)
	op._fading = 0.0
	for k in range(op.lines_of(0).size()):
		op.advance()
	_check(op.shown == op.lines_of(0).size(), "a press didn't bring the next line: %d" % op.shown)
	op.advance()
	for k in range(20):
		op._process(0.1)
	_check(op.scene == 1, "a press with every line up didn't move to the next scene: %d" % op.scene)
	# left alone it plays itself through
	op._process(0.0)
	for k in range(1000):
		if not is_instance_valid(op) or op._finished:
			break
		op._process(0.25)
	_check(not is_instance_valid(op) or op._finished, "left alone the opening never ended")
	_check(main._opening == null, "the game's still held after the opening")
	main._process(0.2)
	_check(sim.elapsed > t0, "the game didn't run on after the opening")
	# Esc ends it at once
	main.play_opening()
	var esc := InputEventKey.new()
	esc.keycode = KEY_ESCAPE
	esc.pressed = true
	main._opening._input(esc)
	_check(main._opening == null, "Esc didn't end the opening")
	# the same Esc doesn't go on to open the pause (Matt, 14 Oct: the pause came up under the Map's card)
	main._unhandled_input(esc)
	_check(not main._menu.visible, "the Esc that skipped the opening opened the pause too")
	if main._menu.visible:
		main._menu.close()
	print("opening ok: six scenes, the lines fit, a press, left alone, Esc, the game held and let go")
	# On the air (14 Oct): the same player with Kev's scenes - a cue a line, in order, inside each take; the lines fit
	var air = main.Opening.new(Words.AIR_SCENES)
	main.add_child(air)
	air._place(Vector2(1920, 1080))
	var air_voiced := 0
	var air_art := 0
	for i in range(air.scenes.size()):
		var sc: Dictionary = air.scenes[i]
		air._go(i)
		if air._pic.texture != null:
			air_art += 1
		_check(sc.has("cues") and sc["cues"].size() == air.lines_of(i).size(), "On the air's scene %d has its cues off its lines" % i)
		for k in range(1, sc.get("cues", []).size()):
			_check(float(sc["cues"][k]) > float(sc["cues"][k - 1]), "On the air's scene %d's cues go backwards" % i)
		var all: Array = air.lines_of(i)
		for k in range(mini(all.size(), air._lines.size())):
			var l: Label = air._lines[k]
			_check(UI.text_width(l, l.text) <= l.size.x - 8.0, "an On the air line runs past its row: '%s'" % l.text)
		if air.voiced():
			air_voiced += 1
			_check(float(sc["cues"].back()) < air._vlen, "On the air's scene %d's last cue is past its take" % i)
	print("on the air: %d of %d scenes have their picture, %d their reading" % [air_art, air.scenes.size(), air_voiced])
	air.finish()


## The placement tool (13 Oct, Matt: Greenhorn's F3/F5): F3 holds the fight still with all three standing on their slots;
## a drag moves one's feet, its corner sizes it (feet kept); F5 saves the site's three, and the view reads them after.
func _placement_checks(main, v) -> void:
	if not v.can_place():
		print("the placement tool: not on a site with its own art here, not checked")
		return
	var sim = main.sim
	var p = v._placer
	var keep_path: String = p.save_path
	p.save_path = "user://smoke_fight_slots.tres"
	var saved0: Dictionary = RunView.saved_sites().duplicate(true)
	p.toggle()
	_check(v.placing and p.visible and v._figs.all(func(f): return f["state"] == "up"), "F3 didn't hold the fight with all three up")
	var run = main._run
	_check(not run._fight["track"].visible and not run._runner["track"].visible and not run._fight["head"].visible, "the bars and the head stayed over the frame while placing")
	var t0: float = sim.elapsed
	main._process(0.5)
	_check(is_equal_approx(sim.elapsed, t0), "the game ran on while placing")
	v._process(0.05)
	# a drag moves the middle one's feet by the drag
	var foot0: Vector2 = v.slot_of(0)["foot"]
	var r0: Rect2 = p.rect_of(0)
	var grab: Vector2 = r0.position + r0.size * Vector2(0.5, 0.3)
	p.press(grab)
	p.move(grab + Vector2(20, 6))
	p.release()
	_check(v.slot_of(0)["foot"] == foot0 + Vector2(20, 6), "a drag didn't move the middle one: %s from %s" % [str(v.slot_of(0)["foot"]), str(foot0)])
	# its corner sizes the near one, its feet kept
	var s1: Dictionary = v.slot_of(1).duplicate()
	var r1: Rect2 = p.rect_of(1)
	p.press(r1.end - Vector2(2, 2))
	p.move(r1.end - Vector2(2, 2) + Vector2(0, 30))
	p.release()
	_check(v.slot_of(1)["scale"] > s1["scale"] * 1.05 and v.slot_of(1)["foot"] == s1["foot"], "the corner didn't size the near one with its feet kept: %s" % str(v.slot_of(1)))
	v._process(0.05)
	var nr: TextureRect = v._figs[1]["rect"]
	_check(absf(nr.position.y + RunView.used_of(nr.texture).end.y * nr.scale.y - s1["foot"].y) < 1.5, "the near one isn't drawn where it's being put")
	# F5: the site's three saved, read from then on
	var want: Array = [v.slot_of(0).duplicate(), v.slot_of(1).duplicate(), v.slot_of(2).duplicate()]
	_check(p.save() == OK and FileAccess.file_exists(p.save_path), "F5 didn't save")
	var back = load(p.save_path)
	_check(back != null and back.sites.has(v.slot_key()) and is_equal_approx(float(back.sites[v.slot_key()][0][0]), want[0]["foot"].x), "the save doesn't hold the middle one: %s" % (str(back.sites) if back != null else "nothing"))
	p.toggle()
	_check(not v.placing and v.slot_of(0)["foot"] == want[0]["foot"] and is_equal_approx(v.slot_of(1)["scale"], snappedf(want[1]["scale"], 0.001)), "after F3 the view doesn't stand them where they were saved")
	main._process(0.1)
	_check(sim.elapsed > t0, "the game didn't run on after placing")
	# one bar at the frame's foot: your HP, or the search's in its place (14 Oct)
	_check(run._fight["track"].visible and run._fight["head"].visible and run._runner["track"].visible != is_equal_approx(run._fight["track"].position.y, run.OVER_Y), "the bars didn't come back after placing")
	# leaving the run screen while placing lets the tool go, and the game runs on (the review: a room click froze it)
	p.toggle()
	var room0: String = main.room
	main.show_room(main.ARMOURY)
	v._process(0.05)
	var t1: float = sim.elapsed
	main._process(0.2)
	_check(not v.placing and not p.visible and sim.elapsed > t1, "leaving the run screen kept the tool on and the game held")
	main.show_room(room0)
	# put it back: the real file untouched, the view on it again
	DirAccess.remove_absolute(ProjectSettings.globalize_path(p.save_path))
	p.save_path = keep_path
	RunView.use_saved(saved0)
	main.refresh()
	print("placement ok: F3 holds the fight, a drag moves, the corner sizes, F5 saves and the view reads it")


## The full art wired (13 Oct): each site its own plate and cover (else the Parade's test pair), the cover's drawn top on
## its line, the zone's gang, the head when he's out, the hands for the gun, feet on the slot.
func _full_art_checks(main, v) -> void:
	var sim = main.sim
	var own := 0
	for i in range(Data.TIERS.size()):
		var key: String = RunView.site_key(str(Data.TIERS[i]["name"]))
		_check(RunView.tex_of([key + "_plate", "parade_plate"]) != null and RunView.tex_of([key + "_cover", "parade_cover"]) != null, "%s has no plate or cover, its own or the test's" % key)
		if RunView.tex(key + "_plate") != null and RunView.tex(key + "_cover") != null:
			own += 1
	print("the run view: %d of %d sites have their own plate and cover" % [own, Data.TIERS.size()])
	# out on the site the check's on: its plate, its cover's top on the line
	var m: Dictionary = sim.mission
	var key0: String = RunView.site_key(str(Data.TIERS[int(m["tier"])]["name"]))
	_check(v._plate.texture == RunView.tex_of([key0 + "_plate", "parade_plate"]) and v._cover.texture == RunView.tex_of([key0 + "_cover", "parade_cover"]), "%s's plate or cover isn't up" % key0)
	_check(absf(v._cover_y + RunView.wall_top(v._cover.texture) * v._cover_s - RunView.COVER_TOP) < 0.5, "the cover's body isn't on its line: %.0f" % (v._cover_y + RunView.wall_top(v._cover.texture) * v._cover_s))
	# the zone's gang, when it's drawn
	var zone: String = RunView.ZONE_KEYS[int(Data.TIERS[int(m["tier"])]["zone"])]
	if RunView.tex("gang_%s_a_stand" % zone) != null:
		var ups: Array = v._figs.filter(func(f): return f["state"] in ["pop", "up"])
		_check(not ups.is_empty() and ups.all(func(f): return f["rect"].texture in [RunView.tex("gang_%s_a_stand" % zone), RunView.tex("gang_%s_b_stand" % zone), RunView.tex("gang_%s_a_fire" % zone), RunView.tex("gang_%s_b_fire" % zone)]), "the gang up isn't %s's" % zone)
	# feet on the slot: a figure that's up, not lifted or ducked, stands its drawn bottom on its foot
	v._duck = 0.0
	v._duck_t = 0.0
	v._duck_next = 99.0
	for k in range(v._figs.size()):
		v._set_state(k, "up")
	v._process(0.01)
	for k in range(v._figs.size()):
		var r: TextureRect = v._figs[k]["rect"]
		var u: Rect2 = RunView.used_of(r.texture)
		var sc: float = v.slot_of(k)["scale"]
		var feet: float = r.position.y + u.end.y * sc
		_check(absf(feet - (v.slot_of(k)["foot"].y - RunView.DUCK_SCENE * v._duck)) < 1.5, "figure %d's feet at %.0f, its slot's at %.0f" % [k, feet, v.slot_of(k)["foot"].y])
	# the head when he's out, if he's drawn
	for b in Data.BOSSES:
		var hk: String = RunView.site_key(str(b["name"]))
		if RunView.tex("head_%s_stand" % hk) == null:
			continue
		v._figs[0]["boss"] = hk
		_check(v._fig_tex(v._figs[0], "stand") == RunView.tex("head_%s_stand" % hk), "%s isn't drawn as himself" % b["name"])
	v._figs[0]["boss"] = ""
	v._boss_key = ""
	# the head coming out on the last kill: the one who falls falls as himself, the head pops up as the head; and when
	# the head's killed, he falls as the head (the review: the live key drew them as each other)
	var gk: String = str(Data.BOSSES[0]["name"])
	var hk0: String = RunView.site_key(gk)
	var had_boss: bool = m.has("boss")
	var boss0 = m.get("boss", null)
	for k in range(v._figs.size()):
		v._set_state(k, "")
	v._set_state(0, "up")
	m["boss"] = {"name": gk, "started": true, "alive": true, "hp": 1000.0}
	m["kills"] = int(m["kills"]) + 1
	main.refresh()
	var fell = v._figs.filter(func(f): return f["state"] == "down")
	_check(fell.size() == 1 and fell[0]["rect"].texture != RunView.tex("head_%s_down" % hk0), "the last of the gang fell as the head")
	for n in range(4):
		v._process(0.2)
	var ups2: Array = v._figs.filter(func(f): return f["state"] in ["pop", "up"])
	_check(ups2.size() == 1 and str(ups2[0].get("boss", "")) == hk0, "the head didn't come up as himself: %s" % str(ups2.map(func(f): return f.get("boss", ""))))
	if RunView.tex("head_%s_stand" % hk0) != null and not ups2.is_empty():
		_check(ups2[0]["rect"].texture in [RunView.tex("head_%s_stand" % hk0), RunView.tex("head_%s_fire" % hk0)], "the head is drawn as someone else")
	m["boss"]["alive"] = false
	m["kills"] = int(m["kills"]) + 1
	main.refresh()
	var fell2 = v._figs.filter(func(f): return f["state"] == "down" and str(f.get("boss", "")) == hk0)
	_check(fell2.size() == 1, "the head didn't fall")
	if RunView.tex("head_%s_down" % hk0) != null and fell2.size() == 1:
		_check(fell2[0]["rect"].texture == RunView.tex("head_%s_down" % hk0), "the head fell as one of the gang")
	if had_boss:
		m["boss"] = boss0
	else:
		m.erase("boss")
	main.refresh()
	# the hands for the gun: a shotgun's, and a hammer's or none
	var hold = sim.equipped["Primary"]
	for pair in [["Primary", "Farmer's shotgun", "shotgun"], ["Primary", "Claw hammer", "melee"]]:
		var g: Dictionary = sim._plain(pair[0], pair[1])
		if g.is_empty():
			continue
		sim.equipped["Primary"] = g
		main.refresh()
		var want: Texture2D = RunView.hands_tex(RunView.gun_in_hand(sim))     # its own picture, else its kind's (the kit, 17 Oct); the secondary's behind it dry
		if want != null:
			_check(v._hands.visible and v._hands.texture == want, "the %s's hands aren't up" % pair[1])
		elif pair[2] == "melee":
			_check(not v._hands.visible, "a revolver's hands show for the hammer")
	# every gun's hands in the corner: the drawn bottom-right on HANDS_CORNER (the review: a first gun on the fallback kept the old place)
	for gname in ["Army SMG", "Nail gun", "Sawn-off"]:
		var g2: Dictionary = sim._plain("Primary", gname)
		sim.equipped["Primary"] = g2
		main.refresh()
		v._recoil = 0.0
		v._duck = 0.0
		v._jolt = 0.0
		v._process(0.0)
		if v._hands.visible:
			var br: Vector2 = v._hands.position + RunView.used_of(v._hands.texture).end * v._hs
			_check(br.distance_to(RunView.HANDS_CORNER) < 1.5, "the %s's hands aren't in the corner: %s" % [gname, str(br)])
	# a melee swing (14 Oct, Matt: "the action just hangs"): the hammer's arm apart from the off hand, no hit as it winds
	# up, one on the chop with a streak behind it, the arm back where it was after; a gun keeps its kick
	var hammer: Dictionary = sim._plain("Primary", "Claw hammer")
	if not hammer.is_empty() and RunView.tex("hands_melee") != null:
		sim.equipped["Primary"] = hammer
		main.refresh()
		_check(v._melee and v._hand_r.visible and v._hand_l.visible and v._hands.self_modulate.a < 0.01, "the hammer's arm isn't apart from the off hand")
		# where it's drawn, not just its position: in the corner, and the weapon's tip in frame (Matt, 14 Oct: off the right)
		v._recoil = 0.0
		v._jolt = 0.0
		v._duck = 0.0
		v._swing = -1.0
		v._process(0.0)
		var drawn_br: Vector2 = v._hands.get_transform() * RunView.used_of(v._hands.texture).end
		_check(drawn_br.distance_to(RunView.HANDS_CORNER) < 1.5, "the hammer's hands aren't drawn in the corner: %s" % str(drawn_br))
		var tip0: Vector2 = v.tip_point()
		_check(tip0.x <= RunView.W - 12.0 and tip0.y >= 0.0, "the hammer's head is out of frame at rest: %s" % str(tip0))
		var shots := [0]
		var count := func(_at): shots[0] += 1
		v.shot_fired.connect(count)
		v._duck = 0.0
		v._duck_t = 0.0
		v._duck_next = 99.0
		v._firing = true
		v._figs[0]["state"] = "up"
		v._swing = -1.0
		v._shot_t = 0.0
		v._process(0.01)
		_check(v._swing >= 0.0 and shots[0] == 0, "the swing hit as it began, or never began")
		var sl: float = v._swing_len
		v._process(sl * RunView.SWING_UP - 0.01)
		_check(v._hand_r.rotation > 0.1 and shots[0] == 0, "no wind-up before the chop: %.2f" % v._hand_r.rotation)
		_check(v.tip_point().x <= RunView.W - 12.0 and v.tip_point().y >= 0.0, "the hammer's head leaves the frame winding up: %s" % str(v.tip_point()))
		v._process(sl * (RunView.SWING_CONTACT - RunView.SWING_UP))
		_check(shots[0] == 1 and v._hand_r.rotation < -0.2, "the chop didn't land once, forward: %d hits, %.2f" % [shots[0], v._hand_r.rotation])
		_check(v.tip_point().x <= RunView.W - 12.0 and v.tip_point().x >= 0.0, "the hammer's head is out of frame on the chop: %s" % str(v.tip_point()))
		_check(not v._trail.is_empty(), "no streak behind the chop")
		v._shot_t = 99.0
		v._process(sl)
		_check(v._swing < 0.0 and is_zero_approx(v._hand_r.rotation) and v._swing_off == Vector2.ZERO and shots[0] == 1, "the arm didn't settle back after the swing")
		# down behind the wall mid-swing: no hit on the chop
		v._shot_t = 0.0
		v._process(0.01)
		v._duck = 1.0
		v._duck_t = 5.0
		v._process(sl)
		_check(shots[0] == 1, "a swing landed with the hands down behind the wall")
		v._duck = 0.0
		v._duck_t = 0.0
		v.shot_fired.disconnect(count)
		var gun3: Dictionary = sim._plain("Primary", "Farmer's shotgun")
		if not gun3.is_empty():
			var sec_was = sim.equipped["Secondary"]
			sim.equipped["Secondary"] = null     # a dry gun shows the secondary's hands (gun_in_hand): none, so the gun's (17 Oct, the flake)
			sim.equipped["Primary"] = gun3
			main.refresh()
			_check(not v._melee and not v._hand_r.visible and v._hands.self_modulate.a > 0.99 and is_zero_approx(v._hands.rotation), "a gun kept the hammer's swing parts")
			sim.equipped["Secondary"] = sec_was
	sim.equipped["Primary"] = hold
	main.refresh()


## The Yard as lanes (9 Oct, docs/design/yard.md): eight buildings, five columns of two picks and a rank; a tile
## picks, the strip builds; the other side stays on show and refits for half; the columns open on the campaign
## and the depth and stay open; the rank at depth 9; the rail's Upgrade badge; every pick's figure where it lives;
## salvage from the deep sites; the buildings move with the Yard; an old save's levels become picks.
func _yard_wide_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	main.show_room(main.OVERVIEW)
	main.refresh()
	var yt = main._yard_tree
	_check(yt.visible and not main._grid.visible, "the Pitch is not the lanes alone")
	# every pick its own glyph, and no column's two the same (Lanes-G, the review)
	for bld in Data.YARD:
		for col in bld["picks"]:
			_check(NodeGlyphs.PICK_GLYPH.has(col[0]["id"]) and NodeGlyphs.PICK_GLYPH.has(col[1]["id"]), "a Yard pick has no glyph of its own: %s / %s" % [col[0]["id"], col[1]["id"]])
			_check(NodeGlyphs.of_pick(col[0], bld["key"]) != NodeGlyphs.of_pick(col[1], bld["key"]), "%s's %s and %s share a glyph" % [bld["name"], col[0]["name"], col[1]["name"]])
			for pk in col:
				_check(NodeGlyphs.SVG.has(NodeGlyphs.of_pick(pk, bld["key"])), "%s's glyph is not drawn: %s" % [pk["name"], NodeGlyphs.of_pick(pk, bld["key"])])
	_check(yt.STRIP_Y + yt.STRIP_H <= yt.size.y and yt._build.position.y + yt._build.size.y <= yt.STRIP_H, "the Pitch's strip runs past the room or its button out of it")
	# the heading takes the room the lanes left (Matt, 10 Oct): the strip ends at the room's foot, the heading its band
	_check(is_equal_approx(yt.STRIP_Y + yt.STRIP_H, yt.size.y) and yt.HEAD_H >= 200 and yt.LANES_Y == yt.HEAD_H + 8, "the Pitch leaves room unused or its heading short: strip to %d of %d, heading %d" % [yt.STRIP_Y + yt.STRIP_H, int(yt.size.y), yt.HEAD_H])
	var names: Array = Data.YARD_WEB.map(func(t): return t["name"])
	_check(names == Data.YARD.map(func(b): return b["name"]) and yt.web().layout.size() == Data.YARD.size() * 15, "the Pitch's regions are off: %s, %d nodes" % [str(names), yt.web().layout.size()])
	# a fresh Yard: column 1 open, the rest shut with their gates; nothing affordable with no cash
	sim.yard_picks = {}
	sim.yard_ranks = {}
	sim.yard_open = 1
	sim.yard_seen = {}
	sim.yard_seen_cols = 1
	sim._yard_changed("")
	var cash0: float = sim.cash
	sim.cash = 0.0
	yt.selected = {}
	yt._shown = ""
	main.refresh()
	_check(sim.yard_cols() >= 1 and yt.tile("bench", 0, "a")["look"] == "open" and (sim.yard_cols() > 1 or yt.tile("bench", 1, "a")["look"] == "shut"), "the fresh Yard's columns are off: %d open, %s / %s" % [sim.yard_cols(), yt.tile("bench", 0, "a")["look"], yt.tile("bench", 1, "a")["look"]])
	_check(main._rail_status(main.OVERVIEW).get("badge", "") == "", "the rail's Upgrade badge is lit with no cash")
	_check(sim.yard_pick_block("bench", 0, "a") == "Short of tins", "a pick with no cash: '%s'" % sim.yard_pick_block("bench", 0, "a"))
	_check(sim.yard_pick_block("bench", 5 - 1, "a") == Data.yard_gate(4) or sim.yard_cols() >= 5, "a shut column's block is not its gate: '%s'" % sim.yard_pick_block("bench", 4, "a"))
	# pick, build, the other side dim, a refit for half; the badge is news only (9 Oct): lit for what's newly
	# buyable or a column opened since the Yard was looked at, cleared by looking
	main.show_room(main.MISSIONS)
	sim.cash = 1000000.0
	main.refresh()
	_check(main._rail_status(main.OVERVIEW).get("badge", "") == "Can build", "the rail's Upgrade badge is not lit with a pick newly affordable")
	main.show_room(main.OVERVIEW)
	_check(main._rail_status(main.OVERVIEW).get("badge", "") == "" and not main._rail_buttons[main.OVERVIEW]._badge.visible, "looking at the Pitch did not clear the badge (as drawn: %s)" % str(main._rail_buttons[main.OVERVIEW]._badge.visible))
	var seen_n: int = sim.yard_seen.size()
	var rt: Dictionary = sim.to_dict()
	sim.yard_seen = {}
	sim.load_dict(rt)
	_check(sim.yard_seen.size() == seen_n and seen_n > 0 and sim.yard_seen_cols == sim.yard_cols(), "what the badge has seen did not survive a save: %d of %d" % [sim.yard_seen.size(), seen_n])
	main.show_room(main.MISSIONS)
	sim.cash = 0.0
	main.refresh()
	sim.cash = 1000000.0
	main.refresh()
	_check(main._rail_status(main.OVERVIEW).get("badge", "") == "", "the badge lit again for picks already seen")
	sim.hp = sim.max_hp()
	sim.deploy(3)
	_check(sim.on_mission() and not sim._yard_buyable_ids().is_empty(), "with the runner out, the Pitch reads nothing buyable for the badge")
	if sim.on_mission():
		sim._extract()
	sim.yard_open = sim.yard_cols() + 1
	_check(main._rail_status(main.OVERVIEW).get("badge", "") == "Can build", "a column opened did not light the badge")
	sim.yard_open = 1
	sim.yard_seen_cols = 1
	main.show_room(main.OVERVIEW)
	yt._press("kennel", 0, "a")
	main.refresh()
	_check(yt._title.visible and yt._title.text.begins_with("A dog") and yt._build.text.begins_with("Build (") and yt._build.text.contains(Fmt.money(sim.yard_pick_cost("kennel", 0))) and not yt._build.disabled, "the strip does not offer A dog with its price: '%s' / '%s'" % [yt._title.text, yt._build.text])
	_check_fit(main, "Yard (a pick picked)")
	var c1: int = sim.yard_pick_cost("kennel", 0)
	var cash1: float = sim.cash
	yt._on_build()
	main.refresh()
	_check(sim.yard_has("a_dog") and is_equal_approx(sim.cash, cash1 - c1) and yt.tile("kennel", 0, "a")["look"] == "built" and yt.tile("kennel", 0, "b")["look"] == "other", "Build did not build A dog: %s, £%.0f" % [str(sim.yard_picks.get("kennel", [])), cash1 - sim.cash])
	_check(yt._build.text == "Built" and yt._build.disabled, "a built pick still offers a build")
	# its other side (24 Oct, Matt: option B - nothing locks): open at 2.5 times, both built after, the strip saying so
	yt._press("kennel", 0, "b")
	main.refresh()
	var c2: int = sim.yard_pick_cost("kennel", 0)
	_check(yt._build.text.begins_with("Build (") and yt._build.text.contains(Fmt.money(c2)) and absi(c2 - int(round(c1 * Data.YARD_SECOND))) <= 100 and yt._other.text.contains("is built · this one costs ×2.5"), "the other side isn't offered at 2.5 times: '%s', '%s', %d from %d" % [yt._build.text, yt._other.text, c2, c1])
	_check_fit(main, "Yard (a column's other side)")
	sim.cash = maxf(sim.cash, float(c2) + 10.0)
	var cash2: float = sim.cash
	yt._on_build()
	main.refresh()
	_check(sim.yard_has("good_nose") and sim.yard_has("a_dog") and sim.yard_side("kennel", 0) == "ab" and is_equal_approx(sim.cash, cash2 - c2) and yt.tile("kennel", 0, "b")["look"] == "built" and yt.tile("kennel", 0, "a")["look"] == "built", "the other side didn't build beside the first: %s" % str(sim.yard_picks.get("kennel", [])))
	_check(sim.yard_pick_block("kennel", 0, "a") == "Built" and sim.yard_pick_block("kennel", 0, "b") == "Built" and yt._build.text == "Built" and yt._build.disabled, "a column with both sides built still offers a build")
	_check(not sim._yard_buyable_ids().any(func(x): return str(x).begins_with("kennel/0")), "a full column still counts as buyable")
	_check_fit(main, "Yard (both sides built)")
	# the columns open on the campaign and the depth, and stay open
	sim.best_dig = {}
	for i in range(sim.depth.size()):
		sim.depth[i] = 1
		sim.best_depth[i] = 0
	sim.yard_open = 0
	_finish_campaign(sim)
	_check(sim.yard_cols() == 4, "the campaign done opens %d columns, not four" % sim.yard_cols())
	sim.best_dig = {"site": "The Streets", "depth": 9, "yard": 1}
	_check(sim.yard_cols() == Data.YARD_COLS, "depth 9 does not open every column")
	sim.best_dig = {}
	for i in range(sim.depth.size()):
		sim.depth[i] = 1
		sim.best_depth[i] = 0
	_check(sim.yard_cols() == Data.YARD_COLS, "the columns closed again when the depth went")
	# the fifth column and the rank want salvage
	sim.salvage = {"copper": 0, "steel": 0, "army": 0}
	_check(sim.yard_pick_block("stash", 4, "a").begins_with("Wants 10 copper"), "column five without salvage: '%s'" % sim.yard_pick_block("stash", 4, "a"))
	sim.salvage["copper"] = 40
	var r0: int = sim.yard_rank_cost("stash")
	_check(sim.yard_pick("stash", 4, "b") and sim.salvage["copper"] == 30 and sim.buy_yard_rank("stash") and sim.yard_rank("stash") == 1 and sim.salvage["copper"] == 25, "the salvage did not pay: %s" % str(sim.salvage))
	_check(sim.yard_rank_cost("stash") > r0 and sim.yard_rank_salvage("stash") == Data.YARD_RANK_SALVAGE + 1, "the rank's price did not climb")
	var rk_keep: int = sim.yard_rank("stash")
	sim.yard_ranks["stash"] = Data.YARD_RANK_SALVAGE_TO
	_check(sim.yard_rank_salvage("stash") == 0 and sim.yard_rank_cost("stash") > r0, "a rank past the fifth still wants salvage (24 Oct: tins alone): %d" % sim.yard_rank_salvage("stash"))
	yt._press_rank("stash")
	yt._shown = ""
	main.refresh()
	_check(not yt._other.text.contains("salvage") and not yt._other.text.contains(" copper") and yt._other.text.contains(Fmt.money(sim.yard_rank_cost("stash"))), "the rank strip past the fifth still asks salvage: '%s'" % yt._other.text)
	sim.yard_ranks["stash"] = rk_keep
	yt._press_rank("stash")
	yt._shown = ""
	main.refresh()
	_check(yt._build.text == "Buy (%s)" % Fmt.money(sim.yard_rank_cost("stash")) and yt._title.text.contains("rank 1"), "the rank's strip is off: '%s' / '%s'" % [yt._title.text, yt._build.text])
	_check_fit(main, "Yard (a rank)")
	# every buy button on the Pitch says what it costs (24 Oct, Matt: "the buy button doesn't list the cost"): each
	# building's rank and its first column's unbuilt side, in tins
	for yb in Data.YARD:
		yt._press_rank(str(yb["key"]))
		yt._shown = ""
		main.refresh()
		_check((yt._build.text.contains(Fmt.money(sim.yard_rank_cost(str(yb["key"])))) or yt._build.text.contains(Fmt.money_k(sim.yard_rank_cost(str(yb["key"]))))), "%s's rank button has no price: '%s'" % [yb["key"], yt._build.text])
		_check(UI.text_width(yt._build, yt._build.text) + 32.0 <= yt._build.size.x, "%s's rank button runs past its edge: '%s'" % [yb["key"], yt._build.text])
		for yside in ["a", "b"]:
			if not sim.yard_built_side(str(yb["key"]), 0, yside):     # an unbuilt side (both can be built, option B)
				yt._press(str(yb["key"]), 0, yside)
				yt._shown = ""
				main.refresh()
				_check((yt._build.text.contains(Fmt.money(sim.yard_pick_cost(str(yb["key"]), 0))) or yt._build.text.contains(Fmt.money_k(sim.yard_pick_cost(str(yb["key"]), 0)))), "%s's build button has no price: '%s'" % [yb["key"], yt._build.text])
				_check(UI.text_width(yt._build, yt._build.text) + 32.0 <= yt._build.size.x, "%s's build button runs past its edge: '%s'" % [yb["key"], yt._build.text])
				break
	yt.selected = {}
	sim.cash = cash0
	yt._shown = ""
	main.refresh()
	_check(yt._headline.text == "%d of 80" % sim.yard_built() and yt._unit.text == "upgrades built", "the Pitch's headline is off: '%s' %s" % [yt._headline.text, yt._unit.text])
	_check(yt._chips.shown() == 6 and yt._chips._labels[0].text.begins_with(Fmt.money(sim.cash)), "the Pitch's purse chips are off: %d shown, first '%s'" % [yt._chips.shown(), yt._chips._labels[0].text])
	# the purse down the left under the title (Matt, 10 Oct): below the headline, inside the title's width and the band,
	# clear of Move; every chip shown with the most salvage the Yard can hold
	var yc := Rect2(yt._chips.position, yt._chips.size)
	_check(yc.position.y >= yt._headline.position.y + yt._headline.size.y and yc.end.x <= yt.PAD + 350 and yc.end.y <= yt.HEAD_H - 8, "the Pitch's purse is not down the left under the title: %s" % str(yc))
	var salv_was: Dictionary = sim.salvage.duplicate()
	var cash_was: float = sim.cash
	var notes_was: int = sim.notes
	var scrap_was: int = sim.scrap
	for kind in Data.SALVAGE:
		sim.salvage[kind] = 99999
	sim.cash = 99999999.0
	sim.notes = 999999
	sim.scrap = 999999
	yt._shown = ""
	main.refresh()
	yc = Rect2(yt._chips.position, yt._chips.size)
	_check(yt._chips.shown() == 6 and yc.end.y <= yt.HEAD_H - 8 and yc.end.x <= yt.PAD + 350, "the Pitch's purse loses a chip or leaves the band at the most: %d shown, %s" % [yt._chips.shown(), str(yc)])
	sim.salvage = salv_was
	sim.cash = cash_was
	sim.notes = notes_was
	sim.scrap = scrap_was
	yt._shown = ""
	main.refresh()
	_check_fit(main, "Yard (lanes)")
	sim.load_dict(saved)
	main.refresh()
	_yard_pick_checks(main)


## Every pick's figure where it lives (9 Oct): each set straight in, read, set back.
func _yard_pick_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.yard_picks = {}
	sim.yard_ranks = {}
	sim._yard_changed("")
	var on := func(key: String, col: int, side: String) -> void:
		_yard_set(sim, key, col, side)
	# the Bench
	var it: Dictionary = sim._plain("Helmet", "Hard hat")
	it["affixes"] = [{"stat": "hp", "value": 5, "tier": 1}]
	it["rarity"] = 1
	var reroll0: int = sim.craft_cost(it, "affixes")
	on.call("bench", 0, "b")
	_check(sim.craft_cost(it, "affixes") == int(round(sim._inf(int(Data.CRAFT["affixes"]["cash"]) * Items.ilvl(it) * 2) * 0.75)) or sim.craft_cost(it, "affixes") < reroll0, "Cheap parts did not take a quarter off: %d from %d" % [sim.craft_cost(it, "affixes"), reroll0])
	on.call("bench", 1, "b")
	_check(sim.lock_max() == Data.LOCKS + 1, "Two locks didn't give a second padlock: %d" % sim.lock_max())     # 20 Oct
	on.call("bench", 1, "a")
	on.call("bench", 3, "a")
	_check(sim.socket_max() == Data.SOCKET_MAX + 1 and sim.bump_levels() == Data.BUMP_LEVELS * 2, "Third socket or Overbump is off")
	sim.yard_ranks["bench"] = 2
	_check(sim.bump_cap() == Data.BUMP_CAP + 2, "the Bench's rank does not raise the cap")
	sim.yard_ranks = {}
	var scrap0: int = sim.scrap_of(it)
	on.call("bench", 2, "b")
	_check(sim.scrap_of(it) == scrap0 * 2, "Strip for parts did not double the scrap")
	var rng := RandomNumberGenerator.new()
	rng.seed = 7
	var t3: Dictionary = sim._plain("Helmet", "Hard hat")
	t3["rarity"] = 4
	var down := false
	for k in range(300):
		t3["affixes"] = [{"stat": "hp", "value": 20, "tier": 3}]
		Items.reroll_one(t3, "hp", rng, 1.0, true)
		down = down or int(t3["affixes"][0]["tier"]) < 3
	_check(not down, "Fine tuning let a re-roll go down a tier")
	var aff: Dictionary = Items.affix_def("hp")
	var rr: Array = Items.tier_range(aff, 2)
	var low := false
	for k in range(200):
		low = low or Items.roll_affix(aff, 1, rng, 2, 0, true)["value"] < int(ceil((rr[0] + rr[1]) / 2.0))
	_check(not low, "Masterwork rolled in the bottom half")
	var two: Dictionary = sim._plain("Armour", Data.BASES["Armour"][0]["name"])
	two["rarity"] = 3
	two["affixes"] = [{"stat": "hp", "value": 5, "tier": 1}, {"stat": "armour_pct", "value": 30, "tier": 3}, {"stat": "rest_pct", "value": 5, "tier": 1}]
	Items.reroll_affixes(two, rng, ["hp", "armour_pct"], false)     # two padlocks (20 Oct: Two locks is the second)
	_check(two["affixes"].size() == 3 and two["affixes"].any(func(a): return a["stat"] == "armour_pct" and int(a["value"]) == 30) and two["affixes"].any(func(a): return a["stat"] == "hp" and int(a["value"]) == 5), "two padlocks didn't keep both: %s" % str(two["affixes"]))
	# the Stash
	var cap0: int = sim.stash_cap()
	on.call("stash", 0, "a")
	on.call("stash", 1, "a")
	on.call("stash", 3, "a")
	on.call("stash", 4, "b")
	sim.yard_ranks["stash"] = 1
	_check(sim.stash_cap() == cap0 + 40 + 50 + 60 + 100 + 20, "the Stash's cells are off: %d from %d" % [sim.stash_cap(), cap0])
	sim.yard_ranks = {}
	var yt = main._yard_tree
	yt.selected = {}
	on.call("stash", 0, "b")
	on.call("stash", 2, "b")
	on.call("stash", 3, "b")
	_check(sim.stash_free(sim._plain(Data.AMMO, "Nails")) and sim.stash_free(Items.roll_unique(Data.UNIQUES[0], sim.rng)) and not sim.stash_free(sim._plain(Data.PAPER, "A P45")) and not sim.stash_free(it) and sim.yard_has("filing_cabinet"), "Racks or Wall of fame is off, or the Filing cabinet still frees a paper")
	on.call("stash", 1, "b")
	var junk: Dictionary = sim._plain("Helmet", "Army helmet")     # worth a pound of scrap or more (a hard hat's £20 is under 24, 12 Oct)
	junk["rarity"] = 0
	junk["affixes"] = []
	var sc0: int = sim.scrap
	var binned: Array = sim._bin_commons([junk, sim._plain(Data.AMMO, "Nails")])
	_check(binned.size() == 1 and not binned.has(junk) and sim.scrap > sc0, "Bins did not scrap the commons: %d kept" % binned.size())
	var ins0: int = sim.insure_cost(3)
	on.call("stash", 2, "a")
	_check(sim.insure_cost(3) <= int(ceil(ins0 / 2.0 / 10.0)) * 10 + 10, "Strongroom did not halve insurance: %d from %d" % [sim.insure_cost(3), ins0])
	# the Clinic
	var rest0: float = sim.rest_rate()
	on.call("clinic", 0, "a")
	on.call("clinic", 1, "a")
	_check(is_equal_approx(sim.rest_rate(), rest0 * (Data.REST_BASE + 1.5) / Data.REST_BASE), "Beds and Ward are off: %.2f from %.2f" % [sim.rest_rate(), rest0])
	on.call("clinic", 0, "b")
	on.call("clinic", 1, "b")
	_check(sim.clinic_stock() == Data.CLINIC_STOCK + 10, "Shelf and Stockroom are off: %d" % sim.clinic_stock())
	sim.wounds = {"legs": {"stat": "pace", "what": "a bad ankle", "from": "The Parade", "hp_pct": 20}}
	var wc0: int = sim.wound_cost()
	var wm0: float = sim.wound_mult("pace")
	on.call("clinic", 2, "a")
	_check(sim.wound_cost() <= int(ceil(wc0 / 2.0)) + 1, "Surgery did not halve the wound's price")
	on.call("clinic", 2, "b")
	_check(sim.wound_mult("pace") > wm0, "Physio did not lighten the wound")
	sim.wounds = {}
	on.call("clinic", 3, "b")
	var bandages := func() -> int: return sim.rig.filter(func(x): return str(x.get("base", "")) == "Bandage").size()
	var room_k: bool = sim.rig_room(1)
	var bn0: int = bandages.call()
	sim.hp = sim.max_hp()
	sim.deploy(3)
	_check(not room_k or bandages.call() == bn0 + 1, "the Field kit did not put a bandage in the rig")
	sim.extract_now()
	var hp0: float = sim.max_hp()
	on.call("clinic", 4, "a")
	sim.yard_ranks["clinic"] = 2
	_check(is_equal_approx(sim.max_hp(), hp0 * 1.16), "Theatre and the Clinic's rank are off: %.1f from %.1f" % [sim.max_hp(), hp0])
	sim.yard_ranks = {}
	# the Fence
	var stock0: int = sim.market_stock()
	var words0: Array = sim.words.duplicate(true)
	var shelf0: Array = sim.market.duplicate(true)
	on.call("fence", 0, "a")
	_check(sim.words == words0 and sim.market.slice(0, shelf0.size()) == shelf0 and sim.market.size() == shelf0.size() + 2, "a Fence pick re-rolled the words or the shelf: %d from %d" % [sim.market.size(), shelf0.size()])
	on.call("fence", 1, "a")
	_check(sim.market_stock() == stock0 + 5 and sim.market.size() >= sim.market_stock(), "Stall and Shopfront are off: %d, %d on the shelf" % [sim.market_stock(), sim.market.size()])
	var sp0: int = sim.sell_price(it)
	on.call("fence", 0, "b")
	on.call("fence", 4, "b")
	sim.yard_ranks["fence"] = 1
	_check(sim.sell_price(it) > sp0 and absi(sim.sell_price(it) - int(round(sp0 * 1.37))) <= 2, "Haggling, Dealer's cut and the rank are off: %d from %d" % [sim.sell_price(it), sp0])
	sim.yard_ranks = {}
	on.call("fence", 1, "b")
	_check(sim.contracts_open() == Data.CONTRACTS_OPEN + 2 and sim.contracts.size() >= sim.contracts_open(), "Orders did not open two more contracts: %d up" % sim.contracts.size())
	# a build never refills a shelf bought from; a refit off Orders takes its two back
	sim.market = sim.market.slice(0, 1)
	on.call("fence", 2, "b")
	_check(sim.market.size() == 1, "a build refilled the Fence's shelf: %d on it" % sim.market.size())
	on.call("fence", 1, "a")
	_check(sim.contracts.size() == Data.CONTRACTS_OPEN, "the refit off Orders left %d contracts" % sim.contracts.size())
	on.call("fence", 2, "a")
	_check(sim.market.any(func(x): return x.has("unique")), "the Back room has no unique on the shelf")
	var g0: int = sim.gamble_price(Data.GAMBLE_KINDS[0]["kind"])
	on.call("fence", 3, "a")
	_check(g0 <= 0 or absi(sim.gamble_price(Data.GAMBLE_KINDS[0]["kind"]) - int(round(g0 * 0.5))) <= 1, "the Gambler's table did not halve the gamble")
	# the Radio (9 Oct, map juicing): the sky's two columns, then the words'
	var hold_elapsed: float = sim.elapsed
	var hold_weather: Array = sim.weather.duplicate()
	sim.elapsed = 3600.0 * 3.0                       # noon
	sim.weather[1] = "Rain"
	var rain0: Dictionary = sim.effective(3)
	on.call("radio", 0, "a")
	var rain1: Dictionary = sim.effective(3)
	_check(is_equal_approx(rain1["search"], rain0["search"] / 1.3 * 1.15), "the Weather set did not halve the rain: %.3f from %.3f" % [rain1["search"], rain0["search"]])
	on.call("radio", 1, "a")
	_check(is_equal_approx(sim.effective(3)["cash"], rain1["cash"] * 1.2), "the forecast did not pay a fifth more under the rain")
	sim.weather[1] = ""
	sim.elapsed = 3600.0 * 14.0                      # 23:00
	var night0: Dictionary = sim.effective(3)
	on.call("radio", 0, "b")
	_check(sim.is_night() and is_equal_approx(sim.effective(3)["pace"], night0["pace"] / 0.8 * 0.9), "the Night set did not halve night's feet: %.3f from %.3f" % [sim.effective(3)["pace"], night0["pace"]])
	var patrol_n: float = sim.effective(3)["patrol"]
	on.call("radio", 1, "b")
	_check(is_equal_approx(sim.effective(3)["patrol"], patrol_n * 1.25), "Dead air did not slow the night's gangs")
	sim.elapsed = hold_elapsed
	sim.weather = hold_weather
	_finish_campaign(sim)
	sim.atlas = {}
	sim.best_depth[3] = maxi(sim.best_depth[3], 9)
	sim.set_depth(3, 9)
	sim.words[3] = []
	sim.sealed[3] = false
	sim.notes = 100000
	var rc0: int = sim.word_craft_cost(3, "retune")
	on.call("radio", 2, "a")
	_check(sim.word_craft_cost(3, "retune") == maxi(1, int(ceil(18.0 * 0.75))) and rc0 == 18, "the Scanner did not take a quarter off: %d from %d" % [sim.word_craft_cost(3, "retune"), rc0])
	on.call("radio", 2, "b")
	_check(sim.word_craft(3, "tune") and sim.words[3].size() == 1, "Tune in with Two channels did not add one word: %s" % str(sim.words[3]))
	var mw0: int = sim.max_words(3)
	on.call("radio", 3, "a")
	_check(sim.yard_has("lorry_watch") and float(Data.FX["yard/lorry_watch"]) == 2.0, "Lorry watch isn't on, or isn't twice Kev's papers")     # 15 Oct
	on.call("radio", 3, "b")
	_check(sim.max_words(3) == mw0 + 1 and mw0 == 4, "Long range did not add a word: %d from %d" % [sim.max_words(3), mw0])
	sim.words[3] = []
	_check(sim.word_craft(3, "broadcast") and sim.words[3].size() == 5, "a broadcast with Long range did not fill five: %s" % str(sim.words[3]))
	on.call("radio", 4, "a")
	var jw: Dictionary = sim.word_effect("Numbers", 1)
	_check(is_equal_approx(float(jw["hp"]), sqrt(1.4)) and is_equal_approx(float(jw["drop"]), 1.3), "the Jammer's word is off: %s" % str(jw))
	on.call("radio", 4, "b")
	var mw: Dictionary = sim.word_effect("Numbers", 1)
	_check(is_equal_approx(float(mw["drop"]), 1.45) and is_equal_approx(float(mw["hp"]), 1.4), "the Military band's word is off: %s" % str(mw))
	sim.yard_ranks["radio"] = 2
	_check(is_equal_approx(float(sim.word_effect("Numbers", 1)["drop"]), 1.0 + 0.3 * 1.6), "the Radio's rank did not add to the pay")
	sim.yard_ranks = {}
	sim.words[3] = []
	# the Generator (24 Oct, milestone 8: energy where the time away was): each pick's figure, and the rank's
	_check(sim.generator_max_energy() == 0.0 and sim.generator_energy_regen() == 0.0 and sim.generator_kill_energy() == 0.0 and sim.generator_cooldown_pct() == 0.0 and not sim.generator_first_free(), "the Generator gives energy unbuilt")
	on.call("generator", 0, "a")
	_check(is_equal_approx(sim.generator_max_energy(), 10.0), "the Jerry can is not +10 max energy: %.1f" % sim.generator_max_energy())
	on.call("generator", 1, "a")
	_check(is_equal_approx(sim.generator_energy_regen(), 0.5), "the Dynamo is not +0.5 energy a second: %.2f" % sim.generator_energy_regen())
	on.call("generator", 2, "b")
	_check(is_equal_approx(sim.generator_kill_energy(), 5.0), "Kickback is not 5 energy a kill: %.1f" % sim.generator_kill_energy())
	on.call("generator", 3, "a")
	_check(is_equal_approx(sim.generator_cooldown_pct(), 5.0), "the Flywheel is not 5%% shorter cooldowns: %.1f" % sim.generator_cooldown_pct())
	on.call("generator", 4, "a")
	_check(sim.generator_first_free(), "the Pilot light does not make the first skill free")
	sim.yard_ranks["generator"] = 3
	_check(is_equal_approx(sim.generator_max_energy(), 16.0), "the Generator's rank is not +2 max energy a rank: %.1f" % sim.generator_max_energy())
	sim.yard_ranks = {}
	# no pick or rank on the Pitch reads time away (24 Oct, Matt: the offline nodes go)
	for yb in Data.YARD:
		var yb_lines: Array = [str(yb.get("rank", {}).get("words", "")), str(yb.get("rank", {}).get("short", ""))]
		for col in yb["picks"]:
			for pk in col:
				yb_lines.append_array([str(pk["words"]), str(pk["short"])])
		_check(not yb_lines.any(func(w): return w.to_lower().contains("away")), "%s still reads time away: %s" % [yb["key"], str(yb_lines.filter(func(w): return w.to_lower().contains("away")))])
	var fire0: float = sim.more("fire")
	on.call("generator", 3, "b")
	_check(is_equal_approx(sim.more("fire"), fire0 * 1.1), "Arc lamps did not add a tenth to fire")
	on.call("generator", 4, "b")
	sim.hp = sim.max_hp() * 0.4
	sim.deploy(3)
	_check(is_equal_approx(sim.hp, sim.max_hp()), "the Charger did not send the run out full")
	sim.extract_now()
	# the Lookout
	var first0: float = sim.patrol_s(sim.effective(3), true)
	on.call("lookout", 0, "a")
	on.call("lookout", 1, "a")
	_check(is_equal_approx(sim.patrol_s(sim.effective(3), true), first0 * 2.0), "Spotter and Lookout post are off: %.1f from %.1f" % [sim.patrol_s(sim.effective(3), true), first0])
	on.call("lookout", 0, "b")
	_check(sim.odds_runs() == 60, "Glasses did not read sixty runs")
	var later0: float = sim.patrol_s(sim.effective(3))
	on.call("lookout", 2, "b")
	on.call("lookout", 3, "b")
	on.call("lookout", 4, "a")
	_check(is_equal_approx(sim.patrol_s(sim.effective(3)), later0 * 1.1 * (Data.FX["yard/watch_rota"] if sim.is_night() else 1.0) * 1.2), "Tripwires, Watch rota (nights only, 18 Oct) and the Crow's nest are off")
	on.call("lookout", 4, "b")
	var pool0: int = int(sim.effective(3)["pool"])
	sim.deploy(3)
	_check(int(sim.mission["remaining"]) <= maxi(1, pool0 - 1), "Flares did not take a head off the first gang")
	sim.extract_now()
	# the Kennel
	var q0: float = sim.rarity_bonus()
	on.call("kennel", 0, "b")
	on.call("kennel", 1, "b")
	on.call("kennel", 4, "b")
	_check(is_equal_approx(sim.rarity_bonus(), q0 + 0.35), "the Kennel's quality is off: %.2f from %.2f" % [sim.rarity_bonus(), q0])
	var poison0: float = sim.more("poison")
	on.call("kennel", 3, "b")
	_check(is_equal_approx(sim.more("poison"), poison0 * 1.1), "the Ratter did not add a tenth to poison")
	# salvage: a deep kill on a zone's site drops its kind, home with the run; the buildings move with the Yard
	sim.load_dict(saved)
	_finish_campaign(sim)
	sim.best_depth[3] = 7
	sim.set_depth(3, 8)
	sim.hp = sim.max_hp()
	sim.deploy(3)
	var mm: Dictionary = sim.mission
	_check(int(mm["t"]["depth"]) == 8, "the salvage run is not at depth 8: %d" % int(mm["t"]["depth"]))
	sim.rng.seed = 11
	for k in range(400):
		sim._kill(mm, mm["t"])
	var got: int = int(mm.get("salvage", {}).get("copper", 0))
	_check(got > 0 and mm.get("salvage", {}).size() == 1, "a deep Estate site gave no copper, or the wrong kind: %s" % str(mm.get("salvage", {})))
	var cu0: int = int(sim.salvage["copper"])
	sim.extract_now()
	_check(int(sim.salvage["copper"]) == cu0 + got, "the run's salvage did not come home: %d from %d" % [int(sim.salvage["copper"]), cu0])
	sim.cash = 1000000.0
	sim.notes = 400
	_yard_set(sim, "kennel", 0, "a")
	_yard_set(sim, "stash", 4, "a")
	sim.yard_ranks["kennel"] = 3
	sim.yard_mark_seen()
	# an old save's levels become the matching picks, free
	var old: Dictionary = sim.to_dict()
	old.erase("yard_picks")
	old.erase("yard_ranks")
	old["stash_level"] = 3
	old["comms_level"] = 2
	old["kennel_level"] = 3
	sim.load_dict(old)
	_check(sim.yard_has("shelving") and sim.yard_has("another_unit") and sim.yard_has("lock_up") and sim.yard_has("weather_set") and sim.yard_has("forecast") and not sim.yard_has("scanner") and sim.yard_has("fetch"), "an old save's levels did not become picks: %s" % str(sim.yard_picks))
	sim.load_dict(saved)
	main.refresh()
	print("the Pitch's lanes ok: the screen, a build and its other side, the gates kept, salvage, ranks, every building's picks, the move, the old saves")


## The sum strip's tiles sit inside their panel (7 Oct: the strip was sized by the node tile's height, four
## pixels short, and the tiles' feet were cut off).
func _sum_strip_check(main) -> void:
	var bk = main._barracks
	var inside := Rect2(Vector2.ZERO, bk._sum.size)
	# every chip the trees call for is on the row, and none the trees convert to or increase was dropped to fit -
	# read off the screen before anything re-lays it
	var shown_tags: Array = []
	for k in range(bk._sum_chips.shown()):
		shown_tags.append(bk._sum_chips._tags[k].text)
	var want: Array = bk.sum_items([])
	_check(shown_tags.size() == want.size(), "the sum strip shows %d of its %d chips" % [shown_tags.size(), want.size()])
	_check(not shown_tags.has("Joints") or shown_tags.back() == "Joints", "the Joints chip is not last: %s" % str(shown_tags))
	for el in Data.ELEMENTS:
		if bk.sim.tree_sum("conv_%s_pct" % el) > 0.0 or bk.sim.tree_sum("%s_pct" % el) > 0.0:
			_check(shown_tags.has(el.capitalize()), "the %s the trees give is not on the sum strip: %s" % [el, str(shown_tags)])
	for k in range(bk._sum_chips.shown()):
		var pnl = bk._sum_chips._panels[k]
		var r := Rect2(bk._sum_chips.position + pnl.position, pnl.size)
		_check(inside.encloses(r), "a sum chip runs out of its strip: %s in %s" % [str(r), str(inside)])
	# a node's panel: the figure as a chip beside the title, the sentence under them (Matt, 10 Oct), apart
	if bk.selected != "" and bk._chips.visible:
		var said: String = (bk._words.text + " " + bk._words2.text).strip_edges()
		_check(bk._words.position.y >= bk._chips.position.y + Chips.CHIP_H and bk._words.text != "" and said.ends_with("."), "the node's chip and sentence are off: words at y %.0f, chips to %.0f, '%s'" % [bk._words.position.y, bk._chips.position.y + Chips.CHIP_H, said])
	_check(bk._panel.position.y >= bk.HEAD_H, "the node panel sits on the band")


## The rarities' colours (Rarity-A, 7 Oct): seven tones a cell can wear, every one its own, none the pick ring's;
## a unique pink, a legendary gold, a rare blue, on the cell and on the head's chip.
func _rarity_tone_checks(sim) -> void:
	var tones := ["good", "rare", "epic", "legendary", "unique", "set"]
	var seen := []
	for t in tones:
		var c: Color = Pal.tone_color(t)
		_check(c != Pal.PICK and c != Pal.TEXT_2, "the %s tone is the pick ring's or the plain text's" % t)
		_check(not seen.has(c), "the %s tone is another rarity's colour" % t)
		seen.append(c)
	var rare: Dictionary = sim._plain("Helmet", "Hard hat")
	rare["rarity"] = 2
	var leg: Dictionary = sim._plain("Helmet", "Hard hat")
	leg["rarity"] = 4
	var uniq: Dictionary = sim._plain("Helmet", "Hard hat")
	uniq["rarity"] = 4
	uniq["unique"] = "Test"
	_check(Pal.item_tone(rare) == "rare" and Pal.item_tone(leg) == "legendary" and Pal.item_tone(uniq) == "unique", "an item's tone is off: %s / %s / %s" % [Pal.item_tone(rare), Pal.item_tone(leg), Pal.item_tone(uniq)])
	var Cell = load("res://scripts/ui/item_cell.gd")
	var cell = Cell.new()
	cell.show_item(uniq, false)
	_check((cell.get_theme_stylebox("normal") as StyleBoxFlat).border_color == Pal.UNIQUE, "a unique's cell is not pink")
	cell.show_item(leg, true)
	_check((cell.get_theme_stylebox("normal") as StyleBoxFlat).border_color == Pal.PICK, "a picked cell's ring is not the pick ring")
	cell.queue_free()


## The shell's odds, settled: frames of main._read_odds until every open tier has read (the Runs and Radio
## screens show "reading the odds" until then).
func _settle_odds(main) -> void:
	for k in range(4000):
		main._read_odds()
		var done := true
		for i in range(Data.TIERS.size()):
			if main.sim.tier_open(i) and not main.sim.odds_settled(i):
				done = false
		if done:
			return


## A site's level (the endgame, 7 Oct): tier plus depth drives the curve, the bases and the item level, so the
## streets' ladder is gentle and long and the Barracks' steep and short; the Runs card says the level.
## The deep bases (10 Oct, docs/design/deep_guns.md): tiers 7-9 from level 12, 16 and 20, on every slot a runner
## wears; a campaign site's "a tier up" never reaches them; every deep base has its words and a footprint that fits.
func _deep_tier_checks(main) -> void:
	var sim = main.sim
	_check(sim.loot_tier_at(11) == 6 and sim.loot_tier_at(12) == 7 and sim.loot_tier_at(15) == 7 and sim.loot_tier_at(16) == 8 and sim.loot_tier_at(20) == 9,
		"the deep tiers by level are off: %d %d %d %d" % [sim.loot_tier_at(11), sim.loot_tier_at(12), sim.loot_tier_at(16), sim.loot_tier_at(20)])
	_check(sim.loot_cap(9) == Data.CAMPAIGN_TIER and sim.loot_cap(12) == Data.MAX_TIER, "a campaign site's tier up reaches the deep bases")
	for slot in ["Primary", "Secondary", "Helmet", "Armour", "Rig", "Backpack", "Charm"]:
		for tier in [7, 8, 9]:
			var n := 0
			for b in Data.BASES[slot]:
				if int(b["tier"]) == tier:
					n += 1
					_check(Words.ITEMS.has(b["name"]), "the deep base %s has no words" % b["name"])
					var f: Vector2i = Items.footprint({"slot": slot, "base": b["name"]})
					_check(f.x <= 5 and f.y <= 4, "the deep base %s does not fit a cell grid" % b["name"])
			_check(n > 0, "no %s base at tier %d" % [slot, tier])
		var deep_rng := RandomNumberGenerator.new()
		deep_rng.seed = 7
		var seen_deep := false
		for k in range(400):
			var it: Dictionary = Items.roll(slot, Data.CAMPAIGN_TIER, deep_rng)
			_check(int(it["tier"]) <= Data.CAMPAIGN_TIER, "a campaign roll gave a deep %s" % it["base"])
			var deep: Dictionary = Items.roll(slot, Data.MAX_TIER, deep_rng)
			seen_deep = seen_deep or int(deep["tier"]) > Data.CAMPAIGN_TIER
		_check(seen_deep, "a tier-9 roll never gave a deep %s" % slot)
	for t in Data.TIERS:
		_check(int(t["loot_tier"]) <= Data.CAMPAIGN_TIER, "the campaign's %s drops a deep tier" % t["name"])
	# the Workshop's gun builds: a deep improvised base only once a site drops its tier (the review, 10 Oct)
	var hold_bd: Array = sim.best_depth.duplicate()
	for i in range(sim.best_depth.size()):
		sim.best_depth[i] = 1
	var top_build := 0
	for e in sim.build_options("gun"):
		top_build = maxi(top_build, int(e["tier"]))
	_check(top_build == Data.CAMPAIGN_TIER, "the campaign's gun builds reach T%d" % top_build)
	for i in range(sim.best_depth.size()):
		sim.best_depth[i] = 20
	top_build = 0
	for e in sim.build_options("gun"):
		top_build = maxi(top_build, int(e["tier"]))
	_check(top_build == Data.MAX_TIER, "the deep gun builds stop at T%d at depth 20" % top_build)
	sim.best_depth = hold_bd
	# a shop's unique or set piece carries its own base's level, not a deep throwaway's
	var u_rng := RandomNumberGenerator.new()
	u_rng.seed = 11
	for k in range(60):
		var u: Dictionary = Data.UNIQUES[k % Data.UNIQUES.size()]
		var it: Dictionary = Items.roll_unique(u, u_rng)
		_check(Items.ilvl(it) <= Items.unique_tier(u, int(Items.base_named(u["slot"], u["base"])["tier"])), "%s rolled at level %d over its base's tier, held in its range" % [u["name"], Items.ilvl(it)])
	# each gun line climbs: every deep tier beats the line's best below it
	for slot in ["Primary", "Secondary"]:
		var best := {}
		for b in Data.BASES[slot]:
			if b.has("rof"):
				var k := "%s/%d" % [str(b.get("type", "")), int(b["tier"])]
				best[k] = maxf(float(best.get(k, 0.0)), float(b["damage"]) * float(b["rof"]))
		for k in best.keys():
			var bits: PackedStringArray = k.split("/")
			var tier := int(bits[1])
			if tier >= 7:
				var below := 0.0
				for k2 in best.keys():
					var b2: PackedStringArray = k2.split("/")
					if b2[0] == bits[0] and int(b2[1]) < tier:
						below = maxf(below, float(best[k2]))
				_check(float(best[k]) > below, "the deep %s at T%d (%.0f) doesn't beat its line below (%.0f)" % [bits[0], tier, float(best[k]), below])


func _site_level_checks(main) -> void:
	var sim = main.sim
	var hold_depth: Array = sim.depth.duplicate()
	var hold_best: Array = sim.best_depth.duplicate()
	for i in range(Data.TIERS.size()):
		sim.best_depth[i] = 20
	_check(sim.loot_tier_at(1) == 1 and sim.loot_tier_at(8) == 5 and sim.loot_tier_at(9) == Data.CAMPAIGN_TIER and sim.loot_tier_at(30) == Data.MAX_TIER, "the gear tier by level is off: %d %d %d" % [sim.loot_tier_at(1), sim.loot_tier_at(8), sim.loot_tier_at(9)])
	_deep_tier_checks(main)
	sim.set_depth(3, 8)
	sim.set_depth(11, 2)
	var hold_intel: Array = [sim.words[3].duplicate(true), sim.words[11].duplicate(true)]
	sim.words[3] = []                     # the plain sites: a word on the air can add a gear tier
	sim.words[11] = []
	var streets: Dictionary = sim.effective(3)
	var barracks: Dictionary = sim.effective(11)
	_check(int(streets["level"]) == 8 and int(barracks["level"]) == 10 and sim.site_level(3) == 8, "the sites' levels are off: %d / %d" % [int(streets["level"]), int(barracks["level"])])
	_check(float(barracks["hp"]) > float(streets["hp"]) and float(barracks["dps"]) > float(streets["dps"]), "the Barracks at depth 2 is no harder than the streets at depth 8: %.0f vs %.0f HP" % [float(barracks["hp"]), float(streets["hp"])])
	_check(int(streets["loot_tier"]) == 5 and int(barracks["loot_tier"]) == Data.CAMPAIGN_TIER, "the bases by level are off: streets tier %d, barracks tier %d" % [int(streets["loot_tier"]), int(barracks["loot_tier"])])
	# a find carries the site's level
	var f0: Dictionary = Items.roll("Primary", int(streets["loot_tier"]), sim.rng, 0.0, false, false, "", "", 0.33, 8, int(streets["level"]))
	var f8: Dictionary = Items.roll("Primary", int(barracks["loot_tier"]), sim.rng, 0.0, false, false, "", "", 0.33, 2, int(barracks["level"]))
	_check(int(f0["ilvl"]) == 8 and int(f8["ilvl"]) == 10, "a find's item level is not the site's: %d / %d" % [int(f0["ilvl"]), int(f8["ilvl"])])
	# never under the site's own campaign curve: the Barracks at depth 2 keeps the campaign's climb
	var camp_d2: float = float(Data.TIERS[11]["hp"]) * (1.0 + Data.DEPTH_HOSTILE)
	_check(float(barracks["hp"]) >= camp_d2 - 0.01, "the Barracks at depth 2 fell under its campaign curve: %.0f < %.0f" % [float(barracks["hp"]), camp_d2])
	# the Runs card says it: the level on the kicker, the finds' level on a tile, the stations on the note
	main.show_room(main.MISSIONS)
	main._missions._pick_zone(1)
	main._missions._shown = ""
	main.refresh()
	var c0: Dictionary = main._missions._cols[0]
	_check(c0["band"].kicker.text == "The Estate · Tier 1", "the streets' kicker isn't its zone and tier: '%s'" % c0["band"].kicker.text)     # the gear's level is the tile's (18 Oct, said once)
	var finds := -1
	for r in range(6):
		if c0["tiles"][r]["key"].text == "Item level":
			finds = r
	_check(finds >= 0 and c0["tiles"][finds]["value"].text.begins_with(str(sim.wear_of(8))), "the streets' Gear level tile is off: %s" % (c0["tiles"][finds]["value"].text if finds >= 0 else "no Gear level tile"))
	# every open site's tile reads the same way: the number first, never "level N gear" on one and "level N" on the next (Matt's shot)
	for c in main._missions._cols:
		if c["deploy"].visible:
			_check(c["tiles"][finds]["value"].text.substr(0, 1).is_valid_int(), "a Gear level tile reads '%s'" % c["tiles"][finds]["value"].text)
	main._missions._pick_zone(3)
	main._missions._shown = ""
	main.refresh()
	var c6: Dictionary = main._missions._cols[0]       # the Services, the city's first
	_check(not c6["note"].text.contains("Depth"), "the Services' card still names a depth's station: '%s'" % c6["note"].text)     # the depths are the signals' (15 Oct)
	_check_fit(main, "Runs (levels)")
	main._missions._pick_zone(1)
	_find_at_mine_checks(main)
	_tier_guide_checks(main)
	_site_unique_checks(main)
	_smg_line_checks(main)
	_growth_checks(main)
	_combo_checks(main)
	_auto_gone_checks(main)
	_socket_find_checks(main)
	sim.words[3] = hold_intel[0]
	sim.words[11] = hold_intel[1]
	sim.depth = hold_depth
	sim.best_depth = hold_best
	sim._surv_cache = {}


## A fifth of the finds at the runner's level (16 Oct, Matt's playtest: level 10 at the Bank, every drop for 14): the
## level to wear on the cards, a fifth of the plain gear at the wearable item level and the rest at the site's, on a
## site and a signal alike; a runner past the site gets all of it at the site's.
func _find_at_mine_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var keep_xp: float = sim.xp
	sim.xp = Data.xp_for_level(9)               # a level under the Bank's drops (10 at 2 x - 2, 19 Oct)
	var mine: int = sim.wearable_level()
	_check(sim.wear_of(mine) <= 9 and sim.wear_of(mine + 1) > 9, "the wearable item level at 9 is %d (wears at %d)" % [mine, sim.wear_of(mine)])
	var bank: Dictionary = sim.effective(8)
	var site_lv: int = int(bank["level"])
	var w: Array = sim.finds_words(site_lv)
	_check(site_lv > mine and w == [str(sim.wear_of(site_lv))], "the Bank's Gear level reads '%s', not its number" % str(w))
	var tally := func(t: Dictionary) -> Array:
		sim.rng.seed = 1616
		var low := 0
		var gear := 0
		var m := {"found": [], "tier": int(t["tier"]), "kills": 0, "patrols": 0}
		for k in range(1500):
			var got: Dictionary = sim._find(m, t, false, {}, true)
			var it: Dictionary = got["it"]
			if str(it.get("slot", "")) in Data.SLOTS and not it.has("unique") and not it.has("set") and not it.get("mythic", false):
				gear += 1
				if int(it.get("ilvl", 0)) == mine:
					low += 1
		return [low, gear]
	var on_site: Array = tally.call(bank)
	var share: float = float(on_site[0]) / maxf(1.0, float(on_site[1]))
	_check(on_site[1] > 200 and share > 0.14 and share < 0.27, "the Bank's plain gear at the runner's level: %d of %d" % [on_site[0], on_site[1]])
	var sig: Dictionary = bank.duplicate(true)
	sig["level"] = site_lv + 6                 # a signal's fix, deeper than the campaign site
	var on_sig: Array = tally.call(sig)
	var sig_share: float = float(on_sig[0]) / maxf(1.0, float(on_sig[1]))
	sig["loot_tier"] = Data.MAX_TIER           # a deep fix's bases: the runner's fifth comes on the campaign's, as a gamble's
	sim.rng.seed = 77
	var deep_ok := true
	var mm := {"found": [], "tier": 8, "kills": 0, "patrols": 0}
	for k in range(600):
		var g: Dictionary = sim._find(mm, sig, false, {}, true)["it"]
		if str(g.get("slot", "")) in Data.SLOTS and not g.has("unique") and not g.has("set") and int(g.get("ilvl", 0)) == mine and int(g["tier"]) > sim.gear_tier():
			deep_ok = false
	_check(deep_ok, "a find at the runner's level came on a deep base, past the campaign's tier %d" % sim.gear_tier())
	_check(sig_share > 0.14 and sig_share < 0.27, "a signal's plain gear at the runner's level: %d of %d" % [on_sig[0], on_sig[1]])
	sim.xp = Data.xp_for_level(40)
	var past: Array = tally.call(bank)
	_check(past[0] == 0 or sim.wearable_level() == site_lv, "a runner past the site got finds under it: %d" % past[0])
	sim.xp = keep_xp
	# the Runs card says when the rig's short of the fight's rounds (16 Oct), first so it's never the chip left off, and fits
	var keep_rig: Array = sim.rig.duplicate()
	var keep_gun = sim.equipped["Primary"]
	var aside: Array = sim.stash.filter(func(x): return Items.is_ammo(x))     # the stash's rounds would go out with it (the gate's top-up)
	for it in aside:
		sim.stash.erase(it)
	sim.equipped["Primary"] = sim._plain("Primary", _base_of_type("shotgun"))
	sim.rig = []                                  # none at all: short on any fight, however strong the runner (3 shells weren't, on a strong one)
	main.show_room(main.MISSIONS)
	main._missions._pick_zone(1)
	main._missions._shown = ""
	main.refresh()
	var cc: Dictionary = main._missions._cols[0]
	var card_chips: Array = cc["chips"].text_nodes().map(func(l): return str(l.text))
	_check(not card_chips.is_empty() and str(card_chips[0]).contains("hort") and cc["chips"].shown() >= 1, "the Runs card doesn't say the rig's short: %s" % str(card_chips))
	_check_fit(main, "Runs (rounds short)")
	sim.rig = keep_rig
	sim.equipped["Primary"] = keep_gun
	sim.stash.append_array(aside)
	main._missions._shown = ""
	print("a fifth of the finds at the runner's level ok: the Bank %d of %d, a signal %d of %d" % [on_site[0], on_site[1], on_sig[0], on_sig[1]])


## The map's tier guide (16 Oct, item 11): the button opens it over the Runs room on the zone's first site; its rows are
## the sim's guide_rows (depth 1 the baseline, the gear's level as finds carry it, what opens at its depth); the Where
## to farm tab names every head and every site's own unique; both tabs fit; the close puts the room back.
func _tier_guide_checks(main) -> void:
	var sim = main.sim
	var ms = main._missions
	main.show_room(main.MISSIONS)
	main.refresh()
	if sim.on_mission():
		print("the tier guide: skipped on a run")
		return
	var g = ms._guide
	g.site = -1
	g.tab = "depths"
	ms._guide_btn.pressed.emit()
	main.refresh()
	_check(g.visible and g.site == ms._tier(0) and g._site_title.text == str(Data.TIERS[g.site]["name"]), "the guide didn't open on the zone's first site: visible %s, site %d, '%s'" % [str(g.visible), g.site, g._site_title.text])
	_check_fit(main, "Runs (the tier guide, depths)")
	# the ladder as a signal plays it (the review: depth comes by signals, by level): from the site's own level, the
	# first row a signal at it against the campaign's run; the site's own unique at the level its depth reaches; the
	# deep tiers marked; the gangs never easing as the levels climb past the campaign's
	for i in [3, 8, 11]:
		var lv0: int = sim.lv_at(i, 1)
		var rows: Array = sim.guide_rows(i, lv0, 24)
		var r0: Dictionary = rows[0]
		_check(rows.size() == 24 and int(r0["level"]) == lv0 and int(r0["wear"]) == sim.wear_of(lv0) and int(r0["depth"]) == sim.tier_depth(lv0), "%s's first row isn't its own level: %s" % [Data.TIERS[i]["name"], str(r0)])
		var own: Dictionary = sim.site_unique(i)
		var own_lv: int = sim.site_unique_level(i)
		var own_row: Array = rows.filter(func(r): return int(r["level"]) == own_lv)
		_check(own.is_empty() or own_lv < lv0 or own_lv >= lv0 + 24 or (not own_row.is_empty() and own_row[0]["marks"].any(func(m): return str(m[0]).begins_with(str(own["name"])))), "%s's own unique isn't marked at level %d" % [Data.TIERS[i]["name"], own_lv])
		_check(own.is_empty() or sim.tier_depth(own_lv) == sim.site_unique_depth(i), "%s's own unique level %d isn't where a signal's depth reaches %d" % [Data.TIERS[i]["name"], own_lv, sim.site_unique_depth(i)])
		var ok := true
		for k in range(rows.size()):
			var r: Dictionary = rows[k]
			if int(r["level"]) in Data.DEEP_TIER_LEVELS:
				ok = ok and r["marks"].any(func(m): return str(m[1]) == "deep")
			if k >= 1 and int(r["depth"]) >= 3:
				ok = ok and float(r["gangs"]) >= float(rows[k - 1]["gangs"]) * (1.0 - 1e-6)
		_check(ok, "%s's ladder: a deep tier unmarked, or the gangs easing with level: %s" % [Data.TIERS[i]["name"], str(rows.map(func(r): return [int(r["level"]), snappedf(float(r["gangs"]), 0.01), r["marks"].map(func(m): return m[1])]))])
	# a ladder from part-way up doesn't mark again what opened under its first row
	var part: Array = sim.guide_rows(8, sim.lv_at(8, 1) + 10, 6)
	_check(not part[0]["marks"].any(func(m): return str(m[1]) == "set"), "a ladder from part-way up marks the set pieces again: %s" % str(part[0]["marks"]))
	# the table shows the rows from a few under the reach, the reach marked
	g._pick_site(11)
	var from: int = sim.guide_from(11, g.ROWS)
	var br: Array = sim.guide_rows(11, from, g.ROWS)
	var here: int = sim.reach - from
	var shown_ok: bool = g._rows[0]["cells"][0].text.ends_with("%d" % int(br[0]["level"])) and g._rows[11]["cells"][1].text == "Level %d" % int(br[11]["wear"])
	_check(shown_ok and (here < 0 or here > 11 or (g._rows[here]["cells"][0].text.begins_with("▶") and g._rows[here]["edge"].visible)), "the guide's table doesn't show the Barracks' rows: '%s', '%s' (reach %d from %d)" % [g._rows[0]["cells"][0].text, g._rows[11]["cells"][1].text, sim.reach, from])
	_check_fit(main, "Runs (the tier guide, the Barracks)")
	# where to farm
	g._pick_tab("farm")
	var farm_text: String = " | ".join(g.text_nodes().map(func(l): return str(l.text)))
	var missing: Array = []
	for b in Data.BOSSES:
		var bn: String = str(b["name"]) if g.known(sim, int(b["tier"])) else Fmt.scramble(str(b["name"]))     # not yet known: scrambled (20 Oct)
		if not farm_text.contains(bn):
			missing.append(b["name"])
	for i in range(Data.TIERS.size()):
		var u: Dictionary = sim.site_unique(i)
		if not u.is_empty() and not farm_text.contains(str(u["name"]) if g.known(sim, i) else Fmt.scramble(str(u["name"]))):
			missing.append(u["name"])
	var lf: Array = g.looking_for(sim)
	_check(missing.is_empty() and lf.any(func(x): return str(x[0]) == "Rifles" and str(x[1]).contains(g.site_name(sim, 11))), "Where to farm leaves out %s (looking for: %s)" % [str(missing), str(lf.slice(0, 3))])
	# a guide on a fresh camp: only the Outskirts known, the rest scrambled and not to be picked
	var fresh_s = Sim.new()
	fresh_s.start()
	_check(g.site_name(fresh_s, 0) == str(Data.TIERS[0]["name"]) and g.site_name(fresh_s, 11) == Fmt.scramble(str(Data.TIERS[11]["name"])) and not g.known(fresh_s, 11), "the guide knows a fresh camp's Barracks")
	_check(g.looking_for(fresh_s).all(func(x): return not str(x[1]).contains("The Barracks")), "the guide names the Barracks to a fresh camp")
	_check_fit(main, "Runs (the tier guide, where to farm)")
	g._close.pressed.emit()
	main.refresh()
	_check(not g.visible and ms.text_nodes().has(ms._title), "the guide's close didn't put the room back")
	g.tab = "depths"
	print("the tier guide: the ladders, the marks, where to farm ok")


## What grows without end (7 Oct): paragon levels past the cap on the same curve, the lorries' multiplier, and an affix's
## value by item level - so the second leg reaches further than the first and a deep drop beats a shallow one.
## Socketables, a find of their own (21 Oct, Matt's save: 4 in 300 finds): SOCKET_FIND of every find, kills too, about half
## the class's own pair's elements; the roll at the find's tier or under, a plain one in a stack of one.
func _socket_find_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var hold: Dictionary = sim.to_dict()
	_set_cls(sim, "Drifter")
	var own := 0
	var n := 400
	for k in range(n):
		var it: Dictionary = sim.socket_find_roll(9)
		_check(Items.is_socketable(it) and it["affixes"].is_empty() and int(it.get("count", 1)) == 1, "a socketable find isn't a plain socketable: %s" % str(it).substr(0, 120))
		if float(Items.base_of(it).get("conv_fire_pct", 0)) > 0.0 or float(Items.base_of(it).get("conv_shock_pct", 0)) > 0.0:
			own += 1
	_check(own > n * 0.45 and own < n * 0.85, "a Drifter's socketables: %d of %d fire or shock" % [own, n])
	_check(int(Items.base_of(sim.socket_find_roll(1))["tier"]) <= 1, "a tier-1 find's socketable came over its tier")
	# through the finds themselves, searches and kills
	sim.hp = sim.max_hp()
	sim.deploy(0)
	var socks := [0, 0]
	var finds := 1500
	for from_kill in [false, true]:
		for k in range(finds):
			var f: Dictionary = sim._find(sim.mission, sim.mission["t"], from_kill, {}, true)
			if not f.is_empty() and Items.is_socketable(f["it"]):
				socks[1 if from_kill else 0] += 1
	_check(socks[1] >= finds * Data.SOCKET_FIND * 0.6 and socks[0] >= finds * Data.SOCKET_FIND * 0.6, "socketables a find: %d of %d searches, %d of %d kills" % [socks[0], finds, socks[1], finds])
	sim.extract_now()
	sim.load_dict(hold)
	print("socketable finds ok")


## What came in auto-run's place (21 Oct, Matt): the Lookout's Early warning - after the clear, no gang till the first
## crate's searched - and the bus depot's pack cells.
func _auto_gone_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var hold: Dictionary = sim.to_dict()
	_check(not ("auto_tier" in sim.to_dict()) and not sim.has_method("set_auto"), "auto-run is still in the sim")
	_yard_set(sim, "lookout", 3, "a")
	_yard_set(sim, "lookout", 2, "b")      # Tripwires, not Hold fire: Early warning alone
	_check(sim.yard_has("early_warning") and not sim.yard_has("hold_fire"), "the Lookout's fourth pick is not Early warning")
	var m := {"patrols": 0, "crate_i": 0, "crates": [{"kind": "x"}], "found": []}
	_check(sim.gang_held(m), "Early warning let a gang come before the first crate")
	m["crate_i"] = 1
	_check(not sim.gang_held(m), "Early warning held the gang past the first crate")
	m["crate_i"] = 0
	m["dry"] = true
	_check(not sim.gang_held(m), "Early warning held a dry run's gang")
	var cap0: int = sim.capacity_raw()
	sim.rebuilt["bus_depot"] = 1
	var cap1: int = sim.capacity_raw()
	sim.rebuilt["bus_depot"] = 3
	_check(cap1 - cap0 == 2 * (2 if sim.has_node("hoarder") else 1) and sim.capacity_raw() - cap0 == 4 * (2 if sim.has_node("hoarder") else 1), "the bus depot's pack: +%d at rank 1, +%d at rank 3" % [cap1 - cap0, sim.capacity_raw() - cap0])
	sim.load_dict(hold)
	print("auto-run gone: Early warning, the bus depot's pack ok")


## The broken builds (21 Oct, Data.COMBOS): on with every part, off with any one gone or the balance's switch, and a
## run's stacks growing with no top - the class, its set at its count, the unique, the element's keystone and capstone.
const COMBO_TREES := {"embers": "Petrol", "clean_kills": "The cold", "flatline": "Live", "opened_for_good": "Blades", "live_load": "Live", "drilled": "Knuckles"}
const COMBO_STOPPERS := ["never_there", "hit_and_run", "walking_wounded"]     # the nodes that would stop a run's stacks: no recipe walks through one
func _combo_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var hold: Dictionary = sim.to_dict()
	# the first of each gang off the kit (21 Oct, Matt: "fix both"): an affix's line and a set's count in the fight's figure
	for sl in Data.SLOTS:
		sim.equipped[sl] = null
	sim._dry_memo.clear()
	var f0: float = sim.first_pct_total()
	var hat: Dictionary = sim._plain("Helmet", "Hard hat")
	hat["affixes"] = [{"stat": "first_pct", "value": 20, "tier": 2}]
	sim.equipped["Helmet"] = hat
	_check(is_equal_approx(sim.first_pct_total(), f0 + 20.0), "an affix's first of each gang isn't the fight's: %.0f from %.0f" % [sim.first_pct_total(), f0])
	var army: Dictionary = Items.set_named("The Army's")
	for k in range(3):
		sim.equipped[army["pieces"][k]["slot"]] = Items.roll_set_piece(army["name"], army["pieces"][k], sim.rng)
	var f3: float = sim.first_pct_total()
	_check(f3 >= f0 + 40.0, "the Army's three-piece first of each gang isn't the fight's: %.0f from %.0f" % [f3, f0])
	sim.load_dict(hold)
	for key in Data.COMBOS:
		var c: Dictionary = Data.COMBOS[key]
		sim.load_dict(hold)
		_set_cls(sim, str(c["class"]))
		var et: String = COMBO_TREES[key]
		var trees: Array = [et]
		for j in Data.JOINTS:
			if j["class"] == c["class"] and j["element_tree"] == et:
				trees.append(j["tree"])            # the joint's class half: the element's tops open with it
		sim.tree = []
		for tn in trees:
			for i in range(Data.tree_named(tn)["nodes"].size()):
				sim.tree.append("%s/%d" % [tn, i])
		for sl in Data.SLOTS:
			sim.equipped[sl] = null
		var st: Dictionary = Items.set_named(str(c["set"]))
		for k in range(int(c["pieces"])):
			var pc: Dictionary = st["pieces"][k]
			sim.equipped[pc["slot"]] = Items.roll_set_piece(st["name"], pc, sim.rng)
		var u: Dictionary = {}
		for x in Data.UNIQUES:
			if x.get("rule", "") == c["rule"]:
				u = x
		if u.is_empty():
			_check(not sim.combo_on(key), "%s turned on with no unique for its rule" % key)
			continue                            # Flatline's bag comes with the pinnacles' uniques (24 Oct)
		sim.equipped[u["slot"]] = Items.roll_unique(u, sim.rng, 10)
		if sim.equipped["Primary"] == null:
			sim.equipped["Primary"] = sim._plain("Primary", "Pump shotgun")     # Flatline's unique is a bag: a gun to make the kills with (25 Oct, a flake: bare hands)
		sim._dry_memo.clear()
		# its recipe (24 Oct): each node it needs walked to from nothing under the real gates, the build on at the end
		var tree_full: Array = sim.tree.duplicate()
		var gates_was: bool = sim.core_gates
		sim.core_gates = true
		sim.tree = []
		sim.xp = maxf(sim.xp, Data.xp_for_level(50))
		sim.best_level = maxi(sim.best_level, 50)    # the Pitch's points: an element's starter is theirs (24 Oct)
		var walked: Array = []
		for path in c.get("recipe", []):
			var rid: String = Data.node_id_named(str(path))
			_check(rid != "" and _walk(sim, rid), "%s's recipe: %s does not train from nothing ('%s')" % [key, path, sim.train_block(rid) if rid != "" else "no such node"])
			walked.append(rid)
		_check(c.get("recipe", []).size() == 4 and sim.combo_on(key), "%s's recipe doesn't turn the build on: %s" % [key, str(c.get("recipe", []))])
		_check(not COMBO_STOPPERS.any(func(e): return sim.has_node(e)), "%s's recipe walks through a node that stops the stacks" % key)
		sim.core_gates = gates_was
		sim.tree = tree_full
		sim._dry_memo.clear()
		_check(sim.combo_on(key), "%s's build is not on with every part: class %s, set %d, rule %s, nodes %s" % [key, sim.cls, sim.set_count(str(c["set"])), str(sim.has_rule(str(c["rule"]))), str(c["nodes"].map(func(n): return sim.has_node(str(n))))])
		var others: Array = Data.COMBOS.keys().filter(func(k2): return k2 != key and sim.combo_on(k2))
		_check(others.is_empty(), "%s's build turns on another's: %s" % [key, str(others)])
		# its defensive half (Matt, 27 Oct): a stack takes COMBO_GUARD_STEP off their fire, to the cap; none with no stacks
		_check(is_equal_approx(sim.combo_guard({"combo": 30.0}), 1.0 - 30.0 * Data.COMBO_GUARD_STEP) and is_equal_approx(sim.combo_guard({"combo": 1e6}), 1.0 - Data.COMBO_GUARD_CAP) and is_equal_approx(sim.combo_guard({}), 1.0),
			"%s's stacks don't guard: %.2f at 30, %.2f at a million" % [key, sim.combo_guard({"combo": 30.0}), sim.combo_guard({"combo": 1e6})])
		var warm_m := {}
		_check(sim._combo_warm(warm_m) == key and is_equal_approx(float(warm_m.get("combo", 0.0)), Data.COMBO_WARM), "%s's run doesn't start warm: %s" % [key, str(warm_m)])     # Matt, 27 Oct
		Sim.combos_off = true
		var cold_m := {}
		_check(sim._combo_warm(cold_m) == "" and not cold_m.has("combo"), "%s starts warm with the balance's switch off" % key)
		_check(is_equal_approx(sim.combo_guard({"combo": 30.0}), 1.0), "%s's guard holds with the balance's switch off" % key)
		_check(not sim.combo_on(key), "%s's build is on with the balance's switch off" % key)
		Sim.combos_off = false
		var piece_slot: String = st["pieces"][0]["slot"]
		var piece = sim.equipped[piece_slot]
		sim.equipped[piece_slot] = null
		_check(not sim.combo_on(key), "%s's build is on a set piece short" % key)
		sim.equipped[piece_slot] = piece
		# a run: the stacks grow, kill on kill
		for sl in ["Primary", "Secondary"]:
			if sim.equipped[sl] != null:
				var box: Dictionary = sim.ammo_box(Items.ammo_type(sim.equipped[sl]))
				if not box.is_empty():
					var fed: Dictionary = sim._plain(Data.AMMO, box["name"])
					Items.set_stack(fed, 2000)
					sim.rig.push_front(fed)
		if key == "drilled":                   # the Recruit's: a kill while a skill of his runs - three of his slotted, auto
			var sk_d: Dictionary = _skill_node_ids()
			for sid in ["make_ready", "suppressing_fire", "smoke"]:
				if not sim.tree.has(sk_d[sid]):
					sim.tree.append(sk_d[sid])
			sim.skill_slots = ["make_ready", "suppressing_fire", "smoke"]
			sim.skill_auto = [true, true, true]
			sim._dry_memo.clear()
		sim.hp = sim.max_hp()
		sim.deploy(3)
		sim.mission["remaining"] = 400
		var seen: Array = []
		for k in range(40):
			sim.hp = sim.max_hp()
			sim.advance(1.0)
			if sim.mission == null:
				break
			if k == 19 or k == 39:
				seen.append(Sim.combo_stacks(sim.mission))
				seen.append(int(sim.mission["remaining"]))
		_check(seen.size() == 4 and float(seen[0]) > 0.0 and (float(seen[2]) > float(seen[0]) or int(seen[1]) == 0) and is_finite(float(seen[2])), "%s's stacks did not grow on a run (stacks, left): %s" % [key, str(seen)])
		if sim.on_mission():
			sim.extract_now()
		if key == "drilled":                   # and none with no skill of his running (the review: the condition alone)
			sim.skill_slots = ["", "", ""]
			sim._dry_memo.clear()
			sim.hp = sim.max_hp()
			sim.deploy(3)
			sim.mission["remaining"] = 400
			for k in range(20):
				sim.hp = sim.max_hp()
				sim.advance(1.0)
				if sim.mission == null:
					break
			_check(sim.mission != null and int(sim.mission["kills"]) > 0 and Sim.combo_stacks(sim.mission) == Data.COMBO_WARM, "Drilled stacked with no skill of his running: %s" % (str(Sim.combo_stacks(sim.mission)) if sim.mission != null else "no run"))
			if sim.on_mission():
				sim.extract_now()
	# their figures on screen: past an int's top, a figure in e-notation that fits its tile (the review)
	_check(Fmt.num(1e30) == "1.0e30" and Fmt.num(2.5e12) == "2.5T" and Fmt.num(3e9) == "3.0B" and Fmt.num(-1e30) == Fmt.MINUS + "1.0e30", "a broken build's figures read %s / %s / %s" % [Fmt.num(1e30), Fmt.num(2.5e12), Fmt.num(3e9)])
	sim.load_dict(hold)
	sim.record["dealt"] = 1e30
	main.show_room(main.RUNNER)
	main.refresh()
	_check_fit(main, "the stats, a broken build's most damage")
	sim.load_dict(hold)
	print("the broken builds ok")


func _growth_checks(main) -> void:
	var sim = main.sim
	var hold: Dictionary = sim.to_dict()
	sim.lorries = 0
	sim.hp = 1e12                          # never under half: the under-half damage would ride on the growth (10 Oct)
	sim.xp = Data.xp_for_level(Data.MAX_LEVEL)
	var hp50: float = sim.max_hp()
	var dps50: float = sim.dps()
	_check(sim.level() == Data.MAX_LEVEL and sim.paragon() == 0 and is_equal_approx(sim.growth_mult(), 1.0), "at the cap the growth reads %.2f with %d paragon" % [sim.growth_mult(), sim.paragon()])
	sim.paragon_xp = 0.0
	sim.paragon_reset_free()
	# the paragon board (21 Oct, the crew; the web's ring from 22 Oct, slice 4): XP past the cap is the crew's; a level a
	# point, nothing paid until it's spent; a point goes on a ring node (RING_STACK to a node, pathed round from a
	# class's entry)
	sim._gain_xp(Data.xp_for_level(Data.MAX_LEVEL + 10) - Data.xp_for_level(Data.MAX_LEVEL))
	_check(sim.level() == Data.MAX_LEVEL and is_equal_approx(sim.xp, Data.xp_for_level(Data.MAX_LEVEL)) and sim.paragon() == 10 and sim.paragon_free() == 10, "ten levels past the cap read level %d, paragon %d, %d free, the runner's XP %.0f" % [sim.level(), sim.paragon(), sim.paragon_free(), sim.xp])
	_check(is_equal_approx(sim.max_hp(), hp50) and is_equal_approx(sim.dps(), dps50), "paragon levels paid with no point spent: hp ×%.2f" % (sim.max_hp() / hp50))
	for k in range(6):
		sim.paragon_add("damage")
	for k in range(4):
		sim.paragon_add("hp")
	var pct_d: float = float(Data.paragon_row("damage")["pct"])
	var pct_h: float = float(Data.paragon_row("hp")["pct"])
	_check(not sim.paragon_add("find") and sim.paragon_free() == 0, "a point past the paragon levels went on the board")
	_check(is_equal_approx(sim.max_hp() / hp50, pow(1.0 + pct_h / 100.0, 4.0)) and is_equal_approx(sim.dps() / dps50, pow(1.0 + pct_d / 100.0, 6.0)), "the board's points did not pay (each on the last, 25 Oct): hp ×%.3f dps ×%.3f" % [sim.max_hp() / hp50, sim.dps() / dps50])
	var pg: Array = sim.paragon_progress()
	_check(is_equal_approx(pg[0], 0.0) and pg[1] > 0.0, "the next paragon level reads %s" % str(pg))
	# the paragon's levels grow gently past 50, not doubling every seven (24 Oct: they stopped coming and the reach walled)
	var step_at := func(l: int) -> float: return Data.xp_for_level(l + 1) - Data.xp_for_level(l)
	_check(is_equal_approx(step_at.call(Data.MAX_LEVEL), floorf(step_at.call(Data.MAX_LEVEL - 1) * (1.0 + Data.PARAGON_XP_GROW))) and step_at.call(Data.MAX_LEVEL + 20) < step_at.call(Data.MAX_LEVEL) * 2.2 and step_at.call(Data.MAX_LEVEL + 20) > step_at.call(Data.MAX_LEVEL), "the paragon's levels: %.0f at 50, %.0f at 70" % [step_at.call(Data.MAX_LEVEL), step_at.call(Data.MAX_LEVEL + 20)])
	# resists and find, and a reset for tins: the points free again
	var fire0: float = sim.resist_raw("fire")
	var find0: float = sim.rarity_bonus()
	sim.cash = 1e9
	var cost: int = sim.paragon_reset_cost()
	_check(cost > 0 and sim.paragon_reset() and sim.paragon_free() == 10 and is_equal_approx(sim.cash, 1e9 - cost), "the board's reset: %d free, cost %d" % [sim.paragon_free(), cost])
	for k in range(4):
		sim.paragon_add("resists")           # the ring: the Recruit's spoke at 0° is a resists entry (24 Oct; it was a step round from hp)
	for k in range(2):
		sim.paragon_add("find")
	_check(sim.paragon_pts("resists") == 4 and sim.paragon_pts("hp") == 0 and sim.paragon_pts("find") == 2, "the way round the ring to resists reads wrong: %s" % str(sim.ring))
	_check(Data.RING["nodes"].filter(func(nd): return nd["entry"]).map(func(nd): return str(nd["key"])).size() == Data.CLASSES.size(), "the ring has an entry off a class's spoke")
	_check(is_equal_approx(sim.resist_raw("fire") - fire0, 4.0 * float(Data.paragon_row("resists")["pct"])) and is_equal_approx(sim.rarity_bonus() - find0, 2.0 * float(Data.paragon_row("find")["pct"]) / 100.0), "resists +%.1f and find +%.3f off the board" % [sim.resist_raw("fire") - fire0, sim.rarity_bonus() - find0])
	# the crew's, saved with the camp, not a runner's
	var d: Dictionary = JSON.parse_string(JSON.stringify(sim.to_dict()))
	var back = Sim.new()
	back.load_dict(d)
	_check(back.paragon() == 10 and back.paragon_pts("resists") == 4 and back.paragon_pts("find") == 2 and back.ring.values().all(func(v): return typeof(v) == TYPE_INT), "the ring did not survive a save: %s" % str(back.ring))
	# a resist point re-reads the odds (the review: it moves no bucket in their key); the board's resists stop at the cap
	var key0: Array = sim._odds_key(0)
	sim.paragon_add("resists")
	sim._key_memo = []
	_check(sim._odds_key(0) != key0, "a resist point on the board left the odds' key as it was")
	var over0: float = sim.over_cap("fire")
	for id in sim.ring:
		if sim.node(str(id))["key"] == "resists":
			sim.ring[id] = 500                   # past any stack: the cap holds
	sim._dry_memo.clear()
	_check(is_equal_approx(sim.resist_raw("fire"), maxf(fire0, Data.RESIST_CAP)) and is_equal_approx(sim.over_cap("fire"), over0), "the board's resists went past the cap: %.1f, over the cap %.1f from %.1f" % [sim.resist_raw("fire"), sim.over_cap("fire"), over0])
	# the Barracks (slice 4): the ring on the web - a node picked says its stack, Train puts a paragon point on it, the
	# reset button is the ring's; the ring's label carries the points free
	sim.paragon_reset_free()
	sim._dry_memo.clear()
	main.show_room(main.BARRACKS)
	var bk = main._barracks
	var wv = bk.web()
	_check(not bk.also_names().has("Paragon"), "the paragon board is still in the Also row: %s" % str(bk.also_names()))
	var ring_t: Dictionary = Data.RING
	_check(ring_t["nodes"].size() == Data.RING_NODES and wv.layout.has("%s/0" % Data.RING_TREE), "the ring is not on the web")
	var entry_id := ""
	for i in range(ring_t["nodes"].size()):
		if ring_t["nodes"][i].get("entry", false) and ring_t["nodes"][i]["key"] == Data.PARAGON_BOARD[0]["key"]:
			entry_id = "%s/%d" % [Data.RING_TREE, i]
	if entry_id == "":
		for i in range(ring_t["nodes"].size()):
			if ring_t["nodes"][i].get("entry", false):
				entry_id = "%s/%d" % [Data.RING_TREE, i]
	_check(entry_id != "" and sim.can_train(entry_id), "a ring entry can't take a paragon point: '%s'" % sim.train_block(entry_id))
	var off_id := "%s/%d" % [Data.RING_TREE, (int(entry_id.get_slice("/", 1)) + 3) % Data.RING_NODES]
	_check(sim.train_block(off_id).begins_with("wants a path"), "a ring node three on from an entry took a point with nothing before it: '%s'" % sim.train_block(off_id))
	wv.pick(entry_id)
	main.refresh()
	_check(bk._title.text.contains("the ring") and bk._title.text.contains("0 of %d" % Data.RING_STACK) and bk._train.visible and bk._train.text.contains("paragon point"), "a ring node picked reads '%s' / '%s'" % [bk._title.text, bk._train.text])
	_check_fit(main, "Caravan (a ring node picked)")
	bk._on_train()
	main.refresh()
	_check(int(sim.ring.get(entry_id, 0)) == 1 and sim.paragon_free() == 9 and bk._title.text.contains("1 of %d" % Data.RING_STACK), "Train did not put a paragon point on the ring node: '%s'" % bk._title.text)
	var next_id := "%s/%d" % [Data.RING_TREE, (int(entry_id.get_slice("/", 1)) + 1) % Data.RING_NODES]
	_check(sim.can_train(next_id), "the next ring node is not reached from a stacked one: '%s'" % sim.train_block(next_id))
	for k in range(Data.RING_STACK):
		sim.train_node(entry_id)
	_check(sim.train_block(entry_id).begins_with("full") and int(sim.ring[entry_id]) == Data.RING_STACK, "a ring node took points past its stack: %d, '%s'" % [int(sim.ring[entry_id]), sim.train_block(entry_id)])
	_check(bk._respec.text.begins_with("Reset the ring") and not bk._respec.disabled, "the ring's reset button reads '%s'" % bk._respec.text)
	bk._on_respec()
	bk._on_respec()     # the reset asks twice now (25 Oct, the review)
	_check(sim.paragon_spent() == 0 and sim.ring.is_empty() and not sim.tree.any(func(id): return sim.is_ring(str(id))), "the ring's reset button did not reset it")
	wv.pick("")
	sim.paragon_xp = Data.xp_for_level(Data.MAX_LEVEL + 10) - Data.xp_for_level(Data.MAX_LEVEL)
	_check(Data.xp_for_level(Data.MAX_LEVEL + 11) > Data.xp_for_level(Data.MAX_LEVEL + 10) and Data.xp_for_level(Data.MAX_LEVEL + 10) > Data.xp_for_level(Data.MAX_LEVEL), "the XP curve stops at the cap")
	main.refresh()
	_check(main._top_labels["level"].text == "%d +10" % Data.MAX_LEVEL and main._top_labels["xp"].text.contains(" / "), "the top bar does not say the paragon: '%s' / '%s'" % [main._top_labels["level"].text, main._top_labels["xp"].text])   # the figure with LEVEL beside it since the sheet (8 Oct)
	_check_fit(main, "Top bar (paragon)")
	sim.xp = Data.xp_for_level(Data.MAX_LEVEL)
	sim.paragon_xp = 0.0
	sim.paragon_reset_free()
	sim._dry_memo.clear()
	sim.lorries = 3
	_check(is_equal_approx(sim.max_hp() / hp50, pow(Data.LORRY_MULT, 3)) and is_equal_approx(sim.dps() / dps50, pow(Data.LORRY_MULT, 3)), "three lorries did not multiply the Pitch: hp ×%.2f" % (sim.max_hp() / hp50))
	# an affix's value by item level: nothing to ILVL_FROM, a fifth more at five past, the same tier
	var a := {"stat": "hp", "min": 10, "max": 50}
	var at15 := Items.roll_affix(a, Data.ILVL_FROM, sim.rng, 5)
	var at25 := Items.roll_affix(a, Data.ILVL_FROM + 10, sim.rng, 5)
	_check(int(at15["value"]) <= 50 and int(at25["value"]) >= int(round(Items.tier_range(a, 5)[0] * Items.ilvl_mult(Data.ILVL_FROM + 10))) and int(at25["tier"]) == 5, "the deep affix did not grow: %d at %d, %d at %d" % [int(at15["value"]), Data.ILVL_FROM, int(at25["value"]), Data.ILVL_FROM + 10])
	_check(is_equal_approx(Items.ilvl_mult(Data.ILVL_FROM + 10), 1.0 + Data.ILVL_SCALE * 10.0) and is_equal_approx(Items.ilvl_mult(5), 1.0), "the item level's multiplier is off")
	var u_shallow: Dictionary = Items.roll_unique(sim._unique_named("Lucky Cap"), sim.rng, 5)
	var u_deep: Dictionary = Items.roll_unique(sim._unique_named("Lucky Cap"), sim.rng, Data.ILVL_FROM + 20)
	_check(Items.ilvl(u_deep) == Data.ILVL_FROM + 20 and int(u_deep["affixes"][0]["value"]) == int(round(20 * Items.ilvl_mult(Data.ILVL_FROM + 20))) and int(u_shallow["affixes"][0]["value"]) == 20, "a unique found deep does not carry the depth: %d / %d" % [int(u_shallow["affixes"][0]["value"]), int(u_deep["affixes"][0]["value"])])
	# the find carries the site's level into a unique
	sim.best_depth[11] = 30
	sim.set_depth(11, 25)
	var t: Dictionary = sim.effective(11)
	var found: Dictionary = Items.roll_unique(sim.site_unique(11), sim.rng, int(t["level"]))
	_check(Items.ilvl(found) == 33, "the Barracks at depth 25 did not give a level-33 unique: %d" % Items.ilvl(found))
	# gear scaling (21 Oct): past ILVL_GROW_FROM a base's damage and armour and a flat line compound, a percent line doesn't
	var g0: int = Data.ILVL_GROW_FROM
	var g10: float = pow(1.0 + Data.ILVL_GROW, 10.0)
	_check(is_equal_approx(Items.grow(g0), 1.0) and is_equal_approx(Items.grow(5), 1.0) and is_equal_approx(Items.grow(g0 + 10), g10), "the bases' growth reads %.3f at %d" % [Items.grow(g0 + 10), g0 + 10])
	var gun: Dictionary = sim._plain("Primary", "Pipe shotgun")
	var vest: Dictionary = sim._plain("Armour", "Work jacket")
	vest["affixes"] = []
	gun["ilvl"] = g0
	vest["ilvl"] = g0
	var gun0: float = Items.dps(gun)
	var vest0: float = Items.armour(vest)
	gun["ilvl"] = g0 + 10
	vest["ilvl"] = g0 + 10
	_check(gun0 > 0.0 and vest0 > 0.0 and is_equal_approx(Items.dps(gun) / gun0, g10) and is_equal_approx(Items.armour(vest) / vest0, g10), "a base's damage or armour did not grow past the deep tier: ×%.3f, ×%.3f" % [Items.dps(gun) / maxf(gun0, 0.001), Items.armour(vest) / maxf(vest0, 0.001)])
	var flat: Array = Items._scaled([{"stat": "hp", "value": 100}, {"stat": "damage_pct", "value": 100}], g0 + 10)
	_check(int(flat[0]["value"]) == int(round(100.0 * Items.ilvl_mult(g0) * g10)) and int(flat[1]["value"]) == int(round(100.0 * Items.ilvl_mult(g0 + 10))), "a fixed list at a deep level: hp %d, damage %% %d" % [int(flat[0]["value"]), int(flat[1]["value"])])
	# a set piece at a deep find keeps its own base (its resist, its conversion, its look), lifted to its type's best there
	var lifted := 0
	for st in Data.SETS:
		for pc in st["pieces"]:
			var deep_pc: Dictionary = Items.roll_set_piece(st["name"], pc, sim.rng, g0 + 10, Data.MAX_TIER)
			var own_pc: Dictionary = Items.roll_set_piece(st["name"], pc, sim.rng, g0 + 10)
			var b: Dictionary = Items.base_named(pc["slot"], pc["base"])
			_check(deep_pc["base"] == pc["base"] and own_pc["base"] == pc["base"] and Items.base_of(deep_pc).get("res", {}) == b.get("res", {}) and Items.base_of(deep_pc).get("conv_bleed_pct", 0) == b.get("conv_bleed_pct", 0) and Items.score(deep_pc) >= Items.score(own_pc) - 0.001, "%s's %s at a deep find: on %s, %.0f against its own %.0f" % [st["name"], pc["name"], deep_pc["base"], Items.score(deep_pc), Items.score(own_pc)])
			lifted += 1 if float(deep_pc.get("lift", 1.0)) > 1.0 else 0
	_check(lifted > 0, "no set piece found deep was lifted")
	for st in Data.SETS:                   # a charm's lift reads in its find and cash; a bag's or a rig's none (the review)
		for pc in st["pieces"]:
			var deep_pc: Dictionary = Items.roll_set_piece(st["name"], pc, sim.rng, g0 + 10, Data.MAX_TIER)
			var lf: float = float(deep_pc.get("lift", 1.0))
			if pc["slot"] in [Data.CHARM]:
				_check(lf <= 1.0 or Items.find(deep_pc) + Items.cash_pct(deep_pc) > Items.find(Items.roll_set_piece(st["name"], pc, sim.rng, g0 + 10)) + Items.cash_pct(Items.roll_set_piece(st["name"], pc, sim.rng, g0 + 10)), "%s's lift does nothing to its find" % pc["name"])
			elif not (Data.SLOT_SCORE[pc["slot"]] in ["dps", "armour"]):
				_check(lf <= 1.0, "%s carries a lift its slot never reads: %.2f" % [pc["name"], lf])
	# the armour's cut, a med's heal and a grenade's hit read the level fought: a deep run's, the campaign's as they were
	var m_was = sim.mission
	sim.mission = {"t": {"level": g0 + 10}}
	_check(sim.fight_level() == g0 + 10 and is_equal_approx(sim.armour_k(), Data.ARMOUR_K * g10) and is_equal_approx(sim.fight_grow(), g10), "the armour's cut on a deep run reads %.1f" % sim.armour_k())
	sim.mission = {"t": {"level": 5}}
	_check(is_equal_approx(sim.armour_k(), Data.ARMOUR_K) and is_equal_approx(sim.fight_grow(), 1.0), "the armour's cut in the campaign moved: %.1f" % sim.armour_k())
	sim.mission = m_was
	# a shop's unique scales as the gamble does
	sim.mate = {"unique": "Lucky Cap", "notes": 0}
	var shop_u: Dictionary = sim._mate_item()
	_check(not shop_u.is_empty() and Items.ilvl(shop_u) == sim.gamble_level(), "the mate's unique at level %d, the gamble's %d" % [Items.ilvl(shop_u), sim.gamble_level()])
	sim.load_dict(hold)
	print("the growth ok: paragon, the lorries, the deep affix, the bases")


## The SMG line (7 Oct): a gun a tier from T2 to T6, two at T6, the top over the shotguns'; every SMG primary
## carries walking fire, read in the fight's stream and said on the panel's tail.
func _smg_line_checks(main) -> void:
	var sim = main.sim
	var smgs: Array = []
	for b in Data.BASES["Primary"]:
		if b.get("type", "") == "smg" and int(b["tier"]) <= Data.CAMPAIGN_TIER:     # the campaign's line; the deep bases are their own checks
			smgs.append(b)
	var tiers: Array = smgs.map(func(b): return int(b["tier"]))
	for t in range(2, 7):
		_check(t in tiers, "the SMG line has no T%d" % t)
	_check(tiers.count(6) == 2 and smgs.size() == 9, "the SMG line is %d guns with %d at T6" % [smgs.size(), tiers.count(6)])
	var top_smg := 0.0
	var top_other := 0.0
	for b in Data.BASES["Primary"]:
		if not b.has("rof") or int(b["tier"]) > Data.CAMPAIGN_TIER:
			continue
		var dps: float = float(b["damage"]) * float(b["rof"])
		if b.get("type", "") == "smg":
			top_smg = maxf(top_smg, dps)
		elif int(b["tier"]) == 6:
			top_other = maxf(top_other, dps)
	_check(top_smg > top_other and top_smg < top_other * 1.15, "the SMG top is %.0f against the others' %.0f: a shade over was the aim" % [top_smg, top_other])
	for b in smgs:
		_check(b.has("sustain"), "%s has no walking fire" % b["name"])
		_check(Words.item_words(b["name"]) != "", "%s has no words" % b["name"])
	# walking fire in the stream: nothing at the gang's first tick, the cap after ten seconds, reset by the next gang
	var hold = sim.equipped["Primary"]
	sim.equipped["Primary"] = sim._plain("Primary", "Riot squad's SMG")
	var m := {"sustain_t": 0.0}
	_check(is_equal_approx(sim.sustain_mult(m), 1.0), "walking fire starts above nothing")
	m["sustain_t"] = 5.0
	_check(is_equal_approx(sim.sustain_mult(m), 1.2), "walking fire at five seconds reads %.2f, not 1.20" % sim.sustain_mult(m))
	m["sustain_t"] = 30.0
	_check(is_equal_approx(sim.sustain_mult(m), 1.4), "walking fire did not cap at +40%%: %.2f" % sim.sustain_mult(m))
	sim.equipped["Primary"] = sim._plain("Primary", "Riot squad's shotgun")
	_check(is_equal_approx(sim.sustain_mult(m), 1.0), "a shotgun walks its fire")
	sim.equipped["Primary"] = hold
	# the panel's tail says it
	var gun: Dictionary = sim._plain("Primary", "Courier's SMG")
	_check(Items.base_res_words(gun).contains("walking fire: damage +4% a second, up to +40%"), "the SMG's tail does not say walking fire: '%s'" % Items.base_res_words(gun))
	print("the SMG line ok: nine guns, walking fire")


## A site's own unique (endgame part 3): never loose, gated by zone (the streets at 12, the Barracks at 6),
## found on its site past the gate and nowhere shallower; the Runs card names it until it is on the shelf.
func _site_unique_checks(main) -> void:
	var sim = main.sim
	for u in sim.loose_uniques(99):
		_check(not u.has("site"), "%s is a site's own and loose" % u["name"])
	_check(sim.site_unique_depth(3) == 12 and sim.site_unique_depth(7) == 9 and sim.site_unique_depth(11) == 6, "the sites' own depths are off: %d %d %d" % [sim.site_unique_depth(3), sim.site_unique_depth(7), sim.site_unique_depth(11)])
	_check(sim.site_unique(11)["name"] == "The Quartermaster's Manual" and sim.site_unique(3)["name"] == "The Gritter's Hopper", "the sites' own are off")
	var hold_shelf: Array = sim.shelf.duplicate()
	var hold_stash: Array = sim.stash.duplicate()
	sim.shelf = []
	# the Barracks at depth 5: never; at depth 6: within a few hundred finds
	var own := 0
	for d in [5, 6]:
		own = 0
		sim.set_depth(11, d)
		sim.deploy(11)
		var m: Dictionary = sim.mission
		var eff: Dictionary = sim.effective(11)
		for k in range(400):
			m["found"] = []
			sim._find(m, eff)
			if not m["found"].is_empty() and m["found"][0].get("unique", "") == "The Quartermaster's Manual":
				own += 1
		sim.extract_now()
		if d == 5:
			_check(own == 0, "the Barracks' own dropped at depth 5")
		else:
			_check(own > 0 and own < 60, "the Barracks' own is %d of 400 finds at depth 6; 3%% was the aim" % own)
	# the Runs card names it until it is found
	sim.shelf = []
	main.show_room(main.MISSIONS)
	main._missions.select(11)
	main.refresh()
	var c8: Dictionary = main._missions._cols[0]
	_check(main._missions._station_words(11).contains("signal: The Quartermaster's Manual, only here"), "the Barracks' station words do not name its own: '%s'" % main._missions._station_words(11))
	_check(not c8["note"].text.contains("Depth"), "the Barracks' card still names a depth's station: '%s'" % c8["note"].text)
	_check_fit(main, "Runs (a site's own)")
	sim.shelf = ["The Quartermaster's Manual"]
	_check(not main._missions._station_words(11).contains("its own"), "the Barracks' station words still name its own once found")
	# the Fence's gamble never hands out the chase
	var chase_names: Array = []
	for c in sim.shelf_chase():
		chase_names.append(c["name"])
	var leaked := ""
	for k in range(300):
		var g: Dictionary = sim.roll_gamble({"slot": "Charm", "type": ""}, 0.0)
		if g.get("unique", "") in chase_names:
			leaked = g["unique"]
	_check(leaked == "", "the gamble handed out the chase: %s" % leaked)
	main._missions._pick_zone(1)
	sim.shelf = hold_shelf
	sim.stash = hold_stash


## The map at thirty-six (endgame part 4, 7 Oct): the new nodes' effects, each read through the sim.
func _map_nodes_checks(main) -> void:
	var sim = main.sim
	var hold: Dictionary = sim.to_dict()
	sim.atlas = {}
	sim.atlas_points = 100
	sim.words[3] = []
	var take := func(keys: Array):
		for k in keys:
			_check(_rank_to(sim, k), "%s did not take" % k)
	sim.set_depth(3, 2)
	var e0: Dictionary = sim.effective(3)
	# the sites' column, down the chain
	take.call(["picked_over", "deeper_pockets", "quiet_roads", "after_dark"])
	var e1: Dictionary = sim.effective(3)
	_check("Night" in e1["intel"] and float(e1["rarity"]) - float(e0["rarity"]) >= 0.5 * 1.5 - 0.001, "After dark did not make the run a night run with the dark's half again: %.2f" % (float(e1["rarity"]) - float(e0["rarity"])))
	var ep1: int = sim.atlas_rank("easy_pickings")     # the Map's web (22 Oct): the way to After dark ranks Easy pickings on the rich way
	take.call(["second_look", "second_look", "open_ground", "short_cuts", "short_cuts", "worn_in", "worn_in"])     # the quiet way in its order: a shortcut through the keystone would rank it
	_check(is_equal_approx(sim.recover_s(), Data.RECOVER_H * 3600.0 / 2.0), "Worn in did not halve the recovery: %.0f" % sim.recover_s())
	take.call(["easy_pickings", "easy_pickings", "local_knowledge", "every_penny", "every_penny"])
	var e2: Dictionary = sim.effective(3)
	_check(is_equal_approx(float(e2["drop"]) / float(e1["drop"]), (1.0 + 0.1 * 2.0) / (1.0 + 0.1 * ep1)), "Easy pickings is off: %.2f" % (float(e2["drop"]) / float(e1["drop"])))
	_check(int(e2["loot_tier"]) == int(e1["loot_tier"]) + 1, "Local knowledge did not add a gear tier")
	_check(is_equal_approx(float(e2["pace"]) / float(e1["pace"]), 1.1), "Short cuts is off")
	_check(int(e2["contact"]) == int(e1["contact"]) - 1, "Open ground did not take one off")
	_check(is_equal_approx(float(e2["cash"]) / float(e1["cash"]), 1.2), "Every penny is off")
	var best0: int = sim.best_depth[3]
	sim.best_depth[3] = 3
	sim.set_depth(3, 6)
	_check(sim.depth[3] == 4, "without the keystone the ladder opened past the deepest plus one: %d" % sim.depth[3])
	var reach0: int = sim.reach
	sim.reach = 20
	var band0: Array = sim.signal_band([-1])     # one paper (20 Oct): the faint band reaches furthest under
	take.call(["lie_of_the_land"])
	var band1: Array = sim.signal_band([-1])
	_check(int(band0[0]) == 20 + int(Data.SIGNAL_GRADES[0]["roll"][0][0]) and int(band1[0]) == 20 - int(Data.FX["atlas/lie_of_the_land"]), "The lie of the land did not stop the low rolls: %s -> %s (18 Oct)" % [str(band0), str(band1)])
	sim.reach = reach0
	sim.set_depth(3, 2)
	sim.best_depth[3] = best0
	# the crews' column
	take.call(["paid_in_notes", "two_of_everything", "heads_up", "heads_up"])
	sim.boss_paid[5] = []                 # the runs above paid him: Long memory reads from here
	sim.bosses_beaten[1] = true
	sim.depth[5] = 3                     # the ladder by hand: the Lie of the land no longer opens it (18 Oct)
	var full: int = int(sim.boss_of(5)["notes"]) * 3
	_check(sim.boss_cost(5) == int(round(full / 3.0)), "Heads up is off: %d of %d" % [sim.boss_cost(5), full])
	_check(sim.pinnacle_depth(11) == int(Data.PINNACLE_DEPTH[3]), "the pinnacle moved before Full strength")
	take.call(["full_strength"])
	_check(sim.pinnacle_depth(11) == int(Data.PINNACLE_DEPTH[3]) - 2, "Full strength did not bring the pinnacle two sooner")
	take.call(["bounties", "bounties", "wages", "wages", "wages", "heavy_crews"])
	var e3: Dictionary = sim.effective(3)
	_check(is_equal_approx(float(e3["xp"]) / float(e2["xp"]), 1.3 * 1.5) and is_equal_approx(float(e3["cash"]) / float(e2["cash"]), 1.5) and int(e3["contact"]) == int(e2["contact"]) + 1, "Wages and Heavy crews are off")
	take.call(["their_own_kit", "their_own_kit", "marked_men", "long_memory"])
	sim.notes += 10000
	sim.arm_boss(5, true)
	sim.deploy(5)
	var paid_at: Array = sim.boss_paid[5].duplicate()
	sim.extract_now()
	_check(paid_at == [3] and sim.boss_cost(5) == 0, "Long memory did not make the next run at that depth free: %d, %s" % [sim.boss_cost(5), str(paid_at)])
	sim.set_depth(5, 2)
	_check(sim.boss_cost(5) > 0, "Long memory made another depth free")
	sim.arm_boss(5, true)
	sim.deploy(5)
	sim.extract_now()
	_check(sim.boss_paid[5] == [3, 2] and sim.boss_cost(5) == 0, "Long memory forgot a depth: %s" % str(sim.boss_paid[5]))
	sim.depth[5] = 3                     # the ladder by hand: the Lie of the land no longer opens it (18 Oct)
	_check(sim.boss_cost(5) == 0, "Long memory forgot the first depth paid")
	take.call(["head_start"])
	var pts: int = sim.atlas_points
	sim.deploy(5)
	var m: Dictionary = sim.mission
	m["boss"] = {"name": sim.boss_of(5)["name"], "zone": 0, "alive": true, "hp": 1.0, "started": true, "pinnacle": true}
	sim._boss_down(m, sim.effective(5))
	sim.extract_now()
	_check(sim.atlas_points == pts + 1, "Head start did not pay a point for a head at full strength")
	_check(int(m.get("notes", 0)) >= Data.NOTES_BOSS * 3 * 2, "Bounties did not double the head's notes: %d" % int(m.get("notes", 0)))
	var hi0: int = int(sim.signal_band([])[1])
	take.call(["lorrys_route"])
	_check(int(sim.signal_band([])[1]) == hi0 + 1, "The lorry's route did not widen the decoder's band at the top: %d from %d" % [int(sim.signal_band([])[1]), hi0])     # 15 Oct
	# the air (9 Oct): the juicing lane, each read through the sim on the streets at depth 2
	sim.yard_picks.erase("radio")              # the Radio's Scanner and band read alone elsewhere
	sim.yard_ranks = {}
	sim._yard_changed("")
	sim.words[3] = []
	sim.sealed[3] = false
	sim.notes += 100000
	var rc0: int = sim.word_craft_cost(3, "retune")
	take.call(["good_reception", "good_reception"])
	_check(sim.word_craft_cost(3, "retune") == maxi(1, int(ceil(rc0 * 0.7 - 0.0001))), "Good reception is off: %d of %d" % [sim.word_craft_cost(3, "retune"), rc0])
	_check(not sim.atlas_open("long_wave") or sim.atlas_rank("clear_air") > 0, "the codes' third spine node opened with the second not ranked")
	take.call(["clear_air"])
	_check(sim.set_filtered("Numbers") and sim.filtered == "Numbers", "Clear air did not take a filter")
	var heard := false
	for k in range(40):
		heard = heard or sim._roll_words(3, [], 2).any(func(wd): return wd["w"] == "Numbers")
	_check(not heard, "Clear air's word was still heard")
	var mw2: int = sim.max_words(3)
	var er0: Dictionary = sim.effective(3)
	take.call(["tip_offs", "tip_offs", "booster", "booster", "booster", "long_wave"])     # the quality way in its order (22 Oct: Booster sits past Tip-offs)
	_check(is_equal_approx(float(sim.word_effect("Numbers", 1)["drop"]), 1.0 + 0.3 * 1.3), "Booster is off: %s" % str(sim.word_effect("Numbers", 1)))
	_check(sim.max_words(3) == mw2 + 1 and mw2 == 2, "Long wave did not add a word at depth 2: %d from %d" % [sim.max_words(3), mw2])
	_check(is_equal_approx(float(sim.effective(3)["rarity"]) - float(er0["rarity"]), 0.1), "Tip-offs is off")
	take.call(["strong_signal", "strong_signal"])
	var twos := 0
	for k in range(40):
		twos += 1 if sim._roll_tier(3) == 2 else 0
	_check(twos > 10 and sim.word_tier_now(3, 2) == 2, "Strong signal did not land tier II at depth 2: %d of 40" % twos)
	var call0: int = sim.word_craft_cost(3, "call")
	take.call(["early_word", "early_word", "held_frequency"])
	_check(sim.word_craft_cost(3, "call") == maxi(1, int(ceil(float(call0) * 0.5 - 0.6))) or absi(sim.word_craft_cost(3, "call") - int(ceil(call0 * 0.5))) <= 1, "Early word is off: %d of %d" % [sim.word_craft_cost(3, "call"), call0])
	take.call(["relay"])
	_check(sim.set_standing(0, "Tooled up") and "Tooled up" in sim.effective(3)["intel"] and sim.active_words(3).size() == 1, "the Relay's standing word is not on the site: %s" % str(sim.active_words(3)))
	_check(not sim.set_standing(1, "Ex-army"), "a second standing word without the whole band")
	take.call(["bent", "whole_band"])
	_check(sim.set_standing(1, "Ex-army") and sim.active_words(3).size() == 2, "the whole band's second word is not on the site: %s" % str(sim.active_words(3)))
	sim.words[3] = [{"w": "Bailiffs", "t": 1}]
	_check(sim.active_words(3).size() == 3, "a site's own word and the two standing ones do not all work: %s" % str(sim.active_words(3)))
	var ranks := 0
	for a in Data.ATLAS:
		ranks += int(a["max"])
	_check(ranks == 59 and Data.ATLAS_ALL.size() >= Data.ATLAS.size() + 24 and sim.atlas_free() == sim.atlas_points - sim.atlas_spent(), "the map's ranks do not add to fifty-nine with the fillers: %d, %d free" % [ranks, sim.atlas_free()])
	_open_map(main)
	main._radio._atlas._shown = ""
	main.refresh()
	_check_fit(main, "Radio (the map, full)")
	main._radio._pick_view("air")
	# Held frequency (21 Oct): Hold at half price
	var hold_price: int = sim.word_craft_cost(3, "hold")
	sim.atlas.erase("held_frequency")
	_check(sim.word_craft_cost(3, "hold") >= hold_price * 2 - 1, "Held frequency does not halve Hold: %d with, %d without" % [hold_price, sim.word_craft_cost(3, "hold")])
	sim.load_dict(hold)


## The map in the Caravan's shape (Map-A, 7 Oct): the tiles in three columns, the pips as the ranks, the taken
## tiles lined, the sum strip, and the panel filled by a pick with a rank taken through it.
func _map_screen_checks(main) -> void:
	var sim = main.sim
	var at = main._radio._atlas
	var wv = at.web()
	# the Map's web (22 Oct): every atlas node and every filler on the canvas, none on another, the whole Dial in view
	var ids: Array = []
	for t in Data.MAP_WEB:
		for i in range(t["nodes"].size()):
			ids.append("%s/%d" % [t["name"], i])
	_check(at.visible and wv.visible and ids.size() == Data.ATLAS_ALL.size() and ids.size() >= Data.ATLAS.size() + 24, "the Map's web has %d nodes for %d atlas nodes" % [ids.size(), Data.ATLAS_ALL.size()])
	for a in Data.ATLAS:
		_check(Data.map_id(a["key"]) != "", "%s is not on the Map's web" % a["key"])
	var overlaps := 0
	for a_i in range(ids.size()):
		for b_i in range(a_i + 1, ids.size()):
			var pa: Vector2 = wv.layout[ids[a_i]]
			var pb: Vector2 = wv.layout[ids[b_i]]
			if pa.distance_to(pb) < wv.radius_of(wv.node_of(ids[a_i])) + wv.radius_of(wv.node_of(ids[b_i])) + 4.0:
				overlaps += 1
	_check(overlaps == 0, "%d pairs of Map nodes sit on each other" % overlaps)
	wv.focus_all()
	for id in ids:
		var p: Vector2 = wv.to_screen(wv.layout[id])
		_check(p.x >= -1.0 and p.y >= -1.0 and p.x <= wv.size.x + 1.0 and p.y <= wv.size.y + 1.0, "%s is off the Dial's canvas at the whole zoom" % id)
	wv.show_state(sim)
	for key in sim.atlas:
		if sim.atlas_rank(key) > 0 and Data.map_id(key) != "":
			_check(wv.state_of(Data.map_id(key)).get("taken", false), "%s is ranked and the canvas doesn't show it" % key)
	var taken := 0
	for key in sim.atlas:
		if sim.atlas_rank(key) > 0 and not Data.atlas_of(key).get("filler", false):
			taken += 1
	_check(at._sum_chips.shown() >= mini(taken, at.SUM_CHIPS) - 1 and at._sum_chips.shown() <= mini(taken, at.SUM_CHIPS) + 1, "the map's sum strip shows %d chips for %d taken" % [at._sum_chips.shown(), taken])
	# the regions: a spine ending in the keystone, two branches; a shut node's panel says what it needs
	for t in Data.MAP_WEB:
		var keys: Array = t["nodes"].filter(func(n): return not n.get("filler", false)).map(func(n): return n["key"])
		var last: Dictionary = Data.atlas_of(t["nodes"][3]["key"])
		_check(keys.size() == (12 if t["column"] != 2 else 11) and last.get("keystone", false), "%s is not its nodes with the keystone at the spine's end" % t["name"])
	at._pick("lie_of_the_land")
	_check((at._title.text.contains("wants a path") or at._title.text.contains("opens at %d points" % Data.MAP_KEYSTONE_POINTS) or sim.can_rank_atlas("lie_of_the_land")) and (at._take.disabled or sim.can_rank_atlas("lie_of_the_land")), "a shut node's panel does not say what it needs: '%s'" % at._title.text)
	for b in at._web_buttons:
		_check(b.visible, "a Dial web button is hidden")
	at._web_buttons[3].pressed.emit()
	_check(wv.zoom > 0.3, "The codes button did not zoom the canvas")
	at._web_buttons[0].pressed.emit()
	# a pick fills the panel; a rank through it takes; the pips follow
	var rank0: int = sim.atlas_rank("quiet_roads")
	sim.atlas_points += 1
	at._pick("quiet_roads")
	_check(at._title.text.begins_with("Quiet roads · rank %d of 3" % rank0) and at._take.visible and not at._take.disabled and at._words.text.ends_with("."), "the map's panel after a pick is off: '%s' / '%s'" % [at._title.text, at._words.text])
	_check(at._words.position.y >= at._chips.position.y + Chips.CHIP_H, "the map panel's sentence sits on its chips")
	at._on_take()
	_check(sim.atlas_rank("quiet_roads") == rank0 + 1 and at._title.text.begins_with("Quiet roads · rank %d of 3" % (rank0 + 1)), "a rank through the panel did not take: %d, '%s'" % [sim.atlas_rank("quiet_roads"), at._title.text])
	_check_fit(main, "Runs (the map, picked)")
	sim.atlas_points -= 1                 # the point lent above goes back: the save check after counts them


## The rail (9 Oct, Matt's order and names): the loadout is Runner, the sheet is Stats, the Bench is the Workshop.
