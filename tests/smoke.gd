## The Clinic's cure card (30 Oct, parked item 6, the Tourniquet: "Stops bleed" on its chip, "heals 0 for you, over
## 0 s"): every heal and cure as the shelf's pick; a cure's figure line is what it stops with no tail; a heal's tail
## says what it heals; the figure line and the tail never overlap.
func _l32_clinic_cure_checks(main) -> void:
	var sim = main.sim
	var hold: Array = sim.clinic.duplicate()
	main.show_room(main.MEDIC)
	var cl = main._clinic
	if cl.showing != "shelf":
		cl._show("shelf")
	var cures := 0
	var heals := 0
	for b in Data.BASES[Data.MEDICAL]:
		var it: Dictionary = sim._plain(Data.MEDICAL, str(b["name"]))
		sim.clinic = [it]
		main.refresh()
		cl._shelf._pick(cl._shelf.cell_of(it["id"]))
		main.refresh()
		var head = cl._head
		_check(head.visible and head._title.text.begins_with(str(b["name"])), "the Clinic didn't show %s: '%s'" % [b["name"], head._title.text])
		var all_words: Array = head.text_nodes().filter(func(x): return x is Label and _showing(x)).map(func(x): return str(x.text))
		var fig_r: Rect2 = _text_rect_local(head._figure, UI)
		var fig_w: float = UI.text_width(head._figure, head._figure.text) + ((10.0 + UI.text_width(head._unit, head._unit.text)) if head._unit.text != "" else 0.0)
		_check(fig_w <= head.width + 0.5, "%s's figure line runs past the card: '%s %s'" % [b["name"], head._figure.text, head._unit.text])
		if head._tail_chips.visible and head._tail_chips.shown() > 0:
			var tail_r: Rect2 = head._tail_chips.used_rect()
			tail_r.position += head._tail_chips.position
			var unit_r: Rect2 = _text_rect_local(head._unit, UI)
			_check(not fig_r.intersects(tail_r) and (head._unit.text == "" or not unit_r.intersects(tail_r)), "%s: the figure line %s sits on its tail %s" % [b["name"], str(fig_r), str(tail_r)])
		if b.has("cure"):
			cures += 1
			_check(head._figure.text == Words.CURE_CLEARS[str(b["cure"])] and head._unit.text == "", "%s's figure line reads '%s' '%s'" % [b["name"], head._figure.text, head._unit.text])
			_check(not all_words.any(func(w): return w.contains("heals")), "%s's card reads %s" % [b["name"], str(all_words)])
		elif b.has("heal"):
			heals += 1
			_check(head._tail_chips.visible and head._tail_chips.words(0).begins_with("heals ") and not head._tail_chips.words(0).begins_with("heals 0"), "%s's tail: %s" % [b["name"], str(all_words)])
	_check(cures >= 5 and heals >= 3, "the Clinic's meds tried: %d cures, %d heals" % [cures, heals])
	sim.clinic = hold
	cl.selected = {}
	main.refresh()
	print("the Clinic's cards ok: %d cures read what they stop, %d heals their tail, none on its tail" % [cures, heals])


func _r4_art_names_checks() -> void:
	_check(Items.slug("The Rat Man's Bag") == "the_rat_man_s_bag" and Items.slug("Semi-auto .22") == "semi_auto_22" and Items.slug("AR-pattern rifle") == "ar_pattern_rifle" and Items.slug("  The Allotments ") == "the_allotments",
		"the art-name rule: %s" % str([Items.slug("The Rat Man's Bag"), Items.slug("Semi-auto .22"), Items.slug("AR-pattern rifle"), Items.slug("  The Allotments ")]))
	var keys := {}
	for t in Data.TIERS:
		keys[Items.slug(str(t["name"]))] = true
	for z in Data.ZONES:
		keys[Items.slug(str(z["name"]))] = true
	for b in Data.BOSSES:
		keys[Items.slug(str(b["name"]))] = true
	for p in Data.PINNACLES:
		for f in ["who", "place", "art"]:
			if p.has(f):
				keys[Items.slug(str(p[f]))] = true
	for c in Data.COUNTY:
		for f in ["place", "who"]:
			if c.has(f):
				keys[Items.slug(str(c[f]))] = true
	for z in Data.COUNTY_ZONES:
		keys[Items.slug(str(z["name"]))] = true
		keys[Items.slug(str(z["head"]))] = true
	var seen := 0
	var orphans: Array = []
	for dir in ["res://art/fight_boss", "res://art/fight_county", "res://art/fight_walls", "res://art/fight_new", "res://art/fight"]:
		for f in DirAccess.get_files_at(dir):
			if not f.ends_with(".png"):
				continue
			var stem: String = f.get_basename()
			var key := ""
			if stem.ends_with("_plate") or stem.ends_with("_cover"):
				key = stem.substr(0, stem.length() - 6)
			elif stem.begins_with("head_") or stem.begins_with("gang_"):
				var parts: PackedStringArray = stem.substr(5).split("_")
				var drop: int = 1 if stem.begins_with("head_") else 2          # head_<key>_<pose>, gang_<key>_<a|b>_<pose>
				key = "_".join(parts.slice(0, parts.size() - drop))
			else:
				continue                                  # the hands: a gun's or a kind's, not a place's
			seen += 1
			if not keys.has(key):
				orphans.append("%s/%s" % [dir.get_file(), f])
	_check(seen > 0 and orphans.is_empty(), "a place's or a head's picture no name finds by the art rule (%d read): %s" % [seen, str(orphans)])
	print("refactor 5 art names ok: %d pictures" % seen)


## U1, U2: hurt, the repeat's gate read as the shell reads it - an odds frame, then a paint - never disagrees with the
## press, settles to ready, and leaves the site's hurt read as it was.
func _fixa_gate_paint_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	_fixa_prep(sim)
	var site := 0
	main.show_room(main.MISSIONS)
	main._missions.select(site)
	main._missions._shown = ""
	main.refresh()
	var cols: Dictionary = main._missions._cols[0]
	sim.hp = sim.max_hp() * 0.45
	sim._caches_out()
	var mism: Array = []
	var ready_at := -1
	for f in range(3000):
		main._read_odds()
		main.refresh()
		var verdict: bool = sim.can_repeat(site)
		if cols["repeat"].visible and cols["repeat"].disabled == verdict:
			mism.append([f, verdict, sim.repeat_block(site)])
		if verdict and cols["repeat"].visible and not cols["repeat"].disabled:
			ready_at = f
			break
	_check(mism.is_empty(), "U2: the repeat button disagreed with the press %d times: %s" % [mism.size(), str(mism.slice(0, 3))])
	_check(ready_at >= 0, "U1: hurt, Run it ×5 never settled to ready: '%s', '%s'" % [sim.repeat_block(site), cols["repeat"].text])
	_check(sim._surv_cache.has(site) and sim._surv_cache[site][0] == sim._odds_key(site), "U1: the full-HP read took the site's hurt read")
	sim.load_dict(saved)
	main.refresh()
	print("fix A gate paint ok: settled at frame %d" % ready_at)


## U3: a refused repeat says why (the gate's reason with the repeat out of it), mid-sentence on the card - HP kept.
func _fixa_repeat_refused_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	_fixa_prep(sim)
	var zt: Array = Data.ZONES[0]["tiers"]
	var site: int = int(zt[1])
	sim.best_depth[site] = maxi(1, int(sim.best_depth[site]))
	_fixa_repeat_at(sim, site)
	sim.best_depth[int(zt[0])] = 0                 # the site shut behind them: the next run can't go
	sim._repeat_go()
	var rep: Dictionary = sim.repeat_report
	var want: String = Words.mid_base(Words.REPEAT["shut_site"])
	_check(not sim.away() and str(rep.get("ended", "")) == "blocked" and str(rep.get("reason", "")) == want, "U3: a refused repeat's reason: ended '%s', '%s' (want '%s')" % [str(rep.get("ended", "")), str(rep.get("reason", "")), want])
	sim.best_depth[int(zt[0])] = 1
	main.show_room(main.MISSIONS)
	main._missions.select(site)
	main._missions._shown = ""
	main.refresh()
	var rc = main._missions._report
	_check(rc.visible and rc.ended.text == Words.REPEAT["ended_blocked"] % want, "U3: the card's end: '%s'" % rc.ended.text)
	var hp_why: String = Words.mid_base(Words.REPEAT["shut_odds"] % 85)
	sim.repeat_report["reason"] = hp_why
	rc.visible = false
	main._missions._shown = ""
	main.refresh()
	_check(rc.ended.text == Words.REPEAT["ended_blocked"] % hp_why and rc.ended.text.contains("HP"), "U3: a reason's HP lowered on the card: '%s'" % rc.ended.text)
	sim.repeat_seen()
	sim.load_dict(saved)
	main.refresh()
	print("fix A repeat refused ok")


## The expeditions (29 Oct, docs/design/trips.md 3, 4 line B, 6): `-- only expeditions`. The gate (after the
## Quartermaster), the selected runner refused, cargo converted (the return grows with the cargo's worth; no cargo, no
## return), the risk and its roll, the quota, the hold-up's three ways out, hands rolled as items (save/load), the pool's
## rerolls, wages only for those sent, levelling, hurt, lost only on walking away, line B's steps and expeditions at once,
## every new screen's fit, save/load mid-expedition, no offline progress.
func _expeditions_checks(main) -> void:
	var sim = main.sim
	var E: Dictionary = Words.EXPEDITIONS
	if sim.on_mission():
		sim.extract_now()
	if sim.away():
		sim.bring_back()
	sim.mission = null
	sim.repeat = {}
	sim.odds_budget = 0
	sim.candidates = []
	var home: String = sim.cls
	var lead_cls: String = "Scrapper" if home != "Scrapper" else "Drifter"
	if not sim.roster.has(lead_cls):
		_check(sim.set_class(lead_cls) and sim.set_class(home), "the fixture: no second runner for a lead")
	sim.roster[lead_cls]["xp"] = maxf(float(sim.roster[lead_cls].get("xp", 0.0)), Data.xp_for_level(20))
	var qz: int = 3
	for b in Data.BOSSES:
		if str(b["name"]) == "The Quartermaster":
			qz = int(b["zone"])
	sim.yard_picks.erase("bunkhouse")
	sim.yard_ranks.erase("bunkhouse")
	sim._yard_dirty = true
	sim.expeditions = []
	sim.hands = []
	sim.hand_pool = []
	sim.seen.erase("hand_pool_rolled")
	sim.quota_done = {}
	sim.cash = 1e7
	sim.scrap = 50000
	sim.salvage["copper"] = 400
	sim.salvage["army"] = 999                  # the Bunkhouse's fifth step wants army surplus
	sim.yard_open = maxi(sim.yard_open, 5)     # the Pitch's fifth column, as a camp dug deep has it
	for i in range(Data.TIERS.size()):
		sim.best_depth[i] = maxi(1, int(sim.best_depth[i]))     # the campaign done: the hold sites open
	for z in range(sim.bosses_beaten.size()):
		sim.bosses_beaten[z] = true
	var cargo: Array = [{"kind": "scrap", "n": 5000}]
	# --- the gate: shut before the Quartermaster, the Bunkhouse's line B with it; open after
	sim.bosses_beaten[qz] = false
	_check(not sim.expeditions_open() and sim.exp_send_block(0, lead_cls, [], cargo) == E["shut_open"] and not _exp_go(sim, 0, lead_cls, [], cargo),
		"an expedition went before the Quartermaster: '%s'" % sim.exp_send_block(0, lead_cls, [], cargo))
	_check(sim.yard_pick_block("bunkhouse", 0, "b") == Words.REPEAT["stub"] and sim.yard_stub("bunkhouse", 0, "b"), "the Bunkhouse's line B opened before the Quartermaster: '%s'" % sim.yard_pick_block("bunkhouse", 0, "b"))
	main.show_room(main.MISSIONS)
	main._missions.set_expeditions(true)
	main.refresh()
	_check(not main._missions.exp_on and not main._missions._exp_btn.visible, "the Map's Expeditions tab showed before the Quartermaster")
	sim.bosses_beaten[qz] = true
	_check(sim.expeditions_open() and not sim.yard_stub("bunkhouse", 0, "b") and sim.yard_pick_block("bunkhouse", 0, "b") == "", "the Quartermaster down didn't open the expeditions and line B: '%s'" % sim.yard_pick_block("bunkhouse", 0, "b"))
	# --- the selected runner can't go; the lead is another class's
	_check(not (home in sim.exp_leads()) and lead_cls in sim.exp_leads(), "the leads: %s (the runner %s)" % [str(sim.exp_leads()), home])
	_check(sim.exp_send_block(0, home, [], cargo) == E["shut_selected"] and not _exp_go(sim, 0, home, [], cargo), "the selected runner went: '%s'" % sim.exp_send_block(0, home, [], cargo))
	# --- the odds: the gate's dry read of the lead's kit at the far place, the same read the lead's own gate makes
	var o: Array = sim.exp_odds(0, lead_cls)
	_check(bool(o[1]) and float(o[0]) >= 0.0 and float(o[0]) <= 1.0, "the far place's odds didn't read: %s" % str(o))
	_check(sim.cls == home and not sim.roster.has(home) and sim.roster.has(lead_cls), "the odds' read left the crew swapped: %s, %s" % [sim.cls, str(sim.roster.keys())])
	# --- cargo converted: no cargo, no return; the return grows with the cargo's worth
	_check(sim.exp_send_block(0, lead_cls, [], []) == E["shut_cargo"] and is_equal_approx(sim.exp_return_worth(0, 0.0, []), 0.0), "no cargo still went, or returned something")
	var r_small: float = sim.exp_return_worth(0, 1000.0, [])
	var r_big: float = sim.exp_return_worth(0, 8000.0, [])
	_check(r_big > r_small * 7.0 and r_small > 0.0 and sim.exp_quality(8000.0, []) > sim.exp_quality(1000.0, []), "the return doesn't grow with the cargo's worth: %.0f, %.0f" % [r_small, r_big])
	var scrap0: int = sim.scrap
	var cash0: float = sim.cash
	_check(_exp_go(sim, 0, lead_cls, [], cargo), "an expedition with the lead alone didn't go: '%s'" % sim.exp_send_block(0, lead_cls, [], cargo))
	_check(sim.scrap == scrap0 - 5000 and is_equal_approx(sim.cash, cash0), "the cargo didn't leave the camp, or the lead alone was paid: scrap %d -> %d, %s -> %s" % [scrap0, sim.scrap, str(cash0), str(sim.cash)])
	var e1: Dictionary = sim.expeditions[0]
	_check(is_equal_approx(float(e1["worth"]), 5000.0 * sim.cargo_unit("scrap")) and sim.cargo_unit("scrap") < sim.exchange_worth("scrap") and float(e1["dur"]) == float(Data.EXP_PLACES[0]["time"]), "the shipment's worth or time: %s" % str(e1))
	_check(sim.lead_out(lead_cls) and not sim.set_class(lead_cls), "the lead away could still be played")
	# one at a time before Two at once
	_check(sim.exp_send_block(1, lead_cls, [], [{"kind": "copper", "n": 10}]) == E["shut_at_once"] % 1, "a second expedition went before Two at once: '%s'" % sim.exp_send_block(1, lead_cls, [], [{"kind": "copper", "n": 10}]))
	e1["risk"] = 0.0
	e1["hold"] = 0.0
	sim.advance(float(e1["dur"]) - 10.0)
	_check(str(e1["state"]) == "out", "the expedition came back before its time")
	sim.advance(20.0)
	_check(str(e1["state"]) == "back" and not bool(e1["res"]["bad"]), "the expedition didn't come back on time: %s" % str(e1["state"]))
	var res1: Dictionary = e1["res"]
	_check(float(res1["total"]) > 0.0 and (not res1["items"].is_empty() or not res1["cur"].is_empty()), "the cargo came back as nothing: %s" % str(res1))
	var meds: int = res1["items"].filter(func(it): return Items.is_medical(it) or Items.is_supplies(it)).size()
	_check(meds > 0, "Swansea paid no meds or supplies: %s" % str(res1["items"].map(func(it): return it["base"])))
	main.show_room(main.MISSIONS)
	main._missions._shown = ""
	main.refresh()
	var rep = main._missions._exp_report
	_check(rep.visible and rep.title.text == E["rep_title"] % Words.mid(str(Data.EXP_PLACES[0]["name"])) and rep.take.visible, "the report isn't up when they're back: '%s'" % rep.title.text)
	_check_fit(main, "the Map, an expedition back")
	var st0: int = sim.stash.size()
	_check(sim.exp_take(int(e1["id"])) and sim.expeditions.is_empty() and sim.stash.size() > st0 and not sim.lead_out(lead_cls), "Take it didn't put it away: %d items" % (sim.stash.size() - st0))
	# the bigger cargo brings back more, rolled
	var totals: Array = []
	for n in [2000, 16000]:
		sim.scrap = 50000
		_check(_exp_go(sim, 1, lead_cls, [], [{"kind": "scrap", "n": n}]), "the fixture: Bristol didn't go")
		var e: Dictionary = sim.expeditions[0]
		e["risk"] = 0.0
		e["hold"] = 0.0
		sim.advance(float(e["dur"]) + 1.0)
		totals.append(float(e["res"]["total"]))
		var tins0: float = sim.cash
		sim.exp_take(int(e["id"]))
		_check(sim.cash > tins0, "Bristol paid no %s" % sim.money_word())
	_check(totals[1] > totals[0] * 7.0, "the return didn't grow with the cargo: %s" % str(totals))
	# --- the risk: the cargo's worth over the lead's kit, the odds short; the roll loses 25-100%
	var odds_v: float = sim.exp_crew_odds(0, lead_cls, [])
	var rk_small: float = sim.exp_risk(0, lead_cls, [], 100.0, 1.0)
	var rk_big: float = sim.exp_risk(0, lead_cls, [], sim.lead_strength(lead_cls) * 2.0, 1.0)
	_check(rk_big > rk_small and rk_big < Data.EXP_RISK_MAX, "the risk doesn't grow with the cargo: %.2f, %.2f" % [rk_small, rk_big])
	_check(sim.exp_risk(0, lead_cls, [], 100.0, 0.5) > rk_small + 0.3, "the risk doesn't grow as the odds fall: %.2f" % sim.exp_risk(0, lead_cls, [], 100.0, 0.5))
	_check(odds_v >= 0.0 and odds_v <= 1.0, "the crew's odds: %.2f" % odds_v)
	sim.yard_ranks["bunkhouse"] = 3
