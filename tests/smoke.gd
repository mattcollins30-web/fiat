	_check(not sim.hand_free(porter) and sim.exp_send_block(0, lead_cls, [int(porter["id"])], cargo) == E["shut_hand"] % "Porter", "a hurt hand could go: '%s'" % sim.exp_send_block(0, lead_cls, [int(porter["id"])], cargo))
