	_check(not up.is_empty(), "the bot's fixture: no armour better than the work jacket to wear")
	if not up.is_empty():
		m["floor"] = [up]                     # the floor's upgrade alone: the bot would wear the bags and the rig above too
		ids0 = m["found"].map(func(x): return int(x["id"]))
		bot._wear_ups(sim)
		_check(sim.equipped["Armour"] == up and sim.floor_items().has(work) and m["found"].map(func(x): return int(x["id"])) == ids0, "the bot didn't take the floor's %s by the swap: worn %s, the jacket down %s" % [up["base"], sim.equipped["Armour"]["base"], str(sim.floor_items().has(work))])
	# a head's unique lands on the floor like any find: no spot of its own past the pack's cells
	m["boss"] = {"name": "The Gamekeeper", "zone": 0, "alive": true, "hp": 1.0, "started": true}
	var on_floor0: int = sim.floor_items().filter(func(x): return x.has("unique")).size()
	var in_pack0: int = m["found"].filter(func(x): return x.has("unique")).size()
	var strapped0: int = m["found"].filter(func(x): return x.get("strapped", false)).size()
	sim._boss_down(m, sim.effective(2))
	var keeper_ids: Array = sim.floor_items().filter(func(x): return x.has("unique")).map(func(x): return int(x["id"]))
	_check(sim.floor_items().filter(func(x): return x.has("unique")).size() > on_floor0 and m["found"].filter(func(x): return x.has("unique")).size() == in_pack0 and m["found"].filter(func(x): return x.get("strapped", false)).size() == strapped0,
		"the Keeper's unique didn't land on the floor: %d down, %d in the pack, %d strapped" % [sim.floor_items().filter(func(x): return x.has("unique")).size() - on_floor0, m["found"].filter(func(x): return x.has("unique")).size() - in_pack0, m["found"].filter(func(x): return x.get("strapped", false)).size() - strapped0])
	# left down and Get out now: a head's drop still comes home, as it did (the review); a pinnacle's too
	m["remaining"] = 0
	m["cleared"] = true
	sim.get_out()
	if sim.on_mission():
		sim.extract_now()
	_check(not keeper_ids.is_empty() and keeper_ids.all(func(i): return sim.stash.any(func(x): return int(x["id"]) == i)), "the Keeper's unique left on the floor didn't come home: %s" % str(keeper_ids))
	sim.hp = sim.max_hp()
	sim.deploy(3)
	if sim.on_mission():
		var mm: Dictionary = sim.mission
		mm["floor"] = []
		sim.order_beaten["grid"] = 0
		sim._order_down(mm, mm["t"], {"order": "grid", "name": Data.pinnacle("grid")["who"]})
		var p_ids: Array = mm["floor"].filter(func(x): return x.has("unique")).map(func(x): return int(x["id"]))
		mm["remaining"] = 0
		mm["cleared"] = true
		sim.get_out()
		if sim.on_mission():
			sim.extract_now()
		_check(not p_ids.is_empty() and p_ids.all(func(i): return sim.stash.any(func(x): return int(x["id"]) == i)), "the Lineman's unique left on the floor didn't come home: %s" % str(p_ids))
	if sim.on_mission():
		sim.extract_now()
	sim.loot_by_hand = by_hand_was
	sim.load_dict(saved)
	main.refresh()
	print("floor wear ok: Equip off the floor, the old piece down, a bag's and a rig's overflow down and said, the head's unique on the floor, the bot's swap, the save")


## Pick-A (Matt, 6 Oct): the pick and the fitted laid the same on the run and in the Lock-up; a price tag, no fence
## line, no ditched line; Equip and Ditch on a run (what comes off goes into the pack); no Sell in the Lock-up.
func _pick_panel_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	# on a run: an armour in the pack against the one worn; Equip swaps them; the pack must hold what comes off
	var worn: Dictionary = sim._plain("Armour", "Riot suit")
	sim.equipped["Armour"] = worn
	sim.equipped["Backpack"] = sim._plain("Backpack", "School bag")     # twelve cells: the leathers and the suit's three more; the start's bag has nine
	sim.deploy(3)
	var m: Dictionary = sim.mission
	var found: Dictionary = sim._plain("Armour", "Motorbike leathers")
	found["rarity"] = 2
	found["affixes"] = [{"stat": "poison_res", "value": 7, "tier": 1}, {"stat": "armour", "value": 3, "tier": 1}]
	m["found"] = [found]
	main.show_room(main.MISSIONS)
	main.refresh()
	main._run._inv._pick(main._run._inv.cell_of(found["id"]))
	main.refresh()
	var pk = main._run._pick
	_check(pk._heads[0].visible and pk._heads[1].visible and pk._heads[0]._title.text == "Motorbike leathers" and pk._heads[1]._title.text == "Riot suit", "the run's pick does not lay the pick and the fitted side by side: %s / %s" % [pk._heads[0]._title.text, pk._heads[1]._title.text])
	# one form for the affix chips, side by side (16 Oct, Matt: "res not resistance"): the short always, even with room;
	# a proof names both its halves; nothing reads "resist"
	var lone = load("res://scripts/ui/item_head.gd").new(440)
	main.add_child(lone)
	var roomy: Dictionary = sim._plain("Helmet", "Hard hat")
	roomy["rarity"] = 2
	roomy["affixes"] = [{"stat": "fire_proofed", "value": 8, "tier": 2}, {"stat": "bleed_res", "value": 9, "tier": 1}]
	lone.show_item(roomy, sim)
	var chip_words: Array = []
	for h in [pk._heads[0], lone]:
		for l in h._affixes.text_nodes():
			chip_words.append(str(l.text))
	var joined: String = " | ".join(chip_words)
	lone.queue_free()
	_check(not joined.contains("resist") and joined.contains("poison res") and joined.contains("bleed res") and joined.contains("fire res & dmg"), "the affix chips side by side aren't one short form: %s" % joined)
	# the flavour on the foot, always (18 Oct, Matt: it moved between the column and the foot, and a hint pushed it off):
	# left of the buttons, inside the panel, whole sentences (under a verdict its one row keeps the sentences that fit);
	# with no verdict, wrapped to the foot's two rows when it needs them
	var said: String = Words.item_words("Motorbike leathers")
	var fl: Label = pk._words
	var edge: float = pk._foot_left_edge()
	_check(said == "" or (fl.visible and fl.text != "" and said.begins_with(fl.text) and fl.text.ends_with(".") and fl.position.y >= pk.foot_y and fl.position.x + fl.size.x <= edge + 0.5 and fl.position.y + fl.size.y <= pk.h + 0.5 and (fl.autowrap_mode != TextServer.AUTOWRAP_OFF or UI.text_width(fl, fl.text) <= fl.size.x)),
		"the pick's flavour isn't whole on the foot: '%s' at %s (edge %.0f)" % [fl.text, str(Rect2(fl.position, fl.size)), edge])
	# and wrapped, every row of it shows (17 Oct, Matt's shot: the blank-firer's two rows cut to "It fires...") - and a
	# hint never takes its place: it's a chip at the front of the tail
	var knife_was = sim.equipped["Secondary"]
	sim.equipped["Secondary"] = sim._plain("Secondary", "Knife")
	var blank: Dictionary = sim._plain("Secondary", "Converted blank-firer")
	blank["affixes"] = [{"stat": "damage_low_pct", "value": 8, "tier": 1}]
	sim.stash_put(blank)
	pk.show_pick(blank, sim, "The pick · in the stash")
	pk.show_fitted(sim.equipped["Secondary"], sim)
	pk.set_hint_options(["No rounds for it in the rig"])
	var bl: Label = pk._words
	var bw: String = Words.item_words("Converted blank-firer")
	var whole: bool = bl.visible and (bl.text == bw or bw.begins_with(bl.text)) and (bl.autowrap_mode == TextServer.AUTOWRAP_OFF or bl.get_visible_line_count() >= bl.get_line_count())
	_check(whole and bl.position.y >= pk.foot_y and bl.position.y + bl.size.y <= pk.h + 0.5, "the blank-firer's flavour isn't whole on the foot: '%s', %d of %d rows show, %s" % [bl.text, bl.get_visible_line_count(), bl.get_line_count(), str(Rect2(bl.position, bl.size))])
	_check(pk.hint_text() == "No rounds for it in the rig" and bl.text != pk.hint_text(), "the hint isn't a chip in the tail: '%s' / foot '%s'" % [pk.hint_text(), bl.text])
	pk.set_hint_options([])
	_check(pk.hint_text() == "", "the hint chip stayed after the hint went")
	# a hint too long beside the tail still shows, alone, inside the head (the review: the Workshop's refusals)
	var long_why: String = "The %s has no magazine mount" % "police marksman's rifle"
	pk.set_hint_options([long_why, "No magazine mount", "Doesn't fit"])
	var tc = pk._heads[0]._tail_chips
	_check(pk.hint_text() != "" and tc.used_rect().size.x <= pk._heads[0].width + 0.5, "a long hint vanished or left the head: '%s', %.0f of %.0f" % [pk.hint_text(), tc.used_rect().size.x, pk._heads[0].width])
	pk.show_pick(blank, sim, "The pick · in the stash")
	_check(pk.hint_text() == "", "the next pick kept the last one's hint")
	sim.stash.erase(blank)
	sim.equipped["Secondary"] = knife_was
	main._run._shown = ""
	# the run repaints its pick from the pack's selection, still the leathers, for what follows
	main.refresh()
	# rounds lead with how many, the grade a chip; a gun's tail is chips
	var slugs_it: Dictionary = sim._plain(Data.AMMO, "Slugs")
	var lone2 = load("res://scripts/ui/item_head.gd").new(440)
	main.add_child(lone2)
	lone2.show_item(slugs_it, sim, "feeds the shotgun")
	var tw: Array = lone2._tail_chips.text_nodes().map(func(l): return str(l.text))
	_check(lone2._figure.text == str(int(slugs_it["rounds"])) and lone2._unit.text == "rounds" and tw.any(func(t): return t.begins_with("+") and t.contains("%")), "special rounds aren't led by their count, the bonus a chip: '%s %s' / %s" % [lone2._figure.text, lone2._unit.text, str(tw)])
	var gun_it: Dictionary = sim._plain("Primary", _base_of_type("shotgun"))
	lone2.show_item(gun_it, sim, ["fits nothing", "shells, 40 in the rig"])
	_check(lone2._tail_chips.visible and not lone2._tail.visible and lone2._tail_chips.text_nodes().size() >= 2, "a gun's tail isn't chips: %s" % str(lone2._tail_chips.text_nodes().map(func(l): return l.text)))
	lone2.queue_free()
	_check(pk._kickers[0].text == "THE PICK · IN THE PACK · %d CELLS" % Items.size(found) and pk._kickers[1].text == "FITTED NOW · %d CELLS" % Items.size(worn), "the kickers are off: '%s' / '%s'" % [pk._kickers[0].text, pk._kickers[1].text])
	_check(pk._tag_labels[0].text == Fmt.money(sim.sell_price(found)) and pk._tag_labels[1].text == Fmt.money(sim.sell_price(worn)), "the price tags are off: %s / %s" % [pk._tag_labels[0].text, pk._tag_labels[1].text])
	_check(pk._verdict.visible and pk._verdict.text.begins_with("▼ Downgrade") and pk._deltas[0].visible and pk._deltas[0].text.begins_with("▼"), "the verdict and deltas are off: '%s' / '%s'" % [pk._verdict.text, pk._deltas[0].text])
	_check(pk.button_texts() == ["Equip", "Ditch"] and not pk._buttons[0].disabled, "the run's buttons are not Equip and Ditch: %s" % str(pk.button_texts()))
	_check(not pk.text_nodes().any(func(l): return l.text.begins_with("The Fence pays") or l.text.begins_with("Ditched")), "the Fence line or the ditched line is still there")
	_check_fit(main, "Run (Pick-A)")
	pk.press(0)
	main.refresh()
	_check(sim.equipped["Armour"]["id"] == found["id"] and m["found"].size() == 1 and m["found"][0]["id"] == worn["id"], "Equip on a run did not swap the worn piece into the pack")
	# no room for what comes off (the riot suit back on, three cells bigger than the vest found): Equip greyed, the hint says so
	sim.equipped["Armour"] = worn
	var small: Dictionary = sim._plain("Armour", "Stab vest")
	m["found"] = [small]
	while sim.pack_used(m) + (Items.size(worn) - Items.size(small)) <= sim.capacity():
		m["found"].append(sim._plain(Data.AMMO, "Nails"))
	main.refresh()
	main._run._inv._pick(main._run._inv.cell_of(small["id"]))
	main.refresh()
	# (1 Nov, Matt's playtest: never blocked for room) Equip stays live, the hint says the suit goes down, and it does
	_check(not pk._buttons[0].disabled and pk.hint_text() == "Your riot suit goes to the floor" and not pk.hint_text().contains("No room"), "a full pack greyed Equip or the hint isn't the floor's: '%s', disabled %s" % [pk.hint_text(), str(pk._buttons[0].disabled)])
	_check_fit(main, "Run (Pick-A, no room)")
	var used_was: int = sim.pack_used(m) - Items.size(small)
	pk.press(0)
	main.refresh()
	_check(sim.equipped["Armour"]["id"] == small["id"] and sim.floor_items().has(worn) and not m["found"].has(worn) and sim.pack_used(m) == used_was, "Equip from a full pack didn't put the riot suit on the floor: worn %s, floor %s, %d cells (was %d)" % [sim.equipped["Armour"]["base"], str(sim.floor_items().map(func(x): return x["base"])), sim.pack_used(m), used_was])
	# a smaller backpack found: Equip only when what's carried still fits in it
	var worn_pack = sim.equipped["Backpack"]
	var big_pack: Dictionary = sim._plain("Backpack", Data.BASES["Backpack"].back()["name"])
	sim.equipped["Backpack"] = big_pack
	var small_pack: Dictionary = sim._plain("Backpack", "School bag")     # the smallest found pack; the start is under it
	m["found"] = [small_pack]
	while sim.pack_used(m) + Items.size(big_pack) + 1 <= sim.capacity():
		m["found"].append(sim._plain(Data.AMMO, "Nails"))
	# (1 Nov) it goes on all the same: what it can't hold is said first, then goes down
	var spill_n: int = sim.wear_preview(small_pack["id"])["spill"].size() + (1 if sim.wear_preview(small_pack["id"])["off"] != null else 0)
	_check(sim.can_equip_from_pack(small_pack["id"]) and spill_n > 0, "a smaller backpack over a pack it cannot hold: refused, or nothing said to go down (%d)" % spill_n)
	var floor_was: int = sim.floor_items().size()
	_check(sim.equip_from_pack(small_pack["id"]) and sim.floor_items().size() == floor_was + spill_n and m["found"].all(func(x): return x.has("pos") and not x.get("strapped", false)), "the smaller bag's overflow didn't go to the floor as said: %d down, %d said" % [sim.floor_items().size() - floor_was, spill_n])
	sim.equipped["Backpack"] = big_pack
	m["found"] = [small_pack]
	_check(sim.can_equip_from_pack(small_pack["id"]), "a smaller backpack with room could not go on")
	sim.equipped["Backpack"] = worn_pack
	sim.extract_now()
	sim.load_dict(saved)
	# the Lock-up: the same frame, no Sell anywhere
	sim.equipped["Armour"] = sim._plain("Armour", "Riot suit")
	var in_stash: Dictionary = sim._plain("Armour", "Motorbike leathers")
	sim.stash.append(in_stash)
	main.show_room(main.ARMOURY)
	main._armoury._inv._set_kind(0)
	main.refresh()
	main._armoury._pick_cell(main._armoury._inv.cell_of(in_stash["id"]))
	main.refresh()
	var lk = main._armoury._pick
	_check(lk._heads[0].visible and lk._heads[1].visible and lk._heads[1]._title.text == "Riot suit" and lk._kickers[0].text.begins_with("THE PICK · IN THE STASH"), "the Lock-up's pick is not the same frame: %s / '%s'" % [lk._heads[1]._title.text, lk._kickers[0].text])
	_check(not lk.button_texts().any(func(t): return t.begins_with("Sell")), "Sell is still in the Lock-up: %s" % str(lk.button_texts()))
	_check(lk._verdict.visible and lk._tag_labels[0].visible, "the Lock-up's verdict or price tag is missing")
	_check_fit(main, "Lock-up (Pick-A)")
	sim.stash.erase(in_stash)
	sim.load_dict(saved)
	main.refresh()
	print("Pick-A ok: the two columns, the tags, the verdict, Equip and Ditch on a run, the swap, no room, the Lock-up without Sell")


## 31: the works' rules, now picks (9 Oct): the Generator's Battery, the Lookout's Hold fire, the Kennel's Fetch.
func _top_works_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	_check(not Data.yard_where("battery").is_empty() and not Data.yard_where("hold_fire").is_empty() and not Data.yard_where("fetch").is_empty(), "a work's rule is not a pick")
	# the generator: a second row of pouches, never past the cap
	var hold_rig = sim.equipped["Rig"]
	var big: Dictionary = sim._plain("Rig", Data.BASES["Rig"].back()["name"])
	big["affixes"] = [{"stat": "med_cap", "value": 3, "tier": 5}]
	sim.equipped["Rig"] = big
	_yard_ids(sim, ["jerry_can", "rig_wiring"], "jerry_can")
	_yard_ids(sim, ["battery", "kickback"], "")
	var before: int = sim.med_capacity()
	_yard_ids(sim, ["battery", "kickback"], "battery")
	_check(before > 0 and sim.med_capacity() == mini(before + Data.RIG_ROW, Data.RIG_CAP) and sim.med_capacity() > before, "the Battery's row reads %d from %d" % [sim.med_capacity(), before])
	_yard_ids(sim, ["jerry_can", "rig_wiring"], "rig_wiring")
	_check(sim.med_capacity() == mini(before + Data.RIG_ROW + 4, Data.RIG_CAP), "Rig wiring's pouches are off: %d" % sim.med_capacity())
	# past the cap it clips, and the run's rig and the Lock-up's rig hold the cap: the run's two rows in the one row's height
	sim.rig = []
	var pouches: int = sim.med_capacity()
	var two: Dictionary = {}
	for b in Data.BASES[Data.MEDICAL]:
		if Items.size(sim._plain(Data.MEDICAL, b["name"])) == 2:
			two = b
	while sim.rig_used() < pouches:
		var kit: Dictionary = sim._plain(Data.MEDICAL, two["name"]) if (not two.is_empty() and sim.rig_used() + 2 <= pouches and sim.rig.size() % 3 == 0) else sim._plain(Data.MEDICAL, Data.BASES[Data.MEDICAL][0]["name"])
		sim.rig.append(kit)
	_check(main._run.RIG_MAX >= Data.RIG_CAP and main._armoury._containers.RIG_MAX >= Data.RIG_CAP, "a rig display clips under the sim's cap")
	var mode_was: String = sim.top_up_mode
	sim.set_top_up("leave")                   # the fixture's rig as built: the gate would trade spare heals for magazines now (30 Oct)
	sim.deploy(3)
	main.show_room(main.MISSIONS)
	main.refresh()
	var right_edge := 0.0
	var bottom := 0.0
	for c in main._run._rig_cells:
		if c.visible:
			right_edge = maxf(right_edge, c.position.x + c.size.x)
			bottom = maxf(bottom, c.position.y + c.size.y)
	_check(right_edge <= main._run.PAD + main._run.INNER + 0.5 and bottom <= main._run.RIG_Y + main._run.RIG_ROOM + 0.5, "the run's rig of %d spills: to x %.0f, y %.0f" % [pouches, right_edge, bottom])
	var all_on: Array = _u51_rig_pages_on(main._run)      # every page's (BUILD51-U: the rig pages as the floor does)
	var cells_on: int = int(all_on[0])
	var outlines_on: int = int(all_on[1])
	_check(cells_on == sim.rig.size() and outlines_on == 0, "a full rig of kits and meds shows %d of %d items and %d free pouches" % [cells_on, sim.rig.size(), outlines_on])
	_check_fit(main, "Run (a full rig)")
	sim.set_top_up(mode_was)
	# a kit at a row's end (12 Oct, Matt's playtest): singles to one short of the row, the kit, singles to full - every
	# item shows and no pouch reads empty
	if not two.is_empty():
		var per_row: int = maxi(1, ceili(float(mini(main._run.RIG_MAX, pouches)) / (1 if pouches <= 12 else 2)))
		sim.rig = []
		for i in range(per_row - 1):
			sim.rig.append(sim._plain(Data.MEDICAL, Data.BASES[Data.MEDICAL][0]["name"]))
		sim.rig.append(sim._plain(Data.MEDICAL, two["name"]))
		while sim.rig_used() < pouches:
			sim.rig.append(sim._plain(Data.MEDICAL, Data.BASES[Data.MEDICAL][0]["name"]))
		main.refresh()
		all_on = _u51_rig_pages_on(main._run)                # every page's (BUILD51-U)
		cells_on = int(all_on[0])
		outlines_on = int(all_on[1])
		_check(cells_on == sim.rig.size() and outlines_on == 0, "a kit at the row's end: %d of %d items show, %d pouches read empty" % [cells_on, sim.rig.size(), outlines_on])
	sim.extract_now()
	main.show_room(main.ARMOURY)
	main.refresh()
	_check_fit(main, "Lock-up (a full rig)")
	sim.rig = []
	sim.equipped["Rig"] = hold_rig
	# the lookout: the first gang after the clear waits for a full pack; a second gang does not
	_yard_ids(sim, ["hold_fire", "tripwires"], "hold_fire")
	sim.deploy(3)
	var m: Dictionary = sim.mission
	m["remaining"] = 0
	m["cleared"] = true
	m["found"] = []
	m["patrol_timer"] = 0.0
	sim.advance(5.0)
	_check(sim.on_mission() and m["patrols"] == 0 and m["patrol_timer"] == 0.0, "the first gang's clock ran before the call: %.1f" % m["patrol_timer"])
	main.show_room(main.MISSIONS)
	main.refresh()
	_check(main._run._fight["tiles"][0]["value"].text in ["held off", "held"], "the Next gang tile does not say on the call: '%s'" % main._run._fight["tiles"][0]["value"].text)
	_check_fit(main, "Run (on the call)")
	while sim.pack_used(m) < sim.capacity():
		m["found"].append(sim._plain(Data.AMMO, "Nails"))
	sim.advance(5.0)
	_check(m["patrol_timer"] > 0.0 or m["patrols"] >= 1, "the full pack did not call the first gang")
	m["patrols"] = 1
	m["found"] = []
	m["patrol_timer"] = 0.0
	sim.advance(5.0)
	_check(m["patrol_timer"] > 0.0 or m["patrols"] >= 2, "the second gang waited for the call too")
	sim.extract_now()
	# the kennel: the best thing in the pack comes home with the dog on a death
	_yard_ids(sim, ["fetch", "second_dog"], "fetch")
	sim.deploy(3)
	m = sim.mission
	var cheap: Dictionary = sim._plain(Data.AMMO, "Nails")
	var dear: Dictionary = sim._plain("Armour", Data.BASES["Armour"].back()["name"])
	m["found"] = [cheap, dear]
	var stash_before: int = sim.stash.size()
	sim.hp = 0.0
	sim._kia()
	_check(sim.stash.size() == stash_before + 1 and sim.stash.back()["id"] == dear["id"] and sim.last_report.get("carried", "") != "" and int(sim.last_report["left"]) == 1, "the dog did not carry the best thing home")
	# the deeds carried home are held all the same
	sim.load_dict(saved)
	_yard_ids(sim, ["fetch", "second_dog"], "fetch")
	var hold_ending: String = sim.deeds_fate
	sim.deeds_fate = ""
	sim.deploy(3)
	m = sim.mission
	var deeds: Dictionary = sim._plain(Data.PAPER, "The deeds")
	deeds["deeds"] = true
	m["found"] = [deeds]
	sim.hp = 0.0
	sim._kia()
	_check(sim.deeds_fate == "held" and sim.stash.back().get("deeds", false), "the deeds carried home were not held: '%s'" % sim.deeds_fate)
	sim.deeds_fate = hold_ending
	# the works card reads the rules and fits
	main.show_room(main.OVERVIEW)
	main.refresh()
	_check_fit(main, "Yard (the works' top levels)")
	sim.load_dict(saved)
	main.refresh()
	print("the works' rules ok: the Battery's row, Hold fire, Fetch")


## What's on them and on you as chips (Matt, 6 Oct): "On them" under their bar, "On you" in place of the runner's note.
func _dots_chip_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.deploy(3)
	var m: Dictionary = sim.mission
	m["remaining"] = 3
	m["target_hp"] = 1e9
	m["dots"] = {"fire": 20.0, "poison": 20.0}
	m["chill_t"] = 1.0
	m["shock_t"] = 1.0
	m["my_dots"] = {"poison": 20.0, "bleed": 20.0}
	main.show_room(main.MISSIONS)
	main.refresh()
	var rn = main._run
	_check(rn._fight["chips"].visible and rn._fight["chips"].shown() == 4 and rn._fight["chips"].words(0) == "Burning" and rn._fight["chips"].words(2) == "Chilled" and rn._fight["chips"].words(3) == "Shocked", "On them reads %d chips: %s" % [rn._fight["chips"].shown(), rn._fight["chips"].words(0)])
	_check(rn._runner["chips"].visible and not rn._runner["note"].visible and rn._runner["chips"].shown() == 2 and rn._runner["chips"].words(0) == "Poisoned" and rn._runner["chips"].words(1) == "Bleeding", "On you reads %d chips" % rn._runner["chips"].shown())
	_check(rn._fight["chips"].position.y + Chips.CHIP_H <= rn._fight["box"].position.y + rn._fight["box"].size.y and rn._runner["chips"].position.y + Chips.CHIP_H <= rn._runner["box"].position.y + rn._runner["box"].size.y, "the chips sit out of their boxes")
	_check_fit(main, "Run (on them, on you)")
	# the dots' pools are the end of the bar (Matt, 6 Oct): what fire and poison still have to take off them sits at the
	# fill's end in their colours, so the fill goes down into it; yours the same for what's on you
	var of_hp: float = float(m["t"]["hp"])
	m["target_hp"] = of_hp * 0.5
	m["dots"] = {"fire": of_hp * 0.1, "poison": of_hp * 0.2}
	m["my_dots"] = {"poison": sim.max_hp() * 0.1, "bleed": sim.max_hp() * 0.6}
	sim.hp = sim.max_hp() * 0.5
	main.refresh()
	var segs: Array = rn._fight["segments"]
	var fire_i: int = Data.TYPES.find("fire")
	var poison_i: int = Data.TYPES.find("poison")
	var bleed_i: int = Data.TYPES.find("bleed")
	var fill_px: float = rn._fight["fill"].size.x
	_check(segs[fire_i].visible and segs[poison_i].visible and absf(segs[fire_i].size.x - float(rn._fight["w"]) * 0.1) <= 1.5 and absf(segs[poison_i].size.x - float(rn._fight["w"]) * 0.2) <= 1.5, "their bar's end is not the dots' pools: fire %.0f, poison %.0f" % [segs[fire_i].size.x, segs[poison_i].size.x])
	_check(absf(segs[fire_i].position.x + segs[fire_i].size.x - fill_px) <= 0.5 and absf(segs[poison_i].position.x + segs[poison_i].size.x - segs[fire_i].position.x) <= 0.5, "the pools do not sit at the fill's end, in a row")
	var ysegs: Array = rn._runner["segments"]
	var yfill: float = rn._runner["fill"].size.x
	_check(ysegs[poison_i].visible and ysegs[bleed_i].visible and absf(ysegs[poison_i].size.x - float(rn._runner["w"]) * 0.1) <= 1.5 and absf(ysegs[bleed_i].size.x - (yfill - ysegs[poison_i].size.x)) <= 1.5 and ysegs[bleed_i].position.x >= -0.5, "a pool past the fill's left end is not cut to it: poison %.0f, bleed %.0f of a %.0f fill" % [ysegs[poison_i].size.x, ysegs[bleed_i].size.x, yfill])
	m["dots"] = {}
	m["my_dots"] = {}
	main.refresh()
	_check(not segs[fire_i].visible and not ysegs[bleed_i].visible, "the pools did not clear with the dots")
	m["dots"] = {"fire": 20.0, "poison": 20.0}
	m["my_dots"] = {"poison": 20.0, "bleed": 20.0}
	main.refresh()
	# a med in use rides beside the chips as a muted one; nothing on you brings the note back
	m["using"] = {"name": "Bandage", "heal": 10.0, "left": 4.0}      # a med in use, by hand: the chip beside what's on you
	main.refresh()
	_check(rn._runner["chips"].shown() == 3 and rn._runner["chips"].words(2).contains(" s"), "the med in use is not a chip beside what's on you: %d" % rn._runner["chips"].shown())
	_check_fit(main, "Run (on you, med)")
	m["my_dots"] = {}
	main.refresh()
	_check(rn._runner["chips"].visible and rn._runner["chips"].shown() == 1 and not rn._runner["note"].visible, "the med in use alone is not a chip: %d" % rn._runner["chips"].shown())
	m["my_dots"] = {"poison": 20.0, "bleed": 20.0}
	m["using"] = null
	# no one left to be on: the row goes even with dots in the record
	m["remaining"] = 0
	main.refresh()
	_check(not rn._fight["chips"].visible, "On them shows with no one there")
	m["remaining"] = 3
	m["my_dots"] = {}
	m["dots"] = {}
	m["chill_t"] = 0.0
	m["shock_t"] = 0.0
	main.refresh()
	_check(not rn._fight["chips"].visible and not rn._fight["key"].visible and not rn._runner["note"].visible and not rn._runner["chips"].visible, "the chips did not clear with nothing on anyone (the line is the chips' alone)")
	_check_fit(main, "Run (nothing on anyone)")
	sim.extract_now()
	sim.load_dict(saved)
	main.refresh()
	print("the dots as chips ok: on them, on you, the med beside them, cleared")


## 30: wounds (stacked, 19 Oct: Matt's Clinic A). A hit that takes the runner under a third leaves a wound, one a run, to
## an area not yet hurt - the head's cuts the max HP, the chest's the armour, the legs' the pace - three at most, a
## fourth bad run adding nothing; the Clinic treats each, or the lot; the run, the Pitch and the Clinic say so; the
## save keeps them; they go with the runner.
func _wound_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.wounds = {}
	# the hit under a third wounds; one already under it does not
	sim.deploy(3)
	var m: Dictionary = sim.mission
	var pace0: float = sim.pace()          # on the mission: armour counts the pack's free cells
	var arm0: float = sim.armour()
	var hp0: float = sim.max_hp()
	m["remaining"] = 6
	m["target_hp"] = 1e9
	sim.hp = sim.max_hp() * Data.WOUND_AT - 0.01
	sim.advance(1.0)
	_check(sim.wounds.is_empty(), "a hit already under the third wounded")
	_check(sim.on_mission(), "the runner died under the first wound check")
	if not sim.on_mission():
		sim.load_dict(saved)
		return
	# through the fight itself: a hair over, their fire takes the runner under it
	sim.hp = sim.max_hp() * Data.WOUND_AT + 0.01
	var hp_in: float = sim.hp
	sim.advance(1.0)
	var through_the_fight: bool = sim.hp < hp_in and sim.hp > 0.0
	if through_the_fight:
		_check(sim.wounds.size() == 1 and m.get("wounded", false), "the hit under a third did not wound: %s" % str(sim.wounds))
	else:
		sim._wound(m)                     # nothing landed at this tier (or it killed them): the wound by hand, the rest still checked
	_check(sim.on_mission(), "the runner died under the wound check")
	if not sim.on_mission():
		sim.load_dict(saved)
		return
	var area: String = sim.wounds.keys()[0]
	var cut: String = str(sim.wounds[area]["stat"])
	_check(cut == str(Data.WOUND_AREA[area]["stat"]) and str(sim.wounds[area]["from"]) == str(Data.TIERS[3]["name"]) and str(sim.wounds[area]["what"]) != "", "the wound's record is off: %s" % str(sim.wounds[area]))
	var now: Dictionary = {"pace": sim.pace(), "armour": sim.armour(), "hp": sim.max_hp()}
	var was: Dictionary = {"pace": pace0, "armour": arm0, "hp": hp0}
	for st in Data.WOUND_STATS:
		if st == cut:
			_check(is_equal_approx(now[st], was[st] * (1.0 - Data.WOUND_PCT / 100.0)), "the wound did not cut %s: %.2f from %.2f" % [st, now[st], was[st]])
		else:
			_check(is_equal_approx(now[st], was[st]), "the wound cut %s too: %.2f from %.2f" % [st, now[st], was[st]])
	# one a run: the same run takes no second
	sim._wound(m)
	_check(sim.wounds.size() == 1, "a run left two wounds: %s" % str(sim.wounds))
	# the run says so and fits
	main.show_room(main.MISSIONS)
	main.refresh()
	_check(main._run._runner["head"].text.begins_with("THE RUNNER · WOUNDED:"), "the run's runner head does not say wounded: '%s'" % main._run._runner["head"].text)
	_check_fit(main, "Run (wounded)")
	sim.extract_now()
	_check(sim.last_report.get("wounded", false), "the report does not carry the wound")
	# stacking: three runs, three areas, every stat a tenth; a fourth adds nothing and says so
	for k in range(3):
		sim._wound({"wounded": false, "tier": 5})
	_check(sim.wounds.size() == 3 and Data.WOUND_AREAS.all(func(a): return sim.wounds.has(a)), "three bad runs didn't leave the three areas: %s" % str(sim.wounds.keys()))
	_check(str(sim.events.back()[1]) == Words.WOUNDS["full"], "the fourth didn't say there's nowhere left: '%s'" % str(sim.events.back()[1]))
	for st in Data.WOUND_STATS:
		_check(is_equal_approx(sim.wound_mult(st), 1.0 - Data.WOUND_PCT / 100.0), "three wounds don't cut %s a tenth: %.3f" % [st, sim.wound_mult(st)])
	_check(sim.wound_words().begins_with("3 wounds:"), "three wounds in words: '%s'" % sim.wound_words())
	# the Runner room's card says so
	main.show_room(main.RUNNER)
	main.refresh()
	var wound_chips: Array = _chip_texts(main._stats.cards["runner"]["chips"])
	_check(not wound_chips.is_empty() and str(wound_chips[0]).begins_with("3 wounds:"), "the sheet does not carry the wounds chip: %s" % str(wound_chips))
	_check_fit(main, "Stats (wounded)")
	# the Clinic: a row a wound with its Treat, the body marked, Treat everything the lot
	sim.hp = sim.max_hp() * 0.5
	sim.cash += 50000.0
	var lv: int = sim.level()
	var each: int = int(ceil(Data.WOUND_CASH * lv * sim.inflation() * maxf(0.2, 1.0 - sim.tree_sum("treat_pct") / 100.0)))
	_check(sim.wound_cost("legs") == each and sim.wound_cost() == 3 * each and sim.treat_cost() == sim.heal_cost() + 3 * each, "the wounds' prices: one %d (want %d), all %d, with the HP %d" % [sim.wound_cost("legs"), each, sim.wound_cost(), sim.treat_cost()])
	main.show_room(main.MEDIC)
	main._clinic._shown = ""
	main.refresh()
	var body = main._clinic._body
	_check(main._clinic._band.unit.text.contains("3 wounds") and main._clinic._band.chips.visible, "the Clinic's band does not say 3 wounds: '%s'" % main._clinic._band.unit.text)
	_check(body._head.text == "THE RUNNER · 3 OF 3 WOUNDS" and body._marks.size() == 3, "the body's head or its marks: '%s', %d" % [body._head.text, body._marks.size()])
	for a in Data.WOUND_AREAS:
		var r: Dictionary = body.row(a)
		_check(r["treat"].visible and not r["treat"].disabled and r["treat"].text.begins_with("Treat") and r["effect"].text.begins_with("−"), "the %s's row is off: '%s' / '%s'" % [a, r["treat"].text, r["effect"].text])
	_check(body._all.text.begins_with("Treat everything") and not body._all.disabled, "Treat everything reads '%s'" % body._all.text)
	_check_fit(main, "Clinic (three wounds)")
	# the runner's own drawing, the Kit's (19 Oct, Matt): every wound's mark on it, inside the box
	var BodyV := preload("res://scripts/ui/body.gd")
	var want_fig: String = BodyV.figure_for(str(sim.cls))
	_check((body._figure.texture != null) == (want_fig != ""), "the Clinic's figure is %s with %s for a %s" % [str(body._figure.texture), want_fig, sim.cls])
	var fr: Rect2 = body.figure_rect()
	for a in Data.WOUND_AREAS:
		var at: Vector2 = body.mark_at(a)
		_check(fr.grow(1.0).has_point(at) and Rect2(Vector2.ZERO, Vector2(body.BODY_W, body.BODY_H)).encloses(fr.grow(-0.5)), "the %s's mark sits off the figure: %s in %s" % [a, str(at), str(fr)])
	var hy: float = body.mark_at("head").y
	_check(hy < body.mark_at("chest").y and body.mark_at("chest").y < body.mark_at("legs").y, "the marks are out of order down the body")
	# one treated by its row: that one gone, the rest kept, its price paid
	var cash0: float = sim.cash
	body.row("chest")["treat"].pressed.emit()
	main.refresh()
	_check(not sim.wounds.has("chest") and sim.wounds.size() == 2 and is_equal_approx(cash0 - sim.cash, float(each)), "the chest's Treat: %s left, %.0f paid" % [str(sim.wounds.keys()), cash0 - sim.cash])
	_check(not body.row("chest")["treat"].visible and body.row("chest")["empty"].text == "Chest · Nothing", "the chest's row after: '%s'" % body.row("chest")["empty"].text)
	_check_fit(main, "Clinic (two wounds)")
	# the lot: the HP and both wounds
	cash0 = sim.cash
	var lot: int = sim.treat_cost()
	body._all.pressed.emit()
	main.refresh()
	_check(sim.wounds.is_empty() and sim.hp >= sim.max_hp() - 0.5 and is_equal_approx(cash0 - sim.cash, float(lot)), "Treat everything left %s, HP %.0f of %.0f, %.0f paid of %d" % [str(sim.wounds.keys()), sim.hp, sim.max_hp(), cash0 - sim.cash, lot])
	_check(body._all.text == "Fit for duty" and body._all.disabled, "after the lot the button reads '%s'" % body._all.text)
	# one wound at full HP: the button names it
	sim._wound({"wounded": false, "tier": 5})
	main.refresh()
	var one: String = sim.wounds.keys()[0]
	_check(body._all.text.begins_with("Treat the %s" % str(Data.WOUND_AREA[one]["name"]).to_lower()), "one wound at full HP: the button reads '%s'" % body._all.text)
	_check_fit(main, "Clinic (one wound)")
	# saved and loaded; gone with a dead runner
	var d: Dictionary = sim.to_dict()
	_check(d.get("wounds", {}).has(one), "the wounds are not saved")
	sim.load_dict(d)
	_check(sim.wounds.has(one) and str(sim.wounds[one]["what"]) != "", "the wounds are not loaded: %s" % str(sim.wounds))
	sim.deploy(3)
	sim.hp = 0.0
	sim._kia()
	_check(sim.wounds.is_empty(), "the wounds went on to the next runner")
	sim.load_dict(saved)
	main.refresh()
	print("wounds ok: the hit under a third, one a run, three areas at most, every stat a tenth, the run, the Pitch, the Clinic's rows and its lot, the save, the death")


## Meds as they say (19 Oct, Matt): a share of the heal every second over the med's time, stopping at full; the meds'
## cards in the Clinic say what each does.
func _med_over_time_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var s = Sim.new()
	s.start()
	s.mythics_on = false
	var bandage: Dictionary = s._plain(Data.MEDICAL, "Bandage")
	s.deploy(0)
	if not s.on_mission():
		_check(false, "the fixture: no run for the meds")
		return
	var mm: Dictionary = s.mission
	mm["t"]["dps"] = 0.0
	mm["remaining"] = 0
	s.rig = [bandage]
	s.hp = 10.0
	var t: float = s.use_time(bandage)
	var heal: float = s.med_heal(bandage)
	_check(t > 1.0 and heal > 0.0, "the fixture: the bandage takes %.1f s for %.0f" % [t, heal])
	s.use_med(bandage["id"])
	s._patch(mm, 1.0)
	_check(is_equal_approx(s.hp, 10.0 + heal / t) and mm["using"] != null, "a second in, a med healed %.1f, not %.1f (its share)" % [s.hp - 10.0, heal / t])
	s._patch(mm, t)
	_check(is_equal_approx(s.hp, minf(s.max_hp(), 10.0 + heal)) and mm["using"] == null, "the med's whole didn't land by its time: %.1f of %.1f" % [s.hp - 10.0, heal])
	# at full with nowhere for it to go, a med isn't taken (its end-of-heal work isn't free)
	s.rig = [s._plain(Data.MEDICAL, "Bandage")]
	s.hp = s.max_hp()
	var g0: float = s.guard()
	_check(not s.use_med(s.rig[0]["id"]) and s.rig.size() == 1 and mm["using"] == null and is_equal_approx(s.guard(), g0), "a med went at full HP: rig %d, using %s" % [s.rig.size(), str(mm["using"])])
	# stops at full: nearly full, it ends as the HP tops out
	s.rig = [s._plain(Data.MEDICAL, "Bandage")]
	s.hp = s.max_hp() - 1.0
	s.use_med(s.rig[0]["id"])
	s._patch(mm, t * 0.5)
	_check(s.hp >= s.max_hp() - 0.001 and mm["using"] == null and str(s.events.back()[1]).contains("stopped at full"), "a med didn't stop at full: '%s'" % str(s.events.back()[1]))
	# the Clinic's cards: what each does, a second's, where it is
	main.show_room(main.MEDIC)
	sim.stash.append(sim._plain(Data.MEDICAL, "Bandage"))
	main._clinic._show("stash")
	main.refresh()
	var mc = main._clinic._meds
	_check(mc.visible and not main._clinic._panel.visible, "the Meds tab didn't show its cards")
	var said: String = " | ".join(mc.text_nodes().map(func(l): return str(l.text)))
	var b0: Dictionary = sim._plain(Data.MEDICAL, "Bandage")
	var lines: Array = mc.med_lines(b0)
	_check(said.contains("Bandage") and said.contains(lines[0]) and said.contains(lines[1]) and said.contains("in the stash"), "the bandage's card: %s (want '%s', '%s')" % [said.left(300), lines[0], lines[1]])
	_check_fit(main, "Clinic (meds as cards)")
	main._clinic._show("shelf")
	sim.load_dict(saved)
	main.refresh()
	print("meds over time ok: a share a second, the whole by its time, stops at full, the cards")


## A fresh camp on a run for the meds' and the magazines' checks (28 Oct): nothing coming back unless a check says so,
## a gang that stands.
## The bot's wall (30 Oct, Matt: walled with a class, you switch): in the campaign, WALL_S of picks that are no step
## forward and another open class goes out - a new one when no played class reads the wall; a first clear or a head
## stops the clock; off unless asked for (the one-save reads ask).
func _wall_rule_checks() -> void:
	var w = Sim.new()
	w.start()
	if w.cls != "Poacher":
		w.set_class("Poacher")
	for i in Data.ZONES[0]["tiers"]:
		w.best_depth[i] = 1
	w.bosses_beaten[0] = true                 # the Gamekeeper down: the Paramedic open
	var bt = Bot.new()
	bt.wall_on = true
	var wall: Array = bt.wall_at(w)
	_check(int(wall[0]) == int(Data.ZONES[1]["tiers"][0]) and not bool(wall[1]), "the wall isn't the Estate's first site: %s" % str(wall))
	bt.wall_note(w, int(Data.ZONES[0]["tiers"][0]))     # a cleared site farmed: the clock runs
	w.elapsed += bt.WALL_S - 60.0
	_check(not bt.wall_check(w) and w.cls == "Poacher", "the wall swapped before its clock ran out")
	w.elapsed += 60.0
	_check(bt.wall_check(w) and w.cls == "Paramedic" and bt.walls.size() == 1 and int(bt.walls[0][1]) == int(wall[0]) and str(bt.walls[0][3]) == "Poacher",
		"walled, the open class didn't go out: %s, %s" % [w.cls, str(bt.walls)])
	# a new class grows to the walled one's level before its clock runs
	bt._wall_grace_lv = w.level() + 5         # as if the walled one were five levels on
	bt.wall_note(w, int(Data.ZONES[0]["tiers"][0]))
	_check(bt._wall_from < 0.0, "a new class out: its wall's clock ran before it grew")
	w.elapsed += bt.WALL_S * 2.0
	_check(not bt.wall_check(w) and w.cls == "Paramedic", "a new class out was walled again before it grew")
	# another played class read on a copy: the camp as it was - cash, stash, the bench's HP, the runner out
	w.roster["Poacher"]["hp"] = 10.0         # hurt on the bench, a spare the Poacher wouldn't keep, the cash to shop: what a swap on the real camp would move
	w.stash.append(w._plain(Data.AMMO, "Shells"))
	w.stash.append(w._plain("Helmet", str(Data.BASES["Helmet"][0]["name"])))
	w.cash = 50000.0
	var cash0: float = w.cash
	var stash0: int = w.stash.size()
	var pc_hp: float = float(w.roster.get("Poacher", {}).get("hp", -1.0))
	var o_p: float = bt.class_wall_odds(w, "Poacher", wall)
	_check(w.cls == "Paramedic" and is_equal_approx(w.cash, cash0) and w.stash.size() == stash0 and is_equal_approx(float(w.roster.get("Poacher", {}).get("hp", -1.0)), pc_hp) and bt.cls == "Paramedic" and o_p >= 0.0,
		"reading the Poacher at the wall moved the camp: %s out, cash %.0f -> %.0f, stash %d -> %d" % [w.cls, cash0, w.cash, stash0, w.stash.size()])
	# a first clear tried stops the clock; and off, never
	var w2 = Sim.new()
	w2.start()
	if w2.cls != "Poacher":
		w2.set_class("Poacher")
	for i in Data.ZONES[0]["tiers"]:
		w2.best_depth[i] = 1
	w2.bosses_beaten[0] = true
	var bt2 = _wall_bot()
	bt2.wall_on = true
	bt2.wall_note(w2, int(Data.ZONES[0]["tiers"][0]))
	bt2.pick = 0.5
	bt2.wall_note(w2, int(wall[0]))           # the next site tried under FIRST (a fallback pick): no step forward (the fix round)
	_check(bt2._wall_from >= 0.0, "a first clear tried under FIRST stopped the wall's clock")
	bt2.pick = 0.7
	bt2.wall_note(w2, int(wall[0]))           # at FIRST or better: a step forward
	w2.elapsed += bt2.WALL_S * 2.0
	_check(not bt2.wall_check(w2) and w2.cls == "Poacher", "a first clear tried at FIRST didn't stop the wall's clock")
	var bt3 = Bot.new()
	bt3.wall_note(w2, int(Data.ZONES[0]["tiers"][0]))
	w2.elapsed += bt3.WALL_S * 2.0
	_check(not bt3.wall_check(w2) and w2.cls == "Poacher", "the wall swapped with the rule off")
	var Sum = load("res://tools/balance_summary.gd")
	var wr: Array = Sum.walls_row([{"build": "Drifter as bleed", "one_save": true, "walls": [[3.7, 8, true, "Poacher", "Paramedic", -1.0]]}, {"build": "Doorman as bleed", "one_save": true, "walls": []}])
	_check(str(wr[2]) == "Drifter as bleed: 3.7 h head on 8, Paramedic for Poacher; Doorman as bleed: none", "the summary's walls: '%s'" % str(wr[2]))
	_wall_branch_checks()
	print("the wall ok: the clock, the swap to a new class, a step forward, off")


## The fix round's merge (30 Oct): the read's own build is spared the wall one extra clock at most; the gauntlet stamps a
## build's own guns, never buys the Issuer's over them; P6 judges the faint half alone.
func _merge30_checks() -> void:
	var w = Sim.new()
	w.start()
	if w.cls != "Poacher":
		w.set_class("Poacher")
	var b = Bot.new()
	b.target_cls = "Poacher"
	b._tgt_lv_at = w.elapsed
	var first: bool = b.target_levelling(w)
	w.elapsed += b.WALL_S * 0.5
	b._tgt_lv_at = w.elapsed                 # levelled again
	var second: bool = b.target_levelling(w)
	w.elapsed += b.WALL_S * 0.6
	b._tgt_lv_at = w.elapsed                 # and again: still levelling, but its extra clock's spent
	_check(first and second and not b.target_levelling(w), "the read's own build was spared the wall past one extra clock")
	# the gauntlet: the build's own guns stamped, the rest issued
	var Bal = load("res://tests/balance.gd")
	var g = Sim.new()
	g.start()
	if g.cls != "Poacher":
		g.set_class("Poacher")
	g.issued = true
	g.equipped["Primary"] = g._plain("Primary", "Old .303")
	g.equipped["Secondary"] = g._plain("Secondary", "Service pistol")
	var gb = Bot.new()
	Bal._gauntlet_issued(g, gb, 6)
	_check(str(g.equipped["Primary"]["base"]) == "Old .303" and bool(g.equipped["Primary"].get("stamped", false))
		and str(g.equipped["Secondary"]["base"]) == "Service pistol" and bool(g.equipped["Secondary"].get("stamped", false)),
		"the gauntlet's issued kit took the build's guns: %s, %s" % [str(g.equipped["Primary"]), str(g.equipped["Secondary"]["base"])])
	# a read of a benched class keeps its own stash tabs with it (the merge's review: _read_back dropped them)
	var t = Sim.new()
	t.start()
	if t.cls != "Poacher":
		t.set_class("Poacher")
	t.set_class("Doorman")
	t.set_class("Poacher")
	var tab_it: Dictionary = t._plain("Helmet", str(Data.BASES["Helmet"][0]["name"]))
	t.roster["Doorman"]["tab_items"] = [tab_it]
	var h_t: Dictionary = t._read_as("Doorman")
	t._read_back(h_t)
	_check(t.roster["Doorman"].get("tab_items", []).size() == 1, "a read of the benched Doorman dropped their stash tabs: %s" % str(t.roster["Doorman"].keys()))
	# P6: a full half far outside 35-65% with the faint half fine is green
	var Sum = load("res://tools/balance_summary.gd")
	var p6: Array = Sum.signals_row([{"build": "A", "faint": [10, 9], "full_at_reach": [100, 95]}])
	_check(str(p6[0]) == "P6. The signals" and p6[3] == true, "P6 judged the full half: %s" % str(p6))


## A bot whose wall reads are set by hand (the fix round): `odds` a class's at the wall, `pick` a pick's (-1: the real read).
func _wall_bot():
	var gs := GDScript.new()
	gs.source_code = "extends \"res://tests/bot.gd\"\nvar odds := {}\nvar pick := -1.0\n" + \
		"func class_wall_odds(_sim, name: String, _wall: Array) -> float:\n\treturn float(odds.get(name, 0.0))\n" + \
		"func pick_odds(sim, t: int) -> float:\n\treturn pick if pick >= 0.0 else super(sim, t)\n"
	gs.reload()
	return gs.new()


## The wall rule's branches (the fix round, the review's "three of four untested"): a played class at FIRST, the best
## of two, the 0.05 fallback, the from-class's odds logged, the target levelling kept out, the walled one read again
## and back, H4's target taken from the first step, and the read's build home when the campaign's done.
func _wall_branch_checks() -> void:
	var dice0: Array = [Sim._seed_n, Items._next_id]     # the camps and finds made here leave the later checks' dice as they were
	var w = Sim.new()
	w.start()
	if w.cls != "Poacher":
		w.set_class("Poacher")
	for i in Data.ZONES[0]["tiers"]:
		w.best_depth[i] = 1
	w.bosses_beaten[0] = true                 # the Paramedic open
	w.bosses_beaten[1] = true                 # and the Doorman (the Estate's sites still to clear: the wall stands there)
	_check(w.set_class("Paramedic") and w.set_class("Doorman") and w.set_class("Poacher"), "the wall's fixture: the three classes not played")
	_check(not w.class_open("Scrapper") and not w.class_open("Recruit") and not w.class_open("Drifter"), "the wall's fixture: a class open past the three")
	var bt = _wall_bot()
	bt.wall_on = true
	var wall: Array = bt.wall_at(w)
	var farm: int = int(Data.ZONES[0]["tiers"][0])
	_check(int(wall[0]) >= 0, "the wall's fixture: no wall")
	# the best of two played classes at FIRST, and the walled one's odds in the entry
	bt.odds = {"Poacher": 0.3, "Paramedic": 0.66, "Doorman": 0.8}
	bt.wall_note(w, farm)
	w.elapsed += bt.WALL_S
	_check(bt.wall_check(w) and w.cls == "Doorman" and bt.walls.size() == 1 and bt.walls[0].size() == 7 and is_equal_approx(float(bt.walls[0][5]), 0.8) and is_equal_approx(float(bt.walls[0][6]), 0.3),
		"walled, the best played class at FIRST didn't go out with both odds logged: %s out, %s" % [w.cls, str(bt.walls)])
	# none at FIRST and none new: the nearest, only when it reads 0.05 over the one out
	bt.odds = {"Poacher": 0.3, "Paramedic": 0.5, "Doorman": 0.48}
	bt.wall_note(w, farm)
	w.elapsed += bt.WALL_S
	_check(not bt.wall_check(w) and w.cls == "Doorman", "the fallback swapped for under 0.05 better")
	bt.odds["Doorman"] = 0.4
	bt.wall_note(w, farm)
	w.elapsed += bt.WALL_S
	_check(bt.wall_check(w) and w.cls == "Paramedic" and is_equal_approx(float(bt.walls.back()[5]), 0.5) and is_equal_approx(float(bt.walls.back()[6]), 0.4),
		"none at FIRST: the class 0.05 nearer didn't go out: %s, %s" % [w.cls, str(bt.walls.back())])
	# the walled one read again: not before its clock or a level, back when it reads FIRST
	bt.odds = {"Poacher": 0.5, "Paramedic": 0.3, "Doorman": 0.7}
	_check(not bt.wall_return(w) and w.cls == "Paramedic", "a walled class came back before its clock or a level, or read under FIRST: %s" % w.cls)     # the Poacher due and under; the Doorman not due
	w.elapsed += 60.0
	w.roster["Doorman"]["xp"] = Data.xp_for_level(w.crew_level("Doorman") + 1)     # a level on the bench: read again now
	_check(bt.wall_return(w) and w.cls == "Doorman" and str(bt.walls.back()[3]) == "Paramedic" and str(bt.walls.back()[4]) == "Doorman" and not bt._walled.has("Doorman"),
		"a walled class that levelled and reads FIRST didn't come back: %s, %s" % [w.cls, str(bt.walls.back())])
	bt.odds["Poacher"] = 0.7
	w.elapsed += bt.WALL_S
	_check(bt.wall_return(w) and w.cls == "Poacher" and bt._walled.is_empty(), "a walled class read again on its clock at FIRST didn't come back: %s" % w.cls)
	# the target still levelling isn't walled away; once it stops, it is
	var tb = _wall_bot()
	tb.wall_on = true
	tb.target_cls = "Poacher"
	tb._target_taken = true
	tb.odds = {"Poacher": 0.2, "Paramedic": 0.9, "Doorman": 0.9}
	tb.wall_note(w, farm)
	w.elapsed += tb.WALL_S - 100.0
	w.xp = Data.xp_for_level(w.level() + 1)
	tb.wall_note(w, farm)                     # a level up 100 s before the clock runs out
	w.elapsed += 100.0
	_check(not tb.wall_check(w) and w.cls == "Poacher", "the target was walled away while still levelling")
	w.elapsed += tb.WALL_S
	_check(tb.wall_check(w) and w.cls != "Poacher", "the target that stopped levelling was never walled")
	# H4: a read that starts as its target takes it at once, so the wall's swap isn't undone on the next step
	var h = Sim.new()
	h.start()
	if h.cls != "Poacher":
		h.set_class("Poacher")
	h.bosses_beaten[0] = true
	var hb = Bot.new()
	hb.wall_on = true
	hb.target_cls = "Poacher"
	hb.target_el = "frost"
	hb.take_target(h)
	_check(hb._target_taken, "a read that starts as its target didn't take it")
	hb._crew_out(h, "Paramedic")              # the wall's swap
	hb.take_target(h)
	_check(h.cls == "Paramedic", "the Poacher's read took the Poacher back over the wall's swap")
	# the campaign done: the read's own build back out, once
	for i in range(Data.TIERS.size()):
		h.best_depth[i] = maxi(1, int(h.best_depth[i]))
	for z in range(h.bosses_beaten.size()):
		h.bosses_beaten[z] = true
	h.depot_cleared = true
	_check(h.campaign_done(), "the wall's fixture: the campaign not done")
	hb.wall_home(h)
	_check(h.cls == "Poacher" and hb._wall_home, "the campaign done, the read's own build didn't come back out: %s" % h.cls)
	hb._crew_out(h, "Paramedic")
	hb.wall_home(h)
	_check(h.cls == "Paramedic", "the read's build came home twice")
	Sim._seed_n = int(dice0[0])
	Items._next_id = int(dice0[1])
	print("the wall's branches ok: the best at FIRST, the 0.05 fallback, the odds logged, the walled read again, the target, home")


## The fix round's harness (30 Oct, docs/review30.md's "Balance harness"): the read's end figures off its own build (H3),
## a normal run home on a short clock after the clear (H2), the gauntlet's tries treated and their skills picked (H8),
## the parity read without repeats (H7) and both stopping under their kill with a line (H1), the expeditions' counts and
## sends, and the summary's merge of two reads (H6), gate 16's nevers and gate 15's shipped scrap; the bats.
func _harness_fix_checks() -> void:
	var dice0: Array = [Sim._seed_n, Items._next_id]     # the camps and finds made here leave the later checks' dice as they were
	var Bal = load("res://tests/balance.gd")
	var Sum = load("res://tools/balance_summary.gd")
	# H3: the read's build out for the end's figures
	var e = Sim.new()
	e.start()
	if e.cls != "Poacher":
		e.set_class("Poacher")
	e.bosses_beaten[0] = true
	e.xp = Data.xp_for_level(9)
	var eb = Bot.new()
	_check(eb._crew_out(e, "Paramedic") and e.level() != 9, "the end's fixture: no other class out")
	Bal.end_as_build(e, eb, "Poacher")
	_check(e.cls == "Poacher" and e.level() == 9 and eb.crew_swaps == 1, "the end's figures not the read's build: %s at level %d, %d swaps" % [e.cls, e.level(), eb.crew_swaps])
	# H2: a normal run home on a short clock after the clear, not sat out waiting for its second gang
	var r = _fresh_run(0)
	if r == null:
		_check(false, "the short clock's fixture: no run")
	else:
		var m: Dictionary = r.mission
		m["remaining"] = 0
		m["cleared"] = true
		m["crates_off"] = true
		m["kills"] = 10
		m["clock_used"] = 100.0
		m["patrols"] = 0
		var rb = Bot.new()
		m["clock"] = 1e6
		_check(not rb.should_leave(r), "a long clock after the clear sent the run home")
		m["clock"] = 5.0
		_check(rb.should_leave(r), "a normal run sat out a short clock after the clear")
		r.extract_now()
	# H8: each gauntlet try from whole - wounds seen to, the three skills picked for the place
	var g = Sim.new()
	g.start()
	g.wounds = {str(Data.WOUND_AREAS[0]): {"stat": "pace", "what": "a cut", "from": "the smoke", "hp_pct": 0.1}}
	g.hp = 1.0
	g.skill_slots = ["junk", "", ""]
	Bal.gauntlet_ready(g, Bot.new(), "grid")
	_check(g.wounds.is_empty() and is_equal_approx(g.hp, g.max_hp()) and g.skill_slots.size() == 3 and not ("junk" in g.skill_slots), "a gauntlet try set off hurt or with the last place's skills: %s, %s" % [str(g.wounds), str(g.skill_slots)])
	# H1: past its wall limit the gauntlet stops and says so, every place left named
	var gr: Dictionary = Bal.gauntlet_run(g, Bot.new(), ["grid", "archive"], 0)
	_check(bool(gr["cut"]) and gr["rows"].size() == 2 and gr["rows"].all(func(gw): return int(gw["tries"]) == 0 and str(gw["why"]).begins_with("cut short")) and int(gr["tries"]) == 0,
		"the gauntlet past its wall limit: %s" % str(gr))
	# H7 and H1: the parity read without repeats, cut short at its wall limit with its figures
	var pb = Bal.parity_bot("Poacher", "frost")
	_check(not pb.repeats and not pb.crew_on, "the parity read's bot repeats or swaps")
	var ps = Sim.new()
	ps.start()
	var pp: Dictionary = Bal.parity_play(ps, pb, 0.5, 0)
	_check(bool(pp["cut_short"]) and float(pp["played_h"]) == 0.0 and bool(pp["norepeat"]) and int(pp["runs"]) == 0, "the parity read past its wall limit: %s" % str(pp))
	# the expeditions: a held crew counted once however many fetches; nothing sent where no place reads EXP_ODDS_AT
	var fs := GDScript.new()
	fs.source_code = "extends \"res://scripts/sim/sim.gd\"\nvar fake_odds := 0.2\n" + \
		"func expeditions_open() -> bool:\n\treturn true\n" + \
		"func exp_take(_id: int) -> bool:\n\treturn false\n" + \
		"func exp_hold_site(_id: int) -> int:\n\treturn 0\n" + \
		"func exp_fetch_block(_id: int) -> String:\n\treturn \"\"\n" + \
		"func odds_ready(_i: int) -> bool:\n\treturn true\n" + \
		"func odds_now(_i: int) -> float:\n\treturn 1.0\n" + \
		"func exp_fetch(_id: int) -> bool:\n\treturn true\n" + \
		"func exp_leads() -> Array:\n\treturn [\"Paramedic\"]\n" + \
		"func exp_odds(_p: int, _lead: String, _now := false) -> Array:\n\treturn [fake_odds, true]\n" + \
		"func exp_crew_odds(_p: int, _lead: String, _hand_ids: Array, _now := true) -> float:\n\treturn 0.9\n" + \
		"func exp_risk(_p: int, _lead: String, _hand_ids: Array, _worth: float, _odds: float) -> float:\n\treturn 0.0\n" + \
		"func lead_strength(_lead: String) -> float:\n\treturn 1e9\n" + \
		"func send_expedition(_p: int, _lead: String, _hand_ids: Array, _cargo: Array, _slot := \"\") -> bool:\n\treturn true\n"
	fs.reload()
	var x = fs.new()
	x.start()
	x.expeditions = [{"id": 7, "state": "held"}]
	var xb = Bot.new()
	var f1: bool = xb._expeditions(x)
	var f2: bool = xb._expeditions(x)
	_check(f1 and f2 and xb.exp_fetched == 2 and xb.exp_held == 1, "a held crew fetched twice counted %d times held (fetched %d)" % [xb.exp_held, xb.exp_fetched])
	x.expeditions = []
	x.scrap = 50000
	x.fake_odds = 0.2
	_check(not xb._exp_send(x), "an expedition went where no place read EXP_ODDS_AT")
	x.fake_odds = 0.9
	_check(xb._exp_send(x), "the send's fixture: nothing went where every place reads")
	# H6: two reads merged - walls joined, the repeats and the expeditions summed, the bases worn summed, each read's
	# damage shares weighing the same
	var r1 := {"build": "Drifter as fire", "element": "fire", "hours": 16.0, "walls": [[1.0, 8, false, "Poacher", "Paramedic", 0.7, 0.3]], "repeats": 1, "repeat_runs": 5, "repeat_bails": 1,
		"exp": {"sent": 2, "scrap_out": 1000}, "worn": {"Primary": {"Pistol": 1.0}}, "dealt_by_type": {"smg": 100.0}}
	var r2 := {"build": "Drifter as fire", "element": "fire", "hours": 16.0, "walls": [[2.0, 9, true, "Paramedic", "Drifter", 0.8, 0.2]], "repeats": 2, "repeat_runs": 7, "repeat_bails": 0,
		"exp": {"sent": 3, "scrap_out": 3000}, "worn": {"Primary": {"Pistol": 0.5, "Rifle": 2.0}}, "dealt_by_type": {"rifle": 1e9}}
	var mg: Dictionary = Sum._merged([r1, r2])
	_check(mg["walls"].size() == 2 and int(mg["repeats"]) == 3 and int(mg["repeat_runs"]) == 12 and int(mg["repeat_bails"]) == 1 and int(mg["exp"]["sent"]) == 5 and int(mg["exp"]["scrap_out"]) == 4000,
		"two reads merged kept the first's walls, repeats or expeditions: %s" % str([mg["walls"], mg.get("repeats"), mg.get("repeat_runs"), mg.get("exp")]))
	_check(is_equal_approx(float(mg["worn"]["Primary"]["Pistol"]), 1.5) and is_equal_approx(float(mg["worn"]["Primary"]["Rifle"]), 2.0) and is_equal_approx(float(mg["dealt_by_type"]["smg"]), 1.0) and is_equal_approx(float(mg["dealt_by_type"]["rifle"]), 1.0),
		"two reads merged: the bases worn or the damage shares off: %s, %s" % [str(mg["worn"]), str(mg["dealt_by_type"])])
	# gate 15: the scrap shipped is scrap earned (a merged build's shipping a mean over its reads)
	var sc: Dictionary = {"build": "Drifter as fire", "scrap_end": 3000, "scrap_spent": 0, "elapsed_h": 3.0, "exp": {"scrap_out": 4000}, "reads": 2}     # 1.8 h held with the shipping, 3 h without
	_check(bool(Sum.scrap_row([sc])[3]), "gate 15 left the shipped scrap out of the income: %s" % str(Sum.scrap_row([sc])[2]))
	# gate 16: a build that never cleared a site counts later than any
	var all_lv := {}
	for i in range(Data.OUTSKIRTS_SITES + 1, Data.TIERS.size()):
		all_lv[str(i)] = Sim.wear_of(Sim.lv_at(i, 1))
	var some_lv: Dictionary = all_lv.duplicate()
	some_lv.erase(str(Data.OUTSKIRTS_SITES + 1))
	var sl_ok: Array = Sum.site_levels_row([{"build": "A", "first_clear_lv": all_lv}, {"build": "B", "first_clear_lv": all_lv}])
	var sl_nv: Array = Sum.site_levels_row([{"build": "A", "first_clear_lv": all_lv}, {"build": "B", "first_clear_lv": some_lv}])
	_check(bool(sl_ok[3]) and not bool(sl_nv[3]) and str(sl_nv[2]).contains("never: B"), "gate 16 left out a build that never cleared a site: %s / %s" % [str(sl_ok[2]), str(sl_nv[2])])
	# the bats: every argument after the minutes goes through, the bad flag names every flag, CRLF kept
	var rd: String = FileAccess.get_file_as_string("res://tools/balance_read.bat")
	var bb: String = FileAccess.get_file_as_string("res://tools/balance.bat")
	_check(rd.contains("shift /3") and not rd.contains("%9") and rd.count("\n") == rd.count("\r\n"), "balance_read.bat drops arguments past the ninth, or lost its CRLF")
	_check(bb.contains("[quick^|gauntlet^|broken^|hunt^|long]") and bb.contains("gauntlet %%B %%A %%S") and bb.contains("parity %%B %%A %CAPARG%") and bb.count("\n") == bb.count("\r\n"),
		"balance.bat: the bad flag's words, the gauntlet's read N, the quick parity cap, or its CRLF")
	Sim._seed_n = int(dice0[0])
	Items._next_id = int(dice0[1])
	print("the harness ok: the end's build, the short clock, the gauntlet's tries and cut, parity, expeditions, the merge, gates 15 and 16, the bats")
## The events' text, newest last: what the log said.
func _said(sim) -> Array:
	return sim.events.map(func(ev): return str(ev[1]))


## The crew's floor (30 Oct, Matt, shared XP option B: "felt annoying to have a level 1 class when your other was 15"):
## `-- only crew_floor`. A class swapped in (new or benched) joins at the best other class's level less CREW_FLOOR_UNDER,
## its XP at that level's threshold and the levels' points through _earn_points; a benched class keeps its stored level;
## a death still costs its class its levels till it next comes in after another class was out, and earns no points twice;
## no floor past the cap, the paragon untouched; the log says it; Training's swap notice and the Radio's crew row say
## the level they'd join at, and fit.
func _crew_floor_checks(main) -> void:
	var u: int = Data.CREW_FLOOR_UNDER
	var f = Sim.new()
	f.start()
	f.mythics_on = false
	if f.cls != "Poacher":
		f.set_class("Poacher")
	f.xp = Data.xp_for_level(15)
	f.best_level = 15
	f.training_points = 14
	f.hp = f.max_hp()
	_check(f.join_level("Doorman") == 15 - u and f.crew_level("Doorman") == 0, "a new class would join at %d, not %d" % [f.join_level("Doorman"), 15 - u])
	_check(f.set_class("Doorman") and f.level() == 15 - u and is_equal_approx(f.xp, Data.xp_for_level(15 - u)) and f.training_points == (15 - u - 1) * Data.POINTS_A_LEVEL and f.best_level == 15 - u and is_equal_approx(f.hp, f.max_hp()),
		"a new class swapped in under the floor: level %d, XP %.0f, %d points, best %d, HP %.0f of %.0f" % [f.level(), f.xp, f.training_points, f.best_level, f.hp, f.max_hp()])
	var said: Array = _said(f)
	_check(said.has(Words.CREW["floor"] % ["Doorman", 15 - u, u]) and said.any(func(t): return t.begins_with("Level %d: %d training points" % [15 - u, (15 - u - 1) * Data.POINTS_A_LEVEL])), "the floor's lift went unsaid: %s" % str(said.slice(-4)))
	_check(f.set_class("Poacher") and f.level() == 15 and f.crew_level("Doorman") == 15 - u and f.join_level("Doorman") == 15 - u, "the swap back moved the Poacher, or the Doorman's stored level: %d, Doorman %d" % [f.level(), f.crew_level("Doorman")])
	# the benched class keeps its stored level; join_level is the floor's, a swap takes it
	f.xp = Data.xp_for_level(25)
	f.best_level = 25
	var tp_d: int = int(f.roster["Doorman"]["training_points"])
	_check(f.crew_level("Doorman") == 15 - u and f.join_level("Doorman") == 25 - u, "the bench: stored %d (want %d), joins at %d (want %d)" % [f.crew_level("Doorman"), 15 - u, f.join_level("Doorman"), 25 - u])
	_check(f.set_class("Doorman") and f.level() == 25 - u and f.training_points == tp_d + 10 * Data.POINTS_A_LEVEL, "a benched class swapped in: level %d, %d points (had %d)" % [f.level(), f.training_points, tp_d])
	# a death: back to level 1 while the crew carries on; not lifted while out; lifted when it next comes in, no points twice
	f.hp = f.max_hp()
	f.deploy(0)
	_check(f.on_mission(), "the fixture: the Doorman didn't set off")
	f._kia()
	_check(f.cls == "Doorman" and f.level() == 1 and f.join_level("Doorman") == 1, "a death didn't cost the class its levels: %s at %d" % [f.cls, f.level()])
	f.advance(5.0)
	_check(f.level() == 1, "the dead class was lifted while out: level %d" % f.level())
	var tp0: int = f.training_points
	_check(f.set_class("Poacher") and f.level() == 25, "the Poacher came back lifted or lowered: %d" % f.level())
	_check(f.set_class("Doorman") and f.level() == 25 - u and f.training_points == tp0 and f.best_level == 25 - u, "the dead class back in after the Poacher: level %d, %d points (had %d)" % [f.level(), f.training_points, tp0])
	# the cap: no floor past it, the paragon untouched
	f.set_class("Poacher")
	f.xp = Data.xp_for_level(Data.MAX_LEVEL)
	f.paragon_xp = 1234.0
	_check(f.join_level("Scrapper") == Data.MAX_LEVEL - u and f.set_class("Scrapper") and f.level() == Data.MAX_LEVEL - u and is_equal_approx(f.paragon_xp, 1234.0),
		"a new class under a capped one: level %d, paragon XP %.0f" % [f.level(), f.paragon_xp])
	# the screens: Training's armed swap and the Radio's crew row say the level they'd join at, and fit
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	if sim.away():
		sim.bring_back()
	var saved: Dictionary = sim.to_dict()
	var room0 = main.room
	sim.mission = null
	var home: String = sim.cls
	var low: String = "Recruit" if home != "Recruit" else "Paramedic"
	if not sim.roster.has(low):
		sim.set_class(low)
		sim.set_class(home)
	sim.xp = maxf(sim.xp, Data.xp_for_level(20))
	sim.roster[low]["xp"] = 0.0
	var jl: int = sim.join_level(low)
	_check(jl > 1 and sim.crew_level(low) == 1, "the fixture: %s would join at %d" % [low, jl])
	main.show_room(main.BARRACKS)
	var bk = main._barracks
	bk._armed = ""
	bk._shown = ""
	main.refresh()
	bk._pick_class(low)
	_check(sim.cls == home and bk._armed == low and bk._notice.text.contains("joins at level %d" % jl), "the armed swap doesn't say the level the %s joins at (%d): '%s'" % [low, jl, bk._notice.text])
	var UI_v = load("res://scripts/ui/ui.gd")
	_check(UI_v.text_width(bk._notice, bk._notice.text) <= bk._notice.size.x, "the swap's join line overflows: '%s'" % bk._notice.text)
	_check_fit(main, "Training (a lifted swap armed)")
	for nm in [Data.CLASSES[0]["name"], "Doorman"]:
		bk._armed = str(nm)
		bk._shown = ""
		bk.show_state(sim)
		_check(UI_v.text_width(bk._notice, bk._notice.text) <= bk._notice.size.x, "the swap's line overflows for the %s: '%s'" % [nm, bk._notice.text])
	bk._armed = ""
	sim.signal_seq += 1
	sim.signals.append({"id": sim.signal_seq, "site": 0, "zone": 0, "depth": sim.depth_for_level(0, maxi(Data.REACH_START, sim.reach)), "codes": [], "papers": [],
		"head": false, "convoy": false, "line": 0, "grade": 1})     # a plain signal for the crew row to read
	main.show_room(main.COMMS)
	main._radio._pick_view("air")
	main._radio.selected = sim.signals.size() - 1
	main._radio._shown = ""
	main.refresh()
	var row: Array = main._radio._crew_btns.filter(func(t): return t["button"].visible and str(t["cls"]) == low)
	_check(row.size() == 1 and str(row[0]["name"].text).contains("%d" % jl) and UI_v.text_width(row[0]["name"], row[0]["name"].text) <= row[0]["name"].size.x,
		"the Radio's crew row doesn't say the %s joins at %d, or overflows: %s" % [low, jl, str(row.map(func(t): return t["name"].text))])
	_check_fit(main, "the Radio, a lifted class in the crew")
	# the crew row's odds are read at the level the swap brings them out at: the press carries a read that holds
	var k_sel: int = sim.signals.size() - 1
	var o_b: Array = [0.0, false]
	for i in range(400):
		o_b = sim.signal_odds_class(k_sel, low)
		if bool(o_b[1]):
			break
	_check(bool(o_b[1]) and sim.crew_level(low) == 1 and sim.cls == home, "the fixture: the %s's odds didn't read, or the read moved them" % low)
	_check(sim.set_class(low) and sim.level() == jl and bool(sim.signal_odds_now(k_sel)[1]) and is_equal_approx(float(sim.signal_odds_now(k_sel)[0]), float(o_b[0])),
		"the crew row read the %s below the level they joined at: %s carried, %s now" % [low, str(o_b), str(sim.signal_odds_now(k_sel))])
	sim.load_dict(saved)
	main.show_room(room0)
	main.refresh()
	print("the crew's floor ok: new and benched classes lifted, the bench stored, a death's reset, the cap, said, the screens")


## An expedition lead's XP (30 Oct, the review's S4-S6): `-- only exp_lead_xp`. The lead's XP goes through the one
## roster-side path (training points for the levels risen, to MAX_LEVEL, the rest to the crew's paragon); a send's
## shut while a run's out, with words for why; the run's XP is cut by the lead's level, not the runner out's.
func _exp_lead_xp_checks(_main) -> void:
	var E: Dictionary = Words.EXPEDITIONS
	var s = Sim.new()
	s.start()
	s.mythics_on = false
	if s.cls != "Poacher":
		s.set_class("Poacher")
	var lead := "Scrapper"
	s.set_class(lead)
	s.set_class("Poacher")
	for i in range(Data.TIERS.size()):
		s.best_depth[i] = maxi(1, int(s.best_depth[i]))
	for z in range(s.bosses_beaten.size()):
		s.bosses_beaten[z] = true
	s.cash = 1e7
	s.scrap = 200000
	s.hands = []
	s.expeditions = []
	s.roster[lead]["xp"] = Data.xp_for_level(20)
	s.roster[lead]["best_level"] = 20
	s.roster[lead]["training_points"] = 19
	var goods: Array = [{"kind": "scrap", "n": 1000}]
	for k in range(400):
		if bool(s.exp_odds(0, lead)[1]):
			break
	_check(s.expeditions_open() and s.exp_send_block(0, lead, [], goods) == "", "the fixture: no send: '%s'" % s.exp_send_block(0, lead, [], goods))
	# S5: a run out shuts the send, with its words (before: it went, and its lead's XP was 0)
	s.hp = s.max_hp()
	s.deploy(0)
	_check(s.on_mission() and s.exp_send_block(0, lead, [], goods) == E["shut_run_out"] and not s.send_expedition(0, lead, [], goods) and s.expeditions.is_empty(),
		"an expedition went with a run out: '%s', %d out" % [s.exp_send_block(0, lead, [], goods), s.expeditions.size()])
	s.extract_now()
	s.mission = null
	_check(s.send_expedition(0, lead, [], goods) and float(s.expeditions.back()["xp_run"]) > 0.0, "the run home, the send went without its lead's XP: '%s'" % s.exp_send_block(0, lead, [], goods))
	# S4: home with three levels' XP: the points for them, the log's line
	var e: Dictionary = s.expeditions.back()
	e["risk"] = 0.0
	e["hold"] = 0.0
	e["xp_run"] = (Data.xp_for_level(23) - Data.xp_for_level(20) + 1.0) / s.repeat_xp_share()
	e["t0"] = s.elapsed - float(e["dur"])
	s._exp_tick()
	var r: Dictionary = s.roster[lead]     # the roster's dict as it is now (a read puts a new one back)
	_check(s.crew_level(lead) == 23 and int(r["training_points"]) == 19 + 3 * Data.POINTS_A_LEVEL and int(r["best_level"]) == 23, "a lead's three levels on an expedition: level %d, %d points, best %d" % [s.crew_level(lead), int(r["training_points"]), int(r["best_level"])])
	_check(_said(s).has(Words.CREW["lead_level"] % [lead, 23, 3 * Data.POINTS_A_LEVEL, "s"]), "the lead's levels went unsaid: %s" % str(_said(s).slice(-3)))
	_check(s.cls == "Poacher" and s.training_points == 0, "the lead's points went to the runner out: %d" % s.training_points)
	s.exp_take(int(e["id"]))
	s.expeditions = []
	# S4: past the cap the rest is the crew's paragon
	r["xp"] = Data.xp_for_level(Data.MAX_LEVEL - 1)
	r["best_level"] = Data.MAX_LEVEL - 1
	var p0: float = s.paragon_xp
	var over: float = 5000.0
	var g: float = Data.xp_for_level(Data.MAX_LEVEL) - Data.xp_for_level(Data.MAX_LEVEL - 1) + over
	for k in range(400):
		if bool(s.exp_odds(0, lead)[1]):
			break
	_check(s.send_expedition(0, lead, [], goods), "the fixture: no second send: '%s'" % s.exp_send_block(0, lead, [], goods))
	e = s.expeditions.back()
	e["risk"] = 0.0
	e["hold"] = 0.0
	e["xp_run"] = g / s.repeat_xp_share()
	e["t0"] = s.elapsed - float(e["dur"])
	s._exp_tick()
	r = s.roster[lead]
	_check(is_equal_approx(float(r["xp"]), Data.xp_for_level(Data.MAX_LEVEL)) and is_equal_approx(s.paragon_xp - p0, over) and int(r["best_level"]) == Data.MAX_LEVEL,
		"a lead past the cap: XP %.0f (cap %.0f), paragon +%.0f (want %.0f)" % [float(r["xp"]), Data.xp_for_level(Data.MAX_LEVEL), s.paragon_xp - p0, over])
	# S6: the cut is the lead's level, whatever the runner out's
	s.roster[lead]["xp"] = Data.xp_for_level(5)
	s.xp = Data.xp_for_level(Data.MAX_LEVEL)
	var x_hi: float = s._exp_xp_run(0, lead)
	s.xp = Data.xp_for_level(5)
	var x_lo: float = s._exp_xp_run(0, lead)
	s.roster[lead]["xp"] = Data.xp_for_level(Data.MAX_LEVEL)
	var x_lead_hi: float = s._exp_xp_run(0, lead)
	_check(x_hi > 0.0 and is_equal_approx(x_hi, x_lo) and x_lead_hi < x_lo, "the lead's XP is cut by the runner out's level: %.0f with the runner at 50, %.0f at 5 (the lead at 50: %.0f)" % [x_hi, x_lo, x_lead_hi])
	_check(s.cls == "Poacher" and is_equal_approx(s.xp, Data.xp_for_level(5)) and is_equal_approx(float(s.roster[lead]["xp"]), Data.xp_for_level(Data.MAX_LEVEL)), "the lead's read moved the crew")
	print("an expedition lead's XP ok: points, the cap's paragon, shut with a run out, the lead's level")


func _fresh_run(i := 0):
	var s = Sim.new()
	s.start()
	s.mythics_on = false
	s.hp = s.max_hp()
	s.deploy(i)
	if not s.on_mission():
		return null
	var mm: Dictionary = s.mission
	mm["t"]["dps"] = 0.0
	mm["t"]["hp"] = 1e7
	mm["target_hp"] = 1e7
	mm["remaining"] = maxi(3, int(mm["remaining"]))
	mm["clock"] = 1e6
	return s


## The cures (28 Oct, docs/design/meds_ammo_clinic.md): one an element, a pouch each, at once beside a heal under way;
## what each stops gone and a grace before it lands again; used by the runner when its element's heavy, as a heal is
## under 40%; frost and shock on you (a chill slows your fire, a shock lands more of theirs); the Ambulance's Bag keeps
## a cure as a med; the Clinic, the Workshop and the gate's top-up deal in them; the run screen and the cards say so.
func _cures_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	for ty in Data.ELEMENTS:
		var bs: Array = Data.BASES[Data.MEDICAL].filter(func(b): return str(b.get("cure", "")) == ty)
		_check(bs.size() == 1 and not bs[0].has("heal") and Words.item_words(str(bs[0]["name"])) != "", "no one cure for %s: %s" % [ty, str(bs)])
	var rng := RandomNumberGenerator.new()
	rng.seed = 28
	var rolled := 0
	for k in range(300):
		var r: Dictionary = Items.roll(Data.MEDICAL, 2, rng, 3.0)
		if Items.is_cure(r):
			rolled += 1
			_check(int(r["rarity"]) == 0 and r["affixes"].is_empty(), "a cure rolled %s with affixes %s" % [Items.rarity_name(r), str(r["affixes"])])
	_check(rolled > 0, "three hundred meds rolled and not one cure")
	var s = _fresh_run(0)
	if s == null:
		_check(false, "the cures' fixture: no run")
		return
	var mm: Dictionary = s.mission
	var tq: Dictionary = s._plain(Data.MEDICAL, "Tourniquet")
	var band: Dictionary = s._plain(Data.MEDICAL, "Bandage")
	s.rig = [tq, band]
	_check(int(s.first_med().get("id", -1)) == int(band["id"]) and s.meds_carried() == 1 and int(s.first_cure("bleed").get("id", -1)) == int(tq["id"]), "a cure read as a heal: first med %s, %d carried" % [str(s.first_med().get("base", "")), s.meds_carried()])
	# an odds read's cure writes nothing in the log (the review)
	var ev0: int = s.events_total
	var dry_m: Dictionary = mm.duplicate(true)
	dry_m["dry"] = true
	var tq_dry: Dictionary = s._plain(Data.MEDICAL, "Tourniquet")
	s.rig.append(tq_dry)
	s._cure(dry_m, s.rig.find(tq_dry))
	_check(s.events_total == ev0, "a dry run's cure wrote to the log: %d lines from %d" % [s.events_total, ev0])
	s.rig = [tq, band]
	# at once, beside a heal going in
	s.hp = s.max_hp() * 0.5
	_check(s.use_med(int(band["id"])) and mm["using"] != null, "the fixture: the bandage didn't go in")
	mm["my_dots"] = {"bleed": 30.0}
	_check(s.use_med(int(tq["id"])) and not mm["my_dots"].has("bleed") and s.cure_wards(mm, "bleed") and not s.rig.has(tq) and mm["using"] != null, "the Tourniquet: bleed %s, warded %s, spent %s, the heal kept %s" % [str(mm["my_dots"].get("bleed", 0)), str(s.cure_wards(mm, "bleed")), str(not s.rig.has(tq)), str(mm["using"] != null)])
	_check(str(s.events.back()[1]).begins_with("Tourniquet used"), "the cure wasn't logged: '%s'" % str(s.events.back()[1]))
	# its grace: no bleed lands for CURE_IMMUNE_S, then it does
	mm["using"] = null
	s.rig = []
	mm["t"]["dps"] = s.max_hp() * 0.05
	mm["t"]["types"] = {"bleed": 0.5, "physical": 0.5}
	for k in range(3):
		s.hp = s.max_hp()
		s._tick(1.0)
	_check(float(mm.get("my_dots", {}).get("bleed", 0.0)) == 0.0, "a bleed landed through the cure's grace: %.1f" % float(mm.get("my_dots", {}).get("bleed", 0.0)))
	for k in range(int(Data.CURE_IMMUNE_S)):
		s.hp = s.max_hp()
		s._tick(1.0)
	_check(float(mm.get("my_dots", {}).get("bleed", 0.0)) > 0.0 and not s.cure_wards(mm, "bleed"), "the cure's grace never ran out")
	# by itself, when its element's heavy: a light burn keeps the gel, a heavy one uses it
	var gel: Dictionary = s._plain(Data.MEDICAL, "Burn gel")
	s.rig = [gel]
	mm["my_dots"] = {"fire": s.hp * Data.CURE_AT * 0.5}
	s._auto_cure(mm)
	_check(s.rig.has(gel), "a light burn used the gel")
	mm["my_dots"]["fire"] = s.hp * Data.CURE_AT * 1.5
	s._auto_cure(mm)
	_check(not s.rig.has(gel) and not mm["my_dots"].has("fire"), "a heavy burn didn't use the gel by itself")
	# the runner's tick does it too (and so the odds' dry runs, which run the same tick)
	var ch: Dictionary = s._plain(Data.MEDICAL, "Activated charcoal")
	s.rig = [ch]
	mm["t"]["dps"] = 0.0
	mm["my_dots"] = {"poison": s.hp * Data.CURE_AT * 2.0}
	s._tick(0.1)
	_check(not s.rig.has(ch), "a heavy poison on a run didn't use the charcoal by itself")
	# frost and shock on you: pools from their fire, a chill slowing yours, a shock landing more; each cure stops its own
	mm["cure_t"] = {}
	mm["my_dots"] = {}
	mm["t"]["dps"] = s.max_hp() * 0.1
	mm["t"]["types"] = {"frost": 0.4, "shock": 0.4, "physical": 0.2}
	for k in range(4):
		s.hp = s.max_hp()
		s._tick(1.0)
	_check(s.my_ail(mm, "frost") > 0.0 and s.my_chill_x(mm) < 1.0 and s.my_ail(mm, "shock") > 0.0, "frost and shock left nothing on you: %.2f, %.2f" % [s.my_ail(mm, "frost"), s.my_ail(mm, "shock")])
	mm["t"]["dps"] = 0.0
	var fl: Dictionary = s._plain(Data.MEDICAL, "Hot flask")
	var salts: Dictionary = s._plain(Data.MEDICAL, "Smelling salts")
	s.rig = [fl, salts]
	_check(s.use_med(int(fl["id"])) and s.use_med(int(salts["id"])) and s.my_ail(mm, "frost") == 0.0 and s.my_ail(mm, "shock") == 0.0 and s.rig.is_empty(), "the flask and the salts didn't stop the chill and the shock")
	# a clear-all (Code blue, Clean hands, a skill) takes frost and shock too
	mm["my_ails"] = {"frost": 10.0}
	s._clear_on_you(mm)
	_check(s.my_ail(mm, "frost") == 0.0, "a clear-all left the chill")
	# the Ambulance's Bag: a cure's a med to it, never used up
	var bag: Dictionary = s._plain("Rig", "Paramedic's rig")
	bag["rule"] = "ambulance_bag"
	s.equipped["Rig"] = bag
	var tq2: Dictionary = s._plain(Data.MEDICAL, "Tourniquet")
	s.rig = [tq2]
	mm["cure_t"] = {}
	mm["my_dots"] = {"bleed": 20.0}
	_check(s.use_med(int(tq2["id"])) and s.rig.has(tq2) and not mm["my_dots"].has("bleed"), "the Ambulance's Bag spent its cure")
	s.extract_now()
	# the Workshop's med ladder builds them from scrap; the Clinic stocks them, the front's elements first; the gate
	# packs one for each of the front's elements
	var built: Array = s.build_options("med").map(func(o): return str(o["name"]))
	_check(["Tourniquet", "Burn gel", "Activated charcoal", "Hot flask", "Smelling salts"].all(func(n): return built.has(n)), "the Workshop's med ladder doesn't build the cures: %s" % str(built))
	s._restock_clinic()
	var on_shelf: Array = s.clinic.filter(func(x): return Items.is_cure(x))
	var front_els: Array = s.zone_elements(s.front_tier())
	_check(on_shelf.size() == mini(Data.CLINIC_CURES, s.clinic_stock() - 1) and s.clinic.size() == s.clinic_stock() and (front_els.is_empty() or Items.cure_of(on_shelf[0]) == front_els[0]), "the Clinic's cures: %s for %s" % [str(on_shelf.map(func(x): return x["base"])), str(front_els)])
	s.rig = []
	s.stash = [s._plain(Data.MEDICAL, "Activated charcoal"), s._plain(Data.MEDICAL, "Burn gel"), s._plain(Data.MEDICAL, "Bandage")]
	s._top_up()
	var packed: Array = s.rig.map(func(x): return str(x["base"]))
	_check(front_els.has("poison") and packed.has("Activated charcoal") and not packed.has("Burn gel") and packed.has("Bandage"), "the gate's cures for %s: %s" % [str(front_els), str(packed)])
	# the bot packs them for its zone
	var bt = Bot.new()
	s.rig = []
	s.stash = [s._plain(Data.MEDICAL, "Activated charcoal")]
	bt._pack_cures(s)
	_check(s.rig.any(func(x): return Items.cure_of(x) == "poison"), "the bot didn't pack a cure for the Outskirts' poison")
	# on screen: frost and shock on you as chips, a cure lit in the rig while its element's on you, the cards
	sim.hp = sim.max_hp()
	sim.deploy(3)
	if not sim.on_mission():
		_check(false, "the fixture: no run for the cures' screen")     # 28 Oct, the tools review: the guard was silent
	else:
		var m: Dictionary = sim.mission
		m["remaining"] = 3
		m["target_hp"] = 1e9
		m["my_dots"] = {"bleed": 40.0}
		m["my_ails"] = {"frost": sim.max_hp(), "shock": sim.max_hp()}
		sim.rig = [sim._plain(Data.MEDICAL, "Tourniquet"), sim._plain(Data.MEDICAL, "Bandage")]
		main.show_room(main.MISSIONS)
		main.refresh()
		var rn = main._run
		var said: Array = []
		for k in range(rn._runner["chips"].shown()):
			said.append(rn._runner["chips"].words(k))
		_check(said.any(func(w): return str(w).begins_with("Chilled")) and said.any(func(w): return str(w).begins_with("Shocked")) and said.has("Bleeding"), "On you doesn't say the chill and the shock: %s" % str(said))
		var lit := false
		for c in rn._rig_cells:
			if c.visible and int(c.id) == int(sim.rig[0]["id"]):
				lit = (c.get_theme_stylebox("normal") as StyleBoxFlat).border_color == Pal.PICK
				_check(str(c.tooltip_text).contains("Stops a bleed"), "the Tourniquet's pouch doesn't say what it does: '%s'" % c.tooltip_text)
		_check(lit, "the Tourniquet isn't lit with a bleed on you")
		_check_fit(main, "Run (cures, chill and shock on you)")
		sim.extract_now()
	main.show_room(main.MEDIC)
	sim.stash.append(sim._plain(Data.MEDICAL, "Burn gel"))
	main._clinic._show("stash")
	main.refresh()
	var cards: String = " | ".join(main._clinic._meds.text_nodes().map(func(l): return str(l.text)))
	_check(cards.contains("Burn gel") and cards.contains("Stops burns"), "the Burn gel's card: %s" % cards.left(300))
	_check_fit(main, "Clinic (a cure's card)")
	main._clinic._show("shelf")
	sim.load_dict(saved)
	main.refresh()
	print("cures ok: one an element, at once beside a heal, a grace, by themselves when heavy, frost and shock on you, the Bag, the Workshop, the Clinic, the gate, the bot, the screen")


## The Clinic's supplies (28 Oct, docs/design/meds_ammo_clinic.md): found in medicine cabinets and on the sites leaning
## to meds (the Hospital most), a stack; handed in at the Clinic's strip, her shelf a step better for good - a tier up,
## then Magic and Rare meds rolled with the meds' own affixes, which work as they say; saved; the bot hands them in.
func _clinic_supply_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var hosp: int = -1
	for i in range(Data.TIERS.size()):
		if Data.TIERS[i]["name"] == "The Hospital":
			hosp = i
	var cab: Dictionary = Sim.crate_def("medicine")
	_check(hosp >= 0 and sim.supply_odds(Data.TIERS[hosp], {}) > 0.0 and sim.supply_odds(Data.TIERS[3], {}) == 0.0 and sim.supply_odds(Data.TIERS[3], cab) > 0.0 and sim.supply_odds(Data.TIERS[hosp], cab) > sim.supply_odds(Data.TIERS[3], cab), "the supplies' odds: the Hospital %.3f, the Streets %.3f, a cabinet %.3f" % [sim.supply_odds(Data.TIERS[hosp], {}), sim.supply_odds(Data.TIERS[3], {}), sim.supply_odds(Data.TIERS[3], cab)])
	var s = _fresh_run(0)
	if s == null:
		_check(false, "the supplies' fixture: no run")
		return
	var got := 0
	for k in range(200):
		var f: Dictionary = s._find(s.mission, s.effective(hosp), false, cab, true)
		if not f.is_empty() and Items.is_supplies(f["it"]):
			got += 1
			_check(Items.stack_size(f["it"]) >= int(Data.SUPPLY_COUNT[0]) and Items.stack_size(f["it"]) <= int(Data.SUPPLY_COUNT[1]), "a find of supplies held %d" % Items.stack_size(f["it"]))
	_check(got > 10, "two hundred looks in the Hospital's cabinets found supplies %d times" % got)
	s.extract_now()
	var a: Dictionary = s._plain(Data.SUPPLIES, "Medical supplies")
	var b: Dictionary = s._plain(Data.SUPPLIES, "Medical supplies")
	Items.set_stack(a, 3)
	Items.set_stack(b, 4)
	s.stash = []
	s.stash_put(a)
	s.stash_put(b)
	_check(s.stash.size() == 1 and s.supplies_held() == 7, "two finds of supplies didn't stack: %d pieces, %d held" % [s.stash.size(), s.supplies_held()])
	_check(not s.is_junk(s.stash[0]) and s._bin_commons(s.stash.duplicate()).size() == 1, "the junk run or the Bins take the supplies")
	# her shelf a step at a time
	s.supplies_in = 0
	s._restock_clinic()
	_check(s.med_stock().any(func(bb): return not bb.has("cure") and int(bb["tier"]) == 1), "the fixture: her shelf has no tier-1 heal before the supplies")
	var need0: int = int(Data.CLINIC_STEPS[0]["need"])
	Items.set_stack(s.stash[0], need0)
	s.unlock_all()
	_check(s.hand_in_supplies() == need0 and s.supplies_held() == 0 and s.supplies_in == need0 and s.clinic_step() == 1, "the hand-in: in %d, held %d, step %d" % [s.supplies_in, s.supplies_held(), s.clinic_step()])
	_check(not s.med_stock().any(func(bb): return not bb.has("cure") and int(bb["tier"]) == 1) and s.clinic.all(func(x): return Items.is_cure(x) or int(x["tier"]) > 1), "the first step didn't lift her shelf a tier: %s" % str(s.clinic.map(func(x): return x["base"])))
	_check(s.events.any(func(e): return str(e[1]) == Words.SUPPLIES_STEP[0]), "her step wasn't logged")
	s.supplies_in = int(Data.CLINIC_STEPS[3]["need"])
	var rolled: Array = []
	for k in range(30):
		s._restock_clinic()
		rolled.append_array(s.clinic.filter(func(x): return int(x["rarity"]) > 0))
	var allowed: Array = Items.allowed_affixes(Data.MEDICAL).map(func(af): return str(af["stat"]))
	_check(rolled.any(func(x): return int(x["rarity"]) == 1) and rolled.any(func(x): return int(x["rarity"]) == 2) and rolled.all(func(x): return not Items.is_cure(x) and x["affixes"].size() == int(Data.RARITIES[int(x["rarity"])]["affixes"]) and x["affixes"].all(func(af): return allowed.has(str(af["stat"])))), "her Magic and Rare meds: %d rolled" % rolled.size())
	# a rolled med's own: quicker to use, a beat of Guard, a cure built in
	var s2 = _fresh_run(0)
	_check(s2 != null, "the fixture: no fresh run for the rolled med's checks")     # never skipped silently (the fix round, 30 Oct)
	if s2 != null:
		var mm: Dictionary = s2.mission
		var med: Dictionary = s2._plain(Data.MEDICAL, "Bandage")
		var plain_t: float = s2.use_time(med)
		med["rarity"] = 2
		med["affixes"] = [{"stat": "med_fast_pct", "value": 50, "tier": 3}, {"stat": "med_guard_pct", "value": 10, "tier": 3}, {"stat": "cure_bleed", "value": 1, "tier": 1}]
		_check(s2.use_time(med) < plain_t * 0.6, "Quicker to use: %.1f s against %.1f" % [s2.use_time(med), plain_t])
		_check(Items.affix_lines(med).has("Stops a bleed too"), "a cure built in reads '%s'" % str(Items.affix_lines(med)))
		s2.rig = [med]
		s2.hp = s2.max_hp() * 0.5
		mm["my_dots"] = {"bleed": 30.0}
		var g0: float = s2.guard()
		s2.use_med(int(med["id"]))
		s2._patch(mm, 30.0)
		_check(mm["using"] == null and not mm["my_dots"].has("bleed") and s2.cure_wards(mm, "bleed") and s2.guard() > g0, "the rolled med's own at its end: bleed %s, warded %s, Guard %.1f from %.1f" % [str(mm["my_dots"].get("bleed", 0)), str(s2.cure_wards(mm, "bleed")), s2.guard(), g0])
		s2.extract_now()
	var d: Dictionary = s.to_dict()
	var s3 = Sim.new()
	s3.load_dict(d)
	_check(s3.supplies_in == s.supplies_in and s3.clinic_step() == s.clinic_step(), "the supplies handed in didn't save: %d" % s3.supplies_in)
	# the bot hands them in coming home
	var bt = Bot.new()
	var st: Dictionary = s._plain(Data.SUPPLIES, "Medical supplies")
	Items.set_stack(st, 5)
	s.stash.append(st)
	var in0: int = s.supplies_in
	bt._restock_meds(s)
	_check(s.supplies_held() == 0 and s.supplies_in == in0 + 5, "the bot didn't hand its supplies in")
	# the Clinic's strip: what's held, the step, Hand in - fitting with the three wounds' rows over it
	sim.supplies_in = 0
	var sp: Dictionary = sim._plain(Data.SUPPLIES, "Medical supplies")
	Items.set_stack(sp, need0)
	while not sim.stash_room(1) and not sim.stash.is_empty():
		sim.sell(sim.stash[0])
	sim.stash.append(sp)
	for area in Data.WOUND_AREAS:
		sim.wounds[area] = {"what": "a cut", "stat": "hp", "from": "The Parade", "hp_pct": 20}
	main.show_room(main.MEDIC)
	main._clinic._show("shelf")
	main.refresh()
	var body = main._clinic._body
	var strip: Dictionary = body.supplies_strip()
	_check(strip["panel"].visible and not strip["hand"].disabled and strip["hand"].text.contains(str(need0)) and strip["head"].text.contains(str(need0)), "the strip: '%s', '%s'" % [strip["head"].text, strip["hand"].text])
	var sr: Rect2 = Rect2(strip["panel"].position, strip["panel"].size)
	var note_end: float = body._note.position.y + body._note.size.y
	_check(sr.position.y >= note_end and sr.end.y <= body._bar.position.y, "the strip runs into the rows or the HP: %s, the note ends %.0f, the bar at %.0f" % [str(sr), note_end, body._bar.position.y])
	for r in body._rows:
		if r["panel"].visible:
			_check(not Rect2(r["panel"].position, r["panel"].size).intersects(sr), "the strip sits on a wound's row")
	_check_fit(main, "Clinic (supplies to hand in, three wounds)")
	strip["hand"].pressed.emit()
	main.refresh()
	_check(sim.supplies_in == need0 and sim.supplies_held() == 0 and strip["hand"].disabled and strip["line"].text.begins_with("Step 1"), "Hand in through the screen: in %d, '%s'" % [sim.supplies_in, strip["line"].text])
	_check_fit(main, "Clinic (supplies handed in)")
	sim.load_dict(saved)
	main.refresh()
	print("the Clinic's supplies ok: the finds, the stack, the hand-in, her steps, the rolled meds' own, the save, the bot, the strip")


## Magazines (28 Oct, Matt: "carrying 3000 smg rounds in a rig doesn't make much sense"; docs/design/meds_ammo_clinic.md):
## a gun fires its magazine, reloads empty (a pause by its type, cut by reload_pct), the fight's damage and the odds'
## dry runs with the pause in and the figures out of a fight at the share it fires; the rig carries pouches of
## magazines; the gate fills them free from the stash; bats and free-round guns untouched; the rig shows a pouch's
## magazines and the Rounds tile the one in the gun.
func _magazine_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var mk := func(slot: String, base: String) -> Dictionary: return sim._plain(slot, base)
	_check(Items.mag_size(mk.call("Primary", _base_of_type("smg"))) == 30 and Items.mag_size(mk.call("Primary", _base_of_type("rifle"))) == 10 and Items.mag_size(mk.call("Primary", _base_of_type("shotgun"))) == 8
		and Items.mag_size(mk.call("Secondary", "Service pistol")) == 15 and Items.mag_size(mk.call("Primary", "Nail gun")) == 50 and Items.mag_size(mk.call("Primary", "Belt-fed SMG")) == 100, "the magazines' sizes")
	_check(Items.mag_size(mk.call("Primary", "Spiked bat")) == 0, "a bat has a magazine")
	var smg: Dictionary = mk.call("Primary", _base_of_type("smg"))
	# quicker reloads are the gloves' alone (29 Oct, the itemisation): never a gun's roll, read off the gloves worn
	var gl_hold = sim.equipped["Gloves"]
	sim.equipped["Gloves"] = null
	sim._dry_memo.clear()
	var bare_s: float = sim.reload_s(smg)
	var quick_gl: Dictionary = sim._plain("Gloves", "Gardening gloves")
	quick_gl["affixes"] = [{"stat": "reload_pct", "value": 50, "tier": 3}]
	sim.equipped["Gloves"] = quick_gl
	sim._dry_memo.clear()
	var gl_s: float = sim.reload_s(smg)
	sim.equipped["Gloves"] = gl_hold
	sim._dry_memo.clear()
	_check(gl_s < bare_s and is_equal_approx(bare_s, float(Data.RELOAD_S["smg"])) and is_equal_approx(gl_s, bare_s / (1.0 + (50.0 + Items.base_stat(quick_gl, "reload_pct")) / 100.0)), "Quicker reloads: %.2f s with the gloves against %.2f" % [gl_s, bare_s])
	_check(not Items.allowed_affixes("Primary").any(func(a): return a["stat"] == "reload_pct") and not Items.allowed_affixes("Secondary").any(func(a): return a["stat"] == "reload_pct") and Items.allowed_affixes("Gloves").any(func(a): return a["stat"] == "reload_pct"), "a gun can still roll quicker reloads, or the gloves can't")
	# the fight: the SMG empties its magazine, then a pause with no fire from it, then fires again from the next
	var s = _fresh_run(0)
	if s == null:
		_check(false, "the magazines' fixture: no run")
		return
	var mm: Dictionary = s.mission
	s.equipped["Primary"] = s._plain("Primary", _base_of_type("smg"))
	s.equipped["Secondary"] = null
	s.rig = [_mag_full(s, "SMG magazine", "SMG rounds"), _mag_full(s, "SMG magazine", "SMG rounds"), _mag_full(s, "SMG magazine", "SMG rounds")]
	s._dry_memo.clear()
	var paused_n := 0
	var fired_after := false
	var r0: int = s.rounds_for(s.equipped["Primary"])
	for k in range(40):
		s.hp = s.max_hp()
		var hp0: float = float(mm["target_hp"])
		s._tick(0.5)
		var x: float = float(mm.get("fire_x", {}).get("Primary", 1.0))
		if x <= 0.0:
			paused_n += 1
			_check(hp0 - float(mm["target_hp"]) <= 0.001, "the SMG hit while it reloaded: %.1f" % (hp0 - float(mm["target_hp"])))
		elif paused_n > 0:
			fired_after = fired_after or hp0 - float(mm["target_hp"]) > 0.0
	_check(int(mm.get("reloads", 0)) >= 1 and paused_n >= 2 and fired_after, "the SMG's magazine: %d reloads, %d half-seconds paused, fired after %s" % [int(mm.get("reloads", 0)), paused_n, str(fired_after)])
	_check(s.rounds_for(s.equipped["Primary"]) < r0, "the SMG spent nothing")
	_check(s.rig.filter(func(x): return int(x["rounds"]) == 0).size() >= 1 and s.rig.size() == 3, "a spent magazine left the rig, or none was spent: %s" % str(s.rig.map(func(x): return int(x["rounds"]))))
	# the reload in the figures out of the fight: the guns' part at the share it fires
	s.extract_now()
	s.rig = [_mag_full(s, "SMG magazine", "SMG rounds"), _mag_full(s, "SMG magazine", "SMG rounds"), _mag_full(s, "SMG magazine", "SMG rounds")]
	s._dry_memo.clear()
	var share: float = s.mag_share("Primary")
	var parts: Dictionary = s.damage_parts()
	_check(share > 0.5 and share < 1.0 and absf(float(parts["guns"]) - Items.dps(s.equipped["Primary"]) * share) < 0.01, "the sheet's guns %.2f against %.2f at the share %.2f" % [float(parts["guns"]), Items.dps(s.equipped["Primary"]) * share, share])
	var est0: float = s.estimate(0)
	var slow_gl: Dictionary = s._plain("Gloves", "Gardening gloves")
	slow_gl["affixes"] = [{"stat": "reload_pct", "value": -90, "tier": 1}]
	var gl_keep = s.equipped["Gloves"]
	s.equipped["Gloves"] = slow_gl
	s._dry_memo.clear()
	_check(s.estimate(0) > est0 * 1.2, "a slow reload didn't make the fight longer: %.1f s against %.1f" % [s.estimate(0), est0])
	# and in the odds' dry runs: a slow reload takes longer on the same dice
	var d_rng := RandomNumberGenerator.new()
	d_rng.seed = 7
	s.hp = s.max_hp()
	s._dry_run(0, d_rng)
	var slow_t: float = float(s._dry_last["elapsed"])
	s.equipped["Gloves"] = gl_keep
	s._dry_memo.clear()
	d_rng.seed = 7
	s.hp = s.max_hp()
	s._dry_run(0, d_rng)
	var fast_t: float = float(s._dry_last["elapsed"])
	_check(slow_t > fast_t, "the odds' dry runs don't read the reload: %.0f s slow, %.0f s quick" % [slow_t, fast_t])
	# a bat and a free-round gun: no magazine, no pause
	s.equipped["Primary"] = s._plain("Primary", "Spiked bat")
	_check(not s.uses_mag("Primary") and is_equal_approx(s.mag_share("Primary"), 1.0), "a bat reloads")
	# the gate fills the rig's magazines free from the stash, whatever the setting; new magazines up to the share
	s.equipped["Primary"] = s._plain("Primary", _base_of_type("smg"))
	var half: Dictionary = _mag_full(s, "SMG magazine", "SMG rounds")
	half["rounds"] = 20
	s.rig = [half]
	s.stash = [s._plain(Data.AMMO, "SMG rounds")]
	for k in range(6):
		s.stash.append(s._plain(Data.MAGAZINE, "SMG magazine"))
	var box_n: int = int(s.stash[0]["rounds"])
	s.set_top_up("leave")
	s._top_up()
	_check(int(half["rounds"]) == 30 and s._rounds_in_stash("SMG rounds") == box_n - 10 and s.rig.size() == 1, "Leave it didn't fill the magazines free: %d in it, %d in the stash" % [int(half["rounds"]), s._rounds_in_stash("SMG rounds")])
	_check(str(s.events.back()[1]) == Words.filled_mags(1, ["SMG rounds"]) and str(s.events.back()[1]) == "Filled: 1 magazine from the SMG rounds in the stash", "the fill's log line: '%s'" % str(s.events.back()[1]))
	s.set_top_up("fill")
	s._top_up()
	var mag_cells: int = 0
	for x in s.rig:
		if Items.is_mag(x):
			mag_cells += Items.size(x)
	_check(mag_cells == 1, "the gate's magazines: %d pouches of %d (one went out, one comes back filled: BUILD48 A, item 24)" % [mag_cells, s.med_capacity()])
	_check(s.rig.all(func(x): return not Items.is_mag(x) or (int(x["rounds"]) == 30 and str(x["ammo"]) == "SMG rounds")), "a packed magazine isn't full of the stash's rounds: %s" % str(s.rig.map(func(x): return x.get("rounds", -1))))
	_check(not s.rig.any(func(x): return Items.is_ammo(x)), "a box went in the rig")
	# the stall (29 Oct): the rig full from before - cures and a heal, or a magazine for a gun not carried - still gets
	# the primary's first magazine, the best heal kept; the shells in the stash were never in the gun
	s.equipped["Primary"] = s._plain("Primary", _base_of_type("shotgun"))
	var cap_r: int = s.med_capacity()
	for case in ["cures", "old rounds", "no heal"]:
		var keep_heal: Dictionary = s._plain(Data.MEDICAL, "Bandage")
		s.rig = [] if case == "no heal" else [keep_heal]
		if case == "old rounds":
			s.rig.append(_mag_full(s, "Nail magazine", "Nails"))
		while s.rig_used() < cap_r:
			s.rig.append(s._plain(Data.MEDICAL, "Burn gel" if s.rig.size() % 2 == 0 else "Activated charcoal"))
		# with no heal in, only a two-pouch kit in the stash (the review: room for a one-pouch heal let the kit take it all)
		s.stash = [s._plain(Data.AMMO, "Shells"), s._plain(Data.MAGAZINE, "Shotgun magazine"), s._plain(Data.MEDICAL, "First aid kit" if case == "no heal" else "Hospital kit")]
		s._top_up()
		var shells_in: int = s.rounds_for(s.equipped["Primary"])
		_check(cap_r >= 3 and shells_in > 0 and (s.rig.has(keep_heal) if case != "no heal" else s.rig.any(func(x): return Items.is_heal(x))) and s.rig_used() <= cap_r
			and (case != "old rounds" or not s.rig.any(func(x): return str(x["base"]) == "Nail magazine")),
			"a full rig (%s) went out with %d shells in the gun: %s" % [case, shells_in, str(s.rig.map(func(x): return str(x["base"])))])
	# on screen: the run's rig draws a magazine with its fill and the Rounds tile the one in the gun; the Kit's rig too
	sim.equipped["Primary"] = sim._plain("Primary", _base_of_type("smg"))
	sim.equipped["Secondary"] = null
	var sp: Dictionary = _mag_full(sim, "SMG magazine", "SMG rounds")
	sp["rounds"] = 20
	sim.rig = [sp, _mag_full(sim, "SMG magazine", "SMG rounds"), sim._plain(Data.MEDICAL, "Bandage")]
	sim.set_top_up("leave")
	sim.stash = sim.stash.filter(func(x): return not Items.is_ammo(x))
	sim.hp = sim.max_hp()
	sim.deploy(3)
	if not sim.on_mission():
		_check(false, "the fixture: no run for the magazines' screen")     # 28 Oct, the tools review: the guard was silent
	else:
		var m: Dictionary = sim.mission
		m["remaining"] = 3
		m["target_hp"] = 1e9
		m["t"]["dps"] = 0.0
		sim.advance(1.0)
		main.show_room(main.MISSIONS)
		main.refresh()
		var rn = main._run
		var cell = null
		for c in rn._rig_cells:
			if c.visible and int(c.id) == int(sp["id"]):
				cell = c
		_check(cell != null and cell.mag_pips().size() == 1, "the run's rig doesn't draw the magazine's fill")
		_check(cell != null and cell.text_nodes().any(func(l): return l.visible and str(l.text) == "20"), "the run's magazine tile doesn't show its rounds: %s" % (str(cell.text_nodes().map(func(l): return l.text)) if cell != null else "no cell"))
		if cell != null:
			var whole := Rect2(Vector2.ZERO, cell.size)
			for pr in cell.mag_pips():
				_check(whole.encloses(pr), "a magazine's bar leaves its tile: %s in %s" % [str(pr), str(whole)])
			for l in cell.text_nodes():
				for pr in cell.mag_pips():
					_check(not Rect2(l.position, l.size).intersects(pr), "the magazine's '%s' sits on its bar: %s on %s in %s" % [l.text, str(Rect2(l.position, l.size)), str(pr), str(cell.size)])
		var tile: String = rn._runner["tiles"][3]["value"].text
		var mg: Array = sim.mag_now("Primary")
		_check(tile == Words.MAG_WORDS["tile"] % [int(mg[0]), sim.mags_spare("Primary")] or tile == "%d" % int(mg[0]), "the Rounds tile doesn't show the magazine: '%s'" % tile)
		_check(sim.mags_spare("Primary") == 1, "the spare magazines: %d" % sim.mags_spare("Primary"))
		_check_fit(main, "Run (magazines)")
		m["reload_t"]["Primary"] = 1.5
		main.refresh()
		_check(rn._runner["tiles"][3]["value"].text.begins_with("Reload"), "the Rounds tile doesn't say it's reloading: '%s'" % rn._runner["tiles"][3]["value"].text)
		_check_fit(main, "Run (reloading)")
		sim.extract_now()
	main.show_room(main.ARMOURY)
	main.refresh()
	var ct = main._armoury._containers
	var kit_cell = null
	for c in ct._rig_cells:
		if c.visible and Items.is_mag(ct._item(int(c.id))):
			kit_cell = c
	_check(kit_cell != null and kit_cell.mag_pips().size() == 1, "the Kit's rig doesn't draw a magazine's fill")
	_check_fit(main, "Kit (magazines in the rig)")
	sim.set_top_up("fill")
	sim.load_dict(saved)
	main.refresh()
	# a magazine's picture (30 Oct, the approved canvas: the parts' and pouches' own): a standard one mag_<type>
	for mb in Data.BASES[Data.MAGAZINE]:
		var kind: String = str(mb["kind"])
		# the literal names the design doc lists (the three-stage review, tools 5: built from MAG_ART, a wrong name there passed)
		var lit := {"extended": "extended_magazine", "quick": "quick_magazine", "drum": "drum_magazine", "belt": "belt_box", "hundred": "hundred_round_drum"}
		var want: String = str(lit[kind]) if lit.has(kind) else "mag_" + str(mb["type"])
		_check(Items.mag_slug(sim._plain(Data.MAGAZINE, str(mb["name"]))) == want, "%s's picture isn't %s" % [mb["name"], want])
	_check(Items.mag_slug(sim._plain(Data.MEDICAL, "Bandage")) == "" and Items.mag_slug(sim._plain(Data.AMMO, "Shells")) == "", "a med or a box reads as a magazine")
	print("magazines ok: sizes, reloads, the pause in the fight, the figures and the odds, bats, the gate's fill, the screens")


## Magazines as items (30 Oct, BUILD32 builder M; docs/design/meds_ammo_clinic.md "Magazines as items"): the data and
## names the language pass decided, the size rule, the sling in place of the magazine mount, a gun never without its
## magazine, magazines as finds and on the Fence's shelf, the gate's fill and its log lines. `-- only mags32_rules`.
func _mags32_rules_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	# the names, exactly the language pass's: a standard, extended and quick of each type, its drum, the belt-fed's two
	var want := {"Pistol magazine": ["pistol", "standard", 1], "Extended pistol magazine": ["pistol", "extended", 1], "Quick pistol magazine": ["pistol", "quick", 2], "Pistol drum": ["pistol", "drum", 2],
		"Rifle magazine": ["rifle", "standard", 1], "Extended rifle magazine": ["rifle", "extended", 1], "Quick rifle magazine": ["rifle", "quick", 2], "Rifle drum": ["rifle", "drum", 2],
		"Shotgun magazine": ["shotgun", "standard", 1], "Extended shotgun magazine": ["shotgun", "extended", 1], "Quick shotgun magazine": ["shotgun", "quick", 2], "Shotgun drum": ["shotgun", "drum", 2],
		"SMG magazine": ["smg", "standard", 1], "Extended SMG magazine": ["smg", "extended", 1], "Quick SMG magazine": ["smg", "quick", 2], "SMG drum": ["smg", "drum", 2],
		"Nail magazine": ["improvised", "standard", 1], "Extended nail magazine": ["improvised", "extended", 1], "Quick nail magazine": ["improvised", "quick", 2], "Nail drum": ["improvised", "drum", 2],
		"Belt box": ["smg", "belt", 3], "Hundred-round drum": ["smg", "hundred", 5]}
	var have := {}
	for b in Data.BASES[Data.MAGAZINE]:
		have[str(b["name"])] = [str(b["type"]), str(b["kind"]), int(b["tier"])]
	_check(have == want, "the magazines' bases aren't the language pass's: %s" % str(have))
	for nm in want:
		var mg: Dictionary = sim._plain(Data.MAGAZINE, nm)
		var two: bool = str(want[nm][1]) in ["drum", "belt", "hundred"]
		_check(Items.size(mg) == (2 if two else 1) and Items.mag_pouches(mg) == Items.size(mg), "%s takes %d pouches" % [nm, Items.size(mg)])
		_check(Words.item_words(nm) != "", "%s has no words" % nm)
	# a magazine's size: the gun's own times its kind (the Hundred-round drum its hundred whatever the gun)
	var pump: Dictionary = sim._plain("Primary", "Pump shotgun")
	var cases := {"Shotgun magazine": 8, "Extended shotgun magazine": 12, "Quick shotgun magazine": 8, "Shotgun drum": 16}
	for nm in cases:
		_check(Items.mag_cap(sim._plain(Data.MAGAZINE, nm), pump) == int(cases[nm]), "%s holds %d for a pump shotgun's 8" % [nm, Items.mag_cap(sim._plain(Data.MAGAZINE, nm), pump)])
	var belt_gun: Dictionary = sim._plain("Primary", "Belt-fed SMG")
	_check(Items.mag_cap(sim._plain(Data.MAGAZINE, "Hundred-round drum"), belt_gun) == 100 and Items.mag_cap(sim._plain(Data.MAGAZINE, "Hundred-round drum"), sim._plain("Primary", _base_of_type("smg"))) == 100, "the Hundred-round drum isn't a hundred whatever the gun")
	_check(Items.mag_fits(sim._plain(Data.MAGAZINE, "Nail magazine"), sim._plain("Primary", "Nail gun")) and Items.mag_fits(sim._plain(Data.MAGAZINE, "Shotgun magazine"), sim._plain("Primary", "Pipe shotgun"))
		and not Items.mag_fits(sim._plain(Data.MAGAZINE, "Shotgun magazine"), sim._plain("Primary", "Spiked bat")) and not Items.mag_fits(sim._plain(Data.MAGAZINE, "Rifle magazine"), pump), "a magazine fits by the ammo type the gun fires")
	# the sling, the magazine mount gone: every gun's mounts, the parts' table, the mounts' list
	_check(not ("magazine" in Data.MOUNTS) and "sling" in Data.MOUNTS, "the mounts: %s" % str(Data.MOUNTS))
	var mag_mounts: Array = []
	for sl in ["Primary", "Secondary"]:
		for b in Data.BASES[sl]:
			if "magazine" in b.get("attachments", []):
				mag_mounts.append(str(b["name"]))
	for u in Data.UNIQUES + Data.ISSUED:
		if "magazine" in u.get("attachments", []):
			mag_mounts.append(str(u["name"]))
	_check(mag_mounts.is_empty(), "guns still with a magazine mount: %s" % str(mag_mounts))
	var slings := {}
	for a in Data.ATTACHMENTS:
		_check(str(a["mount"]) != "magazine" and not (str(a["name"]) in ["Extended magazine", "Quick magazine", "Drum magazine", "Belt box", "Hundred-round drum"]), "a magazine part is still a part: %s" % a["name"])
		if str(a["mount"]) == "sling":
			slings[str(a["name"])] = [int(a["tier"]), int(a["sling_pct"])]
	_check(slings == {"Rope sling": [1, 50], "Webbing sling": [2, 65], "Leather sling": [4, 80], "Two-point sling": [6, 100]}, "the slings: %s" % str(slings))
	_check(sim.attachments_for("sling").all(func(x): return str(x["mount"]) == "sling"), "the Workshop's sling list holds something else")
	# every gun the runner gets comes with its standard magazine: a find, a buy off the shelf, a build, the first gun
	sim.hp = sim.max_hp()
	sim.deploy(3)
	if not sim.on_mission():
		_check(false, "the fixture: no run for the guns' magazines")
	else:
		var m: Dictionary = sim.mission
		var shells_n0: int = m["found"].size()
		var found_gun: Dictionary = sim._plain("Primary", "Pump shotgun")
		sim._land(m, found_gun)
		var own_mag: Dictionary = found_gun.get("mag_item", {})
		_check(str(own_mag.get("base", "")) == "Shotgun magazine" and int(own_mag.get("rounds", -1)) == 0 and found_gun.get("with_mag", false) and m["found"].slice(shells_n0).filter(func(x): return Items.is_mag(x)).is_empty(), "a gun found came without its magazine on it: %s / %s" % [str(own_mag), str(m["found"].slice(shells_n0).map(func(x): return x["base"]))])
		var bat: Dictionary = sim._plain("Primary", "Spiked bat")
		sim._land(m, bat)
		_check(not bat.has("mag_item"), "a bat came with a magazine")
		# the first gun: the gun, its magazine and a box, the log as the language pass has it
		m["found"] = []
		sim._first_gun(m)
		var fg: Array = m["found"]
		var fgun: Dictionary = fg.filter(func(x): return Items.is_gun(x))[0]
		var fmag: Array = fg.filter(func(x): return Items.is_mag(x))
		var fbox: Array = fg.filter(func(x): return Items.is_ammo(x))
		_check(fmag.size() == 1 and fbox.size() == 1 and Items.mag_fits(fmag[0], fgun) and fmag[0].get("first_gun", false) and fgun.get("first_gun", false), "the first gun came without its magazine or box: %s" % str(fg.map(func(x): return x["base"])))
		var fline: String = "Found: %s, %s and a box of %s" % [Words.a_thing(str(fgun["base"])), Words.a_thing(str(fmag[0]["base"]) if not fmag.is_empty() else ""), str(fbox[0]["base"]).to_lower() if not fbox.is_empty() else ""]
		_check(str(sim.events.back()[1]) == fline and fline.begins_with("Found: a") and not fline.contains("a box of rounds"), "the first gun's line: '%s' (want '%s')" % [str(sim.events.back()[1]), fline])
		_check(Words.FIRST_GUN % ["a pump shotgun", "a shotgun magazine", "shells"] == "Found: a pump shotgun, a shotgun magazine and a box of shells", "the first gun's words aren't the language pass's")
		# a full stash: the first gun and its magazine come home whatever the room (the first_gun mark)
		var keep_stash: Array = sim.stash.duplicate()
		while sim.stash_room(1):
			sim.stash.append(sim._plain("Helmet", "Hard hat"))
		sim.extract_now()
		_check(sim.stash.has(fgun) and not fmag.is_empty() and sim.stash.has(fmag[0]) and not fmag[0].has("first_gun"), "the first gun's magazine didn't come home with it to a full stash")
		sim.stash = keep_stash
	# a buy off the shelf, a build at the Bench: the gun's magazine into the stash with it
	sim.cash = 1.0e6
	var shelf_gun: Dictionary = sim._plain("Primary", "Pump shotgun")
	sim.market.append(shelf_gun)
	var mags0: int = sim.stash.filter(func(x): return str(x["base"]) == "Shotgun magazine").size()
	while not sim.stash_room(4) and not sim.stash.is_empty():
		sim.stash.pop_front()
	_check(sim.buy(sim.market.size() - 1) and sim.stash.filter(func(x): return str(x["base"]) == "Shotgun magazine").size() == mags0 + 1 and sim.stash.back() == shelf_gun, "a gun bought came without its magazine")
	sim.scrap = 100000
	while not sim.stash_room(6) and not sim.stash.is_empty():
		sim.stash.pop_front()                 # room for the gun and its magazine (the fix round: the build counts it)
	var nails0: int = sim.stash.filter(func(x): return str(x["base"]) == "Nail magazine").size()
	_check(sim.build("gun", "Pipe shotgun") and sim.stash.filter(func(x): return str(x["base"]) == "Nail magazine").size() == nails0 + 1, "a gun built came without its magazine (it fires nails)")
	# magazines as finds (a share of what would be a part), mostly for a gun held; the Fence's shelf sells the standard ones
	sim.equipped["Primary"] = sim._plain("Primary", "Pump shotgun")
	sim.hp = sim.max_hp()
	sim.deploy(3)
	if sim.on_mission():
		var mf: Dictionary = sim.mission
		var mags_found := 0
		var for_held := 0
		for k in range(600):
			mf["found"] = []
			var f: Dictionary = sim._find(mf, mf["t"], false, {}, true)
			if not f.is_empty() and Items.is_mag(f["it"]):
				mags_found += 1
				if Items.mag_type(f["it"]) in sim.owned_ammo_types(mf):
					for_held += 1
		_check(mags_found >= 5 and for_held * 2 > mags_found, "magazines as finds: %d in 600 looks, %d for a gun held" % [mags_found, for_held])
		sim.extract_now()
	else:
		_check(false, "the fixture: no run for the finds")
	sim._restock_market()
	var shelf_mags: Array = sim.market.filter(func(x): return Items.is_mag(x))
	_check(shelf_mags.size() >= Data.SHELF_MAGS and shelf_mags.all(func(x): return Items.mag_kind(x) == "standard" and Items.mag_type(x) in sim.owned_ammo_types()) and shelf_mags.any(func(x): return str(x["base"]) == "Shotgun magazine"), "the Fence's shelf: %s" % str(shelf_mags.map(func(x): return x["base"])))
	# the gate's lines: the fill as the language pass has it, the top-up's numbers their plurals (never "1 meds")
	_check(Words.topped_up(1, 1) == "Topped up: 1 magazine and 1 med from the stash into the rig" and Words.topped_up(2, 3) == "Topped up: 2 magazines and 3 meds from the stash into the rig" and Words.topped_up(0, 1) == "Topped up: 1 med from the stash into the rig", "the top-up's line: '%s'" % Words.topped_up(1, 1))
	_check(Words.filled_mags(3, ["Shells"]) == "Filled: 3 magazines from the shells in the stash" and Words.filled_mags(1, ["SMG rounds"]) == "Filled: 1 magazine from the SMG rounds in the stash", "the fill's line: '%s'" % Words.filled_mags(3, ["Shells"]))
	sim.equipped["Secondary"] = null
	sim.equipped["Rig"] = sim._plain("Rig", "Chest rig")
	sim.rig = [sim._plain(Data.MEDICAL, "Bandage")]
	sim.stash = [sim._plain(Data.AMMO, "Shells"), sim._plain(Data.MAGAZINE, "Shotgun magazine"), sim._plain(Data.MEDICAL, "Bandage")]
	sim.set_top_up("fill")
	var ev0: int = sim.events.size()
	sim._top_up()
	var lines: Array = sim.events.slice(maxi(0, mini(ev0, sim.events.size() - 3))).map(func(e): return str(e[1]))     # the log keeps 20: the last few
	_check(lines.has("Topped up: 1 magazine and 1 med from the stash into the rig") and lines.has("Filled: 1 magazine from the shells in the stash") and not lines.any(func(l): return l.contains("1 meds") or l.contains("1 magazines")), "the gate's lines: %s" % str(lines))
	sim.load_dict(saved)
	main.refresh()
	print("mags32 rules ok: the names, the size rule, the sling, a gun's magazine, finds and the shelf, the gate's lines")


## The fight with magazines as items (30 Oct): the refill by hand from a box in the pack (the playtest's item 4: the
## first gun fires on the run it's found), the sling (the secondary at its share while the primary reloads, none without
## one, full through a refill) in the fight and the figures; the run's Rounds tile. `-- only mags32_fight`.
func _mags32_fight_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.equipped["Primary"] = sim._plain("Primary", "Pump shotgun")
	sim.equipped["Secondary"] = sim._plain("Secondary", "Service pistol")
	sim.equipped["Rig"] = sim._plain("Rig", "Chest rig")
	var smag: Dictionary = sim._plain(Data.MAGAZINE, "Shotgun magazine")     # empty
	var pmag: Dictionary = _mag_full(sim, "Pistol magazine", "Pistol rounds")
	pmag["rounds"] = 200                                                       # a pistol that lasts the test
	sim.rig = [smag, pmag]
	sim.stash = sim.stash.filter(func(x): return not Items.is_ammo(x) and not Items.is_mag(x))
	sim.set_top_up("leave")
	sim.hp = sim.max_hp()
	sim.deploy(3)
	if not sim.on_mission():
		_check(false, "the fixture: no run for the refill")
		sim.load_dict(saved)
		return
	var m: Dictionary = sim.mission
	m["remaining"] = 5
	m["target_hp"] = 1e9
	m["t"]["hp"] = 1e9
	m["t"]["dps"] = 0.0
	m["clock"] = 1e6
	var box: Dictionary = sim._plain(Data.AMMO, "Shells")
	m["found"].append(box)
	var pump: Dictionary = sim.equipped["Primary"]
	_check(sim.rounds_for(pump) == 0 and not sim.has_rounds(pump), "the fixture: the shotgun's magazine isn't empty")
	sim._tick(0.5)
	var rf: float = sim.refill_now("Primary")
	_check(sim.events.slice(-4).any(func(e): return str(e[1]) == "Out of magazines: refilling one from a box in the pack"), "the refill wasn't logged: %s" % str(sim.events.slice(-4).map(func(e): return e[1])))
	var rp: float = sim.reload_pace(m)                  # the refill runs at the runner's pace, as the fire does (the fix round)
	_check(rf > 0.0 and absf(rf * rp - sim.reload_s(pump) * Data.REFILL_MULT) <= 0.5 * rp + 0.001, "the refill isn't the gun's reload times %.1f: %.2f s left of %.2f at pace %.2f" % [Data.REFILL_MULT, rf, sim.reload_s(pump) * Data.REFILL_MULT / rp, rp])
	# meanwhile the secondary at full, as with the primary dry
	var sec_live: Array = sim._gun_dps()
	_check(is_equal_approx(float(sec_live[1]), Items.dps(sim.equipped["Secondary"]) * (1.0 + sim.grade_bonus(sim.equipped["Secondary"]) / 100.0) * sim.fire_x("Secondary")) and float(sec_live[0]) == 0.0, "through the refill the secondary isn't at full: %s" % str(sec_live))
	# the run's Rounds tile says so
	main.show_room(main.MISSIONS)
	main.refresh()
	var tile: String = main._run._runner["tiles"][3]["value"].text
	_check(tile == "Refilling · %d s" % ceili(rf) or tile == "%d s" % ceili(rf), "the Rounds tile through a refill: '%s'" % tile)
	_check_fit(main, "Run (refilling)")
	var g := 0
	var box_before := 0
	while sim.refill_now("Primary") > 0.0 and g < 60:
		sim.hp = sim.max_hp()
		box_before = int(box["rounds"])
		sim._tick(0.5)
		g += 1
	# conservation on the tick it completes (the fix round, the review's 14): what left the box is what went in, the
	# magazine's size; what's in it now no more than that (the tick's shots after)
	var gave: int = int(m.get("last_refill", -1))
	_check(gave == Items.mag_cap(smag, pump) and box_before - int(box["rounds"]) == gave and int(smag["rounds"]) <= gave and int(smag["rounds"]) > 0 and str(smag["ammo"]) == "Shells" and sim.mag_in("Primary") == smag,
		"the refill didn't move a magazine's worth from the box: gave %d (size %d), the box %d to %d, %d in it" % [gave, Items.mag_cap(smag, pump), box_before, int(box["rounds"]), int(smag["rounds"])])
	# the next shots are the gun's, not the secondary's
	var r0: int = int(smag["rounds"])
	var p0: int = int(pmag["rounds"])
	for k in range(6):
		sim.hp = sim.max_hp()
		sim._tick(0.5)
	_check(int(smag["rounds"]) < r0, "the refilled gun didn't fire: %d of %d" % [int(smag["rounds"]), r0])
	_check(p0 - int(pmag["rounds"]) < int(ceil(Items.base_of(sim.equipped["Secondary"])["rof"] * sim.pace() * 3.0 * 0.6)), "the secondary still fired at full behind the refilled gun: %d rounds in 3 s" % (p0 - int(pmag["rounds"])))
	tile = main._run._runner["tiles"][3]["value"].text
	main.refresh()
	tile = main._run._runner["tiles"][3]["value"].text
	_check(tile == Words.MAG_WORDS["tile"] % [int(smag["rounds"]), 0] or tile.begins_with("Reload") or tile == "%d" % int(smag["rounds"]), "the Rounds tile after the refill: '%s'" % tile)
	# no box in the pack: the spent gun stays dry (the secondary, then fists, as before)
	m["found"].erase(box)
	smag["rounds"] = 0
	m["refill"] = {}
	sim._tick(0.5)
	_check(sim.refill_now("Primary") == 0.0 and not sim.has_rounds(pump), "a refill with no box in the pack")
	sim.extract_now()
	# the sling: while the primary reloads between magazines the secondary fires at the sling's share; none without one
	var smg: Dictionary = sim._plain("Primary", _base_of_type("smg"))
	sim.equipped["Primary"] = smg
	sim.rig = [_mag_full(sim, "SMG magazine", "SMG rounds"), _mag_full(sim, "SMG magazine", "SMG rounds"), pmag]
	pmag["rounds"] = 200
	sim.hp = sim.max_hp()
	sim.deploy(3)
	if not sim.on_mission():
		_check(false, "the fixture: no run for the sling")
		sim.load_dict(saved)
		return
	m = sim.mission
	m["remaining"] = 5
	m["target_hp"] = 1e9
	m["t"]["dps"] = 0.0
	sim._tick(0.1)                              # the magazines in
	var spent := {}
	for case in ["none", "Webbing sling"]:
		smg["attachments"]["sling"] = null if case == "none" else sim._plain(Data.ATTACHMENT, case)
		sim._dry_memo.clear()
		m["reload_t"]["Primary"] = 5.0          # a reload under way
		m["reload_to"]["Primary"] = int(sim.mags_for(smg)[1]["id"])
		var fa: float = float(m.get("fired", {}).get("Secondary", 0.0))
		var ra: int = int(pmag["rounds"])
		sim._tick(0.5)
		spent[case] = (float(m.get("fired", {}).get("Secondary", 0.0)) - fa) + float(ra - int(pmag["rounds"]))     # the shots: what's owed plus what came off
		var gd: Array = sim._gun_dps()
		var base_sec: float = Items.dps(sim.equipped["Secondary"]) * (1.0 + sim.grade_bonus(sim.equipped["Secondary"]) / 100.0) * sim.fire_x("Secondary")
		var want_share: float = sim.secondary_share(true) if case == "none" else maxf(sim.secondary_share(true), 0.65)     # its backing share, a sling's lift (the designer's B)
		_check(is_equal_approx(float(gd[1]), base_sec * want_share), "%s: the secondary's dps while the primary reloads is %.2f, not %.2f" % [case, float(gd[1]), base_sec * want_share])
	_check(float(spent["none"]) > 0.0 and float(spent["Webbing sling"]) > float(spent["none"]) * 1.5, "the secondary's shots through a reload: %s (its backing share without a sling, more with)" % str(spent))
	sim.extract_now()
	# and the figures out of the fight: the sling lifts the guns' damage a second by the secondary's share in the pauses
	smg["attachments"]["sling"] = null
	sim._dry_memo.clear()
	var d_none: float = float(sim._gun_dps()[1])
	var share: float = sim.mag_share("Primary")
	var sec_dps: float = Items.dps(sim.equipped["Secondary"]) * (1.0 + sim.grade_bonus(sim.equipped["Secondary"]) / 100.0)
	var sec_none: float = sec_dps * sim.mag_share("Secondary")
	smg["attachments"]["sling"] = sim._plain(Data.ATTACHMENT, "Two-point sling")
	sim._dry_memo.clear()
	var d_sling: float = float(sim._gun_dps()[1])
	var sec_full: float = sec_dps * sim.mag_share("Secondary")     # the secondary's magazines last less with the sling's lift (the second review: the fight's blend)
	var ss: float = sim.secondary_share(true)
	var want_lift: float = sec_full * (ss * share + (1.0 - share)) - sec_none * ss     # the Two-point's 100% in the reloads, its backing share else
	_check(share < 1.0 and sec_full < sec_none and is_equal_approx(d_sling - d_none, want_lift), "the sling's read: %.2f with, %.2f without (want +%.2f)" % [d_sling, d_none, want_lift])
	# the reads use the magazines carried: a drum's slower reload and bigger size move the share
	var std_share: float = share
	sim.rig = [_mag_full(sim, "SMG drum", "SMG rounds")]
	sim._dry_memo.clear()
	var drum_share: float = sim.mag_share("Primary")
	var rate: float = float(Items.base_of(smg)["rof"])     # pace scales the fire and the reload alike: it cancels (the fix round)
	var want_drum: float = (60.0 / rate) / (60.0 / rate + sim.reload_s(smg) * 1.4)
	_check(absf(drum_share - want_drum) < 0.001 and drum_share != std_share, "the share off a drum: %.3f (want %.3f, the standard's %.3f)" % [drum_share, want_drum, std_share])
	sim.load_dict(saved)
	main.refresh()
	print("mags32 fight ok: the refill by hand and its tile, the next shots the gun's, the sling in the fight and the reads")


## The smaller rig (30 Oct, the playtest's item 1: a Body warmer kept the Bum bag's three bandages): swapping a full rig
## for one with fewer pouches sends the overflow to the stash, the last packed first, and says so; refused with no stash
## room; the run's meds then the Kit's. `-- only mags32_rig`.
func _mags32_rig_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.equipped["Rig"] = sim._plain("Rig", "Chest rig")
	sim.rig = []
	var packed: Array = []
	while sim.rig_room(1):
		var it: Dictionary = sim._plain(Data.MEDICAL, "Bandage") if sim.rig.size() % 2 == 0 else sim._plain(Data.MAGAZINE, "SMG magazine")
		sim.rig.append(it)
		packed.append(it)
	while not sim.stash_room(12) and not sim.stash.is_empty():
		sim.stash.pop_back()
	var warmer: Dictionary = sim._plain("Rig", "Body warmer")
	sim.stash.append(warmer)
	var stash0: int = sim.stash.size()
	_check(sim.can_equip_item(int(warmer["id"])) and sim.equip_item(int(warmer["id"])), "the Body warmer wouldn't go on")
	_check(sim.rig_used() <= sim.med_capacity() and sim.med_capacity() == 2, "the smaller rig kept the bigger one's load: %d in %d pouches" % [sim.rig_used(), sim.med_capacity()])
	var back: Array = packed.slice(sim.rig.size())
	_check(sim.rig == packed.slice(0, sim.rig.size()) and back.all(func(x): return sim.stash.has(x)) and sim.stash.size() == stash0 - 1 + 1 + back.size(), "the overflow didn't go to the stash, the last packed first: rig %s" % str(sim.rig.map(func(x): return x["base"])))
	var want_line: String = Words.SMALLER_RIG % Words.things_list(back.map(func(x): return str(x["base"])))     # repeats counted (the three-stage review, UI 13)
	var lines: Array = sim.events.slice(-3).map(func(e): return str(e[1]))     # the log keeps 20: the last few
	_check(lines.has(want_line) and not want_line.contains("a bandage, a bandage"), "the smaller rig's line: %s (want '%s')" % [str(lines), want_line])
	# the Kit and the run read the same meds
	main.show_room(main.ARMOURY)
	main.refresh()
	var kit_label: String = main._armoury._containers._rig_label.text
	_check(kit_label == "Rig %d / %d pouches" % [sim.rig_used(), sim.med_capacity()] and sim.rig_used() <= sim.med_capacity(), "the Kit reads '%s'" % kit_label)
	var kit_meds: int = sim.meds_carried()
	sim.hp = sim.max_hp()
	sim.set_top_up("leave")
	sim.deploy(3)
	if sim.on_mission():
		sim.mission["t"]["dps"] = 0.0
		main.show_room(main.MISSIONS)
		main.refresh()
		var shown := 0
		for c in main._run._rig_cells:
			if c.visible and Items.is_heal(main._run.sim.rig[main._run._rig_cells.find(c)]):
				shown += 1
		_check(sim.meds_carried() == kit_meds and shown == kit_meds and main._run._runner["tiles"][2]["value"].text == ("%d" % kit_meds if kit_meds > 0 else "none"), "the run's meds %d (shown %d, tile '%s') against the Kit's %d" % [sim.meds_carried(), shown, main._run._runner["tiles"][2]["value"].text, kit_meds])
		sim.extract_now()
	else:
		_check(false, "the fixture: no run for the meds' count")
	# no room in the stash for the overflow: the swap is refused, the reason on the Kit's foot
	sim.equipped["Rig"] = sim._plain("Rig", "Chest rig")
	sim.rig = packed.duplicate()
	for it in packed:
		sim.stash.erase(it)
	var warmer2: Dictionary = sim._plain("Rig", "Body warmer")
	sim.stash.append(warmer2)
	while sim.stash_room(1):
		sim.stash.append(sim._plain("Helmet", "Hard hat"))
	_check(not sim.can_equip_item(int(warmer2["id"])) and not sim.equip_item(int(warmer2["id"])) and sim.rig.size() == packed.size(), "a smaller rig went on with no room in the stash for its overflow")
	main.show_room(main.ARMOURY)
	main._armoury.selected = {"kind": "stash", "id": warmer2["id"]}
	main.refresh()
	var foot: String = main._armoury._pick.hint_text()
	_check(main._armoury._pick.button_texts().has("Equip") and main._armoury._pick._buttons[main._armoury._pick.button_texts().find("Equip")].disabled and foot.begins_with("No room in the stash"), "the Kit's Equip is lit for a rig that can't take the overflow, or the foot doesn't say why: '%s'" % foot)
	sim.load_dict(saved)
	main.refresh()
	print("mags32 rig ok: the overflow to the stash, its line, the Kit and the run agree, refused with no room (foot '%s')" % foot)


## The magazines on screen (30 Oct, the approved canvas): the Kit's gun line, a magazine's card and its compare against
## the one in the rig (rounds, pouches, reload; Swap into the rig), "THE RIG" card, a sling's card; every label fits.
