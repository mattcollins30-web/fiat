## BUILD41 (mine, 4): the bot past 50. It acts on a finished odds read only; the coin flip's bar is SAFE_PAST_CAP past
## level 50; a County run, or one with the kit a big share of the DPS, is insured at half again its price in hand; after
## a death every read is made again before it goes.
func _b41_bot_checks() -> void:
	var dice0: Array = [Sim._seed_n, Items._next_id]
	var mk := func(w, site: int, lv: int, grade: int) -> Dictionary:
		w.signal_seq += 1
		return {"id": w.signal_seq, "site": site, "zone": int(Data.TIERS[site]["zone"]), "depth": w.depth_for_level(site, lv), "codes": [], "papers": [],
			"head": false, "convoy": false, "line": 0, "grade": grade}
	var plant := func(w, k: int, odds: float) -> void:
		var sg: Dictionary = w.signal_at(k)
		w._sig_on(sg)
		var key: Array = w._odds_key(int(sg["site"]))
		w._sig_off()
		w._sig_odds[int(sg["id"])] = [key, odds, 100000, int(odds * 100000.0), RandomNumberGenerator.new(), 1.0]
	# the coin flip: three full signals at the reach read 60%; at level 49 one's run (COIN), at 50 none (SAFE_PAST_CAP)
	var s = Sim.new()
	s.start()
	_set_cls(s, "Poacher")
	for z in range(s.bosses_beaten.size()):
		s.bosses_beaten[z] = true
	var b = Bot.new()
	var picks: Array = []
	for lv in [Data.MAX_LEVEL - 1, Data.MAX_LEVEL]:
		s.xp = Data.xp_for_level(lv)
		s.signals = []
		for k in range(Data.SIGNALS_HELD):
			s.signals.append(mk.call(s, 0, s.reach + 1, 3))
		for k in range(Data.SIGNALS_HELD):
			plant.call(s, k, 0.6)
		picks.append(b._pick_signal(s))
	_check(s.signal_level(s.signal_at(0)) >= s.reach and picks[0] >= 0 and picks[1] < 0, "the coin flip past 50: picked %s at levels 49 and 50 (want one, then none)" % str(picks))
	# a finished read only: one dry run a call, the bot reads on till it's settled before it chooses
	var s2 = Sim.new()
	s2.start()
	s2.signals = [mk.call(s2, 0, s2.reach, 1)]
	s2.odds_budget = 1
	b._pick_signal(s2)
	_check(bool(s2.signal_odds_now(0)[1]), "the bot chose on an odds read not finished: %s" % str(s2.signal_odds_now(0)))
	# the insurance: a County run at 1.6 times its price in hand, a run with the kit at stake at twice; a plain one not
	var s3 = Sim.new()
	s3.start()
	s3.xp = Data.xp_for_level(Data.MAX_LEVEL)
	# the starter kit, nothing in the stash: the next runner brings the same, so nothing's at stake and the 1.5x rule
	# insures nothing (the re-review: a bare slot read 0.75 and every signal was insured)
	s3.stash = []
	var share0: float = b.stake_share(s3)
	s3.cash = 2000.0
	_check(share0 < Bot.STAKE_SHARE and not b.insure_for(s3, false, 1000), "the starter kit with an empty stash still insured at 2x: stake %.2f" % share0)
	var mach: Dictionary = s3._plain("Primary", "Machete")
	mach["affixes"] = [{"stat": "damage_pct", "value": 100, "tier": 1}]
	s3.equipped["Primary"] = mach
	s3._dry_memo.clear()
	var kit0: Array = Data.SLOTS.map(func(sl): return int(s3.equipped[sl]["id"]) if s3.equipped[sl] != null else -1)
	var share: float = b.stake_share(s3)
	var kit1: Array = Data.SLOTS.map(func(sl): return int(s3.equipped[sl]["id"]) if s3.equipped[sl] != null else -1)
	s3.cash = 1600.0
	var county_ins: bool = b.insure_for(s3, true, 1000)
	s3.cash = 2000.0
	var stake_ins: bool = b.insure_for(s3, false, 1000)
	s3.cash = 1200.0
	var short_ins: bool = b.insure_for(s3, true, 1000)
	_check(share >= Bot.STAKE_SHARE and kit0 == kit1 and county_ins and stake_ins and not short_ins and not b.insure_for(s3, false, -1),
		"the bot's insurance: stake %.2f, kit put back %s, County at 1.6x %s, the kit at stake at 2x %s, the County at 1.2x %s" % [share, str(kit0 == kit1), str(county_ins), str(stake_ins), str(short_ins)])
	# a spare kit in the stash as good as what's worn: little at stake, no insurance at 2x (the review: against a bare
	# runner the starter kit read 0.75, so every signal was insured)
	for sl in Data.SLOTS:
		var wn = s3.equipped.get(sl)
		if wn != null:
			var cp: Dictionary = wn.duplicate(true)
			cp["id"] = Items._next_id
			Items._next_id += 1
			s3.stash.append(cp)
	var share_sp: float = b.stake_share(s3)
	s3.cash = 2000.0
	_check(share_sp < Bot.STAKE_SHARE and not b.insure_for(s3, false, 1000) and Data.SLOTS.map(func(sl): return int(s3.equipped[sl]["id"]) if s3.equipped[sl] != null else -1) == kit0,
		"a runner with a spare kit as good still insured at 2x: stake %.2f" % share_sp)
	# after a death: a read the dead runner's kit made isn't run on - a level-60 signal read 100% before, read again
	var s4 = Sim.new()
	s4.start()
	s4.signals = [mk.call(s4, 0, 60, 1)]
	plant.call(s4, 0, 1.0)
	var b4 = Bot.new()
	b4.after_death(s4)
	var before: int = b4._pick_signal(s4)
	s4.operators_lost += 1
	b4.lorry_ok = true
	var seen: bool = b4.after_death(s4)
	var after: int = b4._pick_signal(s4)
	_check(before == 0 and seen and after < 0 and not b4.lorry_ok, "after a death the bot ran on the dead runner's read: before %d, seen %s, after %d, the lorry's %s" % [before, str(seen), after, str(b4.lorry_ok)])
	Sim._seed_n = int(dice0[0])
	Items._next_id = int(dice0[1])
	print("b41 bot ok: finished reads, the coin flip at %.2f past 50, the County insured, a re-read after a death" % Bot.SAFE_PAST_CAP)


# ------------------------------------------------------------------ BUILD43 (1 Nov): the frame-time fix
## A stat read, a change through the game's own call, the read again: it moved, and it's what a fresh read says - the
## live stat memo kept nothing past the change (red with the change's bump taken out).
func _b43_moves(what: String, f: Callable, act: Callable) -> void:
	var before = f.call()
	f.call()                                       # the second read is the memo's
	act.call()
	var after = f.call()
	Sim.live_memo_off = true
	var want = f.call()
	Sim.live_memo_off = false
	_check(after == want and after != before, "after %s the stat reads %s, a fresh read %s (before %s): the live memo kept it" % [what, str(after), str(want), str(before)])


## The live stat memo (BUILD43 fix 1): each thing that can move a stat, through the game's own call - the kit off and
## on, an affix added (a temper's in-place change), a socket filled, a node trained, a level, a wound and its
## treatment, the trader's plate, a Yard pick, a run's start and end, a load - moves the read to what a fresh one says.
## The sky moves no memoised stat: a weather roll reads as a fresh read does.
func _b43_memo_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	sim.cash = maxf(sim.cash, 1e7)
	sim.scrap = maxf(sim.scrap, 1e5)
	sim.notes = maxf(sim.notes, 1e5)
	sim.hp = sim.max_hp()
	var mit := Callable(sim, "mitigation")
	var hp_of := Callable(sim, "max_hp")
	var jacket = sim.equipped["Armour"]
	_check(jacket != null and sim.armour() > 0.0, "the camp wears no armour to take off")
	if jacket == null:
		return
	jacket["affixes"].append({"stat": "hp", "value": 25.0})     # a line the piece is sure to carry, whatever the bot left on
	sim._stats_dirty()                             # the fixture set straight in
	var kit_reads := func(): return [sim.mitigation(), sim.max_hp(), sim._affix_index()]
	sim.stash = sim.stash.filter(func(it): return Items.is_paper(it))     # room in the stash for the jacket (the bot's leave it full)
	_b43_moves("the armour taken off", kit_reads, func(): _check(sim.unequip("Armour"), "the armour wouldn't come off"))
	_b43_moves("the armour put back on", kit_reads, func(): _check(sim.equip_item(int(jacket["id"])), "the armour wouldn't go back on"))
	# an affix added to the worn jacket in place: its id stands, only the call says it moved
	_b43_moves("an affix added to the worn armour", Callable(sim, "_affix_index"), func(): _check(sim.craft(int(jacket["id"]), "add"), "the Bench wouldn't add an affix to the worn armour"))
	# a socket filled: salt in the armour's socket, its armour up
	var salt: Dictionary = sim._plain("Attachment", "Road salt")
	sim.stash.append(salt)
	if Items.sockets(jacket) == 0:
		jacket["attachments"]["socket 1"] = null
		sim._stats_dirty()                         # the fixture's socket, set straight in
	_b43_moves("salt in the armour's socket", Callable(sim, "armour"), func(): _check(sim.fit_socket("Armour", "socket 1", int(salt["id"])), "the salt didn't go in the armour's socket"))
	# a level: the XP the game hands out
	_b43_moves("a level gained", hp_of, func(): sim._gain_xp(Data.xp_for_level(sim.level() + 1) - sim.xp + 1.0))
	# a node trained: one the class can train now with HP, armour, pace or a type's damage on it
	sim.training_points = maxi(sim.training_points, 200)
	var body_all := func(): return [sim.max_hp(), sim.mitigation(), sim.pace()] + Data.TYPES.map(func(ty): return sim.increased(ty))
	var node_id := ""
	var near := 999
	for wid in Data.web_ids():                   # the nearest such node on the web (3 Nov), walked up to
		var id: String = str(wid)
		var nd: Dictionary = sim.node(id)
		var eff: String = str(nd.get("effect", ""))
		if (eff in ["hp", "armour_pct", "pace_pct"] or (eff.ends_with("_pct") and eff.trim_suffix("_pct") in Data.TYPES)) and not sim.web_owned(id) and not nd.has("type") and Data.web_kind(id) == "small":
			var st: int = sim.web_steps(id)
			if st > 0 and st < near:
				near = st
				node_id = id
	if node_id != "":
		_walk_to_touch(sim, node_id)
	_check(node_id != "" and sim.can_train(node_id), "no node with HP, armour, pace or damage on it the runner can train: '%s'" % (sim.train_block(node_id) if node_id != "" else "none"))
	if node_id != "":
		_b43_moves("a node trained (%s)" % node_id, body_all, func(): sim.train_node(node_id))
	# the Theatre: a Yard pick
	_b43_moves("the Theatre built", hp_of, func(): _yard_ids(sim, [], "theatre"))
	# a run's start: armour for each free cell of the pack counts on a run only (the fixture's line on the jacket)
	var site := 3
	sim.equipped["Armour"]["affixes"].append({"stat": "armour_per_free", "value": 5.0})
	sim._stats_dirty()                             # the fixture set straight in
	_b43_moves("a run set off", mit, func(): sim.deploy(site))
	_check(sim.on_mission(), "the memo's run didn't set off")
	if sim.on_mission():
		# a piece swapped in the pack for a bigger one, the count the same (review 43, 3): the free cells' armour moves
		sim.mission["found"].append(sim._plain(Data.MEDICAL, "Bandage"))
		mit.call()
		_b43_moves("a bandage in the pack swapped for a vest", mit, func():
			sim.mission["found"].pop_back()
			sim.mission["found"].append(sim._plain("Armour", "Stab vest")))
		sim.mission["found"].pop_back()
		# the trader's plate: the run's own buff
		_b43_moves("the trader's plate", mit, func(): sim.mission["buff_armour_pct"] = 30.0)
		# a wound (any area: HP, armour or pace)
		var body := func(): return [sim.max_hp(), sim.mitigation(), sim.pace()]
		sim.mission["wounded"] = false
		_b43_moves("a wound", body, func(): sim._wound(sim.mission))
		_b43_moves("the run home", mit, func(): sim.extract_now())
		_b43_moves("the wound treated", body, func(): _check(sim.treat(), "the Clinic wouldn't treat the wound"))
	# the ladder (review 43, 1 and 5): the front site a few levels up at camp - the armour's cut reads the front's level
	var front: int = sim.front_tier()
	sim.best_depth[front] = maxi(int(sim.best_depth[front]), 30)
	_check(sim.campaign_done(), "the memo's camp hasn't the ladder (the campaign isn't done)")
	_b43_moves("the front's level raised on the ladder", mit, func(): sim.set_depth(front, int(sim.depth[front]) + 25))
	_check(sim.front_tier() == front, "the ladder moved the front off its site: the check reads another site")
	# a signal read on the front site: _sig_on moves its depth with no call of its own; then back
	var sg := {"id": 4301, "site": front, "zone": int(Data.TIERS[front]["zone"]), "depth": int(sim.depth[front]) + 20, "codes": [], "papers": [], "head": false, "convoy": false, "line": 0}
	_b43_moves("a signal laid on the front", mit, func(): sim._sig_on(sg))
	_b43_moves("the signal taken off", mit, func(): sim._sig_off())
	# a convoy's last lorry down mid-tick (review 43, 4): the lorries multiply HP; read in the same tick, no guard between
	if sim.on_mission():
		sim.extract_now()
	sim.xp = Data.xp_for_level(Data.MAX_LEVEL)         # at the cap: the heads' XP goes to the paragon, the level stands
	sim._stats_dirty()                                 # the fixture set straight in
	sim.hp = sim.max_hp()
	sim.notes = maxf(sim.notes, 1e6)
	sim.lorry_done = false
	sim.best_depth[Data.CONVOY_TIER] = maxi(int(sim.best_depth[Data.CONVOY_TIER]), sim.convoy_depth())
	sim.set_depth(Data.CONVOY_TIER, sim.convoy_depth())     # the Services at the convoy's depth
	sim.arm_boss(Data.CONVOY_TIER, true)
	sim.deploy(Data.CONVOY_TIER)
	_check(sim.on_mission() and sim.mission.get("convoy", false), "the memo's convoy didn't set off")
	if sim.on_mission() and sim.mission.get("convoy", false):
		var cm: Dictionary = sim.mission
		cm["boss_queue"] = []                          # the last of the three
		cm["boss"]["started"] = true
		var l0: int = sim.lorries
		var by_hand_was: bool = sim.loot_by_hand
		sim.loot_by_hand = true                        # the drops to the floor, the run's materials rolled already: the pack
		cm["mat_rolled"] = true                        # stands, so only the lorry moves the read
		var n0: int = cm["found"].size()
		_b43_moves("the convoy's last lorry down", hp_of, func():
			sim._boss_down(cm, cm["t"])
			while cm["found"].size() > n0:
				cm["found"].pop_back())                # the Lorry's Load strapped on put by: the pack as it was, only the lorry moved
		sim.loot_by_hand = by_hand_was
		_check(sim.lorries == l0 + 1, "the convoy's last lorry down beat no lorry")
		sim.extract_now()
	# a load: the jacket off in the save, read back
	var d: Dictionary = JSON.parse_string(JSON.stringify(sim.to_dict()))
	d["equipped"]["Armour"] = null
	_b43_moves("a load", mit, func(): sim.load_dict(d))
	# the sky: no memoised stat reads it, so a roll's figures stand as a fresh read's
	var dmg := Callable(sim, "damage_total")
	dmg.call()
	sim.elapsed += Data.WEATHER_H * 3600.0 * 3.0
	sim._roll_weather()
	var after: float = dmg.call()
	Sim.live_memo_off = true
	var want: float = dmg.call()
	Sim.live_memo_off = false
	_check(after == want, "the damage after the weather turned reads %.3f, a fresh read %.3f" % [after, want])
	# a played stretch with every memo hit read fresh as well: none differs
	Sim.memo_check = true
	sim.memo_stale.clear()
	for k in range(3):
		sim.deploy(site)
		var g := 0
		while sim.on_mission() and g < 300:
			main._process(0.5)
			if sim.on_mission() and sim.hp < sim.max_hp() * 0.4 and sim.mission["using"] == null and not sim.first_med().is_empty():
				sim.use_med(sim.first_med()["id"])
			if sim.on_mission() and (sim.hp < sim.max_hp() * 0.25 or sim.searching()):
				sim.extract_now()
			g += 1
		for s in Data.SLOTS:
			sim.equip_best(s)
		main.refresh()
		sim.hp = sim.max_hp()
	Sim.memo_check = false
	_check(sim.memo_stale.is_empty(), "the live memo handed back %d stale reads in three played runs: %s" % [sim.memo_stale.size(), str(sim.memo_stale.slice(0, 3))])
	print("b43 memo ok: each change moves the read, three runs with every hit read fresh too")


## One of the shell's frames as the engine runs it, timed (ms): every node whose script has a _process, in tree order -
## the smoke's shell is never in a running tree, so nothing's processing by itself; a node that turns its own off
## (a hidden item cell) is skipped once it's ready to.
func _b43_frame(main, dt := 1.0 / 60.0) -> float:
	_b43_unhold(main)
	var procs: Array = []
	_b43_procs(main, procs)
	var t0 := Time.get_ticks_usec()
	for n in procs:
		if is_instance_valid(n):
			n._process(dt)
	return (Time.get_ticks_usec() - t0) / 1000.0


## What would hold the game still in the shell (the menu, a room's card, the opening, a mythic's moment): put by, so
## the frames are played ones. Not timed.
func _b43_unhold(main) -> void:
	if main._menu.visible:
		main._menu.close()
	for k in ["_opening", "_room_card", "_mythic_card"]:
		var c = main.get(k)
		if c != null and is_instance_valid(c):
			c.queue_free()
		main.set(k, null)


var _b43_has_proc := {}
func _b43_procs(n: Node, out: Array) -> void:
	var sc = n.get_script()
	if sc != null:
		var path: String = str(sc.resource_path)
		if not _b43_has_proc.has(path):
			_b43_has_proc[path] = (sc as Script).get_script_method_list().any(func(mi): return str(mi["name"]) == "_process")
		if _b43_has_proc[path] and not (str(path).ends_with("item_cell.gd") and not n.is_processing() and n.is_node_ready()):
			out.append(n)
	for c in n.get_children():
		_b43_procs(c, out)


static func _b43_stats(v: Array) -> Array:
	var s: Array = v.duplicate()
	s.sort()
	if s.is_empty():
		return [0.0, 0.0, 0.0]
	return [float(s[int(s.size() / 2.0)]), float(s[mini(s.size() - 1, int(s.size() * 0.95))]), float(s.back())]


## The frame budget (BUILD43 fix 6): a fight's frames and the Map's (its odds read afresh), the script time of each
## under B43_MED / B43_P95, and a played two minutes - a run, home, out again, the dogs come - with no frame over
## B43_SPIKE. The old code ran a fight at 12.5 / 28 ms, the Map's odds at 35-63 ms p95, the dogs' read 300 ms.
const B43_MED := 6.0
const B43_P95 := 16.0
const B43_MAP_MED := 9.0                       # the Map's frames spend ODDS_MS (5 ms) on the odds by design while they read
const B43_SPIKE := 50.0
func _b43_frames_checks(main) -> void:
	var sim = main.sim
	var asks_was: bool = Sim.asks
	Sim.asks = true                                # the game's own: a watched run's event asks
	if sim.on_mission():
		sim.extract_now()
	var site := 3
	for i in range(Data.TIERS.size()):
		if not (str(Data.TIERS[i]["name"]) in Data.INDOOR_SITES) and sim.can_deploy_to(i) and int(sim.best_depth[i]) > 0 and i <= 6:
			site = i
	# a fight
	sim.hp = sim.max_hp()
	main.show_room(main.MISSIONS)
	sim.deploy(site)
	main.refresh()
	var fight: Array = []
	var guard := 0
	while fight.size() < 240 and guard < 4000:
		guard += 1
		if not sim.on_mission() or sim.searching():
			if sim.on_mission():
				sim.extract_now()
			sim.hp = sim.max_hp()
			sim.deploy(site)
			main.refresh()
		if sim.hp < sim.max_hp() * 0.5:
			sim.hp = sim.max_hp()
		var ms := _b43_frame(main)
		if main._run._view != null and main._run._view._firing:
			fight.append(ms)
	var fs: Array = _b43_stats(fight)
	_check(fight.size() >= 200 and fs[0] < B43_MED and fs[1] < B43_P95, "a fight's frames: %d, script median %.2f ms (under %.0f), p95 %.2f ms (under %.0f), max %.1f" % [fight.size(), fs[0], B43_MED, fs[1], B43_P95, fs[2]])
	# the enemy bars: nothing moved, no redraw
	var v = main._run._view
	if v != null and sim.on_mission():
		v._lay_bars()
		var r0: Array = v._figs.map(func(f): return int(f["bar"].redraws))
		v._lay_bars()
		_check(v._figs.map(func(f): return int(f["bar"].redraws)) == r0, "the enemy bars were drawn again with nothing moved")
	# the damage line: a frame reads no stat (its target's the refresh's)
	sim._stats_dirty()
	main._move_dps_line(1.0 / 60.0)
	_check(sim._live_memo.is_empty(), "the damage line read a stat in a frame: %s" % str(sim._live_memo.keys()))
	# a hidden item cell doesn't run a frame, a mythic's pulse included (its _process was on at ready for every cell)
	var ItemCell := preload("res://scripts/ui/item_cell.gd")
	var cell = ItemCell.new()
	cell.visible = false
	main.add_child(cell)
	cell._ready()
	cell.show_item(Items.roll_unique(sim._unique_named("The Last Orders"), sim.rng), false)
	_check(cell.dress()["pulse"] and not cell.is_processing(), "a hidden mythic's cell runs _process: pulse %s" % str(cell.dress()["pulse"]))
	cell.queue_free()
	# the Map, its odds read afresh in the frames' few ms
	if sim.on_mission():
		sim.extract_now()
	sim.hp = sim.max_hp()
	main.show_room(main.MISSIONS)
	main._missions.select(site)
	sim._surv_cache = {}
	main.refresh()
	var mp: Array = []
	for k in range(240):
		mp.append(_b43_frame(main))
	var ms2: Array = _b43_stats(mp)
	_check(ms2[0] < B43_MAP_MED and ms2[1] < B43_P95, "the Map's frames reading its odds: script median %.2f ms (under %.0f), p95 %.2f ms (under %.0f), max %.1f" % [ms2[0], B43_MAP_MED, ms2[1], B43_P95, ms2[2]])
	# two minutes played: out, home, out again, the dogs on one run
	var played: Array = []
	var worst := ""
	var dogs_at := -1
	var dogs_read_frames := 0
	var saves: Array = []
	var tops: Array = []
	sim.deploy(site)
	main.refresh()
	for k in range(7200):
		if not sim.on_mission():
			sim.hp = sim.max_hp()
			sim.deploy(site)
			main.refresh()
		elif sim.hp < sim.max_hp() * 0.3:
			sim.hp = sim.max_hp()
		if dogs_at < 0 and k > 600 and sim.on_mission() and sim.event_now().is_empty():
			var m: Dictionary = sim.mission
			m["remaining"] = 0
			m["target_hp"] = 0.0
			m["cleared"] = true
			m["searches"] = maxi(1, int(m.get("searches", 0)))
			m["patrol_timer"] = 0.0
			m["event"] = "threat"
			m["event_at"] = 0.0
			dogs_at = k
		var since_save: float = main._since_save
		var was: String = ("run, %s" % str(sim.event_now().get("fam", "fight" if int(sim.mission.get("remaining", 0)) > 0 else "searching"))) if sim.on_mission() else "camp"
		var ms := _b43_frame(main)
		if main._since_save < since_save:
			saves.append(ms)                       # the autosave's frame (every 30 s): weighed apart, not this build's (a question for the designer)
			continue
		played.append(ms)
		if sim.dogs_reading():
			dogs_read_frames += 1
		tops.append([ms, k, was + ("" if sim.on_mission() else " -> home")])
		if ms > B43_SPIKE and worst == "":
			worst = "frame %d (%s)" % [k, was]
	var ps: Array = _b43_stats(played)
	_check(dogs_at > 0 and dogs_read_frames > 0, "the played two minutes met no dogs, or read them in one frame (%d frames reading)" % dogs_read_frames)
	var over: int = played.filter(func(x): return x > B43_SPIKE).size()     # two allowed (review 43, 9): the OS taking the CPU from a frame on his machine isn't the game's
	_check(over <= 2, "a played two minutes had %d frames over %.0f ms script (the worst %.1f): %s; median %.2f, p95 %.2f" % [over, B43_SPIKE, ps[2], worst, ps[0], ps[1]])
	if sim.on_mission():
		sim.extract_now()
	Sim.asks = asks_was
	_check(saves.size() >= 3, "two minutes played saved %d times, not every 30 s" % saves.size())
	tops.sort_custom(func(a, b): return a[0] > b[0])
	print("b43 the played run's slowest frames: %s" % str(tops.slice(0, 5).map(func(x): return "%.1f ms at %d (%s)" % x)))
	print("b43 frames: fight %.2f/%.2f/%.1f ms, Map %.2f/%.2f/%.1f ms, played %.2f/%.2f/%.1f ms (median/p95/max), dogs read over %d frames; the autosave's frames %s ms" % [fs[0], fs[1], fs[2], ms2[0], ms2[1], ms2[2], ps[0], ps[1], ps[2], dogs_read_frames, str(saves.map(func(x): return snappedf(x, 0.1)))])


## A Map read stepped across frames (BUILD43 fix 4): parked at a frame's end and taken up in the next, every site's odds
## are what a read in one go makes - the runs, the share back, the lowest HP - and the runner's figures between the
## steps are their own. The dogs' read stepped likewise: "reading…" in its tile till it's done, then the one-go read.
func _b43_steps_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	sim.hp = sim.max_hp()
	var dmg0: float = sim.damage_total()
	var parked := 0
	var sites := 0
	for i in range(Data.TIERS.size()):
		if not sim.tier_open(i) or sites >= 4:
			continue
		sites += 1
		sim._surv_cache.erase(i)
		sim.odds_time_ms = 0.0
		sim.survival(i)
		var one: Array = sim._surv_cache[i].slice(0, 4) + [sim._surv_cache[i][5]]
		one.remove_at(0)
		sim._surv_cache.erase(i)
		sim.odds_step = true
		sim.odds_time_ms = 0.2                     # a fifth of a ms a frame: every run parks, many times
		var calls := 0
		while not sim.odds_settled(i) and calls < 20000:
			sim.odds_frame_start()
			sim.survival(i)
			calls += 1
			var c: Array = sim._surv_cache[i]
			if c.size() > 6 and c[6] != null:
				parked += 1
				if parked == 1:
					_check(not is_same(sim._dry_memo, c[6]["own"]["_dry_memo"]) and sim._dry_rules.is_empty(), "a parked read left its dry memo or rules as the live game's (review 43, 6)")
				_check(sim.mission == null and not sim._dry_on and is_equal_approx(sim.damage_total(), dmg0), "a parked dry run left its state in: mission %s, dry %s" % [str(sim.mission != null), str(sim._dry_on)])
		sim.odds_step = false
		sim.odds_time_ms = 0.0
		var stepped: Array = sim._surv_cache[i].slice(0, 4) + [sim._surv_cache[i][5]]
		stepped.remove_at(0)
		_check(stepped == one, "%s's odds stepped across %d frames read %s, in one go %s" % [Data.TIERS[i]["name"], calls, str(stepped), str(one)])
	_check(sites > 0 and parked > sites, "the stepped reads never parked (%d parks over %d sites)" % [parked, sites])
	# the dogs on a watched run
	var asks_was: bool = Sim.asks
	Sim.asks = true
	sim.deploy(3)
	var m: Dictionary = sim.mission
	m["remaining"] = 0
	m["target_hp"] = 0.0
	m["cleared"] = true
	m["searches"] = maxi(1, int(m.get("searches", 0)))
	m["patrol_timer"] = 0.0
	m["event"] = "threat"
	m["event_at"] = 0.0
	sim.hp = sim.max_hp()
	sim.advance(0.5)
	var ev: Dictionary = sim.event_now()
	_check(str(ev.get("fam", "")) == "threat" and sim.dogs_reading() and not ev.has("odds"), "the dogs on a watched run were read as they came, not a few ms a frame")
	if str(ev.get("fam", "")) == "threat":
		main.show_room(main.MISSIONS)
		main.refresh()
		var ep = main._run._event_panel
		_check(ep._tiles[1]["value"].text == Words.EV["odds_reading"], "the dogs' odds tile reads '%s' while they're read" % ep._tiles[1]["value"].text)
		_check_fit(main, "the dogs being read")
		var one_go: float = sim._dogs_read(m, int(ev["n"]))
		var frames := 0
		var worst := 0.0
		while sim.dogs_reading() and frames < 2000:
			var t0 := Time.get_ticks_usec()
			sim.dogs_read_step(5.0)
			worst = maxf(worst, (Time.get_ticks_usec() - t0) / 1000.0)
			frames += 1
		_check(ev.has("odds") and float(ev["odds"]) == one_go and frames > 1, "the dogs read over %d frames came to %s, in one go %.3f" % [frames, str(ev.get("odds", "-")), one_go])
		_check(worst < 25.0, "a frame of the dogs' read took %.1f ms" % worst)
		# answered before the read's done, the read stops (review 43, 7): nothing reads it once they're no longer waiting
		var m2: Dictionary = m
		ev.erase("odds")
		sim._dogs_job = {"ev": ev, "job": sim._dogs_begin(m2, int(ev["n"]))}
		sim.dogs_read_step(1.0)
		_check(sim.dogs_reading(), "the dogs' second read didn't start")
		ev["state"] = "fight"
		sim.dogs_read_step(1.0)
		_check(sim._dogs_job.is_empty() and not sim._dry_on and sim.mission != null and is_same(sim.mission, m2), "the dogs' read ran on after they were answered")
		ev["state"] = "ask"
		ev["odds"] = one_go
		main.refresh()
		_check(ep._tiles[1]["value"].text == "%d%%" % roundi(float(ev.get("odds", 0.0)) * 100.0), "the dogs' tile after the read: %s" % ep._tiles[1]["value"].text)
	if sim.on_mission():
		sim.extract_now()
	Sim.asks = asks_was
	# the pick card's spill: kept while the pick and the pack stand, read again when the pack moves
	sim.deploy(3)
	if sim.on_mission():
		# a full pack's paint: settled once, not again while nothing in it moves; a piece in, settled again
		for k in range(10):
			sim.mission["found"].append(sim._plain("Armour", "Stab vest"))
		sim.pack_layout(sim.mission)
		var n0: int = sim.pack_settles
		var placed0: Array = sim.mission["found"].map(func(f): return [f.get("pos", null), f.get("rot", false), f.get("strapped", false)])
		sim.pack_layout(sim.mission)
		_check(sim.pack_settles == n0 and sim.mission["found"].map(func(f): return [f.get("pos", null), f.get("rot", false), f.get("strapped", false)]) == placed0, "a full pack was settled again with nothing in it moved")
		var med: Dictionary = sim._plain(Data.MEDICAL, "Bandage")
		sim.mission["found"].append(med)
		sim.pack_layout(sim.mission)
		_check(sim.pack_settles == n0 + 1 and (med.has("pos") or med.get("strapped", false)), "a piece into the pack wasn't settled at the next paint")
		for k in range(11):
			sim.mission["found"].pop_back()
		var bag: Dictionary = sim._plain("Backpack", str(Data.BASES["Backpack"].back()["name"]))
		sim.mission["found"].append(bag)
		var a: Dictionary = sim.wear_preview(int(bag["id"]))
		_check(is_same(a, sim.wear_preview(int(bag["id"]))), "the pick card's spill was read again with nothing moved")
		var box: Dictionary = sim._plain("Armour", "Work jacket")
		sim.mission["found"].append(box)
		var b: Dictionary = sim.wear_preview(int(bag["id"]))
		_check(not is_same(a, b) and str(b) == str(sim._wear_preview_raw(int(bag["id"]))), "the spill wasn't read again when the pack moved")
		sim.extract_now()
	print("b43 steps ok: %d sites' odds stepped the same as in one go (%d parks), the dogs read a few ms a frame" % [sites, parked])


# ------------------------------------------------------------------ BUILD45: the UI's speed

## The guard (BUILD45, 2 Nov, perf44's proposal): two camps as the designer's play leaves them - a mid one (level 14, 8 h,
## the stash full) and a late one (level 50, the campaign done, the Issue in, 104 pieces) - loaded from tests/fixtures,
## and on each the costs perf44 found, timed as the shell runs them (a click is its call and the frame after; a room's
## steady cost its frames' script, _b43_frame): the Kit's frames with the stash full, its first open, a piece worn and
## taken off, a Fence sale, Training's first open and a node trained, a bag picked off the floor, the sounds' first
## play after the title. Each budget is about twice this build's figure on the cloud; b44's code ran them at several
## times that (perf44). The Radio, the County, the Map, a fight and the autosave are timed and printed for builder A's
## half of BUILD45 (the odds, the past runners), not held here. A fixture a SAVE_VERSION bump refuses says so: regrow it.
const B45_FIXTURES := ["res://tests/fixtures/b45_mid.savez", "res://tests/fixtures/b45_late.savez"]
## The budgets are the cloud's, quiet: a fixed loop's time (B45_REF_MS there) is read before each camp and the budgets
## stretched by it when the machine is busier (the cloud's two CPUs are shared with other builds and runs: everything,
## b44's code too, ran two to four times slower then). Never tightened below them on a faster machine.
const B45_REF_MS := 9.0
var _b45_pace := 1.0
const B45_ROOM_P95 := 20.0          # a room's frames with nothing moving, the stash full (b44: 34-44 ms late)
const B45_KIT_OPEN := 150.0         # the Kit's first open (b44: 180-670 ms)
const B45_WEAR := 120.0             # a piece worn or taken off, the stash full (b44: 120-800 ms)
const B45_SELL := 120.0             # a Fence sale, the stash full, the least of two (b44: 150-260 ms at the quiet pace)
const B45_TRAINING := 200.0         # Training's first open, its whole restate, a second into the game (b44: 450-900 ms; this build 64-178, review45u 2-3)
const B45_TRAIN := 60.0             # a node trained, the least of three (b44: 64-65 ms at the least, the quiet pace; this build 25-35: review45u 3's headroom)
const B45_BAG := 600.0              # a bag off the floor, its spill read, the pack full of strapped kit (b44: 1,500-1,900 ms late)
## The sounds aren't timed (review45u 3: 24 ms against 25, b44 44-48): after the title's warm, no first play loads on
## its own thread (sound.plain_loads); b44's loaded every one there.
## The mid camp's budgets that b44 passed too (review45u 5) are its own, tighter: b44 wore a piece in 41/107 ms and
## picked a bag in 391; its Kit's p95 (11.4 against this build's 8.7) can't part them on a shared machine, so mid's is
## printed only. A section a camp can't run is named here, with why; any other skipped fails.
const B45_MID_WEAR := 60.0
const B45_MID_BAG := 300.0
const B45_SKIPS := {"mid": {"sell": "the Fence shut at level 14"}}


func _b45_budget_checks(main) -> void:
	var keep := "user://smoke_b45_keep.save"
	main.save_game(keep)
	var asks_was: bool = Sim.asks
	for path in B45_FIXTURES:
		var tag: String = str(path).get_file().get_basename().trim_prefix("b45_")
		if not _b45_load(main, path):
			_check(false, "the %s fixture won't load at SAVE_VERSION %d (regrow it: perf44_tools/grow_mid.gd)" % [tag, main.SAVE_VERSION])
			continue
		_b45_pace = _b45_pace_now()
		_b45_camp(main, tag)
	Sim.asks = asks_was
	main.load_game(keep)
	DirAccess.remove_absolute(keep)
	DirAccess.remove_absolute("user://smoke_b45.save")


## A fixture as the game loads a save: the sim at this build's SAVE_VERSION, through load_game.
func _b45_load(main, path: String) -> bool:
	var f := FileAccess.open_compressed(path, FileAccess.READ, FileAccess.COMPRESSION_GZIP)
	if f == null:
		return false
	var d = JSON.parse_string(f.get_as_text())
	f.close()
	if not (d is Dictionary) or not d.has("sim"):
		return false
	d["version"] = main.SAVE_VERSION
	d["saved"] = Time.get_unix_time_from_system()
	var w := FileAccess.open("user://smoke_b45.save", FileAccess.WRITE)
	w.store_string(JSON.stringify(d))
	w.close()
	main.load_game("user://smoke_b45.save")
	main.sim.mythics_on = false
	return main.sim != null and main.sim.level() > 1


## How much slower than the quiet cloud this machine runs now: a fixed loop, three times, against B45_REF_MS (1 at least).
func _b45_pace_now() -> float:
	var total := 0.0
	for r in range(3):
		var t0 := Time.get_ticks_usec()
		var x := 0.0
		for i in range(200000):
			x += sqrt(float(i)) * 0.5
		total += (Time.get_ticks_usec() - t0) / 1000.0 + (0.0 if x > 0.0 else 1.0)
	return maxf(1.0, total / 3.0 / B45_REF_MS)


## A budget as this machine's pace stretches it.
func _b45_b(budget: float) -> float:
	return budget * _b45_pace


## A click: the call, then the frame it lands in (ms).
func _b45_click(main, act: Callable) -> float:
	var t0 := Time.get_ticks_usec()
	act.call()
	var c: float = (Time.get_ticks_usec() - t0) / 1000.0
	return c + _b43_frame(main)


## `n` frames' script, [median, p95, max].
func _b45_frames(main, n: int) -> Array:
	var v: Array = []
	for k in range(n):
		v.append(_b43_frame(main))
	return _b43_stats(v)


func _b45_fill(sim) -> int:
	var slots := ["Primary", "Armour", "Helmet", "Secondary", "Backpack"]
	var n := 0
	var guard := 0
	while sim.stash_used() < sim.stash_cap() and guard < 800:
		guard += 1
		var it: Dictionary = Items.roll(slots[guard % slots.size()], 3, sim.rng)
		if it.is_empty() or not sim.stash_fits(it):
			continue
		if sim.stash_put(it):
			n += 1
	return n


func _b45_camp(main, tag: String) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	sim.hp = sim.max_hp()
	main.show_room(main.MISSIONS)
	main.refresh()
	var rows: Array = []
	for k in range(90):
		_b43_frame(main)                            # a second and a half on the Map: the game's own warming done
	# the Kit, its first open, the stash full
	_b45_fill(sim)
	main.refresh()
	var kit_open: float = _b45_click(main, func(): main.show_room(main.ARMOURY))
	rows.append("Kit first open %.1f" % kit_open)
	_check(kit_open < _b45_b(B45_KIT_OPEN), "%s: the Kit's first open took %.1f ms (under %.0f)" % [tag, kit_open, _b45_b(B45_KIT_OPEN)])
	var kf: Array = _b45_frames(main, 180)
	rows.append("Kit full %.2f/%.2f/%.1f" % kf)
	var ran := {}
	if tag != "mid":
		_check(kf[1] < _b45_b(B45_ROOM_P95), "%s: the Kit's frames with the stash full: p95 %.1f ms (under %.0f), median %.2f" % [tag, kf[1], _b45_b(B45_ROOM_P95), kf[0]])
	# a piece taken off and worn again, the stash full (but the room for it)
	var prim = sim.equipped.get("Primary")
	while prim is Dictionary and not sim.stash_room(Items.size(prim)) and not sim.stash.is_empty():
		sim.stash.pop_back()
	main.refresh()
	for k in range(30):
		_b43_frame(main)
	if prim is Dictionary and not prim.is_empty() and sim.stash_room(Items.size(prim)):
		var pid: int = int(prim["id"])
		var off: float = _b45_click(main, func(): sim.unequip("Primary"); main.refresh())
		var on: float = _b45_click(main, func(): sim.equip_item(pid); main.refresh())
		rows.append("off %.1f on %.1f" % [off, on])
		ran["wear"] = true
		var wear_b: float = B45_MID_WEAR if tag == "mid" else B45_WEAR
		_check(maxf(off, on) < _b45_b(wear_b) and sim.equipped["Primary"] != null and int(sim.equipped["Primary"]["id"]) == pid, "%s: a piece taken off took %.1f ms, worn again %.1f (under %.0f)" % [tag, off, on, _b45_b(wear_b)])
	for k in range(30):
		_b43_frame(main)
	# a Fence sale, the stash full
	if not main.room_shut(main.MARKET):
		main.show_room(main.MARKET)
		main.refresh()
		for k in range(30):
			_b43_frame(main)
		var sells: Array = []
		for n_s in range(2):                       # the least of two
			var spare: Dictionary = {}
			for it in sim.stash:
				if not it.has("unique") and str(it.get("slot", "")) in ["Primary", "Armour", "Helmet", "Secondary", "Backpack"] and it.get("built", false) == false:
					spare = it
			if not spare.is_empty():
				sells.append(_b45_click(main, func(): sim.sell(spare); main.refresh()))
				for k in range(10):
					_b43_frame(main)
		if not sells.is_empty():
			rows.append("sell %s" % str(sells.map(func(x): return snappedf(x, 0.1))))
			ran["sell"] = true
			_check(sells.min() < _b45_b(B45_SELL), "%s: a Fence sale took %.1f ms at the least of %d (under %.0f)" % [tag, sells.min(), sells.size(), _b45_b(B45_SELL)])
	# Training: its first open, a node trained
	while sim.stash.size() > 0 and sim.stash_used() > sim.stash_cap() / 2:
		sim.stash.pop_back()
	sim._stats_dirty()
	main.show_room(main.MISSIONS)
	main.refresh()
	for k in range(30):
		_b43_frame(main)
	if not main.room_shut(main.BARRACKS):
		var web = main._barracks.web()
		web._state = {}                              # the game's first open restates the lot: the shell's web outlived the load (review45u 2)
		web._state_sig = ""
		var stale_after: Array = [-1]                # a lambda's own copy of a local: the count goes in an Array
		var tr_open: float = _b45_click(main, func(): main.show_room(main.BARRACKS); stale_after[0] = web._stale.size())
		rows.append("Training first open %.1f" % tr_open)
		ran["training"] = true
		_check(stale_after[0] == 0 and web._state.size() == web.layout.size(), "%s: Training's timed first open wasn't the whole restate: %d left to a slice, %d of %d read" % [tag, stale_after[0], web._state.size(), web.layout.size()])
		_check(tr_open < _b45_b(B45_TRAINING), "%s: Training's first open took %.1f ms (under %.0f)" % [tag, tr_open, _b45_b(B45_TRAINING)])
		var nid := ""
		sim.training_points += 50
		var trs: Array = []
		for n_t in range(3):                       # the least of three: one node's click, not the cloud's neighbours
			nid = ""
			for t in Data.TREES + Data.ELEMENT_TREES:
				for i in range(t["nodes"].size()):
					var id: String = "%s/%d" % [t["name"], i]
					if nid == "" and sim.can_train(id):
						nid = id
			if nid != "":
				trs.append(_b45_click(main, func(): sim.train_node(nid); main.refresh()))
				_check(sim.tree.has(nid), "%s: %s didn't train" % [tag, nid])
				for k in range(10):
					_b43_frame(main)
		if not trs.is_empty():
			ran["train"] = true
			var least: float = trs.min()
			rows.append("train %s" % str(trs.map(func(x): return snappedf(x, 0.1))))
			_check(least < _b45_b(B45_TRAIN), "%s: a node trained took %.1f ms at the least of %d (under %.0f)" % [tag, least, trs.size(), _b45_b(B45_TRAIN)])
	# a bag off the floor: the pick card reads its spill
	main.show_room(main.MISSIONS)
	var site := 0
	for i in range(Data.TIERS.size()):
		if not (str(Data.TIERS[i]["name"]) in Data.INDOOR_SITES) and sim.can_deploy_to(i) and int(sim.best_depth[i]) > 0:
			site = i
	sim.hp = sim.max_hp()
	sim.deploy(site)
	main.refresh()
	for k in range(20):
		_b43_frame(main)
	if sim.on_mission():
		var ms: Dictionary = sim.mission
		var bag := {}
		for b in Data.BASES.get("Backpack", []):
			bag = sim._plain("Backpack", str(b["name"]))
		for k in range(12):
			ms["found"].append(sim._plain("Armour", "Stab vest"))
		bag["id"] = 990001
		ms["floor"] = ms.get("floor", [])
		ms["floor"].append(bag)
		main._run._floor_pick = 990001
		var pick: float = _b45_click(main, func(): main._run.show_state(sim))
		rows.append("bag pick %.1f" % pick)
		ran["bag"] = true
		var bag_b: float = B45_MID_BAG if tag == "mid" else B45_BAG
		_check(pick < _b45_b(bag_b), "%s: a bag picked off the floor took %.1f ms (under %.0f)" % [tag, pick, _b45_b(bag_b)])
		main._run._floor_pick = -1
		ms["floor"].erase(bag)
		# a fight's frames: printed for builder A (the odds, the stat reads), not held here
		var fight: Array = []
		var g := 0
		while fight.size() < 120 and g < 2000 and sim.on_mission():
			g += 1
			if sim.hp < sim.max_hp() * 0.5:
				sim.hp = sim.max_hp()
			var fm := _b43_frame(main)
			if int(sim.mission.get("remaining", 0)) > 0:
				fight.append(fm)
		_c51_late_fight(main, fight)              # (BUILD51-C) the late runner sweeps a campaign site in a frame: a signal at the reach
		if tag != "mid":
			_check(fight.size() >= C51_FIGHT_LEAST, "%s: the fight's frames weren't timed (%d with a gang on)" % [tag, fight.size()])     # (BUILD51-C)
		rows.append("fight %.2f/%.2f/%.1f (%d)" % (_b43_stats(fight) + [fight.size()]))     # (BUILD51-C) the frames' count
		if sim.on_mission():
			sim.extract_now()
	main.refresh()
	# the sounds: every one's first play after the title, loaded behind it
	var snd = main._sound
	snd._streams.clear()                             # a first boot's: nothing loaded yet
	snd._takes.clear()
	snd.title()
	for k in range(60):
		_b43_frame(main)
		OS.delay_msec(5)                             # the loader's threads, as the title's seconds give them
	var plain0: int = snd.plain_loads
	var t0 := Time.get_ticks_usec()
	var found := 0
	for id in snd.SOUNDS:
		found += snd.takes(id).size()
	var snd_ms: float = (Time.get_ticks_usec() - t0) / 1000.0
	var plain: int = snd.plain_loads - plain0
	rows.append("sounds %.1f (%d takes, %d loaded on the play)" % [snd_ms, found, plain])
	ran["sounds"] = true
	_check(found > 20 and plain == 0, "%s: after the title's warm, %d of the sounds' %d takes still loaded on their first play" % [tag, plain, found])
	main._menu.close()
	# for builder A: the Map, the Radio, the County, the autosave
	main.show_room(main.MISSIONS)
	main.refresh()
	rows.append("Map %.2f/%.2f/%.1f" % _b45_frames(main, 180))
	if not main.room_shut(main.COMMS):
		main.show_room(main.COMMS)
		main.refresh()
		rows.append("Radio %.2f/%.2f/%.1f" % _b45_frames(main, 180))
	if sim.issued:
		main.show_room(main.MISSIONS)
		main._missions.set_county(true)
		main.refresh()
		rows.append("County %.2f/%.2f/%.1f" % _b45_frames(main, 180))
		main._missions.set_county(false)
	var t1 := Time.get_ticks_usec()
	main.save_game("user://smoke_b45_auto.save")
	rows.append("autosave %.1f" % ((Time.get_ticks_usec() - t1) / 1000.0))
	DirAccess.remove_absolute("user://smoke_b45_auto.save")
	var skips: Dictionary = B45_SKIPS.get(tag, {})
	for sec in ["wear", "sell", "training", "train", "bag", "sounds"]:
		if ran.has(sec):
			_check(not skips.has(sec), "%s: the %s ran, but it's down as skipped (%s): take it off B45_SKIPS" % [tag, sec, skips.get(sec, "")])
		else:
			_check(skips.has(sec) and (sec != "sell" or main.room_shut(main.MARKET)), "%s: the %s section was skipped, and it isn't one this camp can't run" % [tag, sec])
	print("b45 %s (level %d, stash %d, pace %.2f): %s" % [tag, sim.level(), sim.stash.size(), _b45_pace, "; ".join(rows)])


## BUILD45's mechanisms read what they did before, only cheaper - each against the old way, worked out here.
func _b45_ui_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
