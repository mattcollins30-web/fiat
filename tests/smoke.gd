## The bot never spends a point on another class's start or skills (the board's open notes). `-- only a51_bot_web`.
func _a51_bot_web_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var bad: Array = []
