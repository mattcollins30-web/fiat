## Fix round A (30 Oct, docs/review30.md): the camp the fixes' checks start from, as _repeat_checks has it - no run out,
## nothing to pick, room in the stash, the runner whole. The caller keeps the save and puts it back.
func _fixa_prep(sim) -> void:
	if sim.on_mission():
		sim.extract_now()
	sim.candidates = []
	sim.auto_equip = false
	sim.repeat = {}
	sim.repeat_report = {}
	sim.unlock_all()
	sim.stash = []
	sim.came_back_seen()
	sim.wounds = {}
	sim._caches_out()
	sim.hp = sim.max_hp()


## The repeat's gate read open on a site, as the shell reads it a frame at a time; whether it opened.
func _fixa_gate(sim, site: int) -> bool:
	sim._dry_memo.clear()
	var g := 0
	while not sim.can_repeat(site) and g < 400:
		sim.survival(site)
		sim.repeat_read(site)
		g += 1
	return sim.can_repeat(site)


## A repeat set off on a site by hand, as start_repeat lays it (for a gate the fixture can't open by its odds).
func _fixa_repeat_at(sim, site: int) -> void:
	sim.repeat = {"site": site, "of": 5, "done": 0, "phase": "rest", "stop": false, "bails_row": 0, "bails": 0, "runs": [], "kept": [], "ups": {},
		"t0": sim.elapsed, "run_t0": sim.elapsed, "lv0": sim.level(), "wounds0": sim.wounds.duplicate(true), "share": sim.repeat_xp_share(), "own_list": false, "first": true}


## S1, S2: nothing the Fence or the Clinic sells comes back for what it cost - Buyer's market on, the Fencing tree's sell
## bonus, fifty Fence ranks, the market hall and the pumping station at their caps; the boxes and meds pay the shelf's
## buy multipliers; a piece that never was on the shelf still sells at the full rate.
func _fixa_resale_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	_fixa_prep(sim)
	_set_cls(sim, "Scrapper")
	var fencing: Dictionary = Data.tree_named("Fencing")
	var bm_id := ""
	for k in range(fencing["nodes"].size()):
		var eff: String = str(fencing["nodes"][k].get("effect", ""))
		if eff in ["sell_pct", "buyers_market"] and not sim.tree.has("Fencing/%d" % k):
			sim.tree.append("Fencing/%d" % k)
		if eff == "buyers_market":
			bm_id = "Fencing/%d" % k
	sim.yard_ranks["fence"] = 50
	sim._yard_dirty = true
	sim.rebuilt["market_hall"] = 20
	sim.rebuilt["pumping"] = 20
	sim._caches_out()
	sim.cash = 1.0e9
	_check(sim.has_node("buyers_market") and sim.tree_sum("sell_pct") >= 35.0 and sim.yard_sell_pct() >= 100.0 and sim.town_stat("fence_pct") >= 40.0 and sim.town_stat("clinic_pct") >= 40.0,
		"S1: the fixture: Buyer's market %s, sell +%.0f%%, the Yard +%.0f%%, the hall −%.0f%%, the station −%.0f%%" % [str(sim.has_node("buyers_market")), sim.tree_sum("sell_pct"), sim.yard_sell_pct(), sim.town_stat("fence_pct"), sim.town_stat("clinic_pct")])
	# every standard box: bought and sold straight back, the purse down
	var types: Array = []
	for b in Data.BASES[Data.AMMO]:
		if not b.has("damage_pct") and not (str(b["type"]) in types):
			types.append(str(b["type"]))
	var bad: Array = []
	var n := 0
	for ty in types:
		sim.stash = []
		var c0: float = sim.cash
		var paid: int = sim.ammo_price(ty)
		if not sim.buy_ammo(ty) or sim.stash.is_empty():
			bad.append("%s not bought" % ty)
			continue
		var got: Dictionary = sim.stash.back()
		var back: int = sim.sell_price(got)
		if not sim.sell(got):
			bad.append("%s not sold" % ty)
			continue
		n += 1
		if sim.cash >= c0 or back >= paid:
			bad.append("%s: %d paid, %d back" % [ty, paid, back])
	_check(n >= 3 and bad.is_empty(), "S1: a box of rounds sold straight back for what it cost or more (%d boxes): %s" % [n, str(bad)])
	# every med on her list, and her shelf's
	bad = []
	n = 0
	for b in sim.med_stock():
		sim.stash = []
		var c0: float = sim.cash
		var on_shelf: Dictionary = sim._plain(Data.MEDICAL, str(b["name"]))
		on_shelf["ilvl"] = int(b["tier"])
		sim.clinic.append(on_shelf)
		var paid: int = sim.clinic_price(on_shelf)
		if not sim.buy_clinic(int(on_shelf["id"])) or sim.stash.is_empty():
			bad.append("%s not bought" % str(b["name"]))
			continue
		var got: Dictionary = sim.stash.back()
		var back: int = sim.sell_price(got)
		sim.sell(got)
		n += 1
		if sim.cash >= c0 or back >= paid:
			bad.append("%s: %d paid, %d back" % [str(b["name"]), paid, back])
	sim._restock_clinic()
	for it in sim.clinic.duplicate():
		sim.stash = []
		var c0: float = sim.cash
		var paid: int = sim.clinic_price(it)
		if not sim.buy_clinic(int(it["id"])):
			bad.append("the shelf's %s not bought" % str(it["base"]))
			continue
		var back: int = sim.sell_price(it)
		sim.sell(it)
		n += 1
		if sim.cash >= c0 or back >= paid:
			bad.append("the shelf's %s: %d paid, %d back" % [str(it["base"]), paid, back])
	_check(n >= 3 and bad.is_empty(), "S1: a med sold straight back to the Fence for what the Clinic charged or more (%d meds): %s" % [n, str(bad)])
	# the buy multipliers on the boxes and the meds: Buyer's market doubles them, the hall and the station take their 40%
	var ty0: String = types[0]
	var mb: Dictionary = sim._plain(Data.MEDICAL, str(sim.med_stock()[0]["name"]))     # the shelf's real price on one of its meds (31 Oct: med_price gone)
	var a_on: int = sim.ammo_price(ty0)
	var m_on: int = sim.clinic_price(mb)
	sim.tree.erase(bm_id)
	sim._caches_out()
	var a_off: int = sim.ammo_price(ty0)
	var m_off: int = sim.clinic_price(mb)
	sim.rebuilt["market_hall"] = 0
	sim.rebuilt["pumping"] = 0
	var a_none: int = sim.ammo_price(ty0)
	var m_none: int = sim.clinic_price(mb)
	_check(not sim.has_node("buyers_market") and absi(a_on - 2 * a_off) <= 1 and absi(m_on - 2 * m_off) <= 1 and absf(float(a_off) - a_none * 0.6) <= 1.0 and absf(float(m_off) - m_none * 0.6) <= 1.0,
		"S1: the boxes and meds don't take the shelf's buy multipliers: a box %d with Buyer's market, %d without, %d with no hall; a med %d, %d, %d" % [a_on, a_off, a_none, m_on, m_off, m_none])
	sim.tree.append(bm_id)
	sim.rebuilt["market_hall"] = 20
	sim.rebuilt["pumping"] = 20
	sim._caches_out()
	# S2: every piece on the Fence's shelf, bought and sold straight back, the purse down
	sim._restock_market()
	var shelf: Array = sim.market.duplicate()
	bad = []
	n = 0
	var gear: Dictionary = {}
	for it in shelf:
		sim.stash = []
		var c0: float = sim.cash
		var paid: int = sim.price(it)
		if gear.is_empty() and str(it.get("slot", "")) in Data.SLOTS:
			gear = it.duplicate(true)
		if not sim.buy_id(int(it["id"])):
			bad.append("%s not bought" % str(it["base"]))
			continue
		var got: Dictionary = sim.stash.back()
		var back: int = sim.sell_price(got)
		sim.sell(got)
		n += 1
		if sim.cash >= c0 or back >= paid:
			bad.append("%s: %d paid, %d back" % [str(it["base"]), paid, back])
	_check(n >= 3 and bad.is_empty(), "S2: a piece off the Fence's shelf sold straight back for what it cost or more (%d pieces): %s" % [n, str(bad)])
	_check(not gear.is_empty() and sim.sell_price(gear) > sim.price(gear), "S2: a piece that never was on the shelf is capped at the shelf's price too: %d against %d" % [sim.sell_price(gear) if not gear.is_empty() else -1, sim.price(gear) if not gear.is_empty() else -1])
	sim.load_dict(saved)
	main.refresh()
	print("fix A resale ok: boxes, meds and the shelf's pieces sell back under their price")


## S3: a save and a load during a repeat keep the runner's wounds from before it - the first run home rests off only the
## repeat's own.
func _fixa_wound_save_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	_fixa_prep(sim)
	var site := 0
	sim.wounds["chest"] = {"stat": "armour", "what": "cracked ribs", "from": "test", "hp_pct": 40}     # an earlier run's wound, as a run gives it
	sim._caches_out()
	sim.hp = sim.max_hp()
	_check(_fixa_gate(sim, site) and sim.start_repeat(site) and sim.away(), "S3: the fixture's repeat didn't set off: '%s'" % sim.repeat_block(site))
	var back = Sim.new()
	back.load_dict(JSON.parse_string(JSON.stringify(sim.to_dict())))
	var g := 0
	while back.away() and int(back.repeat.get("done", 0)) < 1 and g < 30000:
		back.advance(1.0)
		g += 1
	_check(not back.away() or int(back.repeat["done"]) >= 1, "S3: the loaded repeat's first run never came home")
	_check(sim.repeat.get("wounds0", {}).has("chest") and back.wounds.has("chest") and str(back.wounds["chest"].get("what", "")) == "cracked ribs", "S3: a save and load mid-repeat, and the first run home healed the wound from before it: %s" % str(back.wounds))
	sim.load_dict(saved)
	main.refresh()
	print("fix A wounds ok: a wound from before a repeat stays through a save")


## S7: Kev's "they hit harder" reaches the head, and every head of the convoy after it.
func _fixa_hard_wager_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	_fixa_prep(sim)
	_finish_campaign(sim)
	var head := -1
	for i in range(Data.TIERS.size()):
		if not sim.boss_of(i).is_empty() and sim.tier_open(i) and not sim.is_convoy(i) and i != Data.CONVOY_TIER:
			head = i
			break
	sim.best_depth[Data.CONVOY_TIER] = maxi(int(sim.best_depth[Data.CONVOY_TIER]), sim.convoy_depth())
	sim.depth[Data.CONVOY_TIER] = sim.convoy_depth()     # the Services at the convoy's level
	var sites: Array = [head, Data.CONVOY_TIER]
	_check(head >= 0 and sim.is_convoy(Data.CONVOY_TIER), "S7: the fixture: a head %d, the convoy %s" % [head, str(sim.is_convoy(Data.CONVOY_TIER))])
	var mid: Dictionary = sim.to_dict()
	for i in sites:
		if i < 0:
			continue
		sim.load_dict(mid)
		sim.boss_armed[i] = true
		sim.notes = 10000000
		sim._caches_out()
		var t: Dictionary = sim.effective(i)
		var plain: Array = ([t["boss"]] + t.get("boss_queue", [])).map(func(b): return float(b["dps"])) if t.has("boss") else []
		var key: String = sim.wager_site_key(i)
		var hit := false
		for sq in range(1, 400):
			sim.wagers[key] = {"seq": sq, "taken": []}
			var of: Array = sim.wager_offer(key)
			for k in range(of.size()):
				if not hit and str(of[k]["cond"]) == "hard":
					sim.wagers[key]["taken"] = [k]
					hit = true
			if hit:
				break
		sim.hp = sim.max_hp()
		sim.deploy(i)
		var m = sim.mission
		var now: Array = ([m["boss"]] + m.get("boss_queue", [])).map(func(b): return float(b["dps"])) if m != null and m.has("boss") else []
		var all_up: bool = plain.size() >= 1 and now.size() == plain.size() and range(plain.size()).all(func(k): return absf(float(now[k]) - float(plain[k]) * Data.WAGER_HARD) <= 0.001 * float(plain[k]) + 0.0001)
		_check(hit and m != null and m.get("wagers", []).any(func(w): return str(w["cond"]) == "hard") and all_up, "S7: Kev's harder hits didn't reach the head%s at %d: %s against %s" % [" and the convoy" if i == Data.CONVOY_TIER else "", i, str(now), str(plain)])
	sim.load_dict(saved)
	main.refresh()
	print("fix A hard wager ok: the head and the convoy hit harder")


## S9: a repeat packs the cures for its own site's zone, not the front's: one for another zone goes back for it.
func _fixa_repeat_cures_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	_fixa_prep(sim)
	var cure_base := func(el: String) -> String:
		for b in Data.BASES[Data.MEDICAL]:
			if str(b.get("cure", "")) == el:
				return str(b["name"])
		return ""
	var fe: Array = sim.zone_elements(sim.front_tier()).slice(0, Data.TOP_UP_CURES)
	var site := -1
	var want := ""
	for i in range(Data.TIERS.size()):
		if site >= 0 or not sim.tier_open(i) or int(sim.best_depth[i]) <= 0:
			continue
		for el in sim.zone_elements(i).slice(0, Data.TOP_UP_CURES):
			if site < 0 and not (el in fe) and cure_base.call(el) != "":
				site = i
				want = el
	_check(site >= 0 and sim.med_capacity() >= 2, "S9: the fixture: no cleared site throwing an element the front (%d, %s) doesn't, or no rig (%d pouches)" % [sim.front_tier(), str(fe), sim.med_capacity()])
	if site >= 0:
		var site_els: Array = sim.zone_elements(site).slice(0, Data.TOP_UP_CURES)
		var others: Array = Data.ELEMENTS.filter(func(el): return not (el in site_els) and cure_base.call(el) != "")
		sim.rig = []
		while sim.rig_room(1) and sim.rig.size() < 40 and not others.is_empty():
			sim.rig.append(sim._plain(Data.MEDICAL, cure_base.call(others[sim.rig.size() % others.size()])))     # the rig full of another zone's cures
		sim.stash = [sim._plain(Data.MEDICAL, cure_base.call(want))]
		_check(not others.is_empty() and not sim.rig_room(1), "S9: the fixture: the rig not full of other zones' cures")
		_fixa_repeat_at(sim, site)
		sim._repeat_go()
		_check(sim.unwatched() and sim.rig.any(func(x): return Items.cure_of(x) == want), "S9: a repeat at %s packed no cure for its %s: %s" % [str(Data.TIERS[site]["name"]), want, str(sim.rig.map(func(x): return str(x["base"])))])
	sim.load_dict(saved)
	main.refresh()
	print("fix A repeat cures ok: the site's own")


## T1: slotting a skill, or switching its rule, re-reads the site's odds.
func _fixa_skill_odds_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	_fixa_prep(sim)
	var sk := ""
	for ct in Data.trees_for(sim.cls):
		for k in range(ct.get("nodes", []).size()):
			if sk == "" and ct["nodes"][k].has("skill"):
				sim.tree.append("%s/%d" % [ct["name"], k])
				sk = str(ct["nodes"][k]["skill"])
	sim._caches_out()
	sim.skill_slots = ["", "", ""]
	sim.skill_auto = [true, true, true]
	var g := 0
	while not sim.odds_settled(0) and g < 400:
		sim.survival(0)
		g += 1
	var key0: Array = sim._odds_key(0)
	_check(sk != "" and sim.odds_settled(0) and sim.set_skill_slot(0, sk), "T1: the fixture: skill '%s', settled %s" % [sk, str(sim.odds_settled(0))])
	_check(sim._odds_key(0) != key0 and not sim.odds_settled(0), "T1: a skill slotted, the site kept its old odds")
	g = 0
	while not sim.odds_settled(0) and g < 400:
		sim.survival(0)
		g += 1
	var key1: Array = sim._odds_key(0)
	sim.set_skill_auto(0, false)
	_check(sim._odds_key(0) != key1 and not sim.odds_settled(0), "T1: a slot's rule switched off, the site kept its old odds")
	sim.load_dict(saved)
	main.refresh()
	print("fix A skill odds ok")


## T2: the Radio's crew row reads again when the benched class's runner moves - their XP, kit, tree or HP.
func _fixa_crew_odds_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	_fixa_prep(sim)
	if not ("radio" in sim.unlocked):
		sim.unlocked.append("radio")
	_finish_campaign(sim)
	sim.signals = []
	sim.papers = []
	for p in Words.PAPERS:
		if p.has("code") and sim.word_taught_by(str(p["name"])) != "" and sim.stash.size() < 1:
			sim.stash_put(sim._plain(Data.PAPER, str(p["name"])))
	var ps: Array = sim.signal_papers()
	var made: Dictionary = sim.decrypt(ps.slice(0, 1).map(func(x): return int(x["id"])), -1) if not ps.is_empty() else {}
	var cls0: String = sim.cls
	var other: String = "Doorman" if cls0 != "Doorman" else "Poacher"
	_check(not made.is_empty() and sim.set_class(other) and sim.set_class(cls0) and sim.roster.has(other), "T2: the fixture: a signal %s, the %s benched %s" % [str(not made.is_empty()), other, str(sim.roster.has(other))])
	if not made.is_empty() and sim.roster.has(other):
		var k: int = sim.signals.size() - 1
		var settle := func() -> bool:
			for r in range(600):
				if bool(sim.signal_odds_class(k, other)[1]):
					return true
			return false
		for mv in ["best", "XP", "HP", "kit"]:
			var ok: bool = settle.call()
			var before: Array = sim.signal_odds_class(k, other, true)
			var rr: Dictionary = sim.roster[other]
			if mv == "best":                  # the crew's best moved, the bench's own didn't: the level a press brings them out at did (the merge)
				sim.xp = maxf(sim.xp, Data.xp_for_level(mini(Data.MAX_LEVEL, maxi(sim.level(), Data.level_for_xp(float(rr.get("xp", 0.0)))) + 12)))
			elif mv == "XP":
				rr["xp"] = float(rr.get("xp", 0.0)) + Data.xp_for_level(30)
			elif mv == "HP":
				rr["hp"] = float(rr.get("hp", 1.0)) * 0.3
			elif rr["equipped"].get("Primary", null) != null:
				var g2: Dictionary = rr["equipped"]["Primary"].duplicate(true)
				Items._next_id += 1
				g2["id"] = Items._next_id
				rr["equipped"]["Primary"] = g2
			var after: Array = sim.signal_odds_class(k, other, true)
			_check(ok and bool(before[1]) and not bool(after[1]), "T2: the benched %s's %s moved, the crew row kept its read: %s then %s" % [other, mv, str(before), str(after)])
	sim.load_dict(saved)
	main.refresh()
	print("fix A crew odds ok")


## Refactor 2 (30 Oct): another class read the one way (read_as_class). Lifted, at the level a press brings them out at;
## not, at their own; rested, at full HP; nothing of the bench's or the one out's moved after. And a benched class
## that the crew's floor doesn't lift, rested, reads the same odds on the Radio's crew row as on the expeditions board
## for the same place - the place laid on the Radio as a held signal. Where they differ it's by design: the row reads
## the level a press brings them out at and their own HP (a press swaps them in as they are), the board their own level
## and full HP (a lead sets off rested and stays benched).
func _class_read_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	_fixa_prep(sim)
	_finish_campaign(sim)
	var radio_seen: Array = []
	var sim_lorries_seen := -1
	sim.xp = maxf(sim.xp, Data.xp_for_level(30))     # the one out well past a new class's floor
	var cls0: String = sim.cls
	var other: String = "Doorman" if cls0 != "Doorman" else "Poacher"
	_check(sim.set_class(other) and sim.set_class(cls0) and sim.roster.has(other), "class read: the fixture: the %s benched %s" % [other, str(sim.roster.has(other))])
	if sim.roster.has(other):
		var rr: Dictionary = sim.roster[other]
		rr["hp"] = 1.0                             # hurt on the bench, and at level 1: under the crew's floor
		rr["xp"] = 0.0
		var jl: int = sim.join_level(other)
		var own: int = sim.crew_level(other)
		var x0: float = sim.xp
		var hp0: float = sim.hp
		var looks := func() -> Array:
			return [sim.cls, sim.level(), sim.hp, sim.max_hp()]
		var lifted: Array = sim.read_as_class(other, looks, true, false)
		var board: Array = sim.read_as_class(other, looks, false, true)
		var mine: Array = sim.read_as_class(cls0, looks, true, true)
		_check(jl > own and str(lifted[0]) == other and int(lifted[1]) == jl and is_equal_approx(float(lifted[2]), 1.0), "class read: lifted and as they are, read at level %d HP %s (the floor %d, their own %d)" % [int(lifted[1]), str(lifted[2]), jl, own])
		_check(str(board[0]) == other and int(board[1]) == own and is_equal_approx(float(board[2]), float(board[3])), "class read: as a lead, read at level %d HP %s of %s (their own %d)" % [int(board[1]), str(board[2]), str(board[3]), own])
		_check(str(mine[0]) == cls0 and int(mine[1]) == sim.level() and is_equal_approx(float(mine[2]), float(mine[3])), "class read: the one out, rested, read as %s at HP %s of %s" % [str(mine[0]), str(mine[2]), str(mine[3])])
		_check(sim.cls == cls0 and sim.xp == x0 and sim.hp == hp0 and float(sim.roster[other]["hp"]) == 1.0 and sim.crew_level(other) == own, "class read: a read moved something: class %s, XP %s, HP %s, the bench's HP %s, level %d" % [sim.cls, str(sim.xp - x0), str(sim.hp - hp0), str(sim.roster[other]["hp"]), sim.crew_level(other)])
		# the bench at the crew's best, rested: no floor lifts them and both read them whole
		rr = sim.roster[other]
		rr["xp"] = maxf(float(rr.get("xp", 0.0)), sim.xp)
		rr["equipped"] = sim.equipped.duplicate(true)     # the one out's kit, at a far place's floor: odds to read, not a wall
		sim.reach = 0
		var p := 0
		for q in range(Data.EXP_PLACES.size()):
			if sim.exp_level(q) < sim.exp_level(p):
				p = q
		# the Yard's prestige on everyone's damage and HP, raised till the far fight reads between 0 and 1 (the
		# smoke's camp and an area's alone are kitted apart): a read the dice decide, not a wall or a walkover
		var lorries_at := -1
		for lv_l in [0, 5, 10, 15, 18, 20, 22, 25, 30, 40]:
			sim.lorries = lv_l
			var o_l: Array = [0.0, false]
			for r in range(600):
				o_l = sim.exp_odds(p, other)
				if bool(o_l[1]):
					break
			if float(o_l[0]) > 0.0 and (lorries_at < 0 or float(o_l[0]) < 1.0):
				lorries_at = lv_l
			if float(o_l[0]) > 0.0 and float(o_l[0]) < 1.0:
				break
		sim.lorries = maxi(0, lorries_at)
		var whole: float = float(sim.read_as_class(other, func() -> float: return sim.max_hp(), false, true))
		sim.roster[other]["hp"] = whole            # a read puts the bench back as a new entry: set it there
		sim.hp = sim.max_hp()
		var sg: Dictionary = sim._exp_sig(p)
		sim.signals.append(sg)
		var k: int = sim.signals.size() - 1
		var radio: Array = [0.0, false]
		var brd: Array = [0.0, false]
		for r in range(600):
			if not bool(radio[1]):
				radio = sim.signal_odds_class(k, other)
			if not bool(brd[1]):
				brd = sim.exp_odds(p, other)
			if bool(radio[1]) and bool(brd[1]):
				break
		radio_seen = [radio, brd]
		sim_lorries_seen = sim.lorries
		_check(sim.join_level(other) == sim.crew_level(other) and bool(radio[1]) and bool(brd[1]) and float(radio[0]) > 0.0 and is_equal_approx(float(radio[0]), float(brd[0])),
			"class read: the benched %s (level %d, the floor %d) reads %s on the Radio's row and %s on the board for %s" % [other, sim.crew_level(other), sim.join_level(other), str(radio), str(brd), str(sim.exp_place(p).get("key", ""))])
		# hurt on the bench: the row reads them as a press brings them out, hurt; the board still rested
		sim.roster[other]["hp"] = 1.0
		var hurt: Array = [0.0, false]
		var brd2: Array = [0.0, false]
		for r in range(600):
			if not bool(hurt[1]):
				hurt = sim.signal_odds_class(k, other)
			if not bool(brd2[1]):
				brd2 = sim.exp_odds(p, other)
			if bool(hurt[1]) and bool(brd2[1]):
				break
		_check(bool(hurt[1]) and float(hurt[0]) < float(radio[0]) and is_equal_approx(float(brd2[0]), float(brd[0])), "class read: hurt on the bench, the row read %s (whole %s), the board %s (whole %s)" % [str(hurt), str(radio), str(brd2), str(brd)])
	sim.load_dict(saved)
	main.refresh()
	print("class read ok: the row and the board %s, %s" % [str(radio_seen), "the lorries' prestige " + str(sim_lorries_seen)])


## T4: between a repeat's runs the rig's the runner's - no med in or out, no stack split, no parts stripped, and the
## Clinic's Into the rig shut.
func _fixa_rig_away_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	_fixa_prep(sim)
	var site := 0
	_check(_fixa_gate(sim, site) and sim.start_repeat(site), "T4: the fixture's repeat didn't set off: '%s'" % sim.repeat_block(site))
	var g := 0
	while sim.away() and int(sim.repeat.get("done", 0)) < 1 and g < 30000:
		sim.advance(1.0)
		g += 1
	if sim.on_mission():
		sim.extract_now()
	_check(sim.away() and sim.mission == null, "T4: the fixture: not resting between repeat runs")
	if sim.away() and sim.mission == null:
		var med: Dictionary = sim._plain(Data.MEDICAL, "Bandage")
		sim.stash.append(med)
		if sim.rig.is_empty():
			sim.rig.append(sim._plain(Data.MEDICAL, "Bandage"))
		var in_rig: Dictionary = sim.rig[0]
		var box := {}
		for b in Data.BASES[Data.AMMO]:
			if box.is_empty() and not b.has("damage_pct") and int(b["rounds"]) >= 2:
				box = sim._plain(Data.AMMO, str(b["name"]))
		sim.stash.append(box)
		var gun = sim.equipped["Primary"]
		var part_on := false
		if gun != null:
			for mount in gun["attachments"]:
				if part_on or gun["attachments"][mount] != null:
					part_on = part_on or gun["attachments"][mount] != null
					continue
				for ab in Data.ATTACHMENTS:
					if not part_on and str(ab.get("mount", "")) == str(mount):
						gun["attachments"][mount] = sim._plain(Data.ATTACHMENT, str(ab["name"]))
						part_on = true
		_check(not sim.take(int(med["id"])) and sim.stash.has(med) and not sim.leave(int(in_rig["id"])) and sim.rig.has(in_rig) and not sim.can_split(int(box["id"])) and part_on and not sim.can_strip_any("Primary"),
			"T4: between repeat runs the rig moved: take %s, leave %s, split %s, strip all lit %s" % [str(not sim.stash.has(med)), str(not sim.rig.has(in_rig)), str(sim.can_split(int(box["id"]))), str(sim.can_strip_any("Primary"))])
		main.show_room(main.MEDIC)
		main._clinic._show("stash")
		main.refresh()
		var mc = main._clinic._meds
		_check(mc.visible and mc._into.visible and mc._into.disabled, "T4: the Clinic's Into the rig live between repeat runs: shown %s, shut %s" % [str(mc._into.visible), str(mc._into.disabled)])
		main._clinic._show("shelf")
	sim.load_dict(saved)
	main.refresh()
	print("fix A rig away ok")


## Refactor 5 (30 Oct, review30; R4): runner_busy() on every kit move. Between a repeat's runs the Workshop's scrap,
## crafts, builds, stamp and patterns and the Fence's Take refuse, and each one's button is off; then the same fixture
## with the repeat taken off has every one of them open again, so each refusal is the guard's and not the fixture's.
func _r4_kit_away_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	_fixa_prep(sim)
	var site := 0
	_check(_fixa_gate(sim, site) and sim.start_repeat(site), "refactor 5: the fixture's repeat didn't set off: '%s'" % sim.repeat_block(site))
	var g := 0
	while sim.away() and int(sim.repeat.get("done", 0)) < 1 and g < 30000:
		sim.advance(1.0)
		g += 1
	if sim.on_mission():
		sim.extract_now()
	_check(sim.away() and sim.mission == null, "refactor 5: the fixture: not resting between repeat runs")
	if not (sim.away() and sim.mission == null):
		sim.load_dict(saved)
		main.refresh()
		return
	sim.cash = 1.0e7
	sim.notes = 100000
	sim.scrap = 100000
	sim.issued = true                         # the stamp's own first gate
	var piece: Dictionary = Items.roll("Primary", 6, sim.rng, 12)
	piece["affixes"] = [{"stat": "hp", "value": 20.0, "tier": 2}, {"stat": "damage_pct", "value": 10.0, "tier": 1}]
	piece.erase("unique")
	piece.erase("set")
	piece["rarity"] = Data.RARITIES.size() - 2      # under the top, room for another affix: the add job's open at home
	var st_slot := ""
	for sl in Data.SLOTS:
		if st_slot == "" and not sim.issued_def(sl).is_empty():
			st_slot = sl
	var to_stamp: Dictionary = sim._plain(st_slot, str(Data.BASES[st_slot][0]["name"])) if st_slot != "" else {}
	var u: Dictionary = Items.roll_unique(sim._unique_named("The Butcher's Steel"), sim.rng, 10)
	var rare: Dictionary = sim._plain("Primary", "Machete") if not sim._plain("Primary", "Machete").is_empty() else sim._plain("Primary", _base_of_type("melee"))
	rare["rarity"] = Data.PATTERN_RARITY
	sim.patterns = [{"unique": "The Butcher's Steel", "slot": "Primary", "rule": str(u.get("rule", ""))}]
	var c: Dictionary = sim.pattern_cost(rare)
	sim.key_items[str(c["key"])] = 1
	sim.materials[str(c["material"])] = int(c["material_n"])
	var nade: Dictionary = sim._plain(Data.GRENADE, str(Data.BASES[Data.GRENADE][0]["name"]))
	sim.rig = []                              # pouches free for the Take (the whole smoke's bot leaves it full)
	if sim.med_capacity() == 0:
		sim.equipped["Rig"] = sim._plain("Rig", str(Data.BASES["Rig"][0]["name"]))
	sim.stash.append_array([piece, u, rare, nade] + ([to_stamp] if not to_stamp.is_empty() else []))
	var med := ""
	for o in sim.build_options("med"):
		if med == "" and str(o["from"]) == "":
			med = str(o["name"])
	var ws = main._workshop
	var fe = main._fence
	# the sim's answers and the buttons', read the same way away and at home
	var read := func() -> Dictionary:
		var r := {}
		r["can_craft"] = sim.can_craft(int(piece["id"]), "add")
		r["build_ok"] = bool(sim.build_option("med", med).get("ok", false))
		r["stamp"] = sim.stamp_block(to_stamp) == "" if not to_stamp.is_empty() else false
		r["break"] = sim.can_break(u) == ""
		r["pattern"] = sim.pattern_block(rare, 0) == ""
		main.show_room(main.WORKSHOP)
		ws._set_view("craft")
		ws.sel_id = int(piece["id"])
		ws._shown = ""
		main.refresh()
		r["add_tile"] = not ws._job_tiles[ws.JOBS.find("add")]["button"].disabled
		r["scrap_tile"] = not ws._job_tiles[ws.JOBS.find("scrap")]["button"].disabled
		r["reroll"] = ws._affix_buttons[0].visible and not ws._affix_buttons[0].disabled
		if not to_stamp.is_empty():
			ws.sel_id = int(to_stamp["id"])
			ws._shown = ""
			main.refresh()
			r["stamp_tile"] = not ws._job_tiles[ws.JOBS.find("stamp")]["button"].disabled
		if not ws._inv.many:
			ws._inv._toggle_many()
		ws._inv.chosen = [int(piece["id"])]
		ws._inv._shown = ""
		ws._shown = ""
		main.refresh()
		r["scrap_many"] = ws._inv._sell_button.visible and not ws._inv._sell_button.disabled
		ws._inv._toggle_many()
		ws._set_view("build")
		ws.build_kind = "med"
		ws.sel_build = med
		ws._shown = ""
		main.refresh()
		r["build_button"] = ws._pick._buttons[0].visible and not ws._pick._buttons[0].disabled
		r["build_foot"] = ws._builds_foot.text
		ws._set_view("patterns")
		ws.sel_id = int(u["id"])
		ws._shown = ""
		main.refresh()
		r["break_button"] = not ws._pat_break.disabled
		ws.sel_id = int(rare["id"])
		ws.sel_pattern = 0
		ws._shown = ""
		main.refresh()
		r["put_button"] = not ws._pat_put.disabled
		ws.sel_pattern = -1
		ws.sel_id = -1
		ws._set_view("guns")
		main.show_room(main.MARKET)
		fe._show("stash")
		fe._stash.tab = ""                    # the shared tab, its first page, no filter: where the grenade lies (the whole smoke leaves it elsewhere)
		fe._stash.page = 0
		fe._stash.kind = 0
		fe._stash.rarity = -1
		if fe._stash.many:
			fe._stash._toggle_many()
		main.refresh()
		var k: int = fe._stash.cell_of(int(nade["id"]))
		for p in range(8):
			if k < 0:
				fe._stash._turn(1)
				main.refresh()
				k = fe._stash.cell_of(int(nade["id"]))
		if k >= 0:
			fe._stash._pick(k)
			main.refresh()
		r["take"] = k >= 0 and fe._buttons[0].visible and fe._buttons[0].text == "Take" and not fe._buttons[0].disabled
		r["take_room"] = "%d %s" % [k, str(sim.rig_room(Items.size(nade)))]     # for the message, not a verdict
		fe._show("shelf")
		return r
	var away: Dictionary = read.call()
	var lit: Array = away.keys().filter(func(key): return not (key in ["build_foot", "take_room"]) and bool(away[key]))
	_check(lit.is_empty(), "refactor 5: between repeat runs these kit moves are open: %s" % str(lit))
	_check(not sim.scrap_item(int(piece["id"])) and sim.stash.has(piece) and not sim.craft(int(piece["id"]), "add") and piece["affixes"].size() == 2 and not sim.build("med", med)
		and not sim.break_unique(u) and sim.stash.has(u) and not sim.apply_pattern(rare, 0) and not rare.has("pattern") and (to_stamp.is_empty() or not sim.stamp(int(to_stamp["id"]))),
		"refactor 5: between repeat runs a kit move went through: stash %d, affixes %d, patterns %d, rare %s" % [sim.stash.size(), piece["affixes"].size(), sim.patterns.size(), str(rare.get("pattern", ""))])
	_check(sim.build_option("med", med).get("why", "") == Words.REPEAT["shut_away"] and away["build_foot"] == "%s: the Bench waits" % Words.REPEAT["shut_away"] and sim.can_break(u) == Words.REPEAT["shut_away"],
		"refactor 5: away, the Bench doesn't say the runner's away: build '%s', foot '%s', break '%s'" % [sim.build_option("med", med).get("why", ""), away["build_foot"], sim.can_break(u)])
	_check(not to_stamp.is_empty() and away.has("stamp_tile"), "refactor 5: the fixture has no slot with an issued piece to stamp")
	# the control: the repeat off, the very same things open
	var rep: Dictionary = sim.repeat
	sim.repeat = {}
	var home: Dictionary = read.call()
	var shut: Array = home.keys().filter(func(key): return not (key in ["build_foot", "take_room"]) and not bool(home[key]))
	_check(shut.is_empty() and home["build_foot"] == "", "refactor 5: the control: with the repeat off these are still shut (the fixture, not the guard): %s, foot '%s', the Take's cell and rig room %s" % [str(shut), home["build_foot"], home["take_room"]])
	sim.repeat = rep
	sim.load_dict(saved)
	main.refresh()
	print("refactor 5 kit away ok")


## Refactor 5's art rule (30 Oct, R4): Items.slug is the one art-name rule (the old site key dropped apostrophes and
## kept hyphens; the items', hands', nodes' and places' rules were copies). Every site, zone, head and County picture on
## disk is the slug of a name the game has, so none is orphaned by the rule; the rule's own cases.
## The clean-up's merge (30 Oct): a rig left full of heals (from a bat's days) still gets the gun's magazines to their
## share, its best heal kept; and the bot packs its rig on "fill" even from a save set to "Leave it", buying no heal it
## can't pack.
func _cleanup31_checks() -> void:
	var s = Sim.new()
	s.start()
	s.equipped["Rig"] = s._plain("Rig", "Chest rig")
	s.equipped["Primary"] = s._plain("Primary", _base_of_type("smg"))
	s.equipped["Secondary"] = null
	var cap: int = s.med_capacity()
	s.rig = [_mag_full(s, "SMG magazine", "SMG rounds")]
	while s.rig_used() < cap:
		s.rig.append(s._plain(Data.MEDICAL, "Bandage"))
	s.stash = [s._plain(Data.AMMO, "SMG rounds")]
	Items.set_stack(s.stash[0], 3000)
	for k in range(cap):
		s.stash.append(s._plain(Data.MAGAZINE, "SMG magazine"))
	s.set_top_up("fill")
	s._top_up()
	var share: int = 1                        # BUILD48 A (item 24, Matt's pick): the one that went out, the heals left alone (was the magazines' share)
	var pouches: int = s.rig.filter(func(x): return Items.is_mag(x)).size()
	_check(cap >= 4 and pouches == share and s.rig.filter(func(x): return Items.is_heal(x)).size() == cap - 1 and s.rig_used() <= cap,
		"a rig full of heals kept the gun at %d pouches of its %d: %s" % [pouches, share, str(s.rig.map(func(x): return str(x["base"])))])
	# the bot on a save set to "Leave it"
	var b = Sim.new()
	b.start()
	b.equipped["Rig"] = b._plain("Rig", "Chest rig")
	b.equipped["Primary"] = b._plain("Primary", _base_of_type("smg"))
	b.equipped["Secondary"] = null
	b.rig = []
	b.stash = [b._plain(Data.AMMO, "SMG rounds"), b._plain(Data.MEDICAL, "Bandage"), b._plain(Data.MEDICAL, "Bandage"), b._plain(Data.MAGAZINE, "SMG magazine")]
	Items.set_stack(b.stash[0], 3000)
	b.cash = 5000
	b.set_top_up("leave")
	var bot = Bot.new()
	var heals: Array = []
	for k in range(3):
		bot._restock_meds(b)
		heals.append(b.stash.filter(func(x): return Items.is_heal(x)).size())
	_check(b.rounds_for(b.equipped["Primary"]) > 0 and b.rig.any(func(x): return Items.is_heal(x)) and heals[2] <= heals[0],
		"the bot on 'Leave it': %d rounds packed, heals in the stash %s, rig %s" % [b.rounds_for(b.equipped["Primary"]), str(heals), str(b.rig.map(func(x): return str(x["base"])))])
	print("the clean-up's merge ok: magazines to their share past spare heals, the bot packs on fill")


