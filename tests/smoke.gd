## Which of the kit key's parts differ (the try-on flake, 21 Oct), by index: equipped 0 ... the rig's size 7, the pack 8.
func _parts_changed(a: Array, b: Array) -> String:
	var out := []
	for i in range(mini(a.size(), b.size())):
		if str(a[i]) != str(b[i]):
			out.append("%d: %s -> %s" % [i, str(a[i]).left(80), str(b[i]).left(80)])
	return (", " + "; ".join(out)) if not out.is_empty() else ""


## Skills (24 Oct, milestone 8: docs/design/skills.md §8): the loadout and its lock, energy and cooldowns in bounds,
## each rule firing when its condition holds and not otherwise, the press and the switch, each effect ending on time,
## the real fight casting, the odds' key reading the loadout, the save.
func _skills_checks(sim) -> void:
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.yard_picks.erase("generator")
	sim.yard_ranks.erase("generator")
	sim._yard_changed("")
	# the Poacher's tree teaches his eight: four a lane on the hung notables, the fourth the signature
	_set_cls(sim, "Poacher")
	var sk_ids: Dictionary = _skill_node_ids()
	_check(sk_ids.size() == Data.SKILLS.size() and Data.SKILLS.size() == 8 * Data.CLASSES.size() and Data.SKILLS.keys().all(func(k): return sk_ids.has(k)), "the trees don't hold every class's eight skills: %d of %d" % [sk_ids.size(), Data.SKILLS.size()])
	for t in Data.TREES:
		if str(t.get("class", "")) == "":
			continue
		var lane: String = str(t["name"])
		var in_lane: Array = sk_ids.keys().filter(func(k): return str(sk_ids[k]).begins_with(lane + "/"))
		_check(in_lane.size() == 4 and in_lane.filter(func(k): return Data.SKILLS[k].get("signature", false)).size() == 1 and in_lane.all(func(k): return Data.SKILLS[k]["lane"] == lane and Data.SKILLS[k]["cls"] == t["class"]), "%s holds %s" % [lane, str(in_lane)])
		for k in in_lane:
			_check(Data.SKILL_RULES.has(str(Data.SKILLS[k]["rule"])) and str(Data.SKILLS[k].get("kind", "")) in ["damage", "cleanse", "control", "defence"], "%s's rule or kind isn't one: %s / %s" % [k, Data.SKILLS[k]["rule"], Data.SKILLS[k].get("kind", "")])
	for k in sk_ids:
		_check(sim.node(sk_ids[k])["name"] == Data.SKILLS[k]["name"] and str(sim.node(sk_ids[k])["words"]) == Data.SKILLS[k]["line"], "%s's node isn't named and worded as the skill" % k)
	sim.tree = sim.tree.filter(func(id): return not sk_ids.values().has(id))
	_check(not sim.set_skill_slot(0, "clean_shot") and sim.skills_learnt().is_empty(), "an unlearnt skill went in a slot")
	sim.skill_slots = ["", "", ""]
	sim.training_points += 40
	var path_to: String = sk_ids["clean_shot"]
	for step_i in range(12):
		if sim.tree.has(path_to):
			break
		var nxt: String = path_to if sim.touches_trained(path_to) or sim.node(path_to).get("entry", false) else sim.path_next(path_to)
		if nxt == "" or not sim.train_node(nxt):
			break
	_check(sim.tree.has(path_to) and sim.skill_slots[0] == "clean_shot", "training Clean shot didn't teach it into the first empty slot: %s, slots %s" % [str(sim.tree.has(path_to)), str(sim.skill_slots)])
	for k in sk_ids:
		if not sim.tree.has(sk_ids[k]):
			sim.tree.append(sk_ids[k])
	_check(sim.skills_learnt().size() == 8, "the trained skill nodes don't teach their skills: %s" % str(sim.skills_learnt()))
	_check(sim.set_skill_slot(0, "clean_shot") and sim.set_skill_slot(1, "collared") and sim.set_skill_slot(2, "gin_trap"), "a learnt skill would not go in a slot")
	_check(sim.set_skill_slot(1, "clean_shot") and sim.skill_slots[0] == "" and sim.skill_slots[1] == "clean_shot", "a skill sat in two slots: %s" % str(sim.skill_slots))
	sim.set_skill_slot(0, "clean_shot")
	sim.set_skill_slot(1, "collared")
	_check(not sim.set_skill_slot(0, "no_such_skill"), "a skill that isn't one went in a slot")
	var key0: int = sim._kit_key()
	sim.set_skill_auto(0, false)
	_check(sim._kit_key() != key0, "the odds' key doesn't read a slot's rule switched off")
	sim.set_skill_auto(0, true)
	sim.set_skill_slot(2, "decoy")
	_check(sim._kit_key() != key0, "the odds' key doesn't read the loadout")
	sim.set_skill_slot(2, "gin_trap")
	sim.hp = sim.max_hp()
	sim.deploy(0)
	var m: Dictionary = sim.mission
	var t: Dictionary = m["t"]
	_check(not sim.set_skill_slot(0, "decoy") and sim.skill_slots[0] == "clean_shot", "the loadout changed on a run")
	# a fight starts full and ready
	_check(m.has("sk") and is_equal_approx(sim.energy_now(), sim.max_energy()) and sim.skill_wait(0) == 0.0 and sim.skill_wait(2) == 0.0, "a fight didn't start with full energy and every skill ready: %s" % str(m.get("sk", {})))
	_check(is_equal_approx(sim.max_energy(), Data.ENERGY_POOL) and is_equal_approx(sim.energy_regen(), Data.ENERGY_REGEN * (1.0 + (sim.pace() - 1.0) * Data.ENERGY_PACE_SHARE)), "energy's figures: %.1f max, %.2f a second" % [sim.max_energy(), sim.energy_regen()])
	_check(sim.cooldown_cut() <= Data.CDR_CAP and is_equal_approx(sim.skill_cooldown("clean_shot"), 8.0 * (1.0 - sim.cooldown_cut() / 100.0)), "a cooldown is off: %.2f" % sim.skill_cooldown("clean_shot"))
	# the rules, staged: each holds when its condition does and not otherwise
	var holds := func(rule: String, on_you: int) -> bool: return sim._skill_rule_holds(m, t, rule, on_you)
	_check(not holds.call("on_you_2", 1) and holds.call("on_you_2", 2) and not holds.call("on_you_3", 2) and holds.call("on_you_3", 3), "the crowd rules are off")
	sim.hp = sim.max_hp() * 0.6
	var half_off: bool = holds.call("under_half", 1)
	sim.hp = sim.max_hp() * 0.4
	_check(not half_off and holds.call("under_half", 1), "Under half HP is off")
	sim.hp = sim.max_hp()
	m["my_dots"] = {}
	var ail_off: bool = holds.call("ailing", 1)
	m["my_dots"] = {"bleed": 5.0}
	_check(not ail_off and holds.call("ailing", 1), "Ailing is off")
	m["my_dots"] = {}
	m["target_hp"] = float(t["hp"]) * 0.5
	var fin_off: bool = holds.call("finisher", 1)
	m["target_hp"] = float(t["hp"]) * 0.2
	_check(not fin_off and holds.call("finisher", 1), "Finisher is off")
	m["target_hp"] = float(t["hp"])
	m["sk"]["fight_t"] = 1.0
	var op_on: bool = holds.call("opener", 1)
	m["sk"]["fight_t"] = Data.OPENER_S + 1.0
	_check(op_on and not holds.call("opener", 1), "Opener is off")
	# never without the energy, never off its cooldown; the dearest first, one a tick
	m["remaining"] = maxi(2, int(m["remaining"]))
	m["sk"]["energy"] = 10.0
	var c0: int = int(m["sk"]["cast"])
	sim._skills_tick(m, t, 0.0, 1)
	_check(int(m["sk"]["cast"]) == c0, "a skill fired without the energy for it")
	m["sk"]["energy"] = sim.max_energy()
	sim._skills_tick(m, t, 0.0, 2)
	_check(int(m["sk"]["cast"]) == c0 + 1 and str(m["sk"]["last"]["id"]) == "gin_trap", "the dearest ready skill didn't go first: %s" % str(m["sk"].get("last", {})))
	sim._skills_tick(m, t, 0.0, 2)
	_check(int(m["sk"]["cast"]) == c0 + 2 and str(m["sk"]["last"]["id"]) != "gin_trap", "the second skill didn't wait its tick and then go: %s" % str(m["sk"].get("last", {})))
	var e1: float = float(m["sk"]["energy"])
	_check(e1 >= 0.0 and e1 <= sim.max_energy(), "energy left its bounds: %.1f" % e1)
	for k in range(200):
		sim._skills_tick(m, t, 0.05, 0)
		_check(float(m["sk"]["energy"]) >= 0.0 and float(m["sk"]["energy"]) <= sim.max_energy() + 0.001, "energy left its bounds while it refilled: %.2f" % float(m["sk"]["energy"]))
	# the press and the switch: off, it never fires by itself; pressed, it fires once
	sim._skills_fight_start(m)
	for i in range(3):
		sim.set_skill_auto(i, false)
	c0 = int(m["sk"]["cast"])
	sim._skills_tick(m, t, 0.0, 3)
	_check(int(m["sk"]["cast"]) == c0, "a slot switched off fired by itself")
	_check(sim.press_skill(1), "a ready skill wouldn't take a press")
	sim._skills_tick(m, t, 0.0, 1)
	sim._skills_tick(m, t, 0.0, 1)
	_check(int(m["sk"]["cast"]) == c0 + 1 and str(m["sk"]["last"]["id"]) == "collared", "a press didn't fire once: %d casts" % (int(m["sk"]["cast"]) - c0))
	_check(not sim.press_skill(1) and sim.skill_wait(1) > 0.0, "a skill on its cooldown took a press")
	for i in range(3):
		sim.set_skill_auto(i, true)
	# each effect, and its end on time
	var fire := func(id: String) -> void:
		sim.skill_slots[0] = id
		m["sk"]["energy"] = sim.max_energy()
		m["sk"]["cd"] = [0.0, 0.0, 0.0]
		sim._skill_fire(m, t, 0)
	var run_down := func(secs: float) -> void:
		var left := secs
		while left > 0.0:
			sim._skills_tick(m, t, minf(0.25, left), 0)
			left -= 0.25
	sim._skills_fight_start(m)
	sim.skill_slots = ["", "", ""]
	fire.call("clean_shot")
	var on_hit: float = sim._skill_hit_mult(m)
	run_down.call(1.1)
	_check(is_equal_approx(on_hit, 2.5) and is_equal_approx(sim._skill_hit_mult(m), 1.0), "Clean shot: ×%.2f, then ×%.2f" % [on_hit, sim._skill_hit_mult(m)])
	fire.call("flush_them_out")
	on_hit = sim._skill_hit_mult(m)
	run_down.call(8.1)
	_check(is_equal_approx(on_hit, 1.2) and is_equal_approx(sim._skill_hit_mult(m), 1.0), "Flush them out: ×%.2f, then ×%.2f" % [on_hit, sim._skill_hit_mult(m)])
	m["my_dots"] = {"bleed": 9.0, "poison": 9.0, "fire": 9.0}
	fire.call("go_to_ground")
	var in_hid: float = sim._skill_in_mult(m, 3)
	_check(not m["my_dots"].has("bleed") and not m["my_dots"].has("poison") and m["my_dots"].has("fire"), "Go to ground didn't clear the bleed and the poison alone: %s" % str(m["my_dots"]))
	run_down.call(3.1)
	_check(in_hid == 0.0 and is_equal_approx(sim._skill_in_mult(m, 3), 1.0), "Go to ground: ×%.2f in, then ×%.2f" % [in_hid, sim._skill_in_mult(m, 3)])
	m["my_dots"] = {}
	fire.call("collared")
	var in_one: float = sim._skill_in_mult(m, 2)
	run_down.call(3.1)
	_check(is_equal_approx(in_one, 0.5) and is_equal_approx(sim._skill_in_mult(m, 2), 1.0), "Collared, two on you: ×%.2f in, then ×%.2f" % [in_one, sim._skill_in_mult(m, 2)])
	fire.call("decoy")
	var in_dec: float = sim._skill_in_mult(m, 3)
	run_down.call(6.1)
	_check(is_equal_approx(in_dec, 0.7) and is_equal_approx(sim._skill_in_mult(m, 3), 1.0), "Decoy: ×%.2f in, then ×%.2f" % [in_dec, sim._skill_in_mult(m, 3)])
	m["dots"] = {}
	fire.call("net_every_hole")
	var in_net: float = sim._skill_in_mult(m, 4)
	_check(float(m["dots"].get("bleed", 0.0)) > 0.0, "Net every hole didn't start a bleed")
	run_down.call(2.1)
	_check(in_net == 0.0 and is_equal_approx(sim._skill_in_mult(m, 4), 1.0), "Net every hole: ×%.2f in, then ×%.2f" % [in_net, sim._skill_in_mult(m, 4)])
	# an effect cast inside a tick lasts its length, at the frame's step, the bot's and the dry runs' (the review: a
	# skill set mid-tick counted that tick twice)
	var cover := func(id: String, on_you: int, frac: Callable, step: float) -> float:
		sim.skill_slots = [id, "", ""]
		sim._skills_fight_start(m)
		m["my_dots"] = {"bleed": 50.0} if id == "go_to_ground" else {}
		var secs := 0.0
		var ticks: int = int(ceil((float(sim.skill(id)["fx"].values().filter(func(v): return v is float).max()) + 2.0 * step) / step))
		for k in range(ticks):
			sim._skills_tick(m, t, step, on_you)
			secs += float(frac.call()) * step
		m["my_dots"] = {}
		return secs
	for step in [0.25, 1.0, sim.DRY_STEP]:
		var cs: float = cover.call("clean_shot", 1, func() -> float: return (sim._skill_hit_mult(m) - 1.0) / 1.5, step)
		var gg: float = cover.call("go_to_ground", 3, func() -> float: return 1.0 - sim._skill_in_mult(m, 3), step)
		var co: float = cover.call("collared", 2, func() -> float: return (1.0 - sim._skill_in_mult(m, 2)) / 0.5, step)
		_check(absf(cs - 1.0) < 0.01 and absf(gg - 3.0) < 0.01 and absf(co - 3.0) < 0.01, "at a %.2f s step: Clean shot covers %.2f s (want 1), Go to ground %.2f (3), Collared %.2f (3)" % [step, cs, gg, co])
	# a fight's effects end with it
	fire.call("net_every_hole")
	sim._skills_fight_start(m)
	_check(is_equal_approx(sim._skill_in_mult(m, 3), 1.0), "Net every hole held the next gang's fire")
	m["target_hp"] = float(t["hp"]) * 0.2
	fire.call("one_for_the_pot")
	_check(float(m["target_hp"]) <= 0.0, "One for the pot left him standing: %.1f" % float(m["target_hp"]))
	# Gin trap waits for the next man, then springs once
	m["target_hp"] = float(t["hp"])
	m["dots"] = {}
	fire.call("gin_trap")
	sim._skills_tick(m, t, 0.0, 0)
	_check(is_equal_approx(float(m["target_hp"]), float(t["hp"])), "Gin trap sprang on the man already in front")
	m["sk"]["seq"] = int(m["sk"]["seq"]) + 1
	var before_trap: float = float(m["target_hp"])
	sim._skills_tick(m, t, 0.0, 0)
	_check(absf(before_trap - float(m["target_hp"]) - _skill_hit_expected(sim, m, 3.0)) < 0.01 and float(m["dots"].get("bleed", 0.0)) > 0.0, "Gin trap on the next man: %.1f off, bleed %s" % [before_trap - float(m["target_hp"]), str(m["dots"])])
	before_trap = float(m["target_hp"])
	m["sk"]["seq"] = int(m["sk"]["seq"]) + 1
	sim._skills_tick(m, t, 0.0, 0)
	_check(is_equal_approx(float(m["target_hp"]), before_trap), "Gin trap sprang twice")
	# the Generator: Pilot light's first free, Kickback's energy a kill
	sim.yard_picks["generator"] = ["", "", "b", "", "a"]
	sim._yard_changed("")
	sim.skill_slots = ["clean_shot", "collared", "gin_trap"]
	sim._skills_fight_start(m)
	_check(sim.skill_cost_now(0) == 0.0 and sim.skill_cost_now(2) == 0.0, "Pilot light's first skill isn't free")
	sim._skill_fire(m, t, 0)
	_check(is_equal_approx(sim.energy_now(), sim.max_energy()) and sim.skill_cost_now(1) == 25.0, "Pilot light: %.1f energy after the free one, the next costs %.1f" % [sim.energy_now(), sim.skill_cost_now(1)])
	m["sk"]["energy"] = 40.0
	m["remaining"] = 3
	m["target_hp"] = -1.0
	for i in range(3):
		sim.set_skill_auto(i, false)
	sim._fight(m, t, 0.001)
	_check(float(m["sk"]["energy"]) >= 45.0 - 0.01, "Kickback didn't give energy on a kill: %.2f" % float(m["sk"]["energy"]))
	# "3+ on you" counts everyone in the fight, not just those firing (Matt's call 3): one at a time, three in it
	sim.yard_picks.erase("generator")
	sim._yard_changed("")
	sim.skill_slots = ["net_every_hole", "", ""]
	for i in range(3):
		sim.set_skill_auto(i, true)
	sim._skills_fight_start(m)
	m["remaining"] = 3
	m["target_hp"] = float(t["hp"])
	var one_at: Dictionary = t.duplicate()
	one_at["contact"] = 1 - sim.CONTACT
	c0 = int(m["sk"]["cast"])
	sim._fight(m, one_at, 0.001)
	_check(sim.contact(one_at) == 1 and int(m["sk"]["cast"]) == c0 + 1, "with one firing and three in the fight, a 3+ skill didn't fire (contact %d)" % sim.contact(one_at))
	# a run's skills come through a save mid-fight
	m["sk"]["energy"] = 33.0
	var mid: Dictionary = JSON.parse_string(JSON.stringify(sim.to_dict()))
	sim.load_dict(mid)
	m = sim.mission
	_check(m != null and m.has("sk") and is_equal_approx(float(m["sk"]["energy"]), 33.0) and m["sk"]["cd"].size() == 3, "a run's skills didn't come through a save")
	sim.skill_slots = ["clean_shot", "collared", "gin_trap"]
	for i in range(3):
		sim.set_skill_auto(i, true)
	sim.yard_picks.erase("generator")
	sim._yard_changed("")
	sim.extract_now()
	# the odds see the skills: the same seeded dry run with and without Clean shot, Net every hole and Collared reads a
	# different fight - its length or what reached HP - at a site that's a real fight for this camp (a strong one walks
	# the Allotments in a step)
	var plain: Dictionary = {}
	var skilled: Dictionary = {}
	for ti in range(Data.TIERS.size() - 1, -1, -1):
		var r1 := RandomNumberGenerator.new()
		r1.seed = 7
		sim.skill_slots = ["", "", ""]
		sim.hp = sim.max_hp()
		sim._dry_run(ti, r1)
		if float(sim._dry_last["elapsed"]) < 4.0 * sim.DRY_STEP and ti > 0:
			continue
		plain = sim._dry_last.duplicate()
		var r2 := RandomNumberGenerator.new()
		r2.seed = 7
		sim.skill_slots = ["clean_shot", "net_every_hole", "collared"]
		sim._dry_run(ti, r2)
		skilled = sim._dry_last.duplicate()
		break
	_check(float(plain["elapsed"]) != float(skilled["elapsed"]) or float(plain["taken"]) != float(skilled["taken"]), "the dry runs read the same fight with skills and without: %.1f s, %.1f taken both" % [float(plain["elapsed"]), float(plain["taken"])])
	sim.skill_slots = ["clean_shot", "collared", "gin_trap"]
	# the real fight casts: a run of the Allotments with Clean shot on When ready
	sim.hp = sim.max_hp()
	sim.deploy(0)
	var casts := 0
	for k in range(60):
		if not sim.on_mission() or sim.mission["remaining"] <= 0:
			break
		sim.advance(0.25)
		if sim.on_mission():
			casts = maxi(casts, int(sim.mission.get("sk", {}).get("cast", 0)))
	_check(casts > 0, "the fight never cast a skill")
	if sim.on_mission():
		sim.extract_now()
	# the save keeps the learnt, the slots and the switches
	sim.set_skill_auto(2, false)
	var d: Dictionary = JSON.parse_string(JSON.stringify(sim.to_dict()))
	sim.load_dict(d)
	_check(sim.skills_learnt().size() == 8 and sim.skill_slots == ["clean_shot", "collared", "gin_trap"] and sim.skill_auto == [true, true, false], "the skills didn't come through a save: %s %s" % [str(sim.skill_slots), str(sim.skill_auto)])
	# the bot's three (3d): its best damage skill, the cleanse for what the site fires, a control or defensive one
	var bot_b = Bot.new()
	var poison_at := -1
	for ti in range(Data.TIERS.size()):
		var tys: Dictionary = sim.effective(ti).get("types", {})
		if poison_at < 0 and float(tys.get("poison", 0.0)) > 0.0:
			poison_at = ti
	if poison_at >= 0:
		bot_b.pick_skills(sim, poison_at)
		_check(sim.skill_slots == ["one_for_the_pot", "go_to_ground", "net_every_hole"] and sim.skill_auto == [true, true, true], "the bot's three at a poison site: %s" % str(sim.skill_slots))
	_check(poison_at >= 0, "no poison site to read the bot's three at")
	bot_b.pick_skills(sim, -1)                      # no site: nothing ails
	_check(sim.skill_slots == ["one_for_the_pot", "net_every_hole", "decoy"], "the bot's three where nothing ails: %s" % str(sim.skill_slots))
	_set_cls(sim, "Doorman")
	bot_b.pick_skills(sim, -1)
	_check(sim.skill_slots == ["", "", ""], "a Doorman bot kept the Poacher's skills: %s" % str(sim.skill_slots))
	_set_cls(sim, "Poacher")
	for k in sk_ids:
		if not sim.tree.has(sk_ids[k]):
			sim.tree.append(sk_ids[k])
	sim.skill_slots = ["clean_shot", "collared", "gin_trap"]
	sim.skill_auto = [true, true, false]
	# only your class's: another runner with the Poacher's nodes on the camp's tree has none of his skills, and a slot
	# of his never fires for them
	_set_cls(sim, "Doorman")
	for k in sk_ids:
		if not sim.tree.has(sk_ids[k]):
			sim.tree.append(sk_ids[k])
	_check(not sim.skills_learnt().any(func(k): return Data.SKILLS[k]["cls"] == "Poacher") and not sim.skill_known("clean_shot"), "a Doorman has the Poacher's skills: %s" % str(sim.skills_learnt()))
	_set_cls(sim, "Poacher")
	# the cooldown cap: the kit's and the Flywheel's past 40% stop at 40
	if sim.equipped["Helmet"] == null:
		sim.equipped["Helmet"] = sim._plain("Helmet", Data.BASES["Helmet"][0]["name"])
	var helm = sim.equipped["Helmet"]
	_check(helm != null, "no helmet to stage the skills' affixes on")
	if helm != null:
		helm["affixes"].append({"stat": "cdr_pct", "value": 39.0})
		sim.yard_picks["generator"] = ["", "", "", "a", ""]
		sim._yard_changed("")
		_check(is_equal_approx(sim.cooldown_cut(), Data.CDR_CAP) and is_equal_approx(sim.skill_cooldown("clean_shot"), 8.0 * 0.6), "the cooldown cap: %.1f%%, Clean shot %.2f s" % [sim.cooldown_cut(), sim.skill_cooldown("clean_shot")])
		helm["affixes"].pop_back()
		helm["affixes"].append({"stat": "energy_max", "value": 10.0})
		helm["affixes"].append({"stat": "energy_regen_pct", "value": 8.0})
		_check(is_equal_approx(sim.max_energy(), Data.ENERGY_POOL + 10.0) and is_equal_approx(sim.energy_regen(), Data.ENERGY_REGEN * (1.0 + (sim.pace() - 1.0) * Data.ENERGY_PACE_SHARE) * 1.08), "the energy affixes: %.1f max, %.3f a second" % [sim.max_energy(), sim.energy_regen()])
		var lines: Array = Items.affix_lines({"affixes": [{"stat": "cdr_pct", "value": 8.0}, {"stat": "energy_regen_pct", "value": 8.0}, {"stat": "energy_max", "value": 10.0}]})
		_check(lines == ["8% shorter cooldowns", "+8% energy gain", "+10 max energy"], "the skills' affixes read: %s" % str(lines))
		helm["affixes"].pop_back()
		helm["affixes"].pop_back()
	sim.load_dict(saved)
	print("skills ok: the loadout and its lock, energy, cooldowns, the rules, the press, eight effects, a real fight's casts, the save")


## The skill nodes on the trees, skill id -> node id.
func _skill_node_ids() -> Dictionary:
	var out := {}
	for t in Data.TREES:
		var nodes: Array = Data.tree_named(str(t["name"]))["nodes"]
		for k in range(nodes.size()):
			if nodes[k].has("skill"):
				out[str(nodes[k]["skill"])] = "%s/%d" % [t["name"], k]
	return out


## The skills on screen (24 Oct, milestone 8; the canvas): the fight's energy bar and three buttons fit and keep clear
## of Your HP and each other, a press fires, a right-click switches auto; the Runs card's skills button for a class
## with skills, the picker's rows, a press in it, its lock on a run.
func _skills_ui_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var NG = load("res://scripts/ui/node_glyphs.gd")
	var no_glyph: Array = Data.SKILLS.keys().filter(func(id): return not NG.SKILL.has(id) or not NG.SVG.has(NG.SKILL[id]))
	_check(no_glyph.is_empty(), "skills with no glyph of their own: %s" % str(no_glyph))
	# every plain node's figure and sentence in Training (24 Oct: the Recruit's fillers read "Notable" with no sentence)
	var BK = load("res://scripts/ui/barracks.gd")
	var no_words: Array = []
	for t in Data.TREES + Data.ELEMENT_TREES:
		for nd in t["nodes"]:
			if nd.has("value") and not (nd.get("notable", false) or nd.get("keystone", false) or nd.get("capstone", false)):
				if not BK.EFFECT_WORDS.has(nd["effect"]) or not BK.PANEL_WORDS.has(nd["effect"]):
					no_words.append("%s (%s)" % [nd["name"], nd["effect"]])
	_check(no_words.is_empty(), "plain nodes Training has no words for: %s" % str(no_words))
	_set_cls(sim, "Poacher")
	var sk_ids: Dictionary = _skill_node_ids()
	for k in ["clean_shot", "flush_them_out", "collared", "gin_trap"]:
		if not sim.tree.has(sk_ids[k]):
			sim.tree.append(sk_ids[k])
	sim.skill_slots = ["clean_shot", "collared", "gin_trap"]
	sim.skill_auto = [true, true, true]
	# the card: thirds, the skills' button with its pictures; the picker
	main.show_room(main.MISSIONS)
	main.refresh()
	var ms = main._missions
	var c: Dictionary = ms._cols[0]
	_check(c["skills"].visible and c["skill_pics"].all(func(p): return p.texture != null), "the Runs card has no skills button with its pictures")
	_check(c["insure"].position.x + c["insure"].size.x <= c["rig"].position.x and c["rig"].position.x + c["rig"].size.x <= c["skills"].position.x, "the card's foot buttons overlap")
	ms._skills_open()
	main.refresh()
	var pk = ms._skill_pick
	_check(pk.visible and pk.rows.filter(func(r): return r["btn"].visible).size() == 8, "the picker doesn't show the Poacher's eight")
	_check(pk.position.y + pk.size.y <= ms.TOP + ms._map.size.y + 1, "the picker runs off the map: %.0f" % (pk.position.y + pk.size.y))
	_check_fit(main, "Runs (the skills' picker)")
	var flush_row: int = -1
	for k in range(pk.rows.size()):
		if pk.rows[k]["id"] == "flush_them_out":
			flush_row = k
	pk._press(flush_row)
	_check(not sim.skill_slots.has("flush_them_out"), "the picker put a fourth skill in with three picked")
	var collar_row: int = -1
	for k in range(pk.rows.size()):
		if pk.rows[k]["id"] == "collared":
			collar_row = k
	pk._press(collar_row)
	pk._press(flush_row)
	_check(sim.skill_slots == ["clean_shot", "flush_them_out", "gin_trap"], "the picker's take-out and put-in: %s" % str(sim.skill_slots))
	var not_learnt: Array = pk.rows.filter(func(r): return r["btn"].visible and not sim.skill_known(str(r["id"])))
	_check(not not_learnt.is_empty() and not_learnt.all(func(r): return r["btn"].disabled), "a skill not learnt can be picked")
	pk._done.pressed.emit()
	_check(not pk.visible, "Done didn't close the picker")
	# all three empty: the button says what it's for, and fits
	sim.skill_slots = ["", "", ""]
	ms._shown = ""
	main.refresh()
	_check(c["skills"].text != "" and c["skill_pics"].all(func(p): return p.texture == null), "the empty skills button says nothing: '%s'" % c["skills"].text)
	_check_fit(main, "Runs (no skills picked)")
	sim.skill_slots = ["clean_shot", "collared", "gin_trap"]
	# setting off closes the picker and locks the button
	ms._skills_open()
	sim.hp = sim.max_hp()
	ms._deploy(0)
	ms._shown = ""
	ms.show_state(sim)
	_check(not pk.visible and c["skills"].disabled, "on a run the picker stayed open or its button live: %s, %s" % [str(pk.visible), str(c["skills"].disabled)])
	sim.extract_now()
	main.refresh()
	# every class has skills now: a Doorman's card has the button and his picker his eight
	_set_cls(sim, "Doorman")
	ms._shown = ""
	main.refresh()
	_check(c["skills"].visible, "a Doorman's card has no skills button")
	ms._skills_open()
	main.refresh()
	_check(pk.rows.filter(func(r): return r["btn"].visible and Data.SKILLS[str(r["id"])]["cls"] == "Doorman").size() == 8, "the Doorman's picker isn't his eight")
	pk.visible = false
	_set_cls(sim, "Poacher")
	for k in ["clean_shot", "flush_them_out", "collared", "gin_trap"]:
		if not sim.tree.has(sk_ids[k]):
			sim.tree.append(sk_ids[k])          # a class change took the region's nodes
	# the fight: the bar under Your HP, the buttons between the bars and the hands, clear of each other
	sim.hp = sim.max_hp()
	sim.deploy(0)
	main.show_room(main.MISSIONS)
	main.refresh()
	var run = main._run
	_check(run._skills != null, "the run screen has no skills over its frame")
	if run._skills != null:
		var sb = run._skills
		_check(sb.visible, "the fight has skills slotted but shows no skills")
		var hp_r := Rect2(run._runner["track"].position, run._runner["track"].size)
		var en_r := Rect2(sb.position + sb.energy_track.position, sb.energy_track.size)
		_check(hp_r.end.y <= en_r.position.y and absf(hp_r.position.x - en_r.position.x) < 1.0, "the energy bar isn't under Your HP: %s / %s" % [str(hp_r), str(en_r)])
		var btns: Array = sb.keep_rects()
		_check(btns.size() == 3, "the fight shows %d skill buttons" % btns.size())
		for k in range(btns.size()):
			_check(not btns[k].intersects(hp_r) and not btns[k].intersects(en_r) and btns[k].end.x <= run._view.position.x + run.VIEW_W and btns[k].end.y <= run.FIGHT_BOX_Y + run.VIEW_H, "skill button %d sits on a bar or off the frame: %s" % [k, str(btns[k])])
			for j in range(k):
				_check(not btns[k].intersects(btns[j]), "skill buttons %d and %d overlap" % [j, k])
		_check_fit(main, "The fight (the skills)")
		# a right-click switches auto; the pip says so
		var ev := InputEventMouseButton.new()
		ev.button_index = MOUSE_BUTTON_RIGHT
		ev.pressed = true
		sb._input_on(1, ev)
		_check(not sim.skill_auto[1] and sb.buttons[1]["pip"].text == "Off", "a right-click didn't switch auto off: %s, '%s'" % [str(sim.skill_auto[1]), sb.buttons[1]["pip"].text])
		sb._input_on(1, ev)
		_check(sim.skill_auto[1] and sb.buttons[1]["pip"].text == "Auto", "a second right-click didn't switch auto back on")
		# a press fires on the next tick; the word stands over the frame
		for k in range(3):
			sim.set_skill_auto(k, false)
		var c0: int = int(sim.mission["sk"]["cast"])
		sb._press(2)
		sim.advance(0.05)
		main.refresh()
		_check(int(sim.mission["sk"]["cast"]) == c0 + 1 and str(sim.mission["sk"]["last"]["id"]) == "gin_trap" and sb.word.visible and sb.word.text == "Gin trap", "a press didn't fire and say so: %d casts, word '%s'" % [int(sim.mission["sk"]["cast"]) - c0, sb.word.text])
		for k in range(3):
			sim.set_skill_auto(k, true)
		# the numbers keep off the buttons
		var keep: Array = run._keep_out()
		_check(sb.keep_rects().all(func(r): return keep.has(r)), "the numbers don't keep off the skills' buttons")
		_check_fit(main, "The fight (a skill's word)")
		# the stunned chip on them
		sim.mission["sk"]["fx"]["stun_all_t"] = 2.0
		main.refresh()
		_check(run._fight["chips"].visible and _stunned_chip(run), "Stunned isn't on them")
		# a clear: no one stunned, the buttons gone for the search's bar, Your HP where it was
		var hp_y: float = run._runner["track"].position.y
		var rem: int = int(sim.mission["remaining"])
		sim.mission["remaining"] = 0
		main.refresh()
		_check(not _stunned_chip(run) and not sb.visible and run._runner["track"].position.y == hp_y, "at a clear: stunned shown, the buttons up, or Your HP moved (%.0f → %.0f)" % [hp_y, run._runner["track"].position.y])
		sim.mission["remaining"] = rem
		# a class that hasn't these skills shows none of them, the slots left from another class
		_set_cls(sim, "Doorman")
		main.refresh()
		_check(not sb.visible, "a Doorman's fight shows the Poacher's skills")
		_set_cls(sim, "Poacher")
	sim.extract_now()
	# Training's class cards with nothing beaten: each locked one says what opens it, whole (24 Oct: "After the Ma…")
	for b in range(sim.bosses_beaten.size()):
		sim.bosses_beaten[b] = false
	sim.story_beat = 0
	main.show_room(main.BARRACKS)
	main.refresh()
	var bk = main._barracks
	for k in range(Data.CLASSES.size()):
		var cnm: String = Data.CLASSES[k]["name"]
		if Words.CLASS_UNLOCK.has(cnm):
			var cc: Dictionary = bk._class_cards[k]
			_check(bk._class_buttons[k].disabled and cc["lock"].visible and cc["tag"].text == str(Words.CLASS_UNLOCK[cnm]["who"]), "%s's locked card doesn't say what opens it: '%s'" % [cnm, cc["tag"].text])
	_check_fit(main, "Training (the locked classes)")
	main.show_room(main.MISSIONS)
	sim.load_dict(saved)
	main.refresh()
	print("skills on screen ok: the card's button and picker, its lock, a class without, the fight's bar and buttons, a press, auto off")


## Whether a chip on them reads "Stunned" (a skill's hold).
func _stunned_chip(run) -> bool:
	var ch = run._fight["chips"]
	if not ch.visible:
		return false
	for k in range(ch._panels.size()):
		if ch._panels[k].visible and str(ch._labels[k].text).begins_with("Stunned"):
			return true
	return false


## Every class's skills (24 Oct, milestone 8, step 4): each new effect does what its line says on a staged fight, and
## ends on time; Code blue's last stand and its kept energy; Bung's tins; Back of the van once a fight; the Recruit's
## tree and joints; who each head opens.
func _class_skills_checks(sim) -> void:
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.hp = sim.max_hp()
	sim.deploy(0)
	var m: Dictionary = sim.mission
	var t: Dictionary = m["t"]
	var fire := func(id: String) -> void:
		sim._skills_fight_start(m)
		m["sk"]["dt"] = 0.0
		sim._skill_effect(m, t, sim.skill(id)["fx"])
	m["remaining"] = 4
	# wards and cleanses
	m["my_dots"] = {"bleed": 9.0}
	fire.call("tourniquet")
	_check(not m["my_dots"].has("bleed") and not sim._skill_dot_lands(m, "bleed") and sim._skill_dot_lands(m, "fire"), "Tourniquet: the bleed stays or lands again, or wards fire too")
	m["my_dots"] = {"poison": 9.0, "fire": 9.0}
	fire.call("antidote")
	_check(m["my_dots"].is_empty() and not sim._skill_dot_lands(m, "poison") and not sim._skill_dot_lands(m, "fire"), "Antidote: %s" % str(m["my_dots"]))
	m["my_dots"] = {"poison": 9.0, "fire": 9.0, "bleed": 9.0}
	fire.call("major_incident")
	_check(m["my_dots"].is_empty() and sim._skill_wound_kept(m) and sim._skill_wound_kept(m), "Major incident: ailments %s, no wound this run %s" % [str(m["my_dots"]), str(m.get("no_wound", false))])
	m["no_wound"] = false
	fire.call("strapped_up")
	_check(sim._skill_wound_kept(m) and not sim._skill_wound_kept(m), "Strapped up didn't keep one wound off, and only one")
	fire.call("close_shave")
	_check(not sim._skill_dot_lands(m, "poison") and sim._skill_dot_lands(m, "poison"), "Close shave didn't make one ailment miss, and only one")
	# buffs, in and out
	fire.call("adrenaline")
	_check(is_equal_approx(sim._skill_hit_mult(m), 1.5625), "Adrenaline: ×%.3f" % sim._skill_hit_mult(m))
	fire.call("knock_off_kit")
	_check(is_equal_approx(sim._skill_hit_mult(m), 1.3), "Knock-off kit: ×%.2f" % sim._skill_hit_mult(m))
	fire.call("everything_must_go")
	_check(is_equal_approx(sim._skill_hit_mult(m), 2.0), "Everything must go: ×%.2f" % sim._skill_hit_mult(m))
	fire.call("shutters_down")
	_check(is_equal_approx(sim._skill_in_mult(m, 3), 0.2), "Shutters down: ×%.2f in" % sim._skill_in_mult(m, 3))
	fire.call("suppressing_fire")
	_check(is_equal_approx(sim._skill_in_mult(m, 3), 0.65), "Suppressing fire: ×%.2f in" % sim._skill_in_mult(m, 3))
	fire.call("elbow_room")
	_check(is_equal_approx(sim._skill_in_mult(m, 3), 0.75) and is_equal_approx(sim._skill_hit_mult(m), 1.15), "Elbow room: ×%.2f in, ×%.2f out" % [sim._skill_in_mult(m, 3), sim._skill_hit_mult(m)])
	if sim.armour() <= 0.0:
		sim.equipped["Armour"] = sim._plain("Armour", "Stab plates")     # Brace needs armour to brace (the review: it passed with none)
	fire.call("brace")
	_check(sim.armour() > 0.0 and sim._skill_in_mult(m, 3) < 1.0, "Brace took nothing off their fire: ×%.3f on %.0f armour" % [sim._skill_in_mult(m, 3), sim.armour()])
	fire.call("short_circuit")
	_check(is_equal_approx(sim._skill_type_mult(m, "shock"), 1.3) and sim._skill_in_mult(m, 3) == 0.0 and float(m["shock_t"]) > 0.0, "Short circuit: shock ×%.2f, in ×%.2f" % [sim._skill_type_mult(m, "shock"), sim._skill_in_mult(m, 3)])
	fire.call("pat_down")
	_check(is_equal_approx(sim._skill_pat(m), 1.0), "Pat down didn't take their resists")
	fire.call("two_sugars")
	_check(is_equal_approx(float(m["sk"]["fx"]["regen_x"]), 1.5) and float(m["sk"]["fx"]["regen_t"]) > 0.0, "Two sugars")
	fire.call("gone")
	_check(sim._skill_in_mult(m, 3) == 0.0 and is_equal_approx(sim._skill_hit_mult(m), 3.0), "Gone: in ×%.2f, out ×%.2f" % [sim._skill_in_mult(m, 3), sim._skill_hit_mult(m)])
	fire.call("duck_and_weave")
	_check(sim._skill_in_mult(m, 3) == 0.0 and float(m["sk"]["fx"]["hidden_t"]) > 0.0, "Duck and weave: in ×%.2f" % sim._skill_in_mult(m, 3))
	# hits now
	_check(not sim.has_joint("recruit_physical") and not sim.has_rule("linemans_bag"), "the skills' fixture has a joint or the Tool Bag on: the hits below won't read plain")
	var pat_m: Dictionary = {"t": {"res": {"physical": 0.2}}, "target_hp": 1000.0, "sk": {"fx": {}}}     # a plain man: a fifth resisted, no shock, no pat-down
	sim._skill_damage(pat_m, 100.0, "physical", true)
	_check(is_equal_approx(1000.0 - float(pat_m["target_hp"]), 100.0 * (1.0 - sim.phys_resist(0.2))), "a skill's hit on a fifth resisted took %.1f of 100" % (1000.0 - float(pat_m["target_hp"])))
	m["target_hp"] = 10000.0
	fire.call("shoulder_charge")
	_check(absf(10000.0 - float(m["target_hp"]) - _skill_hit_expected(sim, m, 3.0)) < 0.5 and m["sk"]["fx"]["stuns"].size() + int(m["sk"]["stun_share"] > 0.0) > 0, "Shoulder charge: %.1f off" % (10000.0 - float(m["target_hp"])))
	m["target_hp"] = 10000.0
	fire.call("ring_main")
	_check(absf(10000.0 - float(m["target_hp"]) - _skill_hit_expected(sim, m, 1.5) * mini(3, mini(4, sim.contact(t)))) < 0.5, "Ring main: %.1f off" % (10000.0 - float(m["target_hp"])))
	m["target_hp"] = 10000.0
	var hp0: float = sim.hp
	fire.call("danger_close")
	_check(float(m["target_hp"]) < 10000.0 and absf(hp0 - sim.hp - sim.max_hp() * 0.1) < 0.01, "Danger close: %.1f off them, %.1f off you" % [10000.0 - float(m["target_hp"]), hp0 - sim.hp])
	sim.hp = sim.max_hp()
	m["target_hp"] = 10000.0
	m["dots"] = {}
	fire.call("hot_work")
	_check(float(m["dots"].get("fire", 0.0)) > 0.0, "Hot work didn't set him burning")
	m["target_hp"] = 10000.0
	fire.call("lob_one_in")
	_check(float(m["target_hp"]) < 10000.0 and int(m.get("thrown", 0)) > 0, "Lob one in threw nothing")
	# the rest of the 48 (the review: nine had no check)
	fire.call("look_lively")
	_check(is_equal_approx(sim._skill_hit_mult(m), 1.4), "Look lively: ×%.2f" % sim._skill_hit_mult(m))
	fire.call("make_ready")
	_check(is_equal_approx(sim._skill_hit_mult(m), 1.25) and float(m["sk"]["fx"]["buff_t"]) > 0.0, "Make ready: ×%.2f for %.1f s" % [sim._skill_hit_mult(m), float(m["sk"]["fx"].get("buff_t", 0.0))])
	var heads := 0
	for k in range(40):
		fire.call("coin_toss")
		heads += 1 if is_equal_approx(sim._skill_hit_mult(m), 2.0) else 0
	_check(heads > 5 and heads < 35, "Coin toss came up %d of 40" % heads)
	for id in ["flashbang", "smoke"]:
		fire.call(id)
		_check(sim._skill_in_mult(m, 3) <= 0.5 + 0.001, "%s: their fire ×%.2f" % [id, sim._skill_in_mult(m, 3)])
	for id in ["headbutt", "not_on_the_list", "sedative_dart"]:
		m["target_hp"] = 10000.0
		fire.call(id)
		var lasts_s: float = float(sim.skill(id)["fx"]["stun_one_s"])
		_check(is_equal_approx(sim._skill_in_mult(m, 4), 0.75) and m["sk"]["fx"]["stuns"].size() == 1 and is_equal_approx(float(m["sk"]["fx"]["stuns"][0]), lasts_s), "%s: one of 4 held for %.0f s: ×%.2f, %s" % [id, lasts_s, sim._skill_in_mult(m, 4), str(m["sk"]["fx"]["stuns"])])
	_check(absf(10000.0 - float(m["target_hp"])) < 0.01, "Sedative dart hit him")
	m["target_hp"] = 10000.0
	fire.call("headbutt")
	_check(absf(10000.0 - float(m["target_hp"]) - _skill_hit_expected(sim, m, 1.5)) < 0.5, "Headbutt: %.1f off" % (10000.0 - float(m["target_hp"])))
	var gun_keep = sim.equipped["Primary"]
	var rig_keep: Array = sim.rig.duplicate()
	sim.equipped["Primary"] = sim._plain("Primary", "Pipe shotgun")     # a gun that takes rounds, and room for them
	sim.rig = []
	var gun_bd = sim.equipped["Primary"]
	var r_bd: int = sim.rounds_for(gun_bd)
	fire.call("breakdown")
	sim._skills_on_kill(m)
	_check(sim.rounds_for(gun_bd) == r_bd + 20, "Breakdown: %d rounds → %d" % [r_bd, sim.rounds_for(gun_bd)])
	sim.equipped["Primary"] = gun_keep
	sim.rig = rig_keep
	# the timed ones end on time, nothing slotted (the review: §8's "effects end" untested; Ringing ears held a gang)
	var slots0: Array = sim.skill_slots.duplicate()
	sim.skill_slots = ["", "", ""]
	for id in ["tourniquet", "brace", "suppressing_fire", "adrenaline", "net_every_hole"]:
		fire.call(id)
		var lasts: float = 0.0
		for k in sim.skill(id)["fx"].keys():
			if str(k).ends_with("_s"):
				lasts = maxf(lasts, float(sim.skill(id)["fx"][k]))
		var on_now := func() -> bool: return sim._skill_in_mult(m, 3) < 1.0 or sim._skill_hit_mult(m) > 1.0 or not sim._skill_dot_lands(m, "bleed")
		var on_before: bool = on_now.call()
		var ticks := 0
		for step in range(int(floor(lasts)) - 1):
			sim._skills_tick(m, t, 1.0, 3)
			ticks += 1
		_check(on_now.call(), "%s ended early: off after %d of its %.0f s" % [id, ticks, lasts])
		for step in range(int(ceil(lasts)) + 2 - ticks):
			sim._skills_tick(m, t, 1.0, 3)
		_check(on_before and lasts > 0.0, "%s did nothing to time out (%.1f s)" % [id, lasts])
		_check(is_equal_approx(sim._skill_in_mult(m, 3), 1.0) and is_equal_approx(sim._skill_hit_mult(m), 1.0) and sim._skill_dot_lands(m, "bleed"), "%s outlasted its %.0f s: in ×%.2f, out ×%.2f" % [id, lasts, sim._skill_in_mult(m, 3), sim._skill_hit_mult(m)])
	sim.skill_slots = slots0
	# energy, cooldowns, costs
	sim._skills_fight_start(m)
	m["sk"]["energy"] = 10.0
	m["sk"]["cd"] = [5.0, 5.0, 5.0]
	sim._skill_effect(m, t, sim.skill("stand_to")["fx"])
	_check(is_equal_approx(float(m["sk"]["energy"]), 40.0) and is_equal_approx(float(m["sk"]["cd"][0]), 3.0), "Stand to: %.1f energy, %.1f s" % [float(m["sk"]["energy"]), float(m["sk"]["cd"][0])])
	sim.skill_slots = ["clean_shot", "", ""]
	var full_cost: float = sim.skill_cost_now(0)
	fire.call("fire_and_manoeuvre")
	_check(is_equal_approx(sim.skill_cost_now(0), full_cost * 0.5), "Fire and manoeuvre: %.1f, not half of %.1f" % [sim.skill_cost_now(0), full_cost])
	# kills: Jackpot's cooldowns, Chancer's find, Barred's man out, nothing from him
	fire.call("jackpot")
	m["sk"]["cd"] = [10.0, 10.0, 10.0]
	sim._skills_on_kill(m)
	_check(is_equal_approx(float(m["sk"]["cd"][0]), 8.0), "Jackpot: a kill took %.1f s off" % (10.0 - float(m["sk"]["cd"][0])))
	var rem: int = int(m["remaining"])
	var kills0: int = int(m["kills"])
	var finds0: int = int(m.get("finds", 0))
	var cash0: float = float(m["cash"])
	var notes0: int = int(m.get("notes", 0))
	var salv0: String = str(m.get("salvage", {}))
	var xp0: float = float(m["xp"])
	fire.call("barred")
	_check(int(m["remaining"]) == rem - 1 and int(m["kills"]) == kills0 + 1 and float(m["xp"]) > xp0, "Barred: %d → %d on you, %d kills, %.0f XP" % [rem, int(m["remaining"]), int(m["kills"]) - kills0, float(m["xp"]) - xp0])
	_check(int(m.get("finds", 0)) == finds0 and float(m["cash"]) == cash0 and int(m.get("notes", 0)) == notes0 and str(m.get("salvage", {})) == salv0, "Barred's man paid out: %d finds, %.1f tins, %d notes, salvage %s" % [int(m.get("finds", 0)) - finds0, float(m["cash"]) - cash0, int(m.get("notes", 0)) - notes0, str(m.get("salvage", {}))])
	var quiet: Array = sim.tree.filter(func(id): return str(id).contains("/") and str(Data.tree_named(str(id).get_slice("/", 0)).get("nodes", [])[int(str(id).get_slice("/", 1))].get("effect", "") if int(str(id).get_slice("/", 1)) < Data.tree_named(str(id).get_slice("/", 0)).get("nodes", []).size() else "") == "quiet_hands")
	for id in quiet:
		sim.tree.erase(id)                    # Chancer's find with nothing in its way (the review: it passed on Quiet hands)
	fire.call("chancer")
	finds0 = int(m.get("finds", 0))
	sim._kill(m, t)
	_check(not sim.has_node("quiet_hands") and int(m.get("finds", 0)) == finds0 + 1, "Chancer's kill dropped nothing")
	sim.tree.append_array(quiet)
	# Code blue: its energy kept back all run; the killing hit leaves 30%
	_set_cls(sim, "Paramedic")
	var sk_ids: Dictionary = _skill_node_ids()
	# Not today now: under a quarter HP, 40% less in; no longer a second killing-hit save (24 Oct, Matt)
	var nt: String = Data.node_id_named("Shifts/Not today")
	_check(nt != "", "no Not today on the Paramedic's tree")
	if nt != "":
		sim.tree.append(nt)
		sim._dry_memo.clear()
		sim.hp = sim.max_hp() * 0.5
		var above_q: float = sim.low_hp_mult()
		sim.hp = sim.max_hp() * 0.2
		_check(sim.has_node("not_today") and is_equal_approx(above_q, 1.0) and is_equal_approx(sim.low_hp_mult(), 0.6), "Not today: ×%.2f over a quarter, ×%.2f under" % [above_q, sim.low_hp_mult()])
		sim.hp = sim.max_hp()
		# and the fight takes it (the review: only the function was read): a tick at a fifth HP, with it and without
		var lost := []
		for with_nt in [false, true]:
			if with_nt:
				sim.tree.append(nt)
			else:
				sim.tree.erase(nt)
			sim._dry_memo.clear()
			sim._skills_fight_start(m)
			m["remaining"] = 4
			m["target_hp"] = 1.0e12
			m["fresh"] = false
			m["grace"] = 10.0
			m["my_dots"] = {}
			sim.hp = sim.max_hp() * 0.2
			m["taken_by"] = {}
			sim.rng.seed = 4242                     # the same tick both ways
			sim._fight(m, t, 0.1)
			var took: float = 0.0
			for ty_k in m["taken_by"]:
				took += float(m["taken_by"][ty_k])
			lost.append(took)
		_check(float(lost[0]) > 0.0 and absf(float(lost[1]) / float(lost[0]) - 0.6) < 0.02, "the fight under a quarter HP took %s with Not today, against %s without" % [str(lost[1]), str(lost[0])])
		sim.hp = sim.max_hp()
	sim.tree.append(sk_ids["code_blue"])
	sim.tree.append(sk_ids["tourniquet"])
	sim.skill_slots = ["tourniquet", "code_blue", ""]
	sim._skills_fight_start(m)
	m["sk"]["energy"] = 70.0
	_check(not sim._skill_can(m, 0), "Code blue's 60 kept back left Tourniquet castable on 70")
	m["sk"]["energy"] = 80.0
	_check(sim._skill_can(m, 0), "Tourniquet couldn't be cast over Code blue's kept 60")
	m["sk"]["energy"] = 100.0
	_check(not sim._skill_can(m, 1), "Code blue could be pressed: a full cleanse on demand (the review)")
	m["sk"]["energy"] = 60.0
	sim.hp = 1.0
	m["my_dots"] = {"bleed": 99.0}
	_check(sim._skill_last_stand(m) and is_equal_approx(sim.hp, sim.max_hp() * 0.3) and m["my_dots"].is_empty() and not sim._skill_last_stand(m), "Code blue: hp %.1f, ailments %s, twice %s" % [sim.hp, str(m["my_dots"]), str(m.get("last_stand_used", false))])
	sim.hp = sim.max_hp()
	# Bung: twenty tins, or not at all; Back of the van: a grenade, once a fight
	_set_cls(sim, "Scrapper")
	sk_ids = _skill_node_ids()
	sim.tree.append(sk_ids["bung"])
	sim.tree.append(sk_ids["back_of_the_van"])
	sim.skill_slots = ["bung", "back_of_the_van", ""]
	sim._skills_fight_start(m)
	m["sk"]["energy"] = 100.0
	sim.cash = 10.0
	_check(not sim._skill_can(m, 0), "Bung with 10 tins")
	sim.cash = 100.0
	sim._skill_fire(m, t, 0)
	_check(is_equal_approx(sim.cash, 80.0), "Bung didn't take its 20 tins: %.0f" % sim.cash)
	sim.rig = []                              # room for it (the review: a full rig passed)
	_check(sim.rig_room(1), "no room in an empty rig")
	sim._skill_fire(m, t, 1)
	_check(sim.rig.size() == 1 and Items.is_grenade(sim.rig[0]), "Back of the van put no grenade in the rig")
	m["sk"]["energy"] = 100.0
	sim.rig = []
	_check(not sim._skill_can(m, 1), "Back of the van twice in a fight")
	sim._skills_fight_start(m)
	m["sk"]["energy"] = 100.0
	_check(sim._skill_can(m, 1), "Back of the van once a run, not once a fight (the review)")
	# the Recruit: his class, his lanes' figures, his joints
	_set_cls(sim, "Recruit")
	_check(sim.cls == "Recruit" and is_equal_approx(sim.skill_cost_mult(), 0.9), "the Recruit's skills don't cost 10%% less: ×%.2f" % sim.skill_cost_mult())
	_check(Data.joint("recruit_physical").get("element_tree", "") == "Knuckles" and Data.joint("recruit_poison").get("element_tree", "") == "The Rat Man", "the Recruit's joints")
	var learn := func(tree_name: String, node_name: String) -> void:
		var ns: Array = Data.tree_named(tree_name)["nodes"]
		for k in range(ns.size()):
			if str(ns[k]["name"]) == node_name and not sim.tree.has("%s/%d" % [tree_name, k]):
				sim.tree.append("%s/%d" % [tree_name, k])
	if sim.equipped["Rig"] == null:
		sim.equipped["Rig"] = sim._plain("Rig", str(Data.BASES["Rig"][0]["name"]))     # pouches to lose (the review: none passed)
	var g0: float = sim.grenade_mult()
	var med0: int = sim.med_capacity()
	var dmg0: float = sim.damage_total()
	var cd0: float = sim.skill_cooldown("make_ready")
	var cost0: float = sim.skill_cost_mult()
	var emax0: float = sim.max_energy()
	var regen0: float = sim.energy_regen()
	learn.call("Ordnance", "Grenadier")
	_check(is_equal_approx(sim.grenade_mult(), g0 * 2.0) and med0 > 0 and sim.med_capacity() == med0 - 1, "Grenadier: grenades ×%.2f, pouches %d → %d" % [sim.grenade_mult() / g0, med0, sim.med_capacity()])
	learn.call("Ordnance", "Firing blanks")
	_check(is_equal_approx(sim.damage_total(), dmg0 * 0.85) and is_equal_approx(sim.skill_cost_mult(), cost0 * 0.75), "Firing blanks: damage ×%.3f, costs ×%.3f" % [sim.damage_total() / dmg0, sim.skill_cost_mult() / cost0])
	learn.call("Drill", "Quick march")
	_check(is_equal_approx(sim.skill_cooldown("make_ready"), cd0 * 0.7) and is_equal_approx(sim.skill_cost_mult(), cost0 * 0.75 * 1.25), "Quick march: cooldown ×%.2f, cost ×%.3f" % [sim.skill_cooldown("make_ready") / cd0, sim.skill_cost_mult() / cost0])
	learn.call("Drill", "Double time")
	_check(is_equal_approx(sim.max_energy(), emax0 - 30.0) and is_equal_approx(sim.energy_regen(), regen0 * 2.0), "Double time: max %.0f → %.0f, refill ×%.2f" % [emax0, sim.max_energy(), sim.energy_regen() / regen0])
	sim._skills_fight_start(m)
	m["sk"]["dt"] = 0.0
	learn.call("Drill", "Cover me")
	_check(is_equal_approx(sim._skill_in_mult(m, 3), 1.0), "Cover me with nothing running: ×%.2f" % sim._skill_in_mult(m, 3))
	sim._skill_effect(m, t, sim.skill("make_ready")["fx"])
	sim._sk_set(m["sk"], "buff_t", 5.0)
	_check(is_equal_approx(sim._skill_in_mult(m, 3), 0.75), "Cover me with a skill running: ×%.2f" % sim._skill_in_mult(m, 3))
	# an effect no longer than the tick still counts that tick (the review: the countdown runs before the hit), at the
	# bot's step and the dry runs'
	for dt_e in [1.0, 2.0]:
		sim._skills_fight_start(m)
		m["sk"]["dt"] = dt_e
		sim._sk_set(m["sk"], "regen_t", dt_e)
		_check(sim._sk_running(m["sk"]) and is_equal_approx(sim._skill_in_mult(m, 3), 0.75), "an effect as long as a %.0f s tick doesn't count that tick: running %s, ×%.2f" % [dt_e, str(sim._sk_running(m["sk"])), sim._skill_in_mult(m, 3)])
	sim._skills_fight_start(m)
	sim._sk_set(m["sk"], "stun_all_t", 1.0)
	_check(not sim._sk_running(m["sk"]), "Ringing ears' stun counted as a skill of his running")
	sim._skills_fight_start(m)
	m["sk"]["dt"] = 0.0
	# a throw: Blast burns, Ringing ears (and it runs down with nothing slotted), Cook it off's one more
	learn.call("Ordnance", "Blast burns")
	learn.call("Ordnance", "Ringing ears")
	sim._skills_fight_start(m)
	m["sk"]["dt"] = 0.0
	m["dots"] = {}
	sim.skill_slots = ["", "", ""]
	sim._grenade_after(m, 100.0)
	_check(float(m["dots"].get("fire", 0.0)) > 0.0 and sim._skill_in_mult(m, 3) == 0.0, "a throw: burning %s, their fire ×%.2f" % [str(m["dots"]), sim._skill_in_mult(m, 3)])
	sim._skills_tick(m, t, 1.0, 3)
	sim._skills_tick(m, t, 1.0, 3)
	_check(is_equal_approx(sim._skill_in_mult(m, 3), 1.0), "Ringing ears held their fire past its second with nothing slotted: ×%.2f (the review)" % sim._skill_in_mult(m, 3))
	m["remaining"] = 9
	var lob: Dictionary = {"type": "physical", "damage": 100.0}
	m["target_hp"] = 1.0e9
	sim._skill_lob(m, t, lob)
	var without: float = 1.0e9 - float(m["target_hp"])
	learn.call("Ordnance", "Cook it off")
	m["target_hp"] = 1.0e9
	sim._skill_lob(m, t, lob)
	var with_one: float = 1.0e9 - float(m["target_hp"])
	var crowd0: int = mini(9, sim.contact(t))
	_check(is_equal_approx(with_one / without, float(crowd0 + 1) / float(crowd0)), "Cook it off: ×%.3f, not one more than %d" % [with_one / without, crowd0])
	# Passing-out parade: 5 energy back a skill
	learn.call("Drill", "Passing-out parade")
	var sk_r: Dictionary = _skill_node_ids()
	sim.tree.append(sk_r["make_ready"])
	sim.skill_slots = ["make_ready", "", ""]
	sim._skills_fight_start(m)
	m["sk"]["energy"] = 50.0
	var paid: float = sim.skill_cost_now(0)
	sim._skill_fire(m, t, 0)
	_check(is_equal_approx(float(m["sk"]["energy"]), 50.0 - paid + 5.0), "Passing-out parade: %.1f energy, not %.1f" % [float(m["sk"]["energy"]), 50.0 - paid + 5.0])
	# the joints: a skill's own hit 25% harder, and it poisons them (joints B)
	m["dots"] = {}
	m["target_hp"] = 10000.0
	sim._skill_damage(m, 100.0)
	_check(is_equal_approx(10000.0 - float(m["target_hp"]), 100.0) and not m["dots"].has("poison"), "a skill's hit with no joints closed: %.1f" % (10000.0 - float(m["target_hp"])))
	learn.call("Ordnance", "Brute force")
	learn.call("Knuckles", "Recruit's boots")
	learn.call("Drill", "Tear gas")
	learn.call("The Rat Man", "Recruit's gas")
	m["target_hp"] = 10000.0
	sim._skill_damage(m, 100.0)
	_check(sim.has_joint("recruit_physical") and sim.has_joint("recruit_poison") and is_equal_approx(10000.0 - float(m["target_hp"]), 125.0) and float(m["dots"].get("poison", 0.0)) > 0.0, "the Recruit's joints: %.1f, poison %s" % [10000.0 - float(m["target_hp"]), str(m["dots"])])
	sim.extract_now()
	# who each head opens
	var fresh = load("res://scripts/sim/sim.gd").new()
	fresh.start()
	_check(fresh.class_open("Poacher") and not Data.CLASSES.any(func(c): return c["name"] != "Poacher" and fresh.class_open(str(c["name"]))), "a fresh camp has more than the Poacher")
	var order := ["Paramedic", "Doorman", "Scrapper", "Recruit"]
	for z in range(4):
		fresh.bosses_beaten[z] = true
		_check(fresh.class_open(order[z]) and (z == 3 or not fresh.class_open(order[z + 1])), "head %d doesn't open the %s alone" % [z, order[z]])
	_check(not fresh.class_open("Drifter"), "the Drifter came before Kev's first story")
	fresh.story_beat = 1
	_check(fresh.class_open("Drifter"), "Kev's first story didn't bring the Drifter")
	sim.load_dict(saved)
	print("every class's skills ok: wards, cleanses, buffs, hits, energy and costs, kills, Code blue, Bung, the van, the Recruit, the heads' classes")


## The fight's breakdown (24 Oct, the endgame chase): a live run keeps its damage by source - the gun's hits, each
## element's ticks, a skill's own hits - what hit you, the skills' uses; the Stats room's Last run reads the damage and
## opens the breakdown over the room, every word in its box; the sources add to the run's damage, "Everything else"
## the rest.
func _fight_breakdown_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var hold: Dictionary = sim.to_dict()
	sim.hp = sim.max_hp()
	sim.deploy(0)
	var m: Dictionary = sim.mission
	m["by_src"] = {}
	sim._count_src(m, "Rescue axe", 500.0)
	sim._count_src(m, "dot:bleed", 250.0)
	m["src_now"] = "clean_shot"
	m["sk_uses"] = {"clean_shot": 2}
	sim._skill_damage(m, 100.0)
	m["dealt"] = 1000.0
	m["fight_s"] = 20.0
	m["taken_by"] = {"physical": 300.0, "fire": 100.0}
	var fb: Dictionary = sim.fight_breakdown(m)
	var names: Array = fb["src"].map(func(r): return str(r[0]))
	var summed: float = fb["src"].reduce(func(acc, r): return acc + float(r[1]), 0.0)
	_check(names.size() >= 4 and names[0] == "Rescue axe" and names.has(Words.BREAKDOWN["dot:bleed"]) and names.any(func(n): return str(n).begins_with("Clean shot · 2 uses")) and names.has(Words.BREAKDOWN["other"]), "the breakdown's sources: %s" % str(fb["src"]))
	_check(absf(summed - float(m["dealt"])) < 2.0 and float(fb["s"]) == 20.0 and float(fb["took"]["physical"]) == 300.0 and fb["skills"].size() == 1, "the breakdown doesn't add up: %.0f of %.0f, %s" % [summed, float(m["dealt"]), str(fb)])
	# a real fight's ticks count too: the gun's hits and the dots land in by_src as the run goes
	sim.extract_now()
	sim.hp = sim.max_hp()
	sim.deploy(0)
	for k in range(60):
		if not sim.on_mission():
			break
		sim.advance(0.5)
	if sim.on_mission():
		sim.extract_now()
	_check(sim.last_report is Dictionary and sim.last_report.has("fight"), "the run's report has no breakdown")
	# a plain gun's hits are its own row, the top one, and little is left to "Everything else" (the review: items carry
	# "base", not "name")
	var real: Dictionary = sim.last_report.get("fight", {})
	var gun_key: String = Items.full_name(sim.equipped["Primary"]) if sim.equipped["Primary"] != null else ""
	var real_rows: Array = real.get("src", [])
	if float(real.get("dealt", 0.0)) > 0.0 and gun_key != "" and sim.has_rounds(sim.equipped["Primary"]):
		var other: float = 0.0
		for row in real_rows:
			if str(row[0]) == Words.BREAKDOWN["other"]:
				other = float(row[1])
		_check(not real_rows.is_empty() and str(real_rows[0][0]) == gun_key and other < float(real["dealt"]) * 0.25, "the gun isn't the breakdown's top row: %s (%s)" % [str(real_rows), gun_key])
	main.show_room(main.RUNNER)
	main.refresh()
	main._stats.show_fight()
	_check(main._stats.fight_panel != null and main._stats.fight_panel.mouse_filter == Control.MOUSE_FILTER_STOP, "the real run's breakdown didn't open, or lets clicks through")
	main._stats.hide_fight()
	# the Stats room: Damage on the Last run, the button, the breakdown over the room
	var rep: Dictionary = sim.last_report
	rep["fight"] = fb
	main.show_room(main.RUNNER)
	main.refresh()
	var st = main._stats
	_check(st.cards["last"]["rows"][2]["key"].text == "Damage" and st.fight_button.visible, "the Last run has no Damage row or no breakdown button")
	st.show_fight()
	_check(st.fight_panel != null and is_instance_valid(st.fight_panel) and st.fight_text_nodes().size() > 10, "the breakdown didn't open")
	for l in st.fight_text_nodes():
		_check(l.get_minimum_size().x <= l.size.x + 1.0 or l.clip_text, "a breakdown word runs out of its box: '%s'" % l.text)
	_check_fit(main, "Stats (the fight's breakdown)")
	st.hide_fight()
	sim.load_dict(hold)
	main.refresh()
	print("the fight's breakdown ok: by source, what hit you, the skills, the Stats room's panel")


## The true pinnacles' fights (24 Oct, the endgame chase): the Lineman's shield takes the hits first, fills again if
## not broken in its window and, broken, stuns him; the Registrar seals the skill you'd fire next (your fire cut, with
## none slotted); the Issuer prints men who fire and take the hits first. Their new uniques: one of the two drops; the
## Belt's shock arcs; the Stamp's third skill is free and twice; the Revolver prints a kill's hit on the next. On
## screen: the chips "On them", the shield over his bar, a sealed button.
func _order_fight_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var hold: Dictionary = sim.to_dict()
	var learn_skill := func(id: String) -> bool:
		for trd in Data.TREES:
			for k in range(trd["nodes"].size()):
				if str(trd["nodes"][k].get("skill", "")) == id:
					sim.tree.append("%s/%d" % [trd["name"], k])
					sim._dry_memo.clear()
					return sim.skill_known(id)
		return false
	var head_run := func(key: String) -> Dictionary:
		if sim.on_mission():
			sim.extract_now()
		sim.hp = sim.max_hp()
		sim.deploy(3)
		var mh: Dictionary = sim.mission
		mh["boss"] = sim._boss_entry({"name": "A head", "hp": 1000.0, "dps": 1.0, "zone": 0, "order": key})
		mh["boss"]["started"] = true
		mh["remaining"] = 1
		mh["target_hp"] = 1000.0
		mh["dots"] = {}
		return mh
	# the Lineman
	var m: Dictionary = head_run.call("grid")
	sim._order_tick(m, m["t"], 0.1, "grid")
	_check(is_equal_approx(float(m["shield"]), 1000.0 * Data.ORDER_SHIELD), "the Lineman's shield isn't %d%% of him: %s" % [roundi(Data.ORDER_SHIELD * 100.0), str(m.get("shield"))])
	m["target_hp"] = 900.0
	sim._order_absorb(m, m["t"], 1000.0, "grid")
	_check(is_equal_approx(float(m["target_hp"]), 1000.0) and is_equal_approx(float(m["shield"]), 200.0), "the shield didn't take the hit first: %.0f HP, %.0f shield" % [float(m["target_hp"]), float(m["shield"])])
	for k in range(int(Data.ORDER_SHIELD_WINDOW / 0.5) + 1):
		sim._order_tick(m, m["t"], 0.5, "grid")
	_check(is_equal_approx(float(m["shield"]), 300.0), "the shield didn't fill again when its window ran out: %.0f" % float(m["shield"]))
	m["target_hp"] = 500.0
	sim._order_absorb(m, m["t"], 1000.0, "grid")
	_check(float(m["shield"]) <= 0.0 and is_equal_approx(float(m["target_hp"]), 800.0) and float(m["stunned_t"]) > 0.0, "breaking the shield didn't stun him: %.0f HP, %.1f s" % [float(m["target_hp"]), float(m.get("stunned_t", 0.0))])
	_check(sim.order_chips().any(func(c): return str(c[0]).begins_with("Stunned")), "no Stunned chip on the Lineman: %s" % str(sim.order_chips()))
	m["my_dots"] = {}
	m["fresh"] = false
	m["immune_t"] = 0.0
	m["shield"] = 0.0
	m["shield_back"] = 99.0
	m["stunned_t"] = 2.0
	sim._fight(m, m["t"], 0.1)
	_check(float(m.get("last_incoming", 1.0)) <= 0.001, "a stunned Lineman still fired: %.2f" % float(m.get("last_incoming", 1.0)))
	# the Registrar: the skill you'd fire next sealed; none slotted, your fire cut
	m = head_run.call("archive")
	var slots_was: Array = sim.skill_slots.duplicate()
	var learn_one := ""
	for id in Data.SKILLS:
		if str(Data.SKILLS[id]["cls"]) == sim.cls:
			learn_one = id
			break
	_check(learn_skill.call(learn_one), "the seal's fixture couldn't learn %s" % learn_one)
	sim.skill_slots = [learn_one, "", ""]
	if not m.has("sk"):
		m["sk"] = {}
	sim._skills_fight_start(m)
	for k in range(int(Data.ORDER_SEAL_EVERY / 0.5) + 1):
		sim._order_tick(m, m["t"], 0.5, "archive")
	var sealed_ok: bool = float(m.get("sealed", {}).get("0", 0.0)) > 0.0 and not sim._skill_can(m, 0) and float(m.get("taped_t", 0.0)) <= 0.0
	_check(sealed_ok, "the Registrar didn't seal the skill: %s" % str(m.get("sealed")))
	sim.skill_slots = ["", "", ""]
	m["seal_t"] = Data.ORDER_SEAL_EVERY
	sim._order_tick(m, m["t"], 0.1, "archive")
	_check(float(m.get("taped_t", 0.0)) > 0.0, "with no skill to seal the Registrar's red tape didn't hold")
	sim.skill_slots = slots_was
	# the Issuer
	m = head_run.call("mint")
	for k in range(int(Data.ORDER_PRINT_EVERY / 0.5) + 1):
		sim._order_tick(m, m["t"], 0.5, "mint")
	_check(int(m.get("printed", 0)) == 1 and is_equal_approx(float(m["print_pool"]), float(m["t"]["hp"])), "the Issuer didn't print a man: %s" % str(m.get("printed")))
	var k0: int = int(m["kills"])
	m["target_hp"] = 1000.0 - float(m["t"]["hp"]) - 50.0
	sim._order_absorb(m, m["t"], 1000.0, "mint")
	_check(int(m["printed"]) == 0 and int(m["kills"]) == k0 + 1 and is_equal_approx(float(m["target_hp"]), 950.0), "a printed man didn't take the hit first: %d printed, %.0f HP" % [int(m["printed"]), float(m["target_hp"])])
	m["print_t"] = 0.0
	m["printed"] = Data.ORDER_PRINT_MAX
	m["print_t"] = Data.ORDER_PRINT_EVERY
	sim._order_tick(m, m["t"], 0.1, "mint")
	_check(int(m["printed"]) == Data.ORDER_PRINT_MAX, "the Issuer printed past %d" % Data.ORDER_PRINT_MAX)
	_check(sim.order_chips().any(func(c): return str(c[1]) == "Printed") and sim.order_chips(true).is_empty(), "no Printed chip on the Issuer, or one on you")
	m["my_dots"] = {}
	m["fresh"] = false                     # past the underlay's grace and a med's immunity: their fire lands
	m["immune_t"] = 0.0
	m["printed"] = 0
	m["print_pool"] = 0.0
	m["print_t"] = 0.0
	sim._fight(m, m["t"], 0.1)
	var alone: float = float(m.get("last_incoming", 0.0))
	m["printed"] = 3
	m["print_pool"] = float(m["t"]["hp"]) * 3.0
	m["my_dots"] = {}
	sim._fight(m, m["t"], 0.1)
	_check(float(m.get("last_incoming", 0.0)) > alone * 1.5, "the Issuer's printed men don't fire: %.1f against %.1f alone" % [float(m.get("last_incoming", 0.0)), alone])
	sim.extract_now()
	# the uniques: one of the two
	var seen := {}
	var p: Dictionary = Data.pinnacle("grid")
	for k in range(40):
		if sim.on_mission():
			sim.extract_now()
		sim.deploy(3)
		var mm: Dictionary = sim.mission
		mm["found"] = []
		sim.order_beaten["grid"] = 0
		sim._order_down(mm, mm["t"], {"order": "grid", "name": p["who"]})
		for it in mm["found"]:
			seen[str(it.get("unique", ""))] = true
		sim.extract_now()
	_check(seen.has(p["unique"]) and seen.has(p["unique2"]), "the Lineman doesn't drop one of his two: %s" % str(seen.keys()))
	# the Belt: shocked men take more from your skills
	sim.equipped["Backpack"] = Items.roll_unique(sim._unique_named("The Lineman's Tool Bag"), sim.rng, 10)
	sim._dry_memo.clear()
	m = head_run.call("")
	m["shock_t"] = 2.0
	m["target_hp"] = 10000.0
	sim._skill_damage(m, 100.0)
	_check(sim.has_rule("linemans_bag") and is_equal_approx(10000.0 - float(m["target_hp"]), 100.0 * Data.FX["rule/linemans_bag.skills"] * (1.25 if sim.has_joint("recruit_physical") else 1.0)), "the Belt's skills on the shocked: %.1f" % (10000.0 - float(m["target_hp"])))
	sim.extract_now()
	# the Stamp: every third skill free
	sim.load_dict(hold)
	sim.equipped["Charm"] = Items.roll_unique(sim._unique_named("The Registrar's Stamp"), sim.rng, 10)
	sim._dry_memo.clear()
	var sid := ""
	for id in Data.SKILLS:
		if str(Data.SKILLS[id]["cls"]) == sim.cls and float(Data.SKILLS[id].get("cash", 0.0)) <= 0.0 and float(Data.SKILLS[id].get("cost", 0.0)) > 0.0 and not Data.SKILLS[id].get("once_fight", false):
			sid = id
			break
	_check(sid != "" and learn_skill.call(sid), "the Stamp's fixture has no skill: '%s'" % sid)
	if sid != "":
		sim.skill_slots = [sid, "", ""]
		sim.hp = sim.max_hp()
		sim.deploy(0)
		m = sim.mission
		if not m.has("sk"):
			m["sk"] = {}
		sim._skills_fight_start(m)
		var spent: Array = []
		for k in range(3):
			m["sk"]["energy"] = 100.0
			sim._skill_fire(m, m["t"], 0)
			spent.append(100.0 - float(m["sk"]["energy"]))
		_check(spent[0] > 0.0 and spent[1] > 0.0 and spent[2] <= spent[0] - sim.skill_cost_now(0) + 0.01, "the Stamp's third skill wasn't free: %s" % str(spent))
		sim.extract_now()
	# the Revolver: a kill's hit printed on the next
	var downs := []
	for with_it in [false, true]:
		sim.load_dict(hold)
		if with_it:
			sim.equipped["Secondary"] = Items.roll_unique(sim._unique_named("The Issuer's Revolver"), sim.rng, 10)
		sim._dry_memo.clear()
		sim.hp = sim.max_hp()
		sim.rng.seed = 777
		sim.deploy(0)
		m = sim.mission
		m["remaining"] = 5
		m["target_hp"] = 1.0
		m["fresh"] = false
		var left0: int = int(m["remaining"])
		sim._fight(m, m["t"], 0.5)
		downs.append([left0 - int(m["remaining"]), float(m["target_hp"]), float(m.get("by_src", {}).get("rule:issuers_revolver", 0.0)), float(m.get("dealt", 0.0))])
		sim.extract_now()
	# the next man's hp rolls by the rng, so the print reads in its own row: counted, and inside what was dealt
	_check(downs[0][2] == 0.0 and downs[1][2] > 0.0 and downs[1][3] >= downs[1][2], "the Revolver didn't print the kill's hit on the next: %s" % str(downs))
	sim.load_dict(hold)
	main.refresh()
	print("the order's fights ok: the shield, the seal, the printing, the new uniques")


## Patterns (24 Oct, the endgame chase, phase 4): a unique broken down keeps its rule as a pattern at the Workshop; a
## pattern goes on a rare or better of its slot for a pinnacle's drop, a dozen of a material and tins, and the item
## then has the unique's power; the wrong slot, a plain piece, a unique or a mythic takes none; a save keeps both. On
## screen: the Workshop's Patterns view, every word in its box.
func _pattern_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var hold: Dictionary = sim.to_dict()
	sim.patterns = []
	var u: Dictionary = sim._unique_named("The Butcher's Steel")
	var steel: Dictionary = Items.roll_unique(u, sim.rng, 10)
	sim.stash.append(steel)
	_check(sim.can_break(steel) == "" and sim.break_unique(steel) and not sim.stash.has(steel) and sim.patterns.size() == 1 and str(sim.patterns[0]["rule"]) == str(u["rule"]), "breaking a unique didn't keep its pattern: %s" % str(sim.patterns))
	var rare: Dictionary = sim._plain("Primary", "Machete") if not sim._plain("Primary", "Machete").is_empty() else sim._plain("Primary", _base_of_type("melee"))
	rare["rarity"] = Data.PATTERN_RARITY
	var plain: Dictionary = sim._plain("Primary", str(rare["base"]))
	plain["rarity"] = 0
	var hat: Dictionary = sim._plain("Helmet", "Hard hat")
	hat["rarity"] = Data.PATTERN_RARITY
	sim.stash.append_array([rare, plain, hat])
	sim.key_items["ledger_seal"] = 1
	var c: Dictionary = sim.pattern_cost(rare)
	sim.materials[str(c["material"])] = int(c["material_n"])
	sim.cash = float(c["tins"]) + 10.0
	_check(sim.pattern_block(plain, 0) != "" and sim.pattern_block(hat, 0).contains("Primary") and sim.pattern_block(rare, 0) == "", "a pattern's blocks: plain '%s', hat '%s', rare '%s'" % [sim.pattern_block(plain, 0), sim.pattern_block(hat, 0), sim.pattern_block(rare, 0)])
	_check(sim.apply_pattern(rare, 0) and str(rare.get("rule", "")) == str(u["rule"]) and str(rare.get("pattern", "")) == u["name"] and sim.patterns.is_empty() and sim.held_of("ledger_seal") == 0 and sim.cash < 11.0, "putting the pattern on didn't take: %s" % str(rare))
	sim.stash.erase(rare)
	sim.equipped["Primary"] = rare
	sim._rules_key = []
	_check(sim.has_rule(str(u["rule"])), "a worn piece with a pattern hasn't the unique's power")
	_check(not load("res://scripts/ui/item_head.gd").unique_rule(rare).is_empty(), "the pattern's power isn't on the piece's card")
	var d: Dictionary = sim.to_dict()
	d["patterns"] = [{"unique": "x", "slot": "Primary", "rule": "y"}]
	var r = load("res://scripts/sim/sim.gd").new()
	r.load_dict(JSON.parse_string(JSON.stringify(d)))
	_check(r.patterns.size() == 1 and str(r.equipped["Primary"].get("pattern", "")) == u["name"], "a save lost the patterns or the piece's: %s" % str(r.patterns))
	# the view
	sim.stash.append(Items.roll_unique(u, sim.rng, 10))
	main.show_room(main.WORKSHOP)
	main._workshop._set_view("patterns")
	main.refresh()
	_check(main._workshop._pat.visible and main._workshop.pattern_text_nodes().size() > 4, "the Patterns view didn't show")
	for l in main._workshop.pattern_text_nodes():
		if l is Label:
			_check(l.get_minimum_size().x <= l.size.x + 1.0 or l.autowrap_mode != TextServer.AUTOWRAP_OFF, "a Patterns word runs out of its box: '%s'" % l.text)
	_check_fit(main, "Workshop (patterns)")
	# the break asks twice
	var ws = main._workshop
	var u2: Dictionary = sim.stash.back()
	ws.sel_id = int(u2["id"])
	var held: int = sim.patterns.size()
	ws._do_break()
	_check(sim.stash.has(u2) and sim.patterns.size() == held and ws._pat_break.text in UI.ask_forms(Words.PATTERNS["break_sure"]), "the first press broke the unique, or didn't ask again")
	ws._do_break()
	_check(not sim.stash.has(u2) and sim.patterns.size() == held + 1, "the second press didn't break it")
	main._workshop._set_view("guns")
	sim.load_dict(hold)
	main.refresh()
	print("patterns ok: broken down, put on, the power worn, the save, the view")


## The loot filter (24 Oct, the endgame chase, phase 5): a rule fits by kind, rarity, slot, gun and best affix; the first
## that fits wins; scrapped for scrap, highlighted, kept; never a first gun or the rig's; off, nothing's touched; the
## extraction runs them; the save keeps them; the Kit's button and panel, each change in place, the fit.
func _loot_rule_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var hold: Dictionary = sim.to_dict()
	sim.loot_rules = []
	sim.loot_rules_on = true
	var mk := func(slot: String, base: String, rar: int, tier: int) -> Dictionary:
		var it: Dictionary = sim._plain(slot, base)
		it["rarity"] = rar
		it["affixes"] = [{"stat": "armour", "value": 1.0, "tier": tier}] if tier > 0 else []
		it["value"] = maxf(float(it["value"]), 200.0)
		return it
	var common: Dictionary = mk.call("Helmet", "Hard hat", 0, 0)
	var rare5: Dictionary = mk.call("Helmet", "Hard hat", 2, 5)
	var rare2: Dictionary = mk.call("Helmet", "Hard hat", 2, 2)
	var smg: Dictionary = mk.call("Primary", _base_of_type("smg"), 3, 1)
	var rifle: Dictionary = mk.call("Primary", _base_of_type("rifle"), 3, 1)
	var uniq: Dictionary = Items.roll_unique(sim._unique_named("The Butcher's Steel"), sim.rng, 10)
	var first: Dictionary = mk.call("Primary", _base_of_type("smg"), 0, 0)
	first["first_gun"] = true
	var none: Array = [common.duplicate(true)]
	_check(sim.apply_loot_rules(none).size() == 1 and sim.loot_rule_act(common) == "", "no rules, yet a find was touched")
	# the rules: the specials kept, a T5 highlighted, smgs epic and up kept, commons and uncommons scrapped
	_check(sim.loot_rule_add() and sim.loot_rule_act(common) == "" and sim.loot_rule_act(rare5) == "", "a new rule isn't harmless: %s" % str(sim.loot_rules))
	sim.loot_rules = []
	for k in range(4):
		_check(sim.loot_rule_add(), "a rule wouldn't add")
		sim.loot_rules[k]["upto"] = 4
		sim.loot_rules[k]["on"] = true
	sim.loot_rules[0]["kind"] = "special"
	sim.loot_rules[0]["act"] = "keep"
	sim.loot_rules[1]["tier"] = 5
	sim.loot_rules[1]["act"] = "highlight"
	sim.loot_rules[2].merge({"rarity": 3, "slot": "Primary", "gun": "smg", "act": "keep"}, true)
	sim.loot_rules[3].merge({"rarity": 0, "upto": 1, "act": "scrap"}, true)
	_check(sim.loot_rule_act(uniq) == "keep" and sim.loot_rule_act(rare5) == "highlight" and sim.loot_rule_act(smg) == "keep" and sim.loot_rule_act(rifle) == "" and sim.loot_rule_act(common) == "scrap" and sim.loot_rule_act(rare2) == "",
		"the rules' acts: unique %s, T5 %s, smg %s, rifle %s, common %s, rare %s" % [sim.loot_rule_act(uniq), sim.loot_rule_act(rare5), sim.loot_rule_act(smg), sim.loot_rule_act(rifle), sim.loot_rule_act(common), sim.loot_rule_act(rare2)])
	_check(sim.loot_rule_words(sim.loot_rules[0]) == Words.LOOT_RULES["special"] and sim.loot_rule_words(sim.loot_rules[2]).contains("SMG") and sim.loot_rule_words(sim.loot_rules[3]).begins_with("Up to Uncommon"), "the rules' words: '%s', '%s'" % [sim.loot_rule_words(sim.loot_rules[2]), sim.loot_rule_words(sim.loot_rules[3])])
	# a common with a T5: scrapped below the highlight's rule, highlighted above it
	var common5: Dictionary = mk.call("Helmet", "Hard hat", 0, 5)
	_check(sim.loot_rule_act(common5) == "highlight", "a common with a T5 wasn't caught by the rule above the scrap")
	sim.loot_rule_up(3)
	sim.loot_rule_up(2)
	_check(sim.loot_rule_act(common5) == "scrap" and str(sim.loot_rules[1]["act"]) == "scrap", "the scrap moved up didn't win: %s" % sim.loot_rule_act(common5))
	sim.loot_rule_up(2)
	sim.loot_rule_up(3)
	_check(str(sim.loot_rules[3]["act"]) == "scrap" and int(sim.loot_rules[1]["tier"]) == 5, "the rules didn't move back")
	# a batch: the scrap counted, the highlight marked, the first gun and the rig's let by
	var scrap0: int = int(sim.scrap)
	var c2: Dictionary = common.duplicate(true)
	var rig_med: Dictionary = common.duplicate(true)
	rig_med["from_rig"] = true
	var worn: Dictionary = common.duplicate(true)
	worn["spared"] = true
	var out: Array = sim.apply_loot_rules([c2, rare5, uniq, first, rig_med, worn])
	_check(not out.has(c2) and out.has(rare5) and bool(rare5.get("hl", false)) and out.has(uniq) and not uniq.has("hl") and out.has(first) and out.has(rig_med) and out.has(worn) and int(sim.scrap) == scrap0 + sim.scrap_of(c2),
		"the batch: %d out, scrap %d from %d (%d wanted)" % [out.size(), int(sim.scrap), scrap0, sim.scrap_of(c2)])
	# Keep keeps: a kept common is never junk, and the Bins pass it by
	var kc: Dictionary = common.duplicate(true)
	sim.loot_rules[3]["act"] = "keep"
	sim.apply_loot_rules([kc])
	sim.junk_upto = 3
	_check(not sim.is_junk(kc) and sim._bin_commons([kc]).has(kc), "a kept common could still be sold or binned")
	sim.loot_rules[3]["act"] = "scrap"
	_check(sim.is_junk(kc) or sim.compare(kc) == 1, "a common the rules no longer keep is still never sold")
	sim.junk_upto = -1
	# a special rule set to scrap keeps them all the same: a unique, a mythic, a patterned rare
	sim.loot_rules[0]["act"] = "scrap"
	var myth: Dictionary = rare2.duplicate(true)
	myth["mythic"] = true
	var patd: Dictionary = rare2.duplicate(true)
	patd["pattern"] = "The Butcher's Steel"
	var out2: Array = sim.apply_loot_rules([uniq.duplicate(true), myth, patd])
	_check(out2.size() == 3, "a special rule scrapped a unique, a mythic or a patterned piece: %d of 3 kept" % out2.size())
	sim.loot_rules[0]["act"] = "keep"
	# off: nothing touched; a rule switched off is passed over
	sim.loot_rules_on = false
	_check(sim.apply_loot_rules([common.duplicate(true)]).size() == 1 and sim.loot_rule_act(common) == "", "the rules off, yet a common went")
	sim.loot_rules_on = true
	sim.loot_rules[3]["on"] = false
	_check(sim.loot_rule_act(common) == "", "a rule switched off still scrapped")
	sim.loot_rules[3]["on"] = true
	# the extraction runs them
	sim.hp = sim.max_hp()
	sim.wounds = {}
	sim.deploy(0)
	_check(sim.mission != null, "the loot filter's run wouldn't set off")
	if sim.mission != null:
		var c3: Dictionary = common.duplicate(true)
		c3["rarity"] = 1                      # an uncommon: the Stash's Bins take commons first, so the rules alone scrap it
		c3["id"] = 990001
		sim.mission["found"] = [c3]
		var scrap1: int = int(sim.scrap)
		sim.extract_now()
		_check(not sim.stash.any(func(x): return int(x.get("id", -1)) == 990001) and int(sim.scrap) >= scrap1 + sim.scrap_of(c3), "the extraction didn't run the rules: scrap %d from %d" % [int(sim.scrap), scrap1])
	# the save
	sim.loot_rules_on = false
	var r = load("res://scripts/sim/sim.gd").new()
	r.load_dict(JSON.parse_string(JSON.stringify(sim.to_dict())))
	_check(r.loot_rules.size() == 4 and str(r.loot_rules[2]["gun"]) == "smg" and int(r.loot_rules[1]["tier"]) == 5 and not r.loot_rules_on, "a save lost the rules: %s" % str(r.loot_rules))
	sim.loot_rules_on = true
	for k in range(4):
		sim.loot_rule_add()
	_check(sim.loot_rules.size() == sim.LOOT_RULES_MAX and not sim.loot_rule_add(), "the rules passed their cap")
	sim.loot_rules.resize(4)
	# the Kit: the button, the panel, a change in place, the highlight on its cell, the fit
	main.show_room(main.ARMOURY)
	var arm = main._armoury
	arm.selected = {}
	main.refresh()
	_check(arm.rules_button.visible and arm.rules_button.text == Words.LOOT_RULES["button"] % 4, "the Kit's rules button reads '%s'" % arm.rules_button.text)
	_check(arm.rules_button.position.x + arm.rules_button.size.x <= arm._inv.position.x + arm._inv._page_prev.position.x - 4.0, "the rules button runs into the pages")
	arm.rules_button.pressed.emit()
	main.refresh()
	var rp = arm.rules_panel
	_check(rp.visible and not arm.rules_button.visible and rp.picked == 0 and rp._rows[3]["words"].visible and not rp._rows[4]["words"].visible, "the rules panel didn't open on its rows")
	rp._pick(3)
	rp._set_slot(1)
	rp._set_gun(2)
	rp._set_act(1)
	_check(str(sim.loot_rules[3]["slot"]) == "Primary" and str(sim.loot_rules[3]["gun"]) == "rifle" and str(sim.loot_rules[3]["act"]) == "highlight" and rp._rows[3]["act"].text == Words.LOOT_RULES["highlight"], "the editor didn't change the rule in place: %s" % str(sim.loot_rules[3]))
	rp._set_slot(3)
	_check(str(sim.loot_rules[3]["gun"]) == "" and rp._gun_btns[1].disabled, "a Body rule kept its gun, or the guns stayed live")
	rp._step("upto")
	_check(int(sim.loot_rules[3]["upto"]) <= Data.RARITIES.size() - 1 and int(sim.loot_rules[3]["rarity"]) <= int(sim.loot_rules[3]["upto"]), "From and To crossed: %s" % str(sim.loot_rules[3]))
	rp._add_rule()
	_check(sim.loot_rules.size() == 5 and rp.picked == 4 and rp._rows[4]["words"].visible, "Add a rule didn't add and pick it")
	rp._delete_rule()
	_check(sim.loot_rules.size() == 5 and rp._delete.text in UI.ask_forms(Words.LOOT_RULES["delete_sure"]), "Delete took the rule on one press, or didn't say: '%s'" % rp._delete.text)
	rp._del_arm._at -= int(Arm.WINDOW_S * 1000.0) + 500     # the window runs out: a first press again
	rp._process(0.0)
	_check(rp._delete.text == Words.LOOT_RULES["delete"], "Delete's arm outlived its window: '%s'" % rp._delete.text)
	rp._delete_rule()
	rp._delete_rule()
	_check(sim.loot_rules.size() == 4, "Delete didn't take the rule on the second press")
	# every ask-twice arm runs out after its window (Matt, 26 Oct: four seconds) and reads one way
	var arm_t = Arm.new()
	arm_t.press("k", "x")
	_check(arm_t.holds("k", "x") and is_equal_approx(Arm.WINDOW_S, 4.0), "an arm doesn't hold, or its window isn't four seconds")
	arm_t._at -= int(Arm.WINDOW_S * 1000.0) + 1
	_check(not arm_t.holds("k", "x") and not arm_t.press("k", "x"), "an arm acted past its window")
	for w in [Words.FENCE_SURE % 52, Words.LOADOUTS["save_sure"], Words.BUILD["reset_sure"], Words.BUILD["ring_sure"], Words.PATTERNS["break_sure"], Words.ISSUED["burn_sure"], Words.LOOT_RULES["delete_sure"]]:
		_check(not w.contains("gain") and not w.contains("?"), "an ask-twice's words carry their own 'again': '%s'" % w)
	rp._toggle_all()
	_check(not sim.loot_rules_on and rp._on.text == Words.LOOT_RULES["off"], "Rules off didn't switch")
	rp._toggle_all()
	for n in rp.text_nodes():
		var need: float = UI.text_width(n, n.text) + (32.0 if n is Button else 0.0)
		_check(need <= n.size.x + 1.0, "a rules panel word runs out of its box: '%s' needs %.0f, has %.0f" % [n.text, need, n.size.x])
		_check(n.position.x >= 0.0 and n.position.x + n.size.x <= rp.size.x + 0.5 and n.position.y + n.size.y <= rp.size.y + 0.5, "'%s' leaves the rules panel" % n.text)
	_check_fit(main, "The Kit (loot rules)")
	rp._close.pressed.emit()
	main.refresh()
	_check(not rp.visible and arm.rules_button.visible, "Close didn't shut the rules panel")
	arm.selected = {}
	arm.open_rules()
	main.refresh()
	_check(not arm.loadout_cards.any(func(c): return c["panel"].visible), "a loadout card shows over the rules panel")
	arm.close_rules()
	main.refresh()
	_check(arm.loadout_cards.all(func(c): return c["panel"].visible), "the loadouts didn't come back after the rules")
	arm.open_rules()
	main.show_room(main.RUNNER)
	main.show_room(main.ARMOURY)
	main.refresh()
	_check(not rp.visible, "the rules panel stayed open across a room change")
	arm.open_rules()
	arm._inv.many = true
	main.refresh()
	_check(not rp.visible and not arm.rules_button.visible, "the rules panel stayed open over Select-many")
	arm._inv.many = false
	main.refresh()
	# a patterned piece is kept like its unique: never junk, never a contract's
	sim.junk_upto = 3
	_check(not sim.is_junk(patd) and not sim.contract_fits({"kind": "gear", "slot": "Helmet", "rarity": 0}, patd), "a patterned piece could be sold as junk or handed in")
	sim.junk_upto = -1
	var lit: Dictionary = rare5.duplicate(true)
	lit["id"] = 990002
	lit["hl"] = true
	sim.stash.append(lit)
	arm._inv.page = 0
	main.refresh()
	var k: int = arm._inv.cell_of(990002)
	_check(k < 0 or arm._inv._cells[k].mark == "hl", "a highlighted find isn't edged in the stash")
	if k >= 0:
		arm._inv._pick(k)
		_check(not lit.has("hl") and arm._inv._cells[k].mark != "hl", "the highlight stayed once the piece was picked")
	sim.load_dict(hold)
	main.refresh()
	print("the loot filter ok: the fits, the first wins, scrap, highlight, the switches, the extraction, the save, the Kit's panel")


## The collection (24 Oct, the endgame chase, phase 6): the tiles count what's found and done, a unique found shows its
## name and the rest a "?", a site's marks by depth, a set complete once its pieces are found, the save; no power; the
## Stats room's button and panel, the fit.
func _collection_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var hold: Dictionary = sim.to_dict()
	var dps0: float = float(sim.damage_split()["total"])
	sim.shelf = []
	sim.sets_seen = []
	var col: Dictionary = sim.collection()
	_check(int(col["tiles"][0][1]) == 0 and int(col["tiles"][0][2]) == col["uniques"].size() and col["uniques"].size() > 20 and col["sites"].size() == Data.TIERS.size(), "the empty collection: %s" % str(col["tiles"]))
	var u: Dictionary = sim._unique_named("The Butcher's Steel")
	sim._read(Items.roll_unique(u, sim.rng, 10))
	var st: Dictionary = Data.SETS[0]
	for pc in st["pieces"]:
		sim._read({"set": st["name"], "piece": pc["name"], "slot": pc["slot"], "base": pc["base"]})
	sim.best_depth[0] = Data.COLLECTION_LEVELS[-1] + 20
	col = sim.collection()
	var row: Array = col["uniques"].filter(func(x): return x[0] == u["name"])
	_check(int(col["tiles"][0][1]) == 1 and not row.is_empty() and row[0][2] and int(col["tiles"][5][1]) >= 1 and int(col["tiles"][2][1]) >= 1, "the collection didn't count a unique, a set or a site: %s" % str(col["tiles"]))
	_check(is_equal_approx(float(sim.damage_split()["total"]), dps0), "the collection changed the damage")
	var r = load("res://scripts/sim/sim.gd").new()
	r.load_dict(JSON.parse_string(JSON.stringify(sim.to_dict())))
	_check(r.sets_seen.size() == st["pieces"].size(), "a save lost the set pieces found")
	main.show_room(main.RUNNER)
	main.refresh()
	var room = main._stats
	_check(room != null and room.collection_button.visible and room.collection_button.text == Words.COLLECTION["button"], "the Record has no collection button")
	if room != null:
		room.collection_button.pressed.emit()
		_check(room.collection_panel != null and room.collection_text_nodes().size() > 40, "the collection didn't open")
		for n in room.collection_text_nodes():
			var need: float = UI.text_width(n, n.text) + (32.0 if n is Button else 0.0)
			_check(need <= n.size.x + 1.0, "a collection word runs out of its box: '%s' needs %.0f, has %.0f" % [n.text, need, n.size.x])
			_check(n.position.x + n.size.x <= room.COLL_W + 0.5 and n.position.y + n.size.y <= room.COLL_H + 0.5, "'%s' leaves the collection" % n.text)
		_check(room.collection_text_nodes().any(func(n): return n.text == u["name"]) and room.collection_text_nodes().any(func(n): return n.text.begins_with("? · ")), "the found unique or the unfound '?' isn't shown")
		_check_fit(main, "Stats (collection)")
		room.hide_collection()
		_check(room.collection_panel == null, "the collection didn't close")
	sim.load_dict(hold)
	main.refresh()
	print("the collection ok: the tiles, the uniques found and not, the sites' marks, the sets, the save, no power, the panel")


## Loadouts and the build code (24 Oct, the endgame chase, phase 7): a loadout saves what's worn and wears it back
## from the stash, names a piece that's gone and leaves what's on; the rig and the skills come too; the save keeps
## them, by class. A build code round-trips; a pasted one shows its plan and changes nothing till Retrain; a wrong
## class or a bad code is said; the Kit's cards and Training's panel fit.
func _loadout_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var hold: Dictionary = sim.to_dict()
	sim.loadouts = {}
	sim.cash = 1e9
	sim.stash = sim.stash.filter(func(x): return Items.rig_item(x)).slice(0, 10)     # room for the swaps: a full stash refuses them (the full run)
	_check(sim.loadout_state(0) == "empty" and not sim.loadout_wear(0), "an empty loadout wore")
	var gun0: Dictionary = sim._plain("Primary", str(Data.FIRST_GUNS[0][1]))      # a gun he can wear: the smoke's own may be over his level
	gun0["id"] = 991000
	sim.equipped["Primary"] = gun0
	sim.skill_slots = sim.skill_slots.map(func(x): return str(x) if str(x) != "" and sim.skill_known(str(x)) else "")
	if sim.rig.filter(func(x): return Items.is_medical(x)).is_empty():
		if not sim.rig_room(1) and not sim.rig.is_empty():
			sim.rig.pop_back()                 # a full rig: a pouch made for the med
		sim.rig.append(sim._plain(Data.MEDICAL, "Bandage"))
	_check(gun0 != null and sim.loadout_save(0) and sim.loadout_state(0) == "worn", "a loadout didn't save what's worn: %s" % sim.loadout_state(0))
	# a second gun on, then loadout 0 back
	var gun1: Dictionary = sim._plain("Primary", str(gun0["base"]))
	gun1["id"] = 991001
	sim.stash.append(gun1)
	_check(sim.equip_item(991001) and sim.loadout_state(0) == "ready", "the stash gun didn't go on, or loadout 0 isn't ready: %s" % sim.loadout_state(0))
	sim.loadout_save(1)
	var skills0: Array = sim.skill_slots.duplicate()
	sim.skill_slots = ["", "", ""]
	var rig0: int = sim.rig.size()
	var meds: Array = sim.rig.filter(func(x): return Items.is_medical(x))
	_check(not meds.is_empty(), "the loadout fixture's rig has no med")
	if not meds.is_empty():
		sim.rig.erase(meds[0])
		sim.stash.append(meds[0])          # a med out of the rig: wearing the loadout brings it back
	_check(sim.loadout_wear(0) and int(sim.equipped["Primary"]["id"]) == int(gun0["id"]) and sim.stash.has(gun1) and sim.loadout_state(0) == "worn", "loadout 0 didn't wear back")
	_check(sim.skill_slots == skills0 and sim.rig.size() == rig0, "loadout 0's skills or rig didn't come back: %s, rig %d of %d" % [str(sim.skill_slots), sim.rig.size(), rig0])
	# a piece gone: named, and what's on stays on
	sim.stash.erase(gun1)
	_check(sim.loadout_state(1) == "short" and sim.loadout_missing(1).size() == 1, "a gone piece isn't said: %s" % str(sim.loadout_missing(1)))
	_check(sim.loadout_wear(1) and int(sim.equipped["Primary"]["id"]) == int(gun0["id"]), "a gone piece took what was on off")
	sim.stash.append(gun1)
	# the save, by class
	var r = load("res://scripts/sim/sim.gd").new()
	r.load_dict(JSON.parse_string(JSON.stringify(sim.to_dict())))
	_check(r.loadout(1).get("gear", {}).get("Primary", -1) == 991001 and r.loadouts.has(sim.cls) and r.loadouts[sim.cls].size() == Data.LOADOUTS, "a save lost the loadouts: %s" % str(r.loadouts))
	# the Kit's cards
	main.show_room(main.ARMOURY)
	var arm = main._armoury
	arm.selected = {}
	arm._shown = ""
	main.refresh()
	_check(arm.loadout_cards.size() == 3 and arm.loadout_cards[0]["panel"].visible and arm.loadout_cards[0]["state"].text == Words.LOADOUTS["worn_now"] and arm.loadout_cards[2]["what"].text.begins_with("Empty"), "the Kit's loadouts: '%s', '%s'" % [arm.loadout_cards[0]["state"].text, arm.loadout_cards[2]["what"].text])
	for c in arm.loadout_cards:
		for key in ["name", "state", "what", "more", "wear", "save"]:
			var n = c[key]
			var need: float = UI.text_width(n, n.text) + (32.0 if n is Button else 0.0)
			_check(need <= n.size.x + 1.0, "a loadout card word runs out: '%s' needs %.0f, has %.0f" % [n.text, need, n.size.x])
		_check(c["panel"].position.y + c["panel"].size.y <= arm._pick.position.y + arm._pick._buttons[0].position.y - 4.0, "a loadout card runs into the toggles")
	arm.loadout_cards[0]["save"].pressed.emit()
	_check(arm.loadout_cards[0]["save"].text in UI.ask_forms(Words.LOADOUTS["save_sure"]), "saving over a kit didn't ask twice: '%s'" % arm.loadout_cards[0]["save"].text)
	arm.loadout_cards[1]["wear"].pressed.emit()
	_check(arm.loadout_cards[0]["save"].text == Words.LOADOUTS["save"], "the save's arm outlived another press")
	main.refresh()
	_check(int(sim.equipped["Primary"]["id"]) == 991001, "the card's Wear didn't wear loadout 2")
	_check_fit(main, "The Kit (loadouts)")
	arm._pick_slot("Primary")
	main.refresh()
	_check(not arm.loadout_cards[0]["panel"].visible, "the loadouts stayed over a pick")
	arm.selected = {}
	main.refresh()
	# the build code: a few of the class's own nodes trained first, so there's a build to cut
	sim.training_points += 40
	var got := 0
	for pass_n in range(4):
		for t in sim.trees():
			for k in range(t["nodes"].size()):
				var nid: String = "%s/%d" % [t["name"], k]
				if got < 4 and not sim.is_camp(nid) and not sim.tree.has(nid) and sim.can_train(nid) and sim.train_node(nid):
					got += 1
	var code: String = sim.build_code()
	var bd: Dictionary = sim.build_read(code)
	_check(code.begins_with(Data.BUILD_PREFIX) and bd.get("cls", "") == sim.cls and bd["nodes"].size() == sim.tree.filter(func(id): return not sim.is_ring(str(id))).size() and bd["skills"] == sim.skill_slots.filter(func(x): return str(x) != ""), "a build code didn't round-trip: %s" % str(bd))
	_check(sim.build_read("FIAT1-!!").is_empty() and sim.build_read("hello").is_empty(), "a bad code read as a build")
	var body: String = code.substr(Data.BUILD_PREFIX.length()).replace("-", "+").replace("_", "/")
	while body.length() % 4 != 0:
		body += "="
	var raw: PackedByteArray = Marshalls.base64_to_raw(body)
	raw[0] = (int(raw[0]) + 1) % 256
	var aged: String = Data.BUILD_PREFIX + Marshalls.raw_to_base64(raw).replace("+", "-").replace("/", "_").replace("=", "")
	_check(sim.build_read(aged).has("old") and str(sim.build_plan(sim.build_read(aged))["block"]) == Words.BUILD["old"], "another version's code read as a build")
	_check(not bd["nodes"].any(func(id): return sim.is_camp(str(id))), "a build code carried the camp's nodes")
	var tree0: Array = sim.tree.duplicate()
	var cash0: float = sim.cash
	var plan: Dictionary = sim.build_plan(bd)
	_check(str(plan["block"]) == "" and int(plan["trained"]) == int(plan["of"]) and sim.tree == tree0 and sim.cash == cash0, "the plan changed something, or the own build won't retrain: %s" % str(plan))
	var other: Dictionary = bd.duplicate(true)
	other["cls"] = str(Data.CLASSES[0]["name"]) if sim.cls != str(Data.CLASSES[0]["name"]) else str(Data.CLASSES[1]["name"])
	_check(str(sim.build_plan(other)["block"]).contains(str(other["cls"])), "another class's build isn't said")
	var shuffled: Dictionary = bd.duplicate(true)
	shuffled["nodes"].reverse()
	_check(int(sim.build_plan(shuffled)["cost"]) == 0, "the same nodes in another order asked for a reset")
	# a smaller build: retrained into, the cost paid, the nodes as the code
	var own: Array = bd["nodes"].filter(func(id): return not sim.is_camp(str(id)))
	_check(own.size() > 2, "the build code's fixture has too few class nodes: %d" % own.size())
	if own.size() > 2:
		var small: Dictionary = bd.duplicate(true)
		var cut: String = str(own[-1])
		small["nodes"].erase(cut)
		var res: Dictionary = sim.build_apply(small)
		_check(str(res["block"]) == "" and not sim.tree.has(cut) and int(res["cost"]) > 0 and sim.cash < cash0, "retraining into a smaller build: %s" % str(res))
	# Training's buttons and the plan panel
	main.show_room(main.BARRACKS)
	main.refresh()
	var bk = main._barracks
	_check(bk.code_copy.visible and bk.code_paste.visible, "Training has no build code buttons")
	bk.paste_text = code
	bk.code_paste.pressed.emit()
	_check(bk.code_panel.visible and not bk._code_go.disabled and not bk.pending_build.is_empty(), "a pasted code shows no plan")
	for n in bk.code_text_nodes():
		var need: float = UI.text_width(n, n.text) + (32.0 if n is Button else 0.0)
		_check(need <= n.size.x + 1.0, "a build code word runs out: '%s' needs %.0f, has %.0f" % [n.text, need, n.size.x])
	_check_fit(main, "Training (a build code)")
	bk._code_go.pressed.emit()
	_check(not bk.code_panel.visible and bk.pending_build.is_empty(), "Retrain didn't take the code")
	bk.read_code("nonsense")
	_check(bk.code_panel.visible and bk._code_go.disabled, "a bad code could be retrained into")
	main.show_room(main.RUNNER)
	_check(not bk.code_panel.visible, "the code's plan stayed after the room changed")
	bk.paste_text = ""
	sim.load_dict(hold)
	main.refresh()
	print("loadouts and build codes ok: save, wear, gone pieces, the save, the Kit's cards, a code both ways, the plan, the retrain, the panel")


## The review's bugs (25 Oct, docs/review/game.md A1-A8): each with the check that would have caught it.
func _review_fix_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var hold: Dictionary = sim.to_dict()
	# A1: another class's read leaves the camp's nodes - the elements' and the ring's - where they were
	if sim.cls == "":
		sim.set_class(str(Data.CLASSES[0]["name"]))
	var other: String = str(Data.CLASSES[1]["name"]) if sim.cls != str(Data.CLASSES[1]["name"]) else str(Data.CLASSES[0]["name"])
	var el_id: String = "%s/0" % str(Data.ELEMENT_TREES[0]["name"])
	if not sim.tree.has(el_id):
		sim.tree.append(el_id)
	var ring_id: String = "%s/0" % str(Data.RING["name"])
	if not sim.tree.has(ring_id):
		sim.tree.append(ring_id)
	var me: String = sim.cls
	sim.set_class(other)
	sim.set_class(me)
	var tree0: Array = sim.tree.duplicate()
	var h: Dictionary = sim._read_as(other)
	sim._read_back(h)
	_check(sim.cls == me and sim.tree.has(el_id) and sim.tree.has(ring_id) and sim.tree.size() == tree0.size(), "another class's read dropped the camp's nodes: %d of %d, element %s, ring %s" % [sim.tree.size(), tree0.size(), str(sim.tree.has(el_id)), str(sim.tree.has(ring_id))])
	# A2: the skills are the class's: a swap empties the slots for one who knows none, and the way back brings them
	var sk_ids: Array = Data.SKILLS.keys().filter(func(id): return str(Data.SKILLS[id]["cls"]) == me)
	if not sk_ids.is_empty():
		sim.skill_slots = [str(sk_ids[0]), "", ""]
		sim.set_class(other)
		_check(not sim.skill_slots.has(str(sk_ids[0])), "a swap kept the last class's skill in the slots: %s" % str(sim.skill_slots))
		sim.set_class(me)
		_check(sim.skill_slots[0] == str(sk_ids[0]) or not sim.skill_known(str(sk_ids[0])), "the way back lost the class's skills: %s" % str(sim.skill_slots))
	# A4: Floored holds one man of three, not the gang
	var m := {"remaining": 3, "t": sim.tier(0), "floor_t": 1.0}
	var f: float = sim._joints_on_incoming(m, false, 0.1)
	var on: int = mini(3, sim.contact(sim.tier(0)))
	_check(on <= 1 or absf(f - (1.0 - 1.0 / on)) < 0.01, "Floored silenced %.2f of their fire with %d on you" % [1.0 - f, on])
	# A7: a skill's hit is cut by their resist to its type
	var m2 := {"t": {"res": {"shock": 0.5}}, "target_hp": 1000.0, "dealt": 0.0}
	sim._skill_damage(m2, 100.0, "shock", true)
	var cut: float = 1000.0 - float(m2["target_hp"])
	_check(cut > 0.0 and cut <= 60.0, "a skill's shock hit wasn't cut by a 50%% resist: %.0f of 100" % cut)
	# A8: the Arsonist's Rig grows with the fight
	var lasts_names: Array = [str(sim.node("Petrol/3").get("name", "")), str(sim.node("The Rat Man/3").get("name", "")), str(sim.node("Blades/3").get("name", ""))]
	_check(lasts_names == ["Lit", "Dosed", "Opened up"], "the dots' notables the sim doubles by id are now %s" % str(lasts_names))     # dot_seconds reads them by index (the reviewer, 25 Oct)
	_check(Data.FX.has("rule/arsonists_rig.blast") and Data.FX.has("node/fire_pct.notable_s") and Data.FX.has("node/cap_flattened.cut"), "the review's figures aren't in Data.FX")
	# the endgame's (25 Oct, Matt's go): tempering past the raise, compounding paragon, worth by item level, greed
	sim.xp = maxf(sim.xp, Data.xp_for_level(Data.MAX_LEVEL))
	var gun: Dictionary = sim._plain("Primary", "Pump shotgun")
	gun["id"] = 992001
	sim.stash.append(gun)
	_check(sim.temper_block(gun) == Words.TEMPER["raise_first"], "a plain piece under the raise tempers: '%s'" % sim.temper_block(gun))
	gun["ilvl"] = int(gun["tier"]) + sim.bump_cap()
	var dps0: float = Items.dps(gun)
	var worth0: float = Items.worth(gun)
	var sc0: int = sim.temper_scrap(gun)
	sim.scrap = 1000000
	sim.cash = 1e12
	var lv0: int = Items.ilvl(gun)
	_check(sim.temper_block(gun) == "" and sim.craft(992001, "temper") and Items.ilvl(gun) == lv0 + 1 and int(sim.scrap) == 1000000 - sc0, "a temper didn't take: '%s', level %d" % [sim.temper_block(gun), Items.ilvl(gun)])
	_check(Items.dps(gun) > dps0 and Items.worth(gun) > worth0 and sim.temper_scrap(gun) >= sc0, "a temper grew nothing: dps %.0f from %.0f, worth %.0f from %.0f, next %d from %d" % [Items.dps(gun), dps0, Items.worth(gun), worth0, sim.temper_scrap(gun), sc0])
	var uq: Dictionary = Items.roll_unique(sim._unique_named("The Butcher's Steel"), sim.rng, 10)
	_check(sim.temper_block(uq) == "", "a unique won't temper: '%s'" % sim.temper_block(uq))
	var myth: Dictionary = gun.duplicate(true)
	myth["mythic"] = true
	_check(sim.temper_block(myth) == Words.TEMPER["mythic"], "a mythic tempers")
	var pts_hold: Dictionary = sim.ring.duplicate()
	_check(is_equal_approx(pow(1.02, 10), pow(1.0 + float(Data.paragon_row("damage")["pct"]) / 100.0, 10)), "the paragon's damage isn't 2% a point")
	sim.ring = pts_hold
	sim.hp = sim.max_hp()
	sim.deploy(0)
	if sim.mission != null:
		var q0: float = sim.rarity_bonus()
		sim.mission["cleared"] = true
		sim.mission["patrols"] = 2
		_check(is_equal_approx(sim.rarity_bonus() - q0, 2.0 * Data.GREED_QUALITY * (Data.FX["rule/bookies_pencil.rarity"] if sim.has_rule("bookies_pencil") else 1.0)) and sim.greed_gangs() == 2, "greed after the clear: %.2f from %.2f" % [sim.rarity_bonus(), q0])
		sim.extract_now()
	# the UI's (docs/review/ui.md 1, 3, 5, 25, 26): the Fence's rarity row keeps a unique, a set piece, a patterned piece
	var leg: int = Data.RARITIES.size() - 1
	var u: Dictionary = Items.roll_unique(sim._unique_named("The Butcher's Steel"), sim.rng, 10)
	var patd: Dictionary = sim._plain("Helmet", "Hard hat")
	patd["rarity"] = leg
	patd["pattern"] = "The Butcher's Steel"
	sim.stash.append_array([u, patd])
	sim.sell_rarity(leg)
	_check(sim.stash.has(u) and sim.stash.has(patd), "the Fence's rarity row sold a unique or a patterned piece")
	var spare_common: Dictionary = sim._plain("Primary", "Army SMG")     # a common to sell, so the row's button is live (the reviewer: a disabled row passed it)
	spare_common["rarity"] = 0
	sim.stash.append(spare_common)
	var worn_was = sim.equipped.get("Primary", null)
	sim.equipped["Primary"] = sim._plain("Primary", "Army SMG")     # the same in hand: the spare's no upgrade the row keeps back
	main.show_room(main.MARKET)
	main._fence._show("shelf")
	main.refresh()
	var fs = main._fence._sell
	_check(not fs.row_of(0)["sell"].disabled, "the Fence's common row can't sell a spare common")
	var n_before: int = sim.stash.size()
	fs._sell(0)
	main.refresh()
	_check(sim.stash.size() == n_before and (fs.row_of(0)["sell"].text.contains("press again") or fs.row_of(0)["sell"].text == Words.ASK["short"]), "the Fence's Sell didn't ask twice: '%s'" % fs.row_of(0)["sell"].text)
	fs._sell(0)
	_check(not sim.stash.has(spare_common), "the Fence's second press didn't sell")
	# the arm goes with the room, and with a changed count (the second review: armed, away, back with more - one press sold them)
	var spare2: Dictionary = sim._plain("Primary", "Army SMG")
	spare2["rarity"] = 0
	sim.stash.append(spare2)
	main.refresh()
	fs._sell(0)
	main.show_room(main.RUNNER)
	main.refresh()
	main.show_room(main.MARKET)
	main._fence._show("shelf")
	main.refresh()
	fs.show_state(sim)
	_check(fs._arm.sig() == "" and fs.row_of(0)["sell"].text == "Sell", "the Fence's arm outlived the room: '%s'" % fs.row_of(0)["sell"].text)
	fs._sell(0)
	var spare3: Dictionary = sim._plain("Primary", "Army SMG")
	spare3["rarity"] = 0
	sim.stash.append(spare3)
	main.refresh()
	fs._sell(0)
	_check(sim.stash.has(spare2) and sim.stash.has(spare3), "the Fence sold on an arm whose count had changed")
	fs._arm.clear()
	sim.stash.erase(spare2)
	sim.stash.erase(spare3)
	sim.equipped["Primary"] = worn_was
	# a class's own tab: the row neither counts it spare nor sells it (the second review)
	if not sim.loadouts.is_empty() or true:
		var own: Dictionary = sim._plain("Primary", "Army SMG")
		own["rarity"] = 0
		own["tab"] = sim.cls if sim.cls != "" else "Poacher"
		sim.stash.append(own)
		if sim.tab_of(own) != "":
			var sp0: Array = sim.rarity_spare(0)
			var sold0: int = sim.sell_rarity(0)
			_check(sim.stash.has(own) and int(sp0[0]) == sold0, "the Fence's count and its sale disagree: %d counted, %d sold, the tab's piece %s" % [int(sp0[0]), sold0, "kept" if sim.stash.has(own) else "sold"])
		sim.stash.erase(own)
	# the temper tile says why it can't (the second review): a charm, short of scrap
	var charm: Dictionary = sim._plain("Charm", "Lucky penny")
	charm["id"] = 992002
	sim.stash.append(charm)
	_check(sim.temper_block(charm) == Words.TEMPER["no_grow"], "a charm tempers: '%s'" % sim.temper_block(charm))
	main.show_room(main.WORKSHOP)
	main._workshop.open_piece(992002)
	main.refresh()
	var tk: int = main._workshop.JOBS.find("temper")
	var tw: String = " ".join(main._workshop._job_tiles[tk]["words"].map(func(l): return l.text)).strip_edges()
	_check(tw == Words.TEMPER["no_grow"], "the temper tile doesn't say why a charm can't: '%s'" % tw)
	var scrap_was: int = int(sim.scrap)
	if not sim.stash.has(gun):
		sim.stash.append(gun)                  # the Fence's commons row above sold it
	sim.scrap = 0
	main._workshop.open_piece(992001)
	main.refresh()
	if sim.temper_block(gun) == "":
		_check(main._workshop._job_tiles[tk]["price"].text.begins_with("Needs"), "the temper tile doesn't say scrap is short: '%s'" % main._workshop._job_tiles[tk]["price"].text)
	sim.scrap = scrap_was
	sim.stash.erase(charm)
	# a temper grows the piece's flat lines as a deeper drop's (the second review)
	var vest: Dictionary = sim._plain("Armour", "Ballistic vest")
	vest["id"] = 992003
	vest["ilvl"] = 60
	vest["tier"] = 1
	vest["affixes"] = [{"stat": "hp", "value": 100, "tier": 1}]
	sim.stash.append(vest)
	if sim.temper_block(vest) == "":
		sim.craft(992003, "temper")
		_check(int(vest["affixes"][0]["value"]) > 100, "a temper didn't grow the vest's HP line: %d" % int(vest["affixes"][0]["value"]))
	sim.stash.erase(vest)
	# the first tempers don't raise the level to wear a piece (Matt, 25 Oct)
	var w0: int = Items.wear_level({"slot": "Primary", "base": "Pump shotgun", "tier": 1, "ilvl": 40, "tempered": 0})
	_check(Items.wear_level({"slot": "Primary", "base": "Pump shotgun", "tier": 1, "ilvl": 40 + Data.TEMPER_PAST_WEAR, "tempered": Data.TEMPER_PAST_WEAR}) == w0 and Items.wear_level({"slot": "Primary", "base": "Pump shotgun", "tier": 1, "ilvl": 41 + Data.TEMPER_PAST_WEAR, "tempered": Data.TEMPER_PAST_WEAR + 1}) > w0, "the first %d tempers raise the wear, or the next doesn't" % Data.TEMPER_PAST_WEAR)
	# the paragon: damage and HP each on the last, the tins added (the second review)
	_check(Data.PARAGON_COMPOUND == ["damage", "hp"] and not "tins" in Data.PARAGON_COMPOUND, "the paragon's compounding rows are %s" % str(Data.PARAGON_COMPOUND))
	# a roofed site in the zone's rain: no rain's bite, the card says Roofed (Matt, 25 Oct)
	for i in range(Data.TIERS.size()):
		if str(Data.TIERS[i]["name"]) in Data.INDOOR_SITES:
			var w_hold: Array = sim.weather.duplicate()
			sim.weather[int(Data.TIERS[i]["zone"])] = ""
			var dry: Dictionary = sim.effective(i)
			sim.weather[int(Data.TIERS[i]["zone"])] = "Rain"
			var wet: Dictionary = sim.effective(i)
			sim.weather = w_hold
			_check(wet["intel"].has("Roofed") and not wet["intel"].has("Rain") and is_equal_approx(float(wet["search"]), float(dry["search"])) and is_equal_approx(float(wet["patrol"]), float(dry["patrol"])), "%s in the rain: %s, search ×%.2f against ×%.2f" % [Data.TIERS[i]["name"], str(wet["intel"]), float(wet["search"]), float(dry["search"])])
			break
	# the top bar and the fire tile shorten a big figure, never cut it
	var lab: Label = main._top_labels["dps"]
	var forms: Array = main.top_dps_forms(256613.0)
	_check(UI.text_width(lab, str(forms.back())) <= lab.size.x + 0.5, "the top bar's shortest damage won't fit: '%s'" % str(forms.back()))
	var hforms: Array = main.top_hp_forms(123456.0, 123456.0, 0.0)
	_check(UI.text_width(main._top_labels["hp"], str(hforms.back())) <= main._top_labels["hp"].size.x + 0.5, "the top bar's shortest HP won't fit: '%s'" % str(hforms.back()))
	# the Clinic's rail: not Hurt one HP short
	sim.hp = sim.max_hp() - 1.0
	sim.wounds = {}
	_check(str(main._rail_status(main.MEDIC).get("badge", "")) == "", "the Clinic says Hurt one HP short")
	# Reset trees asks twice
	main.show_room(main.BARRACKS)
	main.refresh()
	var bk = main._barracks
	var tree_n: int = sim.tree.size()
	sim.cash = 1e9
	bk._on_respec()
	_check(bk.respec_armed() and sim.tree.size() == tree_n, "Reset trees didn't ask twice")
	# armed on the trees, a ring node picked: the arm's gone, the ring's reset isn't armed (the second review)
	var ring_was: String = bk.selected
	bk.selected = "%s/0" % Data.RING_TREE
	main.refresh()
	_check(not bk.respec_armed(), "the trees' reset arm carried to the ring")
	bk.selected = ring_was
	bk._respec_arm.clear()
	main.refresh()
	bk._on_respec()
	main.show_room(main.RUNNER)
	main.refresh()
	main.show_room(main.BARRACKS)
	main.refresh()
	_check(not bk.respec_armed() and not bk._respec.text.contains("press again"), "the reset's arm outlived the room: '%s'" % bk._respec.text)
	# the On you row stops short of the skill buttons (25 Oct: a med's chip sat under 'Auto')
	var runv = main._run
	if runv != null and runv._skills != null and not runv._skills.buttons.is_empty():
		runv._skill_shift(true)
		var chips_r: float = runv._runner["chips"].position.x + runv._runner["chips"].size.x
		var btn_l: float = runv._skills.position.x + runv._skills.buttons[0]["btn"].position.x
		_check(chips_r <= btn_l, "the On you row runs to %.0f, past the skills' first button at %.0f" % [chips_r, btn_l])
	sim.load_dict(hold)
	main.refresh()
	print("the review's fixes ok: the camp's nodes through a read, the skills by class, Floored one man, skills resisted, the Fence keeps, the figures shorten, the resets ask")


## A skill's hit as the sim lands it: the runner's hits, cut by the man's resist (less what a pat-down took) and lifted
## by a shock, as a gun's are (25 Oct, the review: skills had skipped the resist).
func _skill_hit_expected(sim, m: Dictionary, mult: float, ty := "physical") -> float:
	var r_ty: float = float(m["t"].get("res", {}).get(ty, 0.0)) if m.has("t") else 0.0
	if ty == "physical":
		r_ty = sim.phys_resist(r_ty)
	r_ty *= 1.0 - sim._skill_pat(m)
	var shock: float = (1.0 + sim.shock_amount()) if float(m.get("shock_t", 0.0)) > 0.0 else 1.0
	return sim._skill_base() * mult * (1.0 - r_ty) * shock


## The Issue (25 Oct, docs/design/the_issue.md): the switch to fiat, hard on piles; prices by the circulation; the rate;
## the burn; issued kit; the card and the Issuer's counter.
func _issue_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var hold: Dictionary = sim.to_dict()
	sim.issued = false
	sim.elapsed = 30.0 * 3600.0
	sim.cash = 48213906.0
	sim._notes = 1240
	var inf0: float = sim.inflation()
	var money: float = 48213906.0 + 1240.0 * Data.NOTE_TINS * inf0
	var held := 0.0
	var a_piece = null
	var worn_one: Dictionary = Items.roll("Armour", 5, RandomNumberGenerator.new()) if sim.equipped.get("Armour") == null else {}
	if not worn_one.is_empty():
		sim.equipped["Armour"] = worn_one     # the fixture wears a piece through the Issue
	for it in sim._kit_held():
		held += float(sim.sell_price(it))
		if a_piece == null and sim.sell_price(it) > 0 and not sim.stash.has(it):
			a_piece = it                     # a worn one: taken off after, it sells at the pile's rate too (the review)
	_check(a_piece != null, "the Issue's fixture: no worn piece to sell after it")
	var tins_was: int = sim.sell_price(a_piece) if a_piece != null else 0
	var pile: float = money + held
	var want: float = money * Data.FIAT_PILE_K * sqrt(pile) / pile
	# the Mint's card says what the win turns the pile into, before it (the third review's A1(a))
	var pv: Dictionary = sim.issue_preview()
	_check(absf(float(pv["fiat"]) - want) < 1.0, "the Mint's preview says ƒ%.0f, the Issue gives ƒ%.0f" % [float(pv["fiat"]), want])
	var mint_was: int = sim.rebuild_rank("mint")
	sim.rebuilt["mint"] = maxi(1, mint_was)
	var od_m = main._missions._order
	od_m._shown = ""
	od_m.show_state(sim)
	var mc: Dictionary = od_m.col("mint")
	var tipped_m: Array = mc["chips"]._panels.filter(func(p): return p.visible and p.tooltip_text.contains("his money"))
	_check(not tipped_m.is_empty() and mc["chips"]._labels.any(func(l): return l.get_parent().visible and l.text.contains("≈ƒ")), "the Mint's card doesn't warn what the win turns the pile into")
	if mint_was == 0:
		sim.rebuilt.erase("mint")
	od_m._shown = ""
	sim.issue()
	_check(sim.issued and absf(sim.cash - want) < 1.0 and sim._notes == 0, "the Issue: ƒ%.0f from a pile of %.0f with the stash's %.0f (want ƒ%.0f), notes %d" % [sim.cash, pile, held, want, sim._notes])
	if a_piece != null:
		var hard: float = Data.FIAT_PILE_K * sqrt(pile) / pile
		var expect: float = tins_was * hard     # its tins at the pile's rate, as the cash went
		_check(absf(float(sim.sell_price(a_piece)) - expect) <= maxf(2.0, expect * 0.02), "a piece held through the Issue sells for ƒ%d, not the pile's ƒ%.0f" % [sim.sell_price(a_piece), expect])
	_check(is_equal_approx(sim.inflation(), inf0 * Data.FIAT_SCALE), "fiat prices don't start from the Issue's: ×%.6f against ×%.6f" % [sim.inflation(), inf0 * Data.FIAT_SCALE])
	var big: float = Data.FIAT_PILE_K * sqrt(pile * 10.0)
	_check(big < sim.cash * 3.5, "a pile ten times bigger isn't hard on it: ƒ%.0f against ƒ%.0f" % [big, sim.cash])
	# prices follow the money
	var m0: float = sim.circ_mult()
	sim._earn(Data.FIAT_CIRC_SPAN * 0.5)
	_check(is_equal_approx(sim.circ_mult(), m0 + 0.5) and sim.inflation_pct() == 50, "the circulation's prices: ×%.2f, %d%%" % [sim.circ_mult(), sim.inflation_pct()])
	# a note reads as fiat: the crews' prices keep working
	var c0: float = sim.cash
	sim.notes -= 10
	_check(absf((c0 - sim.cash) - 10.0 * sim.note_price()) < 0.01, "ten notes after the Issue took ƒ%.2f, not ƒ%.2f" % [c0 - sim.cash, 10.0 * sim.note_price()])
	# the rate: a sale down, time back; a burn up and the circulation down
	sim.fiat_rate = 1.0
	sim._rate_after_sale(sim._rate_unit() * 5.0)
	_check(is_equal_approx(sim.fiat_rate, 1.0 - 5.0 * Data.RATE_SALE_STEP), "a sale didn't move the rate: %.3f" % sim.fiat_rate)
	var r0: float = sim.fiat_rate
	sim.advance(3600.0)
	_check(sim.fiat_rate > r0, "the rate didn't drift back: %.3f" % sim.fiat_rate)
	sim.cash = 1e9
	var circ_hold: float = sim.circulation
	sim.circulation = 0.0
	_check(not sim.burn_moves() and not sim.can_burn() and not sim.burn(), "a burn with nothing in circulation still spends (the third review)")
	sim.circulation = circ_hold
	var circ0: float = sim.circulation
	var rb: float = sim.fiat_rate
	_check(sim.burn() and sim.circulation < circ0 and sim.fiat_rate > rb, "a burn: circulation %.0f from %.0f, the rate %.3f from %.3f" % [sim.circulation, circ0, sim.fiat_rate, rb])
	# the money's calls (Matt, 26 Oct): circulation drains, a burn takes a share, notes paid are income, held kit's
	# fiat is the Issue's
	sim.circulation = Data.FIAT_CIRC_SPAN
	sim.advance(Data.CIRC_HALF_H * 3600.0)
	_check(absf(sim.circulation - Data.FIAT_CIRC_SPAN * 0.5) < Data.FIAT_CIRC_SPAN * 0.02, "circulation didn't halve in its half-life: %.0f" % sim.circulation)
	var cb: float = sim.circulation
	var seal: float = Data.FX["rule/issued_seal.burn"] if sim.has_rule("issued_seal") else 1.0
	_check(sim.burn() and absf(sim.circulation - cb * (1.0 - Data.BURN_SHARE * seal)) < 2.0, "a burn didn't take its share: %.0f from %.0f" % [sim.circulation, cb])
	var cn: float = sim.circulation
	var cin: float = sim.cash_in
	sim.notes += 10
	_check(sim.circulation > cn and sim.cash_in > cin, "notes paid after the Issue aren't income: circulation %.0f from %.0f" % [sim.circulation, cn])
	if a_piece != null:
		var c_hold: float = sim.circulation
		sim.circulation = 0.0
		var at_one: int = sim.sell_price(a_piece)
		sim.circulation = Data.FIAT_CIRC_SPAN * 2.0
		_check(absi(sim.sell_price(a_piece) - at_one) <= 1, "a piece held through the Issue rides prices up: ƒ%d at ×1, ƒ%d at ×3" % [at_one, sim.sell_price(a_piece)])
		sim.circulation = c_hold
	# prices after the Issue: never ƒ0 for what cost something, the Clinic's shelf at today's (the third review)
	for box in Data.BASES[Data.AMMO].filter(func(b): return not b.has("damage_pct")):
		_check(sim.ammo_price(str(box["type"])) >= 1, "after the Issue %s costs ƒ%d" % [box["name"], sim.ammo_price(str(box["type"]))])
	var shelf_kit: Dictionary = sim._plain(Data.MEDICAL, "First aid kit")
	_check(sim.med_price(shelf_kit) >= 1 and sim.clinic_price(shelf_kit) <= sim.med_price(shelf_kit) * 2, "after the Issue the Clinic's shelf reads ƒ%d against the list's ƒ%d" % [sim.clinic_price(shelf_kit), sim.med_price(shelf_kit)])
	# issued kit over the runner's level: shown, not sold (the third review)
	var xp_hold: float = sim.xp
	sim.xp = 0.0
	for u in Data.ISSUED:
		var sl0: String = str(u["slot"])
		_check(sim.wear_lock(sim.issued_piece(sl0)) == 0 or (sim.issued_block(sl0).begins_with("Wear at") and not sim.buy_issued(sl0)), "the Issuer sells a level-1 runner a %s it can't wear: '%s'" % [sl0, sim.issued_block(sl0)])
	sim.xp = maxf(xp_hold, Data.xp_for_level(Data.MAX_LEVEL))
	# issued kit: a piece a slot, numbered, kept on a death (an empty stash, so a full one from the run so far can't refuse)
	var stash_hold: Array = sim.stash.duplicate()
	sim.stash.clear()
	var bought: Array = []
	for u in Data.ISSUED:
		var sl: String = str(u["slot"])
		var before: int = sim.stash.size()
		var shown: Dictionary = sim.issued_piece(sl)
		_check(sim.buy_issued(sl) and sim.stash.size() == before + 1, "the Issuer didn't sell the %s: '%s'" % [sl, sim.issued_block(sl)])
		var it: Dictionary = sim.stash.back()
		bought.append(it)
		_check(it.get("issued", false) and Items.full_name(it).contains("No.") and str(it["rule"]) == str(u["rule"]) and Items.ilvl(it) == Items.ilvl(shown), "the %s came without its stamp, rule or level: %s" % [sl, Items.full_name(it)])
		_check(not load("res://scripts/ui/item_head.gd").unique_rule(it).is_empty(), "the %s's rule has no words" % sl)
	sim.stash.assign(stash_hold + bought)     # the bought pieces kept: the webbing check below wants one
	# the third review's A9, C5, C6, M2: loot once a search; the counter's piece one roll; issued kit off the shelf; a
	# death past 50 keeps 50 and takes the paragon
	_check(sim.thin_after({"depth": 3}) == int(roundf(Data.THIN_AFTER + Data.THIN_PER_DEPTH * 3)), "a site's searches still grow with loot quantity: %d" % sim.thin_after({"depth": 3}))
	var ip_a: Dictionary = sim.issued_piece("Helmet")
	var ip_b: Dictionary = sim.issued_piece("Helmet")
	var ip_c: Dictionary = sim.issued_piece("Helmet", -1, true)
	_check(int(ip_a["id"]) == int(ip_b["id"]) and int(ip_c["id"]) != int(ip_a["id"]), "the counter's piece rolls afresh each read, or a bought one shares its id")
	_check(not sim.shelf.any(func(nm): return str(nm).begins_with("Issued")), "issued kit went on the uniques shelf: %s" % str(sim.shelf.filter(func(nm): return str(nm).begins_with("Issued"))))
	var hold_d: Dictionary = sim.to_dict()
	sim.xp = Data.xp_for_level(Data.MAX_LEVEL)
	sim.paragon_xp = Data.xp_for_level(Data.MAX_LEVEL + 3) - Data.xp_for_level(Data.MAX_LEVEL)
	sim.hp = sim.max_hp()
	sim.deploy(0)
	if sim.mission != null:
		sim._kia()
		_check(sim.level() == Data.MAX_LEVEL and sim.paragon() == 0 and sim.ring.is_empty() and not sim.tree.any(func(id): return sim.is_ring(str(id))), "a death past 50: level %d, paragon %d, ring nodes in the tree %s" % [sim.level(), sim.paragon(), str(sim.tree.filter(func(id): return sim.is_ring(str(id))))])
	sim.load_dict(hold_d)
	# stamping (Matt, 26 Oct): a piece of your own, stamped at the slot's issued price, counts towards the County's want
	var own_gun = sim.equipped.get("Primary")
	if own_gun != null and not own_gun.get("issued", false):
		var worn0: int = sim.issued_worn()
		var cash_s: float = sim.cash
		var price_s: int = sim.stamp_price(own_gun)
		_check(price_s == sim.issued_price("Primary") and sim.stamp(int(own_gun["id"])) and own_gun.get("stamped", false) and sim.issued_worn() == worn0 + 1 and is_equal_approx(sim.cash, cash_s - price_s), "stamping the gun: worn %d from %d, cash %.0f from %.0f" % [sim.issued_worn(), worn0, sim.cash, cash_s])
		_check(not sim.stamp(int(own_gun["id"])) and sim.stamp_block(own_gun) == Words.STAMP["done"], "a piece stamped twice")
		own_gun.erase("stamped")
		# the Bench's stamp tile (the canvas 'The stamp at the Bench', A): priced, pressed, then Stamped
		sim.cash = maxf(sim.cash, float(price_s) * 2.0)
		main.open_stamp()
		main.refresh()
		var wsp = main._workshop
		var sk: int = wsp.JOBS.find("stamp")
		var st_t: Dictionary = wsp._job_tiles[sk]
		_check(main.room == main.WORKSHOP and wsp.view == "craft" and st_t["price"].text == Fmt.money(float(price_s)) and not st_t["button"].disabled, "the Bench's stamp tile: room %s, price '%s', off %s" % [main.room, st_t["price"].text, st_t["button"].disabled])
		_check_fit(main, "the Bench with the stamp")
		for jt in wsp._job_tiles:
			for jl in jt["words"]:
				_check(not str(jl.text).ends_with("…"), "a job tile's words cut, four across: '%s'" % jl.text)
		wsp._press_job(sk)
		main.refresh()
		_check(own_gun.get("stamped", false) and st_t["name"].text == Words.STAMP["tag_short"] and st_t["button"].disabled, "the stamp tile didn't stamp: '%s'" % st_t["name"].text)
		own_gun.erase("stamped")
	var web = sim.stash.filter(func(x): return x.get("issued", false) and str(x.get("rule", "")) == "issued_webbing")
	_check(not web.is_empty(), "no issued webbing in the stash to test its meds")
	if not web.is_empty():
		var rig_hold = sim.equipped["Rig"]
		sim.equipped["Rig"] = null
		sim._dry_memo.clear()
		var h0: float = sim.med_heal(shelf_kit)
		sim.equipped["Rig"] = web[0]
		sim._dry_memo.clear()
		_check(sim.med_heal(shelf_kit) > h0 * 1.4, "the issued webbing's meds +50%% does nothing: %.1f against %.1f" % [sim.med_heal(shelf_kit), h0])
		sim.equipped["Rig"] = rig_hold
		sim._dry_memo.clear()
	# the money on screen: ƒ
	main.refresh()
	_check(Fmt.money(1234.0) == "ƒ1,234" and Fmt.notes(10).begins_with("ƒ"), "fiat on screen reads '%s', notes '%s'" % [Fmt.money(1234.0), Fmt.notes(10)])
	_check(Fmt.money_k(4800.0).begins_with("ƒ") and Fmt.money_forms(48000.0).all(func(f): return not str(f).contains("tin")) and Fmt.unit() == "fiat" and sim.money_word() == "fiat" and not sim._cash_words(1200.0).contains("tin"), "after the Issue the short money still says tins: '%s'" % Fmt.money_k(4800.0))
	# the card, once, then the Fence; the counter's tab
	sim.met = sim.met.filter(func(x): return x != "issue")
	main.show_issue_card()
	_check(main._room_card != null and main._room_card.key == "issue", "the Issue's card didn't come up")
	if main._room_card != null:
		for l in main._room_card._lines:
			_check(UI.text_width(l, l.text) <= l.size.x + 0.5, "the Issue's card line runs off: '%s'" % l.text)
		var hint_l: Label = main._room_card._hint
		_check(UI.text_width(hint_l, hint_l.text) <= hint_l.size.x + 0.5 and not hint_l.text.ends_with("…"), "the Issue's card hint is cut: '%s'" % hint_l.text)     # the third review
		_check(main._room_card._lines.any(func(l): return l.text.contains("kit worth")), "the Issue's card leaves out the kit's worth")
		_check_fit(main, "the Issue's card")
		main._room_card.finish()
	_check("issue" in sim.met and main.room == main.MARKET, "after the Issue's card: met %s, the room %s" % ["issue" in sim.met, main.room])
	main._fence._show("shelf")
	main.refresh()
	var band_words: String = " ".join(main._fence._band.text_nodes().filter(func(n): return n is Label and n.is_visible_in_tree()).map(func(n): return n.text))
	_check(not band_words.contains("tins") and not band_words.contains("full value"), "the Fence's band after the Issue still says tins or full value: '%s'" % band_words)
	main._fence._show("issuer")
	main.refresh()
	var ic = main._fence._issuer
	_check(ic != null and ic.visible and main._fence._tabs[4].visible, "the Issuer's counter isn't up after the Issue")
	var tx := 0.0
	for t in main._fence._tabs:
		_check(t.visible and t.position.x >= main._fence._band.kicker.position.x + Pal.BAND_TEXT_W and t.position.x + t.size.x <= Pal.GRID_W - main._fence.PAD + 0.5 and t.position.x >= tx, "five fence tabs don't sit in the band's foot, in order: %s" % str(Rect2(t.position, t.size)))
		tx = t.position.x + t.size.x
	if ic != null:
		for l in ic.labels():
			_check(UI.text_width(l, l.text) <= l.size.x + 0.5, "the counter's words run off: '%s'" % l.text)
		_check_fit(main, "the Issuer's counter")
		# a runner under the pieces' level: each row padlocked, its Buy off (the third review)
		var xp_was: float = sim.xp
		sim.xp = 0.0
		ic.show_state(sim)
		for k in range(Data.ISSUED.size()):
			var lockd: bool = sim.wear_lock(sim.issued_piece(str(Data.ISSUED[k]["slot"]))) > 0
			_check(not lockd or (ic.row_locked(k) and ic.buttons()[k].disabled), "the counter's %s row isn't padlocked and off for a runner under it" % Data.ISSUED[k]["slot"])
		sim.xp = xp_was
		# the burn asks twice; with nothing in circulation it's off
		sim.cash = 1e9
		var circ_was: float = sim.circulation
		sim.circulation = 0.0
		ic._shown = ""
		ic.show_state(sim)
		_check(ic.buttons().back().disabled, "the Burn is live with nothing in circulation (the third review)")
		sim.circulation = maxf(circ_was, Data.FIAT_CIRC_SPAN)
		ic._shown = ""
		ic.show_state(sim)
		var cash_a: float = sim.cash
		var circ_a: float = sim.circulation
		ic._on_burn()
		_check(is_equal_approx(sim.cash, cash_a) and is_equal_approx(sim.circulation, circ_a), "one press of Burn spent: it should ask twice")
		sim.advance(1.0)                          # the circulation drains between the presses (the review)
		cash_a = sim.cash
		circ_a = sim.circulation
		ic._on_burn()
		_check(sim.cash < cash_a and sim.circulation < circ_a, "the second press of Burn didn't burn")
		sim.circulation = circ_was
	main._fence._show("shelf")
	sim.load_dict(hold)
	main.refresh()
	_check(not Fmt.fiat, "the money still reads fiat on a camp before the Issue")
	var pre_gun = sim.equipped.get("Primary")
	_check(pre_gun == null or (sim.stamp_block(pre_gun) == Words.STAMP["not_yet"] and not sim.stamp(int(pre_gun["id"]))), "a stamp before the Issue")
	_check(not sim.issued and not main._fence._tabs[4].visible, "the counter's tab stayed up on a camp before the Issue")
	_check(int(sim.order_beaten.get("mint", 0)) > 0 or sim.order_level("mint") == int(Data.pinnacle("mint")["level"]), "the Mint's first level isn't its set one: %d" % sim.order_level("mint"))
	_check(absf(sim.print_haul(3) - sim.print_haul(2) * Data.PRINT_DECAY) <= 1.0 and sim.print_haul(2) > sim.print_haul(5), "the Mint's prints don't shrink: %.0f, %.0f" % [sim.print_haul(2), sim.print_haul(3)])
	print("the Issue ok: hard on piles, prices by the circulation, notes as fiat, the rate, the burn, six issued pieces, the card, the counter")



## The County (25 Oct): its zones and places open in turn, each zone wanting issued kit worn; a place runs as the
## order's on its host's crew, a head's with his own fight and issued kit off him; the Map's County board; the remix.
func _county_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var hold: Dictionary = sim.to_dict()
	for i in range(Data.TIERS.size()):
		sim.best_depth[i] = maxi(1, int(sim.best_depth[i]))     # the campaign done, as the Issue's camp would be
	for z in range(sim.bosses_beaten.size()):
		sim.bosses_beaten[z] = true
	sim.xp = maxf(sim.xp, Data.xp_for_level(50))
	_check(Data.COUNTY.size() == 12 and Data.COUNTY_ZONES.size() == 4 and Data.ISSUED_WANT.size() == 4, "the County isn't four zones of three")
	for z in range(4):
		var ks: Array = sim.county_places(z)
		_check(ks.size() == 3 and Data.county(str(ks[2])).has("who") and not Data.county(str(ks[0])).has("who"), "the County's zone %d: its head isn't its last place" % z)
		_check(str(Data.county(str(ks[2]))["who"]) == str(Data.COUNTY_ZONES[z]["head"]), "zone %d's head isn't its zone's" % z)
	for c in Data.COUNTY:
		_check(Words.COUNTY_WORDS.has(str(c["key"])) and int(c["site"]) < Data.TIERS.size(), "%s has no line or no host" % c["place"])
	sim.issued = false
	sim.order_beaten = {}
	_check(not sim.county_zone_open(0) and sim.order_block("toll_plaza") == Words.COUNTY["not_yet"], "the County open before the Issue")
	sim.issue()
	sim.reach = 30
	for sl in Data.SLOTS:
		var w = sim.equipped.get(sl)
		if w != null and w.get("issued", false):
			sim.equipped[sl] = null
	_check(sim.county_zone_open(0) and sim.order_open("toll_plaza") and not sim.order_open("distribution") and not sim.county_zone_open(1), "after the Issue: the Motorway's first place alone open")
