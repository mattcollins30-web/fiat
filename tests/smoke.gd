	var shallow: int = sim.thin_after(m["t"])
	var expect := func(d: int) -> int: return int(roundf(Data.THIN_AFTER + Data.THIN_PER_DEPTH * d))     # quantity is more a search, not more searches (Matt, 26 Oct)
	_check(shallow == expect.call(int(m["t"]["depth"])), "thin_after reads %d, not %d" % [shallow, expect.call(int(m["t"]["depth"]))])
	var heavy: Dictionary = sim._plain("Backpack", Data.BASES["Backpack"][0]["name"])
	heavy["affixes"] = [{"stat": "loot_pct", "value": 100, "tier": 5}]
	sim.equipped["Backpack"] = heavy
	_check(sim.thin_after(m["t"]) == shallow, "+100%% quantity pushed the searches as well as the finds: %d from %d" % [sim.thin_after(m["t"]), shallow])
	var deeper: Dictionary = m["t"].duplicate()
	deeper["depth"] = int(m["t"]["depth"]) + 3
	_check(sim.thin_after(deeper) > sim.thin_after(m["t"]), "depth did not push the searches")
	sim.extract_now()
	sim.equipped["Backpack"] = hold_pack
	sim.yard_picks["kennel"] = hold_kennel
	sim._yard_changed("kennel")
	sim.load_dict(saved)
	main.refresh()
	# the start (13 Oct, Matt): a hammer, no rounds to need, and melee behind the tier's best gun
	var camp = Sim.new()
	camp.start()
	_check(camp.equipped["Primary"] != null and camp.equipped["Primary"]["base"] == "Claw hammer" and not camp.rig.any(func(x): return Items.is_ammo(x)), "a new camp does not start with the hammer and no rounds")
	for b in Data.BASES["Primary"]:
		if b["type"] == "melee" and not b.get("start", false):
			var best_gun := 0.0
			for g in Data.BASES["Primary"]:
				if g["type"] != "melee" and int(g["tier"]) == int(b["tier"]) and not g.get("start", false):
					best_gun = maxf(best_gun, float(g["damage"]) * float(g["rof"]))
			_check(best_gun <= 0.0 or float(b["damage"]) * float(b["rof"]) < best_gun * 0.9, "%s at %.0f a second is not behind its tier's best gun (%.0f)" % [b["name"], float(b["damage"]) * float(b["rof"]), best_gun])
	print("crates ok: the queue, the panel, the opening, the save, picked clean, the leans, the sites' own, the dog's nose, depth and quantity")


## Every part off a worn gun at once (28 Oct, Matt): back to the stash as room allows, the Kit room's and the
## Workshop's buttons.
func _strip_all_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	while not sim.stash_room(12) and not sim.stash.is_empty():
		sim.stash.pop_back()
	var gun: Dictionary = sim._plain("Primary", "AR-pattern rifle")
	gun["attachments"] = {"optic": null, "muzzle": null, "magazine": null, "handguard": null, "stock": null}
	sim.equipped["Primary"] = gun
	var n_on := 0
	for att in Data.ATTACHMENTS:
		if att.get("mount", "") in ["optic", "muzzle", "stock"] and gun["attachments"][att["mount"]] == null:
			var a: Dictionary = sim._plain(Data.ATTACHMENT, str(att["name"]))
			gun["attachments"][att["mount"]] = a
			n_on += 1
	_check(n_on >= 2 and sim.parts_on("Primary") == n_on, "the fixture: %d parts on the rifle" % n_on)
	main.show_room(main.ARMOURY)
	main._armoury.selected = {"kind": "slot", "slot": "Primary"}
	main._armoury._shown = ""
	main.refresh()
	var bi := -1
	for k in range(main._armoury._pick._buttons.size()):
		if main._armoury._pick._buttons[k].visible and main._armoury._pick._buttons[k].text == "Strip all parts":
			bi = k
	_check(bi >= 0, "the Kit room has no Strip all parts on a gun with %d parts" % n_on)
	_check_fit(main, "Kit room (strip all)")
	var stash0: int = sim.stash.size()
	if bi >= 0:
		main._armoury._press(bi)
		main.refresh()
	_check(sim.parts_on("Primary") == 0 and sim.stash.size() == stash0 + n_on, "Strip all parts left %d on, the stash %d from %d" % [sim.parts_on("Primary"), sim.stash.size(), stash0])
	# the stash full: off, nothing to take (28 Oct, the review: live, then nothing); room for one: that one, the rest said
	var refit := func() -> void:
		for mount in ["optic", "muzzle", "stock"]:
			for att in Data.ATTACHMENTS:
				if att.get("mount", "") == mount and gun["attachments"][mount] == null:
					gun["attachments"][mount] = sim._plain(Data.ATTACHMENT, str(att["name"]))
	var fill := func() -> void:
		var g := 0
		var big: Dictionary = sim._plain("Armour", "Riot suit")
		var one := ""
		for att in Data.ATTACHMENTS:
			if one == "" and str(att.get("mount", "")) != "socket" and Items.size(sim._plain(Data.ATTACHMENT, str(att["name"]))) == 1:
				one = str(att["name"])
		while sim.stash_room(1) and g < 5000:
			g += 1
			if sim.stash_room(Items.size(big)):
				sim.stash_put(sim._plain("Armour", "Riot suit"))
			else:
				sim.stash_put(sim._plain(Data.ATTACHMENT, one))
		_check(not sim.stash_room(1), "the fixture: the stash didn't fill (%d of %d)" % [sim.stash_used(), sim.stash_cap()])
	var arm_strip := func() -> Button:
		main._armoury._shown = ""
		main.refresh()
		for b in main._armoury._pick._buttons:
			if b.visible and b.text == "Strip all parts":
				return b
		return null
	refit.call()
	fill.call()
	var sb: Button = arm_strip.call()
	_check(sb != null and sb.disabled and not sim.can_strip_any("Primary"), "Strip all is live with the stash full")
	var on_full: int = sim.parts_on("Primary")
	if sb != null and not sb.disabled:
		main._armoury._press(main._armoury._pick._buttons.find(sb))
	_check(sim.parts_on("Primary") == on_full, "Strip all took a part off into a full stash")
	sim.stash.erase(sim.stash.filter(func(x): return Items.size(x) == 1 and Items.is_attachment(x)).back())
	sb = arm_strip.call()
	_check(sb != null and not sb.disabled, "Strip all is off with room for a part")
	if sb != null:
		main._armoury._press(main._armoury._pick._buttons.find(sb))
		main._armoury._shown = ""
		main.refresh()
	var left_on: int = sim.parts_on("Primary")
	_check(left_on > 0 and left_on < on_full and main._armoury._pick.hint_text().contains(str(left_on)) and main._armoury._pick.hint_text().to_lower().contains("room"), "Strip all as room allows: %d left of %d, the hint '%s'" % [left_on, on_full, main._armoury._pick.hint_text()])
	_check_fit(main, "Kit room (strip all, no room for the rest)")
	# the Workshop's Strip all N: the same rule, the same words, off on a run
	main.show_room(main.WORKSHOP)
	var ws = main._workshop
	ws._set_view("guns")
	var still: String = ""
	for mount in gun["attachments"]:
		if gun["attachments"][mount] != null and still == "":
			still = str(mount)
	ws.sel_id = -1
	ws.sel_slot = "Primary"
	ws.sel_mount = still
	refit.call()
	sim.stash.erase(sim.stash.filter(func(x): return Items.size(x) == 1 and Items.is_attachment(x)).back())
	ws._shown = ""
	main.refresh()
	var wi := -1
	for k in range(ws._pick._buttons.size()):
		if ws._pick._buttons[k].visible and ws._pick._buttons[k].text.begins_with("Strip all"):
			wi = k
	_check(wi >= 0 and not ws._pick._buttons[wi].disabled and ws._pick._buttons[wi].text == "Strip all %d" % sim.parts_on("Primary"), "the Workshop has no live Strip all %d" % sim.parts_on("Primary"))
	_check_fit(main, "Workshop (strip all)")
	if wi >= 0:
		var before_w: int = sim.parts_on("Primary")
		ws._press_pick(wi)
		ws._shown = ""
		main.refresh()
		_check(sim.parts_on("Primary") < before_w and sim.parts_on("Primary") > 0 and ws._pick.hint_text().contains(str(sim.parts_on("Primary"))) and ws._pick.hint_text().to_lower().contains("room"), "the Workshop's Strip all as room allows: %d on from %d, '%s'" % [sim.parts_on("Primary"), before_w, ws._pick.hint_text()])
		_check_fit(main, "Workshop (strip all, no room for the rest)")
	sim.stash = sim.stash.filter(func(x): return str(x["base"]) != "Riot suit")
	sim.hp = sim.max_hp()
	sim.deploy(0)
	_check(sim.on_mission() and not sim.can_strip_any("Primary"), "Strip all can go on a run")
	sim.extract_now()
	sim.load_dict(saved)
	main.refresh()
	print("strip all ok: every part off at once, to the stash, from the Kit room and the Workshop; off with no room, the rest said")


## Select-many sells only at the Fence (28 Oct, Matt): the Kit room and the Clinic bin, the Workshop scraps, whatever's
## open; the Fence's stash still sells.
func _select_many_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	for k in ["fence", "workshop", "clinic"]:
		if not sim.unlocked.has(k):
			sim.unlocked.append(k)
	while not sim.stash_room(12) and not sim.stash.is_empty():
		sim.stash.pop_back()
	var rooms := [[main.ARMOURY, main._armoury._inv, "Bin 1"], [main.MEDIC, main._clinic._stash, "Bin 1"], [main.WORKSHOP, main._workshop._inv, "Scrap 1"], [main.MARKET, main._fence._stash, "Sell 1"]]
	for r in rooms:
		sim.stash_put(sim._plain("Helmet", "Hard hat"))
		sim.stash_put(sim._plain("Attachment", "Red dot"))
		sim.stash_put(sim._plain("Medical", "Bandage"))
		main.show_room(r[0])
		if r[0] == main.MARKET:
			main._fence._show("stash")
		var inv = r[1]
		inv.many = true
		main.refresh()
		var shown: Array = inv.items.filter(func(x): return not Items.is_deeds(x) and not x.has("unique") and not x.has("set") and not Items.is_mag(x) and sim.stash.has(x))     # a magazine scraps for nothing (the fix round)
		_check(not shown.is_empty(), "%s's grid showed none of the fixture's pieces" % r[0])
		if shown.is_empty():
			inv.many = false                      # left as found (28 Oct, the tools review)
			continue
		var it: Dictionary = shown[0]
		# a mixed pick (the review): a unique beside the plain piece is passed over, and the figure is the plain one's
		var prize: Dictionary = {}
		var lone: Array = shown.filter(func(x): return not Items.stacks(x) and not Items.is_mag(x))     # a magazine is never a unique (30 Oct)
		if r[0] in [main.ARMOURY, main.WORKSHOP] and not lone.is_empty():
			it = lone[0]
			prize = sim._plain(str(it["slot"]), str(it["base"]))
			prize["unique"] = "A test unique"
			while not sim.stash_fits(prize):     # room for it (30 Oct: the bot's run leaves the stash fuller - a gun's magazine with it)
				var spare_out: Array = sim.stash.filter(func(x): return x != it and not shown.has(x))
				if spare_out.is_empty():
					break
				sim.stash.erase(spare_out[0])
			sim.stash_put(prize)
		inv.chosen = [it["id"]] + ([prize["id"]] if not prize.is_empty() else [])
		main.refresh()
		if r[2] == "Scrap 1":
			_check(sim.scrap_yield(it) > 0 and inv._sell_button.text.contains("· %d" % sim.scrap_yield(it)), "the Workshop's Scrap figure is not the plain piece's %d: '%s'" % [sim.scrap_yield(it), inv._sell_button.text])     # the figure always (28 Oct, the tools review)
		var words: String = inv._sell_button.text
		_check(inv._sell_button.visible and words.begins_with(r[2]) and not inv._sell_button.disabled, "%s's Select-many reads '%s', not %s (28 Oct: sales only at the Fence)" % [r[0], words, r[2]])
		if r[0] != main.MARKET:
			_check(not words.begins_with("Sell"), "%s sells from Select-many: '%s'" % [r[0], words])
		_check_fit(main, "%s (select many)" % r[0])
		var scrap0: int = int(sim.scrap)
		var cash0: float = sim.cash
		inv._sell_chosen()
		_check(not sim.stash.has(it), "%s's Select-many left the %s" % [r[0], it["base"]])
		if not prize.is_empty():
			_check(sim.stash.has(prize), "%s's Select-many took a unique in a mixed pick: %s %s" % [r[0], str(prize["slot"]), str(prize["base"])])
		if r[2] == "Scrap 1":
			_check(int(sim.scrap) == scrap0 + sim.scrap_yield(it) and is_equal_approx(sim.cash, cash0), "the Workshop's Select-many did not scrap the plain piece alone: scrap %d from %d" % [int(sim.scrap), scrap0])
			# on a run the Workshop's Scrap is shut (the review: it pressed to nothing)
			var again: Dictionary = sim._plain("Attachment", "Red dot")
			while sim.stash_used() > sim.stash_cap() - 4 and not sim.stash.is_empty():
				sim.stash.pop_back()               # room for it (31 Oct: the bot's run left the stash full on another seed's camp); saved puts it back
			sim.stash_put(again)
			inv.many = true
			inv.chosen = [again["id"]]
			main.refresh()
			_check(not inv._sell_button.disabled, "the fixture: Scrap is off at home")
			# the same pick across the run's start and end (28 Oct, the review: the button went stale on an unchanged pick)
			sim.hp = sim.max_hp()
			sim.deploy(0)
			main.refresh()
			_check(sim.on_mission() and inv._sell_button.disabled and inv._sell_button.tooltip_text != "", "the Workshop's Select-many Scrap is live on a run")
			sim.extract_now()
			main.refresh()
			_check(not sim.on_mission() and not inv._sell_button.disabled and inv._sell_button.tooltip_text == "", "the Workshop's Scrap stayed off home with the pick unchanged: '%s'" % inv._sell_button.tooltip_text)
		elif r[2] == "Bin 1":
			_check(int(sim.scrap) == scrap0 and is_equal_approx(sim.cash, cash0), "%s's Select-many paid for a bin" % r[0])
		elif r[2] == "Sell 1":
			_check(sim.cash > cash0, "the Fence's Select-many didn't sell: £%.0f from £%.0f" % [sim.cash, cash0])     # 28 Oct, the tools review: a bin passed too
		inv.many = false
	main._fence._show("shelf")                    # left as found (28 Oct, the tools review)
	sim.load_dict(saved)
	main.refresh()
	print("select many ok: the Kit room and the Clinic bin, the Workshop scraps, the Fence sells")


## Bin for its scrap; a unique asks twice; the deeds never; with the Fence shut, Select-many bins the plain things.
func _bin_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var hold_unlocked = sim.unlocked.duplicate()
	sim.unlocked.erase("fence")
	while not sim.stash_room(12) and not sim.stash.is_empty():
		sim.stash.pop_back()
	var junk: Dictionary = sim._plain("Helmet", "Hard hat")
	var prize: Dictionary = Items.roll_unique(Data.UNIQUES[0], sim.rng)
	sim.stash_put(junk)
	sim.stash_put(prize)
	main.show_room(main.ARMOURY)
	main._armoury._inv.kind = 0
	main._armoury._inv.rarity = -1
	main.refresh()
	main._armoury._pick_cell(main._armoury._inv.cell_of(junk["id"]))
	main.refresh()
	var bin_i: int = -1
	for k in range(main._armoury._pick._buttons.size()):
		if main._armoury._pick._buttons[k].visible and main._armoury._pick._buttons[k].text == "Bin":
			bin_i = k
	_check(bin_i >= 0, "a stash pick has no Bin")
	_check_fit(main, "Lock-up (the bin)")
	var scrap0: int = int(sim.scrap)
	if bin_i >= 0:
		main._armoury._press(bin_i)
		main.refresh()
	_check(not sim.stash.has(junk) and int(sim.scrap) == scrap0, "Bin did not throw the hard hat out, for nothing (27 Oct)")
	# a unique asks twice
	main._armoury._pick_cell(main._armoury._inv.cell_of(prize["id"]))
	main.refresh()
	bin_i = -1
	for k in range(main._armoury._pick._buttons.size()):
		if main._armoury._pick._buttons[k].visible and main._armoury._pick._buttons[k].text == "Bin":
			bin_i = k
	if bin_i >= 0:
		main._armoury._press(bin_i)
		main.refresh()
		_check(sim.stash.has(prize) and main._armoury._pick._buttons[bin_i].text.begins_with("Bin it"), "a unique went in the bin on the first press")
		_check_fit(main, "Lock-up (the bin, asked)")
		main._armoury._press(bin_i)
		main.refresh()
		_check(not sim.stash.has(prize), "a unique did not go in the bin on the second press")
	else:
		_check(false, "a unique has no Bin")
	_check(not sim.can_bin(sim._plain(Data.PAPER, "The deeds")), "the deeds can go in the bin")
	# Select-many with the Fence shut: Bin, the plain things only
	var a: Dictionary = sim._plain("Helmet", "Hard hat")
	sim.stash_put(a)
	main._armoury._inv.many = true
	main._armoury._inv.chosen = [a["id"]]
	main.refresh()
	_check(main._armoury._inv._sell_button.text.begins_with("Bin 1") and not main._armoury._inv._sell_button.disabled, "Select-many does not bin with the Fence shut: '%s'" % main._armoury._inv._sell_button.text)
	_check_fit(main, "Lock-up (select many, the bin)")
	main._armoury._inv._sell_chosen()
	_check(not sim.stash.has(a), "Select-many's bin left the hard hat")
	main._armoury._inv.many = false
	sim.unlocked = hold_unlocked
	sim.load_dict(saved)
	main.refresh()
	print("the bin ok: a pick's Bin for scrap, a unique asked twice, never the deeds, Select-many bins with the Fence shut")


## The fight kit's hands (17 Oct): a gun base with its own picture shows it (art/fight/hands/<base>.png), drawn as wide as
## the kind's were, its corner where theirs was; its flash on a drawn pixel of the gun, firing into open air; a base
## without one falls back to its kind's; the secondary's in hand behind a dry primary. Every base picture there is checked.
const WALLS_OPEN := []     # walls with no solid row on purpose (a railing, a fence), placed by their tip: none yet


func _kit_hands_checks(main) -> void:
	var sim = main.sim
	var v = main._run._view
	# the kit's plate and wall where they're there: drawn as the old 688 across, the wall's top at COVER_TOP, its slots
	# under their own key - the old pair's placing their start
	var was_key: String = v._site_key
	if RunView.kit_pair("the_parade"):
		v._site("the_parade")
		var pw: float = v._plate.size.x * v._plate.scale.x
		var cw: float = v._cover.size.x * v._cover.scale.x
		var top: float = v._cover_y + RunView.wall_top(v._cover.texture) * v._cover_s
		_check(v._kit_site and is_equal_approx(pw, RunView.PLATE_VIEW_W) and is_equal_approx(cw, RunView.COVER_VIEW_W) and absf(top - RunView.COVER_TOP) < 0.5 and v.slot_key() == "the_parade@kit",
			"the kit's Parade pair isn't drawn as the old: plate %.0f, wall %.0f, its top %.1f (want %.0f), slots under '%s'" % [pw, cw, top, RunView.COVER_TOP, v.slot_key()])
		var placed: Dictionary = RunView.saved_sites()
		if not placed.has("the_parade@kit"):
			_check(RunView.site_slot("the_parade@kit", 0)["foot"] == RunView.site_slot("the_parade", 0)["foot"], "the kit's Parade unplaced doesn't start where the old pair's were")
		v._site(was_key if was_key != "-" else "")
	# every site's wall with its body's top at COVER_TOP (17 Oct, Matt: only the tips showed): the row there at least
	# WALL_SOLID drawn, never above the picture's highest drawn row
	var tips: Array = []
	for t in Data.TIERS:
		var key: String = Items.slug(str(t["name"]))
		var ct: Texture2D = RunView.tex(key + "_cover")
		if ct == null:
			continue
		var wt: float = RunView.wall_top(ct)
		var img: Image = ct.get_image()
		var row := 0
		for x in range(img.get_width()):
			if img.get_pixel(x, int(wt)).a > 0.5:
				row += 1
		if row < RunView.WALL_SOLID * img.get_width() and not (key in WALLS_OPEN):     # no solid row: placed by its tip, the old fault
			tips.append("%s (%d, %d of %d drawn)" % [key, int(wt), row, img.get_width()])
		v._site(key)
		_check(absf(v._cover_y + wt * v._cover_s - RunView.COVER_TOP) < 0.5, "%s's wall body isn't at COVER_TOP: %.1f" % [key, v._cover_y + wt * v._cover_s])
	_check(tips.is_empty(), "walls whose top isn't their body: %s" % ", ".join(tips))
	v._site(was_key if was_key != "-" else "")
	var run = main._run
	for k in run.TILE_ICONS:
		var there: bool = run.icon_tex(run.TILE_ICONS[k]) != null
		_check(run._view == null or not there or run._six[k].has("icon"), "the six's tile %d has its art but no icon" % k)
	_check(Items.slug("Farmer's shotgun") == "farmer_s_shotgun" and Items.slug("Semi-auto .22") == "semi_auto_22" and Items.slug("Courier's SMG") == "courier_s_smg", "the hands' names aren't the manifest's: %s" % Items.slug("Semi-auto .22"))
	var seen := 0
	var bad: Array = []
	for slot in ["Primary", "Secondary"]:
		for b in Data.BASES[slot]:
			var gun: Dictionary = sim._plain(slot, str(b["name"]))
			var slug: String = Items.slug(Items.art_name(str(b["name"])))     # a renamed base's pictures under its old name (the fix round)
			var own: Texture2D = RunView.tex("hands/" + slug)
			var ht: Texture2D = RunView.hands_tex(gun)
			if own == null:
				_check(ht == null or ht == RunView.tex_of(["hands_" + RunView._hands_kind(gun), "hands_revolver"]), "%s has no picture but doesn't fall back to its kind's" % b["name"])
				continue
			seen += 1
			_check(ht == own and is_equal_approx(own.get_size().x * RunView.hands_scale(own), RunView.HANDS_VIEW_W), "%s's hands aren't its own picture at the kind's width: %s" % [b["name"], str(own.get_size())])
			if Items.is_melee(gun):
				continue
			var kind: String = RunView._hands_kind(gun)
			var mz: Dictionary = RunView.muzzle_of(own, kind, slug)
			if mz.is_empty():
				continue
			var img: Image = own.get_image()
			if img.is_compressed():
				img = img.duplicate()
				img.decompress()
			var at: Vector2 = mz["at"]
			var drawn := false
			for dx in range(-2, 3):
				for dy in range(-2, 3):
					var q := Vector2i(int(at.x) + dx, int(at.y) + dy)
					if q.x >= 0 and q.y >= 0 and q.x < img.get_width() and q.y < img.get_height() and img.get_pixelv(q).a > 0.5:
						drawn = true
			var ahead: Vector2 = at + (mz["dir"] as Vector2).normalized() * 6.0
			var qa := Vector2i(int(ahead.x), int(ahead.y))
			var clear: bool = qa.x < 0 or qa.y < 0 or qa.x >= img.get_width() or qa.y >= img.get_height() or img.get_pixelv(qa).a < 0.5
			if not (drawn and clear):
				bad.append("%s at %s (drawn %s, clear %s)" % [b["name"], str(at), str(drawn), str(clear)])
	_check(bad.is_empty(), "the kit's hands whose flash isn't at the muzzle: %s" % ", ".join(bad))
	# the secondary in hand behind a dry primary; the primary while it has rounds or needs none
	var kp = sim.equipped["Primary"]
	var ks = sim.equipped["Secondary"]
	var keep_rig: Array = sim.rig.duplicate()
	sim.equipped["Primary"] = sim._plain("Primary", "Pump shotgun")
	sim.equipped["Secondary"] = sim._plain("Secondary", "Service pistol")
	sim.rig = []
	var dry = RunView.gun_in_hand(sim)
	sim.rig = [_rmag(sim, "Shells")]
	var fed = RunView.gun_in_hand(sim)
	sim.equipped["Primary"] = sim._plain("Primary", "Spiked bat")
	var bat = RunView.gun_in_hand(sim)
	_check(str(dry["base"]) == "Service pistol" and str(fed["base"]) == "Pump shotgun" and str(bat["base"]) == "Spiked bat", "the gun in hand: dry %s, fed %s, a bat %s" % [dry["base"], fed["base"], bat["base"]])
	sim.equipped["Primary"] = kp
	sim.equipped["Secondary"] = ks
	sim.rig = keep_rig
	print("the kit's hands: %d base pictures, every flash at its muzzle ok" % seen)


## The run view (13 Oct, Time Crisis; docs/design/fight_art.md): with its art there, the frame takes the two boxes; the
## six figures under it; the gang up as many as are on you; a kill drops one; a hit reddens the edges; the search pans
## to the crates; their bar over the frame in a fight, the search's under the six; it all fits.
## Your muzzle flash (15 Oct, item 9): every gun kind's at its picture's muzzle - a drawn pixel of the gun, in the
## frame - for its moment, then gone; none on a blade or a hammer.
func _flash_checks(main) -> void:
	var v = main._run._view
	for kind in RunView.MUZZLE:
		var ht: Texture2D = RunView.tex("hands_" + kind)
		if ht == null:
			continue
		v._kind = kind
		v._melee = false
		v._hands.texture = ht
		v._hands.size = ht.get_size()
		v._hands.visible = true
		v._hands_at = RunView.HANDS_CORNER - RunView.used_of(ht).end * RunView.HANDS_SCALE
		v._hands.position = v._hands_at
		v._hs = RunView.hands_scale(ht)
		v._mz = RunView.muzzle_of(ht, kind)
		v.fire_flash()
		var fs: Dictionary = v.flash_state()
		var mz: Vector2 = RunView.MUZZLE[kind]["at"]
		var img: Image = ht.get_image()
		var drawn := false
		for dx in range(-3, 4):
			for dy in range(-3, 4):
				var q := Vector2i(int(mz.x) + dx, int(mz.y) + dy)
				if q.x >= 0 and q.y >= 0 and q.x < img.get_width() and q.y < img.get_height() and img.get_pixelv(q).a > 0.5:
					drawn = true
		# and it fires into open air: a few pixels on along its direction, nothing drawn (16 Oct: the new hands moved every
		# muzzle and the old points sat on the arm, in open air behind the gun, and still passed)
		var ahead: Vector2 = mz + (RunView.MUZZLE[kind]["dir"] as Vector2).normalized() * 6.0
		var qa := Vector2i(int(ahead.x), int(ahead.y))
		var clear: bool = qa.x < 0 or qa.y < 0 or qa.x >= img.get_width() or qa.y >= img.get_height() or img.get_pixelv(qa).a < 0.5
		_check(fs["up"] and Rect2(0, 0, RunView.W, RunView.H).has_point(fs["at"]) and drawn and clear and fs["at"].is_equal_approx(v._hands.position + mz * RunView.HANDS_SCALE), "the %s's flash isn't at its muzzle in the frame: %s (drawn there: %s, open air ahead: %s)" % [kind, str(fs["at"]), str(drawn), str(clear)])
		v._flash_step(1.0)
		_check(v.flash_state()["up"], "the %s's flash went before its first frame was drawn" % kind)
		v._flash_step(1.0)
		_check(not v.flash_state()["up"], "the %s's flash stayed up past its moment" % kind)
	v._melee = true
	v.fire_flash()
	_check(not v.flash_state()["up"], "a blade or a hammer flashed")
	v._melee = false
	_kit_hands_checks(main)
	main.refresh()
	print("the muzzle flash ok: each gun at its muzzle, for its moment; none on a blade")


## A bar over each of them (15 Oct, items 11 and 6; hpbars_mockup.png A): a bar a figure up, in the frame, clear of
## the head line and the chips; the one you're hitting its HP (your hits held till their number's out), the rest full;
## none on one falling; a kill drops the one you were hitting; the bar drops by a number as it lands.
func _fig_bar_checks(main) -> void:
	var run = main._run
	var v = run._view
	var sim = main.sim
	var m: Dictionary = sim.mission
	for k in range(8):
		v._process(0.1)
	main.refresh()
	v._process(0.0)
	var bs: Array = v.bars()
	_check(bs.size() == v.figures_up() and bs.size() > 0 and bs.filter(func(b): return b["hit"]).size() == 1, "a bar a figure up, one hit: %d bars, %d up, %d hit" % [bs.size(), v.figures_up(), bs.filter(func(b): return b["hit"]).size()])
	var frame := Rect2(0, 0, RunView.W, RunView.H)
	var keep: Array = run._keep_out()
	for b in bs:
		var rr: Rect2 = b["rect"]
		var on_run := Rect2(v.position + rr.position * run.VIEW_SCALE, rr.size * run.VIEW_SCALE)
		_check(frame.encloses(rr) and keep.all(func(r): return not r.intersects(on_run)), "a figure's bar is out of the frame or on the head line or the chips: %s" % str(rr))
		var of: float = float(m["t"]["hp"])
		var want: float = clampf((float(m["target_hp"]) + run.held_hits()) / of, 0.0, 1.0) if b["hit"] else 1.0
		_check(absf(float(b["share"]) - want) < 0.02, "figure %d's bar reads %.2f, not %.2f" % [b["k"], float(b["share"]), want])
	var tag: Label = v.hp_words()
	_check(tag.visible and tag.text == "%d / %d" % [ceili(clampf(float(m["target_hp"]) + run.held_hits(), 0.0, float(m["t"]["hp"]))), int(round(float(m["t"]["hp"])))] and UI.text_width(tag, tag.text) <= tag.size.x, "the HP over the one you're hitting reads '%s'" % tag.text)
	# a number held, then out: the bar holds it, then drops by it
	run._hit_pending = {"physical": float(m["t"]["hp"]) * 0.25}
	m["target_hp"] = float(m["t"]["hp"]) * 0.6
	run._fig_bars()
	v._process(0.0)
	var held: float = v.bars().filter(func(b): return b["hit"])[0]["share"]
	run._release_hits(Vector2(100, 100))
	v._process(0.0)
	var out: float = v.bars().filter(func(b): return b["hit"])[0]["share"]
	_check(absf(held - 0.85) < 0.02 and absf(out - 0.6) < 0.02, "the bar doesn't hold a hit till its number, then drop by it: %.2f then %.2f" % [held, out])
	# a kill drops the one you were hitting, and its bar goes with it
	var hit_k: int = v._target_k
	m["kills"] = int(m["kills"]) + 1
	main.refresh()
	v._process(0.0)
	_check(v._figs[hit_k]["state"] == "down" and not v.bars().any(func(b): return b["k"] == hit_k), "a kill didn't drop the one you were hitting, or its bar stayed on it")
	print("the bars over them ok: one a figure, the one hit its HP and the rest full, held hits, a kill")


## The bigger frame (15 Oct, Matt: frame_mockup_B, "B it is"): on the run the rail folds to its glyphs and the run and
## the log take the width; the frame drawn at the column's width, its own 588 x 262 space scaled; the band slim over it;
## off the run the rail as it was.
func _frame_checks(main) -> void:
	var run = main._run
	var v = run._view
	main.layout(Vector2(1920, 1080))
	_check(is_equal_approx(run.VIEW_SCALE, float(run.VIEW_W) / RunView.W) and run.VIEW_H == int(round(RunView.H * run.VIEW_SCALE)) and v.scale.is_equal_approx(Vector2(run.VIEW_SCALE, run.VIEW_SCALE)), "the frame's scale: %.3f, %d high, drawn at %s" % [run.VIEW_SCALE, run.VIEW_H, str(v.scale)])
	var fr := Rect2(v.global_position, Vector2(RunView.W, RunView.H) * v.scale)
	var col := Rect2(run._left.global_position, run._left.size)
	_check(col.encloses(fr) and fr.size.x >= 800.0 and fr.position.y >= run._band.global_position.y + run._band.size.y and fr.end.y + 8.0 <= run._six[0]["panel"].global_position.y + 0.5, "the frame %s isn't in the column %s under the band, over the six" % [str(fr), str(col)])
	_check(main.rail_folded and is_equal_approx(main._rail_panel.size.x, Pal.RAIL_FOLDED_W) and main._rail_buttons.values().all(func(b): return b.size.x == Pal.RAIL_FOLDED_W and not b._name.visible and b.tooltip_text.begins_with(b.room)), "on a run the rail isn't folded to its glyphs, names on hover")
	var rail_end: float = main._rail.global_position.x + Pal.RAIL_FOLDED_W
	_check(is_equal_approx(run.global_position.x, rail_end + Pal.MARGIN) and run.global_position.x + run.size.x <= 1920.0 - Pal.MARGIN + 0.5 and is_equal_approx(run.size.x, Pal.RUN_W), "the run isn't beside the folded rail at its width: x %.0f, w %.0f" % [run.global_position.x, run.size.x])
	_check(is_equal_approx(main._events.global_position.x, run.global_position.x) and is_equal_approx(main._events.size.x, Pal.RUN_W), "the log isn't under the run at its width")
	# the slim band at its widest: the way out, a convoy and gangs, capstones - every line fits, nothing on anything
	var bd = run._band
	# the band kept simple (16 Oct, Matt): no depth or zone, one clock - the time left - and no "ticks while they're on you"
	var went_out: bool = not main.sim.on_mission()
	if went_out:
		main.sim.hp = main.sim.max_hp()
		main.sim.deploy(3)
		main.show_room(main.MISSIONS)
	if main.sim.on_mission() and not main.sim.mission.get("way_out", false):
		main.refresh()
		_check(bd.kicker.text == main.sim.sky_words(int(main.sim.mission["tier"])) and bd.unit.text == "left" and not bd.right[0].text.contains("clock") and not bd.right[1].text.contains("clock"), "the run's band says more than the site, the sky and the time left: '%s' / '%s' / '%s', '%s'" % [bd.kicker.text, bd.unit.text, bd.right[0].text, bd.right[1].text])     # the sky on the kicker (23 Oct, parked item 8)
		print("the run's band kept simple: '%s', '%s' %s, '%s'" % [bd.title.text, bd.headline.text, bd.unit.text, bd.right[0].text])
		# nothing on the take's row when all's well (18 Oct, Matt: "remove 'leaving keeps the loot'")
		var mm2: Dictionary = main.sim.mission
		if main.sim.hp / main.sim.max_hp() > 0.35 and not mm2.get("leave_full", false) and main.sim.pack_used(mm2) < main.sim.capacity() and not mm2.has("crates"):
			_check(run._note.text == "", "a plain run still says something under the take: '%s'" % run._note.text)
		# the runner panel (16 Oct, RunPanel mockup): the rig's cells full size (two rows at most) down to the take; the
		# take one strip over the run's line, the line over the button; "Their fire" and the icons on the six
		var rig_bottom := 0.0
		var smallest := 999.0
		for c in run._rig_cells:
			if c.visible:
				rig_bottom = maxf(rig_bottom, c.position.y + c.size.y)
				smallest = minf(smallest, c.size.y)
		for o in run._rig_outlines:
			if o.visible:
				rig_bottom = maxf(rig_bottom, o.position.y + o.size.y)
				smallest = minf(smallest, o.size.y)
		var strip: Panel = run._take_strip["panel"]
		_check(smallest >= 56.0 and rig_bottom <= run._take_head.position.y and run._take_head.position.y + run._take_head.size.y <= strip.position.y and is_equal_approx(run._note.position.y, run._take_head.position.y) and strip.position.y + strip.size.y <= run._button.position.y,
			"the runner panel's rows are off: rig cells %.0f px to %.0f, take head %.0f, strip %.0f-%.0f, note %.0f (on the head's row), button %.0f" % [smallest, rig_bottom, run._take_head.position.y, strip.position.y, strip.position.y + strip.size.y, run._note.position.y, run._button.position.y])
		_check(run._view == null or (run._six[1].has("icon") and run._six[4].has("icon")) or not ResourceLoader.exists("res://art/ui/dps.png"), "the six have no icons where Matt's art is")
	if went_out and main.sim.on_mission():
		main.sim.extract_now()
		main.refresh()
	bd.set_words("The way out", "Ransacked Streets", "12:59", ["to the way out · see them off", "see them off", "left"], Pal.ACCENT)
	bd.set_right(["", "convoy, 12 gangs", "◆◆ Poached, Dead quiet, Spread"])
	for short in ["◆◆ 3 capstones", "◆◆ 3", ""]:
		if UI.text_width(bd.right[2], bd.right[2].text) <= bd.right[2].size.x:
			break
		bd.set_right(["", "convoy, 12 gangs", short])
	var labels: Array = [bd.title, bd.headline, bd.unit, bd.kicker, bd.right[0], bd.right[1], bd.right[2]]
	for l in labels:
		_check(UI.text_width(l, l.text) <= l.size.x + 0.5 and l.position.x >= 0.0 and l.position.x + l.size.x <= bd.size.x + 0.5 and l.position.y + l.size.y <= bd.bar.position.y + 2.0, "the slim band's '%s' doesn't fit its row: %.0f in %.0f at %s" % [l.text, UI.text_width(l, l.text), l.size.x, str(l.position)])
	for i in range(labels.size()):
		for j in range(i + 1, labels.size()):
			var a: Label = labels[i]
			var b: Label = labels[j]
			if (a == bd.headline and b == bd.unit) or a.text == "" or b.text == "":
				continue
			var ra := Rect2(a.position, Vector2(UI.text_width(a, a.text), a.size.y))
			var rb := Rect2(b.position, Vector2(UI.text_width(b, b.text), b.size.y))
			_check(not ra.grow(-2.0).intersects(rb.grow(-2.0)), "the slim band's '%s' sits on '%s'" % [a.text, b.text])
	main.refresh()
	# off the run, the rail as it was
	main.show_room(main.RUNNER)
	main.refresh()
	_check(not main.rail_folded and is_equal_approx(main._rail_panel.size.x, Pal.RAIL_W) and main._rail_buttons.values().all(func(b): return b.size.x == Pal.RAIL_W and b._name.visible) and is_equal_approx(main._events.size.x, Pal.GRID_W), "off the run the rail didn't unfold")
	main.show_room(main.MISSIONS)
	main.refresh()


## The six under the frame (17 Oct, Matt: stat-tile mockup A with C's grouping): THEM and YOU, each tile's icon
## then its key over its figure inside the tile; the figure never the "—" fallback; the tones on what wants acting on.
func _six_checks(main, m: Dictionary) -> void:
	var run = main._run
	var g: Array = run._six_groups
	_check(g.size() == 2 and g[0].position.x >= run.VIEW_X - 0.5 and absf(g[0].position.x + g[0].size.x + run.SIX_GAP - g[1].position.x) < 0.5 and g[1].position.x + g[1].size.x <= run.VIEW_X + run.VIEW_W + 0.5,
		"the six's two groups aren't side by side across the frame's width")
	for k in range(6):
		var t: Dictionary = run._six[k]
		var want = g[0] if k in run.SIX_THEM else g[1]
		_check(t["panel"].get_parent() == want, "the six's tile %d ('%s') is in the wrong group" % [k, t["key"].text])
		var tw: float = t["panel"].size.x
		var left: float = 8.0
		if t.has("icon"):
			_check(is_equal_approx(t["icon"].size.x, run.TILE_ICON), "the six's tile %d icon is %.0f px, not %d" % [k, t["icon"].size.x, run.TILE_ICON])
			left = t["icon"].position.x + t["icon"].size.x
		for l in [t["key"], t["value"]]:
			_check(l.position.x >= left and l.position.x + l.size.x <= tw + 0.5 and UI.text_width(l, l.text) <= l.size.x + 0.5, "the six's '%s' doesn't sit beside its icon in its tile" % l.text)
		_check(t["value"].text != "—", "the six's %s fell back to a dash" % t["key"].text)
	# the tones: their fire red when it'd drop you inside SIX_FAST_S, quiet when it wouldn't
	var sim = main.sim
	m["last_incoming"] = sim.hp
	main.refresh()
	_check(run._six[0]["value"].get_theme_color("font_color") == Pal.BAD, "their fire at your HP a second isn't red")
	m["last_incoming"] = 0.01
	main.refresh()
	_check(run._six[0]["value"].get_theme_color("font_color") == Pal.TEXT, "their fire at a trickle is red")
	# endgame figures (the second review's 8): their fire, kills and rounds in the millions still fit, never cut
	var inc_was: float = float(m["last_incoming"])
	m["last_incoming"] = 1234567.0     # (not the kills: the view counts them to drop a figure)
	main.refresh()
	_check(str(run._six[0]["value"].text) in run.incoming_forms(1234567.0), "their fire at 1.2M reads '%s', none of its forms" % run._six[0]["value"].text)
	for t in run._six:
		var lv: Label = t["value"]
		_check(UI.text_width(lv, lv.text) <= lv.size.x + 0.5 and not lv.text.ends_with("…"), "the six's %s at endgame figures doesn't fit: '%s' (%.0f in %.0f px)" % [t["key"].text, lv.text, UI.text_width(lv, lv.text), lv.size.x])
	m["last_incoming"] = inc_was
	_check(run.incoming_forms(3.25)[0] == "3.2/s" or run.incoming_forms(3.25)[0] == "3.3/s", "a trickle of fire lost its tenth: %s" % str(run.incoming_forms(3.25)))
	# a gang due after the clock runs out says so, not a time that never comes (the first review's 2(b), 15)
	if not sim.has_rule("bomb_suit"):
		_check(run.gang_in_forms({"clock": 10.0}, 600.0) == Words.RUN_GANG_LATE and run.gang_in_forms({"clock": 1e6}, 60.0) == [Fmt.mss(60.0)], "the gang's time past the clock: %s, %s" % [str(run.gang_in_forms({"clock": 10.0}, 600.0)), str(run.gang_in_forms({"clock": 1e6}, 60.0))])
	# the On you chips stay short of the skills' buttons (the second review's 10): skills on, greed and a med in use
	var sk_ids: Dictionary = _skill_node_ids()
	var mine_sk: Array = sk_ids.keys().filter(func(sid): return str(sim.skill(str(sid)).get("cls", "")) == sim.cls)
	if not mine_sk.is_empty():
		var slots_was: Array = sim.skill_slots.duplicate()
		var tree_was: Array = sim.tree.duplicate()
		var cleared_was: bool = bool(m.get("cleared", false))
		var patrols_was: int = int(m.get("patrols", 0))
		var using_was = m["using"]
		var dots_was = m.get("my_dots", {})
		for sid in mine_sk.slice(0, 3):
			if not sim.tree.has(sk_ids[sid]):
				sim.tree.append(sk_ids[sid])
		sim.skill_slots = mine_sk.slice(0, 3).map(func(x): return str(x))
		while sim.skill_slots.size() < 3:
			sim.skill_slots.append("")
		sim._dry_memo.clear()
		m["cleared"] = true
		m["patrols"] = 9
		m["using"] = {"name": "Field surgery kit", "left": 12.0}
		m["my_dots"] = {"fire": 5.0}
		main.refresh()
		var cr: Rect2 = run._runner["chips"].used_rect()
		cr.position += run._runner["chips"].position
		var keeps: Array = run._skills.keep_rects() if run._skills != null else []
		_check(not keeps.is_empty(), "the skills' buttons didn't show for the On you check")
		_check(not keeps.any(func(r): return r.intersects(cr)), "the On you chips run under the skills' buttons: %s against %s" % [str(cr), str(keeps)])
		m["using"] = null
		m["my_dots"] = {}
		main.refresh()
		_check(run._runner["chips"]._panels.any(func(p): return p.visible and p.tooltip_text.begins_with("Greed")), "the greed chip has no hover words")
		# a chip with hover words takes the mouse: it mustn't sit over any button on the screen
		var tipped: Array = run._runner["chips"]._panels.filter(func(p): return p.visible and p.tooltip_text != "")
		var btns: Array = run.find_children("*", "BaseButton", true, false).filter(func(b): return b.is_visible_in_tree())
		for p in tipped:
			var over: Array = btns.filter(func(b): return b.get_global_rect().intersects(p.get_global_rect()))
			_check(over.is_empty(), "a hover chip sits over a button: %s" % str(over.map(func(b): return b.name)))
		sim.skill_slots = slots_was
		sim.tree = tree_was
		sim._dry_memo.clear()
		m["cleared"] = cleared_was
		m["patrols"] = patrols_was
		m["using"] = using_was
		m["my_dots"] = dots_was
		main.refresh()
	# your fire is the top bar's figure (19 Oct, Matt: 510 against 362), the pace beside it
	var top_fire: String = main._top_labels["dps"].text.get_slice(" ", 0)
	_check(run._six[1]["value"].text.begins_with(top_fire + "/s"), "your fire reads '%s', the top bar '%s'" % [run._six[1]["value"].text, main._top_labels["dps"].text])
	_check(absf(sim.pace() - 1.0) < 0.005 or run._six[1]["value"].text.contains("×") or run._six[1]["value"].text == top_fire + "/s", "your fire's pace is off: '%s'" % run._six[1]["value"].text)
	var rows: Array = run.six_rows(m, m["t"], 1.0)
	_check((rows[4][2] == Pal.BAD) == (rows[4][1][0] == "none"), "the meds' tone and its figure disagree: %s" % str(rows[4]))
	# a blade in hand: its rounds read melee, muted, not the dash
	var gun_was = sim.equipped["Primary"]
	sim.equipped["Primary"] = sim._plain("Primary", "Machete")
	main.refresh()
	_check(run._six[5]["value"].text == "melee" and run._six[5]["value"].get_theme_color("font_color") == Pal.TEXT_3, "a machete's rounds read '%s', not melee" % run._six[5]["value"].text)
	# the Weed Burner: a shotgun's base, and it spends rounds as one now (25 Oct, the review: no longer free)
	var wb: Dictionary = Items.roll_unique(sim._unique_named("The Council's Weed Burner"), sim.rng)
	if not wb.is_empty():
		sim.equipped["Primary"] = wb
		main.refresh()
		_check(run._six[5]["value"].get_theme_font("font").has_char(0x221E), "the tiles' font has no ∞ for the Weed Burner")
		_check(run._six[5]["value"].text != "∞" and run._six[5]["value"].text != "melee", "the Weed Burner's rounds read '%s', as if free" % run._six[5]["value"].text)
	sim.equipped["Primary"] = gun_was
	m["last_incoming"] = 0.0
	main.refresh()
	print("the six: THEM and YOU, %d px icons, the tones, a blade's melee" % run.TILE_ICON)


func _run_view_checks(main) -> void:
	var run = main._run
	if run._view == null:
		print("the run view: no art here (art/fight_test), the boxes as they were")
		return
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.hp = sim.max_hp()
	sim.deploy(0)
	var m: Dictionary = sim.mission
	m["event_at"] = -1.0
	m["remaining"] = 3
	main.show_room(main.MISSIONS)
	main.refresh()
	for k in range(4):
		run._view._process(0.2)
	var v = run._view
	_check(v.visible and not run._fight["box"].visible and not run._runner["box"].visible and run._six[0]["panel"].visible, "the run view did not take the two boxes")
	var want: int = mini(3, mini(int(m["remaining"]), maxi(1, sim.contact(m["t"]))))
	_check(v.figures_up() == want, "the frame shows %d up, not %d" % [v.figures_up(), want])
	_check(not v.state()["glass"], "the glass shows in a fight")
	_full_art_checks(main, v)
	_check(not run._fight["track"].visible and run._six[0]["key"].text == "Their fire", "the top bar shows in a fight (their HP is over each of them), or the six don't lead with Incoming")
	_six_checks(main, m)
	_fig_bar_checks(main)
	_flash_checks(main)
	_check_fit(main, "Run (the run view, a gang)")
	_frame_checks(main)
	_check(not run._fight_face["art"].visible and not run._runner_face["art"].visible, "the faces' pictures show over the run view (Matt, 13 Oct)")
	# a kill drops one - any of them, not the first every time (Matt, 13 Oct)
	m["kills"] = int(m["kills"]) + 1
	main.refresh()
	v._process(0.05)
	_check(v._figs.any(func(f): return f["state"] == "down"), "a kill dropped nobody")
	var fallen := {}
	for trial in range(24):
		for k in range(v._figs.size()):
			v._set_state(k, "up")
		v._kills_seen = int(m["kills"])
		m["kills"] = int(m["kills"]) + 1
		main.refresh()
		for k in range(v._figs.size()):
			if v._figs[k]["state"] == "down":
				fallen[k] = true
	_check(fallen.size() >= 2, "only one of them ever goes down: %s" % str(fallen.keys()))
	# under fire you duck behind the wall now and then
	v._duck_next = 0.0
	v._duck_t = 0.0
	for k in range(4):
		v._process(0.1)
	_check(float(v.state()["duck"]) > 0.3, "the runner never ducks: %s" % str(v.state()))
	# down behind the wall, the wall runs to the frame's foot (Matt, 13 Oct: "too short when crouching") - the wall
	# itself, one piece, nothing tiled under it (23 Oct, Matt: "you can see the same tiled wall 3 times")
	v._duck_t = 5.0
	for k in range(10):
		v._process(0.1)
	var cv: TextureRect = v._cover
	_check(v._duck > 0.95 and cv.position.y + cv.size.y * cv.scale.y >= RunView.H, "ducked, the wall stops short of the frame's foot: cover to %.0f" % (cv.position.y + cv.size.y * cv.scale.y))
	# and every site's wall reaches by itself, from art/fight_walls/
	for wkey in RunView.SITE_FAR.keys():
		var wct: Texture2D = RunView.tex(str(wkey) + "_cover")
		_check(wct != null and RunView.tex_from(str(wkey) + "_cover") == RunView.WALLS_DIR and RunView.cover_reaches(wct), "%s's wall isn't the tall one, or stops short ducked (from %s)" % [wkey, RunView.tex_from(str(wkey) + "_cover")])
	v._duck_t = 0.0
	# the far one stands further down the street than the middle one, smaller, wholly in the frame
	# every site's three: the far one above the wall, smaller than the middle one, in frame, clear of the other two
	var keys: Array = [""] + RunView.SITE_FAR.keys()
	# the tables' own (what F3/F5 has saved is Matt's call, checked only for being in the frame, below)
	var placed: Dictionary = RunView.saved_sites().duplicate(true)
	RunView.use_saved({})
	for key in placed:
		for k in range(3):
			var row: Array = placed[key][k]
			_check(float(row[0]) >= 0.0 and float(row[0]) <= RunView.W and float(row[1]) > 0.0 and float(row[1]) <= RunView.H + 40.0 and float(row[2]) > 0.05 and float(row[2]) < 2.0, "%s's placed %d is off the frame: %s" % [key, k, str(row)])
	for key in keys:
		var mid_in: Dictionary = RunView.site_slot(key, 0)
		var nr: Dictionary = RunView.site_slot(key, 1)
		var far: Dictionary = RunView.site_slot(key, 2)
		_check(far["foot"].y < mid_in["foot"].y - 25 and far["foot"].y < RunView.COVER_TOP - 20 and far["scale"] < mid_in["scale"] * 0.8 and far["foot"].x - 64 * far["scale"] >= 0 and far["foot"].y - 192 * far["scale"] >= 0, "%s: the far one isn't down the street: %s against %s" % [key, str(far), str(mid_in)])
		_check(absf(far["foot"].x - mid_in["foot"].x) > 40.0 and absf(far["foot"].x - nr["foot"].x) > 50.0 and absf(mid_in["foot"].x - nr["foot"].x) > 80.0, "%s: two of them stand in front of each other: %s %s %s" % [key, str(mid_in["foot"]), str(nr["foot"]), str(far["foot"])])
	RunView.use_saved(placed)
	var mid: Dictionary = RunView.SLOTS[0]
	# the middle one near the centre; the near one left of your gun - most of him clear of every gun's hands (Matt, 13 Oct)
	_check(absf(mid["foot"].x - RunView.W / 2.0) < 45.0, "the middle one isn't near the centre: %s" % str(mid))
	var near: Dictionary = RunView.SLOTS[1]
	var stand: Texture2D = RunView.tex_of(["gang_the_estate_a_stand", "gang_stand"])
	var su: Rect2 = RunView.used_of(stand)
	var nrect := Rect2(near["foot"] - Vector2(su.get_center().x - su.position.x, su.size.y) * near["scale"], su.size * near["scale"])
	nrect.end.y = minf(nrect.end.y, RunView.COVER_TOP)          # below the wall's top he's behind it anyway
	var hand_pics: Array = []
	for ty in ["pistol", "shotgun", "rifle", "smg", "improvised", "melee", "blade", "revolver"]:
		hand_pics.append([ty, RunView.tex("hands_" + ty)])
	for slot in ["Primary", "Secondary"]:
		for b in Data.BASES[slot]:
			hand_pics.append([str(b["name"]), RunView.tex("hands/" + Items.slug(str(b["name"])))])     # the kit's (17 Oct)
	for pic in hand_pics:
		var ty: String = pic[0]
		var ht: Texture2D = pic[1]
		if ht == null:
			continue
		var hsc: float = RunView.hands_scale(ht)
		# what of him is drawn that the hands' drawn pixels cover, sampled every few pixels (a raised hammer's box is mostly air)
		var hu: Rect2 = RunView.used_of(ht)
		var h_at: Vector2 = RunView.HANDS_CORNER - hu.end * hsc
		var n_at: Vector2 = near["foot"] - Vector2(su.get_center().x, su.end.y) * near["scale"]
		var himg: Image = ht.get_image()
		var nimg: Image = stand.get_image()
		var drawn := 0
		var covered := 0
		var y := nrect.position.y
		while y < nrect.end.y:
			var x := nrect.position.x
			while x < nrect.end.x:
				var np: Vector2 = (Vector2(x, y) - n_at) / near["scale"]
				if np.x >= 0 and np.y >= 0 and np.x < nimg.get_width() and np.y < nimg.get_height() and nimg.get_pixelv(Vector2i(np)).a > 0.5:
					drawn += 1
					var hp: Vector2 = (Vector2(x, y) - h_at) / hsc
					if hp.x >= 0 and hp.y >= 0 and hp.x < himg.get_width() and hp.y < himg.get_height() and himg.get_pixelv(Vector2i(hp)).a > 0.5:
						covered += 1
				x += 3.0
			y += 3.0
		_check(drawn > 50, "the near one's sampling found nothing drawn (%d)" % drawn)
		var hidden: float = float(covered) / maxf(1.0, float(drawn))
		_check(hidden < 0.35, "the %s's hands hide %.0f%% of the near one" % [ty, hidden * 100.0])
	# the numbers keep off the bars, the head, the keys and the chips (Matt, 13 Oct: they sat on "On you"), with
	# something on both sides so both rows of chips show; the keep-out drawn here from the nodes, not run's own list
	# and again with your chips as wide as they get (a med in use too), which leaves the frame's foot no room (the review)
	m["dots"] = {"fire": 50.0, "poison": 50.0, "bleed": 50.0}
	m["my_dots"] = {"fire": 50.0, "poison": 50.0, "bleed": 50.0}
	for wide in [false, true]:
		if wide:
			m["using"] = {"name": "First aid kit", "left": 9.0, "heal": 1.0}
		else:
			m["using"] = null
		main.refresh()
		_check(run._fight["chips"].visible and run._runner["chips"].visible, "the chips did not show for the numbers' check")
		var keep: Array = []
		for c in [run._fight["track"], run._runner["track"]]:
			if c.visible:
				keep.append(c.get_global_rect())     # their top bar's gone in a fight (15 Oct, item 11)
		for d in [run._fight, run._runner]:
			for p in d["chips"]._panels:
				if p.visible:
					keep.append(p.get_global_rect())
		var jz: Vector2 = run.juice.global_position if run.juice != null else Vector2.ZERO
		var crossed: Array = []
		for k in range(60):
			for bar_y in [run.FIGHT_BAR_Y, run.RUNNER_BAR_Y]:
				var at: Vector2 = run._scatter(bar_y) + jz               # back to the screen's space
				var path := Rect2(at.x - 30, at.y - Juice.NUMBER_RISE, 60, 30 + Juice.NUMBER_RISE)
				if keep.any(func(r): return r.intersects(path)):
					crossed.append(at)
		_check(crossed.is_empty(), "%d of 120 numbers rise across a bar or a chip (%s): %s" % [crossed.size(), "wide chips" if wide else "three a side", str(crossed.slice(0, 4))])
	m["using"] = null
	m["dots"] = {}
	m["my_dots"] = {}
	# the elements in engine (13 Oct, Matt): fire on them flames and warms them, poison on you greens the frame's edges
	for k in range(v._figs.size()):
		v._set_state(k, "up")
	m["dots"] = {"fire": 50.0}
	m["my_dots"] = {"poison": 50.0}
	main.refresh()
	for k in range(6):
		v._process(0.1)
	var fx: Dictionary = v.fx()
	_check(fx["them"]["fire"] and not fx["them"]["poison"] and not fx["them"]["frost"] and fx["tint"].r > fx["tint"].b * 1.5, "fire on them did not show as fire: %s" % str(fx))
	_check(fx["you"]["poison"] > 0.3 and fx["you"]["fire"] < 0.05, "poison on you did not edge the frame green: %s" % str(fx["you"]))
	# chilled: blue, flakes, slower; shocked: an arc across them
	m["dots"] = {}
	m["my_dots"] = {}
	m["chill_t"] = 5.0
	main.refresh()
	for k in range(3):
		v._process(0.1)
	fx = v.fx()
	_check(fx["them"]["frost"] and not fx["them"]["fire"] and fx["tint"].b > fx["tint"].r * 1.5, "a chill on them did not show as frost: %s" % str(fx))
	m["chill_t"] = 0.0
	m["shock_t"] = 5.0
	main.refresh()
	var arcs := 0
	for k in range(12):
		v._process(0.05)
		arcs = maxi(arcs, int(v.fx()["arcs"]))
	_check(arcs > 0, "a shock on them never arced")
	# chilled, a pop takes twice as long (the review: the slowness itself checked)
	m["shock_t"] = 0.0
	m["chill_t"] = 5.0
	main.refresh()
	for k in range(v._figs.size()):
		v._set_state(k, "")
	v._set_state(0, "pop")
	# coming in is a fade where it stands, not a rise through the floor (Matt, 13 Oct): half way, half there, feet down
	v._process(RunView.POP_S * 0.5)
	var pr: TextureRect = v._figs[0]["rect"]
	var pu: Rect2 = RunView.used_of(pr.texture)
	var pfeet: float = pr.position.y + pu.end.y * v.slot_of(0)["scale"]
	_check(pr.modulate.a > 0.05 and pr.modulate.a < 0.95 and absf(pfeet - (v.slot_of(0)["foot"].y - RunView.DUCK_SCENE * v._duck)) < 1.5, "a figure coming in doesn't fade in where it stands: alpha %.2f, feet %.0f" % [pr.modulate.a, pfeet])
	v._set_state(0, "pop")
	v._process(RunView.POP_S * 1.2)                # full pace it'd be up by now
	_check(v._figs[0]["state"] == "pop", "a chilled figure popped up at full pace")
	v._process(RunView.POP_S * 1.0)
	_check(v._figs[0]["state"] == "up", "a chilled figure never finished popping up")
	m["chill_t"] = 0.0
	main.refresh()
	# a figure down takes its flames with it; nothing on anyone: nothing shown, the edges gone
	m["shock_t"] = 0.0
	m["dots"] = {"fire": 50.0}
	main.refresh()
	v._process(0.05)
	v._set_state(0, "down")
	v._process(0.05)
	_check(not v._figs[0]["fx"]["fire"].emitting, "a figure going down kept burning")
	m["dots"] = {}
	main.refresh()
	for k in range(10):
		v._process(0.1)
	fx = v.fx()
	_check(fx["them"].values().all(func(b): return not b) and fx["you"].values().all(func(a): return a < 0.01) and fx["arcs"] == 0, "the elements did not clear: %s" % str(fx))
	# and the fight over with fire still on the books: every emitter off
	m["dots"] = {"fire": 50.0, "poison": 50.0, "bleed": 50.0}
	m["chill_t"] = 5.0
	main.refresh()
	v._process(0.1)
	var rem0: int = int(m["remaining"])
	m["remaining"] = 0
	main.refresh()
	v._process(0.1)
	_check(v.fx()["them"].values().all(func(b): return not b), "the elements kept going on them after the fight: %s" % str(v.fx()))
	m["remaining"] = rem0
	m["dots"] = {}
	m["chill_t"] = 0.0
	main.refresh()
	# a hit reddens the edges
	sim.hp -= sim.max_hp() * 0.1
	main.refresh()
	_check(v.state()["red"] > 0.5, "a hit did not redden the frame")
	# the search: panned to the crates, the search bar under the six
	m["remaining"] = 0
	m["cleared"] = true
	m["patrol_timer"] = -1e9
	sim._roll_crates(m, m["t"])
	main.refresh()
	for k in range(10):
		v._process(0.2)
	_check(v.state()["pan_to"] > 0.0 and v.state()["crates"] > 0 and v.figures_up() == 0, "the search did not pan to the crates: %s" % str(v.state()))
	# panned, the cover still spans the frame; the crates stand on the ground, nearer is lower and bigger; the glass over
	# the one being opened, its ring the search so far (Matt, 13 Oct)
	_check(v._cover.position.x <= 0.0 and v._cover.position.x + v._cover.size.x >= RunView.W, "panned to the crates, the cover leaves a gap: %.0f to %.0f" % [v._cover.position.x, v._cover.position.x + v._cover.size.x])
	for k in range(RunView.CRATE_SPOTS.size() - 1):
		_check(RunView.CRATE_SPOTS[k]["foot"].y > RunView.CRATE_SPOTS[k + 1]["foot"].y and RunView.CRATE_SPOTS[k]["scale"] > RunView.CRATE_SPOTS[k + 1]["scale"], "the crates aren't in depth: %d against %d" % [k, k + 1])
	# the crates ride the pan: halfway in, they're half the pan short of their spots, the plate with them
	var pan_end: float = v._pan
	v._pan_to = RunView.PAN * 0.5
	v._pan = RunView.PAN * 0.5
	v._process(0.0)
	var c0m: Vector2 = v._crates[0].get_meta("at")
	_check(absf(v._crates[0].position.x - (c0m.x + RunView.PAN * 0.5)) < 0.5 and absf((v._crates[0].position.x - v._plate.position.x) - (c0m.x - (RunView.PLATE_AT.x - RunView.PAN))) < 2.0, "the crates don't ride the pan: crate %.1f, plate %.1f" % [v._crates[0].position.x, v._plate.position.x])
	v._pan = pan_end
	v._pan_to = RunView.PAN
	v._process(0.0)
	var c0: TextureRect = v._crates[0]
	var gc: Vector2 = v._glass.position + Vector2(RunView.Glass.R, RunView.Glass.R)
	_check(v.state()["glass"] and c0.visible and gc.x >= c0.position.x - 4 and gc.x <= c0.position.x + c0.size.x * c0.scale.x + 24 and gc.y < c0.position.y, "the glass isn't over the crate being opened: glass %s, crate %s" % [str(gc), str(c0.position)])
	m["search"] = sim.search_s(m["t"]) * 0.5
	main.refresh()
	_check(absf(float(v.state()["search_p"]) - 0.5) < 0.01, "the glass's ring isn't the search: %.2f" % float(v.state()["search_p"]))
	# the search's bar in the HP bar's place, the frame's width (14 Oct, Matt); a gang puts their HP bar and yours back
	_check(is_equal_approx(run._fight["track"].position.y, run.OVER_Y) and is_equal_approx(run._fight["track"].size.x, run.INNER) and not run._runner["track"].visible and run._six[0]["key"].text == "Gang in", "the search bar is not at the frame's foot in the HP bar's place")
	_search_layout(main, "the run view, the search")
	_check_fit(main, "Run (the run view, the search)")
	m["remaining"] = 2
	main.refresh()
	_check(run._runner["track"].visible and is_equal_approx(run._runner["track"].position.y, run.OVER_Y) and not run._fight["track"].visible, "a gang did not bring your HP bar back, or the search's stayed over it")
	_search_layout(main, "the run view, a gang in the search")
	_check_fit(main, "Run (the run view, a gang in the search)")
	m["remaining"] = 0
	main.refresh()
	_check(not run._runner["track"].visible and is_equal_approx(run._fight["track"].position.y, run.OVER_Y), "the gang gone, the search bar did not come back in the HP bar's place")
	# a full rig and a floor past a row: nothing on the buttons, the floor's pages clear of its cells
	var rig0: Array = sim.rig.duplicate()
	var floor0: Array = sim.floor_items().duplicate()
	if not sim.rig.is_empty() and Items.size(sim.rig[0]) == 1:
		while sim.rig_used() < mini(sim.med_capacity(), Data.RIG_CAP):
			var one: Dictionary = sim.rig[0].duplicate(true)
			one["id"] = Items._next_id
			Items._next_id += 1
			sim.rig.append(one)
	var proto: Dictionary = sim._plain("Helmet", "Army helmet")
	for k in range(14):
		var f: Dictionary = proto.duplicate(true)
		f["id"] = Items._next_id
		Items._next_id += 1
		m["floor"] = sim.floor_items() + [f]
	main.refresh()
	_check(run._crates._prev.visible, "fourteen things on the floor and no pages")
	_search_layout(main, "a full rig, the floor paged")
	_check_fit(main, "Run (a full rig, the floor paged)")
	sim.rig = rig0
	m["floor"] = floor0
	main.refresh()
	_placement_checks(main, v)
	sim.extract_now()
	sim.load_dict(saved)
	main.refresh()
	print("the run view ok: the frame, the gang up, a kill, a hit, the search, the bars and the six, the fit")


## The opening (14 Oct, docs/design/intro.md): six scenes, the game held while they play, every line fitting its row,
## a press bringing the next line then the next scene, Esc ending it; the art reported, not failed, till it's made.
func _opening_checks(main) -> void:
	var sim = main.sim
	main.play_opening()
	var op = main._opening
	_check(op != null and op.scene == 0, "the opening didn't start on its first scene")
	if op.is_inside_tree() and op._vlen > 0.0 and op.voice_on:
		_check(op._voice.playing, "the first scene's reading isn't playing (the review: it started before the tree)")
	var t0: float = sim.elapsed
	main._process(0.5)
	_check(is_equal_approx(sim.elapsed, t0), "the game ran under the opening")
	var arts := 0
	op._place(Vector2(1920, 1080))
	for i in range(op.scenes.size()):
		var sc: Dictionary = op.scenes[i]
		if ResourceLoader.exists(op.ART % sc["art"]) or FileAccess.file_exists(op.ART % sc["art"]):
			arts += 1
		op._go(i)
		var all: Array = op.lines_of(i)
		_check(all.size() <= op._lines.size(), "scene %d has more lines than rows" % i)
		for k in range(mini(all.size(), op._lines.size())):
			var l: Label = op._lines[k]
			_check(UI.text_width(l, l.text) <= l.size.x - 8.0, "an opening line runs past its row: '%s'" % l.text)
			_check(l.position.y + 48 < op._pips[0].position.y, "scene %d's lines run into the pips" % i)
	op._go(0)
	print("the opening: %d of %d scenes have their picture" % [arts, op.scenes.size()])
	# no white band the generator left shows at the picture's top or foot (14 Oct)
	for i in range(op.scenes.size()):
		op._go(i)
		var tx: Texture2D = op._pic.texture
		if tx == null:
			continue
		var img: Image = tx.get_image()
		for y in [0, img.get_height() - 1]:
			var whites := 0
			for x in range(0, img.get_width(), 8):
				var c: Color = img.get_pixel(x, y)
				if minf(c.r, minf(c.g, c.b)) > 0.94:
					whites += 1
			@warning_ignore("integer_division")
			_check(whites < (img.get_width() / 8) * 0.6, "scene %d's picture shows a white band at row %d" % [i, y])
	# the reading: each scene's cues one a line, in order, inside its take; the lines come up as they're said
	var voiced := 0
	for i in range(op.scenes.size()):
		var sc: Dictionary = op.scenes[i]
		_check(sc.has("cues") and sc["cues"].size() == op.lines_of(i).size(), "scene %d's cues aren't one a line" % i)
		for k in range(1, sc.get("cues", []).size()):
			_check(float(sc["cues"][k]) > float(sc["cues"][k - 1]), "scene %d's cues go backwards" % i)
		op._go(i)
		if op.voiced():
			voiced += 1
			_check(float(sc["cues"].back()) < op._vlen, "scene %d's last cue is past its reading (%.1f s)" % [i, op._vlen])
	print("the opening: %d of %d scenes have their reading" % [voiced, op.scenes.size()])
	op._go(0)
	if op.voiced():
		op._fading = 0.0
		var c0: float = float(op.scenes[0]["cues"][0])
		op._process(c0 - 0.5)
		_check(op.shown == 0, "a line came up before it's said: %d" % op.shown)
		op._process(0.6)
		_check(op.shown == 1, "the first line didn't come up as it's said: %d" % op.shown)
		op.advance()
		_check(op.shown == 2 and is_equal_approx(op._vt, float(op.scenes[0]["cues"][1])), "a press didn't take the reading to the next line: %d, %.2f" % [op.shown, op._vt])
		op._go(0)
	# presses: every line of the first scene, then on to the second
	op.size = Vector2(1920, 1080)
	op._fading = 0.0
	for k in range(op.lines_of(0).size()):
		op.advance()
	_check(op.shown == op.lines_of(0).size(), "a press didn't bring the next line: %d" % op.shown)
	op.advance()
	for k in range(20):
		op._process(0.1)
	_check(op.scene == 1, "a press with every line up didn't move to the next scene: %d" % op.scene)
	# left alone it plays itself through
	op._process(0.0)
	for k in range(1000):
		if not is_instance_valid(op) or op._finished:
			break
		op._process(0.25)
	_check(not is_instance_valid(op) or op._finished, "left alone the opening never ended")
	_check(main._opening == null, "the game's still held after the opening")
	main._process(0.2)
	_check(sim.elapsed > t0, "the game didn't run on after the opening")
	# Esc ends it at once
	main.play_opening()
	var esc := InputEventKey.new()
	esc.keycode = KEY_ESCAPE
	esc.pressed = true
	main._opening._input(esc)
	_check(main._opening == null, "Esc didn't end the opening")
	# the same Esc doesn't go on to open the pause (Matt, 14 Oct: the pause came up under the Map's card)
	main._unhandled_input(esc)
	_check(not main._menu.visible, "the Esc that skipped the opening opened the pause too")
	if main._menu.visible:
		main._menu.close()
	print("opening ok: six scenes, the lines fit, a press, left alone, Esc, the game held and let go")
	# On the air (14 Oct): the same player with Kev's scenes - a cue a line, in order, inside each take; the lines fit
	var air = main.Opening.new(Words.AIR_SCENES)
	main.add_child(air)
	air._place(Vector2(1920, 1080))
	var air_voiced := 0
	var air_art := 0
	for i in range(air.scenes.size()):
		var sc: Dictionary = air.scenes[i]
		air._go(i)
		if air._pic.texture != null:
			air_art += 1
		_check(sc.has("cues") and sc["cues"].size() == air.lines_of(i).size(), "On the air's scene %d has its cues off its lines" % i)
		for k in range(1, sc.get("cues", []).size()):
			_check(float(sc["cues"][k]) > float(sc["cues"][k - 1]), "On the air's scene %d's cues go backwards" % i)
		var all: Array = air.lines_of(i)
		for k in range(mini(all.size(), air._lines.size())):
			var l: Label = air._lines[k]
			_check(UI.text_width(l, l.text) <= l.size.x - 8.0, "an On the air line runs past its row: '%s'" % l.text)
		if air.voiced():
			air_voiced += 1
			_check(float(sc["cues"].back()) < air._vlen, "On the air's scene %d's last cue is past its take" % i)
	print("on the air: %d of %d scenes have their picture, %d their reading" % [air_art, air.scenes.size(), air_voiced])
	air.finish()


## The placement tool (13 Oct, Matt: Greenhorn's F3/F5): F3 holds the fight still with all three standing on their slots;
## a drag moves one's feet, its corner sizes it (feet kept); F5 saves the site's three, and the view reads them after.
func _placement_checks(main, v) -> void:
	if not v.can_place():
		print("the placement tool: not on a site with its own art here, not checked")
		return
	var sim = main.sim
	var p = v._placer
	var keep_path: String = p.save_path
	p.save_path = "user://smoke_fight_slots.tres"
	var saved0: Dictionary = RunView.saved_sites().duplicate(true)
	p.toggle()
	_check(v.placing and p.visible and v._figs.all(func(f): return f["state"] == "up"), "F3 didn't hold the fight with all three up")
	var run = main._run
	_check(not run._fight["track"].visible and not run._runner["track"].visible and not run._fight["head"].visible, "the bars and the head stayed over the frame while placing")
	var t0: float = sim.elapsed
	main._process(0.5)
	_check(is_equal_approx(sim.elapsed, t0), "the game ran on while placing")
	v._process(0.05)
	# a drag moves the middle one's feet by the drag
	var foot0: Vector2 = v.slot_of(0)["foot"]
	var r0: Rect2 = p.rect_of(0)
	var grab: Vector2 = r0.position + r0.size * Vector2(0.5, 0.3)
	p.press(grab)
	p.move(grab + Vector2(20, 6))
	p.release()
	_check(v.slot_of(0)["foot"] == foot0 + Vector2(20, 6), "a drag didn't move the middle one: %s from %s" % [str(v.slot_of(0)["foot"]), str(foot0)])
	# its corner sizes the near one, its feet kept
	var s1: Dictionary = v.slot_of(1).duplicate()
	var r1: Rect2 = p.rect_of(1)
	p.press(r1.end - Vector2(2, 2))
	p.move(r1.end - Vector2(2, 2) + Vector2(0, 30))
	p.release()
	_check(v.slot_of(1)["scale"] > s1["scale"] * 1.05 and v.slot_of(1)["foot"] == s1["foot"], "the corner didn't size the near one with its feet kept: %s" % str(v.slot_of(1)))
	v._process(0.05)
	var nr: TextureRect = v._figs[1]["rect"]
	_check(absf(nr.position.y + RunView.used_of(nr.texture).end.y * nr.scale.y - s1["foot"].y) < 1.5, "the near one isn't drawn where it's being put")
	# F5: the site's three saved, read from then on
	var want: Array = [v.slot_of(0).duplicate(), v.slot_of(1).duplicate(), v.slot_of(2).duplicate()]
	_check(p.save() == OK and FileAccess.file_exists(p.save_path), "F5 didn't save")
	var back = load(p.save_path)
	_check(back != null and back.sites.has(v.slot_key()) and is_equal_approx(float(back.sites[v.slot_key()][0][0]), want[0]["foot"].x), "the save doesn't hold the middle one: %s" % (str(back.sites) if back != null else "nothing"))
	p.toggle()
	_check(not v.placing and v.slot_of(0)["foot"] == want[0]["foot"] and is_equal_approx(v.slot_of(1)["scale"], snappedf(want[1]["scale"], 0.001)), "after F3 the view doesn't stand them where they were saved")
	main._process(0.1)
	_check(sim.elapsed > t0, "the game didn't run on after placing")
	# one bar at the frame's foot: your HP, or the search's in its place (14 Oct)
	_check(run._fight["track"].visible and run._fight["head"].visible and run._runner["track"].visible != is_equal_approx(run._fight["track"].position.y, run.OVER_Y), "the bars didn't come back after placing")
	# leaving the run screen while placing lets the tool go, and the game runs on (the review: a room click froze it)
	p.toggle()
	var room0: String = main.room
	main.show_room(main.ARMOURY)
	v._process(0.05)
	var t1: float = sim.elapsed
	main._process(0.2)
	_check(not v.placing and not p.visible and sim.elapsed > t1, "leaving the run screen kept the tool on and the game held")
	main.show_room(room0)
	# put it back: the real file untouched, the view on it again
	DirAccess.remove_absolute(ProjectSettings.globalize_path(p.save_path))
	p.save_path = keep_path
	RunView.use_saved(saved0)
	main.refresh()
	print("placement ok: F3 holds the fight, a drag moves, the corner sizes, F5 saves and the view reads it")


## The full art wired (13 Oct): each site its own plate and cover (else the Parade's test pair), the cover's drawn top on
## its line, the zone's gang, the head when he's out, the hands for the gun, feet on the slot.
func _full_art_checks(main, v) -> void:
	var sim = main.sim
	var own := 0
	for i in range(Data.TIERS.size()):
		var key: String = Items.slug(str(Data.TIERS[i]["name"]))
		_check(RunView.tex_of([key + "_plate", "parade_plate"]) != null and RunView.tex_of([key + "_cover", "parade_cover"]) != null, "%s has no plate or cover, its own or the test's" % key)
		if RunView.tex(key + "_plate") != null and RunView.tex(key + "_cover") != null:
			own += 1
	print("the run view: %d of %d sites have their own plate and cover" % [own, Data.TIERS.size()])
	# out on the site the check's on: its plate, its cover's top on the line
	var m: Dictionary = sim.mission
	var key0: String = Items.slug(str(Data.TIERS[int(m["tier"])]["name"]))
	_check(v._plate.texture == RunView.tex_of([key0 + "_plate", "parade_plate"]) and v._cover.texture == RunView.tex_of([key0 + "_cover", "parade_cover"]), "%s's plate or cover isn't up" % key0)
	_check(absf(v._cover_y + RunView.wall_top(v._cover.texture) * v._cover_s - RunView.COVER_TOP) < 0.5, "the cover's body isn't on its line: %.0f" % (v._cover_y + RunView.wall_top(v._cover.texture) * v._cover_s))
	# the zone's gang, when it's drawn
	var zone: String = RunView.ZONE_KEYS[int(Data.TIERS[int(m["tier"])]["zone"])]
	if RunView.tex("gang_%s_a_stand" % zone) != null:
		var ups: Array = v._figs.filter(func(f): return f["state"] in ["pop", "up"])
		_check(not ups.is_empty() and ups.all(func(f): return f["rect"].texture in [RunView.tex("gang_%s_a_stand" % zone), RunView.tex("gang_%s_b_stand" % zone), RunView.tex("gang_%s_a_fire" % zone), RunView.tex("gang_%s_b_fire" % zone)]), "the gang up isn't %s's" % zone)
	# feet on the slot: a figure that's up, not lifted or ducked, stands its drawn bottom on its foot
	v._duck = 0.0
	v._duck_t = 0.0
	v._duck_next = 99.0
	# every figure on you, so the frame keeps them all up: with fewer on you it steps the extra back unplaced (merge 47:
	# the dice left fewer on you than the figures)
	v._on_you = v._figs.size()
	for k in range(v._figs.size()):
		v._set_state(k, "up")
		v._figs[k]["kick_t"] = 0.0          # nor kicked by a hit just taken: its tilt moves the feet
	v._process(0.01)
	for k in range(v._figs.size()):
		var r: TextureRect = v._figs[k]["rect"]
		var u: Rect2 = RunView.used_of(r.texture)
		var sc: float = v.slot_of(k)["scale"]
		var feet: float = r.position.y + u.end.y * sc
		_check(absf(feet - (v.slot_of(k)["foot"].y - RunView.DUCK_SCENE * v._duck)) < 1.5, "figure %d's feet at %.0f, its slot's at %.0f" % [k, feet, v.slot_of(k)["foot"].y])
	# the head when he's out, if he's drawn
	for b in Data.BOSSES:
		var hk: String = Items.slug(str(b["name"]))
		if RunView.tex("head_%s_stand" % hk) == null:
			continue
		v._figs[0]["boss"] = hk
		_check(v._fig_tex(v._figs[0], "stand") == RunView.tex("head_%s_stand" % hk), "%s isn't drawn as himself" % b["name"])
	v._figs[0]["boss"] = ""
	v._boss_key = ""
	# the head coming out on the last kill: the one who falls falls as himself, the head pops up as the head; and when
	# the head's killed, he falls as the head (the review: the live key drew them as each other)
	var gk: String = str(Data.BOSSES[0]["name"])
	var hk0: String = Items.slug(gk)
	var had_boss: bool = m.has("boss")
	var boss0 = m.get("boss", null)
	for k in range(v._figs.size()):
		v._set_state(k, "")
	v._set_state(0, "up")
	m["boss"] = {"name": gk, "started": true, "alive": true, "hp": 1000.0}
	m["kills"] = int(m["kills"]) + 1
	main.refresh()
	var fell = v._figs.filter(func(f): return f["state"] == "down")
	_check(fell.size() == 1 and fell[0]["rect"].texture != RunView.tex("head_%s_down" % hk0), "the last of the gang fell as the head")
	for n in range(4):
		v._process(0.2)
	var ups2: Array = v._figs.filter(func(f): return f["state"] in ["pop", "up"])
	_check(ups2.size() == 1 and str(ups2[0].get("boss", "")) == hk0, "the head didn't come up as himself: %s" % str(ups2.map(func(f): return f.get("boss", ""))))
	if RunView.tex("head_%s_stand" % hk0) != null and not ups2.is_empty():
		_check(ups2[0]["rect"].texture in [RunView.tex("head_%s_stand" % hk0), RunView.tex("head_%s_fire" % hk0)], "the head is drawn as someone else")
	m["boss"]["alive"] = false
	m["kills"] = int(m["kills"]) + 1
	main.refresh()
	var fell2 = v._figs.filter(func(f): return f["state"] == "down" and str(f.get("boss", "")) == hk0)
	_check(fell2.size() == 1, "the head didn't fall")
	if RunView.tex("head_%s_down" % hk0) != null and fell2.size() == 1:
		_check(fell2[0]["rect"].texture == RunView.tex("head_%s_down" % hk0), "the head fell as one of the gang")
	if had_boss:
		m["boss"] = boss0
	else:
		m.erase("boss")
	main.refresh()
	# the hands for the gun: a shotgun's, and a hammer's or none
	var hold = sim.equipped["Primary"]
	for pair in [["Primary", "Farmer's shotgun", "shotgun"], ["Primary", "Claw hammer", "melee"]]:
		var g: Dictionary = sim._plain(pair[0], pair[1])
		if g.is_empty():
			continue
		sim.equipped["Primary"] = g
		main.refresh()
		var want: Texture2D = RunView.hands_tex(RunView.gun_in_hand(sim))     # its own picture, else its kind's (the kit, 17 Oct); the secondary's behind it dry
		if want != null:
			_check(v._hands.visible and v._hands.texture == want, "the %s's hands aren't up" % pair[1])
		elif pair[2] == "melee":
			_check(not v._hands.visible, "a revolver's hands show for the hammer")
	# every gun's hands in the corner: the drawn bottom-right on HANDS_CORNER (the review: a first gun on the fallback kept the old place)
	for gname in ["Army SMG", "Nail gun", "Sawn-off"]:
		var g2: Dictionary = sim._plain("Primary", gname)
		sim.equipped["Primary"] = g2
		main.refresh()
		v._recoil = 0.0
		v._duck = 0.0
		v._jolt = 0.0
		v._process(0.0)
		if v._hands.visible:
			var br: Vector2 = v._hands.position + RunView.used_of(v._hands.texture).end * v._hs
			_check(br.distance_to(RunView.HANDS_CORNER) < 1.5, "the %s's hands aren't in the corner: %s" % [gname, str(br)])
	# a melee swing (14 Oct, Matt: "the action just hangs"): the hammer's arm apart from the off hand, no hit as it winds
	# up, one on the chop with a streak behind it, the arm back where it was after; a gun keeps its kick
	var hammer: Dictionary = sim._plain("Primary", "Claw hammer")
	if not hammer.is_empty() and RunView.tex("hands_melee") != null:
		sim.equipped["Primary"] = hammer
		main.refresh()
		_check(v._melee and v._hand_r.visible and v._hand_l.visible and v._hands.self_modulate.a < 0.01, "the hammer's arm isn't apart from the off hand")
		# where it's drawn, not just its position: in the corner, and the weapon's tip in frame (Matt, 14 Oct: off the right)
		v._recoil = 0.0
		v._jolt = 0.0
		v._duck = 0.0
		v._swing = -1.0
		v._stop_t = 0.0                  # no hit-stop left over from the last hit (27 Oct)
		v._process(0.0)
		var drawn_br: Vector2 = v._hands.get_transform() * RunView.used_of(v._hands.texture).end
		_check(drawn_br.distance_to(RunView.HANDS_CORNER) < 1.5, "the hammer's hands aren't drawn in the corner: %s" % str(drawn_br))
		var tip0: Vector2 = v.tip_point()
		_check(tip0.x <= RunView.W - 12.0 and tip0.y >= 0.0, "the hammer's head is out of frame at rest: %s" % str(tip0))
		var shots := [0]
		var count := func(_at): shots[0] += 1
		v.shot_fired.connect(count)
		v._duck = 0.0
		v._duck_t = 0.0
		v._duck_next = 99.0
		v._firing = true
		v._figs[0]["state"] = "up"
		v._swing = -1.0
		v._stop_t = 0.0                  # no hit-stop left over from the last hit (27 Oct)
		v._shot_t = 0.0
		v._process(0.01)
		_check(v._swing >= 0.0 and shots[0] == 0, "the swing hit as it began, or never began")
		var sl: float = v._swing_len
		v._process(sl * RunView.SWING_UP - 0.01)
		_check(v._hand_r.rotation > 0.1 and shots[0] == 0, "no wind-up before the chop: %.2f" % v._hand_r.rotation)
		_check(v.tip_point().x <= RunView.W - 12.0 and v.tip_point().y >= 0.0, "the hammer's head leaves the frame winding up: %s" % str(v.tip_point()))
		v._process(sl * (RunView.SWING_CONTACT - RunView.SWING_UP))
		_check(shots[0] == 1 and v._hand_r.rotation < -0.2, "the chop didn't land once, forward: %d hits, %.2f" % [shots[0], v._hand_r.rotation])
		_check(v.tip_point().x <= RunView.W - 12.0 and v.tip_point().x >= 0.0, "the hammer's head is out of frame on the chop: %s" % str(v.tip_point()))
		_check(not v._trail.is_empty(), "no streak behind the chop")
		v._shot_t = 99.0
		v._process(sl)
		_check(v._swing < 0.0 and is_zero_approx(v._hand_r.rotation) and v._swing_off == Vector2.ZERO and shots[0] == 1, "the arm didn't settle back after the swing")
		# down behind the wall mid-swing: no hit on the chop
		v._shot_t = 0.0
		v._process(0.01)
		v._duck = 1.0
		v._duck_t = 5.0
		v._process(sl)
		_check(shots[0] == 1, "a swing landed with the hands down behind the wall")
		v._duck = 0.0
		v._duck_t = 0.0
		v.shot_fired.disconnect(count)
		var gun3: Dictionary = sim._plain("Primary", "Farmer's shotgun")
		if not gun3.is_empty():
			var sec_was = sim.equipped["Secondary"]
			sim.equipped["Secondary"] = null     # a dry gun shows the secondary's hands (gun_in_hand): none, so the gun's (17 Oct, the flake)
			sim.equipped["Primary"] = gun3
			main.refresh()
			_check(not v._melee and not v._hand_r.visible and v._hands.self_modulate.a > 0.99 and is_zero_approx(v._hands.rotation), "a gun kept the hammer's swing parts")
			sim.equipped["Secondary"] = sec_was
	sim.equipped["Primary"] = hold
	main.refresh()


## The Yard as lanes (9 Oct, docs/design/yard.md): eight buildings, five columns of two picks and a rank; a tile
## picks, the strip builds; the other side stays on show and refits for half; the columns open on the campaign
## and the depth and stay open; the rank at depth 9; the rail's Upgrade badge; every pick's figure where it lives;
## salvage from the deep sites; the buildings move with the Yard.
func _yard_wide_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	main.show_room(main.OVERVIEW)
	main.refresh()
	var yt = main._yard_tree
	_check(yt.visible and not main._grid.visible, "the Pitch is not the lanes alone")
	# every pick its own glyph, and no column's two the same (Lanes-G, the review)
	for bld in Data.YARD:
		for col in bld["picks"]:
			_check(NodeGlyphs.PICK_GLYPH.has(col[0]["id"]) and NodeGlyphs.PICK_GLYPH.has(col[1]["id"]), "a Yard pick has no glyph of its own: %s / %s" % [col[0]["id"], col[1]["id"]])
			_check(NodeGlyphs.of_pick(col[0], bld["key"]) != NodeGlyphs.of_pick(col[1], bld["key"]), "%s's %s and %s share a glyph" % [bld["name"], col[0]["name"], col[1]["name"]])
			for pk in col:
				_check(NodeGlyphs.SVG.has(NodeGlyphs.of_pick(pk, bld["key"])), "%s's glyph is not drawn: %s" % [pk["name"], NodeGlyphs.of_pick(pk, bld["key"])])
	# two lines a building (28 Oct): eight cards, each building two named lines of five, its detail inside the room
	_check(yt.cards.size() == Data.YARD.size() and Data.YARD.all(func(b): return b["lines"].size() == 2 and b["picks"].size() == 5), "the Pitch's cards or lines are off: %d cards" % yt.cards.size())
	_check(yt._detail.position.y + yt._detail.size.y <= yt.size.y + 0.5 and yt._build.position.y + yt._build.size.y <= yt._detail.size.y and yt._tiles[1][4]["button"].position.y + yt._tiles[1][4]["button"].size.y <= yt._rank.position.y, "the Pitch's detail runs past the room, or its tiles into the rank")
	# a fresh Yard: column 1 open, the rest shut with their gates; nothing affordable with no cash
	sim.yard_picks = {}
	sim.yard_ranks = {}
	sim.yard_open = 1
	sim.yard_seen = {}
	sim.yard_seen_cols = 1
	sim._yard_changed("")
	var cash0: float = sim.cash
	sim.cash = 0.0
	yt.selected = {}
	yt._shown = ""
	main.refresh()
	_check(sim.yard_cols() >= 1 and yt.tile("bench", 0, "a")["look"] == "open" and (sim.yard_cols() > 1 or yt.tile("bench", 1, "a")["look"] == "shut"), "the fresh Yard's columns are off: %d open, %s / %s" % [sim.yard_cols(), yt.tile("bench", 0, "a")["look"], yt.tile("bench", 1, "a")["look"]])
	_check(main._rail_status(main.OVERVIEW).get("badge", "") == "", "the rail's Upgrade badge is lit with no cash")
	_check(sim.yard_pick_block("bench", 0, "a") == "Short of tins", "a pick with no cash: '%s'" % sim.yard_pick_block("bench", 0, "a"))
	_check(sim.yard_pick_block("bench", 5 - 1, "a") == Data.yard_gate(4) or sim.yard_cols() >= 5, "a shut column's block is not its gate: '%s'" % sim.yard_pick_block("bench", 4, "a"))
	# pick, build, the other side dim, a refit for half; the badge is news only (9 Oct): lit for what's newly
	# buyable or a column opened since the Yard was looked at, cleared by looking
	main.show_room(main.MISSIONS)
	sim.cash = 1000000.0
	main.refresh()
	_check(main._rail_status(main.OVERVIEW).get("badge", "") == "Can build", "the rail's Upgrade badge is not lit with a pick newly affordable")
	main.show_room(main.OVERVIEW)
	_check(main._rail_status(main.OVERVIEW).get("badge", "") == "" and not main._rail_buttons[main.OVERVIEW]._badge.visible, "looking at the Pitch did not clear the badge (as drawn: %s)" % str(main._rail_buttons[main.OVERVIEW]._badge.visible))
	var seen_n: int = sim.yard_seen.size()
	var rt: Dictionary = sim.to_dict()
	sim.yard_seen = {}
	sim.load_dict(rt)
	_check(sim.yard_seen.size() == seen_n and seen_n > 0 and sim.yard_seen_cols == sim.yard_cols(), "what the badge has seen did not survive a save: %d of %d" % [sim.yard_seen.size(), seen_n])
	main.show_room(main.MISSIONS)
	sim.cash = 0.0
	main.refresh()
	sim.cash = 1000000.0
	main.refresh()
	_check(main._rail_status(main.OVERVIEW).get("badge", "") == "", "the badge lit again for picks already seen")
	sim.hp = sim.max_hp()
	sim.deploy(3)
	_check(sim.on_mission() and not sim._yard_buyable_ids().is_empty(), "with the runner out, the Pitch reads nothing buyable for the badge")
	if sim.on_mission():
		sim._extract()
	sim.yard_open = sim.yard_cols() + 1
	_check(main._rail_status(main.OVERVIEW).get("badge", "") == "Can build", "a column opened did not light the badge")
	sim.yard_open = 1
	sim.yard_seen_cols = 1
	main.show_room(main.OVERVIEW)
	yt._press("kennel", 0, "a")
	main.refresh()
	_check(yt._title.visible and yt._title.text.begins_with("A dog") and yt._build.text.begins_with("Build (") and yt._build.text.contains(Fmt.money(sim.yard_pick_cost("kennel", 0))) and not yt._build.disabled, "the strip does not offer A dog with its price: '%s' / '%s'" % [yt._title.text, yt._build.text])
	_check_fit(main, "Yard (a pick picked)")
	var c1: int = sim.yard_pick_cost("kennel", 0)
	var cash1: float = sim.cash
	yt._on_build()
	main.refresh()
	_check(sim.yard_has("a_dog") and is_equal_approx(sim.cash, cash1 - c1) and yt.tile("kennel", 0, "a")["look"] == "built" and yt.tile("kennel", 0, "b")["look"] == "other", "Build did not build A dog: %s, £%.0f" % [str(sim.yard_picks.get("kennel", [])), cash1 - sim.cash])
	_check(yt._build.text == "Built" and yt._build.disabled, "a built pick still offers a build")
	# its other side (24 Oct, Matt: option B - nothing locks): open at 2.5 times, both built after, the strip saying so
	yt._press("kennel", 0, "b")
	main.refresh()
	var c2: int = sim.yard_pick_cost("kennel", 0)     # both rounded to the 100 (_round_price): c1's rounding times 2.5 and c2's own, 175 at most (BUILD49-W: the camp at 2,700 read 6,600)
	_check(yt._build.text.begins_with("Build (") and yt._build.text.contains(Fmt.money(c2)) and absi(c2 - int(round(c1 * Data.YARD_SECOND))) <= 200 and yt._other.text.to_lower().contains("is built · this one costs ×2.5"), "the other side isn't offered at 2.5 times: '%s', '%s', %d from %d" % [yt._build.text, yt._other.text, c2, c1])
	_check_fit(main, "Yard (a column's other side)")
	sim.cash = maxf(sim.cash, float(c2) + 10.0)
	var cash2: float = sim.cash
	yt._on_build()
	main.refresh()
	_check(sim.yard_has("good_nose") and sim.yard_has("a_dog") and sim.yard_side("kennel", 0) == "ab" and is_equal_approx(sim.cash, cash2 - c2) and yt.tile("kennel", 0, "b")["look"] == "built" and yt.tile("kennel", 0, "a")["look"] == "built", "the other side didn't build beside the first: %s" % str(sim.yard_picks.get("kennel", [])))
	_check(sim.yard_pick_block("kennel", 0, "a") == "Built" and sim.yard_pick_block("kennel", 0, "b") == "Built" and yt._build.text == "Built" and yt._build.disabled, "a column with both sides built still offers a build")
	_check(not sim._yard_buyable_ids().any(func(x): return str(x).begins_with("kennel/0")), "a full column still counts as buyable")
	_check_fit(main, "Yard (both sides built)")
	# the columns open on the campaign and the depth, and stay open
	sim.best_dig = {}
	for i in range(sim.depth.size()):
		sim.depth[i] = 1
		sim.best_depth[i] = 0
	sim.yard_open = 0
	_finish_campaign(sim)
	_check(sim.yard_cols() == 4, "the campaign done opens %d columns, not four" % sim.yard_cols())
	sim.best_dig = {"site": "The Streets", "depth": 9, "yard": 1}
	_check(sim.yard_cols() == Data.YARD_COLS, "depth 9 does not open every column")
	sim.best_dig = {}
	for i in range(sim.depth.size()):
		sim.depth[i] = 1
		sim.best_depth[i] = 0
	_check(sim.yard_cols() == Data.YARD_COLS, "the columns closed again when the depth went")
	# the fifth column and the rank want salvage (a line's first four built: it climbs in order, 28 Oct)
	sim.yard_picks["stash"] = ["ab", "ab", "ab", "ab", ""]
	sim._yard_changed("stash")
	sim.salvage = {"copper": 0, "steel": 0, "army": 0}
	_check(sim.yard_pick_block("stash", 4, "a").begins_with("Wants 10 copper"), "column five without salvage: '%s'" % sim.yard_pick_block("stash", 4, "a"))
	sim.salvage["copper"] = 40
	var r0: int = sim.yard_rank_cost("stash")
	_check(sim.yard_pick("stash", 4, "b") and sim.salvage["copper"] == 30 and sim.buy_yard_rank("stash") and sim.yard_rank("stash") == 1 and sim.salvage["copper"] == 25, "the salvage did not pay: %s" % str(sim.salvage))
	_check(sim.yard_rank_cost("stash") > r0 and sim.yard_rank_salvage("stash") == Data.YARD_RANK_SALVAGE + 1, "the rank's price did not climb")
	var rk_keep: int = sim.yard_rank("stash")
	sim.yard_ranks["stash"] = Data.YARD_RANK_SALVAGE_TO
	_check(sim.yard_rank_salvage("stash") == 0 and sim.yard_rank_cost("stash") > r0, "a rank past the fifth still wants salvage (24 Oct: tins alone): %d" % sim.yard_rank_salvage("stash"))
	yt._press_rank("stash")
	yt._shown = ""
	main.refresh()
	_check(not yt._other.text.contains("salvage") and not yt._other.text.contains(" copper") and yt._other.text.contains(Fmt.money(sim.yard_rank_cost("stash"))), "the rank strip past the fifth still asks salvage: '%s'" % yt._other.text)
	sim.yard_ranks["stash"] = rk_keep
	yt._press_rank("stash")
	yt._shown = ""
	main.refresh()
	_check(yt._build.text == "Buy (%s)" % Fmt.money(sim.yard_rank_cost("stash")) and yt._title.text.to_lower().contains("rank 1"), "the rank's strip is off: '%s' / '%s'" % [yt._title.text, yt._build.text])
	_check_fit(main, "Yard (a rank)")
	# every buy button on the Pitch says what it costs (24 Oct, Matt: "the buy button doesn't list the cost"): each
	# building's rank and its first column's unbuilt side, in tins
	for yb in Data.YARD:
		yt._press_rank(str(yb["key"]))
		yt._shown = ""
		main.refresh()
		_check((yt._build.text.contains(Fmt.money(sim.yard_rank_cost(str(yb["key"])))) or yt._build.text.contains(Fmt.money_k(sim.yard_rank_cost(str(yb["key"]))))), "%s's rank button has no price: '%s'" % [yb["key"], yt._build.text])
		_check(UI.text_width(yt._build, yt._build.text) + 32.0 <= yt._build.size.x, "%s's rank button runs past its edge: '%s'" % [yb["key"], yt._build.text])
		# each line's next step its price, and every step after it inside its button (28 Oct, the tools review: column 0
		# alone, and the stash's skipped silently once its first column was built)
		for yside in ["a", "b"]:
			var nxt: int = Bot._next_step(sim, yb, yside)
			for c in range(mini(sim.yard_cols(), yb["picks"].size())):
				if sim.yard_built_side(str(yb["key"]), c, yside):
					continue
				yt._press(str(yb["key"]), c, yside)
				yt._shown = ""
				main.refresh()
				if c == nxt:
					_check((yt._build.text.contains(Fmt.money(sim.yard_pick_cost(str(yb["key"]), c))) or yt._build.text.contains(Fmt.money_k(sim.yard_pick_cost(str(yb["key"]), c)))), "%s's line %s step %d build button has no price: '%s'" % [yb["key"], yside, c + 1, yt._build.text])
				_check(UI.text_width(yt._build, yt._build.text) + 32.0 <= yt._build.size.x, "%s's line %s step %d button runs past its edge: '%s'" % [yb["key"], yside, c + 1, yt._build.text])
			_check(nxt != 0 or not sim.yard_built_side(str(yb["key"]), 0, yside), "the fixture: %s's next step read wrong" % yb["key"])
	yt.selected = {}
	sim.cash = cash0
	yt._shown = ""
	main.refresh()
	_check(yt._headline.text == "%d of %d" % [sim.yard_built(), sim.yard_steps()] and yt._unit.text == "upgrades built", "the Pitch's headline is off: '%s' %s" % [yt._headline.text, yt._unit.text])
	_check(yt._chips.shown() == 6 and yt._chips._labels[0].text.begins_with(Fmt.money(sim.cash)), "the Pitch's purse chips are off: %d shown, first '%s'" % [yt._chips.shown(), yt._chips._labels[0].text])
	# the purse down the left under the title (Matt, 10 Oct): below the headline, inside the title's width and the band,
	# clear of Move; every chip shown with the most salvage the Yard can hold
	var yc := Rect2(yt._chips.position, yt._chips.size)
	_check(yc.position.y >= yt._headline.position.y + yt._headline.size.y and yc.end.x <= yt.PAD + 350 and yc.end.y <= yt.HEAD_H - 8, "the Pitch's purse is not down the left under the title: %s" % str(yc))
	var salv_was: Dictionary = sim.salvage.duplicate()
	var cash_was: float = sim.cash
	var notes_was: int = sim.notes
	var scrap_was: int = sim.scrap
	for kind in Data.SALVAGE:
		sim.salvage[kind] = 99999
	sim.cash = 99999999.0
	sim.notes = 999999
	sim.scrap = 999999
	yt._shown = ""
	main.refresh()
	yc = Rect2(yt._chips.position, yt._chips.size)
	_check(yt._chips.shown() == 6 and yc.end.y <= yt.HEAD_H - 8 and yc.end.x <= yt.PAD + 350, "the Pitch's purse loses a chip or leaves the band at the most: %d shown, %s" % [yt._chips.shown(), str(yc)])
	sim.salvage = salv_was
	sim.cash = cash_was
	sim.notes = notes_was
	sim.scrap = scrap_was
	yt._shown = ""
	main.refresh()
	_check_fit(main, "Yard (lanes)")
	sim.load_dict(saved)
	main.refresh()
	_yard_pick_checks(main)


## Every pick's figure where it lives (9 Oct): each set straight in, read, set back.
func _yard_pick_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.yard_picks = {}
	sim.yard_ranks = {}
	sim._yard_changed("")
	var on := func(pair: Array, id: String) -> void:
		_yard_ids(sim, pair, id)
	# the Bench
	var it: Dictionary = sim._plain("Helmet", "Hard hat")
	it["affixes"] = [{"stat": "hp", "value": 5, "tier": 1}]
	it["rarity"] = 1
	var reroll0: int = sim.craft_cost(it, "affixes")
	on.call(["steady_hands", "cheap_parts"], "cheap_parts")
	_check(sim.craft_cost(it, "affixes") == int(round(sim._inf(int(Data.CRAFT["affixes"]["cash"]) * Items.ilvl(it) * 2) * 0.75)) or sim.craft_cost(it, "affixes") < reroll0, "Cheap parts did not take a quarter off: %d from %d" % [sim.craft_cost(it, "affixes"), reroll0])
	on.call(["third_socket", "two_locks"], "two_locks")
	_check(sim.lock_max() == Data.LOCKS + 1, "Two locks didn't give a second padlock: %d" % sim.lock_max())     # 20 Oct
	on.call(["third_socket", "two_locks"], "third_socket")
	on.call(["overbump", "fine_tuning"], "overbump")
	_check(sim.socket_max() == Data.SOCKET_MAX + 1 and sim.bump_levels() == Data.BUMP_LEVELS * 2, "Third socket or Overbump is off")
	sim.yard_ranks["bench"] = 2
	_check(sim.bump_cap() == Data.BUMP_CAP + 2, "the Bench's rank does not raise the cap")
	sim.yard_ranks = {}
	var scrap0: int = sim.scrap_of(it)
	on.call(["gunsmith", "strip_for_parts"], "strip_for_parts")
	_check(sim.scrap_of(it) == scrap0 * 2, "Strip for parts did not double the scrap")
	var rng := RandomNumberGenerator.new()
	rng.seed = 7
	var t3: Dictionary = sim._plain("Helmet", "Hard hat")
	t3["rarity"] = 4
	var down := false
	for k in range(300):
		t3["affixes"] = [{"stat": "hp", "value": 20, "tier": 3}]
		Items.reroll_one(t3, "hp", rng, 1.0, true)
		down = down or int(t3["affixes"][0]["tier"]) < 3
	_check(not down, "Fine tuning let a re-roll go down a tier")
	var aff: Dictionary = Items.affix_def("hp")
	var rr: Array = Items.tier_range(aff, 2)
	var low := false
	for k in range(200):
		low = low or Items.roll_affix(aff, 1, rng, 2, 0, true)["value"] < int(ceil((rr[0] + rr[1]) / 2.0))
	_check(not low, "Masterwork rolled in the bottom half")
	var two: Dictionary = sim._plain("Armour", Data.BASES["Armour"][0]["name"])
	two["rarity"] = 3
	two["affixes"] = [{"stat": "hp", "value": 5, "tier": 1}, {"stat": "armour_pct", "value": 30, "tier": 3}, {"stat": "rest_pct", "value": 5, "tier": 1}]
	Items.reroll_affixes(two, rng, ["hp", "armour_pct"], false)     # two padlocks (20 Oct: Two locks is the second)
	_check(two["affixes"].size() == 3 and two["affixes"].any(func(a): return a["stat"] == "armour_pct" and int(a["value"]) == 30) and two["affixes"].any(func(a): return a["stat"] == "hp" and int(a["value"]) == 5), "two padlocks didn't keep both: %s" % str(two["affixes"]))
	# the Stash
	var cap0: int = sim.stash_cap()
	on.call(["shelving", "racks"], "shelving")
	on.call(["another_unit", "bins"], "another_unit")
	on.call(["lock_up", "filing_cabinet"], "lock_up")
	on.call(["dry_store", "annex"], "annex")
	sim.yard_ranks["stash"] = 1
	_check(sim.stash_cap() == cap0 + 40 + 50 + 60 + 100 + 20, "the Stash's cells are off: %d from %d" % [sim.stash_cap(), cap0])
	sim.yard_ranks = {}
	var yt = main._yard_tree
	yt.selected = {}
	on.call(["shelving", "racks"], "racks")
	on.call(["strongroom", "wall_of_fame"], "wall_of_fame")
	on.call(["lock_up", "filing_cabinet"], "filing_cabinet")
	_check(sim.stash_free(sim._plain(Data.AMMO, "Nails")) and sim.stash_free(Items.roll_unique(Data.UNIQUES[0], sim.rng)) and not sim.stash_free(sim._plain(Data.PAPER, "A P45")) and not sim.stash_free(it) and sim.yard_has("filing_cabinet"), "Racks or Wall of fame is off, or the Filing cabinet still frees a paper")
	on.call(["another_unit", "bins"], "bins")
	var junk: Dictionary = sim._plain("Helmet", "Army helmet")     # worth a pound of scrap or more (a hard hat's £20 is under 24, 12 Oct)
	junk["rarity"] = 0
	junk["affixes"] = []
	var sc0: int = sim.scrap
	var binned: Array = sim._bin_commons([junk, sim._plain(Data.AMMO, "Nails")])
	_check(binned.size() == 1 and not binned.has(junk) and sim.scrap > sc0, "Bins did not scrap the commons: %d kept" % binned.size())
	var ins0: int = sim.insure_cost(3)
	on.call(["strongroom", "wall_of_fame"], "strongroom")
	_check(sim.insure_cost(3) <= int(ceil(ins0 / 2.0 / 10.0)) * 10 + 10, "Strongroom did not halve insurance: %d from %d" % [sim.insure_cost(3), ins0])
	# the Clinic
	var rest0: float = sim.rest_rate()
	on.call(["beds", "shelf"], "beds")
	on.call(["ward", "stockroom"], "ward")
	_check(is_equal_approx(sim.rest_rate(), rest0 * (Data.REST_BASE + 1.5) / Data.REST_BASE), "Beds and Ward are off: %.2f from %.2f" % [sim.rest_rate(), rest0])
	on.call(["beds", "shelf"], "shelf")
	on.call(["ward", "stockroom"], "stockroom")
	_check(sim.clinic_stock() == Data.CLINIC_STOCK + 10, "Shelf and Stockroom are off: %d" % sim.clinic_stock())
	sim.wounds = {"legs": {"stat": "pace", "what": "a bad ankle", "from": "The Parade", "hp_pct": 20}}
	var wc0: int = sim.wound_cost()
	var wm0: float = sim.wound_mult("pace")
	on.call(["surgery", "physio"], "surgery")
	_check(sim.wound_cost() <= int(ceil(wc0 / 2.0)) + 1, "Surgery did not halve the wound's price")
	on.call(["surgery", "physio"], "physio")
	_check(sim.wound_mult("pace") > wm0, "Physio did not lighten the wound")
	sim.wounds = {}
	on.call(["drip", "field_kit"], "field_kit")
	var bandages := func() -> int: return sim.rig.filter(func(x): return str(x.get("base", "")) == "Bandage").size()
	var room_k: bool = sim.rig_room(1)
	var bn0: int = bandages.call()
	sim.hp = sim.max_hp()
	sim.deploy(3)
	_check(not room_k or bandages.call() == bn0 + 1, "the Field kit did not put a bandage in the rig")
	sim.extract_now()
	var hp0: float = sim.max_hp()
	on.call(["theatre", "med_lab"], "theatre")
	sim.yard_ranks["clinic"] = 2
	_check(is_equal_approx(sim.max_hp(), hp0 * 1.16), "Theatre and the Clinic's rank are off: %.1f from %.1f" % [sim.max_hp(), hp0])
	sim.yard_ranks = {}
	# the Fence
	var stock0: int = sim.market_stock()
	var words0: Array = sim.words.duplicate(true)
	var shelf0: Array = sim.market.duplicate(true)
	on.call(["stall", "haggling"], "stall")
	_check(sim.words == words0 and sim.market.slice(0, shelf0.size()) == shelf0 and sim.market.size() == shelf0.size() + 2, "a Fence pick re-rolled the words or the shelf: %d from %d" % [sim.market.size(), shelf0.size()])
	on.call(["shopfront", "contacts"], "shopfront")
	_check(sim.market_stock() == stock0 + 5 and sim.market.size() >= sim.market_stock(), "Stall and Shopfront are off: %d, %d on the shelf" % [sim.market_stock(), sim.market.size()])
	var sp0: int = sim.sell_price(it)
	on.call(["stall", "haggling"], "haggling")
	on.call(["arms_dealer", "dealers_cut"], "dealers_cut")
	sim.yard_ranks["fence"] = 1
	_check(sim.sell_price(it) > sp0 and absi(sim.sell_price(it) - int(round(sp0 * 1.37))) <= 2, "Haggling, Dealer's cut and the rank are off: %d from %d" % [sim.sell_price(it), sp0])
	sim.yard_ranks = {}
	on.call(["shopfront", "contacts"], "contacts")
	_check(is_equal_approx(sim.exchange_spread(), Data.FX["yard/contacts"]), "Contacts did not narrow the exchange's spread: %.2f" % sim.exchange_spread())     # the exchange (28 Oct): was Orders
	# a build never refills a shelf bought from
	sim.market = sim.market.slice(0, 1)
	on.call(["back_room", "fixer"], "fixer")
	_check(sim.market.size() == 1, "a build refilled the Fence's shelf: %d on it" % sim.market.size())
	_check(is_equal_approx(sim.exchange_fixer(), Data.FX["yard/fixer"]), "the Fixer did not add to the exchange: %.2f" % sim.exchange_fixer())
	on.call(["shopfront", "contacts"], "shopfront")
	_check(is_equal_approx(sim.exchange_spread(), Data.EXCHANGE_SPREAD), "the refit off Contacts left the spread at %.2f" % sim.exchange_spread())
	on.call(["back_room", "fixer"], "back_room")
	_check(sim.market.any(func(x): return x.has("unique")), "the Back room has no unique on the shelf")
	var g0: int = sim.gamble_price(Data.GAMBLE_KINDS[0]["kind"])
	on.call(["gamblers_table", "insurance_desk"], "gamblers_table")
	_check(g0 <= 0 or absi(sim.gamble_price(Data.GAMBLE_KINDS[0]["kind"]) - int(round(g0 * 0.5))) <= 1, "the Gambler's table did not halve the gamble")
	# the Radio (9 Oct, map juicing): the sky's two columns, then the words'
	var hold_elapsed: float = sim.elapsed
	var hold_weather: Array = sim.weather.duplicate()
	sim.elapsed = 3600.0 * 3.0                       # noon
	sim.weather[1] = "Rain"
	var rain0: Dictionary = sim.effective(3)
	on.call(["weather_set", "night_set"], "weather_set")
	var rain1: Dictionary = sim.effective(3)
	_check(is_equal_approx(rain1["search"], rain0["search"] / 1.3 * 1.15), "the Weather set did not halve the rain: %.3f from %.3f" % [rain1["search"], rain0["search"]])
	on.call(["forecast", "dead_air"], "forecast")
	_check(is_equal_approx(sim.effective(3)["cash"], rain1["cash"] * 1.2), "the forecast did not pay a fifth more under the rain")
	sim.weather[1] = ""
	sim.elapsed = 3600.0 * 14.0                      # 23:00
	var night0: Dictionary = sim.effective(3)
	on.call(["weather_set", "night_set"], "night_set")
	_check(sim.is_night() and is_equal_approx(sim.effective(3)["pace"], night0["pace"] / 0.8 * 0.9), "the Night set did not halve night's feet: %.3f from %.3f" % [sim.effective(3)["pace"], night0["pace"]])
	var patrol_n: float = sim.effective(3)["patrol"]
	on.call(["forecast", "dead_air"], "dead_air")
	_check(is_equal_approx(sim.effective(3)["patrol"], patrol_n * 1.25), "Dead air did not slow the night's gangs")
	sim.elapsed = hold_elapsed
	sim.weather = hold_weather
	_finish_campaign(sim)
	sim.atlas = {}
	sim.best_depth[3] = maxi(sim.best_depth[3], 9)
	sim.set_depth(3, 9)
	sim.words[3] = []
	sim.sealed[3] = false
	sim.notes = 100000
	var rc0: int = sim.word_craft_cost(3, "retune")
	on.call(["scanner", "two_channels"], "scanner")
	_check(sim.word_craft_cost(3, "retune") == maxi(1, int(ceil(18.0 * 0.75))) and rc0 == 18, "the Scanner did not take a quarter off: %d from %d" % [sim.word_craft_cost(3, "retune"), rc0])
	on.call(["scanner", "two_channels"], "two_channels")
	_check(sim.word_craft(3, "tune") and sim.words[3].size() == 1, "Tune in with Two channels did not add one word: %s" % str(sim.words[3]))
	var mw0: int = sim.max_words(3)
	on.call(["lorry_watch", "long_range"], "lorry_watch")
	_check(sim.yard_has("lorry_watch") and float(Data.FX["yard/lorry_watch"]) == 2.0, "Lorry watch isn't on, or isn't twice Kev's papers")     # 15 Oct
	on.call(["lorry_watch", "long_range"], "long_range")
	_check(sim.max_words(3) == mw0 + 1 and mw0 == 4, "Long range did not add a word: %d from %d" % [sim.max_words(3), mw0])
	sim.words[3] = []
	_check(sim.word_craft(3, "broadcast") and sim.words[3].size() == 5, "a broadcast with Long range did not fill five: %s" % str(sim.words[3]))
	on.call(["jammer", "military_band"], "jammer")
	var jw: Dictionary = sim.word_effect("Numbers", 1)
	_check(is_equal_approx(float(jw["hp"]), sqrt(1.4)) and is_equal_approx(float(jw["drop"]), 1.3), "the Jammer's word is off: %s" % str(jw))
	on.call(["jammer", "military_band"], "military_band")
	var mw: Dictionary = sim.word_effect("Numbers", 1)
	_check(is_equal_approx(float(mw["drop"]), 1.45) and is_equal_approx(float(mw["hp"]), 1.4), "the Military band's word is off: %s" % str(mw))
	sim.yard_ranks["radio"] = 2
	_check(is_equal_approx(float(sim.word_effect("Numbers", 1)["drop"]), 1.0 + 0.3 * 1.6), "the Radio's rank did not add to the pay")
	sim.yard_ranks = {}
	sim.words[3] = []
	# the Generator (24 Oct, milestone 8: energy where the time away was): each pick's figure, and the rank's
	_check(sim.generator_max_energy() == 0.0 and sim.generator_energy_regen() == 0.0 and sim.generator_kill_energy() == 0.0 and sim.generator_cooldown_pct() == 0.0 and not sim.generator_first_free(), "the Generator gives energy unbuilt")
	on.call(["jerry_can", "rig_wiring"], "jerry_can")
	_check(is_equal_approx(sim.generator_max_energy(), 10.0), "the Jerry can is not +10 max energy: %.1f" % sim.generator_max_energy())
	on.call(["dynamo", "floodlights"], "dynamo")
	_check(is_equal_approx(sim.generator_energy_regen(), 0.5), "the Dynamo is not +0.5 energy a second: %.2f" % sim.generator_energy_regen())
	on.call(["battery", "kickback"], "kickback")
	_check(is_equal_approx(sim.generator_kill_energy(), 5.0), "Kickback is not 5 energy a kill: %.1f" % sim.generator_kill_energy())
	on.call(["flywheel", "arc_lamps"], "flywheel")
	_check(is_equal_approx(sim.generator_cooldown_pct(), 5.0), "the Flywheel is not 5%% shorter cooldowns: %.1f" % sim.generator_cooldown_pct())
	on.call(["pilot_light", "charger"], "pilot_light")
	_check(sim.generator_first_free(), "the Pilot light does not make the first skill free")
	sim.yard_ranks["generator"] = 3
	_check(is_equal_approx(sim.generator_max_energy(), 16.0), "the Generator's rank is not +2 max energy a rank: %.1f" % sim.generator_max_energy())
	sim.yard_ranks = {}
	# no pick or rank on the Pitch reads time away (24 Oct, Matt: the offline nodes go)
	for yb in Data.YARD:
		var yb_lines: Array = [str(yb.get("rank", {}).get("words", "")), str(yb.get("rank", {}).get("short", ""))]
		for col in yb["picks"]:
			for pk in col:
				yb_lines.append_array([str(pk["words"]), str(pk["short"])])
		_check(not yb_lines.any(func(w): return w.to_lower().contains("away")), "%s still reads time away: %s" % [yb["key"], str(yb_lines.filter(func(w): return w.to_lower().contains("away")))])
	var fire0: float = sim.more("fire")
	on.call(["flywheel", "arc_lamps"], "arc_lamps")
	_check(is_equal_approx(sim.more("fire"), fire0 * 1.1), "Arc lamps did not add a tenth to fire")
	on.call(["pilot_light", "charger"], "charger")
	sim.hp = sim.max_hp() * 0.4
	sim.deploy(3)
	_check(is_equal_approx(sim.hp, sim.max_hp()), "the Charger did not send the run out full")
	sim.extract_now()
	# the Lookout
	var first0: float = sim.patrol_s(sim.effective(3), true)
	on.call(["spotter", "glasses"], "spotter")
	on.call(["lookout_post", "range_cards"], "lookout_post")
	_check(is_equal_approx(sim.patrol_s(sim.effective(3), true), first0 * 2.0), "Spotter and Lookout post are off: %.1f from %.1f" % [sim.patrol_s(sim.effective(3), true), first0])
	on.call(["spotter", "glasses"], "glasses")
	_check(sim.odds_runs() == 60, "Glasses did not read sixty runs")
	var later0: float = sim.patrol_s(sim.effective(3))
