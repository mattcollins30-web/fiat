var _misfits := 0
var _fails := 0


## A failed assert would end _init before quit() and leave the process hanging;
## this logs and counts instead, and the end exits 1.
func _check(ok: bool, msg: String) -> void:
	if not ok:
		push_error("CHECK FAILED: " + msg)
		_fails += 1


## A Yard pick set straight in (9 Oct): for the checks that set the Yard up rather than buy it. By id (31 Oct, the clean-up:
## the old columns' table went): `pair`'s picks taken off, then `on` put on where it stands now ("" none).
func _yard_ids(s, pair: Array, on: String) -> void:
	var before: Dictionary = s._yard_before()
	for id in pair + ([on] if on != "" else []):
		var at: Array = Data.yard_where(str(id))
		_check(not at.is_empty(), "no Yard pick '%s'" % str(id))
		if at.is_empty():
			continue
		var b: Dictionary = Data.yard_building(str(at[0]))
		var sides: Array = s.yard_picks.get(at[0], []).duplicate()
		while sides.size() < b["picks"].size():
			sides.append("")
		var letter: String = "a" if int(at[2]) == 0 else "b"
		var had: String = str(sides[at[1]]).replace(letter, "")
		var with_it: String = str(sides[at[1]]) + letter if id == on else had
		sides[at[1]] = ("a" if with_it.contains("a") else "") + ("b" if with_it.contains("b") else "")
		s.yard_picks[at[0]] = sides
		s._yard_changed(str(at[0]))
	s._yard_grew(before)


## A primary base of a gun type: the first in the list.
func _base_of_type(ty: String) -> String:
	for b in Data.BASES["Primary"]:
		if b.get("type", "") == ty and not b.has("mag") and not b.has("ammo"):     # its type's own magazine (the fix round: the quick bases carry their own)
			return b["name"]
	return ""


## A class change for a check that isn't about its price (9 Oct: a change costs the respec of the class
## trees): the price handed over first, so the cash after is what it was.
## A tree's capstone by its index, and the nodes behind it (12 Oct: a node beside the capstone comes after it in the list).
func _behind_cap(tree_name: String) -> Array:
	var out: Array = []
	var nodes: Array = Data.tree_named(tree_name)["nodes"]
	for k in range(nodes.size()):
		if not nodes[k].get("capstone", false) and not nodes[k].get("beside", false):
			out.append(k)
	return out


## The Outskirts (12 Oct): a zone before the Estate, three sites, no crew. A new yard starts there and the Streets
## wait on it; it's done with its three cleared; a site's level reads past it;
## Runs has the four zones and no map, the Radio has the map.
func _outskirts_checks(main) -> void:
	var sim = main.sim
	_check(Data.ZONES.size() == 4 and Data.ZONES[0]["name"] == "The Outskirts" and Data.ZONES[0]["tiers"] == [0, 1, 2] and Data.TIERS[3]["name"] == "Ransacked Streets" and Data.TIERS[2]["name"] == "Top Farm", "the Outskirts are not first")
	for i in range(Data.TIERS.size()):
		_check(Data.ZONES[int(Data.TIERS[i]["zone"])]["tiers"].has(i), "%s is not in its zone's list" % Data.TIERS[i]["name"])
		_check(Words.SITES.has(Data.TIERS[i]["name"]), "%s has no words" % Data.TIERS[i]["name"])
	_check(Data.TIERS[Data.BANK]["name"] == "The Bank" and Data.TIERS[Data.CONVOY_TIER]["name"] == "The Services", "the Bank or the Services moved off its index")
	for b in Data.BOSSES:
		_check(int(Data.TIERS[int(b["tier"])]["zone"]) == int(b["zone"]) and int(b["tier"]) == Data.ZONES[int(b["zone"])]["tiers"].back(), "%s is not at his own zone's last site" % b["name"])
	var fresh = Sim.new()
	fresh.start()
	_check(fresh.tier_open(0) and not fresh.tier_open(1) and not fresh.tier_open(3) and fresh.zone_open(0) and not fresh.zone_open(1), "a new pitch does not start at the Allotments alone")
	fresh.best_depth[0] = 1
	fresh.best_depth[1] = 1
	_check(fresh.tier_open(2) and not fresh.zone_open(1), "the Estate opened before Top Farm was cleared")
	fresh.best_depth[2] = 1
	_check(not fresh.zone_open(1) and str(fresh.zone_boss(0).get("name", "")) == "The Gamekeeper", "the Estate opened with the Gamekeeper standing (13 Oct)")
	fresh.bosses_beaten[0] = true
	_check(fresh.zone_complete(0) and fresh.zone_open(1) and fresh.tier_open(3), "the Outskirts cleared and the Gamekeeper down did not open the Estate")
	_check(Sim.lv_at(3, 1) == 1 and Sim.lv_at(11, 1) == 9 and Sim.lv_at(0, 1) == 1 and Sim.lv_at(0, 6) == 3, "a site's level does not read past the Outskirts")
	_check(fresh.salvage_kinds().is_empty(), "the Outskirts drop salvage")
	# Runs: the four zones, the Outskirts first, no map; the Radio has it
	main.show_room(main.MISSIONS)
	var zn: Array = main._missions._map._zone_names
	_check(zn.size() == Data.ZONES.size() and zn[0][0].text == "The Outskirts" and zn[3][0].text == (Data.ZONES[3]["name"] if main.sim.zone_open(3) else Fmt.scramble(str(Data.ZONES[3]["name"]))), "the Map does not draw the four zones, the Outskirts first")     # the drawn Map (19 Oct): areas, not tabs
	main.show_room(main.COMMS)
	main.refresh()
	_check(main._radio._views.size() == 4 and (main._radio._views[1].disabled == not sim.campaign_done()) and (main._radio._views[2].disabled == not sim.campaign_done()) and (main._radio._views[3].disabled == not sim.campaign_done()), "the Radio's map, town and story buttons do not follow the campaign")
	_check_fit(main, "Radio (twelve sites)")
	print("the Outskirts ok: first, three sites, no crew, the Estate after, levels, Runs' four zones, the Radio's map")


