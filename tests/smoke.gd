## What "Leave it" must not touch: HP, the rig, the runner to come, the pack, finds, the clocks, the threads, tins, notes,
## the gang.
func _ev_state(sim, m: Dictionary) -> Array:
	return [sim.hp, sim.rig.size(), sim.promised, m["found"].size(), int(m.get("finds", 0)), float(m["patrol_timer"]), float(m["clock"]),
		JSON.stringify(sim.event_threads), float(m["cash"]), int(m.get("notes", 0)), m["t"].get_instance_id() if m["t"] is Object else str(m["t"].get("hp", 0)), float(m["t"]["dps"]), sim.on_mission()]


## A run out at site `i`, cleared, a search done and quiet, `fam` arrived (`who` pinned: the dogs or a crew, the Scrap man
## or the Vagabond), the site's gang made `weight` heavier first; HP full.
func _ev_at(sim, i: int, fam: String, who := "", weight := 1.0) -> Dictionary:
	if sim.on_mission():
		sim.extract_now()
	sim.hp = sim.max_hp()
	sim.deploy(i)
	var m: Dictionary = sim.mission
	if weight != 1.0:
		m["t"] = m["t"].duplicate()
		m["t"]["dps"] = float(m["t"]["dps"]) * weight
		m["t"]["hp"] = float(m["t"]["hp"]) * weight
	m["event_who"] = who
	_ev_arrive(sim, m, fam)
	return m


## Every string in a words table, flattened (Words.EV, Words.ORDERS).
func _ev_strings(v) -> Array:
	var out: Array = []
	if v is String:
		out.append(v)
	elif v is Array:
		for x in v:
			out.append_array(_ev_strings(x))
	elif v is Dictionary:
		for k in v:
			if str(k) in ["kind"]:
				continue
			out.append_array(_ev_strings(v[k]))
	return out


## A run out at the Streets, cleared, a search done and quiet, `fam` arrived and asking (or answered, asks off); `slots`
## laid over the event; `weight` the site's gang made that much heavier first (the dogs read off it); `full` HP first.
func _ev_force(sim, fam: String, slots := {}, weight := 1.0, slots2 := {}, full := true) -> Dictionary:
	if sim.on_mission():
		sim.extract_now()
	if full:
		sim.hp = sim.max_hp()
	var hp_set: float = sim.hp
	sim.deploy(3)
	sim.hp = hp_set
	var m: Dictionary = sim.mission
	if weight != 1.0:
		m["t"] = m["t"].duplicate()
		m["t"]["dps"] = float(m["t"]["dps"]) * weight
		m["t"]["hp"] = float(m["t"]["hp"]) * weight
	if not slots2.is_empty():
		# slots fixed before it's answered: the standing order reads them (asks off)
		var keep: bool = Sim.asks
		Sim.asks = true
		_ev_arrive(sim, m, fam)
		for k in slots2:
			m["ev"][k] = slots2[k]
		Sim.asks = keep
		if not keep:
			sim.event_by_orders()
		return m
	_ev_arrive(sim, m, fam)
	if not slots.is_empty() and m.has("ev"):
		for k in slots:
			m["ev"][k] = slots[k]
	return m


## The site cleared, a search done and quiet, `fam` due: one tick brings it.
func _ev_arrive(sim, m: Dictionary, fam: String) -> void:
	m["remaining"] = 0
	m["target_hp"] = 0.0
	m["cleared"] = true
	m["searches"] = maxi(1, int(m.get("searches", 0)))
	m["patrol_timer"] = 0.0
	m["event"] = fam
	m["event_at"] = 0.0
	if not m.has("event_who"):
		m["event_who"] = {"trader": "scrap_man", "threat": "dogs"}.get(fam, "")     # BUILD46-E: the slice's own unless asked
	sim.advance(0.5)


## The run screen with an event up: its panel fits, every word in its box and the panel in the column; the buttons
## it should have; the clock's chip round its words while it stops; the scene's caption inside the frame.
func _ev_ui(main, fam: String) -> void:
	var sim = main.sim
	if fam == "threat":
		sim.dogs_odds()                            # the read to its end (BUILD43: a watched run's is a few ms a frame, "reading…" till then)
	main.show_room(main.MISSIONS)
	main.refresh()
	var run = main._run
	var ep = run._event_panel
	_check(ep.visible and ep.fam == fam, "the %s panel isn't up on the run screen" % fam)
	_check_fit(main, "run events: %s" % fam)
	_ev_fits(ep.text_nodes(), Rect2(Vector2.ZERO, ep.size), ep, "the %s panel" % fam)
	_check(Rect2(Vector2.ZERO, run._left.size).encloses(Rect2(ep.position, ep.size)), "the %s panel runs out of the column" % fam)
	var b: Dictionary = ep.buttons()
	var want: Array = {"need": ["free", "bag", "leave"], "locked": ["force", "shoot", "leave"], "threat": ["out", "fight"], "trader": ["done"],
		"danger": ["go", "careful", "leave"], "stash": ["take", "check", "leave"], "body": ["search", "pockets", "leave"], "wreck": ["strip", "cut", "leave"],
		"broadcast": ["listen", "short", "leave"], "weather": ["press", "home", "leave"]}[fam]
	_check(want.all(func(k): return b.has(k)), "the %s panel lacks its buttons: %s" % [fam, str(b.keys())])
	_check(not run._button.visible and not run._button2.visible and not run._crates.visible, "the run's own buttons or the crates show under the %s panel" % fam)
	if fam == "threat":
		_check(ep._tiles[1]["value"].text == "%d%%" % roundi(sim.dogs_odds() * 100.0) and ep._tiles[2]["value"].text == ep.carry_words(sim.event_now()), "the threat's tiles are off: %s, %s" % [ep._tiles[1]["value"].text, ep._tiles[2]["value"].text])
	var chip: Panel = run._stop_chip
	var unit: Label = run._band.unit
	if fam == "threat":
		_check(not chip.visible and unit.text != Words.EV["stopped"], "the clock reads stopped for a threat")
	else:
		var tw: float = UI.text_width(unit, unit.text)
		_check(chip.visible and unit.text == Words.EV["stopped"] and chip.position.x <= unit.position.x and chip.position.x + chip.size.x >= unit.position.x + tw and chip.position.x + chip.size.x <= run._band.size.x, "the clock-stopped chip doesn't hold its words: '%s' %s against %s" % [unit.text, str(Rect2(chip.position, chip.size)), str(Rect2(unit.position, Vector2(tw, unit.size.y)))])
	if run._view != null:
		var pr = run._view.prop
		var cap: Label = pr.caption()
		_check(pr.shown and cap.text != "" and UI.text_width(cap, cap.text) <= cap.size.x and Rect2(Vector2.ZERO, pr.size).encloses(Rect2(cap.position, cap.size)), "the %s caption isn't in the frame: '%s' at %s" % [fam, cap.text, str(cap.position)])
		var c1: String = cap.text.substr(1, 1)
		_check(c1 == c1.to_lower(), "the %s caption doesn't start in lower case: '%s'" % [fam, cap.text])
	# the words on the panel (T10): no screen slip, no unfilled format
	var fmt := RegEx.new()
	fmt.compile("%[-0-9.]*[sdf]")
	for nd in ep.text_nodes():
		for bw in WORDS_SCREEN_BANNED:
			var hit: bool = (nd.text.find(bw) >= 0) if bw == "Boss" or bw.begins_with(" ") or bw.contains(" ") else (nd.text.to_lower().find(bw) >= 0)
			_check(not hit, "the %s panel shows \"%s\": %s" % [fam, bw, nd.text])
		_check(fmt.search(nd.text) == null, "the %s panel shows an unfilled format code: %s" % [fam, nd.text])


## Every label and button in `nodes` holds its words and sits inside `box` (in `root`'s space).
func _ev_fits(nodes: Array, box: Rect2, holder: Control, where: String) -> void:
	for n in nodes:
		if not n.visible:
			continue
		var pad: float = 32.0 if n is Button else 0.0
		var r := Rect2(n.position, n.size)
		var p: Node = n.get_parent()
		while p != null and p != holder:
			r.position += (p as Control).position
			p = p.get_parent()
		_check(UI.text_width(n, n.text) + pad <= n.size.x + 0.5, "%s: '%s' needs %.0f px, has %.0f" % [where, n.text, UI.text_width(n, n.text) + pad, n.size.x])
		_check(box.grow(0.5).encloses(r), "%s: '%s' runs out of its panel" % [where, n.text])


## Pinnacles from depth 10: dearer, harder, their charm in the pool. The
## convoy on the Services from depth 12: all three, one after another, and
## the Lorry's Load at the end.
func _pinnacle_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	_finish_campaign(sim)
	sim.notes += 100000
	for i in range(Data.TIERS.size()):
		sim.best_depth[i] = 20
	# the Carpet Man a depth short of full strength and at it (the Retail Park's at 12, the Bank's at 9, the Barracks' at 6: level 14 on each)
	var pd: int = sim.pinnacle_depth(5)
	_check(pd == 12 and sim.pinnacle_depth(8) == 9 and sim.pinnacle_depth(11) == 6, "the stations' depths are off: %d %d %d" % [pd, sim.pinnacle_depth(8), sim.pinnacle_depth(11)])
	sim.set_depth(5, pd - 1)
	sim.arm_boss(5, true)
	var cost9: int = sim.boss_cost(5)
	var e9: Dictionary = sim.effective(5)
	sim.set_depth(5, pd)
	_check(sim.is_pinnacle(5) and not sim.is_pinnacle(4), "depth %d is not a pinnacle" % pd)
	var e10: Dictionary = sim.effective(5)
	_check(e10["boss"]["pinnacle"] and not e9["boss"].get("pinnacle", false), "the boss at depth %d is not at full strength" % pd)
	# full strength is twice the crew at the same fire (the sixteenth read: a fire multiplier reads 0.00 whatever the HP)
	var site_step: float = float(e10["dps"]) / float(e9["dps"])        # the depth's own step, the only change in the fire
	_check(e10["boss"]["hp"] > e9["boss"]["hp"] * 1.8 * site_step * 0.95 and is_equal_approx(e10["boss"]["dps"] / e9["boss"]["dps"], site_step), "the pinnacle is not twice the crew at the same fire: hp ×%.2f, dps ×%.2f against the site's ×%.2f" % [e10["boss"]["hp"] / e9["boss"]["hp"], e10["boss"]["dps"] / e9["boss"]["dps"], site_step])
	_check(sim.boss_cost(5) > cost9 * 1.8, "the pinnacle costs no more: %d vs %d" % [sim.boss_cost(5), cost9])
	# their charm comes from the pinnacle and never from the ordinary fight
	var charms := 0
	var m: Dictionary
	for k in range(40):
		sim.arm_boss(5, true)
		sim.deploy(5)
		m = sim.mission
		m["boss"]["started"] = true
		sim._boss_down(m, sim.effective(5))
		for it in m["found"] + m.get("floor", []):     # on the floor by hand (1 Nov)
			if it.get("unique", "") == "The Van Keys":
				charms += 1
		sim.extract_now()
	_check(charms > 3 and charms < 30, "the Van Keys came %d of 40 pinnacle kills; a third was the aim" % charms)
	sim.set_depth(5, 5)
	charms = 0
	for k in range(30):
		sim.arm_boss(5, true)
		sim.deploy(5)
		m = sim.mission
		m["boss"]["started"] = true
		sim._boss_down(m, sim.effective(5))
		for it in m["found"] + m.get("floor", []):     # on the floor by hand (1 Nov)
			if it.get("unique", "") == "The Van Keys":
				charms += 1
		sim.extract_now()
	_check(charms == 0, "the Van Keys came from the Carpet Man under full strength")
	# the convoy: the Services at convoy_depth() (CONVOY_DEPTH on the first yard, a depth deeper a move)
	sim.set_depth(Data.CONVOY_TIER, Data.CONVOY_DEPTH - 1)
	_check(not sim.is_convoy(Data.CONVOY_TIER) and not sim.can_arm_boss(Data.CONVOY_TIER), "the convoy came before depth %d" % Data.CONVOY_DEPTH)
	sim.set_depth(Data.CONVOY_TIER, Data.CONVOY_DEPTH)
	_check(sim.is_convoy(Data.CONVOY_TIER) and sim.can_arm_boss(Data.CONVOY_TIER), "the convoy is not on the Services at depth %d" % Data.CONVOY_DEPTH)
	var convoy_cost: int = sim.boss_cost(Data.CONVOY_TIER)
	var three := 0
	for b in Data.BOSSES:
		if int(b["zone"]) >= 1:
			three += int(b["notes"]) * Data.CONVOY_DEPTH            # the plain three (8 Oct); the Gamekeeper doesn't ride (13 Oct)
	_check(convoy_cost == three, "the convoy's price is %d, not the three heads' %d" % [convoy_cost, three])
	sim.arm_boss(Data.CONVOY_TIER, true)
	sim.words[Data.CONVOY_TIER] = []      # the plain site: the heads are formed before the words multiply the site
	var ec: Dictionary = sim.effective(Data.CONVOY_TIER)
	_check(ec.get("convoy", false) and ec["boss_queue"].size() == 2 and not ec["boss"]["pinnacle"], "the convoy is not three in a row, come light")
	var cm_hp: float = float(ec["hp"]) * float(Data.BOSSES[1]["hp"]) * Data.CONVOY_HP
	var cm_dps: float = float(ec["dps"]) * float(Data.BOSSES[1]["dps"]) * Data.CONVOY_DPS
	_check(is_equal_approx(float(ec["boss"]["hp"]), cm_hp) and is_equal_approx(float(ec["boss"]["dps"]), cm_dps), "the convoy's first head is not light and tired: %.0f/%.1f against %.0f/%.1f" % [float(ec["boss"]["hp"]), float(ec["boss"]["dps"]), cm_hp, cm_dps])
	main.show_room(main.MISSIONS)
	main._missions._pick_zone(3)
	_check_fit(main, "Runs (convoy armed)")
	var notes0: int = sim.notes
	sim.deploy(Data.CONVOY_TIER)
	_check(sim.notes == notes0 - convoy_cost, "the convoy's price was not paid")
	m = sim.mission
	_check(m["boss_queue"].size() == 2 and m["convoy"], "the mission did not carry the queue")
	# the pool goes down; each head comes out in turn, the next as one falls
	var names: Array = []
	var found0: int = m["found"].size() + m.get("floor", []).size()     # the heads' uniques on the floor by hand (1 Nov)
	m["remaining"] = 1
	m["target_hp"] = 0.0
	sim.advance(0.05)                          # the last of the pool goes; the first head comes out
	for k in range(3):
		_check(m["boss"]["started"] and m["boss"]["alive"], "head %d did not come out" % (k + 1))
		names.append(m["boss"]["name"])
		m["target_hp"] = 0.0
		sim.advance(0.05)                      # goes down; the next comes out
	_check(not m["boss"]["alive"] and m["boss_queue"].is_empty(), "the last head is still up")
	_check(names == ["The Carpet Man", "The Manager", "The Quartermaster"], "the convoy came in the wrong order: %s" % str(names))
	var ld := false
	var got_all: Array = m["found"] + m.get("floor", [])
	for it in got_all:
		ld = ld or it.get("unique", "") == Data.CONVOY_UNIQUE
	_check(ld and got_all.size() >= found0 + 4, "the Lorry's Load did not come with the three drops: %d found" % (got_all.size() - found0))
	# the ending (7 Oct): the lorry beaten is written, the Yard says to move, the move lights
	_check(sim.lorry_done and sim.lorries == 1 and sim.next_words() == Words.NEXT["done"] and sim.events.any(func(e): return str(e[1]).begins_with("The Lorry's Load is yours")), "the lorry beaten was not written: done %s, lorries %d, next '%s'" % [str(sim.lorry_done), sim.lorries, sim.next_words()])
	sim.extract_now()
	main.show_room(main.OVERVIEW)
	main.refresh()
	# the rules: the keys drive, the pen doubles the notes, the ledger a tier up, the load fills the pack
	var pace0: float = sim.pace()
	var was_charm = sim.equipped["Charm"]
	sim.equipped["Charm"] = Items.roll_unique(sim._unique_named("The Van Keys"), sim.rng)
	_check(sim.pace() > pace0 * 1.2, "the Van Keys did not drive")
	sim.equipped["Charm"] = Items.roll_unique(sim._unique_named("The Manager's Pen"), sim.rng)
	for oi in Data.ZONES[0]["tiers"]:
		sim.best_depth[oi] = maxi(1, int(sim.best_depth[oi]))     # the moved yard's Outskirts walked, so the Streets are open (12 Oct)
	var n0: int = sim.notes
	sim.deploy(3)
	sim.mission["notes"] = 7
	sim.extract_now()
	_check(sim.notes == n0 + 14, "the Manager's Pen did not double the notes: +%d" % (sim.notes - n0))
	sim.equipped["Charm"] = was_charm
	var was_pack = sim.equipped["Backpack"]
	sim.equipped["Backpack"] = Items.roll_unique(sim._unique_named("The Lorry's Load"), sim.rng)
	n0 = sim.notes
	sim.set_depth(3, 3)
	sim.deploy(3)
	sim.mission["found"] = []
	sim.mission["notes"] = 0
	sim.extract_now()
	_check(sim.notes == n0 + sim.capacity() * 3, "the Lorry's Load did not fill the empty pack with notes: +%d of %d (depth %d, best %d, campaign %s)" % [sim.notes - n0, sim.capacity() * 3, sim.depth[3], sim.best_depth[3], str(sim.campaign_done())])
	sim.equipped["Backpack"] = was_pack
	for name in ["The Van Keys", "The Manager's Pen", "The Quartermaster's Ledger", "The Lorry's Load"]:
		_check(Words.UNIQUES.has(name), "%s has no line" % name)
	sim.load_dict(saved)
	print("pinnacles and the convoy ok: full strength, the charm, three in a row, the load, the rules")
	_craft_checks(main)
	_sink_checks(main)
	_inflation_checks(main)
	_recycle_checks(main)
	_book_checks(main)
	_lore_checks(main)
	_radio_line_checks(main)
	_codes_checks(main)
	_tins_checks(main)
	_places_checks(main)
	_faces_checks(main)
	_stack_checks(main)
	_next_checks(main)
	_idle_checks(main)
	_juice_checks(main)
	_hit_register_checks(main)
	_yard_checks(main)
	_fight_breakdown_checks(main)
	_order_fight_checks(main)
	_pattern_checks(main)
	_loot_rule_checks(main)
	_collection_checks(main)
