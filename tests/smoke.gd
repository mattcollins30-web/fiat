## The Map's paint and the odds (19 Oct, Matt: the Map lagged after Glasses): a paint works the odds' key once, a
## button asked for the look it has is left alone, and Glasses' sixty runs show their number at twenty-four.
func _odds_paint_checks(main) -> void:
	var sim = main.sim
	main.show_room(main.MISSIONS)
	main._missions._shown = ""
	sim.prof["key_common"] = 0
	main.refresh()
	_check(int(sim.prof["key_common"]) <= 2, "a paint of the Map worked the odds' key %d times (once, in its scope)" % int(sim.prof["key_common"]))
	_check(sim._scope == 0, "the paint left its odds scope open")
	# a button's look, once
	var b := Button.new()
	main.add_child(b)
	UI.style_button(b, false, "good")
	var sb = b.get_theme_stylebox("normal")
	UI.style_button(b, false, "good")
	_check(b.get_theme_stylebox("normal") == sb, "the same look asked again restyled the button")
	UI.style_button(b, true)
	_check(b.get_theme_stylebox("normal") != sb, "a new look didn't restyle the button")
	var other := StyleBoxFlat.new()
	b.add_theme_stylebox_override("normal", other)
	UI.style_button(b, true)
	_check(b.get_theme_stylebox("normal") != other, "a button restyled by hand kept the hand's look when asked for its old one")
	b.queue_free()
	# Glasses: the number at twenty-four, the rest read behind it
	var s = Sim.new()
	s.start()
	s.mythics_on = false
	_open_camp(s)
	s.yard_picks["lookout"] = ["b", "", "", "", ""]
	s._yard_dirty = true
	if s.yard_has("glasses"):
		s.odds_budget = 1
		var i := 0
		for k in range(Data.ODDS_RUNS):
			s.survival(i)
		var c: Array = s._surv_cache.get(i, [])
		var bailed: bool = not c.is_empty() and int(c[2]) >= s.odds_runs()     # an early settle (all alive or all dead) reads whole
		_check(s.odds_ready(i), "Glasses: the odds didn't show at %d runs" % Data.ODDS_RUNS)
		_check(bailed or not s.odds_settled(i), "Glasses: the odds read whole at %d of %d" % [Data.ODDS_RUNS, s.odds_runs()])
	else:
		_check(false, "the fixture: no Glasses from the Lookout's first pick")
	print("the odds' paint ok: the key once a paint, a button's look once, Glasses' number at %d runs" % Data.ODDS_RUNS)


## The campaign's pace (19 Oct, Matt): gear to wear at 2 x the site's level - 2, and each site first opens at that
## less one, so a runner arrives at its drops' level, a level under at worst; a cleared site stays open to a new runner.
func _site_gate_checks(main) -> void:
	var want := {1: 1, 2: 2, 3: 4, 4: 6, 5: 8, 6: 10, 7: 12, 8: 14, 9: 16}
	for lv in want:
		_check(Sim.wear_of(lv) == int(want[lv]), "items of level %d wear at %d, not %d" % [lv, Sim.wear_of(lv), int(want[lv])])
	var s = Sim.new()
	s.start()
	s.mythics_on = false
	var parade := 4
	var retail := 5
	_check(Data.TIERS[parade]["name"] == "The Parade" and Data.TIERS[retail]["name"] == "The Retail Park", "the fixture: the Parade and the Retail Park moved")
	for i in range(Data.OUTSKIRTS_SITES + 1):
		s.best_depth[i] = 1
	s.bosses_beaten[0] = true
	s.xp = 0.0
	_check(s.site_gate(retail) == Sim.wear_of(Sim.lv_at(retail, 1)) - 1 and s.site_gate(retail) > 1, "the Retail Park's gate reads %d" % s.site_gate(retail))
	s.best_depth[parade] = 1
	_check(not s.tier_open(retail) and s.level_gated(retail), "the Retail Park opened to a level-1 runner")
	s.xp = Data.xp_for_level(s.site_gate(retail))
	_check(s.tier_open(retail), "the Retail Park stayed shut at its gate's level %d" % s.site_gate(retail))
	s.best_depth[retail] = 1
	s.xp = 0.0
	_check(s.tier_open(retail), "a cleared site shut on a new runner")
	# every campaign site's gate: its drops' level less one
	for i in range(Data.TIERS.size()):
		_check(s.site_gate(i) == maxi(1, Sim.wear_of(Sim.lv_at(i, 1)) - 1), "%s opens at %d" % [Data.TIERS[i]["name"], s.site_gate(i)])
	# the Map says so
	var keep = main.sim
	s.best_depth[retail] = 0
	main.sim = s
	main.show_room(main.MISSIONS)
	main._missions.select(retail)
	main.refresh()
	var said := " | ".join(_texts(main._missions))
	_check(said.contains("Opens at level %d" % s.site_gate(retail)), "the Map doesn't say the Retail Park opens at level %d: %s" % [s.site_gate(retail), said.left(300)])
	_check_fit(main, "the Map (a site shut for the level)")
	# a zone shut till its first site's level (19 Oct, Matt: "keep a zone locked until the level cap is hit and note it
	# on the zone of the map"): the Estate done, the Town at its gate
	for i in Data.ZONES[1]["tiers"]:
		s.best_depth[i] = 1
	s.bosses_beaten[1] = true
	var tg: int = s.zone_gate(2)
	s.xp = Data.xp_for_level(tg - 1)
	s.cls = "Scrapper"
	s.runs_total = maxi(1, s.runs_total)
	_check(tg > 1 and not s.zone_open(2) and s.zone_level_shut(2) and Data.ZONES[2]["tiers"].all(func(i): return not s.tier_open(i)), "the Town opened under its level %d" % tg)
	_check(s.next_words() == Words.NEXT["level"] % tg, "what's next doesn't say the Town's level: '%s'" % s.next_words())
	main.sim = s
	main._missions._map._shown = ""
	main.refresh()
	var town_st: String = main._missions._map._zone_names[2][1].text
	_check(town_st.to_lower().contains("level %d" % tg), "the Map's Town doesn't say level %d: '%s'" % [tg, town_st])
	_check_fit(main, "the Map (a zone shut for the level)")
	s.xp = Data.xp_for_level(tg)
	_check(s.zone_open(2) and s.tier_open(int(Data.ZONES[2]["tiers"][0])), "the Town stayed shut at level %d" % tg)
	s.best_depth[int(Data.ZONES[2]["tiers"][0])] = 1
	s.xp = 0.0
	_check(s.zone_open(2), "a zone with a site cleared shut on a new runner")
	main.sim = keep
	main._missions._shown = ""
	main.refresh()
	print("the campaign's pace ok: wear at 2 x - 2, each site open at its drops' level less one, the Map says so")


## The gates for how play feels (19 Oct): one reader for the bot's chronicle and the player's record, judged alike.
func _feel_gate_checks() -> void:
	var Feel = load("res://tools/feel_gates.gd")
	var ch: Array = [
		{"k": "clear", "first": true, "site": "The Parade", "site_level": 2, "depth": 1, "lv": 2},
		{"k": "clear", "first": true, "site": "The Barracks", "site_level": 9, "depth": 1, "lv": 12},
		{"k": "run", "cash": 1000, "gear": 4, "gear_wearable": 1, "outcome": "Back"},
		{"k": "open", "room": "clinic"},
		{"k": "run", "cash": 1000, "gear": 0, "gear_wearable": 0, "wounded": true, "outcome": "Back"},
		{"k": "run", "cash": 1000, "gear": 4, "gear_wearable": 1, "outcome": "Back", "away": true},
		{"k": "contract", "pay": "cash", "amount": 5000},
		{"k": "contract", "pay": "notes", "amount": 99},
	]
	var f: Dictionary = Feel.read(ch)
	_check(f["runs"] == 2 and f["wound_runs"] == 1 and f["gear"] == 4 and f["wearable"] == 1 and f["wounded"] == 1, "the feel read is off: %s" % str(f))
	var bot_f: Dictionary = Feel.read(ch, true)
	_check(bot_f["runs"] == 3 and bot_f["gear"] == 8, "the bot's away hours weren't counted: %s" % str(bot_f))
	var rows: Array = Feel.rows(f)
	var by := {}
	for r in rows:
		by[r[0]] = r[3]
	_check(by.get("Level on entry") == false and by.get("Gear to wear") == false and not by.has("Contracts against runs") and by.get("Deaths") == null, "the feel gates judged it wrong: %s" % str(by))
	var empty: Array = Feel.rows(Feel.read([]))
	_check(empty.all(func(r): return r[3] == null), "an empty record was judged: %s" % str(empty.map(func(r): return r[3])))
	print("the feel gates ok: one reader, the entries, the wearable share, wounds, deaths")


## The drawn Map (19 Oct, Matt's pick B): a pin picked shows its card; a shut zone's pins take no click and carry no
## names; with every zone and every order's place open, no two names on the map cross, and all of them sit inside it.
func _map_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var M = main._missions
	var mv = M._map
	main.show_room(main.MISSIONS)
	# a fresh camp: the Outskirts open, the rest shut
	var s = Sim.new()
	s.start()
	s.mythics_on = false
	main.sim = s
	main.refresh()
	var click := func(at: Vector2) -> void:
		var ev := InputEventMouseButton.new()
		ev.button_index = MOUSE_BUTTON_LEFT
		ev.pressed = true
		ev.position = at
		mv._gui_input(ev)
	click.call(mv.pin_at(1))
	main.refresh()
	_check(M.selected == 1 and M._cols[0]["band"].title.text == str(Data.TIERS[1]["name"]), "a pin picked didn't show its card: selected %d, the card '%s'" % [M.selected, M._cols[0]["band"].title.text])
	click.call(mv.pin_at(10))
	main.refresh()
	_check(M.selected == 1, "a shut zone's pin took the click")
	# a zone not yet known (20 Oct, Matt): its name and its sites' scrambled like the radio's traffic, no "Locked"
	_check(mv._pin_labels[10].text == Fmt.scramble(str(Data.TIERS[10]["name"])) and mv._pin_labels[1].text == str(Data.TIERS[1]["name"]), "a shut zone's pins read '%s', an open one's '%s'" % [mv._pin_labels[10].text, mv._pin_labels[1].text])
	_check(mv._zone_names[1][0].text == Fmt.scramble(str(Data.ZONES[1]["name"])) and not mv._zone_names[1][1].text.contains("Locked") and mv._zone_names[1][1].text != "", "a shut zone reads '%s' / '%s'" % [mv._zone_names[1][0].text, mv._zone_names[1][1].text])
	for zl in mv._zone_names:
		_check(not zl[1].text.contains("Locked"), "a zone still says Locked: '%s'" % zl[1].text)
	_check_fit(main, "the Map (a fresh camp)")
	# the scrambled names cross nothing, on the map and inside it (the review: the glyphs run wider)
	var fboxes: Array = []
	for l in mv.text_nodes():
		if l.visible and l.text != "":
			var fw: float = UI.text_width(l, l.text)
			var fx: float = l.position.x + ((l.size.x - fw) / 2.0 if l.horizontal_alignment == HORIZONTAL_ALIGNMENT_CENTER else (l.size.x - fw if l.horizontal_alignment == HORIZONTAL_ALIGNMENT_RIGHT else 0.0))
			fboxes.append([l.text, Rect2(fx, l.position.y, fw, l.size.y)])
	var fcross: Array = []
	for a2 in range(fboxes.size()):
		if not Rect2(Vector2.ZERO, mv.size).encloses(fboxes[a2][1]):
			fcross.append(fboxes[a2][0] + " (off the map)")
		for b2 in range(a2 + 1, fboxes.size()):
			if fboxes[a2][1].grow(-1.0).intersects(fboxes[b2][1].grow(-1.0)):
				fcross.append("%s / %s" % [fboxes[a2][0], fboxes[b2][0]])
	_check(fcross.is_empty(), "a fresh camp's names cross on the Map: %s" % ", ".join(fcross))
	# nothing else names what isn't known: what's next, the shelf's gaps, the Yard's columns
	var shut_names: Array = []
	for z in range(1, Data.ZONES.size()):
		shut_names.append(str(Data.ZONES[z]["name"]))
		for t in Data.ZONES[z]["tiers"]:
			shut_names.append(str(Data.TIERS[int(t)]["name"]))
	var said_fresh: Array = [s.next_words(), s.next_words(true)]
	for c in s.shelf_chase():
		if not c["found"] and not c["known"]:
			continue
		said_fresh.append(str(c["where"]))
	for col in range(Data.YARD_COLS):
		said_fresh.append(Data.yard_gate(col))
	var named: Array = []
	for t in said_fresh:
		for nm in shut_names:
			if str(t).contains(nm) and not (nm == "The Town" and str(t) == Data.yard_gate(1)):
				named.append("%s in '%s'" % [nm, t])
	_check(named.is_empty(), "a fresh camp is told what it hasn't found: %s" % ", ".join(named.slice(0, 4)))
	# a pin's name is the name only, sitting on its own pin (19 Oct, Matt); the key small and packed
	for i in range(Data.TIERS.size()):
		var pl: Label = mv._pin_labels[i]
		if not pl.visible:
			continue
		var want_nm: String = str(Data.TIERS[i]["name"]) if mv.sim.zone_open(int(Data.TIERS[i]["zone"])) else Fmt.scramble(str(Data.TIERS[i]["name"]))
		_check(pl.text == want_nm, "a pin's name carries more than the name: '%s'" % pl.text)
		var side: int = int(mv.SITE_LABEL[i])
		if side == mv.BELOW or side == mv.ABOVE:
			var cx: float = pl.position.x + pl.size.x / 2.0
			var room_l: bool = pl.position.x <= 4.5 or pl.position.x + pl.size.x >= mv.size.x - 4.5
			_check(absf(cx - mv.pin_at(i).x) < 2.0 or (room_l and Rect2(pl.position, pl.size).grow_individual(0, 0, 0, 0).has_point(Vector2(mv.pin_at(i).x, pl.position.y + 1)) or (room_l and absf(pl.position.x - 4.0) < 0.5)), "%s's name sits off its pin: %.0f against %.0f" % [Data.TIERS[i]["name"], cx, mv.pin_at(i).x])
	# the cloud over all but the open zones (19 Oct, Matt): under every word, its mask white on an open zone's pin,
	# black on a shut one's and on the land between
	if mv._clouds != null:
		_check(mv._clouds.get_index() < mv._zone_names[0][0].get_index() and mv._clouds.mouse_filter == Control.MOUSE_FILTER_IGNORE and mv._clouds.size == mv.size, "the cloud sits over the words or takes the clicks")
		var mk: Image = mv.cloud_mask("1000", mv.size)
		var at_px := func(p: Vector2) -> float:
			return mk.get_pixel(int(p.x * mv.size.x / mv.W0 / mv.MASK_DIV), int(p.y * mv.size.y / mv.H0 / mv.MASK_DIV)).r
		_check(at_px.call(mv.SITE_AT[0]) > 0.5 and at_px.call(mv.SITE_AT[10]) < 0.5 and at_px.call(Vector2(600, 800)) < 0.5, "the cloud's mask is off: the Allotments %.1f, the Hospital %.1f, the moor %.1f" % [at_px.call(mv.SITE_AT[0]), at_px.call(mv.SITE_AT[10]), at_px.call(Vector2(600, 800))])
		# with the City open too, nothing's left clouded: the moor and the motorway strip clear with it (20 Oct, Matt)
		var mk3: Image = mv.cloud_mask("1110", mv.size)
		var all_open: Image = mv.cloud_mask("1111", mv.size)
		var lit := 0
		for yy in range(all_open.get_height()):
			for xx in range(all_open.get_width()):
				lit += 1 if all_open.get_pixel(xx, yy).r > 0.5 else 0
		_check(lit == all_open.get_width() * all_open.get_height() and mk3.get_pixel(int(600 * mv.size.x / mv.W0 / mv.MASK_DIV), int(800 * mv.size.y / mv.H0 / mv.MASK_DIV)).r < 0.5,
			"with every zone open %d of %d cells clear; the moor before the City %.1f" % [lit, all_open.get_width() * all_open.get_height(), mk3.get_pixel(int(600 * mv.size.x / mv.W0 / mv.MASK_DIV), int(800 * mv.size.y / mv.H0 / mv.MASK_DIV)).r])
		# every pin clear of the cloud's soft edge: 12 px at least from its zone's edges, bar the map's own
		for i in range(Data.TIERS.size()):
			var poly: Array = mv.ZONE_SHAPES[int(Data.TIERS[i]["zone"])]["points"]
			var pp: Vector2 = mv.pin_at(i)
			var near := INF
			for e in range(poly.size()):
				var a2: Vector2 = mv._px(poly[e])
				var b2: Vector2 = mv._px(poly[(e + 1) % poly.size()])
				var on_rim: bool = (a2.x <= 0.5 and b2.x <= 0.5) or (a2.y <= 0.5 and b2.y <= 0.5) or (a2.x >= mv.size.x - 0.5 and b2.x >= mv.size.x - 0.5) or (a2.y >= mv.size.y - 0.5 and b2.y >= mv.size.y - 0.5)
				if not on_rim:
					near = minf(near, pp.distance_to(Geometry2D.get_closest_point_to_segment(pp, a2, b2)))
			_check(near >= 12.0, "%s's pin is %.0f px from its zone's edge: the cloud's fade reaches it" % [Data.TIERS[i]["name"], near])
		# and under the moving edge (23 Oct, the review): with each run of zones open, no open site's pin under more than
		# a tenth of cloud at the edge's worst wander and wisps
		for ckey in ["1000", "1100", "1110"]:
			var csoft: Image = mv.soft_mask(mv.cloud_mask(ckey, mv.size))
			for i in range(Data.TIERS.size()):
				if ckey[int(Data.TIERS[i]["zone"])] == "1":
					var cov: float = mv.cloud_cover_bound(csoft, mv.pin_at(i), mv.size)
					_check(cov < 0.1, "%s's pin can sit under %.2f of cloud with zones %s open" % [Data.TIERS[i]["name"], cov, ckey])
		_check(mv._clouds_open == "1000" or mv._clouds_open.length() == Data.ZONES.size(), "the cloud wasn't cut for the zones open: '%s'" % mv._clouds_open)
	_check(mv._key_rect.size.x <= 340.0 and mv._key_rect.size.y <= 32.0 and mv._legend.all(func(e): return mv._key_rect.encloses(Rect2(e[0].position, e[0].size))), "the Map's key is %s, or a word leaves it" % str(mv._key_rect))
	# a pad or the keys step the pins, round the open zones' sites (the review: the tabs were buttons; the Deck's d-pad)
	var kev := InputEventAction.new()
	kev.action = "ui_right"
	kev.pressed = true
	mv._gui_input(kev)
	main.refresh()
	_check(M.selected == 2, "ui_right didn't step to the next pin: %d" % M.selected)
	kev.action = "ui_left"
	mv._gui_input(kev)
	mv._gui_input(kev)
	main.refresh()
	_check(M.selected == 0, "ui_left didn't step back: %d" % M.selected)
	mv._gui_input(kev)
	main.refresh()
	_check(M.selected == 2, "ui_left didn't go round the end to the last open zone's last pin: %d" % M.selected)
	# a level-gated site in an open zone: its pin picks its card, which says what opens it
	for i in range(5):
		s.best_depth[i] = 1                  # the Outskirts and the Parade cleared: the Retail Park next, shut for the level
	s.bosses_beaten[0] = true
	s.xp = 0.0
	M._shown = ""
	mv._shown = ""
	main.refresh()
	click.call(mv.pin_at(5))
	main.refresh()
	_check(M.selected == 5 and M._cols[0]["band"].unit.text == "Opens at level %d" % s.site_gate(5), "a gated site's pin: selected %d, the card '%s'" % [M.selected, M._cols[0]["band"].unit.text])
	# what's over the map takes the click first: the guide, open over the room
	# what's over the map takes the click first: the guide over the room, the came-back card - each later than the map
	# among the room's children (drawn over it, offered the click first) and stopping the mouse, over the map's rect
	M.select(4)
	M._open_guide()
	main.refresh()
	var g = M._guide
	_check(g.visible and g.mouse_filter == Control.MOUSE_FILTER_STOP and g.get_index() > mv.get_index() and g.get_global_rect().encloses(mv.get_global_rect()), "the open guide doesn't stand over the map for the click: index %d against %d, stop %s" % [g.get_index(), mv.get_index(), str(g.mouse_filter == Control.MOUSE_FILTER_STOP)])
	# the guide's tabs and its close take a real click (20 Oct, Matt: "Where to farm and the X button dont work"): its two
	# tabs' pages were full-size and over them, so a click never got through; the smoke only ever emitted pressed
	for b in g._tabs + [g._close]:
		var blocker: String = _click_blocker(main, b)
		_check(blocker == "", "the guide's '%s' doesn't take the click: %s is over it" % [b.text, blocker])
	for tab in ["depths", "farm"]:
		g._pick_tab(tab)
		main.refresh()
		_check_clicks(main, "the Site guide (%s)" % tab, g)
	g._pick_tab("depths")
	main.refresh()
	g._close.pressed.emit()
	main.refresh()
	var card = M._came
	_check(card.mouse_filter == Control.MOUSE_FILTER_STOP and card.get_index() > mv.get_index(), "the came-back card isn't over the map for the click")
	_check(not card.get_global_rect().intersects(mv.get_global_rect()) or card.get_index() > mv.get_index(), "the came-back card sits on the map under it")
	# everything open, every order's place too: the names
	main.sim = sim
	_finish_campaign(sim)
	for p in Data.PINNACLES:
		sim.rebuilt[str(p["opened_by"])] = maxi(1, int(sim.rebuilt.get(str(p["opened_by"]), 0)))
	M._shown = ""
	mv._shown = ""
	main.refresh()
	var boxes: Array = []
	for l in mv.text_nodes():
		if not l.visible or l.text == "":
			continue
		var w: float = UI.text_width(l, l.text)
		var x: float = l.position.x
		if l.horizontal_alignment == HORIZONTAL_ALIGNMENT_CENTER:
			x += (l.size.x - w) / 2.0
		elif l.horizontal_alignment == HORIZONTAL_ALIGNMENT_RIGHT:
			x += l.size.x - w
		boxes.append([l.text, Rect2(x, l.position.y, w, l.size.y)])
	var crossed: Array = []
	var outside: Array = []
	for a in range(boxes.size()):
		if not Rect2(Vector2.ZERO, mv.size).encloses(boxes[a][1]):
			outside.append(boxes[a][0])
		for b in range(a + 1, boxes.size()):
			if boxes[a][1].grow(-1.0).intersects(boxes[b][1].grow(-1.0)):
				crossed.append("%s / %s" % [boxes[a][0], boxes[b][0]])
	_check(crossed.is_empty(), "names cross on the Map: %s" % ", ".join(crossed))
	# the painting (19 Oct, Matt: one picture, the zones and pins traced off it): it covers the map, every pin and order
	# diamond sits inside its own zone's shape, the lit zone follows the pick, no pin sits on another
	var pic = mv.painting()
	if pic != null:
		var pr := Rect2(mv.MAP_AT, pic.get_size() * 2.0)
		_check(pr.encloses(Rect2(Vector2.ZERO, mv.size)) and pr.size.x - mv.size.x <= 8.0 and pr.size.y - mv.size.y <= 8.0, "the painting doesn't fill the Map: %s on %s" % [str(pr), str(mv.size)])
	for i in range(Data.TIERS.size()):
		var zpoly := PackedVector2Array(mv.ZONE_SHAPES[int(Data.TIERS[i]["zone"])]["points"])
		_check(Geometry2D.is_point_in_polygon(mv.SITE_AT[i], zpoly), "%s's pin sits outside its zone" % Data.TIERS[i]["name"])
		for j in range(i):
			_check(mv.pin_at(i).distance_to(mv.pin_at(j)) > 2.0 * mv.HIT_R, "%s's and %s's pins are too close to click apart" % [Data.TIERS[i]["name"], Data.TIERS[j]["name"]])
	for k in mv.ORDER_AT:
		_check(Rect2(Vector2.ZERO, mv.size).has_point(mv.order_pin_at(k)), "%s's diamond is off the Map" % k)
		var oz: int = int(Data.pinnacle(k)["zone"])
		_check(Geometry2D.is_point_in_polygon(mv.ORDER_AT[k], PackedVector2Array(mv.ZONE_SHAPES[oz]["points"])), "%s's diamond sits outside the zone it lights" % k)
	M.select(7)
	main.refresh()
	_check(mv.lit_zone() == int(Data.TIERS[7]["zone"]), "the lit zone doesn't follow the pick: %d" % mv.lit_zone())
	_check(outside.is_empty(), "names leave the Map: %s" % ", ".join(outside))
	_check(mv._order_labels.values().all(func(l): return l.visible), "an opened order's place has no pin on the Map")
	click.call(mv.order_pin_at("archive"))
	main.refresh()
	_check(M.order_key == "archive" and M._order.visible, "the Archive's pin didn't show its card")
	_check_fit(main, "the Map (all open, an order's place picked)")
	M.select(11)
	sim.load_dict(saved)
	M._shown = ""
	main.refresh()
	print("the drawn Map ok: a pin picks its card, a shut zone's don't, no names cross, all inside, the order's places")


## Fence A and B (19 Oct, Matt's picks): the rarity rows sell what isn't worn and keep an upgrade back; the boxes put
## your guns' rounds first and lit; a part says which gun it fits; a contract marks the stash - what goes, what would
## do, the rest shaded - and a cell picked swaps what goes, the pick handed in.
func _fence_ab_checks(main) -> void:
	var sim = main.sim
	if not sim.room_open("fence") or sim.on_mission():
		_check(false, "the Fence was not open for its A/B checks")
		return
	var saved: Dictionary = sim.to_dict()
	var fv = main._fence
	main.show_room(main.MARKET)
	# A: an upgrade on what's worn is kept back from its rarity's row
	sim.equipped["Helmet"] = null
	sim.stash.clear()
	var up: Dictionary = sim._plain("Helmet", "Hard hat")
	up["rarity"] = 1
	var part: Dictionary = sim._plain(Data.ATTACHMENT, "Red dot")
	part["rarity"] = 1
	var med: Dictionary = sim._plain(Data.MEDICAL, "Bandage")
	med["rarity"] = 1
	var box: Dictionary = sim._plain(Data.AMMO, "Nails")
	box["rarity"] = 1
	sim.stash.append_array([up, part, med, box])
	var sp: Array = sim.rarity_spare(1)
	_check(int(sp[0]) == 1 and int(sp[2]) == 1 and int(sp[1]) == sim.sell_price(part), "the uncommon row did not keep the upgrade back: %s" % str(sp))
	fv._show("shelf")
	fv._sell._shown = ""
	main.refresh()
	var row: Dictionary = fv._sell.row_of(1)
	_check(row["count"].text.contains("kept") and not row["sell"].disabled, "the uncommon row does not say the upgrade's kept: '%s'" % row["count"].text)
	_check(fv._sell.row_of(3)["sell"].disabled and fv._sell.row_of(3)["worth"].text == "–", "a rarity with nothing spare can still sell")
	_check_fit(main, "Fence A (an upgrade kept)")
	# a part says which of your guns it fits, a line a gun
	fv._show("stash")
	fv._on_pick(int(part["id"]), "stash")
	main.refresh()
	_check(fv._right_title.text.begins_with("Fits"), "a part does not say what it fits: '%s'" % fv._right_title.text)
	var g0 = sim.equipped.get("Primary", null)
	if g0 != null:
		_check(fv._right_lines[0].text.begins_with(str(g0["base"])), "the part's first line is not the primary: '%s'" % fv._right_lines[0].text)
	_check_fit(main, "Fence A (a part picked)")
	fv._show("shelf")
	fv._sell._sell(1)
	fv._sell._sell(1)     # the press asks twice now (25 Oct, the review)
	_check(sim.stash.has(up) and not sim.stash.has(part) and sim.stash.has(med) and sim.stash.has(box), "selling the uncommons took the upgrade, a med or rounds, or left the part")
	# the boxes: the primary's rounds first and lit
	if g0 != null and Items.ammo_type(g0) in fv._sell.TYPES:
		fv._sell._shown = ""
		main.refresh()
		var b0: Dictionary = fv._sell.box_of(0)
		_check(b0["type"] == Items.ammo_type(g0) and (b0["panel"].get_theme_stylebox("panel") as StyleBoxFlat).border_color == Pal.ACCENT, "the first box is not the primary's, lit: %s" % str(b0["type"]))
		var unlit: Dictionary = fv._sell.box_of(2)
		_check(not fv._sell.worn_types().has(unlit["type"]) or fv._sell.worn_types().size() > 2, "an unworn box sits before a worn one")
	# B: the marks, the swap, the pick handed in
	sim.stash.clear()
	sim.contracts[0] = {"kind": "gear", "slot": "Helmet", "rarity": 1, "count": 2, "level": 0, "stat": "", "pay": "scrap", "amount": 20, "salvage": ""}
	var hats: Array = []
	for v in [10, 20, 30]:
		var h: Dictionary = sim._plain("Helmet", "Hard hat")
		h["rarity"] = 1
		h["value"] = v
		hats.append(h)
	var other: Dictionary = sim._plain(Data.ATTACHMENT, "Red dot")
	sim.stash.append_array(hats + [other])
	fv._show("contracts")
	fv._pick_contract(0)
	main.refresh()
	var ids: Array = hats.map(func(h): return int(h["id"]))
	var mk: Dictionary = fv._contract_marks()
	_check(mk.get(ids[0]) == "go" and mk.get(ids[1]) == "go" and mk.get(ids[2]) == "could" and mk.get(int(other["id"])) == "dim", "the contract's marks are off: %s" % str(mk))
	var cell_mark := ""
	for c in fv._stash._cells:
		if c.visible and c.id == ids[0]:
			cell_mark = c.mark
	_check(cell_mark == "go", "the cheapest hat's cell is not marked to go: '%s'" % cell_mark)
	var first3: Array = fv._stash.items.slice(0, 3).map(func(x): return int(x["id"]))
	_check(first3.slice(0, 2).all(func(i): return mk.get(i) == "go") and mk.get(first3[2]) == "could", "the stash does not put what goes, then what would do, first: %s" % str(first3))
	_check(fv._left_lines[0].text.begins_with("For ") and fv._right_lines[0].text != "", "the hand-in's ask or its worth is off: '%s' / '%s'" % [fv._left_lines[0].text, fv._right_lines[0].text])
	_check(fv._left_lines[1].text.begins_with("The two") or fv._left_lines[1].text == "The cheapest go first", "the hand-in does not say the cheapest go: '%s'" % fv._left_lines[1].text)
	_check_fit(main, "Fence B (marks)")
	# the dearest one picked goes, the dearer of the two going steps out
	fv._on_pick(ids[2], "stash")
	mk = fv._contract_marks()
	_check(mk.get(ids[0]) == "go" and mk.get(ids[2]) == "go" and mk.get(ids[1]) == "could", "the swap in did not put out the dearer: %s" % str(mk))
	_check(fv._left_lines[1].text == "Your pick" and fv._stash.selected == -1, "the swap does not read as your pick: '%s'" % fv._left_lines[1].text)
	# one going picked stays, the next that fits stepping in
	fv._on_pick(ids[0], "stash")
	mk = fv._contract_marks()
	_check(mk.get(ids[0]) == "could" and mk.get(ids[1]) == "go" and mk.get(ids[2]) == "go", "the swap out did not bring the next in: %s" % str(mk))
	# a cell that won't do changes nothing
	fv._on_pick(int(other["id"]), "stash")
	_check(fv._contract_marks() == mk, "a part swapped into a helmet contract")
	_check_fit(main, "Fence B (swapped)")
	var scrap0: int = sim.scrap
	fv._hand_contract(0)
	_check(sim.scrap == scrap0 + 20 and sim.stash.has(hats[0]) and not sim.stash.has(hats[1]) and not sim.stash.has(hats[2]), "the pick was not what went")
	_check(not fv._go.has(0), "the pick outlived the contract")
	# the review (19 Oct): a pick belongs to its contract - a pass ends it; one picked sold, the gap fills cheapest
	# first but never with what was kept back
	sim.stash.clear()
	sim.contracts[0] = {"kind": "gear", "slot": "Helmet", "rarity": 1, "count": 2, "level": 0, "stat": "", "pay": "scrap", "amount": 20, "salvage": ""}
	hats.clear()
	for v in [10, 20, 30, 5]:
		var h: Dictionary = sim._plain("Helmet", "Hard hat")
		h["rarity"] = 1
		h["value"] = v
		hats.append(h)
	sim.stash.append_array(hats.slice(0, 3))
	ids = hats.map(func(h): return int(h["id"]))
	fv._pick_contract(0)
	fv._on_pick(ids[2], "stash")            # 10 and 30 go, 20 kept back
	fv._on_pick(ids[0], "stash")            # 10 kept back too: 20 has to come back in
	var go_now: Array = fv._contract_go(0).map(func(x): return int(x["id"]))
	_check(go_now.has(ids[1]) and go_now.has(ids[2]), "swapping out with nothing else left did not bring the kept one back: %s" % str(go_now))
	sim.stash.append(hats[3])
	sim.sell(hats[1])
	go_now = fv._contract_go(0).map(func(x): return int(x["id"]))
	_check(go_now.has(ids[2]) and go_now.has(ids[3]) and not go_now.has(ids[0]), "a picked one sold let a kept-back one in: %s" % str(go_now))
	sim.passes = 0
	fv._pass(0)
	sim.contracts[0] = {"kind": "gear", "slot": "Helmet", "rarity": 1, "count": 2, "level": 0, "stat": "", "pay": "scrap", "amount": 20, "salvage": ""}
	main.refresh()
	_check(fv._contract_go(0) == sim.contract_items(sim.contracts[0]) and not fv._go.has(0), "a pick outlived its contract's pass")
	fv._on_pick(ids[2], "stash")
	sim.load_dict(sim.to_dict())
	_check(fv._contract_go(0) == sim.contract_items(sim.contracts[0]), "a pick outlived a load")
	sim.load_dict(saved)
	fv._show("shelf")
	main.refresh()
	print("fence A/B ok: upgrades kept, boxes lit, parts' fit, marks, swap, the pick handed in")


## Run held signal `k` and win it outright (the fight and any head done at once), home again.
func _win_signal(sim, k: int) -> void:
	sim.hp = sim.max_hp()
	if not sim.deploy_signal(k):
		_check(false, "signal %d didn't set off" % k)
		return
	sim.mission["remaining"] = 0
	if sim.mission.has("boss"):
		sim.mission["boss"]["alive"] = false
	sim._clear(sim.mission, sim.mission["t"])
	sim.extract_now()


## What a click at `at` lands on, as Godot's GUI picks it: the last-drawn visible control under the point that doesn't
## ignore the mouse, its children before it, a clipping control's children only inside it.
## Shown all the way up (is_visible_in_tree reads false headless, with no window to be in).
func _hidden_at(c: Node) -> String:
	var n: Node = c
	while n is CanvasItem:
		if not (n as CanvasItem).visible:
			return "%s (%s)" % [n.name, n.get_class()]
		n = n.get_parent()
	return "nowhere, in the tree %s" % str(c.is_inside_tree())


func _shown(c: Node) -> bool:
	var n: Node = c
	while n is CanvasItem:
		if not (n as CanvasItem).visible:
			return false
		n = n.get_parent()
	return true


func _click_target(c: Control, at: Vector2) -> Control:
	if not c.visible:
		return null
	if c.clip_contents and not c.get_global_rect().has_point(at):
		return null
	for k in range(c.get_child_count() - 1, -1, -1):
		var ch = c.get_child(k)
		if ch is Control:
			var hit: Control = _click_target(ch, at)
			if hit != null:
				return hit
	if c.mouse_filter != Control.MOUSE_FILTER_IGNORE and c.get_global_rect().has_point(at):
		return c
	return null


## "" when a click on `b`'s middle reaches it (it, or a child of it that passes the click up); else what takes it.
func _click_blocker(top: Control, b: Control) -> String:
	var hit: Control = _click_target(top, b.get_global_rect().get_center())
	if hit == b:
		return ""
	if hit != null and b.is_ancestor_of(hit):
		var n: Node = hit
		while n != b:
			if (n as Control).mouse_filter == Control.MOUSE_FILTER_STOP:
				return "%s (%s, inside it, stops the mouse)" % [n.name, n.get_class()]
			n = n.get_parent()
		return ""
	return "nothing" if hit == null else "%s (%s) under %s" % [hit.name, hit.get_class(), hit.get_parent().name]




## Every visible button that takes the mouse gets a click on its middle (20 Oct: the Site guide's tabs and close were
## covered by its own pages and never did; the smoke had only ever emitted pressed). Only inside a panel sized in code
## (`within`): the smoke's main is never in the tree, so whatever's laid out by anchors has no size to read.
func _check_clicks(main, where: String, within: Control = null) -> void:
	var stack: Array = [main if within == null else within]     # `within`: an overlay's own buttons (what's under it is meant to be covered)
	while not stack.is_empty():
		var n = stack.pop_back()
		for ch in n.get_children():
			stack.append(ch)
		if n is BaseButton and _shown(n) and n.mouse_filter != Control.MOUSE_FILTER_IGNORE and n.get_global_rect().has_area():     # disabled too: what covers it now covers it once it's on (the review)
			var bl: String = _click_blocker(main, n)
			_check(bl == "", "%s: '%s' doesn't take the click: %s is over it" % [where, str(n.get("text")), bl])


## Every part's name in every kind of slot it can sit in (20 Oct, Matt: "Hundre" in the Magazine slot): the whole name
## or its first word, never a word cut, inside its box.
func _part_name_checks(main) -> void:
	var W = main._workshop
	var labels: Array = []
	for slot in W._guns:
		for r in W._guns[slot]["rows"]:
			labels.append(r["fitted"])
			break
	for slot in W._socks:
