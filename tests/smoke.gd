## The away card's sim, for its clock alone (the fix round, 30 Oct): a repeat's time left past the hour.
class _FakeAway:
	var left := 0.0
	func away() -> bool:
		return true
	func repeat_progress() -> Dictionary:
		return {"site": 1, "n": 2, "of": 40, "share": 0.1, "left": left, "bails": 0, "out": true, "stop": false, "first": false}


## The fix round's UI oddities (30 Oct, docs/review30.md "UI oddities", builder C): the ask-twice of the hands and the
## hold-up on arm.gd's 4 s and cleared on hide, the walk-away's singular, the repeat's clock past the hour and its lines,
## "rate of fire", the held-up log's dash, the top bar away between runs, the report's chips never dropped, a hidden cargo
## slot free, one duration helper, the version in CLAUDE.md. `-- only ui30c`. Each fails without its fix.
func _ui30c_checks(main) -> void:
	var sim = main.sim
	var E: Dictionary = Words.EXPEDITIONS
	if sim.on_mission():
		sim.extract_now()
	sim.mission = null
	sim.repeat = {}
	sim.repeat_report = {}
	sim.odds_budget = 0
	var saved: Dictionary = sim.to_dict()
	sim.expeditions = []
	sim.hands = []
	sim.hand_pool = []
	var home: String = sim.cls
	var lead: String = "Scrapper" if home != "Scrapper" else "Drifter"
	if not sim.roster.has(lead):
		_check(sim.set_class(lead) and sim.set_class(home), "the fixture: no lead")
	_exp_strong_lead(sim, lead)
	for i in range(Data.TIERS.size()):
		sim.best_depth[i] = maxi(1, int(sim.best_depth[i]))
	for z in range(sim.bosses_beaten.size()):
		sim.bosses_beaten[z] = true
	sim.yard_open = maxi(sim.yard_open, 5)
	sim.cash = 1e9
	sim.scrap = 50000
	sim.salvage["copper"] = 400
	sim.salvage["army"] = 999
	sim.yard_picks.erase("bunkhouse")
	sim._yard_dirty = true
	for c in range(5):
		_check(sim.yard_pick("bunkhouse", c, "b"), "the fixture: line B step %d: '%s'" % [c + 1, sim.yard_pick_block("bunkhouse", c, "b")])
	var hr := RandomNumberGenerator.new()
	hr.seed = 3003
	var h1: Dictionary = Items.roll_hand(5, hr, 0.0, true, "porter", sim.exp_place_keys())
	sim.hand_pool.append(h1)
	_check(sim.hire_hand(int(h1["id"])), "the fixture: the porter wasn't hired: '%s'" % sim.hire_block(int(h1["id"])))
	# --- the hands' Let go: arm.gd's arm (4 s), a second press at 3.5 s still lets go; hidden, the arm's off
	main.show_room(main.OVERVIEW)
	main._yard_tree._pick_building("bunkhouse")
	main.refresh()
	var hp = main._yard_tree.hands
	_check(hp.visible, "the fixture: the Bunkhouse's hands aren't showing")
	_check("_arm" in hp and hp._arm is Arm, "the hands' Let go has an ask-twice of its own, not arm.gd's")
	if "_arm" in hp:
		hp.picked = int(h1["id"])
		hp._let_go()
		main.refresh()
		_check(sim.hands.has(h1) and hp._arm.holds(int(h1["id"])) and hp.let_go.text == E["let_go_again"], "the hands' first Let go didn't arm: '%s'" % hp.let_go.text)
		hp.visible = false                    # hidden (the smoke's window isn't drawn, so the room's hide doesn't reach it: the panel's own)
		_check(hp._arm.key == null, "the hands' Let go stayed armed with the panel hidden")
		hp.visible = true
		hp.picked = int(h1["id"])
		hp._let_go()
		hp._arm._at = Time.get_ticks_msec() - 3500     # 3.5 s on: past the old 3 s, inside the designer's 4
		hp._let_go()
		_check(not sim.hands.has(h1), "a second Let go 3.5 s after the first didn't let the hand go (arm.gd's window is %.1f s)" % Arm.WINDOW_S)
		_check(Arm.WINDOW_S == 4.0, "arm.gd's window isn't the designer's 4 s: %.1f" % Arm.WINDOW_S)
	sim.hand_pool.append(h1)
	_check(sim.hire_hand(int(h1["id"])), "the fixture: the porter wasn't hired back")
	# --- a hold-up with one hand: "Porter leaves", Walk away on arm.gd's arm, cleared on hide; the log's dash
	_check(_exp_go(sim, 0, lead, [int(h1["id"])], [{"kind": "scrap", "n": 2000}]), "the fixture: the hold-up's expedition didn't go: '%s'" % sim.exp_send_block(0, lead, [int(h1["id"])], [{"kind": "scrap", "n": 2000}]))
	var eh: Dictionary = sim.expeditions.back() if not sim.expeditions.is_empty() else {}
	_check(not eh.is_empty(), "the fixture: no expedition out")
	if not eh.is_empty():
		eh["hold"] = 1.0
		eh["risk"] = 0.0
		sim.advance(float(eh["dur"]) + 1.0)
		_check(str(eh["state"]) == "held", "the fixture: a sure hold-up came back")
		var log_l: String = str(sim.events.back()[1]) if not sim.events.is_empty() else ""
		_check(log_l.begins_with("Held up: ") and not log_l.contains(" - ") and not str(E["held_log"]).contains(" - "), "the held-up log has a spaced hyphen: '%s'" % log_l)
		var ER = load("res://scripts/ui/expedition_report.gd")
		var rep = ER.new()
		root.add_child(rep)
		rep.id = int(eh["id"])
		rep.show_state(sim)
		var walk_n: String = rep.ways[2]["note"].text
		_check(rep.visible and walk_n == E["walk_note_one"] % str(h1["base"]) and walk_n.contains("leaves for good"), "one hand's walk-away reads '%s'" % walk_n)
		_check(UI_v_width(rep.ways[2]["note"]) <= rep.ways[2]["note"].size.x + 0.5, "the walk-away note runs out of its box: '%s'" % walk_n)
		_check("_arm" in rep and rep._arm is Arm, "Walk away has an ask-twice of its own, not arm.gd's")
		if "_arm" in rep:
			rep._way(2)
			rep.show_state(sim)
			_check(str(eh["state"]) == "held" and rep._arm.holds(int(eh["id"])) and rep.ways[2]["button"].text == E["walk_again"], "the first Walk away didn't arm: '%s'" % rep.ways[2]["button"].text)
			rep.visible = false
			_check(rep._arm.key == null, "Walk away stayed armed with the report hidden")
			rep.visible = true
			rep._way(2)
			rep._arm._at = Time.get_ticks_msec() - 3500
			rep._way(2)
			_check(sim.exp_by_id(int(eh["id"])).is_empty() and not sim.hands.has(h1), "a second Walk away 3.5 s after the first didn't walk")
		rep.queue_free()
	sim.expeditions = []
	# --- a report with many finds: the tins and the tokens first, what doesn't fit a count, never dropped
	var finds: Array = []
	for sl in Data.SLOTS:
		for b in Data.BASES[sl]:
			if finds.size() < 40:
				finds.append(sim._plain(sl, str(b["name"])))
	var big: Dictionary = {"id": 9301, "place": 0, "lead": lead, "hands": [], "cargo": [], "worth": 1000.0, "odds": 1.0, "risk": 0.0, "hold": 0.0,
		"t0": sim.elapsed, "dur": 600.0, "state": "back", "quota": false, "seen": false,
		"res": {"bad": false, "loss": 0.0, "bonus": 0.0, "items": finds, "cur": {"tins": 4321.0, "tokens": 2}, "ups": [], "hurt": [], "lead_xp": 0.0}}
	sim.expeditions = [big]
	var ER2 = load("res://scripts/ui/expedition_report.gd")
	var rep2 = ER2.new()
	root.add_child(rep2)
	rep2.id = 9301
	rep2.show_state(sim)
	var chip_w: Array = []
	for k in range(rep2.got.shown()):
		chip_w.append(rep2.got.words(k))
	var all_n: int = finds.size() + 2
	var more_w: String = str(chip_w.back()) if not chip_w.is_empty() else ""
	var more_n: int = int(more_w.get_slice(" ", 0)) if more_w.ends_with(" more") else 0
	_check(rep2.visible and chip_w.size() >= 3 and chip_w.has(Fmt.money(4321.0)) and chip_w.has(E["tokens"] % [2, "s"]), "a full report dropped the tins or the tokens: %s" % str(chip_w))
	_check(more_n > 0 and chip_w.size() - 1 + more_n == all_n, "a full report's chips don't count what they leave off: %d shown + '%s' of %d" % [chip_w.size(), more_w, all_n])
	rep2.queue_free()
	sim.expeditions = []
	# --- a hidden cargo slot holds nothing: the next kind for the first can be what the hidden one had
	var EP = load("res://scripts/ui/expeditions_panel.gd")
	var ep = EP.new()
	ep.sim = sim
	var kinds: Array = sim.cargo_kinds()
	_check(kinds.size() >= 2, "the fixture: fewer than two cargo kinds held: %s" % str(kinds))
	if kinds.size() >= 2:
		var n_vis: int = sim.exp_slots([])
		var goods: Array = []
		for k in range(n_vis + 1):
			goods.append({"kind": "", "share": 1.0})
		goods[0]["kind"] = str(kinds[0])
		goods[n_vis]["kind"] = str(kinds[1])     # a slot a bigger party had, hidden now
		ep.set_pick(0, lead, [], goods)
		ep._next_kind(0)
		_check(str(ep.cargo[0]["kind"]) == str(kinds[1]), "a hidden cargo slot still counts as taken: the next after %s is '%s', not %s" % [kinds[0], ep.cargo[0]["kind"], kinds[1]])
	ep.free()
	# --- one duration helper: the board's and the report's
	_check(Fmt.dur(4800.0) == "1 h 20 min" and Fmt.dur(1800.0) == "30 min" and Fmt.dur(10800.0) == "3 h" and EP.dur(4800.0) == Fmt.dur(4800.0), "the expeditions' durations: '%s'" % Fmt.dur(4800.0))
	_check(not ER2.get_script_method_list().any(func(mi): return str(mi["name"]) == "_dur"), "the expedition report keeps its own duration helper")
	# --- the repeat's report: past the hour h:mm:ss; twelve runs, twelve lines; more, the first says which aren't shown
	sim.repeat = {}
	var RR = load("res://scripts/ui/repeat_report.gd")
	var rr = RR.new()
	root.add_child(rr)
	var mk_rep := func(n: int, t: float) -> Dictionary:
		var runs: Array = []
		for k in range(n):
			runs.append({"n": k + 1, "cleared": true, "kills": 3, "tins": 10.0})
		return {"site": 1, "time": t, "runs": runs, "ended": "done", "kept": [], "lv0": 10, "lv1": 10, "share": 0.25}
	sim.repeat_report = mk_rep.call(12, 8592.0)
	rr.show_state(sim)
	var shown_l: Array = rr.lines.filter(func(l): return l.visible and l.text != "")
	_check(rr.visible and rr.sub.text.ends_with("2:23:12") and not rr.sub.text.contains("143:"), "a repeat over the hour reads '%s'" % rr.sub.text)
	_check(rr.lines.size() == 2 * rr.LINES_ROWS and shown_l.size() == 12 and not shown_l.any(func(l): return l.text.contains("not shown")), "twelve repeat runs don't take the twelve lines: %d labels, %d shown, '%s'" % [rr.lines.size(), shown_l.size(), shown_l[0].text if not shown_l.is_empty() else ""])
	_check(rr.lines.all(func(l): return l.position.y + l.size.y <= rr.again.position.y), "a repeat line runs under the buttons")
	sim.repeat_report = mk_rep.call(13, 600.0)
	rr.unfolded = true
	rr.show_state(sim)
	shown_l = rr.lines.filter(func(l): return l.visible and l.text != "")
	_check(shown_l.size() == 12 and shown_l[0].text == Words.REPEAT["not_shown"] % 2 and shown_l.back().text.begins_with("Run 13 "), "thirteen repeat runs: '%s' … '%s'" % [shown_l[0].text if not shown_l.is_empty() else "", shown_l.back().text if not shown_l.is_empty() else ""])
	_check(RR.run_hidden(12) == 0 and RR.run_hidden(13) == 2 and Words.REPEAT["not_shown_one"] == "Run 1 not shown", "the hidden runs: %d at 12, %d at 13" % [RR.run_hidden(12), RR.run_hidden(13)])
	rr.queue_free()
	sim.repeat_report = {}
	# the away card's time left past the hour
	var AC = load("res://scripts/ui/away_card.gd")
	var ac = AC.new()
	root.add_child(ac)
	var fake := _FakeAway.new()
	fake.left = 8592.0
	ac.show_state(fake)
	_check(ac.left_l.text.contains("2:23:12") and not ac.left_l.text.contains("143:"), "the away card's time left over the hour reads '%s'" % ac.left_l.text)
	_check(UI_v_width(ac.left_l) <= ac.left_l.size.x + 0.5, "the away card's time left runs out of its box: '%s'" % ac.left_l.text)
	ac.queue_free()
	# --- the top bar between repeat runs: away, at the site, not resting
	sim.repeat = {"site": 1, "of": 5, "done": 1, "phase": "rest", "stop": false, "bails_row": 0, "bails": 0, "runs": [], "kept": [], "ups": {},
		"t0": sim.elapsed - 600.0, "run_t0": sim.elapsed - 600.0, "lv0": sim.level(), "wounds0": {}, "share": 0.25, "own_list": false}
	main.show_room(main.MISSIONS)
	main.refresh()
	var where_t: String = main._top_glyphs["where"].tooltip_text     # the bar's place in full (the bar drops "Away: " when it's tight)
	_check(sim.away() and not sim.on_mission() and where_t == "Away: " + str(Data.TIERS[1]["name"]), "the top bar between repeat runs reads '%s'" % where_t)
	sim.hp = sim.max_hp() * 0.5                # hurt between runs: away, and the rest's time beside it
	main.refresh()
	where_t = main._top_glyphs["where"].tooltip_text
	_check(where_t.begins_with("Away: " + str(Data.TIERS[1]["name"]) + " · full in ") and not where_t.contains("Resting"), "the top bar resting between repeat runs reads '%s'" % where_t)
	sim.hp = sim.max_hp()
	sim.repeat = {}
	main.refresh()
	# --- "rate of fire", never "RoF": the pick's deltas and the gloves' short unit
	var rate_g: Dictionary = {}
	var other_g: Dictionary = {}
	for b in Data.BASES["Gloves"]:
		var g: Dictionary = sim._plain("Gloves", str(b["name"]))
		if Items.role(g) == "rate" and rate_g.is_empty():
			rate_g = g
		elif Items.role(g) != "rate" and other_g.is_empty():
			other_g = g
	_check(not rate_g.is_empty() and not other_g.is_empty(), "the fixture: no rate-of-fire gloves, or none other")
	if not rate_g.is_empty() and not other_g.is_empty():
		var dd: Array = PickPanel.deltas_of(rate_g, other_g)
		_check(dd.any(func(d): return str(d[1]).ends_with("rate of fire")) and not dd.any(func(d): return str(d[1]).contains("RoF")), "the gloves' deltas: %s" % str(dd))
		_check(Items.glove_unit_short(rate_g) != "RoF" and not Items.glove_unit_short(rate_g).contains("RoF"), "the gloves' short unit is '%s'" % Items.glove_unit_short(rate_g))
	# --- the build code's copy goes to the test clipboard, never the system's, while the smoke runs
	main.show_room(main.BARRACKS)
	var bk = main._barracks
	bk.copied = ""
	bk._copy_code()
	_check(bk.clip_off and bk.copied == sim.build_code() and bk.copied != "", "the build code's copy missed the test clipboard: '%s'" % bk.copied)
	# --- the version in CLAUDE.md is the game's
	var cf := FileAccess.open("res://CLAUDE.md", FileAccess.READ)
	var cmd: String = cf.get_as_text() if cf != null else ""
	var ver: String = str(load("res://scripts/ui/menu.gd").VERSION)
	_check(cmd.contains("%s is current" % ver), "CLAUDE.md's current version isn't the game's %s" % ver)
	sim.load_dict(saved)
	sim.expeditions = []
	sim.hands = []
	sim.hand_pool = []
	main.refresh()
	print("the fix round's UI oddities ok (builder C, 30 Oct)")


## The art inventory (the fix round, 30 Oct, the tests review): the asserts that a picture is in the copy, apart from the
## logic checks so a missing file reads as what it is. The cloud copy's art can trail the designer's machine.
func _art_inventory_checks(main) -> void:
	var sim = main.sim
	_check(Items.art(sim._plain(Data.PAPER, "A P45")) != null and Items.art(sim._plain(Data.PAPER, "A boarding pass")) == Items.art(sim._plain(Data.PAPER, "A P45")), "art: papers have no picture in the cell, or not the same one")
	_check(Items.art(sim._plain("Secondary", "Legation machine pistol")) != null and Items.art(sim._plain("Armour", "Turnout coat")) != null, "art: a renamed base lost its picture")
	var n := 0
	for u in Data.ISSUED:
		n += 1
		_check(Items.art(sim.issued_piece(str(u["slot"]))) != null, "art: no picture for the %s" % u["name"])
	_check(n > 0, "art: no issued kit to look for")


## Kev's wagers, every word and every pay through the take path (the fix round, 30 Oct, the tests review: quality and the
## slot pay were never asserted, hard and no meds only when the seeded offer held them): each found on an offer there,
## taken as the panel takes it, and its effect read off the run it goes on.
func _wager_take_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	sim.mission = null
	sim.repeat = {}
	var nsite := 1
	var depth_was: int = int(sim.best_depth[nsite])
	var wagers_was: Dictionary = sim.wagers.duplicate(true)
	var key: String = sim.wager_site_key(nsite)
	var wants: Array = []
	for c in Data.WAGER_CONDS:
		wants.append(["cond", str(c["id"])])
	for p in Data.WAGER_PAYS:
		wants.append(["pay", str(p["id"])])
	var met := 0
	for want in wants:
		var found := false
		for sq in range(200):
			if found:
				break
			sim.wagers[key] = {"seq": sq, "taken": []}
			var of: Array = sim.wager_offer(key)
			for k in range(of.size()):
				if found or str(of[k][want[0]]) != want[1]:
					continue
				found = true
				sim.best_depth[nsite] = 0
				sim.hp = sim.max_hp()
				_check(sim.wager_site_open(nsite) and sim.take_wager(key, k) and sim.wager_taken(key, k), "the fixture: Kev's %s wager wasn't taken" % want[1])
				var w: Dictionary = of[k]
				var plain_t: Dictionary = sim.effective(nsite)
				var clock0: float = sim.clock_budget(plain_t)
				sim.deploy(nsite)
				var m = sim.mission
				_check(m != null and m.has("wagers") and m["wagers"].size() == 1, "the fixture: the %s wager didn't go on the run" % want[1])
				if m == null:
					continue
				met += 1
				match want[1]:
					"gang":
						_check(int(m["t"]["pool"]) == ceili(float(plain_t["pool"]) * Data.WAGER_GANG) and is_equal_approx(float(m.get("wager_gang", 1.0)), Data.WAGER_GANG), "the gang wager: pool %d against %d" % [int(m["t"]["pool"]), int(plain_t["pool"])])
					"no_meds":
						var bd: Dictionary = sim._plain(Data.MEDICAL, "Bandage")
						sim.rig.append(bd)
						sim.hp = sim.max_hp() * 0.3
						_check(bool(m["t"].get("no_meds", false)) and not sim.use_med(int(bd["id"])), "the no-meds wager: a med went in")
						sim.rig.erase(bd)
					"clock":
						_check(is_equal_approx(float(m["clock"]), clock0 * Data.WAGER_CLOCK), "the clock wager: %.1f against %.1f" % [float(m["clock"]), clock0])
					"hard":
						_check(is_equal_approx(float(m["t"]["dps"]), float(plain_t["dps"]) * Data.WAGER_HARD), "the hard wager: %.2f against %.2f" % [float(m["t"]["dps"]), float(plain_t["dps"])])
					"notes":
						_check(is_equal_approx(float(m.get("wager_notes", 1.0)), 1.5), "the notes wager not marked")
					"slot":
						var sl: String = str(w["slot"])
						_check(sl in Data.WAGER_SLOTS and int(m.get("wager_slots", {}).get(sl, 1)) == 3, "the slot wager: %s" % str(m.get("wager_slots", {})))
						var got := 0
						for j in range(60):
							var f: Dictionary = sim._find(m, m["t"], false, {"slots": [sl], "lean": 1.0})
							if str(f.get("it", {}).get("slot", "")) == sl and not f["it"].has("unique") and not f["it"].get("mythic", false):
								got += 1
						_check(got > 0 and int(m.get("wager_finds", 0)) == 2 * got, "the slot wager: %d %s finds, %d more" % [got, sl, int(m.get("wager_finds", 0))])
						m["found"] = []
					"quality":
						_check(is_equal_approx(float(m["t"].get("rarity", 0.0)), float(plain_t.get("rarity", 0.0)) + 0.5), "the quality wager: %.2f against %.2f" % [float(m["t"].get("rarity", 0.0)), float(plain_t.get("rarity", 0.0))])
				if sim.mission != null:
					sim.extract_now()
		_check(found, "no offer with Kev's %s in 200" % want[1])
	_check(met == wants.size() and wants.size() == Data.WAGER_CONDS.size() + Data.WAGER_PAYS.size(), "Kev's wagers met through the take path: %d of %d" % [met, wants.size()])
	sim.best_depth[nsite] = depth_was
	sim.wagers = wagers_was
	sim.hp = sim.max_hp()


## Another class's runner to lead, for the fixtures: one played, else made.
func _qm_zone() -> int:
	for b in Data.BOSSES:
		if str(b["name"]) == "The Quartermaster":
			return int(b["zone"])
	return -1


func _exp_other_lead(sim, not_this: String, home: String) -> String:
	for c in ["Poacher", "Paramedic", "Recruit", "Drifter", "Scrapper", "Doorman"]:
		if c != not_this and c != home and sim.roster.has(c) and not sim.lead_out(c):
			return c
	for c in ["Poacher", "Paramedic", "Recruit"]:
		if c != not_this and c != home and not sim.roster.has(c):
			if sim.set_class(c) and sim.set_class(home):
				return c
	return not_this


## A send for the checks: the place's odds read for the lead first (the send waits on a settled read, as the gate does).
func _exp_go(sim, p: int, lead: String, hs: Array, goods: Array, slot := "") -> bool:
	if lead != sim.cls and sim.roster.has(lead) and not sim.on_mission():
		sim.exp_odds(p, lead)
	return sim.send_expedition(p, lead, hs, goods, slot)


## The expeditions' fix round (29 Oct, review 29d: game A1-A5 and B1-B6, the UI's A and B, the tools review's survivors):
## the economy (no place returns more than ~1.0x the cargo at the best hands; crates from the cargo; the scrap round trip
## shut), the quota's week and kinds, the Issue, the fetch and the ransom, the leads' XP, the far place's fight pinned, the
## words and the screens, the bot shipping for real. Each check fails without its fix.
func _expeditions_fix_checks(main) -> void:
	var sim = main.sim
	var E: Dictionary = Words.EXPEDITIONS
	if sim.on_mission():
		sim.extract_now()
	sim.mission = null
	sim.repeat = {}
	sim.odds_budget = 0
	sim.candidates = []
	sim.expeditions = []
	sim.hands = []
	sim.hand_pool = []
	sim.issued = false
	sim.mythics_on = false
	sim.elapsed = maxf(sim.elapsed, 40.0 * 3600.0)     # prices risen: the inflation checks read it
	var home: String = sim.cls
	var lead: String = "Scrapper" if home != "Scrapper" else "Drifter"
	if not sim.roster.has(lead):
		_check(sim.set_class(lead) and sim.set_class(home), "the fixture: no lead")
	_exp_strong_lead(sim, lead)
	for i in range(Data.TIERS.size()):
		sim.best_depth[i] = maxi(1, int(sim.best_depth[i]))
	for z in range(sim.bosses_beaten.size()):
		sim.bosses_beaten[z] = true
	sim.yard_open = maxi(sim.yard_open, 5)
	sim.cash = 1e9
	sim.salvage["army"] = 999
	sim.yard_picks.erase("bunkhouse")
	sim._yard_dirty = true
	for c in range(5):
		_check(sim.yard_pick("bunkhouse", c, "b"), "the fixture: line B step %d: '%s'" % [c + 1, sim.yard_pick_block("bunkhouse", c, "b")])
	# the full step count after the Quartermaster: every step, line B's in (the tools review's B4: nothing pinned it)
	_check(sim.yard_steps() == Data.YARD.size() * 10, "the Pitch's steps after the Quartermaster: %d, not %d" % [sim.yard_steps(), Data.YARD.size() * 10])
	var hr := RandomNumberGenerator.new()
	hr.seed = 2929
	var keys: Array = sim.exp_place_keys()
	var mk := func(trade: String, affs: Array, lv := 1, rarity := 4, tier := 9) -> Dictionary:
		var h: Dictionary = Items.roll_hand(tier, hr, 0.0, true, trade, keys)
		h["rarity"] = rarity
		h["lv"] = lv
		h["affixes"] = affs
		sim.hands.append(h)
		return h
	# --- the economy: the return at the best hands, over many rolls, at the hands' cap (EXP_RETURN x EXP_BONUS_CAP) and no
	# more; the average expedition's x1.2 (the designer's call, 31 Oct) is _b37g_checks'. Best: two Legendary level-10
	# porters with "+% finds" (raw ×2.2, capped).
	var p1: Dictionary = mk.call("porter", [{"stat": "x_finds", "value": 24, "tier": 5}], 10)
	var p2: Dictionary = mk.call("porter", [{"stat": "x_finds", "value": 24, "tier": 5}], 10)
	var c1: Dictionary = mk.call("cracker", [], 10)
	var c2: Dictionary = mk.call("cracker", [], 10)
	var best: Array = [int(p1["id"]), int(p2["id"])]
	var crack: Array = [int(c1["id"]), int(c2["id"])]
	_check(sim._exp_bonus_raw(best, 0) > Data.EXP_BONUS_CAP + 0.5 and is_equal_approx(sim.exp_bonus(best, 0), Data.EXP_BONUS_CAP), "the hands' bonus isn't capped: raw %.2f, %.2f" % [sim._exp_bonus_raw(best, 0), sim.exp_bonus(best, 0)])
	_check(sim.exp_bonus(crack, 0) > 1.0 and is_zero_approx(sim.exp_return_worth(1, 0.0, crack)), "the crackers' crates: a bonus on the cargo, nothing from nothing")
	var ratios: Array = []
	var parts_seen := 0
	for p in range(Data.EXP_PLACES.size()):
		var tot := 0.0
		var crack_tot := 0.0
		var n := 100
		for k in range(n):
			var e := {"place": p, "lead": lead, "hands": best, "worth": 100000.0, "res": {"loss": 0.0, "bonus": 0.0}, "slot": "Primary", "quota": false}
			sim._exp_roll_return(e)
			tot += _exp_tins_eq(sim, e["res"])
			parts_seen += e["res"]["items"].filter(func(it): return Items.is_attachment(it)).size()
			var ec := {"place": p, "lead": lead, "hands": crack, "worth": 100000.0, "res": {"loss": 0.0, "bonus": 0.0}, "slot": "Primary", "quota": false}
			sim._exp_roll_return(ec)
			crack_tot += _exp_tins_eq(sim, ec["res"])
		var r: float = tot / (n * 100000.0)
		var rc: float = crack_tot / (n * 100000.0)
		ratios.append("%s x%.2f (crackers x%.2f)" % [str(Data.EXP_PLACES[p]["short"]), r, rc])
		var cap_x: float = Data.EXP_RETURN * Data.EXP_BONUS_CAP
		_check(r <= cap_x * 1.08 and r >= cap_x * 0.9 and rc <= cap_x * 1.08, "%s returns x%.2f (crackers x%.2f) of the cargo at the best hands, not the cap's x%.2f" % [str(Data.EXP_PLACES[p]["short"]), r, rc, cap_x])     # the hands' cap holds (the average's x1.2 is _b37g_checks', 31 Oct)
	print("expeditions: return over cargo at the best hands, 100 rolls a place: %s" % ", ".join(ratios))
	_check(parts_seen > 0, "the Scrapper lead's share of gun parts never came back")
	var tiny := 0.0
	for k in range(200):
		var et := {"place": 1, "lead": lead, "hands": crack, "worth": sim.cargo_unit("scrap"), "res": {"loss": 0.0, "bonus": 0.0}, "slot": "Primary", "quota": false}
		sim._exp_roll_return(et)
		tiny += _exp_tins_eq(sim, et["res"])
	_check(tiny / 200.0 < 2.0 * sim.cargo_unit("scrap") * Data.EXP_RETURN * Data.EXP_BONUS_CAP, "one scrap with crackers came back %.0f against %.1f at the cap's x%.2f (the review's A3)" % [tiny / 200.0, sim.cargo_unit("scrap"), Data.EXP_RETURN * Data.EXP_BONUS_CAP])     # twice the return at the cap (31 Oct: EXP_RETURN 1.8 put the cap past x2)
	var big := {"place": 0, "lead": lead, "hands": [], "worth": 5e6, "res": {"loss": 0.0, "bonus": 0.0}, "slot": "Primary", "quota": false}
	sim._exp_roll_return(big)
	_check(big["res"]["items"].size() <= Data.EXP_ITEMS_MAX and int(big["res"]["cur"].get("scrap", 0)) > 0, "a big return past the find cap: %d finds" % big["res"]["items"].size())
	var cnt := 0
	for k in range(400):
		cnt += sim._exp_count(0.3)
	_check(cnt > 80 and cnt < 160, "a fraction's count isn't kept as a chance: %d of 400 at 0.3 (the review's B6)" % cnt)
	# the scrap round trip: a find scrapped and shipped never beats the Fence (the 28 Oct pump stays shut)
	var strip := _yard_pick_by_id(sim, "strip_for_parts")
	var it0: Dictionary = Items.roll("Primary", 4, hr, 0.5)
	var fence: float = float(sim.sell_price(it0))
	var shipped: float = sim.cargo_slot_worth("scrap", sim.scrap_yield(it0)) * Data.EXP_RETURN * Data.EXP_BONUS_CAP
	_check(strip and shipped <= fence * 1.0001, "a find scrapped and shipped beats the Fence: %.0f against %.0f" % [shipped, fence])
	_check(sim.cargo_unit("copper") <= sim.exchange_worth("copper") * (1.0 - sim.exchange_spread()) * sim.exchange_fixer() + 0.001, "cargo isn't valued at the exchange's give rate")
	# --- the inflation before the Issue: the wages, the rerolls, the ransom's floor and the quota's target at today's prices
	_check(sim.inflation() > 1.05, "the fixture: no inflation (%.2f)" % sim.inflation())
	var wh: Dictionary = mk.call("scout", [{"stat": "x_wage", "value": 20, "tier": 4}], 1, 2, 5)
	var base_w: float = Data.HAND_WAGE * 5 * float(Data.RARITIES[2]["value"])
	_check(sim.hand_wage(wh) == int(round(sim._inf(base_w) * 0.8)) and sim.hand_wage(wh) > int(round(base_w)), "a wage isn't at today's prices less its −20%%: %d (base %.0f)" % [sim.hand_wage(wh), base_w])
	_check(sim.reroll_cost(false) > Data.HAND_REROLL[0], "New faces at the old price: %d" % sim.reroll_cost(false))
	# --- the far place's fight, pinned (the tools review's B2): the host site, the place's gang, its level's depth; Swansea
	# off the campaign's depth 1 (the review's A2)
	var reach0: int = sim.reach
	for rv in [5, 14]:
		sim.reach = rv
		for p in range(Data.EXP_PLACES.size()):
			var pl: Dictionary = Data.EXP_PLACES[p]
			var sg: Dictionary = sim._exp_sig(p)
			var lv: int = maxi(int(pl["lv"]), rv + int(pl["reach"]))
			_check(int(sg["site"]) == Data.EXP_HOST and int(sg["zone"]) == int(pl["zone"]) and int(sg["depth"]) == maxi(2, lv - Sim.lv_at(Data.EXP_HOST, 1) + 1),
				"%s's fight at reach %d: %s" % [str(pl["short"]), rv, str([sg["site"], sg["zone"], sg["depth"]])])
	sim.reach = reach0
	# --- the hands' figures: scouts, drivers, the loader's slot, "never held up near", "−% hold-ups"
	var scout: Dictionary = mk.call("scout", [], 1, 4, 9)
	var driver: Dictionary = mk.call("driver", [], 1, 4, 9)
	var loader: Dictionary = mk.call("quartermaster", [], 1, 4, 9)
	var safe: Dictionary = mk.call("porter", [{"stat": "x_safe", "value": 1, "tier": 5, "place": "bristol"}, {"stat": "x_hold", "value": 50, "tier": 5}], 1)
	var o0: float = float(sim.exp_odds(0, lead)[0])
	_check(is_equal_approx(sim.exp_crew_odds(0, lead, [int(scout["id"])]), minf(1.0, o0 + Items.hand_fig(scout) / 100.0)) and Items.hand_fig(scout) > 0, "a scout's odds aren't added")
	_check(sim.exp_time(0, [int(driver["id"])]) < sim.exp_time(0, []), "a driver didn't shorten the time")
	_check(sim.exp_slots([int(loader["id"])]) == Data.EXP_SLOTS + Items.hand_fig(loader), "a loader's cargo slot: %d" % sim.exp_slots([int(loader["id"])]))
	_check(is_zero_approx(sim.exp_hold_chance(1, [int(safe["id"])], 0.5)) and is_equal_approx(sim.exp_hold_chance(0, [int(safe["id"])], 0.5), sim.exp_hold_chance(0, [], 0.5) * 0.5),
		"never held up near or −%% hold-ups doesn't bite: %.3f, %.3f" % [sim.exp_hold_chance(1, [int(safe["id"])], 0.5), sim.exp_hold_chance(0, [int(safe["id"])], 0.5)])
	# the tiers climb: Legendary hands roll their affixes past T3 now and then (the tools review's M40)
	var top := 0
	for k in range(60):
		var hh: Dictionary = Items.roll_hand(9, hr, 50.0, true, "", keys)
		for a in hh["affixes"]:
			top = maxi(top, int(a["tier"]))
	_check(top >= 4, "the hands' affixes never roll past T%d" % top)
	# --- Send stores the risk and the hold-up the functions give (the tools review's M15, M18, M24)
	sim.scrap = 200000
	var hs: Array = [int(scout["id"]), int(safe["id"])]
	_check(_exp_go(sim, 0, lead, hs, [{"kind": "scrap", "n": 2000}]), "the fixture: a send: '%s'" % sim.exp_send_block(0, lead, hs, [{"kind": "scrap", "n": 2000}]))
	var es: Dictionary = sim.expeditions.back()
	_check(is_equal_approx(float(es["odds"]), sim.exp_crew_odds(0, lead, hs)) and is_equal_approx(float(es["risk"]), sim.exp_risk(0, lead, hs, float(es["worth"]), float(es["odds"])))
		and is_equal_approx(float(es["hold"]), sim.exp_hold_chance(0, hs, float(es["risk"]))) and float(es["worth"]) > 0.0, "what Send stored isn't what the functions give: %s" % str([es["odds"], es["risk"], es["hold"]]))
	# a lead already out can't lead another (the tools review's M94)
	_check(sim.exp_send_block(1, lead, [], [{"kind": "scrap", "n": 10}]) == E["shut_lead_out"] % lead, "a lead out led a second: '%s'" % sim.exp_send_block(1, lead, [], [{"kind": "scrap", "n": 10}]))
	# the lead's XP: a repeat run's share of a run there, on the way home (the coordinator's call)
	var xp0: float = float(sim.roster[lead]["xp"])
	es["risk"] = 1.0
	es["hold"] = 0.0
	var t_res: float = sim.elapsed
	es["t0"] = sim.elapsed - float(es["dur"])
	sim._exp_tick()
	_check(float(es["xp_run"]) > 0.0 and is_equal_approx(float(sim.roster[lead]["xp"]) - xp0, float(es["xp_run"]) * sim.repeat_xp_share()), "the lead earned %.0f XP, not a repeat run's share of %.0f" % [float(sim.roster[lead]["xp"]) - xp0, float(es["xp_run"])])
	# hurt for as long as the expedition took, from its return (the tools review's M45, M46)
	_check(int(scout["id"]) in es["res"]["hurt"] and is_equal_approx(float(scout["hurt_until"]), t_res + float(es["dur"])), "hurt until %.0f, not %.0f" % [float(scout.get("hurt_until", -1.0)), t_res + float(es["dur"])])
	sim.exp_take(int(es["id"]))
	scout["hurt_until"] = -1.0
	# the level cap (M51)
	scout["xp"] = 100
	sim._exp_home({"id": -5, "place": 0, "lead": lead, "hands": [int(scout["id"])], "worth": 0.0, "dur": 1.0, "res": {"loss": 0.0}}, 0.0)
	_check(int(scout["lv"]) == Data.HAND_LV_MAX, "a hand past the level cap: %d" % int(scout["lv"]))
	# --- meds as cargo leave the stash (M12)
	for k in range(5):
		sim.stash.append(Items.roll(Data.MEDICAL, 1, hr))
	var meds0: int = sim.cargo_held("meds")
	_check(_exp_go(sim, 2, lead, [], [{"kind": "meds", "n": 3}]) and sim.cargo_held("meds") == meds0 - 3, "meds shipped didn't leave the stash: %d -> %d" % [meds0, sim.cargo_held("meds")])
	sim.expeditions = []
	# --- the hold-ups: the ransom is half of what's coming back after the roll, and the hand sent stays; a fetch brings
	# the return as rolled and the hands unhurt (the review's A4, D2, D3)
	scout["hurt_until"] = -1.0
	var held: Array = []
	for p in [1, 3]:
		var hh2: Dictionary = mk.call("driver", [], 1, 1, 3)
		_check(_exp_go(sim, p, lead if p == 1 else _exp_other_lead(sim, lead, home), [int(hh2["id"])], [{"kind": "scrap", "n": 3000}]), "the fixture: a hold-up's send at %d: '%s'" % [p, sim.exp_send_block(p, lead, [int(hh2["id"])], [{"kind": "scrap", "n": 3000}])])
	held = sim.expeditions.duplicate()
	_check(held.size() == 2, "the fixture: two held, not %d" % held.size())
	for e in held:
		e["risk"] = 1.0
		e["hold"] = 1.0
		e["t0"] = sim.elapsed - float(e["dur"])
	sim._exp_tick()
	var ea: Dictionary = held[0]
	var due: float = sim.exp_return_worth(int(ea["place"]), float(ea["worth"]), ea["hands"]) * (1.0 - float(ea["res"]["loss"]))
	_check(str(ea["state"]) == "held" and float(ea["res"]["loss"]) > 0.0 and sim.exp_ransom(int(ea["id"])) == int(round(maxf(Data.EXP_RANSOM_MIN * sim.inflation(), due * Data.EXP_RANSOM))),
		"the ransom isn't half of what's coming back: %d against %.0f" % [sim.exp_ransom(int(ea["id"])), due * Data.EXP_RANSOM])
	var ha: Dictionary = sim.hand_by_id(int(ea["hands"][0]))
	_check(sim.exp_pay(int(ea["id"])) and sim.hands.has(ha) and is_equal_approx(float(ea["res"]["total"]), due), "a ransom lost the hand, or the return isn't what was due")
	sim.exp_take(int(ea["id"]))
	if held.size() == 2:
		var eb: Dictionary = held[1]
		var loss_b: float = float(eb["res"]["loss"])
		var hb: Dictionary = sim.hand_by_id(int(eb["hands"][0]))
		sim.hp = sim.max_hp()
		_check(sim.exp_fetch(int(eb["id"])), "the fixture: the fetch: '%s'" % sim.exp_fetch_block(int(eb["id"])))
		if sim.on_mission():
			sim.mission["boss"]["alive"] = false
			sim.mission["cleared"] = true
			sim.extract_now()
		_check(str(eb["state"]) == "back" and loss_b > 0.0 and is_equal_approx(float(eb["res"]["loss"]), loss_b) and not sim.hand_hurt(hb) and eb["res"]["hurt"].is_empty(),
			"a fetch refunded the bad roll or hurt the hand: loss %.2f -> %.2f, hurt %s" % [loss_b, float(eb["res"]["loss"]), str(eb["res"].get("hurt", []))])
		sim.exp_take(int(eb["id"]))
	# --- the quota: a week of played hours, never scrap, its bonus on its own slot, its kinds frozen for the week, Take it
	# crediting what it pays (the review's B2, C6; the tools review's M60-M62, M89, M90)
	var w0: int = sim.exp_week()
	sim.elapsed += Data.EXP_WEEK_H * 3600.0
	_check(sim.exp_week() == w0 + 1, "the quota's week isn't %.0f hours played" % Data.EXP_WEEK_H)
	var kinds_seen := {}
	var el0: float = sim.elapsed
	for w in range(25):
