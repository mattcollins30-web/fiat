	sim.town_stopped = {}
	sim.load_dict(d)
	sim = main.sim
	_check(sim.town_stopped.keys() == ["library"], "a stopped place lost on a load: %s" % str(sim.town_stopped.keys()))
	sim.story_beat = keep["beat"]
	sim.rebuilt = keep["rebuilt"]
	sim.materials = keep["mats"]
	sim.key_items = keep["keys"]
	sim.cash = keep["cash"]
