	var k: int = shown.find(piece)
	if k < 0:
		for i in range(shown.size()):
			if is_same(shown[i], piece):
				k = i
	_check(k >= 0, "the rolled piece is not in the Craft view's grid")
	main.refresh()
	var piece_cell: int = ws._inv.cell_of(int(piece["id"]))     # its cell, not its place in the list (a bigger stash pages it: 13 Oct)
	if piece_cell < 0:
		for p in range(8):
			ws._inv._turn(1)
			main.refresh()
			piece_cell = ws._inv.cell_of(int(piece["id"]))
			if piece_cell >= 0:
				break
	_check(piece_cell >= 0, "the rolled piece has no cell in the Craft view")
	ws._pick_cell(maxi(0, piece_cell))
	_check(ws._piece_title.text != "Pick a piece", "picking a piece did not fill the piece card")
	_check(ws._piece_chips.words(1) == "Item level %d" % Items.ilvl(piece), "the piece card's level chip is wrong: %s" % ws._piece_chips.words(1))
	_check(ws._affix_rows[0]["tag"].text.begins_with("T2 ") and ws._affix_rows[0]["tag"].text.contains("–") and ws._affix_rows[0]["label"].text.begins_with("+20"), "the first affix row does not read the affix and its tier: '%s' %s" % [ws._affix_rows[0]["label"].text, ws._affix_rows[0]["tag"].text])
	_check(ws._affix_rows[2]["label"].text == "No third affix", "the missing third affix's row is off: %s" % ws._affix_rows[2]["label"].text)
	# regen rolls in tenths (the pass, 20 Oct): T1 0.2, T5 0.9-1.0 at the campaign's levels; the row, its range and a compare read them so
	var rg_def: Dictionary = Items.affix_def("regen")
	var rg_rng := RandomNumberGenerator.new()
	rg_rng.seed = 7
	var rg1: Dictionary = Items.roll_affix(rg_def, 1, rg_rng, 1)
	var rg5: Dictionary = Items.roll_affix(rg_def, 1, rg_rng, 5)
	_check(typeof(rg1["value"]) == TYPE_FLOAT and is_equal_approx(float(rg1["value"]), 0.2) and float(rg5["value"]) >= 0.9 and float(rg5["value"]) <= 1.0, "regen does not roll in tenths: T1 %s, T5 %s" % [str(rg1["value"]), str(rg5["value"])])
	var rg_hold: Array = piece["affixes"].duplicate(true)
	piece["affixes"][0] = {"stat": "regen", "value": 0.4, "tier": 2}
	ws._shown = ""
	ws.show_state(sim)
	_check(ws._affix_rows[0]["label"].text.begins_with("+0.4") and ws._affix_rows[0]["tag"].text.begins_with("T2") and (ws._affix_rows[0]["tag"].text == "T2" or ws._affix_rows[0]["tag"].text.contains(".")), "a regen row does not read in tenths: '%s' %s" % [ws._affix_rows[0]["label"].text, ws._affix_rows[0]["tag"].text])
	var rg_other: Dictionary = piece.duplicate(true)
	rg_other["affixes"][0] = {"stat": "regen", "value": 0.7, "tier": 4}
	_check(PickPanel.deltas_of(rg_other, piece).any(func(d): return str(d[1]) == "0.3 HP/s"), "a regen compare does not read in tenths: %s" % str(PickPanel.deltas_of(rg_other, piece)))
	piece["affixes"] = rg_hold
	ws._shown = ""
	ws.show_state(sim)
	_check(ws._affix_buttons[0].visible and ws._affix_buttons[0].text.contains("tin") and not ws._affix_buttons[0].disabled, "the re-roll values button is not priced and live: %s" % ws._affix_buttons[0].text)
	_check(ws._job_tiles[ws.JOBS.find("bump")]["price"].text.ends_with("notes"), "the level tile is not priced in notes: %s" % ws._job_tiles[ws.JOBS.find("bump")]["price"].text)
	_check(ws._job_tiles[ws.JOBS.find("scrap")]["price"].text.begins_with("+") and ws._job_tiles[ws.JOBS.find("scrap")]["price"].text.ends_with("scrap"), "the scrap tile does not say what it gives: %s" % ws._job_tiles[ws.JOBS.find("scrap")]["price"].text)
	_check(ws._affix_buttons.all(func(b): return b.visible), "the two re-rolls aren't up on a piece with affixes")
	_check_fit(main, "Workshop (craft, piece picked)")
	# a padlock on the first affix (20 Oct): the two re-rolls inside the card, priced, the lock line saying it
	piece["locks"] = []
	ws._toggle_lock(0)
	_check(sim.locks_of(piece) == [piece["affixes"][0]["stat"]] and ws._affix_buttons[0].visible and ws._affix_buttons[1].visible, "a padlock on the first affix: %s" % str(sim.locks_of(piece)))
	_check(ws._affix_buttons[1].position.x + ws._affix_buttons[1].size.x <= ws.BODY_W - ws.PAD + 0.5, "the re-rolls run off the piece card")
	_check(ws._affix_buttons[0].text.contains("tin") and ws._affix_buttons[1].text.contains("tin"), "the re-rolls carry no price")
	_check_fit(main, "Workshop (craft, a padlock on)")
	# the job runs in the room: new affixes keep the count and the locked one, the foot says what was done
	var before_affixes: int = piece["affixes"].size()
	var kept0: Dictionary = piece["affixes"][0].duplicate()
	ws._press_affix_job(1)
	main.refresh()
	var after: Dictionary = sim.item_by_id(piece["id"])
	_check(after.get("affixes", []).size() == before_affixes and after["affixes"][0] == kept0, "new affixes in the room changed the count or the locked one")
	_check(ws._foot.text.begins_with("Kept") or ws._foot.text.begins_with("New") or ws._foot.get_theme_color("font_color") == Pal.GOOD, "the jobs' foot does not say what the Bench did: %s" % ws._foot.text)
	_check(not main._menu.visible, "a job in the room opened the menu")
	_check_fit(main, "Workshop (craft, after a job)")
	# scrap from the room: the piece goes, the foot says what it gave, nothing stays picked
	var scrap_before: int = sim.scrap
	var gave: int = sim.scrap_of(after)
	ws._press_job(ws.JOBS.find("scrap"))
	_check(sim.item_by_id(piece["id"]).is_empty() and sim.scrap == scrap_before + gave, "the scrap tile did not scrap the piece for %d" % gave)
	_check(ws.sel_id == -1 and ws._piece_title.text.begins_with("Pick a piece") and ws._foot.text.begins_with("Scrapped"), "after scrapping: picked %d, title '%s', foot '%s'" % [ws.sel_id, ws._piece_title.text, ws._foot.text])
	_check_fit(main, "Workshop (craft, after scrapping)")
	ws._set_view("guns")
	_check(not ws._piece.visible and not ws._jobs.visible, "the piece card stayed up on the Guns view")
	sim.load_dict(saved)
	print("craft view ok: stash gear only, the piece card, the priced tiles, the padlocks and the re-rolls, a job in the room")


## Every tree node's effect has a reader (16 Oct: Fumes, Cumulative and Nicked carried dot_pct and nothing read it from
## the tree): the sim's own source names each effect - a tree_sum, a has_node, or one of the element families' patterns
## ("%s_pct", "conv_%s_pct", "proof_" + the element) - and a damage-over-time node grows a burn as the same stat on gear.
func _tree_effect_checks(sim) -> void:
	var src := FileAccess.get_file_as_string("res://scripts/sim/sim.gd") + FileAccess.get_file_as_string("res://scripts/sim/items.gd")
	var els := ["fire", "frost", "poison", "shock", "bleed", "physical"]
	var orphans := []
	for t in Data.TREES + Data.ELEMENT_TREES:
		for n in t["nodes"]:
			var e := str(n.get("effect", ""))
			if e == "":
				continue
			var read := src.contains('tree_sum("%s")' % e) or src.contains('has_node("%s")' % e) or src.contains('node_active("%s")' % e)
			for el in els:
				if e == "%s_pct" % el:
					read = read or src.contains('tree_sum("%s_pct" % ty)')
				if e == "conv_%s_pct" % el:
					read = read or src.contains('tree_sum("conv_%s_pct" % ty)')
				if e == "proof_%s" % el:
					read = read or src.contains('has_node("proof_" + ty)')
				if e == "%s_res" % el:
					read = read or src.contains('tree_sum("%s_res" % ty)')          # the web's resist fillers (22 Oct)
				if e == "%s_last_pct" % el:
					read = read or src.contains('tree_sum("%s_last_pct" % ty)')     # Oil drum, Serrated, Deep freeze, Takes its time
			if e == "skill_" + str(n.get("skill", "")):
				read = read or (Data.SKILLS.has(str(n["skill"])) and src.contains('has_node("skill_" + id)'))     # the skill nodes, through skill_known (milestone 8)
			if not read and not (e in orphans):
				orphans.append("%s (%s)" % [e, n["name"]])
	_check(orphans.is_empty(), "tree effects nothing reads: %s" % ", ".join(orphans))
	# Fumes: +20% to a burn's growth, as 20% dot_pct on gear gives
	var keep_tree: Array = sim.tree.duplicate()
	var keep_cls: String = sim.cls
	sim.cls = "Drifter"
	sim.tree = []
	var a := {}
	sim._dot_add(a, "fire", 100.0, 1.0e9)
	var fumes := -1
	var petrol: Dictionary = Data.tree_named("Petrol")
	for k in range(petrol["nodes"].size()):
		if str(petrol["nodes"][k].get("effect", "")) == "dot_pct":
			fumes = k
	sim.tree = ["Petrol/%d" % fumes]
	var b := {}
	sim._dot_add(b, "fire", 100.0, 1.0e9)
	var gear: float = sim._affix_sum("dot_pct")      # what the kit already carries: the node adds to it, as an affix would
	var want: float = float(a["fire"]) * (1.0 + (gear + float(petrol["nodes"][fumes]["value"])) / 100.0) / (1.0 + gear / 100.0)
	_check(fumes >= 0 and is_equal_approx(float(b["fire"]), want), "Fumes didn't grow the burn: %.2f, wanted %.2f" % [float(b.get("fire", 0.0)), want])
	# and only theirs: a burn on the runner (their fire's, in my_dots) doesn't grow with the runner's own node
	var kept_mission = sim.mission
	var mine: Dictionary = {}
	sim.mission = {"my_dots": mine}            # only the pool's identity is read: no run is started for it
	sim._dot_add(mine, "fire", 100.0, 1.0e9)
	var with_node: float = float(mine.get("fire", 0.0))
	sim.tree = []
	mine.clear()
	sim._dot_add(mine, "fire", 100.0, 1.0e9)
	sim.mission = kept_mission
	_check(with_node > 0.0 and is_equal_approx(with_node, float(mine.get("fire", 0.0))), "Fumes grew a burn on the runner: %.2f against %.2f" % [with_node, float(mine.get("fire", 0.0))])
	# nor the gear's +% dots (17 Oct, Matt): a dot_pct affix grows a burn on them, not one on you
	var plain_on_you: float = float(mine.get("fire", 0.0))
	var dot_slot: String = "Charm" if sim.equipped.get("Charm") != null else "Helmet"
	var dot_kit: Dictionary = (sim.equipped[dot_slot] if sim.equipped[dot_slot] != null else sim._plain(dot_slot, Data.BASES[dot_slot][0]["name"])).duplicate(true)
	dot_kit["affixes"] = dot_kit["affixes"] + [{"stat": "dot_pct", "value": 50, "tier": 1}]
	var kept_kit = sim.equipped[dot_slot]
	sim.equipped[dot_slot] = dot_kit
	sim._dry_memo.clear()
	mine.clear()
	sim.mission = {"my_dots": mine}
	sim._dot_add(mine, "fire", 100.0, 1.0e9)
	var theirs_pool := {}
	sim._dot_add(theirs_pool, "fire", 100.0, 1.0e9)
	sim.mission = kept_mission
	sim.equipped[dot_slot] = kept_kit
	sim._dry_memo.clear()
	_check(is_equal_approx(float(mine.get("fire", 0.0)), plain_on_you) and float(theirs_pool.get("fire", 0.0)) > plain_on_you * 1.4, "the gear's +50%% dots: a burn on you %.2f (plain %.2f), on them %.2f" % [float(mine.get("fire", 0.0)), plain_on_you, float(theirs_pool.get("fire", 0.0))])
	# the one figure (16 Oct, item 14): damage_split's burn is what the pool deals a second once it settles, worked
	# against _dot_add and _dot_tick themselves; and a node's "+N a second" is the figure with it less without it
	var conv := -1
	for k in range(petrol["nodes"].size()):
		if str(petrol["nodes"][k].get("effect", "")) == "conv_fire_pct" and conv < 0:
			conv = k
	sim.tree = ["Petrol/%d" % conv, "Petrol/%d" % fumes]
	sim.mission = null
	var split: Dictionary = sim.damage_split()
	var fire_rate: float = float(sim.type_dps()["fire"])
	var pool := {}
	var dealt := 0.0
	for step in range(4000):
		sim._dot_add(pool, "fire", fire_rate * 0.05, fire_rate)
		dealt = sim._dot_tick(pool, 0.05, {})
	var settled: float = dealt / 0.05
	_check(conv >= 0 and fire_rate > 0.0 and absf(settled - float(split["dots"].get("fire", 0.0))) <= 0.02 * settled, "the split's burn %.1f isn't what the pool settles to, %.1f" % [float(split["dots"].get("fire", 0.0)), settled])
	_check(is_equal_approx(float(split["total"]), float(split["hits"]) + float(split["dot"])) and float(split["hits"]) > 0.0, "the split doesn't add up: %s" % str(split))
	var tree_before: Array = sim.tree.duplicate()
	var gain: Array = sim.node_damage_gain("Petrol/%d" % fumes)
	sim.tree = ["Petrol/%d" % conv]
	var without: float = float(sim.damage_split()["total"])
	sim.tree = tree_before.duplicate()
	_check(sim.tree == tree_before and is_equal_approx(float(gain[0]), float(split["total"]) - without) and float(gain[0]) > 0.0, "Fumes's +N a second isn't the figure with it less without: %s against %.1f" % [str(gain), float(split["total"]) - without])
	var gain2: Array = sim.node_damage_gain("Petrol/%d" % conv)     # untrained the other way: taken on, then put back
	_check(sim.tree == tree_before, "trying a trained node off reordered the tree: %s, was %s" % [str(sim.tree), str(tree_before)])
	sim.tree = ["Petrol/%d" % fumes]
	var gain3: Array = sim.node_damage_gain("Petrol/%d" % conv)
	_check(sim.tree == ["Petrol/%d" % fumes] and float(gain2[0]) > 0.0 and is_equal_approx(float(gain2[0]), float(gain3[0])), "a node's gain reads differently trained (%.1f) and not (%.1f)" % [float(gain2[0]), float(gain3[0])])
	var burn_shown: bool = float(split["dots"].get("fire", 0.0)) < 0.5 or sim.split_words(split).contains("%.0f burning" % float(split["dots"]["fire"]))     # a burn under half a point a second isn't named (a weak kit's)
	var any_dot: bool = split["dots"].values().any(func(v): return float(v) >= 0.5)
	var lead_ok: bool = sim.split_words(split).begins_with("%.0f from hits" % float(split["hits"])) and sim.split_words(split, true).begins_with("Hits ") if any_dot else sim.split_words(split).begins_with("All of it hits")
	_check(burn_shown and lead_ok, "the split's words: %s (burn %.2f)" % [sim.split_words(split), float(split["dots"].get("fire", 0.0))])
	sim.mission = kept_mission
	sim.tree = keep_tree
	sim.cls = keep_cls
	print("tree effects all read; Fumes grows the burn on them, not on you; the split's burn settles as the pool does ok")


## The trees' rules (9 Oct, docs/design/trees.md §8): the lanes match the table; every joint's two halves in
## the fourth column, open on one, closed on both, for its class alone; a class change's price and its two
## presses, free for a new runner; the camp's high-water mark; an old save's trees back as points, once.
func _tree_rules_checks(main) -> void:
	var sim = main.sim
	sim.core_gates = false            # Training's 15 Oct gates are _training_gate_checks'; this area tests the mechanics
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var bk = main._barracks
	var table := {"Drifter": ["Moving on", "Petrol", "Luck", "Live", "The Pitch"], "Scrapper": ["Stripping", "Live", "Fencing", "Petrol", "The Pitch"],
		"Poacher": ["Stalking", "The Rat Man", "Snares", "The cold", "The Pitch"], "Paramedic": ["Triage", "The Rat Man", "Shifts", "The cold", "The Pitch"],
		"Doorman": ["Muscle", "Blades", "The door", "Knuckles", "The Pitch"]}
	main.show_room(main.BARRACKS)
	for c in table:
		_set_cls(sim, c)
		bk.alt = ""
		bk._shown = ""
		main.refresh()
		# the web (22 Oct): every tree of the table's row is a region on the canvas, its class's two reachable at an entry
		var wv = bk.web()
		for tn in table[c]:
			if tn == "":
				continue
			_check(wv.layout.has("%s/0" % tn), "the %s's %s is not on the web" % [c, tn])
		_check(wv.state_of("%s/0" % table[c][0]).get("reach", false) or sim.tree.has("%s/0" % table[c][0]), "the %s's first tree's entry isn't reachable" % c)
	# a runner with no class: the Pitch alone reachable, and the Also row the pages
	sim.cls = ""
	sim.tree = []
	bk._shown = ""
	main.refresh()
	_check(bk.web().state_of("The Pitch/0").get("reach", false) and not bk.web().state_of("Stalking/0").get("reach", false) and not bk.also_names().has("Petrol"), "a runner with no past can path a class's tree, or the Also row lists a tree")
	_check_fit(main, "Caravan (no past)")
	# every joint
	for j in Data.JOINTS:
		var halves := []
		for tn in [j["tree"], j["element_tree"]]:
			var t: Dictionary = Data.tree_named(tn)
			var found := -1
			for i in range(t["nodes"].size()):
				if str(t["nodes"][i].get("joint", "")) == j["key"]:
					_check(found < 0, "%s holds two halves of %s" % [tn, j["key"]])
					found = i
			_check(found >= 0 and int(t["nodes"][found]["col"]) == Data.JOINT_COL and t["nodes"][found].get("notable", false), "%s's half of %s is not a fourth-column notable" % [tn, j["key"]])
			halves.append("%s/%d" % [tn, found])
		_check(Data.tree_named(j["tree"]).get("class", "") == j["class"] and str(sim.node(halves[1]).get("class", "")) == j["class"], "%s's halves are not the %s's" % [j["key"], j["class"]])
		sim.cls = j["class"]
		sim.tree = [halves[0]]
		_check(not sim.has_joint(j["key"]), "%s closed on its class half alone" % j["key"])
		sim.tree = [halves[1]]
		_check(not sim.has_joint(j["key"]), "%s closed on its element half alone" % j["key"])
		sim.tree = [halves[0], halves[1], "%s/6" % j["element_tree"]]
		_check(sim.has_joint(j["key"]) and sim.node_active("%s/6" % j["element_tree"]), "%s did not close with both halves, or its keystone did not work" % j["key"])
		for c in table:
			if c != j["class"]:
				sim.cls = c
				_check(not sim.has_joint(j["key"]), "%s closed for a %s" % [j["key"], c])     # the keystone itself works for any class pathed to it (the web, 22 Oct)
				break
	# the crew (21 Oct): a runner with no class takes the first pick as theirs, one press, free, keeping what's trained
	sim.load_dict(saved)
	sim.cls = ""
	sim.roster = {}
	sim.tree = ["The Pitch/0", "The Rat Man/0"]
	var cash0: float = sim.cash
	bk._shown = ""
	main.refresh()
	bk._pick_class("Poacher")
	_check(sim.cls == "Poacher" and is_equal_approx(sim.cash, cash0) and sim.tree.has("The Pitch/0") and sim.tree.has("The Rat Man/0") and sim.roster.is_empty(), "the first pick did not make this runner the Poacher: %s %s" % [sim.cls, str(sim.tree)])
	# a swap: two presses, free; the Poacher's own kept by the crew; a class not played comes in at level 1 with the arrival's kit
	sim.xp = Data.xp_for_level(12)
	var poacher_gun = sim.equipped["Primary"]
	bk._shown = ""
	main.refresh()
	bk._pick_class("Doorman")
	_check(sim.cls == "Poacher" and bk._armed == "Doorman" and bk._notice.text.contains("press again"), "the first press swapped, or said nothing: '%s'" % bk._notice.text)
	_check(bk._title.text.begins_with("Doorman"), "the armed swap's panel does not show the Doorman: '%s'" % bk._title.text)
	_check_fit(main, "Caravan (a swap armed)")
	bk._pick_class("Doorman")
	_check(sim.cls == "Doorman" and sim.level() == 1 and is_equal_approx(sim.cash, cash0) and sim.tree.filter(func(id): return not sim.is_camp(str(id))).is_empty() and sim.tree.has("The Pitch/0") and sim.node_active("The Pitch/0") and sim.equipped["Primary"] != null and sim.equipped["Primary"]["base"] == sim.START_WEAPON, "a swap to a new class is off: %s at level %d, %s" % [sim.cls, sim.level(), str(sim.tree)])
	_check(sim.roster.has("Poacher") and sim.crew_level("Poacher") == 12 and is_same(sim.roster["Poacher"]["equipped"]["Primary"], poacher_gun), "the crew did not keep the Poacher's own: %s" % str(sim.roster.keys()))
	_check(poacher_gun == null or sim.item_by_id(int(poacher_gun["id"])).is_empty(), "the Poacher's gun is still the Doorman's to reach")
	_check(bk._class_cards[Data.CLASSES.map(func(c): return c["name"]).find("Poacher")]["tag"].text.contains("12"), "the Poacher's card does not say his level: '%s'" % bk._class_cards[Data.CLASSES.map(func(c): return c["name"]).find("Poacher")]["tag"].text)
	_check_fit(main, "Caravan (the crew)")
	# not on a run
	sim.hp = sim.max_hp()
	sim.deploy(0)
	_check(sim.on_mission() and not sim.set_class("Poacher") and sim.cls == "Doorman", "a class swapped on a run")
	sim.extract_now()
	# and back: the Poacher's level, tree and kit as he left them, the Doorman's to the crew
	_press_class(main, "Poacher")
	_check(sim.cls == "Poacher" and sim.level() == 12 and sim.tree.has("The Rat Man/0") and sim.tree.has("The Pitch/0") and sim.tree.count("The Pitch/0") == 1 and is_same(sim.equipped["Primary"], poacher_gun) and sim.roster.has("Doorman") and not sim.roster.has("Poacher") and not sim.roster["Doorman"]["tree"].has("The Pitch/0"), "the swap back lost the Poacher's own: %s level %d %s" % [sim.cls, sim.level(), str(sim.tree)])
	# saved and loaded
	var crew_d: Dictionary = JSON.parse_string(JSON.stringify(sim.to_dict()))
	var cfresh = Sim.new()
	cfresh.load_dict(crew_d)
	_check(cfresh.cls == "Poacher" and cfresh.roster.has("Doorman") and cfresh.crew_level("Doorman") == 1 and cfresh.roster["Doorman"]["equipped"]["Primary"] != null, "the crew did not survive a save: %s" % str(cfresh.roster.keys()))
	_check(cfresh.set_class("Doorman") and cfresh.level() == 1 and cfresh.equipped["Primary"] != null and typeof(cfresh.equipped["Primary"]["rarity"]) == TYPE_INT and typeof(cfresh.equipped["Primary"]["id"]) == TYPE_INT, "a loaded crew's runner would not come out, or came out with float figures")
	# the Pitch's tree is the camp's, its own points (21 Oct, Matt): one a level of the crew's best class
	_check(sim.pitch_points() == sim.crew_best_level() - 1 and sim.free_for("The Pitch/1") == sim.pitch_free() and sim.free_for("Stalking/0") == sim.points_free(), "the Pitch's points are off: %d of best %d" % [sim.pitch_points(), sim.crew_best_level()])
	# a node picked disarms a swap
	bk._pick_class("Doorman")
	bk._pick(Data.COMMON_TREE + "/1")
	_check(bk._armed == "", "picking a node did not disarm the swap")
	_stash_tab_checks(main)
	# the camp's high-water mark: levels under the best earn nothing; past it, a point a level
	sim.load_dict(saved)
	sim.best_level = 10
	sim.xp = Data.xp_for_level(3)
	var pts0: int = sim.training_points
	var before: int = sim.level()
	sim.xp = Data.xp_for_level(9)
	sim._earn_points(before)
	_check(sim.training_points == pts0 and sim.best_level == 10, "a runner re-levelling under the camp's best earned %d points" % (sim.training_points - pts0))
	before = sim.level()
	sim.xp = Data.xp_for_level(12)
	sim._earn_points(before)
	_check(sim.training_points == pts0 + 2 and sim.best_level == 12, "past the camp's best a level did not earn a point: %d, best %d" % [sim.training_points - pts0, sim.best_level])
	# saves: the layout version and the best level go in; an old save's tree comes back as points, once
	sim.load_dict(saved)
	sim.tree = ["The Pitch/0"]
	var d: Dictionary = sim.to_dict()
	_check(int(d.get("tree_v", 0)) == sim.TREE_V and d.has("best_level"), "the save has no layout version or best level")
	d["tree_v"] = 1
	sim.load_dict(d)
	_check(sim.tree.is_empty() and sim.points_free() == sim.training_points, "an old save's tree did not come back as points: %s" % str(sim.tree))
	sim.tree = ["The Pitch/0"]
	sim.load_dict(sim.to_dict())
	_check(sim.tree == ["The Pitch/0"], "a save from this layout was refunded again")
	var yd: Dictionary = sim.to_dict()
	yd["tree"] = ["The Yard/0"]                # a save from before the Pitch (14 Oct)
	sim.load_dict(yd)
	_check(sim.tree == ["The Pitch/0"], "a save's Yard node did not become the Pitch's: %s" % str(sim.tree))
	d.erase("tree_v")
	d.erase("best_level")
	sim.load_dict(d)
	_check(sim.best_level == sim.level(), "an old save's best level is not its runner's: %d" % sim.best_level)
	sim.load_dict(saved)
	bk.alt = ""
	bk._armed = ""
	bk._shown = ""
	main.refresh()
	sim.core_gates = true
	print("tree rules ok: the lanes, ten joints, a class change's price and presses, the high-water mark, the old saves")
	_joint_payoff_checks(main)


## Every joint's payoff (trees.md §3), read at the function it lives in, both halves trained straight into the
## tree; with the joint open each reads plain.
func _joint_payoff_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.words[3] = []
	sim.set_depth(3, 1)
	var close := func(key: String) -> void:
		var j: Dictionary = Data.joint(key)
		sim.cls = j["class"]
		sim.tree = []
		for tn in [j["tree"], j["element_tree"]]:
			var t: Dictionary = Data.tree_named(tn)
			for i in range(t["nodes"].size()):
				if str(t["nodes"][i].get("joint", "")) == key:
					sim.tree.append("%s/%d" % [tn, i])
	var fresh_run := func() -> Dictionary:
		if sim.on_mission():
			sim.extract_now()
		sim.hp = sim.max_hp()
		sim.deploy(3)
		sim.mission["dots"] = {}
		return sim.mission
	# the Drifter's fire: an SMG's hit lights them, a burn already there never shrinks, and a burning gang takes a quarter more
	close.call("drifter_fire")
	sim.equipped["Primary"] = sim._plain("Primary", _base_of_type("smg"))
	var m: Dictionary = fresh_run.call()
	_check(is_equal_approx(sim._joint_hit_mult(m, "smg"), 1.0), "the Drifter's joint added to a gang not burning")
	m["dots"]["fire"] = 500.0
	sim._joints_on_hit(m, m["t"], 10.0, "smg", 0.1)
	_check(float(m["dots"]["fire"]) >= 500.0 and is_equal_approx(sim._joint_hit_mult(m, "smg"), 1.25) and is_equal_approx(sim._joint_hit_mult(m, "rifle"), 1.0), "the Drifter's joint shrank the burn or missed the quarter: %.1f" % float(m["dots"]["fire"]))
	# the Drifter's bleed (joints B): a bleeding kill's drop rolls its rarity twice - more rare things over many kills
	close.call("drifter_bleed")
	m = fresh_run.call()
	var counts := [0, 0]
	for shocked in [false, true]:
		sim.rng.seed = 4242
		for k in range(400):
			m["found"] = []
			m["kill_bleeding"] = shocked
			sim._find(m, m["t"], true)
			for it in m["found"]:
				if it["slot"] in Data.SLOTS and int(it.get("rarity", 0)) >= 1:
					counts[1 if shocked else 0] += 1
	_check(counts[1] > counts[0], "a bleeding kill's drops are no rarer: %d against %d" % [counts[1], counts[0]])
	# the Scrapper's shock: every improvised hit shocks
	close.call("scrapper_shock")
	m = fresh_run.call()
	m["shock_t"] = 0.0
	sim._joints_on_hit(m, m["t"], 10.0, "improvised", 0.1)
	_check(float(m["shock_t"]) >= 1.0, "an improvised hit did not shock with the Scrapper's joint")
	# the Scrapper's fire: a kill while it burns drops something, and the Fence pays a fifth more
	var piece: Dictionary = sim._plain("Helmet", "Hard hat")
	sim.tree = []
	var plain_price: int = sim.sell_price(piece)
	close.call("scrapper_fire")
	_check(sim.sell_price(piece) >= int(plain_price * 1.19), "the Scrapper's joint did not lift the Fence's price: %d to %d" % [plain_price, sim.sell_price(piece)])
	m = fresh_run.call()
	var t_dry: Dictionary = m["t"].duplicate()
	t_dry["drop"] = 0.0
	var finds0: int = int(m.get("finds", 0))
	m["kill_burning"] = true
	sim._kill(m, t_dry)
	_check(int(m.get("finds", 0)) == finds0 + 1, "a kill while it burned dropped nothing with the Scrapper's joint")
	# the Scrapper's class: improvised guns do 20% more, nothing else does, and no other class's do (12 Oct)
	var cls_keep: String = sim.cls
	var mission_keep = sim.mission
	sim.mission = null                       # a class changes only at the Yard
	var imp_gun: Dictionary = sim._plain("Primary", _base_of_type("improvised"))
	var smg_gun: Dictionary = sim._plain("Primary", _base_of_type("smg"))
	_set_cls(sim, "Scrapper")
	_check(is_equal_approx(sim._class_gun_mult(imp_gun), 1.2) and is_equal_approx(sim._class_gun_mult(smg_gun), 1.0), "the Scrapper's improvised guns are not 20%% up, or another gun is: %.2f / %.2f" % [sim._class_gun_mult(imp_gun), sim._class_gun_mult(smg_gun)])
	_set_cls(sim, "Doorman")
	_check(sim.cls == "Doorman" and is_equal_approx(sim._class_gun_mult(imp_gun), 1.0), "a Doorman's improvised gun takes the Scrapper's 20%%: %s" % sim.cls)
	_set_cls(sim, cls_keep)
	sim.mission = mission_keep
	# the Poacher's poison: the first shot on a gang lands its poison at full stacks
	close.call("poacher_poison")
	m = fresh_run.call()
	m["fresh"] = true
	m["dots"]["poison"] = 0.01
	sim._joints_on_hit(m, m["t"], 10.0, "rifle", 0.1)
	var full: float = float(m["dots"]["poison"])
	_check(full > 1.0 and m.has("full_dose"), "the first shot's poison is not at full stacks: %.2f" % full)
	m["dots"]["poison"] = 0.01
	sim._joints_on_hit(m, m["t"], 10.0, "rifle", 0.1)
	_check(float(m["dots"]["poison"]) < full, "the full dose landed twice on one gang")
	# the Rat Man's Bag lifts the cap, not the fill (12 Oct, the lorry-fix read: a full dose at 999 stacks was thousands of seconds of the gun)
	var bag_was = sim.equipped["Backpack"]
	sim.equipped["Backpack"] = Items.roll_unique(sim._unique_named("The Rat Man's Bag"), sim.rng)
	sim._dry_memo.clear()
	_check(sim.dot_stacks("poison") >= 999 and sim.dot_fill_stacks("poison") == (15 if sim.has_node("poison_stacks") else int(Data.DOTS["poison"]["stacks"])), "the Rat Man's Bag's uncapped stacks reach the full dose: %d" % sim.dot_fill_stacks("poison"))
	m = fresh_run.call()
	m["fresh"] = true
	m["dots"]["poison"] = 0.01
	sim._joints_on_hit(m, m["t"], 10.0, "rifle", 0.1)
	var bag_full: float = float(m["dots"]["poison"])
	var bag_rate: float = float(sim.type_dps()["poison"]) * (1.0 - float(m["t"].get("res", {}).get("poison", 0.0))) * sim.pace() * float(m["t"]["pace"])
	var bag_cap: float = bag_rate * float(Data.DOTS["poison"]["ratio"]) * sim.dot_seconds("poison") * sim.dot_fill_stacks("poison") * sim.dot_depth() * maxf(sim.dot_grow(), 1.0)     # the cap grows with dot_pct (16 Oct)
	_check(m.has("full_dose") and bag_cap > 1.0 and is_equal_approx(bag_full, bag_cap), "the full dose with the Bag is not the tree's stacks: %.0f against %.0f" % [bag_full, bag_cap])
	sim.equipped["Backpack"] = bag_was
	# the Paramedic's shock (joints B): a med shocks them 3 s; the Paramedic's frost: chilled, they do 30% less and meds heal a fifth more
	close.call("paramedic_shock")
	m = fresh_run.call()
	m["shock_t"] = 0.0
	m["using"] = {"name": "Bandage", "left": 0.0, "heal": 10.0}
	sim._patch(m, 0.1)
	_check(float(m.get("shock_t", 0.0)) >= sim.status_s(3.0) - 0.001 and float(m["dots"].get("poison", 0.0)) <= 0.0, "a med did not shock them with the Paramedic's joint: %.2f" % float(m.get("shock_t", 0.0)))
	close.call("paramedic_frost")
	m = fresh_run.call()
	_check(is_equal_approx(sim._joints_on_incoming(m, true, 0.1), 0.7) and is_equal_approx(sim._joints_on_incoming(m, false, 0.1), 1.0), "chilled gangs do not do 30%% less with the Paramedic's joint")
	sim.hp = sim.max_hp() * 0.2
	var hp0: float = sim.hp
	m["chill_t"] = 1.0
	m["using"] = {"name": "Bandage", "left": 0.0, "heal": 10.0}
	sim._patch(m, 0.1)
	_check(is_equal_approx(sim.hp - hp0, 12.0), "a med did not heal a fifth more while they were chilled: %.1f" % (sim.hp - hp0))
	# Flattened: a kill with the plain staggers the next of them, half their fire for two seconds
	sim.cls = "Doorman"
	sim.tree = ["Knuckles/10"]
	sim.tops_open = true
	m = fresh_run.call()
	m["target_hp"] = 0.0
	sim._fight(m, m["t"], 0.05)
	_check(float(m.get("flat_t", 0.0)) > 0.0, "a kill with the plain did not flatten the next")
	var flat_on: float = float(maxi(1, mini(int(m.get("remaining", 1)), sim.contact(m["t"]))))     # one man of those on you fires at half, not the gang (25 Oct, the review)
	var flat_x: float = sim._joints_on_incoming(m, false, 0.1)
	_check(flat_x <= 1.0 - 0.5 / flat_on + 0.001 and flat_x < 1.0, "Flattened did not halve the next man's fire: ×%.2f with %d on you" % [flat_x, int(flat_on)])
	sim.tops_open = false
	if sim.on_mission():
		sim.extract_now()
	# the sum strip's Physical chip, the Doorman's knuckles alone: what it ignores, never a "+0%"
	sim.cls = "Doorman"
	sim.tree = ["Knuckles/5"]
	var phys: Array = main._barracks.sum_items([]).filter(func(it): return str(it.get("tag", "")) == "Physical")
	_check(phys.size() == 1 and phys[0]["forms"].all(func(f): return str(f) != "" and not str(f).contains("+0%")) and phys[0]["forms"].slice(1).all(func(f): return str(f).contains("+") or str(f).contains("ignores")), "the pen-only Physical chip reads a nothing: %s" % str(phys))
	# the plain figures count the notables as the fight does: Spray's quarter with an SMG in hand, none without
	sim.cls = "Drifter"
	sim.tree = ["Moving on/3"]
	sim.equipped["Primary"] = sim._plain("Primary", _base_of_type("smg"))
	var dmg: Array = main._barracks.sum_items([]).filter(func(it): return str(it.get("tag", "")) == "Damage")
	_check(dmg.size() == 1 and str(dmg[0]["forms"][0]) == "+25%", "the strip's Damage leaves out Spray: %s" % str(dmg))
	sim.equipped["Primary"] = sim._plain("Primary", "Nail gun")
	dmg = main._barracks.sum_items([]).filter(func(it): return str(it.get("tag", "")) == "Damage")
	_check(dmg.is_empty(), "the strip counts Spray without an SMG in hand: %s" % str(dmg))
	sim.load_dict(saved)
	main.refresh()
	print("joint payoffs ok: the ten joints and Flattened, each where it lives")


## The trees as webs: a fork at the notable, a branch each way; the second
## past from level 30; two runners turn up when one dies.
func _webs_traits(main) -> void:
	var sim = main.sim
	sim.core_gates = false            # Training's 15 Oct gates are _training_gate_checks'; this area tests the mechanics
	var saved: Dictionary = sim.to_dict()
	_set_cls(sim, "Poacher")
	sim.respec()
	sim.tree = []                    # the Pitch's too: a respec keeps the camp's (21 Oct), the fixture wants it bare
	sim.training_points += 30
	var t: Dictionary = Data.tree_named("Stalking")
	# the web (22 Oct, docs/design/web.md): a node is reached by pathing, not a column's gate - an entry (column 0) any
	# time, the rest touching a node trained along a link; a lane's links run to both of the next column and across its own
	# slice 2: a lane is two rails with a filler between each pair of columns (the ladder), the two rows rung across
	var links: Dictionary = Data.web_links_all()
	_check(links["Stalking/0"].has("Stalking/1") and not links["Stalking/0"].has("Stalking/2"), "Stalking's first node links wrong: %s" % str(links["Stalking/0"]))
	var f01: String = ""
	for other in links["Stalking/0"]:
		if other != "Stalking/1" and sim.node(other).get("filler", false) and str(other).begins_with("Stalking/"):
			f01 = other
	# the wheel (23 Oct, the canvas pass): one starter a class - Stalking's first node - the second lane's first column
	# linked to it across; the keystones on the hub, the capstones at the centre, the hung notables between the
	# stations (strictly alternating, Matt)
	for cls_t in Data.TREES:
		if cls_t.get("class", "") == "":
			continue
		var entries := 0
		for nd in cls_t["nodes"]:
			if nd.get("entry", false):
				entries += 1
			var w: Array = nd.get("wheel", [])
			_check(w.size() == 2, "%s/%s has no place on the wheel" % [cls_t["name"], nd["name"]])
			if nd.has("hang"):
				_check(is_zero_approx(fmod(float(w[0]), Data.WHEEL_COL)), "a hung notable isn't between two stations: %s at %s" % [nd["name"], str(w)])
			elif nd.get("capstone", false):
				_check(is_equal_approx(float(w[1]), Data.WHEEL_CAP), "the capstone isn't at the wheel's centre: %s" % nd["name"])
			elif nd.get("keystone", false):
				_check(is_equal_approx(float(w[1]), Data.WHEEL_HUB), "a keystone isn't on the hub: %s" % nd["name"])
		_check(entries == (1 if int(cls_t["lane"]) == 0 else 0), "%s has %d entries (one starter a class)" % [cls_t["name"], entries])
	_check(links["Snares/0"].has("Stalking/0") and links["Snares/1"].has("Stalking/0"), "the second lane's first column doesn't reach the starter: %s" % str(links["Snares/0"]))
	_check(not Data.web_entry(sim.node("Snares/0")) and Data.web_entry(sim.node("Stalking/0")), "the entries aren't one a class")
	_check(sim.node(f01).get("filler", false) and links[f01].has("Stalking/2"), "no filler between Stalking's first and second columns: %s" % f01)
	_check(not sim.can_train("Stalking/2") and sim.train_block("Stalking/2").begins_with("wants a path"), "a second-column node trained with nothing before it: '%s'" % sim.train_block("Stalking/2"))
	_check(sim.path_next("Stalking/6") == "Stalking/0" or sim.path_next("Stalking/6") == "Stalking/1", "the path to the keystone doesn't start at an entry: %s" % sim.path_next("Stalking/6"))
	_check(_walk(sim, "Stalking/0"), "Stalking's first node did not train")
	_check(sim.can_train(f01) and sim.can_train("Stalking/1") and not sim.can_train("Stalking/2"), "pathing is off: the filler and the rung should open, the next column not")
	_check(not sim.can_train("Stalking/6") and not sim.can_train("Stalking/10"), "a deep node trained on a dip")
	_check(sim.path_next("Stalking/6") == f01 or sim.path_next("Stalking/6") == "Stalking/1", "the next step to the keystone isn't the touching node: %s" % sim.path_next("Stalking/6"))
	# points in another tree open nothing here
	sim.best_level = maxi(sim.best_level, 10)     # the Pitch's own points (21 Oct): one a level of the crew's best
	var yard_in: int = sim.points_in("The Pitch")
	for i in range(3):
		_walk(sim, "The Pitch/%d" % i)
	_check(sim.points_in("The Pitch") > yard_in and not sim.can_train("Stalking/2"), "the Pitch's points opened Stalking's path")
	for i in [2, 3, 7]:
		_check(_walk(sim, "Stalking/%d" % i), "Stalking/%d did not train along the path" % i)
	_check(_walk(sim, "Stalking/6"), "the keystone did not train once pathed to (the level gate off)")
	_check(_walk(sim, "Stalking/9"), "the fifth column did not train")
	_check(sim.has_node("night_work"), "Night work did not take")
	_check(sim.effective(3)["rarity"] > 0.0 and sim.effective(3)["pace"] < 1.0, "Night work did not make the site Night")
	_check(_walk(sim, "Stalking/10"), "the capstone did not train from the column before it: '%s'" % sim.train_block("Stalking/10"))
	_check(_walk(sim, "Stalking/5") and _walk(sim, "Stalking/8"), "the nodes beside the path did not train")
	# the hung notables and the keystone choice (slice 2, web.md §2a)
	var clocked: String = Data.node_id_named("Stalking/Clocked")
	var snare: String = Data.node_id_named("Stalking/Snare and wait")
	_check(clocked != "" and snare != "" and sim.node(clocked).get("notable", false) and sim.node(snare).get("keystone", false), "the new nodes are not on the web")
	_check(_walk(sim, clocked) and sim.has_node("clocked"), "Clocked did not train off its branch: '%s'" % sim.train_block(clocked))
	_check(sim.keystone_held_against(snare) == "Stalking/6", "the keystone choice doesn't see One shot held: '%s'" % sim.keystone_held_against(snare))
	_check(not sim.can_train(snare) and sim.train_block(snare).contains("hangs off"), "the swap went through with nodes hanging off the held keystone: '%s'" % sim.train_block(snare))
	for k in range(20):
		var hangs: String = sim.strands_without("Stalking/6")
		if hangs == "":
			break
		sim.tree.erase(hangs)                 # what hangs off the keystone let go (the column past it): then the swap is open
	var before_pts: int = sim.points_free()
	var one_shot_cost: int = sim.node_cost("Stalking/6")
	sim.training_points -= sim.points_free()     # no points free: the swap pays with the held one's (the review)
	before_pts = 0
	_check(sim.can_train(snare) or sim.train_block(snare).begins_with("wants"), "the swap is still shut with nothing hanging: '%s'" % sim.train_block(snare))
	_check(sim.touches_trained(snare) and sim.train_node(snare) and sim.has_node("snare_and_wait") and not sim.has_node("one_shot") and not sim.tree.has("Stalking/6"), "taking the second keystone did not let the first go: '%s'" % sim.train_block(snare))
	_check(sim.points_free() == before_pts - sim.node_cost(snare) + one_shot_cost, "the keystone let go did not refund its %d points: %d -> %d" % [one_shot_cost, before_pts, sim.points_free()])
	_check(sim.strands_without(snare) == "", "a trained node hangs off the new keystone")
	# the fillers: one stat each, a small node, the eight stats about the lane
	var fillers := 0
	var stats := {}
	for i in range(t["nodes"].size()):
		var nd: Dictionary = t["nodes"][i]
		if nd.get("filler", false):
			fillers += 1
			stats[nd["effect"]] = true
			_check(nd.has("value") and nd.has("at") and nd.has("links") and not nd["links"].is_empty(), "filler %d of Stalking is malformed" % i)
	_check(fillers >= 12 and stats.size() >= 6, "Stalking has %d fillers of %d stats" % [fillers, stats.size()])
	var total := 0
	for tt in Data.TREES + Data.ELEMENT_TREES:
		total += tt["nodes"].size()
	_check(total >= 500, "the web has %d nodes, not 500 and up" % total)
	# the fillers' stats read: a regen filler heals; a resist filler counts
	var mending: String = ""
	for i in range(Data.tree_named("Petrol")["nodes"].size()):
		var nd: Dictionary = Data.tree_named("Petrol")["nodes"][i]
		if nd.get("effect", "") == "fire_res":
			mending = "Petrol/%d" % i
	var res0: float = sim.resist_raw("fire")
	if mending != "":
		var kept_tree: Array = sim.tree.duplicate()
		sim.tree.append(mending)
		sim._dry_memo.clear()
		_check(sim.resist_raw("fire") > res0 + 2.9, "a fire resist filler did not raise the resist: %.1f -> %.1f" % [res0, sim.resist_raw("fire")])
		sim.tree = kept_tree
		sim._dry_memo.clear()
	main.show_room(main.BARRACKS)
	_check_fit(main, "Caravan (web)")
	# the traits: one on the runner now; a death brings two to choose from
	sim.runner_trait = "Heavy-handed"
	_check(is_equal_approx(sim.trait_mult("damage"), 1.08) and is_equal_approx(sim.trait_mult("pace"), 0.95), "Heavy-handed's figures did not read")
	sim.runner_trait = "Lucky"
	var r0: float = sim.rarity_bonus()
	sim.runner_trait = ""
	_check(sim.rarity_bonus() < r0 - 0.09, "Lucky did not add to rarity_bonus")
	sim.promised = "Wary"
	sim.hardcore = false
	sim.deploy(3)
	sim.mission["hp_start"] = sim.hp
	sim._kia()
	_check(sim.candidates.size() == 2 and sim.candidates[1] == "Wary", "two did not turn up with the promised one among them: %s" % str(sim.candidates))
	_check(sim.runner_trait == sim.candidates[0], "the runner in hand is not the first candidate")
	# the pick is the Map's card column (21 Oct, the canvas): the two as cards, what went and what stays, Set off shut
	var menu_was: bool = main._menu.visible
	main.show_room(main.MISSIONS)
	main.refresh()
	var ms = main._missions
	_check(ms._pick.visible and not ms._cols[0]["panel"].visible and main._menu.visible == menu_was, "the trait pick isn't on the Map")
	_check(ms._pick_cards[1]["name"].text == "Wary" and ms._pick_cards[1]["chips"].shown() >= 1 and ms._pick_go.disabled, "the pick's cards or its shut Set off are off: '%s'" % ms._pick_cards[1]["name"].text)
	_check(ms._pick_kicker.text.contains("back at level 1") and ms._pick_lost.shown() >= 4, "the pick doesn't say what the death took: '%s', %d chips" % [ms._pick_kicker.text, ms._pick_lost.shown()])
	_check(Missions.trait_chips("Tins +15%, max HP −10%").map(func(c): return c["colour"]) == [Pal.GOOD, Pal.BAD], "a trait's cost isn't in the bad tone")
	_check_fit(main, "The Map (back at level 1)")
	# away with a death: the tally's card open doesn't cover the pick (the review); the Radio's Set off waits for it
	ms._came_open = true
	var cb_was: Dictionary = sim.came_back.duplicate(true)
	sim.came_back_seen()
	sim.came_back["runs"] = 1
	sim.came_back["deaths"] = 1
	ms._shown = ""
	main.refresh()
	_check(not ms._came.visible and ms._came_btn.disabled and ms._pick.visible, "the came-back card covers the trait pick")
	sim.came_back = cb_was
	ms._came_open = false
	main._radio.show_state(sim)
	if not sim.signals.is_empty():
		_check(main._radio._set_off.disabled and main._radio._set_off.text.contains("trait"), "the Radio's Set off doesn't wait for the trait: '%s'" % main._radio._set_off.text)
	ms._pick_cards[1]["button"].pressed.emit()
	main.refresh()
	_check(sim.runner_trait == "Wary" and sim.candidates.is_empty(), "picking the second runner did not take")
	_check(not ms._pick.visible and ms._cols[0]["panel"].visible, "the site's card did not come back after the pick")
	_check(sim.trait_mult("patrol") > 1.1, "Wary's gangs come no later")
	sim.load_dict(saved)
	sim.core_gates = true
	print("webs, the second past and traits ok")
	_element_checks(main)
	_element_bot_checks(main)
	_web_rule_checks(main)
	_web_pool_checks(main)


## Slice 3 (web.md §1, §3, §4): the elements' points come off the use meter and spend in the element alone; the
## Pitch's and the elements' nodes are the camp's, kept through a swap, a death and a reset; a half is its class's;
## the bridge opens a neighbour's region at level 30, one a class, for 3 points.
func _web_pool_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	sim.core_gates = false
	_set_cls(sim, "Scrapper")
	sim.respec()
	sim.tree = []
	sim.element_points = {}
	sim.element_xp = {}
	sim.training_points = 20
	# the Pitch circle (24 Oct): an element's starter is bought from the Pitch's pool, one point; the class's buy nothing
	# there, and the element's own points buy the rest of its region
	sim.best_level = maxi(sim.best_level, 3)
	_check(sim.is_element_starter("Live/0") and sim.free_for("Live/0") == sim.pitch_free() and sim.node_cost("Live/0") == Data.ELEMENT_OPEN_COST, "an element's starter isn't the Pitch's to buy: %d free, %d cost" % [sim.free_for("Live/0"), sim.node_cost("Live/0")])
	var pitch0: int = sim.pitch_free()
	_check(not sim.element_opened("shock") and sim.train_node("Live/0") and sim.element_opened("shock") and sim.pitch_free() == pitch0 - 1 and sim.points_free() == 20 and sim.element_free("shock") == 0, "a Pitch point did not open Live: %d Pitch free, %d class" % [sim.pitch_free(), sim.points_free()])
	_check(sim.free_for("Live/1") == 0 and sim.train_block("Live/1").begins_with("wants"), "a class's or the Pitch's points bought an element's node: '%s'" % sim.train_block("Live/1"))
	sim.element_points["shock"] = 2
	_check(sim.free_for("Live/1") == 2 and sim.train_node("Live/1") and sim.element_free("shock") == 2 - sim.node_cost("Live/1") and sim.points_free() == 20, "an element's point did not buy its own node: %d free, %d class" % [sim.element_free("shock"), sim.points_free()])
	# the meter: a run's damage in the element, in site pools, ELEMENT_METER a point; never a dry run's
	sim.deploy(3)
	var m: Dictionary = sim.mission
	var t: Dictionary = m["t"]
	var pool_hp: float = float(t["hp"]) * float(t["pool"])
	m["dealt_by"] = {"fire": pool_hp * Data.ELEMENT_METER * 2.0 + 1.0, "shock": pool_hp * 0.5}
	sim.extract_now()
	_check(int(sim.element_points.get("fire", 0)) == 0 and sim.element_points["shock"] == 2 and float(sim.element_xp.get("shock", 0.0)) > 0.4, "the meter did not pay its opened element alone: %s / %s" % [str(sim.element_points), str(sim.element_xp)])
	sim.deploy(3)
	m = sim.mission
	m["dry"] = true
	m["dealt_by"] = {"shock": pool_hp * 10.0}
	sim._fill_meters(m)
	_check(int(sim.element_points.get("shock", 0)) == 2, "a dry run filled the meter")
	m.erase("dry")
	sim.extract_now()
	# the camp's: a swap, a death and a reset keep the elements' and the Pitch's nodes
	sim.best_level = maxi(sim.best_level, 5)
	_check(_walk(sim, "The Pitch/0") and _walk(sim, "Stripping/0"), "the fixture could not train")
	_check(sim.set_class("Doorman") and sim.tree.has("Live/0") and sim.tree.has("The Pitch/0") and not sim.tree.has("Stripping/0"), "a swap lost the camp's nodes or kept the class's: %s" % str(sim.tree))
	_check(sim.set_class("Scrapper") and sim.tree.has("Stripping/0") and sim.tree.has("Live/0"), "the swap back lost a node: %s" % str(sim.tree))
	sim.cash += sim.respec_cost()
	_check(sim.respec() and sim.tree.has("Live/0") and not sim.tree.has("Stripping/0"), "a reset took the elements' nodes: %s" % str(sim.tree))
	_walk(sim, "Stripping/0")
	sim._refund_runner_trees()
	_check(sim.tree.has("Live/0") and sim.tree.has("The Pitch/0") and not sim.tree.has("Stripping/0"), "a death took the camp's nodes: %s" % str(sim.tree))
	# another class's half on the camp's tree does nothing for this runner
	var half := ""
	for i in range(Data.tree_named("Live")["nodes"].size()):
		if str(Data.tree_named("Live")["nodes"][i].get("class", "")) == "Paramedic":
			half = "Live/%d" % i
	var shock0: float = sim.tree_sum("shock_pct")
	sim.tree.append(half)
	sim._dry_memo.clear()
	_check(half != "" and not sim.node_active(half) and sim.tree_sum("shock_pct") == shock0, "the Paramedic's half counted for a Scrapper")
	sim.tree.erase(half)
	# the bridge: level 30, one a class, from your own region, 3 points; the neighbour's region then on show
	var to_drifter := Data.node_id_named("Fencing/The second past")      # joints B (24 Oct): the Scrapper's neighbours the Drifter and the Paramedic
	var to_doorman := Data.node_id_named("Stripping/The second past")
	_check(to_drifter != "" and to_doorman != "" and sim.node(to_drifter)["bridge"] == "Drifter" and sim.node_cost(to_drifter) == Data.BRIDGE_COST, "the Scrapper's bridges are not on the web")
	sim.core_gates = true
	sim.xp = Data.xp_for_level(29)
	_check(sim.bridge() == "" and not sim._on_show("Moving on") and sim.train_block("Moving on/0") != "", "the Drifter's region is on show with no bridge")
	_walk_to_touch(sim, to_drifter)
	_check(sim.train_block(to_drifter).begins_with("opens at level 30"), "the bridge opened under level 30: '%s'" % sim.train_block(to_drifter))
	sim.xp = Data.xp_for_level(30)
	sim.training_points += 20
	_check(sim.can_train(to_drifter) and sim.train_node(to_drifter) and sim.bridge() == "Drifter", "the bridge did not take at 30: '%s'" % sim.train_block(to_drifter))
	_check(sim._on_show("Moving on") and sim._on_show("Luck") and sim.my_classes() == ["Scrapper"] and sim.trees().size() == 6 + Data.ELEMENT_TREES.size(), "the bridge did not open the Drifter's region (and the halves stay the class's): %s" % str(sim.trees().map(func(x): return x["name"])))
	var dr_half := ""
	for i in range(Data.tree_named("Petrol")["nodes"].size()):
		if str(Data.tree_named("Petrol")["nodes"][i].get("class", "")) == "Drifter":
			dr_half = "Petrol/%d" % i
	_check(sim.train_block(dr_half) == "Drifter only", "a bridge opened the Drifter's half: '%s'" % sim.train_block(dr_half))
	# a death's damage fills the meter too
	sim.deploy(3)
	m = sim.mission
	m["hp_start"] = sim.hp
	m["dealt_by"] = {"frost": float(m["t"]["hp"]) * float(m["t"]["pool"]) * Data.ELEMENT_METER}
	if not sim.element_opened("frost"):
		sim.tree.append("The cold/0")          # the Pitch circle: only an opened element's meter fills
	var frost0: int = int(sim.element_points.get("frost", 0))
	sim._kia()
	_check(int(sim.element_points.get("frost", 0)) == frost0 + 1, "a death's run did not fill the meter")
	sim.load_dict(saved)
	_set_cls(sim, "Scrapper")
	sim.xp = Data.xp_for_level(30)
	sim.training_points += 60                # the Fencing lane's bridge is a longer walk than Stripping's was (joints B)
	sim.element_points = {}
	_walk_to_touch(sim, to_drifter)
	_check(sim.train_node(to_drifter), "the bridge fixture could not retake the bridge")
	var pts: int = sim.points_free()
	_check(_walk(sim, "Moving on/0") and sim.points_free() == pts - sim.node_cost("Moving on/0"), "the bridged region did not spend the class's points: '%s', %d of %d" % [sim.train_block("Moving on/0"), sim.points_free(), pts])
	_check(sim.train_block(to_doorman).begins_with("one bridge a class"), "a second bridge was allowed: '%s'" % sim.train_block(to_doorman))
	sim.cash += sim.respec_cost()
	_check(sim.respec() and sim.bridge() == "" and not sim._on_show("Moving on") and not sim.tree.has("Moving on/0"), "a reset did not take the bridge and what was past it")
	sim.load_dict(saved)
	sim.core_gates = true
	print("the web's pools and the bridge ok")


## Train up to the nodes touching `id` without taking it (the walk, stopped one short).
func _walk_to_touch(sim, id: String) -> void:
	for k in range(60):
		if sim.touches_trained(id) or sim.tree.has(id):
			return
		var nxt: String = sim.path_next(id)
		if nxt == "" or nxt == id:
			return
		if sim.free_for(nxt) < sim.node_cost(nxt):
			if sim.is_pitch(nxt):
				sim.best_level += sim.node_cost(nxt)
			elif sim.element_of(nxt) != "":
				sim.element_points[sim.element_of(nxt)] = int(sim.element_points.get(sim.element_of(nxt), 0)) + sim.node_cost(nxt)
			else:
				sim.training_points += sim.node_cost(nxt)
		if not sim.train_node(nxt):
			return


## The web's new rules (22 Oct, web.md §2a): each keystone and starred notable read where the sim reads it.
func _web_rule_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	sim.core_gates = false
	_set_cls(sim, "Poacher")
	sim.respec()
	sim.tree = []
	var nodes := {}
	for path in ["Stalking/Snare and wait", "Snares/Twine", "The door/Last orders", "Live/Overload", "Muscle/Bin lid", "Triage/Jab", "Triage/Worst first",
			"Moving on/B-roads", "Stripping/Workbench", "Moving on/On a roll", "Petrol/Oil drum", "The cold/Brittle",
			"Blades/Arterial", "Knuckles/Floored", "Live/Capacitor", "Stalking/Clocked", "Shifts/Clocking off", "Fencing/Back pocket", "Stripping/Breaker's yard", "Muscle/Off the canvas"]:
		nodes[path] = Data.node_id_named(path)
		_check(nodes[path] != "", "%s is not on the web" % path)
	var with := func(ids: Array) -> void:
		sim.tree = ids.map(func(k): return nodes[k])
		sim._dry_memo.clear()
	# Snare and wait: the gang one fewer, the first of it at half
	sim.deploy(3)
	var m: Dictionary = sim.mission
	var t: Dictionary = m["t"]
	var plain_pool: int = int(m["remaining"])
	sim.extract_now()
	with.call(["Stalking/Snare and wait"])
	sim.deploy(3)
	m = sim.mission
	_check(int(m["remaining"]) == plain_pool - 1, "Snare and wait did not take one off the gang: %d of %d" % [m["remaining"], plain_pool])
	sim.extract_now()
	# Twine: a search sets the snare line, the next gang arrives one fewer; B-roads: the first waits twice as long
	with.call(["Snares/Twine", "Moving on/B-roads"])
	sim.deploy(3)
	m = sim.mission
	t = m["t"]
	var first_plain: float = sim.patrol_s(t, true)
	sim.tree = []
	sim._dry_memo.clear()
	_check(first_plain > sim.patrol_s(t, true) * 1.9, "B-roads did not double the first wait: %.0f vs %.0f" % [first_plain, sim.patrol_s(t, true)])
	with.call(["Snares/Twine"])
	m["cleared"] = true
	m["remaining"] = 0
	m["crates_off"] = true
	m["search"] = sim.search_s(t) - 0.01
	sim._search(m, t, 0.02)
	_check(m.get("twine", false), "a search did not set Twine's snare line")
	m["patrol_timer"] = sim.patrol_s(t, true) + 1.0
	sim._tick(0.1)
	_check(int(m["patrols"]) == 1 and int(m["remaining"]) == sim.PATROL_BASE - 1 and not m.has("twine"), "Twine's next gang isn't one fewer: %d of %d" % [m["remaining"], sim.PATROL_BASE])
	sim.extract_now()
	# Last orders, Clocked, Bin lid, Jab, Capacitor: the hit's multiplier and Guard
	with.call(["The door/Last orders", "Stalking/Clocked", "Muscle/Bin lid", "Triage/Jab", "Live/Capacitor"])
	sim.deploy(3)
	m = sim.mission
	t = m["t"]
	sim._gang_arrives(m)
	_check(float(m.get("guard", 0.0)) >= minf(sim.max_hp() * 0.25, sim.guard_cap()) - 0.01, "Bin lid gave no Guard at the gang's arrival: %.0f" % float(m.get("guard", 0.0)))
	sim._fight(m, t, 0.1)
	_check(float(m.get("shock_t", 0.0)) > 0.0, "Capacitor did not shock the first of the gang")
	m["target_hp"] = 0.0
	sim._fight(m, t, 0.1)
	_check(m.get("clocked", false) and not m["fresh"], "Clocked did not mark the first of the gang down")
	sim.hp = sim.max_hp() * 0.6
	var hp0: float = sim.hp
	var meds: Array = sim.rig.filter(func(x): return Items.is_medical(x))
	if not meds.is_empty():
		_check(sim.use_med(meds[0]["id"]) and m["using"] != null, "the med for Jab did not go on")
		_check(float(m.get("jab_t", 0.0)) > 7.0 and sim.hp <= hp0 - sim.max_hp() * 0.05 + (float(m["using"]["heal"]) if m["using"] != null else 0.0) + 0.01, "Jab did not start or cost its 5%%: jab_t %.1f" % float(m.get("jab_t", 0.0)))
	sim.extract_now()
	# Overload: a shocked one under a fifth dies; Brittle: physical ×1.3 on a chilled one (read off the kill)
	with.call(["Live/Overload"])
	sim.deploy(3)
	m = sim.mission
	t = m["t"]
	m["shock_t"] = 5.0
	m["target_hp"] = float(t["hp"]) * 0.15
	var rem: int = int(m["remaining"])
	sim._fight(m, t, 0.05)
	_check(int(m["remaining"]) == rem - 1, "Overload did not finish a shocked one under a fifth: %d of %d" % [m["remaining"], rem])
	sim.extract_now()
	# Worst first: a med under half heals +50%
	with.call(["Triage/Worst first"])
	sim.deploy(3)
	m = sim.mission
	var meds2: Array = sim.rig.filter(func(x): return Items.is_medical(x))
	if not meds2.is_empty():
		var it: Dictionary = meds2[0]
		var full: float = sim.med_heal(it)
		sim.hp = sim.max_hp() * 0.3
		_check(sim.use_med(it["id"]) and m["using"] != null and is_equal_approx(float(m["using"]["heal"]), full * 1.5), "Worst first did not add half: %s of %.1f" % [str(m["using"]["heal"]) if m["using"] != null else "nil", full])
	sim.extract_now()
	# Workbench, On a roll, the dots' lengths (Light pack and Shop local went for the Drifter's and the Scrapper's skills, 24 Oct)
	with.call(["Stripping/Workbench"])
	var piece: Dictionary = sim.stash.filter(func(x): return x.has("affixes") and not x["affixes"].is_empty() and not Items.is_ammo(x))[0] if not sim.stash.filter(func(x): return x.has("affixes") and not x["affixes"].is_empty() and not Items.is_ammo(x)).is_empty() else {}
	if not piece.is_empty():
		_check(sim.workbench_free() and sim.craft_cost(piece, "values") == 0, "Workbench's free job isn't free: %d" % sim.craft_cost(piece, "values"))
		sim.workbench_day = int(sim.elapsed / 86400.0)
		_check(sim.craft_cost(piece, "values") > 0, "Workbench gave a second free job the same day")
	with.call(["Moving on/On a roll"])
	sim.deploy(3)
	m = sim.mission
	var find0: float = sim.loot_bonus()
	m["roll"] = 4
	sim._dry_memo.clear()
	_check(is_equal_approx(sim.loot_bonus(), find0 + 0.2) and sim.rarity_bonus() > 0.19, "On a roll's four kills aren't +20%% find: %.2f -> %.2f" % [find0, sim.loot_bonus()])
	sim.extract_now()
	var burn0: float = sim.dot_seconds("fire")
	with.call(["Petrol/Oil drum"])
	_check(is_equal_approx(sim.dot_seconds("fire"), burn0 * 1.25), "Oil drum did not make burns last a quarter longer: %.1f -> %.1f" % [burn0, sim.dot_seconds("fire")])
	# Back pocket: a death keeps one piece
	with.call(["Fencing/Back pocket"])
	sim.deploy(3)
	m = sim.mission
	m["hp_start"] = sim.hp
	var worn_v: Array = []
	for sl in Data.SLOTS:
		if sim.equipped[sl] != null:
			worn_v.append(sim.equipped[sl])
	sim._kia()
	var kept_v: Array = sim.stash.filter(func(x): return worn_v.any(func(w): return is_same(w, x)))     # the pieces themselves (an id can repeat across the smoke's loads)
	_check(not worn_v.is_empty() and kept_v.size() == 1, "Back pocket did not keep one piece on the death (%d of %d worn in the stash: %s)" % [kept_v.size(), worn_v.size(), str(kept_v.map(func(x): return Items.full_name(x)))])
	sim.load_dict(saved)
	sim.core_gates = true
	print("the web's rules ok")


## The element trees: affinities, double cost and the locked keystone off
## them, the second past opening it; the keystones' and notables' rules.
## The element bots: each trains its tree first and saves for its keystone,
## takes a second past for an off-affinity element, holds the gun that
## carries the element, seats the element's socketable, and sends the primary
## to the Bench until the element's affixes are on it. Then the band: at
## depth 30 on every site, some build still lands most of its damage.
## Trains a tree's nodes, cheapest columns first, until `n` points are in it (or nothing more will train).
## The Map's web (22 Oct): a rank on a node by pathing to it - the fillers and the spine on the way ranked too, the
## points added as needed (a fixture's way in, not a player's).
## A node already at its top rank counts as taken; the fillers ranked on the way are let go after (their shares would
## move the figures the checks read).
func _rank_to(sim, key: String) -> bool:
	var ok := false
	for k in range(40):
		if sim.atlas_rank(key) >= int(Data.atlas_of(key)["max"]):
			ok = true
			break
		if sim.atlas_open(key):
			if sim.atlas_free() < 1:
				sim.atlas_points += 1
			ok = sim.rank_atlas(key)
			break
		var nxt: String = sim.atlas_path_next(key)
		if nxt == "":
			break
		var nk: String = str(Data.map_node(nxt)["key"])
		if sim.atlas_free() < 1:
			sim.atlas_points += 1
		if not sim.rank_atlas(nk):
			break
	for a in Data.ATLAS_ALL:
		if a.get("filler", false) and sim.atlas.has(a["key"]):
			sim.atlas.erase(a["key"])
	sim._surv_cache = {}
	return ok


## The web (22 Oct): a node trained by pathing to it, the fillers on the way too (their points added as needed).
func _walk(sim, id: String) -> bool:
	for k in range(60):
		if sim.tree.has(id):
			return true
		var nxt: String = id if (sim.touches_trained(id) or Data.web_entry(sim.node(id))) else sim.path_next(id)
		if nxt == "":
			return false
		if sim.free_for(nxt) < sim.node_cost(nxt):
			if sim.is_pitch(nxt):
				sim.best_level += sim.node_cost(nxt)
			elif sim.element_of(nxt) != "":
				sim.element_points[sim.element_of(nxt)] = int(sim.element_points.get(sim.element_of(nxt), 0)) + sim.node_cost(nxt)     # slice 3: the element's own pool
			else:
				sim.training_points += sim.node_cost(nxt)
		if not sim.train_node(nxt):
			return false
	return false


func _train_to(sim, tree_name: String, n: int) -> void:
	var t: Dictionary = Data.tree_named(tree_name)
	sim.training_points += n * 2
	var moved := true
	while sim.points_in(tree_name) < n and moved:
		moved = false
		for i in range(t["nodes"].size()):
			if sim.points_in(tree_name) < n and _walk(sim, "%s/%d" % [tree_name, i]):
				moved = true


func _element_bot_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	for t in Data.ELEMENT_TREES:
		var el: String = t["element"]
		sim.load_dict(saved)
		_set_cls(sim, "Doorman")          # bleed and physical: four of the five are off-affinity
		sim.respec()
		sim.tree = []                    # the Pitch's too: a respec keeps the camp's (21 Oct), the fixture wants it bare
		sim.cash = 400000.0
		sim.market = []                   # nothing to buy, no contracts: the choices below are the only ones
		sim.contracts = []
		sim.training_points = 0
		sim.best_level = maxi(sim.best_level, 5)    # a Pitch point to open the element with (the Pitch circle, 24 Oct)
		sim.element_points = {el: 3}             # slice 3: the element's own pool, earned on its meter
		var bot = Bot.new()
		bot.element = el
		bot._train_tree(sim)
		var mine: Array = sim.tree.filter(func(id): return str(id).begins_with(t["name"] + "/"))
		_check(not mine.is_empty() and sim.element_free(el) == 0 and sim.tree.all(func(id): return str(id).begins_with(t["name"] + "/") or sim.is_pitch(str(id))), "the %s bot did not spend the element's points in its region: %s" % [el, sim.tree])
		sim.element_points[el] += 80
		sim.training_points += 140                # the core's 12 and the keystone's level 20 too (15 Oct); the web's fillers and hung notables on the way (22 Oct)
		sim.xp = maxf(sim.xp, Data.xp_for_level(30))
		bot._train_tree(sim)
		# the keystone wants a joint closed there: a class half on show for it (the runner's, or the second past's first tree's)
		var closable := ""
		var on_show: Array = sim.trees().map(func(x): return x["name"])
		for c in sim.my_classes():
			var j: Dictionary = Data.joint_in(c, t["name"])
			if not j.is_empty() and j["tree"] in on_show and closable == "":
				closable = str(j["key"])
		if closable != "":
			_check(sim.tree.has("%s/6" % t["name"]) and sim.has_joint(closable), "the %s bot did not close its joint and reach its keystone: %s" % [el, sim.tree])
		else:
			_check(sim.tree.has("%s/6" % t["name"]), "the %s bot did not reach the keystone past the halves' column (the web: full access): %s" % [el, sim.tree])
		if el == "physical":
			continue                      # Knuckles scales what isn't converted: no element gun, socketable or affix to chase
		# the gun: a plain better one in the stash loses to the one carrying the element
		var top := {}
		for b in Data.BASES["Primary"]:
			if b.get("type", "") != "melee" and (top.is_empty() or int(b["tier"]) > int(top["tier"]) or (int(b["tier"]) == int(top["tier"]) and float(b["damage"]) * float(b["rof"]) > float(top["damage"]) * float(top["rof"]))):
				top = b
		var carries: Dictionary = sim._plain("Primary", top["name"])     # the hardest-hitting gun there is: nothing the market stocks is 1.5× it
		carries["affixes"] = [{"stat": "conv_%s_pct" % el, "value": 25.0, "tier": 5}]
		carries["rarity"] = 2
		if el == "bleed":
			carries["base"] = "Machete"            # a bleed base too
			carries["attachments"] = {}
			for name in Items.base_of(carries).get("attachments", []):
				carries["attachments"][name] = null
		var plain: Dictionary = carries.duplicate(true)   # the same gun, a better plain affix
		plain["id"] = Items._next_id
		Items._next_id += 1
		plain["affixes"] = [{"stat": "damage_pct", "value": 30.0, "tier": 4}]
		sim.equipped["Primary"] = null
		sim.stash = sim.stash.filter(func(it): return it["slot"] != "Primary")   # only these two to choose from
		while not sim.stash_room(20) and not sim.stash.is_empty():
			sim.sell(sim.stash[0])              # room to swap guns: a full stash refuses the swap
		sim.stash.append(plain)
		sim.stash.append(carries)
		bot._hold_the_element(sim)
		_check(sim.equipped["Primary"] != null and bot._elem_share(sim.equipped["Primary"]) >= 0.249, "the %s bot did not hold a gun carrying the element: %s" % [el, sim.equipped["Primary"]["base"] if sim.equipped["Primary"] != null else "nothing"])
		# the socketable: added at the Bench when none, and the element's own seated
		if el != "bleed":
			var sock: Dictionary = Items.roll(Data.ATTACHMENT, 2, sim.rng)
			var sock_base: String = {"fire": "Lighter fluid", "frost": "Antifreeze", "poison": "Rat poison", "shock": "Car battery"}[el]
			sock["base"] = sock_base
			sock["mount"] = "socket"
			sock["affixes"] = []
			sim.stash.append(sock)
			var cash0: float = sim.cash
			bot._craft_toward(sim)
			_check(Items.sockets(sim.equipped["Primary"]) >= 1 and sim.cash < cash0, "the %s bot did not buy a socket at the Bench" % el)
			bot.tidy(sim)
			var seated := false
			for a in sim.equipped["Primary"]["attachments"].values():
				seated = seated or (a != null and a["base"] == sock_base)
			var where := "in the stash" if sim.stash.has(sock) else "gone"
			for st in Data.SOCKET_SLOTS:
				if sim.equipped[st] != null and sim.equipped[st]["attachments"].values().has(sock):
					where = "on the " + st.to_lower()
			for it in sim.stash:
				if it.get("attachments", {}).values().has(sock):
					where = "on the %s in the stash" % it["base"]
			_check(seated, "the %s bot did not seat its socketable: it is %s; the primary is %s (carries: %s, plain: %s) with %s; bought %s" % [el, where, sim.equipped["Primary"]["base"], is_same(sim.equipped["Primary"], carries), is_same(sim.equipped["Primary"], plain), sim.equipped["Primary"]["attachments"], str(bot.bought.slice(-4))])
		# the Bench: the increased affix added next to the conversion
		sim.cash = 400000.0
		bot._craft_toward(sim)
		var has_inc := false
		for a in sim.equipped["Primary"]["affixes"]:
			has_inc = has_inc or a["stat"] == "%s_pct" % el
		_check(has_inc or sim.craft_cost(sim.equipped["Primary"], "add") < 0, "the %s bot did not add its increased affix: %s" % [el, sim.equipped["Primary"]["affixes"]])
		_check(sim.conversion()[el] > 0.5, "the %s build is not mostly %s: %s" % [el, el, sim.conversion()])
		# the needs-led Bench reads the build's own lines (the review: its figure was the raw hits, fire read as dead)
		var gun: Dictionary = sim.equipped["Primary"]
		var hold_aff: Array = gun["affixes"].duplicate(true)
		gun["affixes"] = [{"stat": "conv_%s_pct" % el, "value": 25.0, "tier": 5}, {"stat": "%s_pct" % el, "value": 30.0, "tier": 5}]
		var esh: Array = bot._shares(sim, "Primary")
		# the conversion line can read nothing or less on the figure (a gun all that element already, a crew resisting it):
		# it's padlocked as the build's own all the same
		_check(esh.size() == 2 and esh.all(func(x): return float(x[1]) >= bot.DEAD or str(x[0]).begins_with("conv_")) and bot._build_lines().has("conv_%s_pct" % el), "the %s bot's Bench reads its own lines as dead: %s" % [el, str(esh)])
		gun["affixes"] = hold_aff
	# the band: at depth 30 on every site, some element build lands at least 60% of what it would unresisted
	var builds := {}
	for t in Data.ELEMENT_TREES:
		builds[t["element"]] = {"types": {t["element"]: 1.0}}
	builds["physical"] = {"types": {"physical": 1.0}}
	for i in range(Data.TIERS.size()):
		sim.depth[i] = 30
		sim.words[i] = []
		var e: Dictionary = sim.effective(i)
		var best := 0.0
		var best_name := ""
		for name in builds:
			var landed: float = 1.0 - float(e["res"].get(name, 0.0))
			if landed > best:
				best = landed
				best_name = name
		_check(best >= 0.6, "no build lands 60%% on %s at depth 30: best %s at %.0f%%" % [e["name"], best_name, best * 100])
		_check(e["res"].values().any(func(r): return float(r) >= 0.3), "%s at depth 30 resists nothing enough to matter: %s" % [e["name"], e["res"]])
		_check(e["res"].values().any(func(r): return float(r) <= 0.01), "%s at depth 30 resists everything: %s" % [e["name"], e["res"]])
	sim.load_dict(saved)
	print("element bots ok: own tree first, saved points, the second past, the gun, the socketable, the Bench, the band")


func _element_checks(main) -> void:
	var sim = main.sim
	sim.core_gates = false            # Training's 15 Oct gates are _training_gate_checks'; this area tests the mechanics
	var saved: Dictionary = sim.to_dict()
	_set_cls(sim, "Drifter")
	sim.respec()
	sim.tree = []                    # the Pitch's too: a respec keeps the camp's (21 Oct), the fixture wants it bare
	sim.training_points += 80
	sim.best_level = maxi(sim.best_level, 50)    # the Pitch's points open the elements' starters (24 Oct)
	sim.equipped["Primary"] = sim._plain("Primary", "Nail gun")     # nothing worn converts: the trees are read alone
	sim.equipped["Secondary"] = null
	_check(sim.affinity("fire") and sim.affinity("bleed") and not sim.affinity("shock"), "the Drifter's affinities are not fire and bleed (joints B)")
	_check(sim.node_cost("Petrol/0") == 1 and sim.node_cost("The Rat Man/0") == 1, "an element's node isn't one of its own points whatever the pair (slice 3): %d / %d" % [sim.node_cost("Petrol/0"), sim.node_cost("The Rat Man/0")])
	# Petrol to its fourth column: the Drifter's half trains, the Scrapper's doesn't
	for i in [0, 1, 2, 4, 3, 7, 5]:
		_check(_walk(sim, "Petrol/%d" % i), "Petrol/%d did not train: %s" % [i, sim.train_block("Petrol/%d" % i)])
	_check(sim.train_block("Petrol/8") == "Scrapper only", "another class's half trained for a Drifter: '%s'" % sim.train_block("Petrol/8"))
	# the joint (9 Oct): one half alone gives its own figure and not the payoff; the element's top is reached by the
	# path, joint or none (the web, 22 Oct: full access)
	_check(not sim.has_joint("drifter_fire") and sim.path_next("Petrol/6") != "" and not sim.train_block("Petrol/6").contains("joint"), "the keystone isn't reached by its path: '%s'" % sim.train_block("Petrol/6"))
	for i in [0, 1, 2, 4, 3, 5, 8]:
		_check(_walk(sim, "Moving on/%d" % i), "Moving on/%d did not train: %s" % [i, sim.train_block("Moving on/%d" % i)])
	_check(sim.has_joint("drifter_fire") and not sim.has_joint("drifter_bleed"), "both halves trained and the joint did not close")
	_check(_walk(sim, "Petrol/6") and sim.has_node("fire_spread"), "Spreads did not train once the joint closed")
	_check(is_equal_approx(sim.conversion()["fire"], 0.70), "the fire conversions do not add to 70%%: %s" % str(sim.conversion()))     # A can of it 20 (9 Oct), Siphoned 35, Petrol bomb 15
	_check(is_equal_approx(sim.dot_seconds("fire"), 8.0) and is_equal_approx(sim.dot_seconds("poison"), 8.0), "Lit did not double the burn")
	_check(_walk(sim, "Petrol/9") and is_equal_approx(sim.more("fire"), 1.4), "Petrol on your hands is not ×1.4")
	# the payoff: an SMG's hit lights them, and a burning gang takes a quarter more from it
	sim.equipped["Primary"] = sim._plain("Primary", _base_of_type("smg"))
	sim.words[3] = []
	sim.set_depth(3, 1)
	sim.hp = sim.max_hp()
	sim.deploy(3)
	var jm: Dictionary = sim.mission
	jm["dots"] = {}
	sim._joints_on_hit(jm, jm["t"], 100.0, "smg", 0.1)
	_check(float(jm["dots"].get("fire", 0.0)) > 0.0, "the Drifter's joined bursts did not ignite")
	sim.extract_now()
	sim.equipped["Primary"] = sim._plain("Primary", "Nail gun")
	# off the pair: the rat man's top is reached too (the web, 22 Oct: full access) - the halves' column, every node
	# another class's, is bypassed by the path; the nodes themselves stay those classes' own
	for i in [0, 1, 2, 4, 3, 7]:
		_walk(sim, "The Rat Man/%d" % i)
	_check(sim.train_block("The Rat Man/5") == "Poacher only" and sim.train_block("The Rat Man/8") == "Recruit only", "the Rat Man's halves trained for a Drifter")
	_check(_walk(sim, "The Rat Man/6"), "an off-pair keystone wasn't reached past the halves' column: '%s'" % sim.train_block("The Rat Man/6", true))
	# the fight: Spreads multiplies fire by those on you; a shocked gang takes more under Live
	sim.words[3] = []
	sim.set_depth(3, 1)
	sim.hp = sim.max_hp()
	sim.deploy(3)
	var m: Dictionary = sim.mission
	var t: Dictionary = m["t"]
	var on_you: int = mini(m["remaining"], sim.contact(t))
	var before: float = m["target_hp"]
	sim.advance(0.1)
	var fire_only: float = sim.type_dps()["fire"] * (1.0 - float(t["res"].get("fire", 0.0))) * sim.pace() * t["pace"] * 0.1
	_check(before - m["target_hp"] > fire_only * on_you * 0.6 or m["remaining"] < sim.mission["t"]["pool"], "Spreads did not multiply the fire by the %d on you" % on_you)
	sim.extract_now()
	# frost: Frozen solid stops their fire while chilled and halves frost; the Poacher's frost joint closes on Snares
	sim.respec()
	sim.tree = []                    # the Pitch's too: a respec keeps the camp's (21 Oct), the fixture wants it bare
	_set_cls(sim, "Poacher")
	sim.training_points += 80
	for i in [0, 1, 2, 4, 3, 7, 5]:
		_walk(sim, "The cold/%d" % i)
	for i in [0, 1, 2, 4, 3, 5, 8]:
		_walk(sim, "Snares/%d" % i)
	_check(sim.has_joint("poacher_frost") and _walk(sim, "The cold/6"), "the Poacher's frost joint did not open Frozen solid: '%s'" % sim.train_block("The cold/6"))
	_check(sim.has_node("frost_freeze") and is_equal_approx(sim.chill_amount(), Data.FREEZE) and is_equal_approx(sim.more("frost"), 0.5), "Frozen solid did not take: chill %.2f more %.2f" % [sim.chill_amount(), sim.more("frost")])
	_check(is_equal_approx(sim.incoming_rate({"dps": 10.0, "types": {"physical": 1.0}}, 1, true), 10.0 * (1.0 - Data.FREEZE) * (1.0 - sim.mitigation())), "a frozen gang fires more than a sliver: %.2f" % sim.incoming_rate({"dps": 10.0, "types": {"physical": 1.0}}, 1, true))
	# the payoff: every gang arrives chilled, and one head short
	sim.hp = sim.max_hp()
	var pool0: int = int(sim.effective(3)["pool"]) - (1 if sim.has_node("trapline") else 0)
	sim.deploy(3)
	_check(float(sim.mission.get("chill_t", 0.0)) > 0.0 and int(sim.mission["remaining"]) == maxi(1, pool0 - 1), "the Poacher's snare, joined, did not chill the first gang and take a head: %d of %d" % [int(sim.mission["remaining"]), pool0])
	sim.extract_now()
	for i in [0, 1, 2, 4, 3, 7, 5]:
		_walk(sim, "The Rat Man/%d" % i)
	for i in [0, 1, 2, 4, 3, 5, 8]:
		_walk(sim, "Stalking/%d" % i)
	_check(_walk(sim, "The Rat Man/6") and sim.dot_stacks("poison") == 15, "Builds did not raise the stacks: '%s'" % sim.train_block("The Rat Man/6"))
	# bleed: Blades to both ends through the Doorman's joint; Glassing's 15% on the conversions
	sim.respec()
	sim.tree = []                    # the Pitch's too: a respec keeps the camp's (21 Oct), the fixture wants it bare
	_set_cls(sim, "Doorman")
	sim.training_points += 80
	var held = sim.equipped["Primary"]
	var held2 = sim.equipped["Secondary"]
	sim.equipped["Secondary"] = null          # the conversions read off the gun alone (a secondary's conversion line read in)
	sim.equipped["Primary"] = sim._plain("Primary", _base_of_type("shotgun"))
	for i in [0, 1, 2, 4, 3, 7, 5, 8]:
		_walk(sim, "Blades/%d" % i)
	for i in [0, 1, 2, 4, 3, 5, 8]:
		_check(_walk(sim, "Muscle/%d" % i), "Muscle/%d did not train: %s" % [i, sim.train_block("Muscle/%d" % i)])
	_check(_walk(sim, "Blades/6") and _walk(sim, "Blades/9"), "Blades did not train past its joint: '%s' / '%s'" % [sim.train_block("Blades/6"), sim.train_block("Blades/9")])
	_check(sim.has_node("bleed_forever") and is_equal_approx(sim.more("bleed"), 1.4), "Blades did not train to both ends")
	var rig_held: Array = sim.rig
	sim.rig = sim.rig.filter(func(x): return not Items.is_ammo(x))     # a graded box's conversion (incendiary) reads in through the gun: off for the read
	sim._dry_memo.clear()
	_check(is_equal_approx(sim.conversion()["bleed"], 0.15 + 0.65), "Glassing did not add 15%% bleed: %s" % str(sim.conversion()))
	sim.rig = rig_held
	sim._dry_memo.clear()
	sim.deploy(3)
	m = sim.mission
	m["dots"] = {"bleed": 60.0}
	var dealt: float = sim._dot_tick(m["dots"], 1.0, {})
	_check(dealt > 0.0 and is_equal_approx(m["dots"]["bleed"], 60.0), "Won't stop let the bleed fade: %s" % str(m["dots"]))
	# the payoff: a bleeding gang does a fifth less to you; the physical joint not closed, nothing more
	_check(sim.has_joint("doorman_bleed") and not sim.has_joint("doorman_physical") and is_equal_approx(sim._joints_on_incoming(m, false, 0.1), 0.8), "the Doorman's bleed joint does not take a fifth off: %.2f" % sim._joints_on_incoming(m, false, 0.1))
	sim.extract_now()
	# Knuckles, the physical: the Doorman's half is the Knuckles' notable; both close the stagger
	for i in [0, 1, 2, 4, 3, 5, 7]:
		_walk(sim, "The door/%d" % i)
	_check(sim.tree.has("The door/7") and not sim.has_joint("doorman_physical"), "Hands on alone closed the physical joint, or did not train: '%s'" % sim.train_block("The door/7"))
	for i in [0, 1, 2, 4, 3, 7, 5]:
		_check(_walk(sim, "Knuckles/%d" % i), "Knuckles/%d did not train: %s" % [i, sim.train_block("Knuckles/%d" % i)])
	_check(sim.has_joint("doorman_physical") and _walk(sim, "Knuckles/6"), "the Doorman's physical joint did not open Bust them up: '%s'" % sim.train_block("Knuckles/6"))
	_check(is_equal_approx(sim.conversion()["physical"], 1.0) and is_equal_approx(sim.phys_resist(0.2), 0.0), "Bust them up did not end the conversions and their armour: %s" % str(sim.conversion()))
	sim.deploy(3)
	_check(is_equal_approx(sim._joints_on_incoming(sim.mission, false, 0.1), 0.75 * 0.9), "the Doorman's physical joint and Stagger do not cut their fire to %.3f: %.3f" % [0.75 * 0.9, sim._joints_on_incoming(sim.mission, false, 0.1)])
	sim.extract_now()
	sim.equipped["Primary"] = held
	sim.equipped["Secondary"] = held2
	# the Caravan: every lane, the joints' links, the Also row's chips each swapping the fifth lane and back
	main.show_room(main.BARRACKS)
	_check_fit(main, "Caravan (elements, yard)")
	var bk = main._barracks
	# the web (22 Oct): the Doorman's trees and the Pitch on the canvas, the closed joints drawn joined
	var wv = bk.web()
	for tn in ["Muscle", "Blades", "The door", "Knuckles", "The Pitch"]:
		_check(wv.layout.has("%s/0" % tn), "%s is not on the web" % tn)
	_check(sim.has_joint("doorman_bleed") and sim.has_joint("doorman_physical"), "the Doorman's joints aren't closed for the web check")
	for name in bk.also_names():
		_check(bk.also_button(name) != null, "the %s chip is not on the Also row" % name)
		_check(bk._is_pages(name), "the Also row lists %s: the trees are the web's now" % name)
		bk.also_button(name).pressed.emit()
		_check_fit(main, "Caravan (also: %s)" % name)
		_check(not bk.web().visible and bk._cells[0]["button"].visible, "%s did not take the web's place" % name)
		bk.also_button(name).pressed.emit()
		_check(bk.alt == "" and bk.web().visible, "the %s chip pressed again did not give the web back" % name)
	# the layout: the header with the points and the classes in its top right; the web, the Also row, the sum strip
	# and the panel under it
	_check(bk._points.text == "%d" % _web_free(sim), "the Caravan's points read '%s'" % bk._points.text)
	for cb in bk._class_buttons:
		_check(cb.position.y + cb.size.y <= bk.HEAD_H and cb.position.x >= bk._kicker.position.x + bk._kicker.size.x, "a class button is not in the band, right")
	_web_checks(main)
	bk._shown = ""
	main.refresh()
	_check(bk.ALSO_Y >= bk.LANES_Y + bk.LANES_H and bk.PANEL_Y >= bk.ALSO_Y + bk.ALSO_H and bk.PANEL_Y + bk.PANEL_H <= Pal.ROOM_H and bk.LANES_Y >= bk.HEAD_H, "the Caravan's strips overlap")
	# the band (10 Oct, Bands-U A): the rooms' one height; the sum in it under the class's line, clear of the face, the
	# classes and the notice; the classes at its foot, right
	var sum_r := Rect2(bk._sum.position, bk._sum.size)
	_check(bk.HEAD_H == Pal.BAND_H and Rect2(0, 0, Pal.GRID_W, bk.HEAD_H).encloses(sum_r) and sum_r.position.y >= bk._points.position.y + 40 and sum_r.position.x >= bk._face.position.x + bk._face.size.x and not sum_r.intersects(Rect2(bk._class_line.position, bk._class_line.size)), "the sum is not in the band under the points: %s" % str(sum_r))
	var classes_r := Rect2()
	for cb in bk._class_buttons:
		var cr := Rect2(cb.position, cb.size)
		classes_r = cr if classes_r.size == Vector2.ZERO else classes_r.merge(cr)
		_check(not cr.intersects(sum_r), "a class button is on the sum: %s" % str(cr))
	_check(classes_r.end.y <= bk.HEAD_H - 8 and classes_r.end.y >= bk.HEAD_H - 24 and classes_r.position.y >= bk._class_line.position.y + bk._class_line.size.y, "the classes' two rows are off the band's foot: %s" % str(classes_r))     # two rows of three (24 Oct, option B)
	_check(not Rect2(bk._notice.position, bk._notice.size).intersects(sum_r), "the class notice sits on the sum")
	_class_card_checks(bk)
	# the lines over the classes (12 Oct): as the screen stands, with no past (two lines), and with a past and no trait (one)
	_line_pill_checks(bk, sum_r)
	var trait_was: String = sim.runner_trait
	var cls_was: String = sim.cls
	for st in [["", ""], [cls_was if cls_was != "" else "Poacher", ""]]:
		sim.cls = st[0]
		sim.runner_trait = st[1]
		bk._show_head()
		_line_pill_checks(bk, sum_r)
		_class_card_checks(bk)
		_check_fit(main, "Caravan (the band, past '%s')" % st[0])
	sim.cls = cls_was
	sim.runner_trait = trait_was
	bk._show_head()
	# the sum strip (option A, 9 Oct): the elements in play in their colours, the dots, the joints last; no zeros
	var sum_tags: Array = []
	for k in range(bk._sum_chips.shown()):
		sum_tags.append(bk._sum_chips._tags[k].text)
	var last: int = maxi(0, bk._sum_chips.shown() - 1)
	_check(not sum_tags.is_empty() and sum_tags.has("Bleed") and sum_tags.has("Physical") and sum_tags.has("Lasting") and sum_tags[last] == "Joints" and bk._sum_chips._labels[last].text.begins_with("2 of "), "the sum strip is off: %s" % str(bk._sum_chips.text_nodes().map(func(l): return l.text)))
	_check(bk._sum_chips._tags[sum_tags.find("Bleed")].get_theme_color("font_color") == Pal.ELEMENT_COLOURS["bleed"], "the Bleed chip is not in bleed's colour")
	for k in range(bk._sum_chips.shown()):
		_check(not bk._sum_chips._labels[k].text.begins_with("+0") and not bk._sum_chips._labels[k].text.begins_with("0%"), "the sum strip shows a figure at nothing: %s %s" % [sum_tags[k], bk._sum_chips._labels[k].text])
	# a crowded strip: every plain figure and four elements at once - the short forms, then the plain figures go
	var crowd_tree: Array = sim.tree.duplicate()
	for tn in ["The Pitch", "Petrol", "The cold", "Live", "The Rat Man"]:
		for i in _behind_cap(tn):
			if not sim.tree.has("%s/%d" % [tn, i]):
				sim.tree.append("%s/%d" % [tn, i])
	sim.tops_open = true
	bk._shown = ""
	main.refresh()
	var crowd_tags: Array = []
	for k in range(bk._sum_chips.shown()):
		crowd_tags.append(bk._sum_chips._tags[k].text)
	var crowd_full: Array = bk.sum_items([])     # the row as laid, then the long forms tried alone: they must not fit
	_check(not bk._fits(bk.sum_items_raw()), "the crowded strip fits at its long forms - the check is not crowded")
	_check(crowd_tags.size() == crowd_full.size(), "the crowded strip shows %d of %d" % [crowd_tags.size(), crowd_full.size()])
	bk._shown = ""
	main.refresh()                              # the probe above laid the long forms on the widget: lay the strip again
	_check(["Damage", "Fire", "Frost", "Shock", "Poison", "Lasting"].all(func(t_in): return crowd_tags.has(t_in)) and crowd_tags.back() == "Joints", "the crowded strip lost an element, Damage or the Joints: %s" % str(crowd_tags))
	_sum_strip_check(main)
	_check_fit(main, "Caravan (a crowded sum strip)")
	# heavier still, in the band's three rows (Bands-U A; the reviewer): every element tree, Knuckles -
	# every element and the Joints still on show, the plain figures going first
	for tn in ["Blades", "Knuckles"]:
		var tt: Dictionary = Data.tree_named(tn)
		if tt.is_empty():
			continue
		for i in _behind_cap(tn):
			if not sim.tree.has("%s/%d" % [tn, i]):
				sim.tree.append("%s/%d" % [tn, i])
	bk._shown = ""
	main.refresh()
	var heavy_tags: Array = []
	for k in range(bk._sum_chips.shown()):
		heavy_tags.append(bk._sum_chips._tags[k].text)
	_check(["Fire", "Frost", "Shock", "Poison", "Bleed", "Physical"].all(func(t_in): return heavy_tags.has(t_in)) and heavy_tags.back() == "Joints" and heavy_tags.size() == bk.sum_items([]).size(), "the heaviest sum lost an element or the Joints in the band: %s" % str(heavy_tags))     # Damage goes before the elements (22 Oct: the web's three-digit figures)
	bk._shown = ""
	main.refresh()
	_check_fit(main, "Caravan (the heaviest sum)")
	sim.tree = crowd_tree
	sim.tops_open = false
	bk._shown = ""
	main.refresh()
	# the capstone sits at the wheel's centre, inside the keystones (the wheel, 23 Oct); the points key fits its box and
	# the regions' labels carry no meter words
	var wv2 = bk.web()
	var wc: Vector2 = wv2._axis["The door"]["wheel"]
	_check(wv2.layout.has("The door/10") and wv2.layout["The door/10"].distance_to(wc) < wv2.layout["The door/6"].distance_to(wc), "the capstone is not inside the keystones on the wheel")
	_check(bk._key.fit_fails().is_empty(), "the points key's words don't fit: %s" % str(bk._key.fit_fails()))
	# and at the widest the key gets (the review): a level-50 Paramedic with points unspent, an element pool past 99
	var key_sim = Sim.new()
	key_sim.start()
	key_sim.set_class("Paramedic")
	key_sim.training_points = 49
	key_sim.element_points = {"shock": 412}
	key_sim.paragon_xp = 1e9
	bk._key.show_state(key_sim)
	_check(bk._key.fit_fails().is_empty(), "the points key's widest words don't fit: %s" % str(bk._key.fit_fails()))
	bk._key.show_state(sim)
	for tn in wv2._axis:
		_check(not wv2.region_words(tn).contains("meter") and not (wv2._trees[tn].has("element") and wv2.region_words(tn).contains("free")), "a region's label still carries the key's words: '%s'" % wv2.region_words(tn))
	# the gun in hand changes a typed node's look without anything else moving (the reviewer's catch)
	var typed_id := ""
	for b in Data.TREES:
		for i in range(b["nodes"].size()):
			if b["nodes"][i].has("type") and sim.tree.has("%s/%d" % [b["name"], i]) and typed_id == "":
				typed_id = "%s/%d" % [b["name"], i]
	if typed_id != "" and sim.equipped["Primary"] != null:
		var hold_gun = sim.equipped["Primary"]
		var typed_node: Dictionary = sim.node(typed_id)
		# a gun of the node's type, then one of another: the node goes active, then idle, and the screen follows
		var same_base := ""
		var other_base := ""
		for base in Data.BASES["Primary"]:
			if base.get("type", "") == typed_node["type"] and same_base == "":
				same_base = base["name"]
			elif base.get("type", "") != typed_node["type"] and other_base == "":
				other_base = base["name"]
		if same_base != "" and other_base != "":
			sim.equipped["Primary"] = sim._plain("Primary", same_base)
			main.refresh()
			var shown_active: String = bk._shown
			sim.equipped["Primary"] = sim._plain("Primary", other_base)
			main.refresh()
			_check(not sim._active(typed_node) and bk._shown != shown_active, "the gun swap did not refresh the Caravan: typed node %s" % typed_id)
		sim.equipped["Primary"] = hold_gun
		main.refresh()
		_check(bk._shown.contains(sim.gun_type()), "the Caravan's signature does not carry the gun in hand")
	sim.load_dict(saved)
	sim.core_gates = true
	print("the elements ok: affinities, double cost, the paths, the joints and their payoffs, the second past's joint, Spreads, Frozen solid, Builds, Won't stop, Knuckles, the Caravan's web")
	_capstone_checks(main)
	_melee_checks(main)


## Melee: no rounds, bleed built in, grip and head mounts, in among them.
## 28: a capstone a tree, past the keystone, wanting the keystone and every notable, a quarter of the tree again (a third until the pass).
func _capstone_checks(main) -> void:
	var sim = main.sim
	sim.core_gates = false            # Training's 15 Oct gates are _training_gate_checks'; this area tests the mechanics
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	# every tree carries one, last, wide on the Caravan, and its cost is a third of the tree rounded up
	for b in Data.TREES + Data.ELEMENT_TREES:
		var behind: Array = b["nodes"].filter(func(n): return not n.get("beside", false) and n.has("col") and not n.has("hang") and not n.has("xlinks") and not n.has("bridge"))     # a node beside the capstone (12 Oct) comes after it; the web's fillers and extras (22 Oct) come after everything and don't price it
		var last: Dictionary = behind.back()
		_check(last.get("capstone", false) and last.has("words") and last["effect"].begins_with("cap_"), "%s has no capstone at its end" % b["name"])
		_check(b["nodes"].filter(func(n): return n.get("capstone", false)).size() == 1, "%s has more than one capstone" % b["name"])
		# a quarter of the rest of the tree, rounded up; the two classes' halves in an element tree count once
		var others := 0
		var half := 0
		for i in range(behind.size() - 1):
			var nd: Dictionary = behind[i]
			var c: int = Data.node_cost(int(nd["col"]), nd.get("notable", false), nd.get("keystone", false))
			if nd.has("class"):
				half = maxi(half, c)
			else:
				others += c
		_check(Data.capstone_cost(b) == ceili((others + half) / 4.0), "%s's capstone costs %d, not a quarter of %d" % [b["name"], Data.capstone_cost(b), others + half])
		_check(int(last["col"]) == Data.COLUMNS - 1, "%s's capstone is not in the last column" % b["name"])
	# it opens when the path reaches it (the web, 22 Oct): nothing behind it, shut; the column before it taken, open
	_set_cls(sim, "Poacher")
	sim.tree = sim.tree.filter(func(id): return not str(id).begins_with("Snares/"))
	sim.training_points = 200
	var snares: Dictionary = Data.tree_named("Snares")
	var cap_id := Data.node_id_named("Snares/Poached")
	_check(not sim.can_train(cap_id) and sim.train_block(cap_id).begins_with("wants a path"), "the capstone opened with nothing behind it: '%s'" % sim.train_block(cap_id))
	# a path up the lane to the column before it: the rails and their fillers, the capstone's own links among them
	for i in range(snares["nodes"].size()):
		var nd: Dictionary = snares["nodes"][i]
		if not nd.get("capstone", false) and not nd.get("beside", false) and not nd.has("hang") and not nd.has("xlinks") and absf(float(nd["at"][1])) <= 1.0:
			sim.tree.append("Snares/%d" % i)
	_check(sim.can_train(cap_id) and sim.node_cost(cap_id) == Data.capstone_cost(snares), "the capstone did not open with the path behind it (cost %d): '%s'" % [sim.node_cost(cap_id), sim.train_block(cap_id)])
	_check(sim.train_node(cap_id) and sim.has_node("cap_poached"), "the capstone did not train")
	# Poached: a gang's arrival brings a find
	sim.deploy(3)
	var m: Dictionary = sim.mission
	m["remaining"] = 0
	m["cleared"] = true
	var found_before: int = m["found"].size() + int(m["left"])
	m["patrol_timer"] = 1e9
	sim.advance(0.5)
	_check(m["patrols"] >= 1 and m["found"].size() + int(m["left"]) > found_before, "Poached did not bring a find when the gang came")
	sim.extract_now()
	# the Caravan shows it as a ◆◆ tile the lane's height at its end, and the run band names it
	main.show_room(main.BARRACKS)
	main._barracks.selected = ""
	main._barracks._shown = ""
	main.refresh()
	var wvc = main._barracks.web()
	_check(wvc.layout.has(cap_id) and wvc.state_of(cap_id).get("taken", false) and NodeGlyphs.texture(NodeGlyphs.of(sim.node(cap_id))) != null, "the capstone is not on the web as taken, or has no glyph")
	_check_fit(main, "Caravan (capstone)")
	main._barracks._pick(cap_id)
	main.refresh()
	_check(main._barracks._title.text.ends_with("capstone · trained"), "the capstone's panel title is off: '%s'" % main._barracks._title.text)
	_check_fit(main, "Caravan (capstone picked)")
	sim.deploy(3)
	main.show_room(main.MISSIONS)
	main.refresh()
	_check(main._run._band.right[2].text.contains("Poached") or main._run._band.right[2].text.contains("capstone"), "the run band does not name the capstone: '%s'" % main._run._band.right[2].text)
	_check_fit(main, "Run (capstone)")
	sim.extract_now()
	# Dead quiet: every gang the size of the first; Ghost: a run starts at the search and a full pack brought home is the clear
	sim.tree.append("Stalking/%d" % _cap_idx("Stalking"))
	sim.deploy(3)
	m = sim.mission
	m["remaining"] = 0
	m["cleared"] = true
	m["patrols"] = 4
	m["patrol_timer"] = 1e9
	sim.advance(0.5)
	_check(m["remaining"] == sim.PATROL_BASE - (1 if sim.has_node("trapline") else 0), "Dead quiet let the fifth gang grow: %d" % m["remaining"])
	sim.extract_now()
	sim.tree = sim.tree.filter(func(id): return not str(id).begins_with("Stalking/"))
	_set_cls(sim, "Drifter")
	sim.tree.append("Moving on/%d" % _cap_idx("Moving on"))
	var best_before: int = sim.best_tier
	sim.deploy(3)
	m = sim.mission
	_check(m["remaining"] == 0 and m["cleared"] and m.get("ghost_pending", false), "Ghost did not start the run at the search")
	_check(sim.best_tier == best_before, "Ghost cleared the ladder on arrival")
	sim.extract_now()
	_check(sim.best_tier == best_before, "a Ghost run brought home light counted as a clear")
	sim.best_tier = 0
	sim.best_depth[3] = 0
	sim.deploy(3)
	m = sim.mission
	m["found"] = []
	while sim.pack_used(m) < sim.capacity():
		m["found"].append(sim._plain(Data.AMMO, "Nails"))
	sim.extract_now()
	_check(sim.best_tier == 4 and sim.best_depth[3] >= 1, "a Ghost run brought home full did not clear the site (best tier %d)" % sim.best_tier)
	sim.load_dict(saved)
	# Held: no second takes more than a tenth of you, their shots and what they left on you together
	sim.tree.append("The door/%d" % _cap_idx("The door"))
	var deep: int = sim.best_tier if sim.tier_open(sim.best_tier) else 0     # the deepest open (a flake: best_tier can name a tier whose zone isn't open)
	sim.deploy(deep)
	m = sim.mission
	m["remaining"] = 40
	sim.hp = sim.max_hp()
	sim.advance(1.0)
	_check(sim.on_mission() and float(m["last_incoming"]) <= sim.max_hp() * 0.1 + 0.01, "Held let a second take %.1f of %.1f" % [float(m["last_incoming"]), sim.max_hp()])
	sim.extract_now()
	sim.load_dict(saved)
	# Iron: a kill under half HP heals a tenth
	sim.tree.append(Data.node_id_named("Muscle/Iron"))
	sim.deploy(3)
	m = sim.mission
	sim.hp = sim.max_hp() * 0.3
	var hp_before: float = sim.hp
	var max_before: float = sim.max_hp()       # the kill's xp can bring a level, and the level more max HP: the tenth is of the max as it heals
	sim._kill(m, m["t"])
	_check(sim.hp >= hp_before + max_before * 0.1 - 0.01, "Iron did not heal on the kill: %.1f to %.1f" % [hp_before, sim.hp])
	sim.extract_now()
	sim.load_dict(saved)
	main.refresh()
	sim.core_gates = true
	print("the capstones ok: one a tree, the cost, the gate, Poached, the tile, the band, Dead quiet, Ghost, Held, Iron")


func _melee_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	var bat: Dictionary = sim._plain("Primary", "Spiked bat")
	_check(Items.is_melee(bat) and Items.ammo_words(bat) == "Takes no rounds" and bat["attachments"].has("grip") and bat["attachments"].has("business end"), "a spiked bat is not a melee weapon with a grip and a head")
	var old = sim.equipped["Primary"]
	sim.equipped["Primary"] = sim._plain("Primary", "Nail gun")
	var bleed0: float = sim.conversion()["bleed"]          # whatever the rest of the kit and the web add already
	sim.equipped["Primary"] = bat
	sim.rig = []
	_check(sim.has_rounds(bat) and sim.dps() > 0.0, "a bat ran dry")
	_check(is_equal_approx(sim.conversion()["bleed"], bleed0 + 0.2) or sim.conversion()["physical"] <= 0.001, "the bat's nails are not 20%% bleed on top of %.2f: %s" % [bleed0, str(sim.conversion())])
	var head: Dictionary = sim._plain("Attachment", "Nails through it")
	bat["attachments"]["business end"] = head
	_check(is_equal_approx(sim.conversion()["bleed"], bleed0 + 0.35) or sim.conversion()["physical"] <= 0.001, "nails through it did not add 15%% bleed: %s" % str(sim.conversion()))
	_check(is_equal_approx(sim.incoming_rate({"dps": 10.0, "types": {"physical": 1.0}}, 1), 10.0 * (1.0 - sim.mitigation()) * Data.MELEE_INCOMING), "a melee runner is not hit %.2f× harder" % Data.MELEE_INCOMING)
	# the first second of a gang: their shot before your swing
	sim.words[3] = []
	sim.set_depth(3, 1)
	sim.hp = sim.max_hp()
	sim.deploy(3)
	var m: Dictionary = sim.mission
	var hp0: float = m["target_hp"]
	sim.advance(0.5)
	_check(is_equal_approx(m["target_hp"], hp0), "the bat swung inside the first second of a gang")
	sim.advance(1.0)
	_check(m["target_hp"] < hp0 or m["remaining"] < m["t"]["pool"], "the bat never swung")
	sim.extract_now()
	# the Workshop shows the bat's grip and head, and fits a part to the head
	sim.stash.append(sim._plain("Attachment", "Tape"))
	main.show_room(main.WORKSHOP)
	main._workshop._set_view("guns")
	main.refresh()
	var labels := []
	for r in main._workshop._guns["Primary"]["rows"]:
		labels.append(r["mount"].text)
	_check(labels[0] == "Grip" and labels[1] == "Business end" and labels[2] == "" and main._workshop._guns["Primary"]["rows"][2]["button"].visible and not main._workshop._guns["Primary"]["rows"][3]["button"].visible, "the bat's rows are %s (the third a hollow slot, no second row)" % str(labels))
	_check_fit(main, "Workshop (a bat)")
	main._workshop._pick_row("Primary", 0)
	_check(main._workshop.sel_mount == "grip", "picking the first row did not pick the grip")
	main._workshop._pick_cell(0)
	main._workshop._press(0)
	_check(bat["attachments"]["grip"] != null and bat["attachments"]["grip"]["mount"] == "grip", "a grip part did not fit the grip")
	_check_fit(main, "Workshop (a bat, taped)")
	# a bat's part on the panel: the kind leads, the mount reads as a word, and nothing calls a bat a gun
	var lead: Dictionary = sim._plain(Data.ATTACHMENT, "Lead in it")
	while not sim.stash_room(1) and not sim.stash.is_empty():
		sim.sell(sim.stash[0])
	sim.stash.append(lead)
	main._workshop.sel_slot = ""
	main._workshop.sel_mount = ""
	main.refresh()
	main._workshop._pick_cell(main._workshop._inv.cell_of(lead["id"]))
	main.refresh()
	var lead_chips: Array = main._workshop._pick._heads[0]._chip_labels.filter(func(l): return l.visible).map(func(l): return l.text)
	_check(lead_chips.size() >= 2 and lead_chips[0] == "Melee part" and lead_chips[1] == "Business end", "a bat part's chips are %s" % str(lead_chips))
	_check(not main._workshop._pick._kickers[1].text.to_lower().contains("gun") and not main._workshop._pick._right_title.text.contains("gun"), "a bat part's panel talks of a gun: '%s' / '%s'" % [main._workshop._pick._kickers[1].text, main._workshop._pick._right_title.text])
	_check_fit(main, "Workshop (a bat part)")
	# a part with a long kind line and an affix in the Lock-up: fits, the part's own figures first, the affix banded
	var bipod: Dictionary = sim._plain(Data.ATTACHMENT, "Bipod")
	bipod["rarity"] = 1
	bipod["affixes"] = [{"stat": "damage_pct", "value": 4, "tier": 2}]
	while not sim.stash_room(1) and not sim.stash.is_empty():
		sim.sell(sim.stash[0])
	sim.stash.append(bipod)
	main.show_room(main.ARMOURY)
	main.refresh()
	main._armoury._pick_cell(main._armoury._inv.cell_of(bipod["id"]))
	main.refresh()
	var bhead = main._armoury._head
	_check(bhead.visible and bhead._title.text == "Bipod" and bhead._figure.text == "+18%", "the part's head is off: '%s' '%s'" % [bhead._title.text, bhead._figure.text])
	_check(bhead._tail.text.contains("−6% pace") and not bhead._tail.text.contains("+22"), "the part's own figures carry its affix too: '%s'" % bhead._tail.text)
	_check(bhead._affixes.visible and bhead._affixes.words(0) == "+4% dmg" and bhead._affixes._tags[0].text == "T2" and bhead._affixes._labels[0].get_theme_color("font_color") == Pal.tier_color(2), "the part's affix is not a chip in its tier's colour: '%s'" % bhead._affixes.words(0))
	var chip_words := []
	for k in range(bhead.CHIPS):
		if bhead._chips[k].visible:
			chip_words.append(bhead._chip_labels[k].text)
	_check(chip_words.has("Gun part") and chip_words.has("Handguard") and chip_words.has("Uncommon") and chip_words.has("Rifles only") and not chip_words.has("1 cell"), "the part's chips are %s" % str(chip_words))
	_check_fit(main, "Armoury (a bipod)")
	sim.stash.erase(bipod)
	# the set pieces with three affixes (27 Oct: HP on the Bank's and the Fire Crew's): every one a chip in the head
	for sn in ["The Bank's", "The Fire Crew's"]:
		for pc in Items.set_named(sn)["pieces"]:
			if pc["affixes"].size() < 3:
				continue
			var sp: Dictionary = Items.roll_set_piece(sn, pc, sim.rng, 60)
			while not sim.stash_room(6) and not sim.stash.is_empty():
				sim.sell(sim.stash[0])
			sim.stash.append(sp)
			main.refresh()
			main._armoury._pick_cell(main._armoury._inv.cell_of(sp["id"]))
			main.refresh()
			var ac = main._armoury._head._affixes
			_check(ac.asked >= 3 and ac.shown() == ac.asked, "%s shows %d of its %d chips" % [pc["name"], ac.shown(), ac.asked])     # its 3 affixes and the rest: none dropped
			sim.stash.erase(sp)
	main.refresh()
	# a gun with parts and a socketable on: the head's tail names them, the fitted gun's right column lists them
	var kitted: Dictionary = sim._plain("Primary", "Workshop SMG")
	kitted["attachments"]["optic"] = sim._plain(Data.ATTACHMENT, "Red dot")
	kitted["attachments"]["muzzle"] = sim._plain(Data.ATTACHMENT, "Choke") if Data.ATTACHMENTS.any(func(b): return b["name"] == "Choke") else null
	kitted["attachments"]["socket 1"] = sim._plain(Data.ATTACHMENT, "Lighter fluid")
	var held_primary = sim.equipped["Primary"]
	sim.equipped["Primary"] = kitted
	main._armoury._pick_slot("Primary")
	main.refresh()
	var khead = main._armoury._head
	_check(khead._tail.text.contains("Red dot") or khead._tail.text.contains("part"), "a kitted gun's head does not say what's on it: '%s'" % khead._tail.text)
	_check(main._armoury._pick._right_lines[0].text.begins_with("Red dot"), "the fitted gun's column does not list its parts: '%s'" % main._armoury._pick._right_lines[0].text)
	_pick_boxes_check(main._armoury._pick, "the Lock-up's pick")
	_check(main._armoury._pick._right_lines.any(func(l): return l.text.begins_with("Lighter fluid")), "the socketable is not listed with the parts")
	_check_fit(main, "Armoury (a kitted gun)")
	sim.equipped["Primary"] = held_primary
	var kit_words: Array = Items.fitted_words(kitted)
	_check(kit_words[0].contains("Red dot") and kit_words[0].contains("lighter fluid") and kit_words[1].contains("socketable") and kit_words[2].ends_with("fitted"), "fitted_words: %s" % str(kit_words))
	main.show_room(main.WORKSHOP)
	main.refresh()
	# the Bench's heading (9 Oct): its picks built in the Yard; every mount open, no upgrade button
	for picks_on in [false, true]:
		_yard_set(sim, "bench", 0, "b" if picks_on else "")
		_yard_set(sim, "bench", 1, "a" if picks_on else "")
		main._workshop._shown = ""
		main.refresh()
		_check(main._workshop._headline.text == ("2 of 5" if picks_on else "0 of 5"), "the Bench's heading reads '%s'" % main._workshop._headline.text)
		_check(main._workshop._next.text.contains("Cheap parts") == picks_on, "the Bench's heading does not name its picks: '%s'" % main._workshop._next.text)
		var chips = main._workshop._chips
		# the band (Bands-U A): the purse down the left under the headline, the views at the foot, right, the line between
		var ws = main._workshop
		var cr := Rect2(chips.position, chips.size)
		_check(ws.HEAD_H == Pal.BAND_H and cr.position.y >= ws._headline.position.y + ws._headline.size.y and cr.end.x <= ws.PAD + Pal.BAND_TEXT_W + 0.5 and cr.end.y <= ws.HEAD_H - 8 and chips.shown() == 0,     # no purse chips since 18 Oct (said once)
 "the purse chips are off their place in the band: %s, %d shown" % [str(cr), chips.shown()])
		for v in ws._views:
			var vr := Rect2(v.position, v.size)
			_check(vr.end.y <= ws.HEAD_H - 8 and vr.end.x <= ws.size.x - ws.PAD + 0.5 and not vr.intersects(cr) and not vr.intersects(Rect2(ws._next.position, ws._next.size)), "a view's tab is off the band's foot or on the purse or the line: %s" % str(vr))
		var prim = sim.equipped["Primary"]
		if prim != null:
			for r in main._workshop._guns["Primary"]["rows"]:
				if r["key"] != "" and prim["attachments"].get(r["key"], null) != null:
					var part: Dictionary = prim["attachments"][r["key"]]
					_check(r["fitted"].get_theme_color("font_color") == Pal.tier_color(int(part.get("tier", 1))), "the %s tile is not in its part's tier colour" % r["key"])
		_check_fit(main, "Workshop (picks %s)" % str(picks_on))
	_yard_set(sim, "bench", 0, "")
	_yard_set(sim, "bench", 1, "")
	# a bench job on the craft view's piece shows at once, with nothing re-picked (notes paid: the level bump)
	var ws_piece: Dictionary = sim._plain("Helmet", "Hard hat")
	if sim.stash_room(1):
		sim.stash.append(ws_piece)
		main._workshop._set_view("craft")
		main.refresh()
		var kc: int = main._workshop._inv.cell_of(ws_piece["id"])
		if kc >= 0:
			main._workshop._pick_cell(kc)
			main.refresh()
			var before_words: String = main._workshop._piece_chips.words(1)
			sim.notes += 1000
			sim.craft(ws_piece["id"], "bump")
			main.refresh()
			_check(main._workshop._piece_chips.words(1) != before_words or main._workshop._foot.get_theme_color("font_color") == Pal.GOOD, "the craft view did not refresh after a bump: '%s'" % main._workshop._piece_chips.words(1))
		sim.stash.erase(ws_piece)
		main._workshop._set_view("guns")
		main.refresh()
	# a long part name on a tile falls back to its first word, never an ellipsis
	_check(main._workshop._short_names("Drum magazine") == ["Drum magazine", "Drum"] and main._workshop._short_names("Tape") == ["Tape"], "the tile's short names are off: %s" % str(main._workshop._short_names("Drum magazine")))     # no word cut (20 Oct): the type steps down instead
	var drum_gun = sim.equipped["Primary"]
	if drum_gun != null and drum_gun["attachments"].has("magazine"):
		var hold_mag = drum_gun["attachments"]["magazine"]
		drum_gun["attachments"]["magazine"] = sim._plain("Attachment", "Drum magazine")
		main._workshop._shown = ""
		main.refresh()
		_check_fit(main, "Workshop (a drum magazine on a tile)")
		drum_gun["attachments"]["magazine"] = hold_mag
		main._workshop._shown = ""
		main.refresh()
	main.refresh()
	sim.stash.erase(lead)
	# Through the lot: a Doorman's swing hits everyone on you
	_set_cls(sim, "Doorman")
	sim.respec()
	sim.tree = []                    # the Pitch's too: a respec keeps the camp's (21 Oct), the fixture wants it bare
	sim.training_points += 30
	for i in [0, 1, 2, 3, 7, 8]:
		_walk(sim, "The door/%d" % i)
	_check(sim.has_node("melee_sweep"), "Through the lot did not take with a bat in hand")
	sim.equipped["Primary"] = sim._plain("Primary", "Army SMG")
	_check(not sim.has_node("melee_sweep"), "Through the lot counts with a gun")
	sim.equipped["Primary"] = old
	sim.load_dict(saved)
	print("melee ok: no rounds, the nails, the mounts, the wait, harder hit, the Workshop, Through the lot")
	_unique_rules_checks(main)


## The build-defining uniques: every one rolls and has words; the depth
## gates on the loose pool and the mate; each rule does its thing.
func _unique_rules_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	for u in Data.UNIQUES:
		var it := Items.roll_unique(u, sim.rng)
		_check(it["unique"] == u["name"] and Words.UNIQUES.has(u["name"]), "%s does not roll, or has no words" % u["name"])
	_check(sim.loose_uniques(1).size() == 7 and sim.loose_uniques(12).size() > 10 and sim.loose_uniques(25).size() == sim.loose_uniques(99).size(), "the depth gates on the loose pool are off: %d / %d / %d" % [sim.loose_uniques(1).size(), sim.loose_uniques(12).size(), sim.loose_uniques(25).size()])
	for i in range(sim.best_depth.size()):
		sim.best_depth[i] = 1
	for k in range(20):
		_check(int(sim._unique_named(sim.roll_mate()["unique"]).get("depth", 0)) == 0, "the mate sold a deep unique before anyone had been deep")
	sim.best_depth[3] = 25
	var deep := 0
	for k in range(40):
		deep += 1 if int(sim._unique_named(sim.roll_mate()["unique"]).get("depth", 0)) >= 6 else 0     # the build ones open at 6 now (12 Oct)
	_check(deep > 10, "the mate's deep stock did not open at depth 25: %d of 40" % deep)
	# a bare runner to hang each rule on
	for s in Data.SLOTS:
		sim.equipped[s] = null
	sim.equipped["Primary"] = sim._plain("Primary", "Army SMG")
	sim.respec()
	sim.tree = []                    # the Pitch's too: a respec keeps the camp's (21 Oct), the fixture wants it bare
	sim.words[3] = []
	sim.set_depth(3, 1)
	var t: Dictionary = sim.effective(3)
	# the burner: all fire, spreads; it takes rounds now (25 Oct, the review: trimmed)
	var burner := Items.roll_unique(sim._unique_named("The Council's Weed Burner"), sim.rng)
	sim.equipped["Primary"] = burner
	_check(is_equal_approx(sim.conversion()["fire"], 1.0) and Items.ammo_words(burner) != "Takes no rounds" and not Items.free_rounds(burner), "the burner is not all fire, or still free: %s" % str(sim.conversion()))
	sim.equipped["Primary"] = sim._plain("Primary", "Army SMG")
	# Jump Leads: a third shock
	sim.equipped["Secondary"] = Items.roll_unique(sim._unique_named("Jump Leads"), sim.rng)
	_check(sim.conversion()["shock"] >= 0.33, "Jump Leads did not add a third shock: %s" % str(sim.conversion()))
	sim.equipped["Secondary"] = null
	# the bag and the steel: stacks, more, and the carry on a kill
	sim.equipped["Backpack"] = Items.roll_unique(sim._unique_named("The Rat Man's Bag"), sim.rng)
	_check(sim.dot_stacks("poison") == 999, "the bag did not uncap poison")
	sim.deploy(3)
	var m: Dictionary = sim.mission
	m["dots"] = {"poison": 50.0}
	m["target_hp"] = 0.0
	m["remaining"] = 3
	sim.advance(0.1)
	_check(m.get("dots", {}).has("poison") and m["dots"]["poison"] > 0.0, "poison did not carry to the next with the bag: %s" % str(m.get("dots", {})))
	sim.extract_now()
	sim.equipped["Backpack"] = null
	sim.equipped["Primary"] = Items.roll_unique(sim._unique_named("The Butcher's Steel"), sim.rng)
	_check(is_equal_approx(sim.more("bleed"), 2.0), "the steel is not ×2 bleed")
	sim.equipped["Primary"] = sim._plain("Primary", "Army SMG")
	# the hopper: chilled always, one at a time
	sim.equipped["Armour"] = Items.roll_unique(sim._unique_named("The Gritter's Hopper"), sim.rng)
	sim.deploy(3)
	m = sim.mission
	sim.advance(0.1)
	_check(float(m.get("chill_t", 0.0)) > 0.0 and sim.contact(t) == 1, "the hopper did not chill them and bring them one at a time: chill %.1f contact %d" % [float(m.get("chill_t", 0.0)), sim.contact(t)])
	sim.extract_now()
	sim.equipped["Armour"] = null
	# the gloves: their shock resist is nothing
	sim.equipped["Charm"] = Items.roll_unique(sim._unique_named("The Sparky's Gloves"), sim.rng)
	sim.equipped["Primary"]["affixes"] = [{"stat": "conv_shock_pct", "value": 50, "tier": 5}]
	var full: float = sim.damage_rate({"res": {}})
	_check(is_equal_approx(sim.damage_rate({"res": {"shock": 0.6}}), full), "the gloves did not ignore their shock resist")
	sim.equipped["Primary"]["affixes"] = []
	# the manual: every element yours
	sim.equipped["Charm"] = Items.roll_unique(sim._unique_named("The Quartermaster's Manual"), sim.rng)
	_check(sim.affinity("poison") and sim.affinity("frost") and sim.node_cost("The Rat Man/0") == 1, "the manual did not make every element the runner's")
	# the plaque: all resists, nothing else
	sim.equipped["Charm"] = Items.roll_unique(sim._unique_named("A Blue Plaque"), sim.rng)
	sim.equipped["Primary"]["affixes"] = [{"stat": "damage_pct", "value": 50, "tier": 5}]
	_check(is_equal_approx(sim._affix_sum("damage_pct"), 0.0) and sim.resist("fire") >= 0.4, "the plaque did not blank the rest: dmg %.0f fire res %.2f" % [sim._affix_sum("damage_pct"), sim.resist("fire")])
	sim.equipped["Primary"]["affixes"] = []
	# the sign: the first drops, gangs half as often
	sim.equipped["Charm"] = null
	sim.equipped["Secondary"] = Items.roll_unique(sim._unique_named("The Lollipop Lady's Sign"), sim.rng)
	var p0: float = sim.patrol_s(t)
	sim.equipped["Secondary"] = null
	_check(p0 >= sim.patrol_s(t) * 2.0, "the sign did not halve the gangs")
	# the pencil, the Float, the cardigan, the ladle, the hat, the thermos, the whistles, the tester, the flask, the keys, the log
	var r0: float = sim.rarity_bonus()
	sim.equipped["Charm"] = Items.roll_unique(sim._unique_named("The Bookie's Pencil"), sim.rng)
	_check(sim.rarity_bonus() > r0 * 1.5 + 0.1, "the pencil did not double magic find")
	sim.equipped["Charm"] = null
	var cap0: int = sim.capacity()
	var pace0: float = sim.pace()
	sim.equipped["Rig"] = sim._plain("Rig", "Bum bag")
	sim.equipped["Backpack"] = Items.roll_unique(sim._unique_named("The Float"), sim.rng)
	sim.rig = [sim._plain(Data.MEDICAL, "Bandage")]
	var float_box: Dictionary = sim._plain(Data.AMMO, "Shells")
	sim.stash.append(float_box)
	_check(sim.med_capacity() > 0 and sim.first_med().is_empty() and sim.meds_carried() == 0 and sim.pace() > pace0 * 1.35 and sim.capacity() > cap0, "the Float did not do its three things (no meds, the rig kept, pace, pack): rig %d meds %d pace %.2f cap %d" % [sim.med_capacity(), sim.meds_carried(), sim.pace() / pace0, sim.capacity()])
	var float_med: Dictionary = sim._plain(Data.MEDICAL, "Bandage")
	sim.stash.append(float_med)
	_check(not sim.take(int(float_med["id"])) and sim.take(int(float_box["id"])), "under the Float a med went in the rig, or rounds didn't (18 Oct: it stops the meds only)")
	sim.stash.erase(float_med)
	# the Field kit's bandage doesn't go in the Float's rig either (the review: dead bandages filled the pouches)
	sim.rig = []
	_yard_set(sim, "clinic", 3, "b")         # the Field kit
	sim._yard_setting_off()
	_check(not sim.yard_has("field_kit") or sim.rig.all(func(r): return not Items.is_medical(r)), "under the Float the Field kit put a med in the rig")
	_yard_set(sim, "clinic", 3, "")
	sim.rig = []
	sim.equipped["Backpack"] = null
	sim.equipped["Rig"] = null
	sim.equipped["Armour"] = Items.roll_unique(sim._unique_named("Nan's Cardigan"), sim.rng)
	_check(is_equal_approx(sim.mitigation(), 0.0), "Nan's Cardigan has armour")
	sim.hp = sim.max_hp() * 0.5
	sim.deploy(3)
	var h0: float = sim.hp
	sim.advance(1.0)
	_check(sim.hp > h0 + sim.max_hp() * 0.012 or sim.hp >= sim.max_hp() - 0.1 or sim.mission == null, "the cardigan did not give 3%% a second: %.1f -> %.1f of %.1f" % [h0, sim.hp, sim.max_hp()])
	sim.extract_now()
	sim.equipped["Armour"] = null
	sim.equipped["Primary"] = Items.roll_unique(sim._unique_named("The Dinner Lady's Ladle"), sim.rng)
	sim.hp = sim.max_hp() * 0.5
	sim.deploy(3)
	m = sim.mission
	h0 = sim.hp
	m["target_hp"] = 0.0
	sim.advance(0.05)
	_check(sim.hp >= h0 + sim.max_hp() * 0.1 - 1.0, "the ladle did not heal a tenth on a kill: %.1f -> %.1f" % [h0, sim.hp])
	sim.extract_now()
	sim.equipped["Primary"] = sim._plain("Primary", "Army SMG")
	sim.equipped["Helmet"] = Items.roll_unique(sim._unique_named("A Traffic Warden's Hat"), sim.rng)
	_check(sim.notes_a_kill(t) == 2 * (int(ceil(Data.NOTES_KILL * 1.0)) + sim.atlas_rank("paid_in_notes")) or sim.notes_a_kill(t) >= 2, "the hat did not double the notes")
	sim.equipped["Helmet"] = null
	sim.equipped["Charm"] = Items.roll_unique(sim._unique_named("The Vicar's Thermos"), sim.rng)
	_check(is_equal_approx(sim.resist("fire"), 0.0), "the thermos left a fire resist")
	sim.deploy(3)
	m = sim.mission
	m["my_dots"] = {"fire": 40.0}
	sim.hp = sim.max_hp() * 0.5
	h0 = sim.hp
	m["remaining"] = 1
	m["target_hp"] = 1e9
	sim.advance(0.5)
	_check(sim.hp > h0 - 1.0, "the thermos did not turn the burn to warmth: %.1f -> %.1f" % [h0, sim.hp])
	sim.extract_now()
	sim.equipped["Charm"] = Items.roll_unique(sim._unique_named("The Scout Leader's Whistle"), sim.rng)
	sim.deploy(3)
	m = sim.mission
	m["remaining"] = 0
	m["cleared"] = true
	m["patrol_timer"] = 1e9
	sim.advance(0.1)
	_check(m["remaining"] == 1, "the scout's whistle did not make the gang one: %d" % m["remaining"])
	sim.extract_now()
	sim.equipped["Charm"] = null
	var c0: int = sim.contact(t)
	sim.equipped["Helmet"] = Items.roll_unique(sim._unique_named("The Sergeant's Whistle"), sim.rng)
	_check(sim.contact(t) == c0 + 2 and is_equal_approx(sim.more("physical"), 1.6), "the Sergeant's Whistle: contact %d more %.1f" % [sim.contact(t), sim.more("physical")])
	sim.equipped["Helmet"] = null
	sim.equipped["Secondary"] = Items.roll_unique(sim._unique_named("The Electrician's Tester"), sim.rng)
	_check(is_equal_approx(sim.more("shock"), 0.5), "the tester is not half shock")
	sim.equipped["Secondary"] = null
	sim.equipped["Charm"] = Items.roll_unique(sim._unique_named("The Gamekeeper's Flask"), sim.rng)
	sim.deploy(3)
	m = sim.mission
	m["t"]["types"] = {"physical": 0.5, "poison": 0.5}
	m["target_hp"] = 1e9
	sim.advance(0.5)
	_check(m.get("dots", {}).get("poison", 0.0) > 0.0, "the flask did not poison them back: %s" % str(m.get("dots", {})))
	sim.extract_now()
	sim.words[3] = []
	sim.equipped["Charm"] = Items.roll_unique(sim._unique_named("The Caretaker's Keys"), sim.rng)
	var fired := 0
	for k in range(5):
		sim.deploy(3)
		fired += 1 if sim.mission["event"] != "" else 0
		sim.extract_now()
	_check(fired == 5, "the keys did not make something happen every run: %d of 5" % fired)
	sim.equipped["Charm"] = null
	var log_v := Items.roll_unique(sim._unique_named("The Lorry Driver's Log"), sim.rng)
	sim.stash.append(log_v)
	_check(sim.has_rule("drivers_log") and sim.insure_cost(3) == 0, "the log in the stash did not count, or insurance isn't free")
	sim.stash.erase(log_v)
	sim.load_dict(saved)
	print("the uniques ok: all roll with words, the depth gates, the mate's deep stock, twenty-one rules")
	_unique_tier_checks(main)
	_over_cap_checks(main)
	_guard_checks(main)
	_set_checks(main)


## Over the cap (12 Oct, docs/design/over_the_cap.md): a resist past 75 is its element's damage, a point a point, to
## 50; all resists count; physical never; the Water cannon soaks it; the new lines roll where they should.
func _over_cap_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	for s in Data.SLOTS:
		sim.equipped[s] = null
	sim.equipped["Primary"] = sim._plain("Primary", "Army SMG")
	var inc0: float = sim.increased("fire")
	var coat: Dictionary = sim._plain("Armour", "Stab vest")
	coat["affixes"] = [{"stat": "fire_res", "value": 60}]
	var hat: Dictionary = sim._plain("Helmet", "Hard hat")
	hat["affixes"] = [{"stat": "fire_res", "value": 50}]
	sim.equipped["Armour"] = coat
	sim.equipped["Helmet"] = hat
	_check(is_equal_approx(sim.resist("fire"), 0.75) and is_equal_approx(sim.resist_raw("fire"), 110.0) and is_equal_approx(sim.over_cap("fire"), 35.0), "110 fire resist is not 75%% and 35 over: %.2f / %.0f" % [sim.resist("fire"), sim.over_cap("fire")])
	_check(is_equal_approx(sim.increased("fire") - inc0, 35.0), "35 over the cap is not +35%% fire: +%.0f" % (sim.increased("fire") - inc0))
	hat["affixes"] = [{"stat": "fire_res", "value": 200}]
	_check(is_equal_approx(sim.over_cap("fire"), Data.OVER_CAP), "over the cap is not held at %d" % int(Data.OVER_CAP))
	hat["affixes"] = [{"stat": "all_res", "value": 80}]
	coat["affixes"] = []
	_check(is_equal_approx(sim.over_cap("frost"), 5.0) and is_equal_approx(sim.over_cap("poison"), 5.0) and sim.over_cap("physical") == 0.0, "all resists did not go over the cap on each, or physical did")
	hat["affixes"] = [{"stat": "fire_proofed", "value": 20}]
	_check(is_equal_approx(sim.resist("fire"), 0.2) and is_equal_approx(sim.increased("fire") - inc0, 20.0), "the -proofed line is not resist and damage")
	# the Water cannon: a run's resists down
	sim.equipped["Charm"] = Items.roll_unique(sim._unique_named("A Blue Plaque"), sim.rng)
	coat["affixes"] = [{"stat": "fire_res", "value": 100}]
	_check(sim.over_cap("fire") == 0.0, "the Blue Plaque went over the cap")
	sim.equipped["Charm"] = null
	coat["affixes"] = []
	hat["affixes"] = [{"stat": "fire_res", "value": 100}]
	sim.hp = sim.max_hp()
	sim.words[3] = []
	sim.deploy(3)
	_check(sim.mission != null, "the over-the-cap run did not set off")
	if sim.mission == null:
		sim.load_dict(saved)
		return
	sim.mission["t"]["soaked"] = 0.3
	sim._dry_memo.clear()                 # the run's memo read the resists at the gate
	_check(is_equal_approx(sim.resist_raw("fire"), 70.0) and is_equal_approx(sim.resist("fire"), 0.7) and sim.over_cap("fire") == 0.0, "soaked did not take 30 off: %.0f" % sim.resist_raw("fire"))
	sim.extract_now()
	_check(sim.word_words("Water cannon", 1)[0].contains("your resist"), "the Water cannon's bite has no words: %s" % str(sim.word_words("Water cannon", 1)))
	# where the lines roll
	var on := func(slot: String, stat: String) -> bool: return Items.allowed_affixes(slot).any(func(a): return a["stat"] == stat)
	_check(on.call("Rig", "fire_res") and on.call("Rig", "all_res") and on.call("Armour", "fire_proofed") and on.call("Helmet", "bleed_proofed") and not on.call("Charm", "fire_proofed") and not on.call("Primary", "fire_proofed"), "the resists or the -proofed lines roll in the wrong slots")
	# every element tree's notable over the cap, and Knuckles' armour one
	for et in Data.ELEMENT_TREES:
		var want: String = "thick_skinned" if et["element"] == "physical" else "proof_" + str(et["element"])
		_check(et["nodes"].any(func(n): return n["effect"] == want and int(n.get("col", 0)) == 5 and int(n.get("row", 0)) == 1), "%s has no over-the-cap node" % et["name"])
	sim.load_dict(saved)
	print("over the cap ok: 110 is 75 and +35, held at 50, all resists, never physical, -proofed, soaked, the lines' slots, the six nodes")


## Guard (12 Oct, docs/design/shields.md): their fire comes off Guard first; the cap; the Paramedic's overheal and a
## med's overflow; each class's node at its moment; Transfusion fills it; gone at the extract.
func _guard_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	for s in Data.SLOTS:
		sim.equipped[s] = null
	sim.equipped["Primary"] = sim._plain("Primary", "Army SMG")
	_set_cls(sim, "Doorman")
	sim.respec()
	sim.tree = []                    # the Pitch's too: a respec keeps the camp's (21 Oct), the fixture wants it bare
	sim.words[3] = []
	sim.hp = sim.max_hp()
	sim.deploy(3)
	var m: Dictionary = sim.mission
	_check(sim.guard() == 0.0 and is_equal_approx(sim.guard_cap(), sim.max_hp() * Data.GUARD_SHARE), "a bare Doorman starts with Guard, or its cap is off: %.0f of %.0f" % [sim.guard(), sim.guard_cap()])
	sim._guard_add(m, 1000000.0)
	_check(is_equal_approx(sim.guard(), sim.guard_cap()), "Guard went past its cap")
	m["guard"] = 50.0
	var hp0: float = sim.hp
	sim._take(m, 10.0)
	_check(is_equal_approx(sim.guard(), 40.0) and is_equal_approx(sim.hp, hp0), "Guard did not take the hit first")
	sim._take(m, 100.0)
	_check(sim.guard() == 0.0 and is_equal_approx(sim.hp, hp0 - 60.0), "what Guard couldn't take did not come off HP: %.0f" % (hp0 - sim.hp))
	sim.hp = sim.max_hp()
	sim._heal(m, 30.0)
	_check(sim.guard() == 0.0, "a Doorman's overflow became Guard")
	sim._heal(m, 30.0, true, 0.5)
	_check(is_equal_approx(sim.guard(), 15.0), "a med's overflow line did not make Guard: %.0f" % sim.guard())
	# the class nodes, at their moments
	var node_id := func(tree_name: String, effect: String) -> String:
		for t in Data.TREES:
			if t["name"] == tree_name:
				for k in range(t["nodes"].size()):
					if t["nodes"][k]["effect"] == effect:
						return "%s/%d" % [tree_name, k]
		return ""
	m["guard"] = 0.0
	sim.tree.append(node_id.call("The door", "squared_up"))
	_check(sim.has_node("squared_up"), "Squared up did not take")
	sim._gang_arrives(m)
	_check(is_equal_approx(sim.guard(), minf(sim.guard_cap(), sim.max_hp() * 0.15)), "Squared up gave %.0f, not 15%% of max HP to the cap" % sim.guard())
	m["guard"] = 0.0
	var coat: Dictionary = sim._plain("Armour", "Stab vest")
	coat["affixes"] = [{"stat": "guard_gang", "value": 8}]
	sim.equipped["Armour"] = coat
	sim._gang_arrives(m)
	_check(is_equal_approx(sim.guard(), minf(sim.guard_cap(), sim.max_hp() * 0.23)), "Squared up and the guard line did not add to the cap: %.0f" % sim.guard())
	sim.extract_now()
	sim.equipped["Armour"] = null
	sim.tree.erase(node_id.call("The door", "squared_up"))
	sim.hp = sim.max_hp()
	sim.deploy(3)
	_check(sim.mission != null and sim.guard() == 0.0, "the next run started with Guard")
	if sim.mission != null:
		sim.extract_now()
	# the other three classes' nodes at their moments, through the run's own code
	for cd in [["Poacher", "Stalking", "in_the_hide"], ["Scrapper", "Stripping", "sheet_metal"], ["Drifter", "Moving on", "breather"]]:
		_set_cls(sim, cd[0])
		sim.tree.append(node_id.call(cd[1], cd[2]))
		_check(sim.has_node(cd[2]), "%s did not take" % cd[2])
		sim.hp = sim.max_hp()
		sim.deploy(3)
		if sim.mission == null:
			_check(false, "the %s run did not set off" % cd[2])
			continue
		m = sim.mission
		m["guard"] = 0.0
		match cd[2]:
			"in_the_hide":
				m["fresh"] = true
				m["remaining"] = 3
				m["target_hp"] = -1.0
			_:
				m["remaining"] = 0
				m["target_hp"] = 0.0
				m["cleared"] = true
				m["search"] = sim.search_s(m["t"])
		sim.advance(0.05)
		_check(sim.guard() > 0.0, "%s gave no Guard at its moment" % cd[2])
		sim.extract_now()
		sim.tree.erase(node_id.call(cd[1], cd[2]))
	sim.load_dict(saved)
	saved = sim.to_dict()
	_set_cls(sim, "Paramedic")
	sim.respec()
	sim.tree = []                    # the Pitch's too: a respec keeps the camp's (21 Oct), the fixture wants it bare
	for s_ in Data.SLOTS:
		sim.equipped[s_] = null                 # a bare runner: no Guard line on the kit (they roll now)
	sim.equipped["Primary"] = sim._plain("Primary", "Army SMG")
	sim.words[3] = []
	sim.hp = sim.max_hp()
	sim.deploy(3)
	m = sim.mission
	m["guard"] = 0.0
	var half: float = sim.guard_cap() * 0.5
	sim._heal(m, half)
	_check(is_equal_approx(sim.guard(), half), "the Paramedic's overheal did not make Guard: %.0f of %.0f" % [sim.guard(), half])
	sim.tree.append(node_id.call("Shifts", "overtime"))
	_check(is_equal_approx(sim.guard_cap(), sim.max_hp() * Data.GUARD_SHARE * 1.5), "Overtime did not grow Guard's cap by half")
	sim.tree.erase(node_id.call("Shifts", "overtime"))
	sim.tree.append(node_id.call("Shifts", "cap_transfusion"))
	_check(sim.has_node("cap_transfusion") and is_equal_approx(sim.guard_cap(), sim.max_hp() * Data.GUARD_SHARE * 2.0), "Transfusion did not double Guard's cap")
	m["using"] = {"name": "Bandage", "left": 0.0, "heal": 5.0}
	sim._patch(m, 0.1)
	_check(is_equal_approx(sim.guard(), sim.guard_cap()), "Transfusion's med did not fill Guard to the top: %.0f of %.0f" % [sim.guard(), sim.guard_cap()])
	# what Guard takes is Guard's on the run screen, not red: the red figures count only what reached HP
	var taken0: float = float(m.get("taken", 0.0))
	var by0: float = 0.0
	for ty in m.get("taken_by", {}):
		by0 += float(m["taken_by"][ty])
	m["t"]["dps"] = 1.0
	m["remaining"] = maxi(1, int(m["remaining"]))
	sim.advance(1.0)
	var by1: float = 0.0
	for ty in m.get("taken_by", {}):
		by1 += float(m["taken_by"][ty])
	_check(sim.mission == null or (float(m.get("guarded", 0.0)) > 0.0 and absf((by1 - by0) - (float(m.get("taken", 0.0)) - taken0)) < 0.5), "Guard's share went into the red figures: by type +%.1f, to HP +%.1f, guarded %.1f" % [by1 - by0, float(m.get("taken", 0.0)) - taken0, float(m.get("guarded", 0.0))])
	# the Stats sheet says where Guard comes from, in its colour
	main.show_room(main.RUNNER)
	main.refresh()
	var gnote: Label = main._stats.cards["defence"]["note"]
	_check(gnote.text.begins_with("Guard ") and gnote.text.contains("overheal"), "the Stats sheet's defence does not say where Guard comes from: '%s'" % gnote.text)
	_check_fit(main, "Stats (Guard)")
	if sim.mission != null:
		sim.extract_now()
	sim.load_dict(saved)
	print("Guard ok: first off Guard, the cap, overheal and a med's overflow, Squared up, Transfusion's cap, gone at the extract")


## Uniques by tier (12 Oct, docs/design/uniques.md): every unique but the paper has a band and a range; it rolls held
## inside its range on its slot's best base there, name, rule and art kept; a higher copy beats a lower; the melee
## secondary past the Cosh is lifted; the bands pick by tier; the shelf keeps the best tier; the mate's offer has one;
## the four gap uniques' rules.
func _unique_tier_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	for u in Data.UNIQUES:
		if u["slot"] == Data.PAPER:
			_check(not u.has("range"), "the paper has a range")
			continue
		_check(u.has("range") and Data.UNIQUE_BAND_WEIGHT.has(str(u.get("band", ""))), "%s has no band or range" % u["name"])
		var lo: int = int(u["range"][0])
		var hi: int = int(u["range"][1])
		var low: Dictionary = Items.roll_unique(u, sim.rng, -1, 1)
		var high: Dictionary = Items.roll_unique(u, sim.rng, -1, 99)
		_check(int(low["tier"]) == lo and int(high["tier"]) == hi, "%s did not hold inside %d-%d: T%d / T%d" % [u["name"], lo, hi, int(low["tier"]), int(high["tier"])])
		_check(low["unique"] == u["name"] and high["unique"] == u["name"] and high["rule"] == u["rule"] and Items.full_name(high) == u["name"], "%s lost its name or rule at its top" % u["name"])
		_check(Items.base_of(high).get("type", "") == Items.base_named(u["slot"], u["base"]).get("type", ""), "%s changed its gun type at its top: %s" % [u["name"], high["base"]])
		for k in high["attachments"]:
			_check(str(k).begins_with("socket") or str(k) in Items.base_of(high).get("attachments", []), "%s has a mount its body hasn't: %s on %s" % [u["name"], k, high["base"]])
		if hi > lo:
			_check(Items.score(high) > Items.score(low), "%s at T%d does not beat itself at T%d: %.1f vs %.1f" % [u["name"], hi, lo, Items.score(high), Items.score(low)])
	# the sign past the Cosh: still a Cosh, lifted to the slot's curve
	var sgn: Dictionary = sim._unique_named("The Lollipop Lady's Sign")
	var s4: Dictionary = Items.roll_unique(sgn, sim.rng, -1, 4)
	var s9: Dictionary = Items.roll_unique(sgn, sim.rng, -1, 9)
	_check(s9["base"] == "Cosh" and float(s9.get("lift", 1.0)) > float(s4.get("lift", 1.0)) and float(s4.get("lift", 1.0)) > 1.0 and Items.dps(s9) > Items.dps(s4), "the sign is not a lifted Cosh: %s ×%.2f" % [s9["base"], float(s9.get("lift", 1.0))])
	# a worn copy and a better one: the better reads as an upgrade
	for s in Data.SLOTS:
		sim.equipped[s] = null
	var steel: Dictionary = sim._unique_named("The Butcher's Steel")
	sim.equipped["Primary"] = Items.roll_unique(steel, sim.rng, -1, 4)
	var better: Dictionary = Items.roll_unique(steel, sim.rng, -1, 9)
	_check(sim.compare(better) == 1, "a T9 steel does not read better than the T4 worn")
	# the bands: a levelling one never at T9, a chase one never at T2, the levelling ones most at T3
	var loose: Array = sim.loose_uniques(99)
	var by_band := {"levelling": 0, "core": 0, "chase": 0}
	for k in range(300):
		var at9: Dictionary = sim.pick_unique(loose, 9)
		_check(at9.is_empty() or str(at9["band"]) != "levelling", "a levelling unique came at T9: %s" % at9.get("name", ""))
		var at2: Dictionary = sim.pick_unique(loose, 2)
		_check(not at2.is_empty() and str(at2["band"]) == "levelling", "a %s unique came at T2: %s" % [str(at2.get("band", "")), at2.get("name", "")])
		var at4: Dictionary = sim.pick_unique(loose, 4)
		by_band[str(at4["band"])] += 1
	_check(by_band["levelling"] > by_band["core"] and by_band["chase"] == 0, "the bands' weights did not pick at T4: %s" % str(by_band))
	_check(sim.pick_unique(loose, 0).is_empty() and not sim.pick_unique(loose, 0, true).is_empty(), "a find outside every range dropped one, or a shop came up empty")
	# the shelf keeps the best tier found, through a save
	var hold_shelf: Array = sim.shelf.duplicate()
	sim.shelf = []
	sim.shelf_tier = {}
	sim._read(Items.roll_unique(steel, sim.rng, -1, 7))
	sim._read(Items.roll_unique(steel, sim.rng, -1, 5))
	_check(int(sim.shelf_tier.get(steel["name"], 0)) == 7, "the shelf did not keep the best tier: %s" % str(sim.shelf_tier))
	var round_trip = Sim.new()
	round_trip.start()
	round_trip.load_dict(sim.to_dict())
	_check(int(round_trip.shelf_tier.get(steel["name"], 0)) == 7, "the shelf's tiers did not save")
	# the mate: an offer with a tier, and what he sells is that tier
	sim.mate = sim.roll_mate()
	_check(sim.mate.has("tier") and int(sim.mate["notes"]) == Data.MATE_NOTES * int(sim.mate["tier"]), "the mate's offer has no tier: %s" % str(sim.mate))
	_check(int(sim._mate_item()["tier"]) == int(sim.mate["tier"]), "the mate's unique is not the tier he offered")
	sim.mate = {"unique": "Lucky Cap", "notes": 400}      # a save from before the tiers
	_check(int(sim._mate_item()["tier"]) == 1, "an old mate's offer did not roll at its own base's tier")
	sim.shelf = hold_shelf
	# the four gaps' rules
	var t: Dictionary = sim.effective(3)
	var search0: float = sim.search_s(t)
	sim.equipped["Helmet"] = Items.roll_unique(sim._unique_named("The Miner's Lamp"), sim.rng)
	_check(sim.search_s(t) < search0 * 0.5 + 0.01, "the Miner's Lamp did not halve the search: %.1f vs %.1f" % [sim.search_s(t), search0])
	sim.equipped["Helmet"] = null
	var med: Dictionary = sim._plain(Data.MEDICAL, Data.BASES[Data.MEDICAL][0]["name"])
	var heal0: float = sim.med_heal(med)
	var fire0: float = sim.dot_seconds("fire")
	var depth0: float = sim.dot_depth()
	sim.equipped["Rig"] = Items.roll_unique(sim._unique_named("The Paramedic's Bum Bag"), sim.rng)
	_check(is_equal_approx(sim.med_heal(med), heal0 * 1.5), "the Bumbag's meds do not heal half again: %.1f vs %.1f" % [sim.med_heal(med), heal0])
	sim.rig = [med.duplicate()]
	sim.words[3] = []                    # no Rationed on the site: the med is allowed
	sim.deploy(3)
	var m: Dictionary = sim.mission
	sim.hp = sim.max_hp() * 0.3
	sim.advance(0.1)
	_check(m["using"] != null or sim.rig.is_empty(), "the Bumbag did not use a med under 40%")
	sim.extract_now()
	sim.equipped["Rig"] = Items.roll_unique(sim._unique_named("The Plumber's Belt"), sim.rng)
	_check(is_equal_approx(sim.dot_seconds("fire"), fire0) and is_equal_approx(sim.dot_depth(), depth0 * 2.0) and is_equal_approx(sim.dot_depth(false), 1.0) and is_equal_approx(sim.status_s(1.0), 2.0), "the Plumber's Belt did not double a dot's depth and a chill's length, or slowed the dot: %.1f s, ×%.1f" % [sim.dot_seconds("fire"), sim.dot_depth()])
	sim.equipped["Rig"] = null
	sim.equipped["Secondary"] = Items.roll_unique(sim._unique_named("The Starting Pistol"), sim.rng)
	sim.rig = [sim._plain(Data.AMMO, "Pistol rounds")]
	sim.deploy(3)
	m = sim.mission
	m["target_hp"] = 100000.0
	sim._starting_shot(m, m["t"])
	var after: float = float(m["target_hp"])
	var shot: float = 100000.0 - after
	_check(shot > 0.0 and m.get("opened", false), "the Starting Pistol's first shot did not land")
	sim.advance(0.05)
	_check(after - float(m["target_hp"]) < shot, "the Starting Pistol fired its first shot twice: %.0f then %.0f" % [shot, after - float(m["target_hp"])])
	sim.extract_now()
	sim.load_dict(saved)
	print("uniques by tier ok: bands and ranges, held in range, the body's mounts, a higher copy better, the sign lifted, the bands by tier, the shelf's best, the mate's tier, the four new rules")


## Sets: pieces roll and have words, the count, the bonuses at two and the
## full set, the rules, the drop by depth, the tint and the panel's line.
func _set_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	for st in Data.SETS:
		for p in st["pieces"]:
			var it := Items.roll_set_piece(st["name"], p, sim.rng)
			_check(it["set"] == st["name"] and it["piece"] == p["name"] and Items.full_name(it) == p["name"] and Words.item_words(p["name"]) != "", "%s does not roll as a piece with words" % p["name"])
			_check(load("res://scripts/ui/item_cell.gd").rarity_tone(it) == "set", "a set piece is not tinted")
	for s in Data.SLOTS:
		sim.equipped[s] = null
	sim.equipped["Primary"] = sim._plain("Primary", "Army SMG")
	var council: Dictionary = Items.set_named("The Council's")
	_check(sim.set_count("The Council's") == 0 and sim.set_bonuses().is_empty(), "a bare runner has set bonuses")
	sim.equipped["Armour"] = Items.roll_set_piece("The Council's", council["pieces"][0], sim.rng)
	sim.equipped["Helmet"] = Items.roll_set_piece("The Council's", council["pieces"][1], sim.rng)
	_check(sim.set_count("The Council's") == 2 and is_equal_approx(sim.set_stat("all_res"), 20.0) and sim.resist("fire") >= 0.2, "two of the Council's did not give all resists +20")
	_check(not sim.has_set_rule("council"), "the Council's rule came at two")
	sim.equipped["Backpack"] = Items.roll_set_piece("The Council's", council["pieces"][2], sim.rng)
	sim.equipped["Charm"] = Items.roll_set_piece("The Council's", council["pieces"][3], sim.rng)
	_check(sim.set_count("The Council's") == 4 and sim.has_set_rule("council") and is_equal_approx(sim.set_stat("regen"), 1.0) and sim._affix_sum("search_pct") >= 30.0 + 8.0, "the full council's did not give it all: rule %s regen %.1f search %.0f" % [str(sim.has_set_rule("council")), sim.set_stat("regen"), sim._affix_sum("search_pct")])
	# the panel's line, in the set's tint
	main.show_room(main.ARMOURY)
	main._armoury._pick_slot("Armour")
	main.refresh()
	_check(main._armoury._head.text_nodes().any(func(r): return r.text.begins_with("The Council's · 4 of 4") or r.text == "4 of 4 worn"), "the panel's set chip is missing: %s" % str(main._armoury._head.text_nodes().map(func(r): return r.text)))
	_check_fit(main, "Armoury (a set)")
	# the Army's: contact down one, more ×1.3 at four
	for s in Data.SLOTS:
		sim.equipped[s] = null
	var army: Dictionary = Items.set_named("The Army's")
	sim.words[3] = []
	sim.weather[1] = ""                  # fog would take the one the set takes
	var t: Dictionary = sim.effective(3)
	var c0: int = sim.contact(t)
	for p in army["pieces"]:
		sim.equipped[p["slot"]] = Items.roll_set_piece("The Army's", p, sim.rng)
	_check(sim.contact(t) == c0 - 1 and is_equal_approx(sim.more("physical"), 1.3), "the Army's full set: contact %d of %d, more %.1f" % [sim.contact(t), c0, sim.more("physical")])
	# the Carpet Man's two: 30% bleed, bleeds last twice
	for s in Data.SLOTS:
		sim.equipped[s] = null
	sim.equipped["Primary"] = sim._plain("Primary", "Army SMG")
	var carpet: Dictionary = Items.set_named("The Carpet Man's")
	for p in carpet["pieces"]:
		sim.equipped[p["slot"]] = Items.roll_set_piece("The Carpet Man's", p, sim.rng)
	sim.rig = sim.rig.filter(func(x): return not Items.is_ammo(x))     # a graded box's conversion reads in through the gun
	sim._dry_memo.clear()
	_check(is_equal_approx(sim.conversion()["bleed"], 0.3) and is_equal_approx(sim.dot_seconds("bleed"), 12.0), "the Carpet Man's: bleed %.2f seconds %.0f" % [sim.conversion()["bleed"], sim.dot_seconds("bleed")])
	# drops by depth: nothing at depth 1, pieces by depth 12, no army's before 15
	# (the Fire Crew's three at depth 9 join the count from 12 on)
	_check(sim.set_pieces_at(1).is_empty() and sim.set_pieces_at(5).size() == 6 and sim.set_pieces_at(12).size() == 15 and sim.set_pieces_at(15).size() == 19, "the sets' depth gates are off: %d / %d / %d / %d" % [sim.set_pieces_at(1).size(), sim.set_pieces_at(5).size(), sim.set_pieces_at(12).size(), sim.set_pieces_at(15).size()])
	sim.load_dict(saved)
	print("sets ok: the pieces, the count, the bonuses, the rules, the tint, the panel, the gates")
	_atlas_checks(main)


## The map: a point a new depth past the first, the passives, their effects.
func _atlas_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	_finish_campaign(sim)
	sim.atlas = {}
	sim.atlas_points = 0
	_open_map(main)
	_check(main._radio.view == "map" and main._radio._atlas.visible, "the map did not open on the Radio after the campaign")
	_check_fit(main, "Radio (the map, empty)")
	# a clear at depth 2 earns a point; depth 1 does not
	sim.set_depth(3, 1)
	var t1: Dictionary = sim.effective(3)
	sim.best_depth[3] = 0
	sim.deploy(3)
	sim._clear(sim.mission, t1)
	sim.extract_now()
	_check(sim.atlas_points == 0, "a depth-1 clear put a point on the map")
	sim.set_depth(3, 2)
	var t2: Dictionary = sim.effective(3)
	sim.deploy(3)
	sim._clear(sim.mission, t2)
	sim.extract_now()
	_check(sim.atlas_points == 1 and sim.atlas_free() == 1, "a depth-2 clear did not earn a point: %d" % sim.atlas_points)
	sim.deploy(3)
	sim._clear(sim.mission, t2)
	sim.extract_now()
	_check(sim.atlas_points == 1, "clearing the same depth again earned a point")
	# the ranks and their effects
	var patrol0: float = sim.patrol_s(t2)
	var search0: float = sim.search_s(t2)
	var cost0: int = sim.word_craft_cost(3, "retune")
	var notes0: int = sim.notes_a_kill(t2)
	# the Map's web (22 Oct): a region's entry is open, the rest by pathing - a branch's first node past a filler off
	# the entry; the other regions' nodes don't open on this one's points
	_check(sim.atlas_open("picked_over") and not sim.atlas_open("deeper_pockets") and not sim.atlas_open("quiet_roads") and not sim.can_rank_atlas("quiet_roads"), "the sites' branches are open with nothing ranked: '%s'" % sim.atlas_block("quiet_roads"))
	_check(sim.atlas_block("quiet_roads").begins_with("wants a path") and sim.atlas_path_next("quiet_roads") == Data.map_id("picked_over"), "the path hint to Quiet roads isn't the entry: '%s'" % sim.atlas_path_next("quiet_roads"))
	_check(sim.rank_atlas("picked_over") and sim.atlas_rank("picked_over") == 1, "a rank did not take")
	_check(not sim.rank_atlas("deeper_pockets"), "a rank took with no point free")
	sim.atlas_points += 10
	_check(not sim.atlas_open("heads_up") and sim.atlas_open("paid_in_notes"), "the crews' region reads the sites' ranks")
	var f_quiet: String = str(Data.map_node(sim.atlas_path_next("quiet_roads"))["key"])
	_check(Data.atlas_of(f_quiet).get("filler", false) and sim.rank_atlas(f_quiet) and sim.atlas_open("quiet_roads") and sim.rank_atlas("quiet_roads") and sim.atlas_rank("quiet_roads") == 1, "the branch did not open past its filler: %s" % f_quiet)
	_check(not sim.atlas_open("easy_pickings") and sim.atlas_open("second_look"), "the rich way opened off the quiet one, or the spine's next is shut")
	_check(sim.atlas_block("lie_of_the_land").begins_with("wants a path"), "the keystone's block isn't the path first: '%s'" % sim.atlas_block("lie_of_the_land"))
	var f_deep: String = str(Data.map_node(sim.atlas_path_next("deeper_pockets"))["key"])
	_check(Data.atlas_of(f_deep).get("filler", false) and sim.rank_atlas(f_deep) and sim.atlas_open("deeper_pockets") and sim.rank_atlas("deeper_pockets"), "the rich way did not open past its filler: %s" % f_deep)
	_check(is_equal_approx(sim.atlas_level("deeper_pockets"), 0.3) or is_equal_approx(sim.atlas_level("quiet_roads"), 1.3) or is_equal_approx(sim.atlas_level("easy_pickings"), 0.3) or is_equal_approx(sim.atlas_level("every_penny"), 0.3), "a filler's share did not read into its ranked node's figure: %s / %s" % [f_quiet, f_deep])
	_check(sim.patrol_s(t2) > patrol0 * 1.09, "Quiet roads did not slow the gangs")
	sim.atlas_points += 10
	for i in range(2):
		_rank_to(sim, "deeper_pockets")
	_check(sim.atlas_rank("deeper_pockets") == 3 and not sim.can_rank_atlas("deeper_pockets"), "Deeper pockets went past its max")
	_check(sim.search_s(t2) < search0 * 0.75, "Deeper pockets did not quicken searches")
	_check(_rank_to(sim, "good_reception") and sim.word_craft_cost(3, "retune") <= int(ceil(cost0 * 0.85)) and sim.word_craft_cost(3, "retune") < cost0 + 1, "Good reception did not cheapen the crafts: %d from %d" % [sim.word_craft_cost(3, "retune"), cost0])
	# a note more a kill - doubled by the Traffic Warden's Hat when the camp's kit is wearing it (17 Oct: the check read
	# +1 and failed whenever the smoke's earlier runs had left the hat on)
	var hat: int = int(Data.FX["rule/wardens_hat.notes"]) if sim.has_rule("wardens_hat") else 1
	_check(_rank_to(sim, "paid_in_notes") and sim.notes_a_kill(t2) == notes0 + hat, "Paid in notes did not add a note: %d from %d (the hat x%d)" % [sim.notes_a_kill(t2), notes0, hat])
	_check(_rank_to(sim, "two_of_everything"), "Two of everything did not take")
	# the boss drops two with it
	sim.notes += 1000
	sim.arm_boss(5, true)
	sim.set_depth(5, 1)
	sim.deploy(5)
	var m: Dictionary = sim.mission
	m["boss"] = {"name": sim.boss_of(5)["name"], "zone": 0, "alive": true, "hp": 1.0, "started": true}
	var found_before: int = m["found"].size()
	sim._boss_down(m, sim.effective(5))
	_check(m["found"].size() == found_before + 2, "Two of everything did not drop a second: %d" % (m["found"].size() - found_before))
	sim.extract_now()
	_open_map(main)
	_check_fit(main, "Radio (the map, ranked)")
	_map_screen_checks(main)
	_site_level_checks(main)
	main._radio._reset_map()
	_check(sim.atlas_spent() == 0 and sim.atlas_free() == sim.atlas_points, "starting the map again did not refund")
	main._radio._pick_view("air")
	# the round trip keeps it
	sim.rank_atlas("picked_over")
	var pts_held: int = sim.atlas_points
	var d: Dictionary = sim.to_dict()
	sim.load_dict(d)
	_check(sim.atlas_rank("picked_over") == 1 and sim.atlas_points == pts_held, "the map did not survive a save")
	_map_nodes_checks(main)
	sim.load_dict(saved)
	print("the map ok: points, ranks, effects, two of everything, reset")
	_contracts_checks(main)


## The Fence's contracts: three open, hand in the cheapest that fit, paid in
## cash, notes or a unique; the mate sells a unique for notes.
func _contracts_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	_check(sim.contracts.size() == Data.CONTRACTS_OPEN, "the Fence has %d contracts open, not %d" % [sim.contracts.size(), Data.CONTRACTS_OPEN])
	_check(not sim.mate.is_empty() and sim.mate["notes"] > 0, "the Fence's mate has nothing: %s" % str(sim.mate))
	for i in range(60):
		var c: Dictionary = sim.roll_contract()
		_check(c["count"] >= 1 and c["count"] <= 5 and c["rarity"] >= 1 and c["rarity"] <= 2, "a contract rolled outside its bounds: %s" % str(c))
		_check(c["pay"] in Data.CONTRACT_PAYS and c["amount"] > 0, "a contract pays nothing, or not in currency: %s" % str(c))
	# a scrap contract: two uncommon helmets, hand in through the screen (no tins since 24 Oct)
	sim.contracts[0] = {"kind": "gear", "slot": "Helmet", "rarity": 1, "count": 2, "level": 0, "stat": "", "pay": "scrap", "amount": 500, "salvage": ""}
	var cheap: Dictionary = sim._plain("Helmet", "Hard hat")
	cheap["rarity"] = 1
	cheap["value"] = 1
	var common: Dictionary = sim._plain("Helmet", "Hard hat")
	for it in [common, cheap]:
		sim.stash.append(it)
	var fits0 := 0                                                     # the run may have left helmets that fit
	for it in sim.stash:
		if sim.contract_fits(sim.contracts[0], it):
			fits0 += 1
	sim.contracts[0]["count"] = fits0 + 1
	_check(not sim.can_hand_in(0), "a contract for %d took with %d that fit" % [fits0 + 1, fits0])
	var mid: Dictionary = sim._plain("Helmet", "Hard hat")
	mid["rarity"] = 1
	mid["value"] = 2
	sim.stash.append(mid)
	_check(sim.can_hand_in(0), "a contract for %d did not take with %d that fit" % [fits0 + 1, fits0 + 1])
	var picked: Array = sim.contract_items(sim.contracts[0])
	_check(picked.size() == fits0 + 1 and picked[0]["id"] == cheap["id"] and picked[1]["id"] == mid["id"], "the cheapest that fit were not the ones picked first")
	main.show_room(main.MARKET)
	main._fence._show("contracts")
	_check_fit(main, "Fence (contracts)")
	var cash0: float = sim.cash
	var scrap0: int = sim.scrap
	main._fence._pick_contract(0)
	main._fence._hand_contract(0)
	_check(sim.scrap == scrap0 + 500 and sim.cash == cash0, "handing in did not pay its 500 scrap, or paid tins: scrap +%d, tins +%.0f" % [sim.scrap - scrap0, sim.cash - cash0])
	_check(not sim.stash.has(cheap) and not sim.stash.has(mid) and sim.stash.has(common), "the wrong helmets went")
	_check(sim.contracts.size() == Data.CONTRACTS_OPEN, "the handed-in contract was not replaced")
	# notes, and the mate
	sim.contracts[1] = {"kind": "gear", "slot": "Helmet", "rarity": 2, "count": 1, "level": 0, "stat": "", "pay": "notes", "amount": 12, "salvage": ""}
	var rare: Dictionary = sim._plain("Helmet", "Hard hat")
	rare["rarity"] = 2
	sim.stash.append(rare)
	var notes0: int = sim.notes
	_check(sim.hand_in(1) and sim.notes == notes0 + 12 * (2 if sim.yard_has("fixer") else 1), "a notes contract did not pay")
	sim.passes = 0
	_check(sim.pass_contract(0) and sim.contracts.size() == Data.CONTRACTS_OPEN, "turning one down did not replace it")
	sim.notes = int(sim.mate["notes"]) - 1
	_check(not sim.can_buy_mate(), "the mate sold with a note short")
	sim.notes = int(sim.mate["notes"])
	var want: String = sim.mate["unique"]
	_check(sim.buy_mate() and sim.notes == 0 and sim.stash.back().get("unique", "") == want, "the mate did not sell %s" % want)
	var runs0: int = sim.runs_total
	var offer: String = sim.mate["unique"]
	var changed := false
	for i in range(Data.MATE_RUNS):
		sim.deploy(3)
		sim.extract_now()
		changed = changed or sim.mate["unique"] != offer
	_check(sim.runs_total == runs0 + Data.MATE_RUNS, "runs_total did not count the runs")
	main._fence._show("contracts")
	_check_fit(main, "Fence (contracts, after)")
	# the contracts show from the rail and the tab when one's ready; what's next says so
	sim.contracts = [{"kind": "gear", "amount": 400, "count": 3, "pay": "notes", "rarity": 2, "slot": "Attachment", "level": 0, "stat": "", "salvage": ""}]
	for it in sim.stash.duplicate():
		if sim.contract_fits(sim.contracts[0], it):
			sim.stash.erase(it)              # nothing in the stash to hand in: open, not ready
	main.refresh()
	var fence_status: Dictionary = main._rail_status(main.MARKET) if main.has_method("_rail_status") else {}
	_check(fence_status.get("badge", "") == "", "the rail flags a contract that isn't ready: %s" % str(fence_status))
	main.show_room(main.MARKET)
	main.refresh()
	while not sim.stash_room(1) and not sim.stash.is_empty():
		sim.sell(sim.stash[0])
	for k in range(3):
		var part: Dictionary = sim._plain(Data.ATTACHMENT, "Red dot")
		part["rarity"] = 2
		part["affixes"] = [{"stat": "damage_pct", "value": 3, "tier": 1}, {"stat": "speed_pct", "value": 2, "tier": 1}]
		sim.stash.append(part)
	main.refresh()
	_check(sim.can_hand_in(0), "three rare parts did not make the contract ready")
	fence_status = main._rail_status(main.MARKET)
	_check(fence_status.get("badge", "") == "Ready" and main._fence._tabs[2].text == "Contracts ✓1", "a ready contract is not flagged: %s / %s" % [str(fence_status), main._fence._tabs[2].text])
	_check(sim.next_words() == Words.NEXT["contract"] or sim.campaign_done(), "what's next does not point at the ready contract: '%s'" % sim.next_words())
	_check_fit(main, "Fence (contract ready)")
	main._fence._show("shelf")
	var d: Dictionary = sim.to_dict()
	sim.load_dict(d)
	_check(sim.contracts.size() == Data.CONTRACTS_OPEN and sim.contracts[0]["slot"] == d["contracts"][0]["slot"], "contracts did not survive a save")
	sim.load_dict(saved)
	main.show_room(main.MARKET)
	main._fence.selected = {}
	main.refresh()
	if not sim.contracts.is_empty():
		sim.contracts[0] = {"kind": "gear", "slot": "Helmet", "rarity": 1, "count": 2, "level": 0, "stat": "", "pay": "scrap", "amount": 20, "salvage": ""}
		main._fence._show("contracts")
		main._fence._shown = ""
		main.refresh()
		var t0: String = main._fence._list.row_of(0)["have"].text
		_check(t0.ends_with("/ 2"), "the row's count is not of two: '%s'" % t0)
		_check(main._fence._list.row_of(0)["title"].text == "Two uncommon helmets", "the ask is not the row's title: '%s'" % main._fence._list.row_of(0)["title"].text)
		# every affix the Fence can ask for is named on the row, whole or short
		for slot in Data.CONTRACT_SLOTS.slice(0, Data.CONTRACT_SLOTS.size() - 1):
			for a in Items.allowed_affixes(slot):
				sim.contracts[0] = {"kind": "affix", "slot": slot, "rarity": 1, "count": 1, "level": 0, "stat": a["stat"], "pay": "notes", "amount": 5, "salvage": ""}
				main._fence._shown = ""
				main.refresh()
				var tt: String = main._fence._list.row_of(0)["title"].text
				var tight: String = str(main._fence.AFFIX_TIGHT.get(str(a["stat"]), a["short"]))     # the glossary's word where the short won't fit (22 Oct); the slot alone never passes
				_check(tt.contains(sim.contract_affix_phrase(a["stat"])) or tt.ends_with(str(a["short"])) or tt.ends_with(tight), "an affix ask does not name its affix: '%s' for %s on a %s" % [tt, a["stat"], slot])
				# and the tight form fits the row whatever the RNG rolls (the review): the widest slot's name with every affix's word
				var lbl: Label = main._fence._list.row_of(0)["title"]
				var wide_slot := ""
				for sl in Data.CONTRACT_SLOTS:
					var sn: String = "Gun part" if sl == Data.ATTACHMENT else str(sl)
					if wide_slot == "" or UI.text_width(lbl, sn) > UI.text_width(lbl, wide_slot):
						wide_slot = sn
				var widest: String = "%s · %s" % [wide_slot, tight]
				_check(UI.text_width(lbl, widest) <= lbl.size.x, "an affix ask's tight form is too wide for the row: '%s' needs %d px, has %d" % [widest, int(UI.text_width(lbl, widest)), int(lbl.size.x)])
				_check(main._fence._list.row_of(0)["have"].text != "", "the row's count went blank for %s on a %s" % [a["stat"], slot])
		_check(sim.contract_words({"kind": "affix", "slot": "Armour", "stat": "conv_fire_pct", "count": 1}) == "an armour with fire conversion", "the affix ask reads '%s'" % sim.contract_words({"kind": "affix", "slot": "Armour", "stat": "conv_fire_pct", "count": 1}))
		_check_fit(main, "Fence (contracts in the voice)")
	print("contracts and the mate ok: three open, the cheapest that fit, cash, notes, the mate")
	_fence_ab_checks(main)
	_events_checks(main)


## The run's events: a convoy, someone trapped, a locked cache.
func _events_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	var fired := 0
	for i in range(40):
		sim.deploy(3)
		if sim.mission["event"] != "":
			fired += 1
			_check(sim.mission["event_at"] >= Data.EVENT_WINDOW[0] and sim.mission["event_at"] <= Data.EVENT_WINDOW[1], "an event is timed outside its window")
		sim.extract_now()
	_check(fired > 3 and fired < 25, "events on %d of 40 runs; 30%% was the aim" % fired)
	# no passing convoy in the first runs (17 Oct, Matt: one on the very first Allotments run used both starter
	# bandages and left the next site at 0%); the other two still come, and the convoy does once past them
	var runs_was: int = sim.runs_total
	var early := {}
	var later := {}
	sim.runs_total = 0
	for k in range(300):
		early[sim.roll_event()] = true
	sim.runs_total = Data.CONVOY_FROM_RUN
	for k in range(300):
		later[sim.roll_event()] = true
	sim.runs_total = runs_was
	# a new camp's spare bandages in the stash (17 Oct, Matt), on top of the two in the rig
	var fresh = Sim.new()
	fresh.start()
	var spares: int = fresh.stash.filter(func(it): return str(it["base"]) == "Bandage").size()
	_check(spares == Data.START_STASH_BANDAGES and fresh.rig.size() == 2, "a new camp has %d bandages in the stash (not %d) and %d in the rig" % [spares, Data.START_STASH_BANDAGES, fresh.rig.size()])
	_check(not early.has("convoy") and early.has("trapped") and early.has("cache") and later.has("convoy"), "a convoy can pass in the first %d runs, or the events stopped coming: early %s, later %s" % [Data.CONVOY_FROM_RUN, str(early.keys()), str(later.keys())])
	# a convoy: a bigger gang, and their notes
	sim.deploy(3)
	var m: Dictionary = sim.mission
	m["remaining"] = 0
	m["cleared"] = true
	m["event"] = "convoy"
	m["event_at"] = 0.0
	var notes0: int = int(m.get("notes", 0))
	sim.advance(0.1)
	_check(m["remaining"] == sim.PATROL_BASE + 2 and int(m["notes"]) > notes0 and m["event_done"] == "convoy" and m["event_at"] < 0.0, "the convoy did not come: %d left, %d notes" % [m["remaining"], int(m["notes"])])
	# and the run screen counts them (8 Oct, Matt: "11 of 10 down"): the bar's "of" is the pool as it stands, with the
	# convoy's crew in, and the band says a convoy came
	m["cleared"] = false
	m["kills"] = int(sim.tier(3)["pool"])
	main.show_room(main.MISSIONS)
	main.refresh()
	var bar_words: String = main._run._band._bar_label.text
	_check(bar_words == "%d of %d down" % [m["kills"], m["kills"] + m["remaining"]], "the run's bar reads the site's pool with a convoy's crew in: '%s'" % bar_words)
	_check(main._run._band.right[1].text.contains("convoy"), "the band does not say a convoy came: '%s'" % main._run._band.right[1].text)
	sim.extract_now()
	# someone trapped: a trait promised to the next arrival
	sim.promised = ""
	sim.deploy(3)
	m = sim.mission
	m["event"] = "trapped"
	m["event_at"] = 0.0
	sim.advance(0.1)
	_check(sim.promised != "" and sim.promised != sim.runner_trait, "the trapped runner promised nothing: %s" % sim.promised)
	sim.extract_now()
	sim.promised = ""
	# a cache: opened at any Bench (9 Oct: it wanted Bench 2)
	sim.deploy(3)
	m = sim.mission
	m["event"] = "cache"
	m["event_at"] = 0.0
	m["remaining"] = 999                   # keep the search from finding on its own
	var found0: int = m["found"].size()
	sim.advance(0.1)
	_check(m["found"].size() == found0 + 1, "the cache did not open")
	# its words never name a room that may be shut (13 Oct, Matt's save: "the Bench's tools" with the Workshop shut)
	var cache_line: String = str(sim.events.back()[1])
	for room_word in ["Bench", "Workshop", "Clinic", "Fence", "Radio", "Yard", "Pitch"]:
		_check(not cache_line.contains(room_word), "the cache's line names the %s: '%s'" % [room_word, cache_line])
	sim.extract_now()
	# a run out to a site with no codes says so with no colon left hanging (13 Oct, Matt's save: "depth 1: ")
	sim.deploy(0)
	var out_lines: Array = sim.events.filter(func(e): return str(e[1]).begins_with("Out to "))
	_check(not out_lines.is_empty(), "no 'Out to' line was logged")
	if not out_lines.is_empty():
		var ol: String = str(out_lines.back()[1])
		_check(not ol.strip_edges().ends_with(":") and (sim.mission["t"]["intel"].is_empty() != ol.contains(": ")), "the run's line is off: '%s' (codes %s)" % [ol, str(sim.mission["t"]["intel"])])
	sim.extract_now()
	sim.load_dict(saved)
	print("events ok: the convoy, the trapped runner, the cache, the run's line")
	_pinnacle_checks(main)


## Pinnacles from depth 10: dearer, harder, their charm in the pool. The
## convoy on the Services from depth 12: all three, one after another, and
## the Lorry's Load at the end.
func _pinnacle_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	_finish_campaign(sim)
	sim.notes += 100000
	for i in range(Data.TIERS.size()):
		sim.best_depth[i] = 20
	# the Carpet Man a depth short of full strength and at it (the Retail Park's at 12, the Bank's at 9, the Barracks' at 6: level 14 on each)
	var pd: int = sim.pinnacle_depth(5)
	_check(pd == 12 and sim.pinnacle_depth(8) == 9 and sim.pinnacle_depth(11) == 6, "the stations' depths are off: %d %d %d" % [pd, sim.pinnacle_depth(8), sim.pinnacle_depth(11)])
	sim.set_depth(5, pd - 1)
	sim.arm_boss(5, true)
	var cost9: int = sim.boss_cost(5)
	var e9: Dictionary = sim.effective(5)
	sim.set_depth(5, pd)
	_check(sim.is_pinnacle(5) and not sim.is_pinnacle(4), "depth %d is not a pinnacle" % pd)
	var e10: Dictionary = sim.effective(5)
	_check(e10["boss"]["pinnacle"] and not e9["boss"].get("pinnacle", false), "the boss at depth %d is not at full strength" % pd)
	# full strength is twice the crew at the same fire (the sixteenth read: a fire multiplier reads 0.00 whatever the HP)
	var site_step: float = float(e10["dps"]) / float(e9["dps"])        # the depth's own step, the only change in the fire
	_check(e10["boss"]["hp"] > e9["boss"]["hp"] * 1.8 * site_step * 0.95 and is_equal_approx(e10["boss"]["dps"] / e9["boss"]["dps"], site_step), "the pinnacle is not twice the crew at the same fire: hp ×%.2f, dps ×%.2f against the site's ×%.2f" % [e10["boss"]["hp"] / e9["boss"]["hp"], e10["boss"]["dps"] / e9["boss"]["dps"], site_step])
	_check(sim.boss_cost(5) > cost9 * 1.8, "the pinnacle costs no more: %d vs %d" % [sim.boss_cost(5), cost9])
	# their charm comes from the pinnacle and never from the ordinary fight
	var charms := 0
	var m: Dictionary
	for k in range(40):
		sim.arm_boss(5, true)
		sim.deploy(5)
		m = sim.mission
		m["boss"]["started"] = true
		sim._boss_down(m, sim.effective(5))
		for it in m["found"]:
			if it.get("unique", "") == "The Van Keys":
				charms += 1
		sim.extract_now()
	_check(charms > 3 and charms < 30, "the Van Keys came %d of 40 pinnacle kills; a third was the aim" % charms)
	sim.set_depth(5, 5)
	charms = 0
	for k in range(30):
		sim.arm_boss(5, true)
		sim.deploy(5)
		m = sim.mission
		m["boss"]["started"] = true
		sim._boss_down(m, sim.effective(5))
		for it in m["found"]:
			if it.get("unique", "") == "The Van Keys":
				charms += 1
		sim.extract_now()
	_check(charms == 0, "the Van Keys came from the Carpet Man under full strength")
	# the convoy: the Services at convoy_depth() (CONVOY_DEPTH on the first yard, a depth deeper a move)
	sim.set_depth(Data.CONVOY_TIER, Data.CONVOY_DEPTH - 1)
	_check(not sim.is_convoy(Data.CONVOY_TIER) and not sim.can_arm_boss(Data.CONVOY_TIER), "the convoy came before depth %d" % Data.CONVOY_DEPTH)
	sim.set_depth(Data.CONVOY_TIER, Data.CONVOY_DEPTH)
	_check(sim.is_convoy(Data.CONVOY_TIER) and sim.can_arm_boss(Data.CONVOY_TIER), "the convoy is not on the Services at depth %d" % Data.CONVOY_DEPTH)
	var convoy_cost: int = sim.boss_cost(Data.CONVOY_TIER)
	var three := 0
	for b in Data.BOSSES:
		if int(b["zone"]) >= 1:
			three += int(b["notes"]) * Data.CONVOY_DEPTH            # the plain three (8 Oct); the Gamekeeper doesn't ride (13 Oct)
	_check(convoy_cost == three, "the convoy's price is %d, not the three heads' %d" % [convoy_cost, three])
	sim.arm_boss(Data.CONVOY_TIER, true)
	sim.words[Data.CONVOY_TIER] = []      # the plain site: the heads are formed before the words multiply the site
	var ec: Dictionary = sim.effective(Data.CONVOY_TIER)
	_check(ec.get("convoy", false) and ec["boss_queue"].size() == 2 and not ec["boss"]["pinnacle"], "the convoy is not three in a row, come light")
	var cm_hp: float = float(ec["hp"]) * float(Data.BOSSES[1]["hp"]) * Data.CONVOY_HP
	var cm_dps: float = float(ec["dps"]) * float(Data.BOSSES[1]["dps"]) * Data.CONVOY_DPS
	_check(is_equal_approx(float(ec["boss"]["hp"]), cm_hp) and is_equal_approx(float(ec["boss"]["dps"]), cm_dps), "the convoy's first head is not light and tired: %.0f/%.1f against %.0f/%.1f" % [float(ec["boss"]["hp"]), float(ec["boss"]["dps"]), cm_hp, cm_dps])
	main.show_room(main.MISSIONS)
	main._missions._pick_zone(3)
	_check_fit(main, "Runs (convoy armed)")
	var notes0: int = sim.notes
	sim.deploy(Data.CONVOY_TIER)
	_check(sim.notes == notes0 - convoy_cost, "the convoy's price was not paid")
	m = sim.mission
	_check(m["boss_queue"].size() == 2 and m["convoy"], "the mission did not carry the queue")
	# the pool goes down; each head comes out in turn, the next as one falls
	var names: Array = []
	var found0: int = m["found"].size()
	m["remaining"] = 1
	m["target_hp"] = 0.0
	sim.advance(0.05)                          # the last of the pool goes; the first head comes out
	for k in range(3):
		_check(m["boss"]["started"] and m["boss"]["alive"], "head %d did not come out" % (k + 1))
		names.append(m["boss"]["name"])
		m["target_hp"] = 0.0
		sim.advance(0.05)                      # goes down; the next comes out
	_check(not m["boss"]["alive"] and m["boss_queue"].is_empty(), "the last head is still up")
	_check(names == ["The Carpet Man", "The Manager", "The Quartermaster"], "the convoy came in the wrong order: %s" % str(names))
	var ld := false
	for it in m["found"]:
		ld = ld or it.get("unique", "") == Data.CONVOY_UNIQUE
	_check(ld and m["found"].size() >= found0 + 4, "the Lorry's Load did not come with the three drops: %d found" % (m["found"].size() - found0))
	# the ending (7 Oct): the lorry beaten is written, the Yard says to move, the move lights
	_check(sim.lorry_done and sim.lorries == 1 and sim.next_words() == Words.NEXT["done"] and sim.events.any(func(e): return str(e[1]).begins_with("The Lorry's Load is yours")), "the lorry beaten was not written: done %s, lorries %d, next '%s'" % [str(sim.lorry_done), sim.lorries, sim.next_words()])
	sim.extract_now()
	main.show_room(main.OVERVIEW)
	main.refresh()
	# the rules: the keys drive, the pen doubles the notes, the ledger a tier up, the load fills the pack
	var pace0: float = sim.pace()
	var was_charm = sim.equipped["Charm"]
	sim.equipped["Charm"] = Items.roll_unique(sim._unique_named("The Van Keys"), sim.rng)
	_check(sim.pace() > pace0 * 1.2, "the Van Keys did not drive")
	sim.equipped["Charm"] = Items.roll_unique(sim._unique_named("The Manager's Pen"), sim.rng)
	for oi in Data.ZONES[0]["tiers"]:
		sim.best_depth[oi] = maxi(1, int(sim.best_depth[oi]))     # the moved yard's Outskirts walked, so the Streets are open (12 Oct)
	var n0: int = sim.notes
	sim.deploy(3)
	sim.mission["notes"] = 7
	sim.extract_now()
	_check(sim.notes == n0 + 14, "the Manager's Pen did not double the notes: +%d" % (sim.notes - n0))
	sim.equipped["Charm"] = was_charm
	var was_pack = sim.equipped["Backpack"]
	sim.equipped["Backpack"] = Items.roll_unique(sim._unique_named("The Lorry's Load"), sim.rng)
	n0 = sim.notes
	sim.set_depth(3, 3)
	sim.deploy(3)
	sim.mission["found"] = []
	sim.mission["notes"] = 0
	sim.extract_now()
	_check(sim.notes == n0 + sim.capacity() * 3, "the Lorry's Load did not fill the empty pack with notes: +%d of %d (depth %d, best %d, campaign %s)" % [sim.notes - n0, sim.capacity() * 3, sim.depth[3], sim.best_depth[3], str(sim.campaign_done())])
	sim.equipped["Backpack"] = was_pack
	for name in ["The Van Keys", "The Manager's Pen", "The Quartermaster's Ledger", "The Lorry's Load"]:
		_check(Words.UNIQUES.has(name), "%s has no line" % name)
	sim.load_dict(saved)
	print("pinnacles and the convoy ok: full strength, the charm, three in a row, the load, the rules")
	_craft_checks(main)
	_sink_checks(main)
	_inflation_checks(main)
	_recycle_checks(main)
	_book_checks(main)
	_lore_checks(main)
	_radio_line_checks(main)
	_codes_checks(main)
	_tins_checks(main)
	_places_checks(main)
	_faces_checks(main)
	_stack_checks(main)
	_next_checks(main)
	_idle_checks(main)
	_juice_checks(main)
	_yard_checks(main)
	_fight_breakdown_checks(main)
	_order_fight_checks(main)
	_pattern_checks(main)
	_loot_rule_checks(main)
	_collection_checks(main)
	_loadout_checks(main)
	_review_fix_checks(main)
	_issue_checks(main)
	_county_checks(main)
	_picked_clean_checks(main)
	_esc_checks(main)
	_exploit_checks(main)
	_sound_checks(main)
	_dress_checks(main)
	_mythic_moment_checks(main)
