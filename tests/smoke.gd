## 35: contracts paying in craft materials: scrap by the handful, a socketable of the zone's element, a graded box for a gun held.
func _contract_material_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	# the contracts (9 Oct, docs/design/contracts.md): the kinds of ask, notes and materials (no tins, 24 Oct), no uniques, no items
	for i in range(Data.TIERS.size()):
		sim.best_depth[i] = mini(sim.best_depth[i], 3)
	var kinds := {}
	var pays := {}
	for k in range(400):
		var c: Dictionary = sim.roll_contract()
		kinds[c["kind"]] = kinds.get(c["kind"], 0) + 1
		pays[c["pay"]] = pays.get(c["pay"], 0) + 1
		_check(c["pay"] in ["notes", "material"] and int(c["amount"]) > 0 and sim.contract_pay_words(c) != "" and sim.contract_words(c) != "", "a contract before any salvage drops is off: %s" % str(c))
		if c["pay"] == "material":
			_check(sim.contract_materials().has(str(c["material"])) and int(c["amount"]) == clampi(int(ceil(sim.contract_weight(c) * Data.CONTRACT_MATERIAL)), 1, Data.CONTRACT_MATERIAL_MAX), "a material contract is off: %s, earnable %s" % [str(c), str(sim.contract_materials())])
		_check(c["pay"] != "cash" and c["pay"] != "scrap", "a contract pays tins or scrap (24 Oct: notes and materials): %s" % str(c))
	_check(kinds.size() == (4 if sim.deepest_site_level() - Data.CONTRACT_DEEP_LESS >= Data.CONTRACT_DEEP_FROM else 3) and not kinds.has("papers") and pays.size() == 2, "four hundred contracts did not cover every kind and pay: %s / %s" % [str(kinds), str(pays)])
	# every slot weighs alike at a rarity (the pay's floor follows the pieces' price since 12 Oct)
	for slot in Data.CONTRACT_SLOTS:
		var probe_c := {"kind": "gear", "slot": slot, "rarity": 2, "count": 1, "level": 0, "stat": "", "pay": "scrap", "amount": 0, "salvage": ""}
		_check(sim.contract_worth(probe_c) > 0.0, "a %s ask is worth nothing to price" % slot)
	var deep_c := {"kind": "deep", "slot": "", "rarity": 1, "count": 1, "level": 30, "stat": "", "pay": "scrap", "amount": 0, "salvage": ""}
	_check(sim.contract_worth(deep_c) > 0.0, "a deep ask at level 30 is worth nothing to price")
	var prim := {"kind": "gear", "slot": "Primary", "rarity": 2, "count": 2, "level": 0, "stat": "", "pay": "", "amount": 0, "salvage": ""}
	var helm: Dictionary = prim.duplicate()
	helm["slot"] = "Helmet"
	_check(sim.contract_weight(prim) == sim.contract_weight(helm) and sim.contract_weight(prim) == 4.0, "two rares weigh %.1f / %.1f" % [sim.contract_weight(prim), sim.contract_weight(helm)])
	# salvage once a zone's site is dug to its depth
	sim.best_depth[6] = sim.depth_for_level(6, Data.SALVAGE_DEPTH + Data.TIERS.size() - 1 - Data.OUTSKIRTS_SITES)     # the depth's level on the Barracks (D15)
	_check(sim.salvage_kinds() == ["steel"], "the salvage on offer is off: %s" % str(sim.salvage_kinds()))
	var sv: Dictionary = {}
	for k in range(400):
		var c: Dictionary = sim.roll_contract()
		if c["pay"] == "salvage":
			sv = c
			break
	_check(not sv.is_empty() and sv["salvage"] == "steel" and int(sv["amount"]) == maxi(1, int(ceil(sim.contract_weight(sv)))), "no salvage contract, or the wrong kind: %s" % str(sv))
	# a material pays into the rebuild's counts; the Outskirts alone pays notes (24 Oct)
	var mat_c := {"kind": "meds", "slot": "", "rarity": 1, "count": 1, "level": 0, "stat": "", "pay": "material", "amount": 4, "salvage": "", "material": "copper_wire"}
	_check(sim.contract_pay_words(mat_c) == "4 copper wire", "a material contract reads '%s'" % sim.contract_pay_words(mat_c))
	var bd_keep: Array = sim.best_depth.duplicate()
	for i in range(sim.best_depth.size()):
		sim.best_depth[i] = 1 if i < Data.OUTSKIRTS_SITES else 0
	var outs_pays := {}
	for k in range(100):
		outs_pays[sim.roll_contract()["pay"]] = true
	_check(sim.contract_materials().is_empty() and sim.salvage_kinds().is_empty() and outs_pays.keys() == ["notes"], "the Outskirts alone pays %s" % str(outs_pays.keys()))
	sim.best_depth = bd_keep
	# each kind of ask takes what it says, and pays
	var deep := {"kind": "deep", "slot": "", "rarity": 1, "count": 1, "level": 12, "stat": "", "pay": "salvage", "amount": 3, "salvage": "steel"}
	var helmet: Dictionary = sim._plain("Helmet", "Hard hat")
	helmet["ilvl"] = 11
	_check(not sim.contract_fits(deep, helmet), "a level-11 helmet fits a level-12 ask")
	helmet["ilvl"] = 14
	_check(sim.contract_fits(deep, helmet) and Items.ilvl(helmet) == 14, "a level-14 helmet does not fit a level-12 ask")
	var affix := {"kind": "affix", "slot": "Helmet", "rarity": 1, "count": 1, "level": 0, "stat": "armour_pct", "pay": "notes", "amount": 5, "salvage": ""}
	var plain_h: Dictionary = sim._plain("Helmet", "Hard hat")
	var arm_h: Dictionary = sim._plain("Helmet", "Hard hat")
	arm_h["rarity"] = 1
	arm_h["affixes"] = [{"stat": "armour_pct", "value": 5, "tier": 1}]
	_check(not sim.contract_fits(affix, plain_h) and sim.contract_fits(affix, arm_h) and sim.contract_words(affix).contains("% armour"), "the affix ask is off: '%s'" % sim.contract_words(affix))
	var papers := {"kind": "papers", "slot": "", "rarity": 1, "count": 2, "level": 0, "stat": "", "pay": "scrap", "amount": 9, "salvage": ""}
	var meds := {"kind": "meds", "slot": "", "rarity": 1, "count": 2, "level": 0, "stat": "", "pay": "notes", "amount": 5, "salvage": ""}
	_check(sim.contract_fits(papers, sim._plain(Data.PAPER, "A P45")) and not sim.contract_fits(papers, sim._plain(Data.PAPER, "The deeds")) and sim.contract_fits(meds, sim._plain(Data.MEDICAL, "Bandage")) and not sim.contract_fits(meds, helmet), "papers or meds asks take the wrong things")
	for it in sim.stash.duplicate():
		if sim.contract_fits(deep, it):
			sim.stash.erase(it)
	sim.stash.append(helmet)
	sim.contracts[0] = deep
	var st0: int = int(sim.salvage.get("steel", 0))
	_check(sim.can_hand_in(0) and sim.hand_in(0) and int(sim.salvage["steel"]) == st0 + 3 and not sim.stash.has(helmet), "a deep ask paying safe steel did not pay")
	var mat_h := {"kind": "meds", "slot": "", "rarity": 1, "count": 1, "level": 0, "stat": "", "pay": "material", "amount": 4, "salvage": "", "material": "copper_wire"}
	sim.stash.append(sim._plain(Data.MEDICAL, "Bandage"))
	sim.contracts[0] = mat_h
	var cw0: int = int(sim.materials.get("copper_wire", 0))
	var tins0: float = sim.cash
	_check(sim.can_hand_in(0) and sim.hand_in(0) and int(sim.materials.get("copper_wire", 0)) == cw0 + 4 and sim.cash == tins0, "a material contract didn't pay its copper wire: %d from %d" % [int(sim.materials.get("copper_wire", 0)), cw0])
	var u: Dictionary = Items.roll_unique(Data.UNIQUES[0], sim.rng)
	_check(not sim.contract_fits(deep, u), "a unique fits a contract")
	# turning one down: free once a run, then notes doubling, free again after a run
	sim.passes = 0
	sim.notes = 100
	_check(sim.pass_cost() == 0 and sim.pass_contract(1) and sim.notes == 100, "the first turn-down cost notes")
	_check(sim.pass_cost() == Data.CONTRACT_PASS_NOTES and sim.pass_contract(1) and sim.notes == 100 - Data.CONTRACT_PASS_NOTES, "the second turn-down did not cost %d notes" % Data.CONTRACT_PASS_NOTES)
	_check(sim.pass_cost() == Data.CONTRACT_PASS_NOTES * 2, "the third turn-down does not double: %d" % sim.pass_cost())
	sim.notes = sim.pass_cost() - 1
	_check(not sim.can_pass_contract(1) and not sim.pass_contract(1), "a turn-down took without the notes")
	sim.notes = 100
	sim.hp = sim.max_hp()
	sim.deploy(3)
	sim.extract_now()
	if sim.on_mission():
		sim._extract()
	_check(sim.pass_cost() == 0, "a run home did not make the next turn-down free: %d" % sim.pass_cost())
	# a save keeps them; a save from before has its unique, socketable and rounds pays rolled again
	sim.passes = 2
	var rt: Dictionary = sim.to_dict()
	sim.load_dict(rt)
	_check(sim.passes == 2 and sim.contracts[0]["kind"] == rt["contracts"][0]["kind"], "the contracts or the turn-downs did not survive a save")
	var old: Dictionary = sim.to_dict()
	old["contracts"] = [{"slot": "Armour", "rarity": 2, "count": 3, "pay": "unique", "amount": 0, "unique": "x"}, {"slot": "Helmet", "rarity": 1, "count": 1, "pay": "socketable", "amount": 1, "what": "Road salt"}]
	sim.load_dict(old)
	_check(sim.contracts.all(func(c): return c["pay"] in Data.CONTRACT_PAYS and c.has("kind")), "an old save kept a unique or an item pay: %s" % str(sim.contracts))
	# five open with Orders: five rows on the tab
	_yard_set(sim, "fence", 1, "b")
	_check(sim.contracts.size() == Data.CONTRACTS_MAX, "Orders did not open five: %d" % sim.contracts.size())
	main.show_room(main.MARKET)
	main._fence._show("contracts")
	main._fence._shown = ""
	main.refresh()
	_check(range(Data.CONTRACTS_MAX).filter(func(k): return main._fence._list.row_of(k)["panel"].visible).size() == Data.CONTRACTS_MAX, "the tab does not show five rows with Orders")
	_check(main._fence._list.row_of(0)["pass"].text == "Pass" and main._fence._list.row_of(0)["tag"].text != "", "a row's Pass or its tag is off: '%s'" % main._fence._list.row_of(0)["pass"].text)
	_check_fit(main, "Fence (five contracts)")
	# the Fence's contracts tab reads them and fits
	main.show_room(main.MARKET)
	main._fence._show("contracts")
	main._fence._shown = ""
	main.refresh()
	_check_fit(main, "Fence (material contracts)")
	main._fence._show("shelf")
	sim.load_dict(saved)
	main.refresh()
	print("the contracts ok: five kinds of ask, notes and materials, salvage from its depth, the turn-down's price, the old saves, five rows")


## 34: crafting at the Bench. Scrap in hand from searches, scrapping and ditching; the Build column: a box of rounds,
## a grade from the box below, a med from the one below, an improvised gun firing nails, a grenade from its socketable.
func _build_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.scrap = 0
	# scrap from a search comes home; a ditch is scrap too; scrapping an item at the Bench is its value over twenty
	sim.deploy(3)
	var m: Dictionary = sim.mission
	m["remaining"] = 0
	m["cleared"] = true
	m["patrol_timer"] = -1e9
	m["event_at"] = -1.0
	m["crates_off"] = true                    # a site that can't be picked clean before a scrap roll (15 Oct, item 4: the flake)
	var guard := 0
	while int(m.get("scrap", 0)) == 0 and guard < 600:
		sim.hp = sim.max_hp()
		sim.advance(1.0)
		guard += 1
	var run_scrap: int = int(m.get("scrap", 0))
	_check(run_scrap >= Data.SCRAP_HANDFUL[0], "searches brought no scrap in %d seconds" % guard)
	var vest: Dictionary = sim._plain("Armour", "Riot suit")
	m["found"].append(vest)
	sim.ditch(vest["id"])
	_check(int(m.get("scrap", 0)) == run_scrap + sim.scrap_of(vest) and sim.scrap_of(vest) == int(vest["value"] / Data.SCRAP_PER_POUND), "the ditch did not pay its scrap: %d" % int(m.get("scrap", 0)))
	sim.extract_now()
	_check(sim.scrap == run_scrap + sim.scrap_of(vest), "the run's scrap did not come home: %d" % sim.scrap)
	var junk: Dictionary = sim._plain("Helmet", Data.BASES["Helmet"][0]["name"])
	sim.stash.append(junk)
	var before_scrap: int = sim.scrap
	_check(sim.scrap_item(junk["id"]) and not sim.stash.has(junk) and sim.scrap == before_scrap + sim.scrap_of(junk), "scrapping at the Bench is off: %d" % sim.scrap)
	# the Build column: each kind lists, with costs and what it wants
	sim.scrap = 1000
	sim.equipped["Primary"] = sim._plain("Primary", "Sawn-off")
	sim.equipped["Secondary"] = null
	for it in sim.stash.duplicate():
		if Items.is_gun(it) and Items.ammo_type(it) == "rifle":
			sim.stash.erase(it)
	var boxes: Array = sim.build_options("box")
	_check(boxes.any(func(o): return o["name"] == "Shells" and o["ok"]) and boxes.any(func(o): return o["name"] == "Rifle rounds" and not o["ok"] and o["why"] == "No gun for it"), "the boxes are off: %s" % str(boxes.map(func(o): return [o["name"], o["ok"]])))
	_check(sim.build("box", "Shells") and sim.scrap == 1000 - Data.BUILD_BOX and sim.stash.any(func(it): return Items.is_ammo(it) and it["base"] == "Shells"), "a box of shells did not build")
	# a grade wants a full box of the one below; it takes the rounds and leaves the rest
	var slugs: Dictionary = sim.build_option("grade", "Slugs")
	_check(slugs["from"] == "Shells" and slugs["from_n"] == 150 and slugs["ok"], "slugs' build is off: %s" % str(slugs))
	var shells_before: int = sim._rounds_in_stash("Shells")
	for it in sim.stash.duplicate():
		if Items.is_ammo(it) and it["base"] == "Slugs":
			sim.stash.erase(it)
	_check(not sim.build_option("grade", "Incendiary shells")["ok"] and sim.build_option("grade", "Incendiary shells")["why"].contains("slugs"), "incendiary shells built without a box of slugs under them")
	_check(sim.build("grade", "Slugs") and sim._rounds_in_stash("Shells") == shells_before - 150 and sim.stash.any(func(it): return Items.is_ammo(it) and it["base"] == "Slugs" and int(it["rounds"]) == 90), "slugs did not build from the shells")
	_check(sim.build_option("grade", "Incendiary shells")["ok"], "a box of slugs did not open the incendiary shells")
	# a med from the one below; a bandage from scrap alone
	for it in sim.stash.duplicate():
		if it["base"] == "Bandage" or it["base"] == "First aid kit":
			sim.stash.erase(it)
	_check(sim.build_option("med", "Bandage")["ok"] and not sim.build_option("med", "First aid kit")["ok"], "the med ladder's first step is off")
	_check(sim.build("med", "Bandage") and sim.build_option("med", "First aid kit")["ok"] and sim.build("med", "First aid kit") and not sim.stash.any(func(it): return it["base"] == "Bandage"), "a first aid kit did not take the bandage")
	# a gun: improvised, Common, plain, firing nails whatever it is, up to the Bench's level
	var guns: Array = sim.build_options("gun")
	_check(guns.size() >= 4 and guns.any(func(o): return o["tier"] >= 4), "the guns' list is not every improvised tier (9 Oct: no Bench level holds them back): %s" % str(guns.map(func(o): return [o["name"], o["tier"]])))
	_check(sim.build("gun", "Pipe shotgun"), "the pipe shotgun did not build")
	var built: Dictionary = sim.stash.back()
	_check(built["base"] == "Pipe shotgun" and int(built["rarity"]) == 0 and built["affixes"].is_empty() and built.get("nails", false) and Items.ammo_type(built) == "improvised", "the built gun is not plain and firing nails: %s" % str(built))
	# a grenade from its socketable; the nail bomb from scrap alone
	for it in sim.stash.duplicate():
		if it["base"] == "Lighter fluid":
			sim.stash.erase(it)
	_check(not sim.build_option("grenade", "Petrol bomb")["ok"] and sim.build_option("grenade", "Nail bomb")["ok"], "the grenade's socketable is not wanted")
	var fluid: Dictionary = sim._plain(Data.ATTACHMENT, "Lighter fluid")
	fluid["count"] = 2
	sim.stash.append(fluid)
	_check(sim.build("grenade", "Petrol bomb") and int(fluid["count"]) == 1 and sim.stash.any(func(it): return Items.is_grenade(it) and it["base"] == "Petrol bomb"), "the petrol bomb did not take one lighter fluid off the stack")
	# short of scrap: refused; out on a run: refused, scrapping too
	sim.scrap = 0
	_check(not sim.build_option("box", "Shells")["ok"] and sim.build_option("box", "Shells")["why"] == "Short of scrap" and not sim.build("box", "Shells"), "a build went through with no scrap")
	sim.scrap = 100
	sim.deploy(3)
	var out_opt: Dictionary = sim.build_option("box", "Shells")
	_check(not out_opt["ok"] and out_opt["why"] == "The runner is out" and not sim.build("box", "Shells") and not sim.scrap_item(sim.stash[0]["id"]), "the Bench worked with the runner out")
	sim.extract_now()
	_check(sim.last_report.has("scrap"), "the report does not carry the run's scrap")
	# the Bench's craft view says so and fits; the menus open and fit
	sim.scrap = 50
	main.show_room(main.WORKSHOP)
	main._workshop._set_view("craft")
	main._workshop.sel_id = -1
	main._workshop._shown = ""
	main.refresh()
	_check(main._workshop._build.visible and main._workshop._build.text == "Build for scrap", "the craft view has no Build button: '%s'" % main._workshop._build.text)
	_check_fit(main, "Workshop (craft, build)")
	# the Build view (21 Oct, off the old menu): Build for scrap opens it; a kind's builds are its cards, each priced;
	# a card picked fills the pick panel and its Build button builds through main
	var menu_before: String = main._menu._title.text if main._menu.visible else ""
	main._workshop._build.pressed.emit()
	var ws = main._workshop
	_check(ws.view == "build" and ws._kinds.visible and ws._builds.visible and (main._menu._title.text if main._menu.visible else "") == menu_before, "Build for scrap did not open the Build view (or opened a menu): view %s, kinds %s, builds %s, menu '%s'" % [ws.view, ws._kinds.visible, ws._builds.visible, main._menu._title.text if main._menu.visible else ""])
	_check(ws.VIEWS.size() == 5 and ws.VIEW_NAMES.size() == 5, "the Workshop's views are not five")      # Patterns the fifth (24 Oct)
	for kk in ws.BUILD_KINDS:
		ws._pick_kind(str(kk[0]))
		var kopts: Array = sim.build_options(str(kk[0]))
		var shown: int = 0
		for pg in range(ws._build_page_count()):
			shown += ws._build_cards.filter(func(c): return c["button"].visible).size()
			_check_fit(main, "Workshop (build, %s, page %d)" % [kk[0], pg + 1])
			ws._turn_builds(1)
		_check(shown == kopts.size() and ws.build_page == 0, "the Build view's pages show %d cards of %s's %d builds" % [shown, kk[0], kopts.size()])
		_check(main._workshop._inv.fixed_kind == ws.takes_slot(str(kk[0])), "the Build view's grid shows %s, not what %s takes" % [main._workshop._inv.fixed_kind, kk[0]])
	ws._pick_kind("grenade")
	_check(ws._inv.fixed_kind == Data.ATTACHMENT, "the grenades' grid isn't the socketables they take")
	sim.scrap = 500
	ws._pick_kind("box")
	var bopts: Array = sim.build_options("box")
	var bk: int = -1
	for k in range(bopts.size()):
		if bool(bopts[k]["ok"]):
			bk = k
			break
	_check(bk >= 0, "no box to build with a gun held")
	if bk >= 0:
		ws._pick_build_card(bk)
		_check(ws.sel_build == str(bopts[bk]["name"]) and ws._pick.button_texts() == ["Build · %d scrap" % int(bopts[bk]["scrap"])], "the picked build's button is off: %s" % str(ws._pick.button_texts()))
		_check_fit(main, "Workshop (build, picked)")
		var before: int = sim.scrap
		ws._pick.press(0)
		_check(sim.scrap == before - int(bopts[bk]["scrap"]), "the Build button did not build: scrap %d to %d" % [before, sim.scrap])
	# one not buildable: its card says why, its button is off
	ws._pick_kind("grade")
	var gopts: Array = sim.build_options("grade")
	for k in range(gopts.size()):
		if not bool(gopts[k]["ok"]):
			ws._pick_build_card(k)
			var before_g: int = sim.scrap
			ws._pick.press(0)
			var why_short: String = Workshop.why_short(str(gopts[k]["why"]))
			_check(sim.scrap == before_g and (ws._build_cards[k]["words"].text.contains(str(gopts[k]["why"])) or ws._build_cards[k]["words"].text.contains(why_short)), "a build it can't make went through, or its card doesn't say why: '%s'" % ws._build_cards[k]["words"].text)
			break
	main._workshop._set_view("guns")
	sim.load_dict(saved)
	main.refresh()
	print("the Bench's builds ok: scrap from a search, a ditch and a scrapping; a box, a grade from the box below, the med ladder, a gun firing nails, a grenade from its socketable, the refusals, the craft view and the Build view")


## 33: ammo grades with an element. The gun's live stack of hollow point bleeds, incendiary burns, salted chills,
## match rounds weight the first shot: read through the model like a conversion affix on the gun.
func _grade_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	for b in Data.BASES[Data.AMMO]:
		if b.has("conv_bleed_pct") or b.has("conv_fire_pct") or b.has("conv_frost_pct") or b.has("first_pct"):
			var it: Dictionary = sim._plain(Data.AMMO, b["name"])
			_check(Items.grade_words(b) != "" and Items.headline(it)[1].contains(Items.grade_words(b).trim_prefix(", ")) and Words.item_words(b["name"]) != "", "%s's grade does not read: '%s'" % [b["name"], Items.headline(it)[1]])
	_check(Data.BASES[Data.AMMO].any(func(b): return b["type"] == "shotgun" and b.has("conv_fire_pct")) and Data.BASES[Data.AMMO].any(func(b): return b["type"] == "smg" and b.has("conv_fire_pct")) and Data.BASES[Data.AMMO].any(func(b): return b["type"] == "rifle" and b.has("conv_frost_pct")), "a grade is missing: incendiary shells and SMG rounds, salted rifle rounds")
	# the live stack's share reaches the conversion; an empty stack or the wrong type does not
	sim.tree = sim.tree.filter(func(id): return not str(id).begins_with("Petrol/") and not str(id).begins_with("Live/") and not str(id).begins_with("Blades/"))
	var smg: Dictionary = sim._plain("Primary", "Workshop SMG")
	sim.equipped["Primary"] = smg
	sim.equipped["Secondary"] = null
	if sim.equipped["Rig"] == null:
		sim.equipped["Rig"] = sim._plain("Rig", Data.BASES["Rig"][0]["name"])
	sim.rig = []
	sim._dry_memo.clear()
	var bleed0: float = sim.conversion()["bleed"]
	var hollow: Dictionary = sim._plain(Data.AMMO, "SMG hollow point")
	sim.rig = [hollow]
	_check(is_equal_approx(sim.conversion()["bleed"], bleed0 + 0.2), "hollow point did not add its bleed share: %.2f from %.2f" % [sim.conversion()["bleed"], bleed0])
	_check(is_equal_approx(sim.grade_stat(smg, "conv_bleed_pct"), 20.0), "grade_stat reads %.0f" % sim.grade_stat(smg, "conv_bleed_pct"))
	hollow["rounds"] = 0
	_check(is_equal_approx(sim.conversion()["bleed"], bleed0), "an empty stack still converted")
	var fire_shells: Dictionary = sim._plain(Data.AMMO, "Incendiary shells")
	sim.rig = [fire_shells]
	_check(is_equal_approx(sim.grade_stat(smg, "conv_fire_pct"), 0.0), "shotgun shells fed the SMG's conversion")
	# match rounds weight the first shot
	var rifle: Dictionary = sim._plain("Primary", "Stalking rifle")
	sim.equipped["Primary"] = rifle
	sim.rig = [sim._plain(Data.AMMO, "Match rounds")]
	_check(is_equal_approx(sim.grade_stat(rifle, "first_pct"), 25.0) and is_equal_approx(sim.grade_bonus(rifle), 15.0), "match rounds' first shot and damage read %.0f / %.0f" % [sim.grade_stat(rifle, "first_pct"), sim.grade_bonus(rifle)])
	# the first shot through the fight: a tick fresh with match rounds lands more than one with plain rounds
	var plain_r: Dictionary = sim._plain(Data.AMMO, "Rifle rounds")
	sim.auto_equip = false                # "Equip if better" would swap the rifle out on deploy
	sim.candidates = []                   # a runner waiting to be picked would take over the kit on deploy
	var drops := []
	sim.stash = sim.stash.filter(func(x): return not Items.is_ammo(x))     # deploy tops the rig up from the stash: only the stack on test (19 Oct: the rarity rows keep rounds now)
	for stack in [plain_r, sim._plain(Data.AMMO, "Match rounds")]:
		sim.rig = [stack]
		sim.rng.seed = 11
		sim.deploy(3)
		var m: Dictionary = sim.mission
		m["target_hp"] = 1e6
		m["remaining"] = 3
		m["fresh"] = true
		m["t"]["res"] = {}                # the same target both times: the intel re-rolls between deploys (a Hardened word is 30% off physical)
		m["t"]["pace"] = 1.0
		sim.rng.seed = 11                 # the swing the same both times: deploy spent the dice differently
		sim._fight(m, m["t"], 0.5)
		drops.append(1e6 - m["target_hp"])
		drops.append("%s rig %s rounds %s grade %.0f first %.0f melee %s rules %s dps %.1f physical %.1f pace %.2f site pace %.2f res %s fresh %s dealt_by %s" % [sim.equipped["Primary"]["base"], str(sim.rig.map(func(x): return x["base"])), str(sim.has_rounds(sim.equipped["Primary"])), sim.grade_bonus(sim.equipped["Primary"]), sim.grade_stat(sim.equipped["Primary"], "first_pct"), str(sim.melee()), str(sim.has_rule("qm_rifle")), sim.dps(), float(sim.type_dps()["physical"]), sim.pace(), float(m["t"]["pace"]), str(m["t"].get("res", {})), str(m["fresh"]), str(m.get("dealt_by", {}))])
		sim.extract_now()
	# the class's own first-shot share (the Poacher's +40%) is on both: the expected ratio is the grade's 15% times
	# (class + 25%) over (class), read against the class at hand
	var cls_first: float = float(sim.class_data().get("first_pct", 0)) / 100.0
	var expect: float = 1.15 * (1.0 + cls_first + 0.25) / (1.0 + cls_first)
	_check(drops[2] > drops[0] * expect * 0.97, "match rounds' first shot did not land heavier: %.1f against %.1f, expected ×%.2f (%s / %s)" % [drops[2], drops[0], expect, drops[1], drops[3]])
	# no gun in hand: the odds read without a grade, not a crash
	sim.equipped["Primary"] = null
	sim.rig = []
	sim._surv_cache = {}
	var odds: float = sim.survival(3)
	_check(odds >= 0.0 and odds <= 1.0, "the odds with no gun in hand read %.2f" % odds)
	sim.equipped["Primary"] = rifle
	sim.load_dict(saved)
	main.refresh()
	print("the grades ok: the words, the three new ones, the share through the conversion, the empty and the wrong stack, the match rounds")


## 32: grenades in the rig. A pouch each, thrown at everyone on you as the type's damage through the model, a dot on the gang.
func _grenade_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	for b in Data.BASES[Data.GRENADE]:
		var g: Dictionary = sim._plain(Data.GRENADE, b["name"])
		_check(Items.is_grenade(g) and Items.rig_item(g) and Items.size(g) == 1 and int(g["rarity"]) == 0 and g["affixes"].is_empty() and Items.headline(g)[0] != "" and Words.item_words(b["name"]) != "", "%s is not a plain one-pouch grenade with words" % b["name"])
	# the throw: the type's damage to everyone on you, the resist read, the dot landed, the pouch spent
	if sim.equipped["Rig"] == null:
		sim.equipped["Rig"] = sim._plain("Rig", Data.BASES["Rig"][0]["name"])
	sim.rig = []
	var bomb: Dictionary = sim._plain(Data.GRENADE, "Petrol bomb")
	sim.rig.append(bomb)
	sim.deploy(3)
	_check(sim.on_mission(), "no run for the grenade checks")
	if not sim.on_mission():
		sim.load_dict(saved)
		return
	var m: Dictionary = sim.mission
	m["remaining"] = 0
	_check(not sim.use_grenade(bomb["id"]) and sim.rig.filter(func(x): return Items.is_grenade(x)).size() == 1, "a grenade went off with no one there")     # the gate's top-up can put a box in the rig beside it
	m["remaining"] = 5
	m["target_hp"] = 100000.0
	m["dots"] = {}
	var t: Dictionary = m["t"]
	var crowd: int = mini(5, sim.contact(t))
	var expect: float = 80.0 * (1.0 + sim.increased("fire") / 100.0) * sim.more("fire") * (1.0 - float(t.get("res", {}).get("fire", 0.0))) * crowd
	var hp0: float = m["target_hp"]
	_check(sim.use_grenade(bomb["id"]), "the petrol bomb did not throw")
	_check(is_equal_approx(hp0 - m["target_hp"], expect) and sim.rig.filter(func(x): return Items.is_grenade(x)).is_empty() and float(m["dots"].get("fire", 0.0)) > 0.0 and int(m.get("thrown", 0)) == 1, "the throw landed %.0f, not %.0f; rig %d; fire dot %.1f" % [hp0 - m["target_hp"], expect, sim.rig.size(), float(m["dots"].get("fire", 0.0))])
	# a throw onto a burn the gun built never shrinks it; a kill by a throw resolves on the next tick
	var gun_rate: float = float(sim.type_dps()["fire"]) * (1.0 - float(t.get("res", {}).get("fire", 0.0))) * sim.pace() * t["pace"]
	var gun_cap: float = gun_rate * float(Data.DOTS["fire"]["ratio"]) * sim.dot_seconds("fire") * sim.dot_stacks("fire")
	m["dots"] = {"fire": gun_cap}
	sim.rig = [sim._plain(Data.GRENADE, "Petrol bomb")]
	sim.use_grenade(sim.rig[0]["id"])
	_check(float(m["dots"]["fire"]) >= gun_cap - 0.01, "the throw shrank the burn: %.0f from %.0f" % [float(m["dots"]["fire"]), gun_cap])
	m["dots"] = {}
	m["remaining"] = 3
	m["target_hp"] = 1.0
	var kills0: int = m["kills"]
	sim.rig = [sim._plain(Data.GRENADE, "Petrol bomb")]
	sim.use_grenade(sim.rig[0]["id"])
	sim.advance(0.5)
	_check(sim.on_mission() and m["kills"] > kills0 and m["remaining"] < 3, "the throw's kill did not resolve: kills %d, remaining %d" % [m["kills"], m["remaining"]])
	m["target_hp"] = 100000.0
	# the idle junk run leaves grenades alone
	var hold_auto: bool = sim.auto_sell
	var keep: Dictionary = sim._plain(Data.GRENADE, "Nail bomb")
	sim.stash.append(keep)
	sim.auto_sell = true
	sim.sell_junk()
	_check(sim.stash.has(keep), "the junk run sold a grenade")
	sim.auto_sell = hold_auto
	sim.stash.erase(keep)
	# frost chills, shock shocks; no enemies, no throw
	var ice: Dictionary = sim._plain(Data.GRENADE, "Dry-ice bag")
	var battery: Dictionary = sim._plain(Data.GRENADE, "Wired battery")
	sim.rig = [ice, battery]
	sim.use_grenade(ice["id"])
	_check(float(m.get("chill_t", 0.0)) > 0.0, "the dry ice did not chill them")
	sim.use_grenade(battery["id"])
	_check(float(m.get("shock_t", 0.0)) > 0.0 and sim.rig.is_empty(), "the battery did not shock them")
	m["remaining"] = 0
	sim.rig = [sim._plain(Data.GRENADE, "Nail bomb")]
	_check(not sim.use_grenade(sim.rig[0]["id"]) and sim.rig.size() == 1, "a grenade was thrown at no one")
	# the run's pouch: lit with a gang on you, pressed it throws; the pick panel knows a grenade
	m["remaining"] = 3
	m["target_hp"] = 100000.0
	main.show_room(main.MISSIONS)
	main.refresh()
	_check(main._run._rig_cells[0].visible, "the grenade's pouch does not show on the run")
	_check_fit(main, "Run (a grenade in the rig)")
	var thrown0: int = int(m.get("thrown", 0))
	main._run._rig_pressed(0)
	_check(sim.rig.is_empty() and int(m.get("thrown", 0)) == thrown0 + 1, "pressing the pouch did not throw the nail bomb")
	m["found"].append(sim._plain(Data.GRENADE, "Bottle of something"))
	main.refresh()
	main._run._inv._pick(main._run._inv.cell_of(m["found"].back()["id"]))
	main.refresh()
	_check(main._run._pick.button_texts()[0] == "Take into the rig", "a grenade found does not offer the rig: %s" % str(main._run._pick.button_texts()))
	_check_fit(main, "Run (a grenade found)")
	main._run._pick.press(0)
	_check(sim.rig.size() == 1 and Items.is_grenade(sim.rig[0]), "Take did not put the grenade in the rig")
	sim.extract_now()
	# the Lock-up: a grenade in the stash goes to the rig; the head's chips say what it is
	sim.rig = []
	var g2: Dictionary = sim._plain(Data.GRENADE, "Petrol bomb")
	sim.stash.append(g2)
	main.show_room(main.ARMOURY)
	main._armoury._inv._set_kind(4)
	main.refresh()
	main._armoury._pick_cell(main._armoury._inv.cell_of(g2["id"]))
	main.refresh()
	var chips_g: Array = main._armoury._head._chip_labels.filter(func(l): return l.visible).map(func(l): return l.text)
	_check(chips_g.size() >= 2 and chips_g[0] == "Grenade" and chips_g[1] == "Fire", "a grenade's chips are %s" % str(chips_g))
	_check(main._armoury._pick.button_texts()[0] == "Take", "a stash grenade does not offer Take: %s" % str(main._armoury._pick.button_texts()))
	_check_fit(main, "Lock-up (a grenade)")
	main._armoury._press(0)
	_check(sim.rig.size() == 1 and sim.rig[0]["id"] == g2["id"], "Take did not move the grenade to the rig")
	# Split (12 Oct, Matt's playtest): half a stack of rounds off into its own beside it, the pick kept, the value following
	var shells: Dictionary = sim._plain("Ammo", "Shells") if Data.BASES.has("Ammo") else {}
	if not shells.is_empty():
		Items.set_stack(shells, 31)
		var before_ids: Array = sim.stash.map(func(it): return it["id"])     # a Shells stack the smoke's runs left is not ours (13 Oct: a 150 read as a third half)
		sim.stash.append(shells)
		main._armoury._inv._set_kind(0)
		main.refresh()
		main._armoury._pick_cell(main._armoury._inv.cell_of(shells["id"]))
		main.refresh()
		var bt: Array = main._armoury._pick.button_texts()
		_check(bt.has("Split"), "a stack of rounds offers no Split: %s" % str(bt))
		_check_fit(main, "Lock-up (rounds, Split)")
		var v0: int = int(shells["value"])
		main._armoury._press(bt.find("Split"))
		var halves: Array = sim.stash.filter(func(it): return Items.is_ammo(it) and it["base"] == "Shells" and not before_ids.has(it["id"]))
		_check(halves.size() == 2 and Items.stack_size(shells) == 16 and halves.any(func(it): return it["id"] != shells["id"] and Items.stack_size(it) == 15), "Split did not halve the stack: %s" % str(halves.map(func(it): return Items.stack_size(it))))
		_check(absi(int(halves[0]["value"]) + int(halves[1]["value"]) - v0) <= 1, "Split changed what the rounds are worth")
		_check(main._armoury.selected.get("id", -1) == shells["id"], "Split lost the pick")
		var one: Dictionary = sim._plain("Ammo", "Shells")
		Items.set_stack(one, 1)
		sim.stash.append(one)
		_check(not sim.can_split(one["id"]), "a single round splits")
		sim.stash = sim.stash.filter(func(it): return before_ids.has(it["id"]) or not (Items.is_ammo(it) and it["base"] == "Shells"))
	# the Fence's shelf carries them now and then
	var seen := false
	for k in range(40):
		sim.restock()
		if sim.market.any(func(it): return Items.is_grenade(it)):
			seen = true
			break
	_check(seen, "forty restocks put no grenade on the Fence's shelf")
	main._armoury._inv._set_kind(0)
	sim.load_dict(saved)
	main.refresh()
	print("grenades ok: the five, the throw, the chill and the shock, no one there, the pouch, the pick, the Lock-up, the shelf")


## The bench's panel on the pick frame (Matt, 6 Oct), and a typed part refused on the wrong gun.
## Each piece on the pick panel in its own box (Pick-B, 7 Oct): a box a column
## shown, every one of the column's text nodes inside it, the two boxes apart,
## and both above the foot.
func _pick_boxes_check(pick, where: String) -> void:
	var boxes: Array = pick._boxes
	_check(boxes[0].visible, "%s: the pick's box is not shown" % where)
	var r0: Rect2 = Rect2(boxes[0].position, boxes[0].size)
	var r1: Rect2 = Rect2(boxes[1].position, boxes[1].size)
	_check(not r0.intersects(r1) and r1.position.x - r0.end.x >= 2.0, "%s: the two boxes touch or overlap (%s, %s)" % [where, str(r0), str(r1)])
	_check(r0.position.x >= 0.0 and r1.end.x <= pick.w, "%s: a box runs off the panel (%s, %s against %d)" % [where, str(r0), str(r1), pick.w])
	_check(r0.end.y <= pick.foot_y and r1.end.y <= pick.foot_y, "%s: a box runs into the foot (%s / %s against %d)" % [where, str(r0), str(r1), pick.foot_y])
	for k in range(2):
		if not boxes[k].visible:
			continue
		var r: Rect2 = Rect2(boxes[k].position, boxes[k].size).grow(-1)
		var nodes: Array = [pick._kickers[k], pick._heads[k]] if k == 0 else [pick._kickers[k], pick._heads[k], pick._right_title]
		for n in nodes:
			if not n.visible:
				continue
			var nr: Rect2 = Rect2(n.position, n.size)
			_check(r.encloses(nr), "%s: %s sits outside its box: %s against %s" % [where, n.name if n.name != "" else "a node", str(nr), str(r)])
		if pick._tags[k].visible:
			var row: Rect2 = Rect2(pick._tags[k].position, pick._tags[k].size)
			_check(r.encloses(row), "%s: the price tag sits outside its box: %s against %s" % [where, str(row), str(r)])


func _bench_pick_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var rifle: Dictionary = sim._plain("Primary", "Garage-built rifle")
	sim.equipped["Primary"] = rifle
	var choke: Dictionary = sim._plain(Data.ATTACHMENT, "Choke")
	while not sim.stash_room(1) and not sim.stash.is_empty():
		sim.sell(sim.stash[0])
	sim.stash.append(choke)
	_check(Items.base_of(choke).get("type", "") == "shotgun" and rifle["attachments"].has("muzzle"), "the choke is not a shotgun's muzzle part")
	_check(not sim.can_fit("Primary", choke["id"]) and sim.fit_refusal("Primary", choke["id"]) == "Shotguns only", "a shotgun-only choke was not refused on a rifle: '%s'" % sim.fit_refusal("Primary", choke["id"]))
	_check(not sim.attachments_for("muzzle", "improvised").has(choke) and sim.attachments_for("muzzle").has(choke), "attachments_for does not leave a typed part off another gun's list")
	var stock: Dictionary = sim._plain(Data.ATTACHMENT, "Wire stock")
	_check(Items.only_words(stock) == "Improvised guns only", "the wire stock's words read '%s'" % Items.only_words(stock))
	_check(not sim.fit("Primary", choke["id"]) and rifle["attachments"]["muzzle"] == null, "the choke went on the rifle")
	main.show_room(main.WORKSHOP)
	main._workshop._set_view("guns")
	main._workshop.sel_slot = ""
	main._workshop.sel_mount = ""
	main.refresh()
	main._workshop._pick_cell(main._workshop._inv.cell_of(choke["id"]))
	main.refresh()
	var pk = main._workshop._pick
	_check(pk.visible and pk._heads[0].visible and pk._heads[0]._title.text == "Choke" and pk._tag_labels[0].visible, "the Bench's part pick is not on the pick frame: '%s'" % pk._heads[0]._title.text)
	_check(pk.button_texts() == ["Fit"] and pk._buttons[0].disabled and pk.hint_text() == "Shotguns only", "the Bench did not grey Fit with the reason: %s / '%s'" % [str(pk.button_texts()), pk.hint_text()])
	# a part that fits: the right column's figure and the verdict are the top bar's before and after (18 Oct: the gun's
	# raw hits called a part that turns them to fire nothing)
	var comp: Dictionary = sim._plain(Data.ATTACHMENT, "Compensator")
	while not sim.stash_room(1) and not sim.stash.is_empty():
		sim.sell(sim.stash[0])
	sim.stash.append(comp)
	main._workshop.sel_slot = ""
	main._workshop.sel_mount = ""
	main._workshop.sel_id = -1
	main._workshop._shown = ""
	main.refresh()                            # the grid laid again with the part in it
	main._workshop._pick_cell(main._workshop._inv.cell_of(comp["id"]))
	main.refresh()
	var dwc: Array = sim.damage_with_part("Primary", comp)
	var fit_line: String = "Fitting it: %.0f → %.0f dmg/s" % [float(dwc[0]), float(dwc[1])]
	_check(pk._right_lines.any(func(l): return l.text == fit_line) and pk._verdict.text == ("▲ Fits" if float(dwc[1]) - float(dwc[0]) >= -0.5 else "▼ Costs damage"), "the Bench's part reads '%s' / '%s', not '%s'" % [str(pk._right_lines.map(func(l): return l.text)), pk._verdict.text, fit_line])
	sim.stash.erase(comp)
	_check(not pk.button_texts().any(func(t): return t.begins_with("Sell")), "Sell is on the Bench")
	_check_fit(main, "Workshop (a refused part)")
	# a part that fits: the verdict and the swap read, Fit goes through the frame
	var dot: Dictionary = sim._plain(Data.ATTACHMENT, "Red dot")
	sim.stash.append(dot)
	main._workshop.sel_slot = ""
	main._workshop.sel_mount = ""
	main._workshop.sel_id = -1
	main.refresh()
	main._workshop._pick_cell(main._workshop._inv.cell_of(dot["id"]))
	main.refresh()
	_check(pk.button_texts() == ["Fit"] and not pk._buttons[0].disabled and pk._verdict.visible, "a fitting part's panel is off: %s / '%s' / pick %s, slot %s mount %s, title '%s', right '%s' '%s'" % [str(pk.button_texts()), pk._verdict.text, str(main._workshop.sel_id), main._workshop.sel_slot, main._workshop.sel_mount, pk._heads[0]._title.text, pk._kickers[1].text, pk._right_title.text])
	_check_fit(main, "Workshop (a part that fits)")
	pk.press(0)
	main.refresh()
	_check(rifle["attachments"]["optic"] != null and rifle["attachments"]["optic"]["base"] == "Red dot", "Fit through the frame did not fit the red dot")
	main._workshop._pick_mount("Primary", "optic")
	main.refresh()
	_check(pk._heads[0].visible and pk._heads[0]._title.text == "Red dot" and pk.button_texts() == ["Strip"], "a fitted part's panel is off: %s" % str(pk.button_texts()))
	_check_fit(main, "Workshop (a fitted part picked)")
	# a socketable: what it does to the damage, before the fit and after (19 Oct, Matt: the socket said nothing)
	rifle["attachments"]["socket 1"] = null
	var fluid: Dictionary = sim._plain(Data.ATTACHMENT, "Lighter fluid")
	_check(Items.is_socketable(fluid) and sim.mount_open("socket 1"), "the fixture: lighter fluid isn't a socketable, or the first socket's shut")
	while not sim.stash_room(1) and not sim.stash.is_empty():
		sim.sell(sim.stash[0])
	sim.stash.append(fluid)
	main._workshop._set_view("sockets")
	main._workshop.sel_slot = ""
	main._workshop.sel_mount = ""
	main._workshop.sel_id = -1
	main._workshop._shown = ""
	main.refresh()
	main._workshop._pick_cell(main._workshop._inv.cell_of(fluid["id"]))
	main.refresh()
	var dws: Array = sim.damage_with_part(main._workshop.sel_slot if main._workshop.sel_slot != "" else "Primary", fluid, "socket 1")
	var sock_line: String = "Fitting it: %.0f → %.0f dmg/s" % [float(dws[0]), float(dws[1])]
	_check(pk._right_lines.any(func(l): return l.text == sock_line) and pk._verdict.visible and pk._verdict.text != "", "the socketable reads '%s' / '%s', not '%s'" % [str(pk._right_lines.map(func(l): return l.text)), pk._verdict.text, sock_line])
	_check(float(dws[1]) > float(dws[0]), "lighter fluid in the rifle's socket read no damage: %.1f → %.1f" % [float(dws[0]), float(dws[1])])
	_check_fit(main, "Workshop (a socketable picked)")
	# in a body piece's socket: the body's figure, not the damage (the review: salt in armour read "Sidegrade" on dmg/s)
	var vest = sim.equipped["Armour"]
	if vest != null:
		vest["attachments"]["socket 1"] = null
		var salt: Dictionary = sim._plain(Data.ATTACHMENT, "Road salt")
		while not sim.stash_room(1) and not sim.stash.is_empty():
			sim.sell(sim.stash[0])
		sim.stash.append(salt)
		main._workshop.sel_slot = "Armour"
		main._workshop.sel_mount = "socket 1"
		main._workshop.sel_id = salt["id"]
		main._workshop._shown = ""
		main.refresh()
		var bw: Array = sim.body_with_part("Armour", salt, "socket 1")
		var said_s: Array = pk._right_lines.map(func(l): return l.text)
		_check(float(bw[1]) > float(bw[0]) and pk._verdict.text == "▲ Fits" and not said_s.any(func(t): return str(t).contains("dmg/s")) and said_s.any(func(t): return str(t).begins_with("Fitting it: stands the fight")), "salt in the armour's socket reads '%s' / %s (the body %.2f → %.2f)" % [pk._verdict.text, str(said_s), float(bw[0]), float(bw[1])])
		_check_fit(main, "Workshop (a socketable for the armour)")
		sim.stash.erase(salt)
		main._workshop._set_view("sockets")
	else:
		_check(false, "the fixture: no armour on for the body's socket")
	var fitted_ok: bool = sim.fit_socket("Primary", "socket 1", fluid["id"])
	var after: float = sim._try({}, sim.damage_total)          # as the verdicts read a kit: fed (the smoke sold its rounds for room)
	_check(fitted_ok and is_equal_approx(after, float(dws[1])), "the socket's figure before the fit (%.1f → %.1f) isn't the kit's after (%.1f; fitted %s, slot '%s')" % [float(dws[0]), float(dws[1]), after, str(fitted_ok), main._workshop.sel_slot])
	sim.load_dict(saved)
	main.refresh()
	print("the Bench's pick frame ok: the part, the refusal, the fit, the fitted")


## Pick-A (Matt, 6 Oct): the pick and the fitted laid the same on the run and in the Lock-up; a price tag, no fence
## line, no ditched line; Equip and Ditch on a run (what comes off goes into the pack); no Sell in the Lock-up.
func _pick_panel_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	# on a run: an armour in the pack against the one worn; Equip swaps them; the pack must hold what comes off
	var worn: Dictionary = sim._plain("Armour", "Riot suit")
	sim.equipped["Armour"] = worn
	sim.equipped["Backpack"] = sim._plain("Backpack", "School bag")     # twelve cells: the leathers and the suit's three more; the start's bag has nine
	sim.deploy(3)
	var m: Dictionary = sim.mission
	var found: Dictionary = sim._plain("Armour", "Motorbike leathers")
	found["rarity"] = 2
	found["affixes"] = [{"stat": "poison_res", "value": 7, "tier": 1}, {"stat": "armour", "value": 3, "tier": 1}]
	m["found"] = [found]
	main.show_room(main.MISSIONS)
	main.refresh()
	main._run._inv._pick(main._run._inv.cell_of(found["id"]))
	main.refresh()
	var pk = main._run._pick
	_check(pk._heads[0].visible and pk._heads[1].visible and pk._heads[0]._title.text == "Motorbike leathers" and pk._heads[1]._title.text == "Riot suit", "the run's pick does not lay the pick and the fitted side by side: %s / %s" % [pk._heads[0]._title.text, pk._heads[1]._title.text])
	# one form for the affix chips, side by side (16 Oct, Matt: "res not resistance"): the short always, even with room;
	# a proof names both its halves; nothing reads "resist"
	var lone = load("res://scripts/ui/item_head.gd").new(440)
	main.add_child(lone)
	var roomy: Dictionary = sim._plain("Helmet", "Hard hat")
	roomy["rarity"] = 2
	roomy["affixes"] = [{"stat": "fire_proofed", "value": 8, "tier": 2}, {"stat": "bleed_res", "value": 9, "tier": 1}]
	lone.show_item(roomy, sim)
	var chip_words: Array = []
	for h in [pk._heads[0], lone]:
		for l in h._affixes.text_nodes():
			chip_words.append(str(l.text))
	var joined: String = " | ".join(chip_words)
	lone.queue_free()
	_check(not joined.contains("resist") and joined.contains("poison res") and joined.contains("bleed res") and joined.contains("fire res & dmg"), "the affix chips side by side aren't one short form: %s" % joined)
	# the flavour on the foot, always (18 Oct, Matt: it moved between the column and the foot, and a hint pushed it off):
	# left of the buttons, inside the panel, whole sentences (under a verdict its one row keeps the sentences that fit);
	# with no verdict, wrapped to the foot's two rows when it needs them
	var said: String = Words.item_words("Motorbike leathers")
	var fl: Label = pk._words
	var edge: float = pk._foot_left_edge()
	_check(said == "" or (fl.visible and fl.text != "" and said.begins_with(fl.text) and fl.text.ends_with(".") and fl.position.y >= pk.foot_y and fl.position.x + fl.size.x <= edge + 0.5 and fl.position.y + fl.size.y <= pk.h + 0.5 and (fl.autowrap_mode != TextServer.AUTOWRAP_OFF or UI.text_width(fl, fl.text) <= fl.size.x)),
		"the pick's flavour isn't whole on the foot: '%s' at %s (edge %.0f)" % [fl.text, str(Rect2(fl.position, fl.size)), edge])
	# and wrapped, every row of it shows (17 Oct, Matt's shot: the blank-firer's two rows cut to "It fires...") - and a
	# hint never takes its place: it's a chip at the front of the tail
	var knife_was = sim.equipped["Secondary"]
	sim.equipped["Secondary"] = sim._plain("Secondary", "Knife")
	var blank: Dictionary = sim._plain("Secondary", "Converted blank-firer")
	blank["affixes"] = [{"stat": "damage_low_pct", "value": 8, "tier": 1}]
	sim.stash_put(blank)
	pk.show_pick(blank, sim, "The pick · in the stash")
	pk.show_fitted(sim.equipped["Secondary"], sim)
	pk.set_hint_options(["No rounds for it in the rig"])
	var bl: Label = pk._words
	var bw: String = Words.item_words("Converted blank-firer")
	var whole: bool = bl.visible and (bl.text == bw or bw.begins_with(bl.text)) and (bl.autowrap_mode == TextServer.AUTOWRAP_OFF or bl.get_visible_line_count() >= bl.get_line_count())
	_check(whole and bl.position.y >= pk.foot_y and bl.position.y + bl.size.y <= pk.h + 0.5, "the blank-firer's flavour isn't whole on the foot: '%s', %d of %d rows show, %s" % [bl.text, bl.get_visible_line_count(), bl.get_line_count(), str(Rect2(bl.position, bl.size))])
	_check(pk.hint_text() == "No rounds for it in the rig" and bl.text != pk.hint_text(), "the hint isn't a chip in the tail: '%s' / foot '%s'" % [pk.hint_text(), bl.text])
	pk.set_hint_options([])
	_check(pk.hint_text() == "", "the hint chip stayed after the hint went")
	# a hint too long beside the tail still shows, alone, inside the head (the review: the Workshop's refusals)
	var long_why: String = "The %s has no magazine mount" % "police marksman's rifle"
	pk.set_hint_options([long_why, "No magazine mount", "Doesn't fit"])
	var tc = pk._heads[0]._tail_chips
	_check(pk.hint_text() != "" and tc.used_rect().size.x <= pk._heads[0].width + 0.5, "a long hint vanished or left the head: '%s', %.0f of %.0f" % [pk.hint_text(), tc.used_rect().size.x, pk._heads[0].width])
	pk.show_pick(blank, sim, "The pick · in the stash")
	_check(pk.hint_text() == "", "the next pick kept the last one's hint")
	sim.stash.erase(blank)
	sim.equipped["Secondary"] = knife_was
	main._run._shown = ""
	# the run repaints its pick from the pack's selection, still the leathers, for what follows
	main.refresh()
	# rounds lead with how many, the grade a chip; a gun's tail is chips
	var slugs_it: Dictionary = sim._plain(Data.AMMO, "Slugs")
	var lone2 = load("res://scripts/ui/item_head.gd").new(440)
	main.add_child(lone2)
	lone2.show_item(slugs_it, sim, "feeds the shotgun")
	var tw: Array = lone2._tail_chips.text_nodes().map(func(l): return str(l.text))
	_check(lone2._figure.text == str(int(slugs_it["rounds"])) and lone2._unit.text == "rounds" and tw.any(func(t): return t.begins_with("+") and t.contains("%")), "special rounds aren't led by their count, the bonus a chip: '%s %s' / %s" % [lone2._figure.text, lone2._unit.text, str(tw)])
	var gun_it: Dictionary = sim._plain("Primary", _base_of_type("shotgun"))
	lone2.show_item(gun_it, sim, ["fits nothing", "shells, 40 in the rig"])
	_check(lone2._tail_chips.visible and not lone2._tail.visible and lone2._tail_chips.text_nodes().size() >= 2, "a gun's tail isn't chips: %s" % str(lone2._tail_chips.text_nodes().map(func(l): return l.text)))
	lone2.queue_free()
	_check(pk._kickers[0].text == "THE PICK · IN THE PACK · %d CELLS" % Items.size(found) and pk._kickers[1].text == "FITTED NOW · %d CELLS" % Items.size(worn), "the kickers are off: '%s' / '%s'" % [pk._kickers[0].text, pk._kickers[1].text])
	_check(pk._tag_labels[0].text == Fmt.money(sim.sell_price(found)) and pk._tag_labels[1].text == Fmt.money(sim.sell_price(worn)), "the price tags are off: %s / %s" % [pk._tag_labels[0].text, pk._tag_labels[1].text])
	_check(pk._verdict.visible and pk._verdict.text.begins_with("▼ Downgrade") and pk._deltas[0].visible and pk._deltas[0].text.begins_with("▼"), "the verdict and deltas are off: '%s' / '%s'" % [pk._verdict.text, pk._deltas[0].text])
	_check(pk.button_texts() == ["Equip", "Ditch"] and not pk._buttons[0].disabled, "the run's buttons are not Equip and Ditch: %s" % str(pk.button_texts()))
	_check(not pk.text_nodes().any(func(l): return l.text.begins_with("The Fence pays") or l.text.begins_with("Ditched")), "the Fence line or the ditched line is still there")
	_check_fit(main, "Run (Pick-A)")
	pk.press(0)
	main.refresh()
	_check(sim.equipped["Armour"]["id"] == found["id"] and m["found"].size() == 1 and m["found"][0]["id"] == worn["id"], "Equip on a run did not swap the worn piece into the pack")
	# no room for what comes off (the riot suit back on, three cells bigger than the vest found): Equip greyed, the hint says so
	sim.equipped["Armour"] = worn
	var small: Dictionary = sim._plain("Armour", "Stab vest")
	m["found"] = [small]
	while sim.pack_used(m) + (Items.size(worn) - Items.size(small)) <= sim.capacity():
		m["found"].append(sim._plain(Data.AMMO, "Nails"))
	main.refresh()
	main._run._inv._pick(main._run._inv.cell_of(small["id"]))
	main.refresh()
	_check(pk._buttons[0].disabled and pk.hint_text().begins_with("No room in the pack"), "a full pack did not grey Equip with the hint: '%s'" % pk.hint_text())
	_check_fit(main, "Run (Pick-A, no room)")
	# a smaller backpack found: Equip only when what's carried still fits in it
	var worn_pack = sim.equipped["Backpack"]
	var big_pack: Dictionary = sim._plain("Backpack", Data.BASES["Backpack"].back()["name"])
	sim.equipped["Backpack"] = big_pack
	var small_pack: Dictionary = sim._plain("Backpack", "School bag")     # the smallest found pack; the start is under it
	m["found"] = [small_pack]
	while sim.pack_used(m) + Items.size(big_pack) + 1 <= sim.capacity():
		m["found"].append(sim._plain(Data.AMMO, "Nails"))
	_check(not sim.can_equip_from_pack(small_pack["id"]), "a smaller backpack could go on over a pack it cannot hold")
	m["found"] = [small_pack]
	_check(sim.can_equip_from_pack(small_pack["id"]), "a smaller backpack with room could not go on")
	sim.equipped["Backpack"] = worn_pack
	sim.extract_now()
	sim.load_dict(saved)
	# the Lock-up: the same frame, no Sell anywhere
	sim.equipped["Armour"] = sim._plain("Armour", "Riot suit")
	var in_stash: Dictionary = sim._plain("Armour", "Motorbike leathers")
	sim.stash.append(in_stash)
	main.show_room(main.ARMOURY)
	main._armoury._inv._set_kind(0)
	main.refresh()
	main._armoury._pick_cell(main._armoury._inv.cell_of(in_stash["id"]))
	main.refresh()
	var lk = main._armoury._pick
	_check(lk._heads[0].visible and lk._heads[1].visible and lk._heads[1]._title.text == "Riot suit" and lk._kickers[0].text.begins_with("THE PICK · IN THE STASH"), "the Lock-up's pick is not the same frame: %s / '%s'" % [lk._heads[1]._title.text, lk._kickers[0].text])
	_check(not lk.button_texts().any(func(t): return t.begins_with("Sell")), "Sell is still in the Lock-up: %s" % str(lk.button_texts()))
	_check(lk._verdict.visible and lk._tag_labels[0].visible, "the Lock-up's verdict or price tag is missing")
	_check_fit(main, "Lock-up (Pick-A)")
	sim.stash.erase(in_stash)
	sim.load_dict(saved)
	main.refresh()
	print("Pick-A ok: the two columns, the tags, the verdict, Equip and Ditch on a run, the swap, no room, the Lock-up without Sell")


## 31: the works' rules, now picks (9 Oct): the Generator's Battery, the Lookout's Hold fire, the Kennel's Fetch.
func _top_works_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	_check(not Data.yard_where("battery").is_empty() and not Data.yard_where("hold_fire").is_empty() and not Data.yard_where("fetch").is_empty(), "a work's rule is not a pick")
	# the generator: a second row of pouches, never past the cap
	var hold_rig = sim.equipped["Rig"]
	var big: Dictionary = sim._plain("Rig", Data.BASES["Rig"].back()["name"])
	big["affixes"] = [{"stat": "med_cap", "value": 3, "tier": 5}]
	sim.equipped["Rig"] = big
	_yard_set(sim, "generator", 0, "a")
	_yard_set(sim, "generator", 2, "")
	var before: int = sim.med_capacity()
	_yard_set(sim, "generator", 2, "a")
	_check(before > 0 and sim.med_capacity() == mini(before + Data.RIG_ROW, Data.RIG_CAP) and sim.med_capacity() > before, "the Battery's row reads %d from %d" % [sim.med_capacity(), before])
	_yard_set(sim, "generator", 0, "b")
	_check(sim.med_capacity() == mini(before + Data.RIG_ROW + 4, Data.RIG_CAP), "Rig wiring's pouches are off: %d" % sim.med_capacity())
	# past the cap it clips, and the run's rig and the Lock-up's rig hold the cap: the run's two rows in the one row's height
	sim.rig = []
	var pouches: int = sim.med_capacity()
	var two: Dictionary = {}
	for b in Data.BASES[Data.MEDICAL]:
		if Items.size(sim._plain(Data.MEDICAL, b["name"])) == 2:
			two = b
	while sim.rig_used() < pouches:
		var kit: Dictionary = sim._plain(Data.MEDICAL, two["name"]) if (not two.is_empty() and sim.rig_used() + 2 <= pouches and sim.rig.size() % 3 == 0) else sim._plain(Data.MEDICAL, Data.BASES[Data.MEDICAL][0]["name"])
		sim.rig.append(kit)
	_check(main._run.RIG_MAX >= Data.RIG_CAP and main._armoury._containers.RIG_MAX >= Data.RIG_CAP, "a rig display clips under the sim's cap")
	sim.deploy(3)
	main.show_room(main.MISSIONS)
	main.refresh()
	var right_edge := 0.0
	var bottom := 0.0
	for c in main._run._rig_cells:
		if c.visible:
			right_edge = maxf(right_edge, c.position.x + c.size.x)
			bottom = maxf(bottom, c.position.y + c.size.y)
	_check(right_edge <= main._run.PAD + main._run.INNER + 0.5 and bottom <= main._run.RIG_Y + main._run.RIG_ROOM + 0.5, "the run's rig of %d spills: to x %.0f, y %.0f" % [pouches, right_edge, bottom])
	var cells_on := 0
	var outlines_on := 0
	for c in main._run._rig_cells:
		if c.visible:
			cells_on += 1
	for o in main._run._rig_outlines:
		if o.visible:
			outlines_on += 1
	_check(cells_on == sim.rig.size() and outlines_on == 0, "a full rig of kits and meds shows %d of %d items and %d free pouches" % [cells_on, sim.rig.size(), outlines_on])
	_check_fit(main, "Run (a full rig)")
	# a kit at a row's end (12 Oct, Matt's playtest): singles to one short of the row, the kit, singles to full - every
	# item shows and no pouch reads empty
	if not two.is_empty():
		var per_row: int = maxi(1, ceili(float(mini(main._run.RIG_MAX, pouches)) / (1 if pouches <= 12 else 2)))
		sim.rig = []
		for i in range(per_row - 1):
			sim.rig.append(sim._plain(Data.MEDICAL, Data.BASES[Data.MEDICAL][0]["name"]))
		sim.rig.append(sim._plain(Data.MEDICAL, two["name"]))
		while sim.rig_used() < pouches:
			sim.rig.append(sim._plain(Data.MEDICAL, Data.BASES[Data.MEDICAL][0]["name"]))
		main.refresh()
		cells_on = 0
		outlines_on = 0
		for c in main._run._rig_cells:
			if c.visible:
				cells_on += 1
		for o in main._run._rig_outlines:
			if o.visible:
				outlines_on += 1
		_check(cells_on == sim.rig.size() and outlines_on == 0, "a kit at the row's end: %d of %d items show, %d pouches read empty" % [cells_on, sim.rig.size(), outlines_on])
	sim.extract_now()
	main.show_room(main.ARMOURY)
	main.refresh()
	_check_fit(main, "Lock-up (a full rig)")
	sim.rig = []
	sim.equipped["Rig"] = hold_rig
	# the lookout: the first gang after the clear waits for a full pack; a second gang does not
	_yard_set(sim, "lookout", 2, "a")
	sim.deploy(3)
	var m: Dictionary = sim.mission
	m["remaining"] = 0
	m["cleared"] = true
	m["found"] = []
	m["patrol_timer"] = 0.0
	sim.advance(5.0)
	_check(sim.on_mission() and m["patrols"] == 0 and m["patrol_timer"] == 0.0, "the first gang's clock ran before the call: %.1f" % m["patrol_timer"])
	main.show_room(main.MISSIONS)
	main.refresh()
	_check(main._run._fight["tiles"][0]["value"].text in ["held off", "held"], "the Next gang tile does not say on the call: '%s'" % main._run._fight["tiles"][0]["value"].text)
	_check_fit(main, "Run (on the call)")
	while sim.pack_used(m) < sim.capacity():
		m["found"].append(sim._plain(Data.AMMO, "Nails"))
	sim.advance(5.0)
	_check(m["patrol_timer"] > 0.0 or m["patrols"] >= 1, "the full pack did not call the first gang")
	m["patrols"] = 1
	m["found"] = []
	m["patrol_timer"] = 0.0
	sim.advance(5.0)
	_check(m["patrol_timer"] > 0.0 or m["patrols"] >= 2, "the second gang waited for the call too")
	sim.extract_now()
	# the kennel: the best thing in the pack comes home with the dog on a death
	_yard_set(sim, "kennel", 2, "a")
	sim.deploy(3)
	m = sim.mission
	var cheap: Dictionary = sim._plain(Data.AMMO, "Nails")
	var dear: Dictionary = sim._plain("Armour", Data.BASES["Armour"].back()["name"])
	m["found"] = [cheap, dear]
	var stash_before: int = sim.stash.size()
	sim.hp = 0.0
	sim._kia()
	_check(sim.stash.size() == stash_before + 1 and sim.stash.back()["id"] == dear["id"] and sim.last_report.get("carried", "") != "" and int(sim.last_report["left"]) == 1, "the dog did not carry the best thing home")
	# the deeds carried home are held all the same
	sim.load_dict(saved)
	_yard_set(sim, "kennel", 2, "a")
	var hold_ending: String = sim.deeds_fate
	sim.deeds_fate = ""
	sim.deploy(3)
	m = sim.mission
	var deeds: Dictionary = sim._plain(Data.PAPER, "The deeds")
	deeds["deeds"] = true
	m["found"] = [deeds]
	sim.hp = 0.0
	sim._kia()
	_check(sim.deeds_fate == "held" and sim.stash.back().get("deeds", false), "the deeds carried home were not held: '%s'" % sim.deeds_fate)
	sim.deeds_fate = hold_ending
	# the works card reads the rules and fits
	main.show_room(main.OVERVIEW)
	main.refresh()
	_check_fit(main, "Yard (the works' top levels)")
	sim.load_dict(saved)
	main.refresh()
	print("the works' rules ok: the Battery's row, Hold fire, Fetch")


## What's on them and on you as chips (Matt, 6 Oct): "On them" under their bar, "On you" in place of the runner's note.
func _dots_chip_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.deploy(3)
	var m: Dictionary = sim.mission
	m["remaining"] = 3
	m["target_hp"] = 1e9
	m["dots"] = {"fire": 20.0, "poison": 20.0}
	m["chill_t"] = 1.0
	m["shock_t"] = 1.0
	m["my_dots"] = {"poison": 20.0, "bleed": 20.0}
	main.show_room(main.MISSIONS)
	main.refresh()
	var rn = main._run
	_check(rn._fight["chips"].visible and rn._fight["chips"].shown() == 4 and rn._fight["chips"].words(0) == "Burning" and rn._fight["chips"].words(2) == "Chilled" and rn._fight["chips"].words(3) == "Shocked", "On them reads %d chips: %s" % [rn._fight["chips"].shown(), rn._fight["chips"].words(0)])
	_check(rn._runner["chips"].visible and not rn._runner["note"].visible and rn._runner["chips"].shown() == 2 and rn._runner["chips"].words(0) == "Poisoned" and rn._runner["chips"].words(1) == "Bleeding", "On you reads %d chips" % rn._runner["chips"].shown())
	_check(rn._fight["chips"].position.y + Chips.CHIP_H <= rn._fight["box"].position.y + rn._fight["box"].size.y and rn._runner["chips"].position.y + Chips.CHIP_H <= rn._runner["box"].position.y + rn._runner["box"].size.y, "the chips sit out of their boxes")
	_check_fit(main, "Run (on them, on you)")
	# the dots' pools are the end of the bar (Matt, 6 Oct): what fire and poison still have to take off them sits at the
	# fill's end in their colours, so the fill goes down into it; yours the same for what's on you
	var of_hp: float = float(m["t"]["hp"])
	m["target_hp"] = of_hp * 0.5
	m["dots"] = {"fire": of_hp * 0.1, "poison": of_hp * 0.2}
	m["my_dots"] = {"poison": sim.max_hp() * 0.1, "bleed": sim.max_hp() * 0.6}
	sim.hp = sim.max_hp() * 0.5
	main.refresh()
	var segs: Array = rn._fight["segments"]
	var fire_i: int = Data.TYPES.find("fire")
	var poison_i: int = Data.TYPES.find("poison")
	var bleed_i: int = Data.TYPES.find("bleed")
	var fill_px: float = rn._fight["fill"].size.x
	_check(segs[fire_i].visible and segs[poison_i].visible and absf(segs[fire_i].size.x - float(rn._fight["w"]) * 0.1) <= 1.5 and absf(segs[poison_i].size.x - float(rn._fight["w"]) * 0.2) <= 1.5, "their bar's end is not the dots' pools: fire %.0f, poison %.0f" % [segs[fire_i].size.x, segs[poison_i].size.x])
	_check(absf(segs[fire_i].position.x + segs[fire_i].size.x - fill_px) <= 0.5 and absf(segs[poison_i].position.x + segs[poison_i].size.x - segs[fire_i].position.x) <= 0.5, "the pools do not sit at the fill's end, in a row")
	var ysegs: Array = rn._runner["segments"]
	var yfill: float = rn._runner["fill"].size.x
	_check(ysegs[poison_i].visible and ysegs[bleed_i].visible and absf(ysegs[poison_i].size.x - float(rn._runner["w"]) * 0.1) <= 1.5 and absf(ysegs[bleed_i].size.x - (yfill - ysegs[poison_i].size.x)) <= 1.5 and ysegs[bleed_i].position.x >= -0.5, "a pool past the fill's left end is not cut to it: poison %.0f, bleed %.0f of a %.0f fill" % [ysegs[poison_i].size.x, ysegs[bleed_i].size.x, yfill])
	m["dots"] = {}
	m["my_dots"] = {}
	main.refresh()
	_check(not segs[fire_i].visible and not ysegs[bleed_i].visible, "the pools did not clear with the dots")
	m["dots"] = {"fire": 20.0, "poison": 20.0}
	m["my_dots"] = {"poison": 20.0, "bleed": 20.0}
	main.refresh()
	# a med in use rides beside the chips as a muted one; nothing on you brings the note back
	m["using"] = {"name": "Bandage", "heal": 10.0, "left": 4.0}      # a med in use, by hand: the chip beside what's on you
	main.refresh()
	_check(rn._runner["chips"].shown() == 3 and rn._runner["chips"].words(2).contains(" s"), "the med in use is not a chip beside what's on you: %d" % rn._runner["chips"].shown())
	_check_fit(main, "Run (on you, med)")
	m["my_dots"] = {}
	main.refresh()
	_check(rn._runner["chips"].visible and rn._runner["chips"].shown() == 1 and not rn._runner["note"].visible, "the med in use alone is not a chip: %d" % rn._runner["chips"].shown())
	m["my_dots"] = {"poison": 20.0, "bleed": 20.0}
	m["using"] = null
	# no one left to be on: the row goes even with dots in the record
	m["remaining"] = 0
	main.refresh()
	_check(not rn._fight["chips"].visible, "On them shows with no one there")
	m["remaining"] = 3
	m["my_dots"] = {}
	m["dots"] = {}
	m["chill_t"] = 0.0
	m["shock_t"] = 0.0
	main.refresh()
	_check(not rn._fight["chips"].visible and not rn._fight["key"].visible and not rn._runner["note"].visible and not rn._runner["chips"].visible, "the chips did not clear with nothing on anyone (the line is the chips' alone)")
	_check_fit(main, "Run (nothing on anyone)")
	sim.extract_now()
	sim.load_dict(saved)
	main.refresh()
	print("the dots as chips ok: on them, on you, the med beside them, cleared")


## 30: wounds (stacked, 19 Oct: Matt's Clinic A). A hit that takes the runner under a third leaves a wound, one a run, to
## an area not yet hurt - the head's cuts the max HP, the chest's the armour, the legs' the pace - three at most, a
## fourth bad run adding nothing; the Clinic treats each, or the lot; the run, the Pitch and the Clinic say so; the
## save keeps them; they go with the runner.
func _wound_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.wounds = {}
	# the hit under a third wounds; one already under it does not
	sim.deploy(3)
	var m: Dictionary = sim.mission
	var pace0: float = sim.pace()          # on the mission: armour counts the pack's free cells
	var arm0: float = sim.armour()
	var hp0: float = sim.max_hp()
	m["remaining"] = 6
	m["target_hp"] = 1e9
	sim.hp = sim.max_hp() * Data.WOUND_AT - 0.01
	sim.advance(1.0)
	_check(sim.wounds.is_empty(), "a hit already under the third wounded")
	_check(sim.on_mission(), "the runner died under the first wound check")
	if not sim.on_mission():
		sim.load_dict(saved)
		return
	# through the fight itself: a hair over, their fire takes the runner under it
	sim.hp = sim.max_hp() * Data.WOUND_AT + 0.01
	var hp_in: float = sim.hp
	sim.advance(1.0)
	var through_the_fight: bool = sim.hp < hp_in and sim.hp > 0.0
	if through_the_fight:
		_check(sim.wounds.size() == 1 and m.get("wounded", false), "the hit under a third did not wound: %s" % str(sim.wounds))
	else:
		sim._wound(m)                     # nothing landed at this tier (or it killed them): the wound by hand, the rest still checked
	_check(sim.on_mission(), "the runner died under the wound check")
	if not sim.on_mission():
		sim.load_dict(saved)
		return
	var area: String = sim.wounds.keys()[0]
	var cut: String = str(sim.wounds[area]["stat"])
	_check(cut == str(Data.WOUND_AREA[area]["stat"]) and str(sim.wounds[area]["from"]) == str(Data.TIERS[3]["name"]) and str(sim.wounds[area]["what"]) != "", "the wound's record is off: %s" % str(sim.wounds[area]))
	var now: Dictionary = {"pace": sim.pace(), "armour": sim.armour(), "hp": sim.max_hp()}
	var was: Dictionary = {"pace": pace0, "armour": arm0, "hp": hp0}
	for st in Data.WOUND_STATS:
		if st == cut:
			_check(is_equal_approx(now[st], was[st] * (1.0 - Data.WOUND_PCT / 100.0)), "the wound did not cut %s: %.2f from %.2f" % [st, now[st], was[st]])
		else:
			_check(is_equal_approx(now[st], was[st]), "the wound cut %s too: %.2f from %.2f" % [st, now[st], was[st]])
	# one a run: the same run takes no second
	sim._wound(m)
	_check(sim.wounds.size() == 1, "a run left two wounds: %s" % str(sim.wounds))
	# the run says so and fits
	main.show_room(main.MISSIONS)
	main.refresh()
	_check(main._run._runner["head"].text.begins_with("THE RUNNER · WOUNDED:"), "the run's runner head does not say wounded: '%s'" % main._run._runner["head"].text)
	_check_fit(main, "Run (wounded)")
	sim.extract_now()
	_check(sim.last_report.get("wounded", false), "the report does not carry the wound")
	# stacking: three runs, three areas, every stat a tenth; a fourth adds nothing and says so
	for k in range(3):
		sim._wound({"wounded": false, "tier": 5})
	_check(sim.wounds.size() == 3 and Data.WOUND_AREAS.all(func(a): return sim.wounds.has(a)), "three bad runs didn't leave the three areas: %s" % str(sim.wounds.keys()))
	_check(str(sim.events.back()[1]) == Words.WOUNDS["full"], "the fourth didn't say there's nowhere left: '%s'" % str(sim.events.back()[1]))
	for st in Data.WOUND_STATS:
		_check(is_equal_approx(sim.wound_mult(st), 1.0 - Data.WOUND_PCT / 100.0), "three wounds don't cut %s a tenth: %.3f" % [st, sim.wound_mult(st)])
	_check(sim.wound_words().begins_with("3 wounds:"), "three wounds in words: '%s'" % sim.wound_words())
	# the Runner room's card says so
	main.show_room(main.RUNNER)
	main.refresh()
	var wound_chips: Array = _chip_texts(main._stats.cards["runner"]["chips"])
	_check(not wound_chips.is_empty() and str(wound_chips[0]).begins_with("3 wounds:"), "the sheet does not carry the wounds chip: %s" % str(wound_chips))
	_check_fit(main, "Stats (wounded)")
	# the Clinic: a row a wound with its Treat, the body marked, Treat everything the lot
	sim.hp = sim.max_hp() * 0.5
	sim.cash += 50000.0
	var lv: int = sim.level()
	var each: int = int(ceil(Data.WOUND_CASH * lv * sim.inflation() * maxf(0.2, 1.0 - sim.tree_sum("treat_pct") / 100.0)))
	_check(sim.wound_cost("legs") == each and sim.wound_cost() == 3 * each and sim.treat_cost() == sim.heal_cost() + 3 * each, "the wounds' prices: one %d (want %d), all %d, with the HP %d" % [sim.wound_cost("legs"), each, sim.wound_cost(), sim.treat_cost()])
	main.show_room(main.MEDIC)
	main._clinic._shown = ""
	main.refresh()
	var body = main._clinic._body
	_check(main._clinic._band.unit.text.contains("3 wounds") and main._clinic._band.chips.visible, "the Clinic's band does not say 3 wounds: '%s'" % main._clinic._band.unit.text)
	_check(body._head.text == "THE RUNNER · 3 OF 3 WOUNDS" and body._marks.size() == 3, "the body's head or its marks: '%s', %d" % [body._head.text, body._marks.size()])
	for a in Data.WOUND_AREAS:
		var r: Dictionary = body.row(a)
		_check(r["treat"].visible and not r["treat"].disabled and r["treat"].text.begins_with("Treat") and r["effect"].text.begins_with("−"), "the %s's row is off: '%s' / '%s'" % [a, r["treat"].text, r["effect"].text])
	_check(body._all.text.begins_with("Treat everything") and not body._all.disabled, "Treat everything reads '%s'" % body._all.text)
	_check_fit(main, "Clinic (three wounds)")
	# the runner's own drawing, the Kit's (19 Oct, Matt): every wound's mark on it, inside the box
	var BodyV := preload("res://scripts/ui/body.gd")
	var want_fig: String = BodyV.figure_for(str(sim.cls))
	_check((body._figure.texture != null) == (want_fig != ""), "the Clinic's figure is %s with %s for a %s" % [str(body._figure.texture), want_fig, sim.cls])
	var fr: Rect2 = body.figure_rect()
	for a in Data.WOUND_AREAS:
		var at: Vector2 = body.mark_at(a)
		_check(fr.grow(1.0).has_point(at) and Rect2(Vector2.ZERO, Vector2(body.BODY_W, body.BODY_H)).encloses(fr.grow(-0.5)), "the %s's mark sits off the figure: %s in %s" % [a, str(at), str(fr)])
	var hy: float = body.mark_at("head").y
	_check(hy < body.mark_at("chest").y and body.mark_at("chest").y < body.mark_at("legs").y, "the marks are out of order down the body")
	# one treated by its row: that one gone, the rest kept, its price paid
	var cash0: float = sim.cash
	body.row("chest")["treat"].pressed.emit()
	main.refresh()
	_check(not sim.wounds.has("chest") and sim.wounds.size() == 2 and is_equal_approx(cash0 - sim.cash, float(each)), "the chest's Treat: %s left, %.0f paid" % [str(sim.wounds.keys()), cash0 - sim.cash])
	_check(not body.row("chest")["treat"].visible and body.row("chest")["empty"].text == "Chest · nothing", "the chest's row after: '%s'" % body.row("chest")["empty"].text)
	_check_fit(main, "Clinic (two wounds)")
	# the lot: the HP and both wounds
	cash0 = sim.cash
	var lot: int = sim.treat_cost()
	body._all.pressed.emit()
	main.refresh()
	_check(sim.wounds.is_empty() and sim.hp >= sim.max_hp() - 0.5 and is_equal_approx(cash0 - sim.cash, float(lot)), "Treat everything left %s, HP %.0f of %.0f, %.0f paid of %d" % [str(sim.wounds.keys()), sim.hp, sim.max_hp(), cash0 - sim.cash, lot])
	_check(body._all.text == "Fit for duty" and body._all.disabled, "after the lot the button reads '%s'" % body._all.text)
	# one wound at full HP: the button names it
	sim._wound({"wounded": false, "tier": 5})
	main.refresh()
	var one: String = sim.wounds.keys()[0]
	_check(body._all.text.begins_with("Treat the %s" % str(Data.WOUND_AREA[one]["name"]).to_lower()), "one wound at full HP: the button reads '%s'" % body._all.text)
	_check_fit(main, "Clinic (one wound)")
	# saved and loaded; gone with a dead runner
	var d: Dictionary = sim.to_dict()
	_check(d.get("wounds", {}).has(one), "the wounds are not saved")
	sim.load_dict(d)
	_check(sim.wounds.has(one) and str(sim.wounds[one]["what"]) != "", "the wounds are not loaded: %s" % str(sim.wounds))
	sim.deploy(3)
	sim.hp = 0.0
	sim._kia()
	_check(sim.wounds.is_empty(), "the wounds went on to the next runner")
	sim.load_dict(saved)
	main.refresh()
	print("wounds ok: the hit under a third, one a run, three areas at most, every stat a tenth, the run, the Pitch, the Clinic's rows and its lot, the save, the death")


## Meds as they say (19 Oct, Matt): a share of the heal every second over the med's time, stopping at full; the meds'
## cards in the Clinic say what each does.
func _med_over_time_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var s = Sim.new()
	s.start()
	s.mythics_on = false
	var bandage: Dictionary = s._plain(Data.MEDICAL, "Bandage")
	s.deploy(0)
	if not s.on_mission():
		_check(false, "the fixture: no run for the meds")
		return
	var mm: Dictionary = s.mission
	mm["t"]["dps"] = 0.0
	mm["remaining"] = 0
	s.rig = [bandage]
	s.hp = 10.0
	var t: float = s.use_time(bandage)
	var heal: float = s.med_heal(bandage)
	_check(t > 1.0 and heal > 0.0, "the fixture: the bandage takes %.1f s for %.0f" % [t, heal])
	s.use_med(bandage["id"])
	s._patch(mm, 1.0)
	_check(is_equal_approx(s.hp, 10.0 + heal / t) and mm["using"] != null, "a second in, a med healed %.1f, not %.1f (its share)" % [s.hp - 10.0, heal / t])
	s._patch(mm, t)
	_check(is_equal_approx(s.hp, minf(s.max_hp(), 10.0 + heal)) and mm["using"] == null, "the med's whole didn't land by its time: %.1f of %.1f" % [s.hp - 10.0, heal])
	# at full with nowhere for it to go, a med isn't taken (its end-of-heal work isn't free)
	s.rig = [s._plain(Data.MEDICAL, "Bandage")]
	s.hp = s.max_hp()
	var g0: float = s.guard()
	_check(not s.use_med(s.rig[0]["id"]) and s.rig.size() == 1 and mm["using"] == null and is_equal_approx(s.guard(), g0), "a med went at full HP: rig %d, using %s" % [s.rig.size(), str(mm["using"])])
	# stops at full: nearly full, it ends as the HP tops out
	s.rig = [s._plain(Data.MEDICAL, "Bandage")]
	s.hp = s.max_hp() - 1.0
	s.use_med(s.rig[0]["id"])
	s._patch(mm, t * 0.5)
	_check(s.hp >= s.max_hp() - 0.001 and mm["using"] == null and str(s.events.back()[1]).contains("stopped at full"), "a med didn't stop at full: '%s'" % str(s.events.back()[1]))
	# the Clinic's cards: what each does, a second's, where it is
	main.show_room(main.MEDIC)
	sim.stash.append(sim._plain(Data.MEDICAL, "Bandage"))
	main._clinic._show("stash")
	main.refresh()
	var mc = main._clinic._meds
	_check(mc.visible and not main._clinic._panel.visible, "the Meds tab didn't show its cards")
	var said: String = " | ".join(mc.text_nodes().map(func(l): return str(l.text)))
	var b0: Dictionary = sim._plain(Data.MEDICAL, "Bandage")
	var lines: Array = mc.med_lines(b0)
	_check(said.contains("Bandage") and said.contains(lines[0]) and said.contains(lines[1]) and said.contains("in the stash"), "the bandage's card: %s (want '%s', '%s')" % [said.left(300), lines[0], lines[1]])
	_check_fit(main, "Clinic (meds as cards)")
	main._clinic._show("shelf")
	sim.load_dict(saved)
	main.refresh()
	print("meds over time ok: a share a second, the whole by its time, stops at full, the cards")


## The effects' numbers in one table (15 Oct, refactor A2): every Data.FX key names something the data has (a tree
## node's effect, a unique's or a set's rule, a joint, a Yard pick or building, a map node), and the sim reads every
## key - a figure moved into the table and orphaned, or a table row for a node since cut, says so here.
func _fx_checks() -> void:
	var have := {"node": {}, "rule": {}, "set": {}, "joint": {}, "yard": {}, "yard_rank": {}, "atlas": {}}
	for t in Data.TREES + Data.ELEMENT_TREES:
		for nd in t["nodes"]:
			if nd.has("effect"):
				have["node"][str(nd["effect"])] = true
	for u in Data.UNIQUES + Data.ISSUED:
		if u.has("rule"):
			have["rule"][str(u["rule"])] = true
	for st in Data.SETS:
		for n in st["bonuses"]:
			if st["bonuses"][n].has("rule"):
				have["set"][str(st["bonuses"][n]["rule"])] = true
	for j in Data.JOINTS:
		have["joint"][str(j["key"])] = true
	for b in Data.YARD:
		have["yard_rank"][str(b["key"])] = true
		for col in b["picks"]:
			for pk in col:
				have["yard"][str(pk["id"])] = true
	for a in Data.ATLAS:
		have["atlas"][str(a["key"])] = true
	var src := FileAccess.get_file_as_string("res://scripts/sim/sim.gd")
	var bad: Array = []
	for k in Data.FX:
		var kind: String = str(k).get_slice("/", 0)
		var id: String = str(k).get_slice("/", 1).get_slice(".", 0)
		if not have.has(kind) or not have[kind].has(id):
			bad.append("%s (no %s called %s)" % [k, kind, id])
		elif not src.contains('Data.FX["%s"]' % k):
			bad.append("%s (the sim never reads it)" % k)
	_check(bad.is_empty(), "the effects' table is off: %s" % ", ".join(bad))
	_check(Data.FX.size() >= 160, "the effects' table has shrunk to %d rows" % Data.FX.size())
	print("the effects' table ok: %d rows, every one the data's and read by the sim" % Data.FX.size())


## The next gang's clock (14 Oct, Matt: "no search time before the next gang shows up which just compounds"): it runs
## only while the site's quiet - held while a gang's on you, so the next can't land on the last and every gang beaten
## gives the search its window back.
func _gang_pause_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.deploy(3)
	var m: Dictionary = sim.mission
	m["remaining"] = 0
	m["cleared"] = true
	m["event_at"] = -1.0
	m["leave_full"] = false
	sim._clear(m, m["t"])
	var due: float = sim.patrol_s(m["t"], m["patrols"] == 0)
	m["patrol_timer"] = due - 3.0
	m["remaining"] = 40                          # a gang too big to beat in the time
	m["target_hp"] = float(m["t"]["hp"])
	var patrols0: int = m["patrols"]
	for k in range(10):
		sim.hp = sim.max_hp()
		sim.advance(0.5)
	_check(sim.on_mission() and m["patrols"] == patrols0 and is_equal_approx(float(m["patrol_timer"]), due - 3.0), "the next gang's clock ran while one was on you: %.1f of %.1f, gangs %d from %d" % [float(m["patrol_timer"]), due, m["patrols"], patrols0])
	m["remaining"] = 0
	sim.advance(1.0)
	_check(sim.on_mission() and float(m["patrol_timer"]) > due - 3.0, "the next gang's clock did not run on once it was quiet: %.1f" % float(m["patrol_timer"]))
	sim.extract_now()
	sim.load_dict(saved)
	main.refresh()
	print("the gangs' clock ok: held while one's on you, on again when it's quiet")


## Gear gated by level (15 Oct, signals_kit.png): a piece over the runner's level stays in the stash, greyed under a
## padlock with its level; Equip waits ("Equip at 25"), Equip if better and the arrow pass it over, the junk rules keep
## it; at the level it goes on. And a save from before the update isn't loaded: its slot says so.
func _gear_gate_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.xp = Data.xp_for_level(15)
	var bases: Array = Data.BASES["Primary"]
	var big: Dictionary = sim._plain("Primary", bases[bases.size() - 1]["name"])
	big["ilvl"] = 9
	var W: int = Items.wear_level(big)          # the Quartermaster's item level's: 16 at 2 x - 2 (19 Oct; 21 at x2.5 - 1.5)
	_check(W == int(round(9 * Data.WEAR_PER_ILVL - Data.WEAR_OFFSET)) and W > 15 and Items.wear_level(sim._plain("Primary", bases[0]["name"])) == 1, "the levels to wear read %d and %d, not the item level's and 1" % [Items.wear_level(big), Items.wear_level(sim._plain("Primary", bases[0]["name"]))])
	_check(Items.wear_level({"slot": Data.MEDICAL, "base": "x", "tier": 6, "ilvl": 9}) == 1, "a med carries a level to wear")
	# past WEAR_FLAT a find's wear is its own level (21 Oct, the crew's read): a level-43 runner wears a level-43 find
	var wears: Array = [Items.wear_for(9), Items.wear_for(12), Items.wear_for(16), Items.wear_for(17), Items.wear_for(43), Items.wear_for(80)]
	_check(wears == [16, 16, 16, 17, 43, Data.MAX_LEVEL] and Items.max_ilvl_for(43) == 43 and Items.max_ilvl_for(15) == 8 and Items.max_ilvl_for(Data.MAX_LEVEL) > 1000, "the wear by item level reads %s; the deepest worn at 43 %d, at 15 %d" % [str(wears), Items.max_ilvl_for(43), Items.max_ilvl_for(15)])
	for lv in range(1, Data.MAX_LEVEL):
		if Items.wear_for(Items.max_ilvl_for(lv)) > lv or Items.wear_for(Items.max_ilvl_for(lv) + 1) <= lv:
			_check(false, "the deepest find a level-%d runner wears is off: %d" % [lv, Items.max_ilvl_for(lv)])
			break
	sim.equipped["Primary"] = sim._plain("Primary", bases[0]["name"])
	sim.stash_put(big)
	_check(sim.wear_lock(big) == W and not sim.can_wear(big) and not sim.can_equip_item(big["id"]) and not sim.equip_item(big["id"]), "a level 25 gun goes on a level 15 runner")
	_check(not sim.equip_best("Primary") or sim.equipped["Primary"]["id"] != big["id"], "Equip if better put on a gun over the runner's level")
	_check(not sim.is_upgrade(big), "a gun over the runner's level carries the arrow")
	sim.junk_upto = Data.RARITIES.size() - 1
	_check(sim.compare(big) != 1 or not sim.is_junk(big), "the junk rules would sell an upgrade waiting for its level")
	sim.junk_upto = -1
	main.show_room(main.ARMOURY)
	main._armoury.selected = {"kind": "stash", "id": big["id"]}
	main.refresh()
	var cell = main._armoury._inv.cell_node(main._armoury._inv.cell_of(big["id"]))
	_check(cell != null and cell._lock.visible and cell._lock.text == str(W) and not cell._up.visible and is_equal_approx(cell._art.modulate.a if cell._art.visible else cell._lines[0].modulate.a, cell.LOCKED_FADE), "the locked gun's cell has no padlock, its level or its grey")
	if cell != null:
		var cr := Rect2(Vector2.ZERO, cell.size)
		_check(cr.encloses(Rect2(cell._lock.position, cell._lock.size)), "the padlock leaves its cell: %s in %s" % [str(Rect2(cell._lock.position, cell._lock.size)), str(cr)])
	var pick = main._armoury._pick
	_check(pick._verdict.text == "Level %d to wear" % W, "the locked gun's verdict reads '%s'" % pick._verdict.text)
	_check(pick._buttons[0].text == "Equip at level %d" % W and pick._buttons[0].disabled, "the locked gun's button reads '%s', %s" % [pick._buttons[0].text, "off" if pick._buttons[0].disabled else "on"])
	_check(not pick.hint_text().begins_with("Level"), "the locked gun says its level twice, the verdict and the hint: '%s'" % pick.hint_text())     # said once (the review)
	_check_fit(main, "the kit with a locked gun")
	# the Fence's shelf: a piece over the level reads its level, never "Better" (the review)
	var shelf_gun: Dictionary = big.duplicate(true)
	shelf_gun["id"] = Items._next_id
	Items._next_id += 1
	sim.market.push_front(shelf_gun)
	main.show_room(main.MARKET)
	main._fence._show("shelf")
	main.refresh()
	main._fence.selected = {"kind": "shelf", "id": shelf_gun["id"]}
	main.refresh()
	_check(main._fence._verdict.visible and main._fence._verdict.text == "Level %d to wear" % W, "a locked gun on the shelf reads '%s'" % main._fence._verdict.text)
	# the shelf's compare is the Kit's (20 Oct, Matt): the worn gun as its own card beside the pick, the verdict and deltas on the foot
	var worn_g = sim.equipped["Primary"]
	_check(worn_g != null and main._fence._fit_head.visible and main._fence._fit_head.text_nodes().any(func(l): return str(l.text) == str(worn_g["base"]) or str(l.text) == Items.full_name(worn_g)) and not main._fence._right_title.visible,
		"the shelf's compare isn't the Kit's: the worn card %s, the old title %s" % [str(main._fence._fit_head.visible), str(main._fence._right_title.visible)])
	_check_fit(main, "the Fence's shelf, a gun against the worn one")
	sim.market.erase(shelf_gun)
	main.show_room(main.ARMOURY)
	main._armoury.selected = {"kind": "stash", "id": big["id"]}
	main.refresh()
	sim.xp = Data.xp_for_level(W)
	main.refresh()
	cell = main._armoury._inv.cell_node(main._armoury._inv.cell_of(big["id"]))
	_check(sim.can_equip_item(big["id"]) and cell != null and not cell._lock.visible and pick._buttons[0].text == "Equip", "at level 25 the gun is still locked")
	_check(sim.equip_item(big["id"]) and sim.equipped["Primary"]["id"] == big["id"], "at level 25 the gun doesn't go on")
	# a save from before the update: not loaded, and its slot says so
	var old := SMOKE_SLOT % 3
	var f := FileAccess.open(old, FileAccess.WRITE)
	f.store_string(JSON.stringify({"version": main.SAVE_VERSION - 1, "saved": 0.0, "sim": sim.to_dict()}))
	f.close()
	_check(main._save_words(old) == main.OLD_SAVE, "an old save's slot reads '%s'" % main._save_words(old))
	var was = main.sim
	main.load_game(old)
	main.sim.mythics_on = false            # the smoke's camps find no mythics on their own (17 Oct: a full pack keeps one now - a bot's Bomb Disposal Suit stopped the clock, its moment held the game); the mythics' own checks make theirs
	_check(main.sim == was, "an old save was loaded")
	DirAccess.remove_absolute(old)
	sim.load_dict(saved)
	main.show_room(main.OVERVIEW)
	main.refresh()
	print("gear gated by level ok: the padlock and its level, Equip at, the arrow and Equip if better pass it, at the level it goes on; an old save refused")


## Signals (15 Oct, endgame_radio.md, signals_radio.png): three papers decrypt into a held signal - a campaign site, a
## crew from any zone, a depth in the reach's band (one deeper with a rare paper), each paper's code; the papers
## spent; three held at most. Read, the site carries it and goes back; run, it's gone from the Radio, the site carries
## it for the run and goes back after; beaten at the reach it raises the reach and pays a point on the Dial; lost, the
## reach stays. The Map has no depth's −/+. The Radio's three columns, their words in their boxes.
func _signal_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	if not ("radio" in sim.unlocked):
		sim.unlocked.append("radio")
	_finish_campaign(sim)
	_check(sim.campaign_done(), "the signals' area wants the campaign done")
	sim.signals = []
	sim.reach = Data.REACH_START
	sim.papers = []                           # the Radio's pile (18 Oct): empty for the fixture
	var bases: Array = []
	for p in Words.PAPERS:
		if p.has("code") and sim.word_taught_by(str(p["name"])) != "" and bases.size() < 6:
			bases.append(str(p["name"]))
	for b in bases:
		sim.stash_put(sim._plain(Data.PAPER, b))
	var ps: Array = sim.signal_papers()
	_check(ps.size() == 6 and not sim.stash.any(func(x): return Sim.is_pile_paper(x)), "six papers put in the stash, %d on the Radio's pile, or some left in the stash" % ps.size())
	var ids: Array = ps.slice(0, 3).map(func(x): return int(x["id"]))
	_check(sim.decrypt_block([]) == sim.DECRYPT_NEEDS_PAPERS and sim.decrypt_block(ids.slice(0, 1)) == "" and sim.decrypt_block(ids.slice(0, 2)) == "" and sim.decrypt_block(ids) == ""
		and sim.decrypt_block(ps.slice(0, 4).map(func(x): return int(x["id"]))) != "",
		"the decoder's block (20 Oct: one to three): '%s' with none, '%s' one, '%s' two, '%s' three, '%s' four" % [sim.decrypt_block([]), sim.decrypt_block(ids.slice(0, 1)),
		sim.decrypt_block(ids.slice(0, 2)), sim.decrypt_block(ids), sim.decrypt_block(ps.slice(0, 4).map(func(x): return int(x["id"])))])
	# the crew to call (20 Oct): an area's for Kev's notes, none without them, any for nothing
	var notes_was: int = sim.notes
	sim.notes = 0
	_check(sim.decrypt_block(ids.slice(0, 1), 2) != "" and sim.decrypt_block(ids.slice(0, 1), -1) == "", "the crew pick with no notes: '%s'" % sim.decrypt_block(ids.slice(0, 1), 2))
	sim.notes = Data.AIM_NOTES + 5
	var aimed: Dictionary = sim.decrypt(ids.slice(0, 1), 2)
	_check(not aimed.is_empty() and int(aimed["zone"]) == 2 and sim.notes == 5, "a signal tuned to the Town's crew: %s, %d notes left" % [str(aimed.get("zone", -1)), sim.notes])
	if not aimed.is_empty():
		main.show_room(main.COMMS)
		main._radio._pick_view("air")
		main._radio.selected = sim.signals.size() - 1
		main._radio._shown = ""
		main.refresh()
		var chip_text: String = " ".join(main._radio._card_codes.text_nodes().map(func(l): return str(l.text)))
		_check(chip_text.contains("Brings") or chip_text.contains("a run"), "the signal card doesn't say what it brings: %s" % chip_text)
		_check(main._radio._crew_buttons.size() == 4 and main._radio._crew_buttons[0].text.begins_with("Any"), "the decoder's crew row: %s" % str(main._radio._crew_buttons.map(func(b): return b.text)))
		_check_fit(main, "the Radio, a signal's materials and the crew row")
		# the crew's odds on the card (21 Oct, Matt: "switch to your bleed paramedic and steam roll it"): a second class
		# played, its odds read for its own runner and the one out put back; the row says both, a press swaps
		var cls0: String = sim.cls
		var gun0 = sim.equipped["Primary"]
		var other: String = "Doorman" if cls0 != "Doorman" else "Poacher"
		_check(sim.set_class(other) and sim.set_class(cls0), "the crew fixture could not swap")
		var k_sel: int = main._radio.selected
		var od_o: Array = [0.0, false]
		for i in range(400):
			od_o = sim.signal_odds_class(k_sel, other)
			if bool(od_o[1]):
				break
		_check(bool(od_o[1]) and sim.cls == cls0 and is_same(sim.equipped["Primary"], gun0) and sim.roster.has(other) and not sim.roster.has(cls0), "a read of the %s's odds moved the runner: %s" % [other, sim.cls])
		for i in range(400):
			if bool(sim.signal_odds(k_sel)[1]):
				break
		_check(sim.roster[other]["rig"].size() == sim.crew_runner(other)["rig"].size() and sim.signal_odds_class(k_sel, other, true)[1], "a read of the %s's odds left their rig or its reading behind" % other)
		main._radio._shown = ""
		main.refresh()
		var crew_b: Array = main._radio._crew_btns.filter(func(t): return t["button"].visible)
		_check(crew_b.size() >= 2 and crew_b[0]["cls"] == cls0 and crew_b[0]["button"].disabled and crew_b.filter(func(t): return t["cls"] == other).size() == 1 and not crew_b.filter(func(t): return t["cls"] == other)[0]["button"].disabled and crew_b.filter(func(t): return t["cls"] == other)[0]["odds"].text.ends_with("%"), "the card's crew row: %s" % str(crew_b.map(func(t): return [t["cls"], t["odds"].text])))
		_check_fit(main, "the Radio, the crew's odds")
		# every class played: a button each, fitting (24 Oct: the Radio held five, the Recruit made six)
		_check(main._radio.CREW_MAX >= Data.CLASSES.size(), "the Radio's crew row holds %d of %d classes" % [main._radio.CREW_MAX, Data.CLASSES.size()])
		for cd_c in Data.CLASSES:
			sim.set_class(str(cd_c["name"]))
		sim.set_class(cls0)
		main._radio._shown = ""
		main.refresh()
		var crew_all: Array = main._radio._crew_btns.filter(func(t): return t["button"].visible)
		_check(sim.crew_played().size() == Data.CLASSES.size() and crew_all.size() == sim.crew_played().size(), "%d classes played, %d crew buttons" % [sim.crew_played().size(), crew_all.size()])
		_check_fit(main, "the Radio, every class in the crew")
		main._radio._on_crew(crew_b.find(crew_b.filter(func(t): return t["cls"] == other)[0]))
		_check(sim.cls == other and bool(sim.signal_odds_now(k_sel)[1]) and is_equal_approx(float(sim.signal_odds_now(k_sel)[0]), float(od_o[0])), "the crew's button did not swap to the %s with their odds read: %s" % [other, str(sim.signal_odds_now(k_sel))])
		sim.set_class(cls0)
		sim.signals.pop_back()
		for b in bases.slice(0, 1):
			sim.stash_put(sim._plain(Data.PAPER, b))
		ps = sim.signal_papers()
		ids = ps.slice(0, 3).map(func(x): return int(x["id"]))
	sim.notes = notes_was
	# the grades (20 Oct, Matt): one paper Faint, two Clear, three Full - each band, most codes and extras as agreed
	for g in range(3):
		var gb: Array = sim.signal_band(ids.slice(0, g + 1))
		var want: Array = [[-7, -2], [-5, 0], [-3, 1]][g]
		_check(int(gb[0]) == maxi(Data.REACH_START, sim.reach + int(want[0])) and int(gb[1]) == maxi(Data.REACH_START, sim.reach + int(want[1])) and int(Sim.signal_grade(g + 1)["codes"]) == g + 2
			and is_equal_approx(float(Sim.signal_grade(g + 1)["extras"]), [0.0, 0.5, 1.0][g]),
			"%d paper(s): band %s at reach %d, grade %s" % [g + 1, str(gb), sim.reach, str(Sim.signal_grade(g + 1))])
	var odds_sum := func(gd: Dictionary) -> float:
		var t := 0.0
		for row in gd["roll"]:
			t += float(row[1])
		return t
	for gd in Data.SIGNAL_GRADES:
		_check(is_equal_approx(odds_sum.call(gd), 1.0), "%s's roll odds sum to %.3f, not 1" % [gd["name"], odds_sum.call(gd)])
	var reach_was: int = sim.reach
	sim.reach = 20
	for n in range(6):
		var one: Dictionary = sim.decrypt(sim.signal_papers().slice(0, 1).map(func(x): return int(x["id"])))
		if one.is_empty():
			break
		_check(int(one.get("grade", 0)) == 1 and not bool(one["head"]) and not bool(one["convoy"]) and sim.signal_level(one) < sim.reach and one["papers"].size() == 1,
			"a one-paper signal: grade %d, head %s, convoy %s, level %d at reach %d" % [int(one.get("grade", 0)), str(one["head"]), str(one["convoy"]), sim.signal_level(one), sim.reach])
		sim._sig_on(one)
		var mw: int = sim.max_words(int(one["site"]))
		sim._sig_off()
		_check(mw <= 2 + sim.atlas_rank("long_wave") + (Data.FX["yard/long_range"] if sim.yard_has("long_range") else 0), "a faint signal carries %d codes, past its 2" % mw)
		sim.signals.pop_back()
	sim.reach = reach_was
	# at the first reach a faint band is the reach itself (nothing rolls under REACH_START): its win still never moves it
	_check(int(sim.signal_band([-1])[1]) == Data.REACH_START or sim.reach > Data.REACH_START + 1, "the faint band at the first reach: %s" % str(sim.signal_band([-1])))
	var fp: Array = sim.signal_papers().slice(0, 1).map(func(x): return int(x["id"]))
	if fp.is_empty():
		sim.stash_put(sim._plain(Data.PAPER, bases[0]))
		fp = sim.signal_papers().slice(0, 1).map(func(x): return int(x["id"]))
	var faint: Dictionary = sim.decrypt(fp)
	if not faint.is_empty():
		var faint_r: int = sim.reach
		_win_signal(sim, sim.signals.size() - 1)
		_check(sim.reach == faint_r, "a faint signal won at the first reach moved it %d -> %d" % [faint_r, sim.reach])
	sim.signals = []
	sim.papers = []
	for b in bases:
		sim.stash_put(sim._plain(Data.PAPER, b))
	ps = sim.signal_papers()
	ids = ps.slice(0, 3).map(func(x): return int(x["id"]))
	var band: Array = sim.signal_band(ids)
	var sg: Dictionary = sim.decrypt(ids)
	_check(not sg.is_empty() and sim.signals.size() == 1 and ((sim.signal_level(sg) >= int(band[0]) and sim.signal_level(sg) <= int(band[1])) or int(sg["depth"]) == 2) and sg["codes"].size() == 3 and sim.signal_papers().size() == 3,
		"a signal made wrong: %s (band %s), %d papers left" % [str(sg), str(band), sim.signal_papers().size()])
	# a rare paper: one deeper
	var rare_ids: Array = sim.signal_papers().map(func(x): return int(x["id"]))
	sim.signal_papers()[0]["rarity"] = Data.PAPER_DEEPER_AT
	_check(sim.signal_band(rare_ids)[0] == sim.signal_band(ids)[0] + 1 or sim.signal_band(rare_ids)[1] == band[1] + 1, "a rare paper doesn't roll a signal deeper: %s" % str(sim.signal_band(rare_ids)))
	# read: the site carries it, then goes back
	var i: int = int(sg["site"])
	var d0: int = int(sim.depth[i])
	var e: Dictionary = sim.signal_read(0)
	_check(int(e["level"]) == sim.signal_level(sg) and int(e["depth"]) == sim.tier_depth(sim.signal_level(sg)) and int(sim.depth[i]) == d0 and sim._sig.is_empty(), "a signal's read left its site at depth %d (was %d), %s" % [int(sim.depth[i]), d0, str(e.get("depth", -1))])
	# a level's fight on any site (D14): the curve bent by the site's shape, not the site's own campaign floor
	var held0: Array = sim.signals.duplicate(true)
	var lo: Dictionary = sg.duplicate(true)
	var hi: Dictionary = sg.duplicate(true)
	var top: int = Data.TIERS.size() - 1
	lo["site"] = 0
	lo["depth"] = sim.depth_for_level(0, sim.signal_level(sg))
	hi["site"] = top
	hi["depth"] = sim.depth_for_level(top, sim.signal_level(sg))
	sim.signals = [lo, hi]
	var e_lo: Dictionary = sim.signal_read(0)
	var e_hi: Dictionary = sim.signal_read(1)
	sim.signals = held0
	var want_r: float = float(Data.TIERS[top]["shape"]["hp"]) / float(Data.TIERS[0]["shape"]["hp"])
	_check(int(e_lo["level"]) == int(e_hi["level"]) and is_equal_approx(float(e_hi["hp"]) / float(e_lo["hp"]), want_r) and is_equal_approx(float(e_hi["dps"]), float(e_lo["dps"])),
		"a signal's level fights differently by site: level %d/%d, hp %.0f against %.0f (want x%.2f), fire %.1f against %.1f (want the same)" % [int(e_lo["level"]), int(e_hi["level"]), float(e_hi["hp"]), float(e_lo["hp"]), want_r, float(e_hi["dps"]), float(e_lo["dps"])])
	# its odds: read a few runs at a time to settled, apart from the site's own, which stay settled (the review)
	var budget_was: int = sim.odds_budget
	sim.odds_budget = 0
	sim.survival(i)
	_check(sim.odds_settled(i), "a site's own odds didn't settle")
	sim.odds_budget = 4
	for n in range(40):
		sim.signal_odds(0)
	_check(sim.signal_odds_now(0)[1] and sim.odds_settled(i), "a signal's odds: settled %s, the site's own still settled %s" % [str(sim.signal_odds_now(0)[1]), str(sim.odds_settled(i))])
	sim.odds_budget = budget_was
	# the Radio's screen
	main.show_room(main.COMMS)
	var rd = main._radio
	rd.chosen = []
	rd._shown = ""
	main.refresh()
	_check(rd._card.visible and rd._card_title.text == str(Data.TIERS[i]["name"]) and rd._papers_box.visible, "the Radio doesn't show the signal held: '%s'" % rd._card_title.text)
	_check_fit(main, "the Radio's signals")
	rd._toggle_paper(0)
	rd._toggle_paper(1)
	rd._toggle_paper(2)
	main.refresh()
	_check(rd.chosen.size() == 3 and not rd._decrypt.disabled and rd._make.text.begins_with("A signal at level"), "three papers picked don't arm the decoder: %s, '%s'" % [str(rd.chosen), rd._make.text])
	_check_fit(main, "the Radio's decoder, three in")
	rd._on_decrypt()
	main.refresh()
	_check(sim.signals.size() == 2 and rd.chosen.is_empty(), "the decoder's button made no signal: %d held" % sim.signals.size())
	# the decrypt (item 20): the new card comes through over ~2.5 s, the button a Skip meanwhile; the lines resolve
	# to the card's own words in order; at the end (or a tap) the card is the signal's
	var made: Dictionary = sim.signal_at(rd.selected)
	_check(rd.decrypting() and rd._dec.visible and rd._decrypt.text == "Skip" and not rd._decrypt.disabled, "the decrypt didn't start: running %s, button '%s'" % [str(rd.decrypting()), rd._decrypt.text])
	if rd.sound != null:
		rd.sound.clear_cued()
	for k in range(26):
		rd._process(0.05)                         # as frames come: a glyph's tick between the lines' codes
	_check(rd.sound == null or ("search_tick" in rd.sound.cued() and "radio_code" in rd.sound.cued()), "the decrypt made no ticks or no line's code: %s" % (str(rd.sound.cued()) if rd.sound != null else ""))
	var site_row: Array = rd._dec_lines[1]
	var codes_row: Array = rd._dec_lines[4]
	_check(rd.decrypting() and site_row[0].text == site_row[1] and site_row[1] == str(Data.TIERS[int(made["site"])]["name"]) and codes_row[0].text != codes_row[1], "1.3 s in: the site '%s' (want '%s'), the codes still coming '%s'" % [site_row[0].text, site_row[1], codes_row[0].text])
	rd._process(2.0)
	main.refresh()
	_check(not rd.decrypting() and not rd._dec.visible and rd._decrypt.text == "Decrypt" and rd._card_title.text == site_row[1], "the decrypt didn't end on the card: running %s, button '%s', card '%s'" % [str(rd.decrypting()), rd._decrypt.text, rd._card_title.text])
	rd.start_decrypt(made)
	rd._on_decrypt()                              # a tap mid-way: to the end, and no second signal
	_check(not rd.decrypting() and sim.signals.size() == 2, "a tap mid-decrypt didn't skip: running %s, %d held" % [str(rd.decrypting()), sim.signals.size()])
	var RadioLine := preload("res://scripts/ui/radio_line.gd")
	for w in ["Regular", "Medium", "SemiBold"]:
		var f: Font = load("res://fonts/Inter-%s.ttf" % w)
		var gone := ""
		for ch in RadioLine.GARBLE_GLYPHS:
			if not f.has_char(ch.unicode_at(0)):
				gone += ch
		_check(gone == "", "decrypt glyphs Inter %s can't draw: %s" % [w, gone])
	# three held at most
	for b in bases.slice(0, 3):
		sim.stash_put(sim._plain(Data.PAPER, b))
	sim.decrypt(sim.signal_papers().slice(0, 3).map(func(x): return int(x["id"])))
	for b in bases.slice(0, 3):
		sim.stash_put(sim._plain(Data.PAPER, b))
	_check(sim.signals.size() == Data.SIGNALS_HELD and sim.decrypt_block(sim.signal_papers().slice(0, 3).map(func(x): return int(x["id"]))).contains("held"), "a fourth signal can be held")
	# a craft on a held signal: its codes change on the signal, the site's own stay
	var before_w: Array = sim.signal_words(sim.signals[0])
	sim.notes += 1000
	var site_words: Array = sim.words[int(sim.signals[0]["site"])].duplicate(true)
	_check(sim.signal_craft(0, "retune") and sim.signals[0].has("words") and sim.words[int(sim.signals[0]["site"])] == site_words, "Retune on a signal: %s -> %s, the site's %s" % [str(before_w), str(sim.signal_words(sim.signals[0])), str(sim.words[int(sim.signals[0]["site"])])])
	# run one and win it: the reach goes up, the site goes back
	sim.hp = sim.max_hp()
	var sg0: Dictionary = sim.signals[0]
	var si: int = int(sg0["site"])
	var sd: int = int(sg0["depth"])
	var r_won: int = sim.reach
	var pts: int = sim.atlas_points
	_check(sim.deploy_signal(0) and sim.on_mission() and sim.mission.has("signal") and int(sim.depth[si]) == sd and sim.signals.size() == Data.SIGNALS_HELD - 1, "a signal didn't set off: depth %d of %d" % [int(sim.depth[si]), sd])
	sim.mission["remaining"] = 0
	if sim.mission.has("boss"):
		sim.mission["boss"]["alive"] = false
	sim._clear(sim.mission, sim.mission["t"])
	sim.extract_now()
	var sl: int = sim.lv_at(si, sd)
	_check(int(sim.best_depth[si]) >= sd and sim.deepest_cleared_level() >= sl, "a signal's clear kept depth %d on its site (it ran at %d) - the cleared level %d under its %d" % [int(sim.best_depth[si]), sd, sim.deepest_cleared_level(), sl])
	_check(not sim.on_mission() and int(sim.depth[si]) == 1 and sim._sig.is_empty() and (sl < r_won or sim.reach == r_won + 1) and sim.atlas_points >= pts, "a signal won: reach %d after level %d (depth %d), site at %d, points %d from %d" % [sim.reach, sl, sd, int(sim.depth[si]), sim.atlas_points, pts])
	# run one and lose it: the reach stays, the signal's gone
	var r0: int = sim.reach
	_check(sim.deploy_signal(0), "the second signal didn't set off")
	sim._kia()
	_check(not sim.on_mission() and sim.reach == r0 and sim.signals.size() == Data.SIGNALS_HELD - 2 and sim._sig.is_empty(), "a lost signal: reach %d from %d, %d held" % [sim.reach, r0, sim.signals.size()])
	# the bot makes signals from its papers (B7.4)
	sim.signals = []
	for b in bases.slice(0, 3):
		sim.stash_put(sim._plain(Data.PAPER, b))
	var bt = Bot.new()
	bt._make_signals(sim)
	_check(sim.signals.size() >= 1 and bt.bought.any(func(x): return str(x[1]).begins_with("a signal")), "the bot made no signal from its papers: %d" % sim.signals.size())
	# the Map: no depth's −/+ on any site
	sim.load_dict(saved)
	main.show_room(main.MISSIONS)
	main.refresh()
	for c in main._missions._cols:
		_check(not c["depth_up"].visible and not c["depth_down"].visible, "a Map card still has the depth's −/+")
	main.show_room(main.OVERVIEW)
	main.refresh()
	print("signals ok: three papers in, one held out, the band and the rare, read and put back, the Radio's columns, three held, Retune on a signal, won and the reach up, lost and gone, no depth's −/+")


## The loot tables (15 Oct, the loot read, Matt's picks): a zone's quality on its drops' rarity; a loose unique from the
## Town on, growing with the depth, capped; set pieces capped; the gamble at the deepest site's level, never common.
## D9 (15 Oct, Matt): a site well under you pays less - whole to five site levels under, 15% less a level past, never
## under 10%; your level read as the item level you wear at; the XP and the tins both, the rest of the site as it was.
## The mythics (16 Oct, docs/design/mythics.md): seven, one a slot, their words; outside every other pool; one find in
## MYTHIC_ODDS_IN on their own dice, none held twice before all seven; worn at any level, never lost; each rule does
## what it says; the bot's reads roll none.
func _mythic_checks(sim) -> void:
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var myths: Array = Data.UNIQUES.filter(func(u): return u.get("mythic", false))
	var slots: Array = myths.map(func(u): return str(u["slot"]))
	_check(myths.size() == Data.SLOTS.size() and Data.SLOTS.all(func(sl): return sl in slots) and myths.all(func(u): return Words.UNIQUES.has(u["name"]) and str(u["band"]) == "mythic"),
		"the mythics aren't one a slot with their words: %s" % str(slots))
	_check(not sim.loose_uniques(99).any(func(u): return u.get("mythic", false)), "a mythic is in the loose pool")
	# the roll: their own dice, about one in MYTHIC_ODDS_IN
	var rng0: int = sim.rng.state
	var myth_was: bool = sim.mythics_on
	sim.mythics_on = true
	sim.mythic_rng.seed = 4242
	var got := 0
	var n := Data.MYTHIC_ODDS_IN * 20
	for k in range(n):
		if not sim.mythic_roll().is_empty():
			got += 1
	_check(got >= 8 and got <= 36 and sim.rng.state == rng0, "the mythic roll: %d in %d finds (want about 20), the main dice moved %s" % [got, n, str(sim.rng.state != rng0)])
	sim.mythics_on = false
	var none := true
	for k in range(Data.MYTHIC_ODDS_IN * 3):
		none = none and sim.mythic_roll().is_empty()
	sim.mythics_on = myth_was
	_check(none, "a mythic rolled with the mythics off")
	# none held twice before all seven
	sim.stash = []
	for s in Data.SLOTS:
		sim.equipped[s] = null
	var held: Array = []
	for k in range(myths.size()):
		var u: Dictionary = sim.mythic_pick()
		_check(not (str(u.get("name", "")) in held), "%s picked twice before all seven" % str(u.get("name", "")))
		held.append(str(u["name"]))
		sim.stash.append(Items.roll_unique(u, sim.rng))
	_check(not sim.mythic_pick().is_empty(), "with all seven held, nothing to pick")
	# worn at any level, its own name and colour
	sim.xp = 0.0
	var one: Dictionary = Items.roll_unique(myths[0], sim.rng, 40, 9)
	_check(one.get("mythic", false) and Items.wear_level(one) == 1 and sim.can_wear(one) and Items.rarity_name(one) == "Mythic" and Pal.item_tone(one) == "mythic",
		"a mythic at level 40: wear %d, %s, %s" % [Items.wear_level(one), Items.rarity_name(one), Pal.item_tone(one)])
	var by_rule := {}
	for u in myths:
		by_rule[str(u["rule"])] = Items.roll_unique(u, sim.rng)
	var wear_one := func(rule: String) -> void:
		for s in Data.SLOTS:
			sim.equipped[s] = null
		var it: Dictionary = by_rule[rule]
		sim.equipped[it["slot"]] = it
		sim._dry_memo.clear()
	sim.load_dict(saved)
	sim.stash = []
	# the rules
	wear_one.call("spare_key")
	_check(is_equal_approx(sim.secondary_share(true), 1.0), "the Spare Key's secondary at %.2f" % sim.secondary_share(true))
	wear_one.call("last_orders")
	var cv: Dictionary = sim._conversion_raw()
	_check(Data.ELEMENTS.all(func(e): return is_equal_approx(float(cv[e]), 1.0)) and is_equal_approx(float(cv["physical"]), 1.0) and sim._tops_open(Data.ELEMENT_TREES[0]["name"]),
		"the Last Orders' hit: %s" % str(cv))
	wear_one.call("removal_van")
	_check(sim.capacity() == sim.capacity_raw() * Data.MYTHIC_PACK, "the Removal Van's pack holds %d of %d" % [sim.capacity(), sim.capacity_raw()])
	wear_one.call("freedom")
	_check(sim.has_keys(), "the Freedom of the Borough doesn't open the crates")
	wear_one.call("headmasters_cap")
	var probe := ""
	for ct in Data.trees_for(sim.cls):
		for i in range(ct.get("nodes", []).size()):
			var nd: Dictionary = ct["nodes"][i]
			var eff: String = str(nd.get("effect", ""))
			if probe == "" and eff != "" and str(ct.get("class", "")) != "" and not nd.has("type") and not nd.has("skill") and not nd.get("keystone", false) and not ("%s/%d" % [ct["name"], i]) in sim.tree:
				probe = eff
	var with_cap: bool = probe == "" or sim.has_node(probe)
	for s in Data.SLOTS:
		sim.equipped[s] = null
	var without: bool = probe != "" and sim.has_node(probe)
	_check(with_cap and (probe == "" or not without or sim.tree.size() > 0), "the Headmaster's Cap: an untrained node of the class (%s) isn't yours" % probe)
	# never a node with a cost (21 Oct, Matt: "fix both"): a Drifter in the Cap has Spray, not Hit and run or Ghost
	var cls_was: String = sim.cls
	_set_cls(sim, "Drifter")
	var tree_was: Array = sim.tree.duplicate()
	sim.tree = []
	wear_one.call("headmasters_cap")
	_check(not sim.has_node("hit_and_run") and not sim.has_node("cap_ghost") and not sim.has_node("never_there"), "the Headmaster's Cap gave a node with a cost: hit and run %s, ghost %s, never there %s" % [str(sim.has_node("hit_and_run")), str(sim.has_node("cap_ghost")), str(sim.has_node("never_there"))])
	_check(sim.has_node("breather"), "the Headmaster's Cap held back a plain notable (Breather)")
	_set_cls(sim, "Poacher")
	sim.tree = []
	wear_one.call("headmasters_cap")
	_check(sim.skills_learnt().is_empty() and sim.has_node("clocked"), "the Headmaster's Cap: skills %s (want none), Clocked %s" % [str(sim.skills_learnt()), str(sim.has_node("clocked"))])
	sim.tree = tree_was
	_set_cls(sim, cls_was)
	# on a run: the Suit's cap, the Bag's meds, the clock, never lost
	wear_one.call("bomb_suit")
	sim.hp = sim.max_hp()
	sim.deploy(0)
	_check(sim.on_mission(), "the mythics' run didn't set off")
	if sim.on_mission():
		var before: float = sim.hp
		sim._take(sim.mission, sim.max_hp() * 10.0)
		_check(before - sim.hp <= sim.max_hp() * Data.MYTHIC_HURT_A_SECOND + 0.01, "the Bomb Disposal Suit let %.0f of %.0f through in a second" % [before - sim.hp, sim.max_hp()])
		sim._time_out(sim.mission)
		_check(sim.equipped["Armour"] != null and sim.equipped["Armour"].get("mythic", false), "the clock took a mythic")
	if sim.on_mission():
		sim.extract_now()
	wear_one.call("ambulance_bag")
	sim.rig = [sim._plain(Data.MEDICAL, "Bandage")]
	sim.hp = sim.max_hp() * 0.3
	sim.deploy(0)
	if sim.on_mission():
		var mid: int = int(sim.rig[0]["id"])
		_check(sim.use_med(mid) and sim.rig.size() == 1, "the Ambulance's Bag spent its med")
		sim.extract_now()
	sim.load_dict(saved)
	print("the mythics ok: seven a slot, their own dice at one in %d, none twice, any level, never lost, each rule" % Data.MYTHIC_ODDS_IN)


func _over_level_checks(sim) -> void:
	if sim.on_mission():
		sim.extract_now()
	var xp0: float = sim.xp
	sim.xp = Data.xp_for_level(1)
	var whole: Dictionary = sim.effective(Data.BANK)
	_check(is_equal_approx(float(whole["over_level"]), 1.0), "a level-1 runner is paid short at the Bank: %.2f" % float(whole["over_level"]))
	sim.xp = Data.xp_for_level(50)
	var reach0: int = sim.reach
	var bd0: Array = sim.best_depth.duplicate()
	var bb0: Array = sim.bosses_beaten.duplicate()
	sim.reach = Data.REACH_START
	for i in range(sim.best_depth.size()):
		sim.best_depth[i] = 1                   # the campaign done, no signal won: the level alone reads (D9)
	for z in range(sim.bosses_beaten.size()):
		sim.bosses_beaten[z] = true
	_check(sim.campaign_done(), "the over-level case's campaign isn't done")
	var low: Dictionary = sim.effective(Data.BANK)
	var mine: float = float(mini(Items.max_ilvl_for(50), Data.MAX_LEVEL))     # a level-50 runner reads as level 50 (21 Oct)
	var want: float = clampf(1.0 - Data.OVER_LEVEL_STEP * maxf(0.0, mine - float(low["level"]) - Data.OVER_LEVEL_FREE), Data.OVER_LEVEL_FLOOR, 1.0)
	var harder: float = sim.campaign_level_mult(Data.BANK)     # and the fight harder with the levels since its first clear (21 Oct), to CAMPAIGN_LEVEL_MAX
	_check(is_equal_approx(float(low["over_level"]), want) and want < 1.0 and is_equal_approx(float(low["xp"]), float(whole["xp"]) * want) and is_equal_approx(float(low["cash"]), float(whole["cash"]) * want) and is_equal_approx(float(low["hp"]), float(whole["hp"]) * harder),
		"a level-50 runner at the Bank: paid %.2f, want %.2f; xp %.1f of %.1f; the fight x%.2f" % [float(low["over_level"]), want, float(low["xp"]), float(whole["xp"]), harder])
	# the fight with the level (21 Oct): a site never cleared is as it is at any level (the frontier never hardens); one
	# cleared at level 2 is as it was to 2 + the free levels, then x1.08 a level gained, twice at most
	var site2: int = Data.OUTSKIRTS_SITES
	var cl0: Dictionary = sim.clear_level.duplicate()
	sim.clear_level.erase(site2)
	sim.xp = Data.xp_for_level(1)
	var plain_hp: float = float(sim.effective(site2)["hp"])
	sim.xp = Data.xp_for_level(40)
	_check(is_equal_approx(float(sim.effective(site2)["hp"]), plain_hp), "a site never cleared hardened with the level: x%.2f" % (float(sim.effective(site2)["hp"]) / plain_hp))
	sim.clear_level[site2] = 2
	sim.xp = Data.xp_for_level(2 + Data.CAMPAIGN_LEVEL_FREE)
	_check(is_equal_approx(float(sim.effective(site2)["hp"]), plain_hp), "a site cleared the free levels ago hardened: x%.2f" % (float(sim.effective(site2)["hp"]) / plain_hp))
	sim.xp = Data.xp_for_level(2 + Data.CAMPAIGN_LEVEL_FREE + 4)
	_check(is_equal_approx(float(sim.effective(site2)["hp"]), plain_hp * pow(1.0 + Data.CAMPAIGN_LEVEL_GROW, 4)), "a runner 4 past the free levels since the clear: HP x%.3f, want x%.3f" % [float(sim.effective(site2)["hp"]) / plain_hp, pow(1.0 + Data.CAMPAIGN_LEVEL_GROW, 4)])
	sim.xp = Data.xp_for_level(40)
	_check(is_equal_approx(float(sim.effective(site2)["hp"]), plain_hp * Data.CAMPAIGN_LEVEL_MAX), "the level's tax runs past its cap: x%.2f" % (float(sim.effective(site2)["hp"]) / plain_hp))
	# a first clear records the level, and the save keeps it
	var rt: Dictionary = sim.to_dict()
	var back = Sim.new()
	back.load_dict(rt)
	_check(back.clear_level.has(site2) and int(back.clear_level[site2]) == 2, "the first clear's level didn't survive the save: %s" % str(back.clear_level))
	sim.clear_level = cl0
	# and the odds read again on a level-up (the review): the key carries the level
	sim.xp = Data.xp_for_level(1)
	var key_lv1: Array = sim._odds_key_common().duplicate()
	sim.xp = Data.xp_for_level(2 + Data.CAMPAIGN_LEVEL_FREE + 4)
	sim._key_memo = []
	sim._scope_memo = []
	_check(sim._odds_key_common() != key_lv1, "the odds' key doesn't move with the level: the Map's reading goes stale as the fight hardens")
	sim.xp = Data.xp_for_level(50)
	_check(sim.over_level_share(int(low["level"]) + 100) == 1.0 and sim.over_level_share(-100) == Data.OVER_LEVEL_FLOOR, "the share isn't whole over you or floored far under")
	# the campaign (25 Oct, the second review; D12's clamp gone): your level against the level the site's gear wants
	for i in range(sim.best_depth.size()):
		sim.best_depth[i] = 1 if i <= 4 else 0
	for z in range(sim.bosses_beaten.size()):
		sim.bosses_beaten[z] = false
	sim.xp = Data.xp_for_level(30)                 # past WEAR_FLAT: a level of wear an item level, so both are there to find
	var at_free := -1
	var past_free := -1
	for lv in range(1, 80):
		if Items.wear_for(lv) == 30 - int(Data.OVER_LEVEL_FREE) and at_free < 0:
			at_free = lv
		if Items.wear_for(lv) == 29 - int(Data.OVER_LEVEL_FREE) and past_free < 0:
			past_free = lv
	_check(at_free > 0 and past_free > 0, "no item level wears at %d or %d" % [30 - int(Data.OVER_LEVEL_FREE), 29 - int(Data.OVER_LEVEL_FREE)])
	if at_free > 0 and past_free > 0:
		var share_free: float = sim.over_level_share(at_free)
		var share_past: float = sim.over_level_share(past_free)
		_check(is_equal_approx(share_free, 1.0) and is_equal_approx(share_past, 1.0 - Data.OVER_LEVEL_STEP),
			"a level-30 runner in the campaign: paid %.2f where the gear wants %d levels under him (want 1), %.2f a level further (want %.2f)" % [share_free, int(Data.OVER_LEVEL_FREE), share_past, 1.0 - Data.OVER_LEVEL_STEP])
	sim.best_depth = bd0
	sim.bosses_beaten = bb0
	sim.reach = reach0
	sim.xp = xp0
	print("over-levelled ok: whole to %d under, less a level past, floored; XP and tins" % int(Data.OVER_LEVEL_FREE))


func _loot_table_checks(sim) -> void:
	var saved: Dictionary = sim.to_dict()
	for i in range(Data.TIERS.size()):
		sim.depth[i] = 1
	var z0: float = float(sim.effective(0)["rarity"])
	var z3: float = float(sim.effective(Data.TIERS.size() - 1)["rarity"])
	_check(z3 - z0 >= Data.ZONE_QUALITY[3] - 0.001, "the City's drops aren't rarer than the Outskirts': %.2f against %.2f" % [z3, z0])
	var town: int = int(Data.ZONES[2]["tiers"][0])
	_check(sim.unique_odds({"tier": 0, "depth": 1}) == 0.0 and is_equal_approx(sim.unique_odds({"tier": town, "depth": 1}), Data.UNIQUE_CAMPAIGN) and is_equal_approx(sim.unique_odds({"tier": town, "depth": 40}), Data.UNIQUE_CAP),
		"a loose unique's odds: %.4f, %.4f, %.4f" % [sim.unique_odds({"tier": 0, "depth": 1}), sim.unique_odds({"tier": town, "depth": 1}), sim.unique_odds({"tier": town, "depth": 40})])
	var lv: int = sim.gamble_level()
	_check(lv <= sim.deepest_site_level() and Items.wear_level({"slot": "Primary", "base": "", "tier": 1, "ilvl": lv}) <= maxi(1, sim.level()), "the gamble's level %d is past what the runner can wear" % lv)
	var ok := true
	for n in range(40):
		var it: Dictionary = sim.roll_gamble(Data.GAMBLE_KINDS[n % Data.GAMBLE_KINDS.size()], 0.99)
		if int(it.get("rarity", 0)) == 0 or (not it.has("unique") and Items.ilvl(it) != lv):
			ok = false
	_check(ok, "a gamble rolled common, or off the deepest site's level (%d)" % lv)
	sim.load_dict(saved)
	print("the loot tables ok: the zones' quality, the uniques' trickle and cap, the gamble at the deepest level")


## A full pack (15 Oct, parked item 10, agreed with Matt): by hand a drop goes to the floor and the pack's unchanged; on
## "Fill up, then go" a find that isn't an upgrade never swaps, an upgrade in the pack never leaves,
## an upgrade find swaps the cheapest thing its size that isn't one.
## B9 (15 Oct): a later gang can be the next zone's crew - harder a head, hotter, their fire the next zone's - said so
## as they come, held while they stand, the site's own again when they're down, through a save; the City's own past the last.
func _harder_gang_checks(sim) -> void:
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	_check(sim.gang_next_odds(1) == 0.0 and is_equal_approx(sim.gang_next_odds(2), Data.GANG_NEXT_STEP) and sim.gang_next_odds(50) == Data.GANG_NEXT_MAX, "the odds a gang: first %.2f, second %.2f, fiftieth %.2f" % [sim.gang_next_odds(1), sim.gang_next_odds(2), sim.gang_next_odds(50)])
	sim.hp = sim.max_hp()
	sim.deploy(0)                                   # the Allotments: the Outskirts' field lads; next, the Estate's
	var m: Dictionary = sim.mission
	var home: Dictionary = m["t"]
	m["patrols"] = 2
	sim._gang_harder(m)
	var h: Dictionary = m["t"]
	_check(not is_same(h, home) and is_same(m.get("t_home"), home), "the harder gang didn't hold the site's own aside")
	_check(is_equal_approx(float(h["hp"]), float(home["hp"]) * Data.GANG_NEXT_HP) and is_equal_approx(float(h["dps"]), float(home["dps"]) * Data.GANG_NEXT_DPS), "harder a head: hp %.1f from %.1f, fire %.2f from %.2f" % [float(h["hp"]), float(home["hp"]), float(h["dps"]), float(home["dps"])])
	_check(int(h.get("hard_zone", -1)) == 1 and float(h["types"].get("bleed", 0.0)) > 0.0 and not home["types"].has("bleed"), "the Estate's fire: zone %d, types %s (the site's %s)" % [int(h.get("hard_zone", -1)), str(h["types"]), str(home["types"])])
	_check(float(home["hp"]) == float(sim.effective(0)["hp"]) and not home.has("hard_zone"), "the site's own was changed by the harder gang")
	var line: String = sim.gang_line(m, 3)
	_check(line.begins_with(Words.GANGS[1]["name"]) and "in from the Estate" in line, "the harder gang's line: %s" % line)
	# through a save, standing
	var d: Dictionary = JSON.parse_string(JSON.stringify(sim.to_dict()))
	sim.load_dict(d)
	m = sim.mission
	_check(m != null and m.has("t_home") and m["t_home"]["depth"] is int and int(m["t"].get("hard_zone", -1)) == 1 and is_equal_approx(float(m["t"]["hp"]), float(m["t_home"]["hp"]) * Data.GANG_NEXT_HP), "a harder gang through a save: %s" % str(m.get("t", {}).get("hard_zone", "none") if m != null else "no run"))
	# down: the site's own again - the one held aside, not the site read again (23 Oct: the clock crossing night or the
	# weather between the two reads moved the site's HP, and this failed with the code right)
	var held_home: Dictionary = m["t_home"]
	m["cleared"] = true
	m["remaining"] = 1
	m["target_hp"] = -1.0
	sim._fight(m, m["t"], 0.05)
	_check(not m.has("t_home") and not m["t"].has("hard_zone") and is_same(m["t"], held_home), "the harder gang down, the site's own didn't come back: %s" % str(m["t"].get("hard_zone", "none")))
	# the patrol arriving rolls it: at the cap's odds, most of a dozen come harder, and the first never does
	var hard := 0
	for k in range(12):
		m["remaining"] = 0
		m["target_hp"] = 0.0
		if m.has("t_home"):
			m["t"] = m["t_home"]
			m.erase("t_home")
		m["patrols"] = 40
		m["patrol_timer"] = 1e9
		sim._tick(0.01)
		if m["t"].has("hard_zone"):
			hard += 1
			_check(is_equal_approx(float(m["target_hp"]), float(m["t"]["hp"])), "a harder gang's first head came at the site's HP: %.1f, theirs %.1f" % [float(m["target_hp"]), float(m["t"]["hp"])])
	_check(hard >= 4, "a dozen gangs at the cap's odds, %d harder" % hard)
	m["remaining"] = 0
	if m.has("t_home"):
		m["t"] = m["t_home"]
		m.erase("t_home")
	m["patrols"] = 0
	m["patrol_timer"] = 1e9
	sim._tick(0.01)
	_check(not m["t"].has("hard_zone") and int(m["patrols"]) == 1, "the first gang came harder")
	# the City's own, past the last
	m["remaining"] = 0
	m["t"]["crew_zone"] = 3
	sim._gang_harder(m)
	_check(int(m["t"].get("hard_zone", -1)) == 3 and "the hard core" in sim.gang_line(m, 2) and Words.GANGS[3]["name"] in sim.gang_line(m, 2), "the City's past the last: %s" % sim.gang_line(m, 2))
	sim.extract_now()
	sim.load_dict(saved)
	print("harder gangs ok: the next zone's crew, harder and hotter, said so, held while they stand, through a save; the City's own past the last")


func _full_pack_checks(sim) -> void:
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var by_hand_was: bool = sim.loot_by_hand
	sim.equipped["Armour"] = sim._plain("Armour", Data.BASES["Armour"].back()["name"])
	sim.equipped["Helmet"] = null
	sim._dry_memo.clear()
	var junk: Dictionary = sim._plain("Armour", "Stab vest")       # worse than what's worn
	var up: Dictionary = sim._plain("Helmet", Data.BASES["Helmet"][0]["name"])     # nothing worn there: an upgrade
	_check(not sim.is_upgrade(junk) and sim.is_upgrade(up), "the fixture: junk an upgrade %s, the helmet %s" % [str(sim.is_upgrade(junk)), str(sim.is_upgrade(up))])
	for hand in [true, false]:
		sim.loot_by_hand = hand
		sim.hp = sim.max_hp()
		sim.deploy(0)
		var m: Dictionary = sim.mission
		m["leave_full"] = not hand
		if hand:
			m["crates"] = []                  # the search on: the floor's on screen
		m["found"] = []
		var guard := 0
		while sim.pack_used(m) + Items.size(junk) <= sim.capacity() and guard < 50:
			var j: Dictionary = junk.duplicate(true)
			j["id"] = 900000 + guard
			m["found"].append(j)
			guard += 1
		while sim.pack_used(m) < sim.capacity() and guard < 80:
			var med: Dictionary = sim._plain(Data.MEDICAL, Data.BASES[Data.MEDICAL][0]["name"])
			med["id"] = 950000 + guard
			m["found"].append(med)             # topped up to the last cell: full is full
			guard += 1
		var fill: Array = m["found"].map(func(x): return int(x["id"]))
		if hand:
			var f0: int = m.get("floor", []).size()
			var drop: Dictionary = up.duplicate(true)
			drop["id"] = 910000
			sim._place_find(m, drop)
			_check(m["found"].map(func(x): return int(x["id"])) == fill and m.get("floor", []).size() == f0 + 1, "by hand a full pack's drop didn't go to the floor: by hand %s, floor %d from %d" % [str(sim.by_hand(m)), m.get("floor", []).size(), f0])
		else:
			var j2: Dictionary = junk.duplicate(true)
			j2["id"] = 920000
			var left0: int = int(m["left"])
			sim._place_find(m, j2)
			_check(m["found"].map(func(x): return int(x["id"])) == fill and int(m["left"]) == left0 + 1, "on auto a non-upgrade swapped into a full pack")
			var u1: Dictionary = up.duplicate(true)
			u1["id"] = 930000
			sim._place_find(m, u1)
			_check(m["found"].any(func(x): return int(x["id"]) == 930000), "on auto an upgrade didn't swap into a full pack")
			var u2: Dictionary = up.duplicate(true)
			u2["id"] = 940000
			var n_junk: int = m["found"].filter(func(x): return not sim.is_upgrade(x)).size()
			sim._place_find(m, u2)
			_check(m["found"].any(func(x): return int(x["id"]) == 930000) and (n_junk == 0 or m["found"].any(func(x): return int(x["id"]) == 940000)), "on auto an upgrade in the pack was swapped out, or the second didn't take the junk's place")
			# a mythic (17 Oct): swaps into a full pack, and no upgrade swaps it out
			m["found"] = []                       # full again, of junk and meds
			var g2 := 0
			while sim.pack_used(m) + Items.size(junk) <= sim.capacity() and g2 < 50:
				var jj: Dictionary = junk.duplicate(true)
				jj["id"] = 970000 + g2
				m["found"].append(jj)
				g2 += 1
			while sim.pack_used(m) < sim.capacity() and g2 < 80:
				var md: Dictionary = sim._plain(Data.MEDICAL, Data.BASES[Data.MEDICAL][0]["name"])
				md["id"] = 980000 + g2
				m["found"].append(md)
				g2 += 1
			var my: Dictionary = Items.roll_unique(sim._unique_named("The Headmaster's Cap"), sim.rng)
			var worn: Dictionary = my.duplicate(true)
			worn["id"] = 990000
			sim.equipped["Helmet"] = worn          # the same cap worn: this one's no upgrade, so only its being a mythic keeps it
			sim._dry_memo.clear()
			_check(not sim.is_upgrade(my), "the fixture: a cap the same as the one worn reads as an upgrade")
			var room_for: bool = m["found"].any(func(x): return not sim._pack_keeps(x) and Items.size(x) >= Items.size(my) and Items.opens(x) == "")
			sim._place_find(m, my)
			_check(not room_for or m["found"].any(func(x): return int(x["id"]) == int(my["id"])), "on auto a full pack passed a mythic over")
			for n in range(3):
				var u3: Dictionary = up.duplicate(true)
				u3["id"] = 960000 + n
				sim._place_find(m, u3)
			_check(not room_for or m["found"].any(func(x): return int(x["id"]) == int(my["id"])), "on auto an upgrade swapped a mythic out of the pack")
			sim.equipped["Helmet"] = null
			sim._dry_memo.clear()
			# a mythic with nothing its size to make way (17 Oct): a pack of meds alone, a five-cell rifle - in over the size
			m["found"] = []
			var g3 := 0
			while sim.pack_used(m) < sim.capacity() and g3 < 80:
				var md3: Dictionary = sim._plain(Data.MEDICAL, Data.BASES[Data.MEDICAL][0]["name"])
				md3["id"] = 985000 + g3
				m["found"].append(md3)
				g3 += 1
			var lo: Dictionary = Items.roll_unique(sim._unique_named("The Last Orders"), sim.rng)
			sim._place_find(m, lo)
			_check(m["found"].any(func(x): return int(x["id"]) == int(lo["id"])), "on auto a full pack of one-cell pieces passed a mythic rifle over")
			_check(room_for, "the fixture: nothing in the full pack big enough to make way for a mythic helmet")
		sim.extract_now()
	# a mythic left on the floor (17 Oct): home on the way out, and on a death
	for ending in ["extract", "timeout", "kia"]:
		sim.hp = sim.max_hp()
		sim.deploy(0)
		var mf: Dictionary = sim.mission
		mf["crates"] = []
		var fm: Dictionary = Items.roll_unique(sim._unique_named("The Spare Key"), sim.rng)
		mf["floor"] = [fm]
		if ending == "extract":
			sim.extract_now()
		elif ending == "timeout":
			sim._time_out(mf)
			if sim.on_mission():
				sim.extract_now()
		else:
			sim._kia()
		_check(sim.stash.any(func(x): return int(x["id"]) == int(fm["id"])), "a mythic left on the floor was lost on the %s" % ending)
		if sim.on_mission():
			sim.extract_now()
	# home to a full stash (17 Oct): a mythic comes in whatever the room, as the deeds do
	sim.hp = sim.max_hp()
	sim.deploy(0)
	var mh: Dictionary = sim.mission
	var g4 := 0
	while sim.stash_put(sim._plain(Data.MEDICAL, Data.BASES[Data.MEDICAL][0]["name"])) and g4 < 2000:
		g4 += 1
	var hm: Dictionary = Items.roll_unique(sim._unique_named("The Last Orders"), sim.rng)
	_check(not sim.stash_fits(hm), "the fixture: the stash isn't full")
	mh["found"].append(hm)
	sim.extract_now()
	_check(sim.stash.any(func(x): return int(x["id"]) == int(hm["id"])), "a mythic brought home to a full stash was left at the gate")
	sim.loot_by_hand = by_hand_was
	sim.load_dict(saved)
	print("a full pack ok: by hand to the floor; on auto only an upgrade swaps in, and never out; a mythic always home")


## The Van's Spare cut (15 Oct, parked item 12, Matt's pick): the secondary at two thirds behind the primary, not all of
## it; Double tap, or the primary dry, still all of it; no +damage of its own.
func _vans_checks(sim) -> void:
	var saved: Dictionary = sim.to_dict()
	sim.tree = sim.tree.filter(func(id): return not str(sim.node(id).get("effect", "")).contains("double_tap"))
	var vans: Dictionary = Items.roll_unique(sim._unique_named("The Van's Spare"), sim.rng)
	sim.equipped["Secondary"] = vans
	sim._dry_memo.clear()
	_check(is_equal_approx(sim.secondary_share(true), 2.0 / 3.0) and sim.secondary_share(false) == 1.0, "the Van's Spare's share: %.3f with the primary, %.3f without" % [sim.secondary_share(true), sim.secondary_share(false)])
	_check(not vans["affixes"].any(func(a): return str(a["stat"]) == "damage_pct"), "the Van's Spare still carries +damage")
	sim.equipped["Secondary"] = sim._plain("Secondary", "Old revolver")
	_check(is_equal_approx(sim.secondary_share(true), 1.0 / 3.0), "a plain secondary's share: %.3f" % sim.secondary_share(true))
	sim.load_dict(saved)
	print("the Van's Spare ok: two thirds, all of it with Double tap or a dry primary, no +damage")


## The heads' keepsakes and the Gamekeeper's loot (15 Oct, parked items 3 and 7): his two uniques in his pool and one
## dropping; the vet's bag in the pack at the drop, the Clinic open there and then, in the drawer after and never the
## stash; the Twelve-Bore's kill heals 3%; the Wax Jacket halves poison on you.
func _keepsake_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var gk: Dictionary = sim.zone_boss(0)
	_check(gk.get("uniques", []).size() == 2 and gk["uniques"].all(func(n): return not sim._unique_named(n).is_empty()), "the Gamekeeper's pool: %s" % str(gk.get("uniques", [])))
	sim.unlocked.erase("clinic")
	sim.keepsakes = []
	sim.hp = sim.max_hp()
	sim.deploy(2)
	var m: Dictionary = sim.mission
	m["boss"] = {"name": gk["name"], "zone": 0, "alive": true, "hp": 1.0, "started": true}
	var n0: int = m["found"].size()
	sim._boss_down(m, m["t"])
	var got: Array = m["found"].slice(n0).map(func(x): return str(x.get("unique", x["base"])))
	_check(sim.room_open("clinic") and "The vet's bag" in sim.keepsakes and "The vet's bag" in got and got.any(func(x): return x in gk["uniques"]), "the Gamekeeper's drop: %s, keepsakes %s" % [str(got), str(sim.keepsakes)])
	# his own, off him, is the first big find (21 Oct, Matt's playtest: the Twelve-Bore read under a Pump found before
	# him): a tier past the site's loot, never under its own base, lifted - over every plain gun of its type at the
	# site's loot tier, and over its own base plain; off the Fence it's as before
	var his: Array = m["found"].slice(n0).filter(func(x): return x.has("unique") and x["unique"] in gk["uniques"])
	for it in his:
		var lift: float = float(it.get("lift", 1.0))
		_check(lift >= Data.BOSS_UNIQUE_LIFT - 0.001 and int(it["tier"]) >= int(Items.base_named(it["slot"], sim._unique_named(it["unique"])["base"])["tier"]), "a head's unique came plain: %s lift %.2f tier %d" % [it["unique"], lift, int(it["tier"])])
	var tf: Dictionary = m["t"]
	var gun: Dictionary = Items.roll_unique(sim._unique_named("The Keeper's Twelve-Bore"), sim.rng, int(tf.get("level", 1)), int(tf["loot_tier"]), true)
	var best_plain := 0.0
	for b in Data.BASES["Primary"]:
		if b.get("type", "") == "shotgun" and int(b["tier"]) <= int(tf["loot_tier"]) + 1:
			var pl: Dictionary = sim._plain("Primary", b["name"])
			pl["ilvl"] = Items.ilvl(gun)
			best_plain = maxf(best_plain, Items.dps(pl))
	_check(Items.dps(gun) > best_plain * 1.1, "the Keeper's gun off him (%.0f dmg/s) doesn't beat the best plain shotgun to a tier past the site's (%.0f)" % [Items.dps(gun), best_plain])
	var loose: Dictionary = Items.roll_unique(sim._unique_named("The Keeper's Twelve-Bore"), sim.rng, int(tf.get("level", 1)), int(tf["loot_tier"]) + 1)     # the same body's tier as off him: the cache must stay plain
	_check(not loose.has("lift") or float(loose["lift"]) < Data.BOSS_UNIQUE_LIFT, "a unique not off its head carries the head's lift")
	sim.extract_now()
	_check(not sim.stash.any(func(x): return str(x["base"]) == "The vet's bag"), "the vet's bag went into the stash")
	main.show_room(main.BARRACKS)
	main._barracks.pick_also("The drawer")
	main.refresh()
	var dr: Dictionary = main._barracks._drawer_branch()
	_check(str(dr["nodes"][0]["name"]).ends_with("The vet's bag") and str(dr["nodes"][0]["words"]).contains("Clinic"), "the drawer doesn't lead with the keepsake: %s" % str(dr["nodes"][0]))
	_check_fit(main, "the drawer with a keepsake")
	main._barracks.pick_also("")
	# the Twelve-Bore: a kill heals 3% of HP
	sim.equipped["Primary"] = Items.roll_unique(sim._unique_named("The Keeper's Twelve-Bore"), sim.rng)
	sim._dry_memo.clear()
	sim.hp = sim.max_hp() * 0.5
	sim.deploy(0)
	sim.mission["t"]["xp"] = 0.0               # no level off the kill: a level-up moved the max HP in the sum (19 Oct, the flaky check)
	var h0: float = sim.hp
	var lv0: int = sim.level()
	sim._kill(sim.mission, sim.mission["t"])
	_check(is_equal_approx(sim.hp - h0, sim.max_hp() * Data.FX["rule/keepers_gun"] + sim._affix_sum("life_per_kill")), "the Twelve-Bore's kill healed %.1f of %.0f (want %.1f + %.1f a kill; level %d -> %d)" % [sim.hp - h0, sim.max_hp(), sim.max_hp() * Data.FX["rule/keepers_gun"], sim._affix_sum("life_per_kill"), lv0, sim.level()])
	sim.extract_now()
	# the Wax Jacket: poison on you does half
	var loss := []
	for wear_it in [false, true]:
		sim.equipped["Armour"] = Items.roll_unique(sim._unique_named("The Keeper's Wax Jacket"), sim.rng) if wear_it else sim._plain("Armour", "Work jacket")
		sim._dry_memo.clear()
		sim.hp = sim.max_hp()
		sim.deploy(0)
		var mm: Dictionary = sim.mission
		mm["t"]["dps"] = 0.0
		mm["remaining"] = 50
		mm["target_hp"] = 1e9
		mm["my_dots"] = {"poison": 50.0}
		mm["guard"] = 0.0                     # Guard soaks what lands: the poison alone, as it reaches HP
		mm["taken_by"] = {}
		sim._tick(1.0)
		loss.append(float(mm["taken_by"].get("poison", 0.0)))
		sim.extract_now()
	_check(loss[0] > 0.0 and is_equal_approx(loss[1], loss[0] * Data.FX["rule/keepers_wax"]), "the Wax Jacket's poison: %s" % str(loss))
	sim.load_dict(saved)
	main.show_room(main.OVERVIEW)
	main.refresh()
	print("the keepsakes ok: the Gamekeeper's two, the vet's bag in the pack and the drawer, never the stash; the Twelve-Bore heals, the Wax Jacket halves")


## Kev's story (15 Oct, endgame_radio.md §3): a beat's three papers go in together and make its signal - its site and
## crew at your reach, the head at full strength; never mixed with another paper; beaten, the story moves on; the
## third beat is the depot's convoy, the three heads in a row; a signal beaten can bring the beat's next paper home.
func _story_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	if not ("radio" in sim.unlocked):
		sim.unlocked.append("radio")
	_finish_campaign(sim)
	sim.signals = []
	sim.story_beat = 0
	for it in sim.signal_papers():
		sim.stash.erase(it)
	var names: Array = sim.story_papers(0)
	_check(names.size() == 3, "the first beat has %d papers" % names.size())
	for nm in names:
		sim.stash_put(sim._plain(Data.PAPER, nm))
	var plain: Dictionary = sim._plain(Data.PAPER, "A P45")
	sim.stash_put(plain)
	var ids: Array = sim.signal_papers().filter(func(x): return sim.story_of(x) == 0).map(func(x): return int(x["id"]))
	var mixed: Array = [ids[0], ids[1], int(plain["id"])]
	_check(sim.decrypt_block(mixed).begins_with("Kev's papers"), "a story paper mixed with another: '%s'" % sim.decrypt_block(mixed))
	_check(sim.story_held().size() == 3 and sim.decrypt_block(ids) == "", "the beat's three: held %d, '%s'" % [sim.story_held().size(), sim.decrypt_block(ids)])
	main.show_room(main.COMMS)
	main._radio._shown = ""
	main.refresh()
	_check_fit(main, "the Radio with Kev's papers")
	var sg: Dictionary = sim.decrypt(ids)
	var b0: Dictionary = Data.STORY_BEATS[0]
	_check(int(sg.get("story", -1)) == 0 and int(sg["site"]) == int(b0["site"]) and int(sg["zone"]) == int(b0["zone"]) and bool(sg["head"]) and sim.signal_level(sg) == maxi(maxi(Data.REACH_START, sim.reach - Data.STORY_UNDER), sim.lv_at(int(sg["site"]), 2)), "the first beat's signal: %s" % str(sg))
	var e: Dictionary = sim.signal_read(0)
	_check(e.has("boss") and e["boss"].get("pinnacle", false), "the first beat's signal has no head at full strength: %s" % str(e.get("boss", {})))
	main._radio._shown = ""
	main.refresh()
	_check(main._radio._card_kicker.text.begins_with("Kev's story"), "the story signal's card: '%s'" % main._radio._card_kicker.text)
	_check_fit(main, "the Radio, a story signal")
	# beaten: the story moves on
	sim.hp = sim.max_hp()
	_check(sim.deploy_signal(0), "the story signal didn't set off")
	sim.mission["remaining"] = 0
	if sim.mission.has("boss"):
		sim.mission["boss"]["alive"] = false
	sim._clear(sim.mission, sim.mission["t"])
	sim.extract_now()
	_check(sim.story_beat == 1 and sim.story_now() == 1, "the story didn't move on: beat %d" % sim.story_beat)
	_check(not (names[0] in sim.book), "a story paper went in the drawer's book")
	# the payoff (20 Oct, Matt: "where are the story beats explained or displayed?"): Kev's line on the came-back card,
	# and the Radio's Kev's story view - the beat beaten with its lines, the next on now, the last's name still on the air
	_check(int(sim.came_back.get("kev", -1)) == 0 and sim.story_at.has(0), "the beat beaten isn't on the came-back record: %s / %s" % [str(sim.came_back.get("kev", -1)), str(sim.story_at)])
	main.show_room(main.MISSIONS)
	main.refresh()
	var cbc = main._missions._came
	var won0: String = str(Words.STORY[0]["won"])
	_check(cbc.visible and (cbc._firsts[0].text + " " + cbc._firsts[1].text).begins_with("Kev: ") and cbc._firsts[2].text.begins_with("Kev's story 1 of"), "the came-back card hasn't Kev's line: '%s' / '%s' / '%s'" % [cbc._firsts[0].text, cbc._firsts[1].text, cbc._firsts[2].text])
	_check_fit(main, "the came-back card, Kev's line")
	main.show_room(main.COMMS)
	main._radio._pick_view("story")
	main._radio._shown = ""
	main.refresh()
	var ks = main._radio._story
	var said: String = " ".join(ks._beats[0]["won"].map(func(l): return str(l.text))).strip_edges()
	_check(ks.visible and ks._beats[0]["state"].text.begins_with("Beaten") and said == won0 and ks._beats[1]["state"].text.begins_with("On now")
		and ks._beats[2]["name"].text == "3 · " + Fmt.scramble(str(Data.STORY_BEATS[2]["name"])) and ks._side_head.text.contains(str(Data.STORY_BEATS[1]["name"]).to_upper()),
		"the story view: '%s' / '%s' / '%s' / '%s' / '%s'" % [ks._beats[0]["state"].text, said, ks._beats[1]["state"].text, ks._beats[2]["name"].text, ks._side_head.text])
	_check_fit(main, "the Radio, Kev's story")
	sim.story_beat = 3
	main._radio._shown = ""
	main.refresh()
	_check(ks._side_head.text.begins_with("THE DEPOT AGAIN"), "past the third the story view doesn't say the depot again: '%s'" % ks._side_head.text)
	_check_fit(main, "the Radio, Kev's story told")
	sim.story_beat = 1
	main._radio._pick_view("air")
	# a signal beaten brings the beat's next paper now and then
	var before: int = sim.story_held().size()
	sim._story_find()
	_check(sim.story_held().size() == before + 1, "no story paper came home: %d from %d" % [sim.story_held().size(), before])
	# the depot: the convoy
	sim.story_beat = 2
	for nm in sim.story_papers(2):
		sim.stash_put(sim._plain(Data.PAPER, nm))
	var dids: Array = sim.signal_papers().filter(func(x): return sim.story_of(x) == 2).map(func(x): return int(x["id"]))
	var dg: Dictionary = sim.decrypt(dids)
	_check(bool(dg.get("convoy_fight", false)) and not bool(dg["head"]), "the depot's signal isn't the convoy: %s" % str(dg))
	var k: int = sim.signals.find(dg)
	var de: Dictionary = sim.signal_read(k)
	_check(de.get("convoy", false) and de.get("boss_queue", []).size() >= 1, "the depot's read has no convoy: %s" % str(de.keys()))
	sim.load_dict(saved)
	main.show_room(main.OVERVIEW)
	main.refresh()
	print("Kev's story ok: a beat's three together, never mixed, its site and crew and head, the story on, a paper home, the depot's convoy")


## The papers encrypted till the Radio (15 Oct): a code-carrying paper held before the Radio's open isn't read, its pick
## says "Encrypted" and its words hide the code; the Radio opening reads every paper held at once. Papers roll common
## to rare, no higher.

## Every paper's card (16 Oct, Matt: "do a pass on all the papers"): picked in the Kit, it fits; before the Radio every
## one says the same line, its chips nothing but glyphs; after, a coded one's first chip is its code, one with none
## has no chips and says so, and its words lead with the code line.
func _paper_pass(main, radio_open: bool) -> void:
	var sim = main.sim
	var IH = load("res://scripts/ui/item_head.gd")
	var latin := RegEx.new()
	latin.compile("[A-Za-z0-9]")
	var n := 0
	for p in Words.PAPERS:
		var pb: String = str(p["name"])
		if sim.story_of({"base": pb, "slot": Data.PAPER}) >= 0:
			continue
		var it: Dictionary = sim._plain(Data.PAPER, pb)
		sim.stash_put(it)
		main.show_room(main.ARMOURY)
		main._armoury.selected = {"kind": "stash", "id": it["id"]}
		main.refresh()
		_check_fit(main, "the Kit with %s (the Radio %s)" % [pb, "open" if radio_open else "shut"])
		var chips: Array = IH.paper_chips(it, sim)
		var taught: String = sim.word_taught_by(pb)
		var tail: String = main._armoury._head._tail.text
		if not radio_open:
			_check(tail.contains("encrypted till the Radio's open") and not chips.is_empty() and chips.all(func(c): return latin.search(str(c["forms"][0])) == null),
				"%s before the Radio: '%s', chips %s" % [pb, tail, str(chips.map(func(c): return c["forms"][0]))])
		elif taught != "":
			_check(not chips.is_empty() and str(chips[0]["forms"][0]) == taught and tail.contains(taught.to_lower()), "%s after the Radio: '%s', chips %s" % [pb, tail, str(chips.map(func(c): return c["forms"][0]))])
		else:
			_check(chips.is_empty() and tail.contains("no code"), "%s (no code) after the Radio: '%s', %d chips" % [pb, tail, chips.size()])
		# no worth on a paper's card (16 Oct, Matt): no price tag, no tins for a headline
		var pk = main._armoury._pick
		_check(not pk._tags[0].visible and not main._armoury._head._figure.text.contains("tin") and not main._armoury._head._unit.text.contains("Fence"), "%s's card shows its worth: tag %s, '%s %s'" % [pb, str(pk._tags[0].visible), main._armoury._head._figure.text, main._armoury._head._unit.text])
		sim.stash.erase(it)
		n += 1
	# Kev's story's papers: the tail says so (not "no code"), and the right column's line is whole, wrapped not cut
	if radio_open:
		for beat in range(Data.STORY_BEATS.size()):
			var sp: Array = sim.story_papers(beat)
			if sp.is_empty():
				continue
			var it: Dictionary = sim._plain(Data.PAPER, str(sp[0]))
			sim.stash_put(it)
			main.show_room(main.ARMOURY)
			main._armoury.selected = {"kind": "stash", "id": it["id"]}
			main.refresh()
			_check_fit(main, "the Kit with Kev's %s" % str(sp[0]))
			var pk = main._armoury._pick
			var shown: String = " ".join(pk._right_lines.map(func(l): return l.text)).strip_edges()
			var want: String = str(sim.paper_lines(it)[2])
			_check(main._armoury._head._tail.text.begins_with("Kev's story") and shown.contains(want) and pk._right_lines.all(func(l): return UI.text_width(l, l.text) <= l.size.x + 0.5), "Kev's %s: tail '%s', right lines '%s' (want '%s')" % [str(sp[0]), main._armoury._head._tail.text, shown, want])
			sim.stash.erase(it)
			n += 1
	print("  every paper's card, the Radio %s: %d" % ["open" if radio_open else "shut", n])

func _paper_crypt_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.unlocked.erase("radio")
	sim.book = []
	var base := ""
	for p in Words.PAPERS:
		if p.has("code") and sim.word_taught_by(str(p["name"])) != "":
			base = str(p["name"])
			break
	var pp: Dictionary = sim._plain(Data.PAPER, base)
	sim.stash_put(pp)
	sim._read(pp)
	_check(not (base in sim.book) and sim.paper_lines(pp)[0] == "Encrypted", "a paper read before the Radio: in the book %s, '%s'" % [str(base in sim.book), sim.paper_lines(pp)[0]])
	var code_line: String = str(Words.PAPERS.filter(func(x): return x["name"] == base)[0]["code"])
	_check(not Words.paper_words(base, false).contains(code_line) and Words.paper_words(base, true).begins_with(code_line), "a paper's code isn't hidden before the Radio: '%s'" % Words.paper_words(base, false))
	main.show_room(main.ARMOURY)
	main._armoury.selected = {"kind": "stash", "id": pp["id"]}
	main.refresh()
	_check(not main._armoury._pick._words.text.contains(code_line), "the Kit's pick shows an encrypted paper's code: '%s'" % main._armoury._pick._words.text)
	_paper_pass(main, false)
	_check_fit(main, "the Kit with an encrypted paper")
	# an encrypted paper's chips draw from the garble's glyphs: every one in each Inter a chip uses (17 Oct, the review's
	# note: a font swap would leave boxes on the card, and nothing would say so)
	var IH := preload("res://scripts/ui/item_head.gd")
	var no_glyph := ""
	for w in ["Regular", "Medium", "SemiBold"]:
		var f: Font = load("res://fonts/Inter-%s.ttf" % w)
		for ch in IH.GARBLE:
			if not f.has_char(ch.unicode_at(0)):
				no_glyph += "%s (%s) " % [ch, w]
	_check(no_glyph == "", "an encrypted paper's glyphs Inter can't draw: %s" % no_glyph)
	_check(main._armoury._head._tail.text.contains("encrypted") and not main._armoury._head._tail.text.contains("the code for"), "the Kit's pick line names an encrypted paper's code: '%s'" % main._armoury._head._tail.text)
	sim.sell_commons()
	_check(sim.stash.has(pp), "selling the commons sold a paper (the endgame's keys, 15 Oct)")
	sim._home_gate(sim._plain(Data.PAPER, "A military radio"))
	_check(sim.room_open("radio") and base in sim.book and sim.paper_lines(pp)[0] == "The Radio" and sim.paper_lines(pp)[1].begins_with("Carries"), "the Radio opening didn't read the paper held: %s / %s" % [str(sim.book), str(sim.paper_lines(pp))])
	main.refresh()
	_check_fit(main, "the Kit with a read paper")
	_paper_pass(main, true)
	var rr := RandomNumberGenerator.new()
	rr.seed = 7
	var top := 0
	for k in range(400):
		var it: Dictionary = Items.roll(Data.PAPER, 1, rr, 2.0)
		top = maxi(top, int(it["rarity"]))
	_check(top == Data.PAPER_RARITY_MAX, "papers roll to rarity %d, not %d" % [top, Data.PAPER_RARITY_MAX])
	sim.load_dict(saved)
	main.show_room(main.OVERVIEW)
	main.refresh()
	print("the papers encrypted ok: unread and hidden till the Radio, read at once when it opens, common to rare")


## Kev's pile (16 Oct, Matt's playtest: two plain papers and a story piece made no signal): a plain paper for notes, the
## price his, never a story piece, read into the book; the Radio's button and its lines; short of notes, the button off
## and the price on it; the papers' line counts the two kinds.
func _kev_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	if not sim.room_open("radio"):
		sim._home_gate(sim._plain(Data.PAPER, "A military radio"))
	_check(sim.campaign_done() or sim.kev_block() == "the campaign first", "Kev sells before the campaign's done: '%s'" % sim.kev_block())
	for i in range(Data.TIERS.size()):
		sim.best_depth[i] = maxi(1, int(sim.best_depth[i]))     # the campaign done, as a signal wants it (load_dict puts it back)
	for z in range(sim.bosses_beaten.size()):
		sim.bosses_beaten[z] = true
	sim.depot_cleared = true
	_check(sim.campaign_done(), "the campaign isn't done for Kev's checks")
	while not sim.stash_room(2) and not sim.stash.is_empty():
		sim.sell(sim.stash[0])
	var price: int = sim.kev_price()
	var kd: int = sim.tier_depth(sim.reach)
	_check(price >= Data.KEV_FLOOR and price == maxi(Data.KEV_FLOOR, roundi(Data.KEV_RUNS * float(Data.TIERS[sim.top_tier()]["pool"]) * ceilf(1.0 + (kd - 1) / 3.0))), "Kev's price is %d" % price)
	var keep_reach: int = sim.reach
	sim.reach = keep_reach + 12
	_check(sim.kev_price() > price, "Kev's price doesn't climb with the reach: %d at %d, %d at %d" % [price, keep_reach, sim.kev_price(), sim.reach])
	sim.reach = keep_reach
	sim.notes = price * 40
	var pages: Array = sim.book_pages()
	var bought := 0
	for k in range(30):
		var n0: int = sim.notes
		var it: Dictionary = sim.ask_kev()
		if it.is_empty():
			break
		bought += 1
		_check(Items.is_paper(it) and str(it["base"]) in pages and sim.story_of(it) < 0 and not Items.is_deeds(it), "Kev sold %s" % str(it.get("base", "")))
		_check(n0 - sim.notes == price and str(it["base"]) in sim.book, "Kev's paper cost %d notes (not %d) or went unread" % [n0 - sim.notes, price])
		if k == 0:
			_check(sim.events.back()[1].begins_with(Words.KEV_SOLD), "Kev's sale wasn't logged: '%s'" % sim.events.back()[1])
	_check(bought >= 20, "Kev sold %d of 30 with the notes and room" % bought)
	main.show_room(main.COMMS)
	var kept_view: String = main._radio.view
	main._radio._pick_view("air")              # the papers and the decoder, not the Dial (the campaign done opens on the map)
	main._radio._shown = ""
	main.refresh()
	var rd = main._radio
	_check(rd._kev.visible and not rd._kev.disabled and rd._kev.text.begins_with("Ask Kev"), "the Radio's Ask Kev is '%s', %s" % [rd._kev.text, "off" if rd._kev.disabled else "on"])
	_check(rd._papers_sub.text.begins_with("Plain"), "the papers' line doesn't count the plain ones: '%s'" % rd._papers_sub.text)
	_check_fit(main, "Radio (Kev's pile)")
	sim.notes = price - 1
	rd._shown = ""
	main.refresh()
	_check(rd._kev.disabled and rd._kev.text.contains("%d notes" % price), "short of notes, Ask Kev reads '%s', %s" % [rd._kev.text, "off" if rd._kev.disabled else "on"])
	_check(sim.ask_kev().is_empty() and sim.notes == price - 1, "Kev sold a paper on credit")
	var kb := Rect2(rd._kev_box.global_position, rd._kev_box.size)
	var dbox := Rect2(rd._decoder_box.global_position, rd._decoder_box.size)
	_check(dbox.encloses(kb), "Kev's pile leaves the decoder's column: %s in %s" % [str(kb), str(dbox)])
	main._radio.view = kept_view
	sim.load_dict(saved)
	main.show_room(main.OVERVIEW)
	main.refresh()
	print("Kev's pile ok: %d papers at %d notes, plain only, read, logged; the button and its price" % [bought, price])


## Training's gating (15 Oct, gating_training.png): an element tree's columns from the third want 6 in its class tree,
## from the fifth 12, the capstone 18; keystones at level 20, capstones at 30; the second past at 30 wants 20 in the
## first class tree; retirement at 50. On the screen: a padlocked pill in the gap before each band, inside the lane and
## clear of the tiles; "Lv 20" by a keystone; the second past's line and its bar.
func _training_gate_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.set_class("Doorman")
	sim.tree = []
	sim.training_points = 400
	sim.xp = Data.xp_for_level(15)
	sim.best_level = maxi(sim.best_level, 15)    # a Pitch point opens Blades (the Pitch circle, 24 Oct)
	var core: String = sim.core_tree("Blades")
	_check(core == "Muscle" and sim.first_tree() == "Muscle", "Blades' core reads '%s', the first tree '%s'" % [core, sim.first_tree()])
	var bt: Dictionary = Data.tree_named("Blades")
	var col2 := ""
	var key_id := ""
	var cap_id := ""
	for i in range(bt["nodes"].size()):
		var nd: Dictionary = bt["nodes"][i]
		if int(nd.get("col", 0)) == 2 and col2 == "":
			col2 = "Blades/%d" % i
		if nd.get("keystone", false):
			key_id = "Blades/%d" % i
		if nd.get("capstone", false):
			cap_id = "Blades/%d" % i
	# Blades' first two columns, then the third straight off the path (the web, 22 Oct: no core gate, the pair gates gone)
	sim.element_points["bleed"] = int(sim.element_points.get("bleed", 0)) + 60     # the element's own points (slice 3)
	for i in range(bt["nodes"].size()):
		if float(bt["nodes"][i]["at"][0]) < 2.0 and absf(float(bt["nodes"][i]["at"][1])) <= 1.0:
			_walk(sim, "Blades/%d" % i)
	_check(sim.train_block(col2) == "", "Blades' third column with nothing in Muscle wants something: '%s'" % sim.train_block(col2))
	# the path hint never names another class's half (the review): a Poacher on Blades past the Doorman's half
	var cls_was: String = sim.cls
	var tree_was: Array = sim.tree.duplicate()
	sim.cls = "Poacher"
	sim.tree = []
	for i in range(bt["nodes"].size()):
		if float(bt["nodes"][i]["at"][0]) < 3.0 and absf(float(bt["nodes"][i]["at"][1])) <= 1.0:
			sim.tree.append("Blades/%d" % i)
	var hint: String = sim.path_next(key_id)
	_check(hint != "" and not sim.node(hint).has("class") and sim.train_block(hint) == "", "the path hint to Blades' keystone for a Poacher is '%s' (%s)" % [hint, sim.train_block(hint) if hint != "" else "none"])
	sim.cls = cls_was
	sim.tree = tree_was
	var mt: Dictionary = Data.tree_named("Muscle")
	# keystones and capstones wait for their levels, everything else met
	var t_was: Array = sim.tree.duplicate()
	for i in range(mt["nodes"].size()):
		var nd: Dictionary = mt["nodes"][i]
		if not nd.get("keystone", false) and not nd.get("capstone", false) and Data.for_classes(nd, sim.my_classes()):
			sim.tree.append("Muscle/%d" % i)
	var mkey := ""
	var mcap := ""
	for i in range(mt["nodes"].size()):
		if mt["nodes"][i].get("keystone", false):
			mkey = "Muscle/%d" % i
		if mt["nodes"][i].get("capstone", false):
			mcap = "Muscle/%d" % i
	_check(sim.train_block(mkey, true) == "opens at level %d" % Data.KEYSTONE_LEVEL, "a keystone at level 15: '%s'" % sim.train_block(mkey, true))
	sim.xp = Data.xp_for_level(Data.KEYSTONE_LEVEL)
	_check(sim.train_block(mkey, true) == "", "a keystone at level 20: '%s'" % sim.train_block(mkey, true))
	sim.tree.append(mkey)
	_check(sim.train_block(mcap, true) == "opens at level %d" % Data.CAPSTONE_LEVEL, "a capstone at level 20: '%s'" % sim.train_block(mcap, true))
	_check(key_id != "" and cap_id != "", "Blades has no keystone or capstone")
	sim.tree = t_was
	sim.xp = Data.xp_for_level(30)
	# the screen: pills and tags placed
	main.show_room(main.BARRACKS)
	main.refresh()
	var bk = main._barracks
	bk._shown = ""
	bk.show_state(sim)
	bk.selected = ""
	bk._shown = ""
	bk.show_state(sim)
	_check_fit(main, "Training with its gates")
	# a keystones-first bot under level 20 still spends once a tree's next node is its keystone (the review)
	sim.tree = []
	sim.xp = Data.xp_for_level(15)
	_train_to(sim, "Muscle", 1)
	for i in range(mt["nodes"].size()):
		if int(mt["nodes"][i].get("col", 0)) < int(sim.node(mkey).get("col", 0)) and Data.for_classes(mt["nodes"][i], sim.my_classes()):
			sim.tree.append("Muscle/%d" % i)
	sim.training_points = sim.points_spent() + 10
	var kb = Bot.new()
	kb.keystones_first = true
	kb._train_tree(sim)
	_check(sim.points_free() < 10, "a keystones-first bot at level 15 banked its points for a keystone at 20: %d free" % sim.points_free())
	sim.load_dict(saved)
	main.show_room(main.OVERVIEW)
	main.refresh()
	print("training's gating ok: the core's 6, 12 and 18, keystones at 20 and capstones at 30, the second past on 20 in the first tree, retirement at 50, the pills and tags placed")


## The search's column (14 Oct, mockups search_mockup3/4): the crates under the six and inside the column, the rig
## under them and clear of the buttons, the floor's cells, its ? and its pages inside the panel and off each other, the
## take's tiles and note folded away.
func _search_layout(main, where: String) -> void:
	var run = main._run
	if not run._crates.visible:
		_check(false, where + ": the crates are not up")
		return
	var cr := Rect2(run._crates.position, run._crates.size)
	var six_end: float = run.VIEW_ROW_Y + UI.TILE_H if run._view != null else 0.0
	_check(Rect2(Vector2.ZERO, run._left.size).encloses(cr) and cr.position.y >= six_end, "%s: the crates leave the column or sit on the six: %s" % [where, str(cr)])
	_check(run._rig_head.position.y >= cr.end.y and run._rig_head.visible, "%s: the rig's head is over the crates (%.0f against %.0f)" % [where, run._rig_head.position.y, cr.end.y])
	var top := 1e9
	var bottom := 0.0
	for k in range(run._rig_cells.size()):
		for n in [run._rig_cells[k], run._rig_outlines[k]]:
			if n.visible:
				top = minf(top, n.position.y)
				bottom = maxf(bottom, n.position.y + n.size.y)
	_check(bottom <= run._button.position.y and (bottom == 0.0 or top >= run._rig_head.position.y + run._rig_head.size.y), "%s: the rig runs %.0f to %.0f, the buttons at %.0f" % [where, top, bottom, run._button.position.y])
	_check(not run._take_head.visible and not run._note.visible and not run._take_strip["panel"].visible, where + ": the take's strip is still up under the crates")
	var box := Rect2(Vector2.ZERO, run._crates.size)
	var shown: Array = []
	for c in run._crates._cells + [run._crates._query]:
		if c.visible:
			shown.append(Rect2(c.position, c.size))
	for t in run._crates._tiles + [{"panel": run._crates._more}]:
		if t["panel"].visible:
			shown.append(Rect2(t["panel"].position, t["panel"].size))
	for b in [run._crates._prev, run._crates._next_page, run._crates._page_label]:
		if b.visible:
			shown.append(Rect2(b.position, b.size))
	for a in range(shown.size()):
		_check(box.encloses(shown[a]), "%s: %s runs out of the crates panel" % [where, str(shown[a])])
		for b in range(a + 1, shown.size()):
			_check(not shown[a].intersects(shown[b]), "%s: %s and %s overlap in the crates panel" % [where, str(shown[a]), str(shown[b])])


## The crates (13 Oct, docs/design/search_crates.md): a cleared site's search is its crates, in the dice's order, their
## searches adding up to thin_after (depth and quantity push it); each crate's finds lean to its kind; all open, the
## site's picked clean - nothing more found, and the auto-run and "Fill up" go; the Kennel's top rank noses each
## crate's best find at the clear and it's the crate's first; the crates in the left column under the six (14 Oct),
## the rig under them and the pick panel beside, show it all and fit; the save keeps the crates.
func _crates_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var hold_pack = sim.equipped["Backpack"]
	var hold_kennel: String = sim.yard_side("kennel", 4)
	_yard_set(sim, "kennel", 4, "")
	sim.equipped["Backpack"] = null
	sim.tree = sim.tree.filter(func(id): return not str(id).begins_with("The Rat Man/"))
	sim.set_depth(3, 1)
	sim.deploy(3)
	var m: Dictionary = sim.mission
	var t: Dictionary = m["t"]
	var n: int = sim.thin_after(t)
	_check(n >= Data.THIN_AFTER, "thin_after at depth 1 reads %d" % n)
	m["remaining"] = 0
	m["cleared"] = true
	m["patrol_timer"] = -1e9
	m["event_at"] = -1.0
	m["leave_full"] = false
	sim._roll_crates(m, t)
	var total := 0
	var keys_ok := true
	for q in m["crates"]:
		total += 0 if q.get("locked", false) else int(q["searches"])     # a locked one's over and above (13 Oct)
		keys_ok = keys_ok and not sim.crate_def(str(q["key"])).is_empty() and int(q["done"]) == 0
		_check(str(q["key"]) != "military", "a military crate on the Streets (the estate's before the town)")
	_check(keys_ok and total >= n and total < n + 4, "the crates' searches add to %d against %d" % [total, n])
	var first_i: int = 0
	while not sim.has_keys() and m["crates"][first_i].get("locked", false):
		first_i += 1                          # the locked ones before it passed over (13 Oct)
	_check(int(m["crate_i"]) == first_i and sim.crate_now(m) == m["crates"][first_i] and not sim.crates_done(m), "the first crate is not the one in hand")
	# the panel: under the pack, the pack two rows a page, and it fits with nothing open
	main.show_room(main.MISSIONS)
	main.refresh()
	var run = main._run
	_check(run._crates.visible and run._pick.visible and run._crates.get_parent() == run._left and run._inv.page_rows == run._inv.ROWS, "the crates are not in the left column with the pick panel beside, the pack whole")
	_check(run._crates._head.text.contains("0 OF %d OPEN" % m["crates"].filter(func(q): return not q.get("locked", false)).size()) and run._crates._head.text.contains("PACK %d OF %d" % [sim.pack_used(m), sim.capacity()]), "the crates' head reads '%s'" % run._crates._head.text)
	_check(run._fight["bar_text"].text.begins_with(str(sim.crate_now(m)["name"])), "the search bar does not name the crate in hand: '%s'" % run._fight["bar_text"].text)     # a locked first one passed over (13 Oct)
	_search_layout(main, "the crates")
	_check_fit(main, "Run (the crates)")
	# HP low with the take's note folded away: the warning on the crates' head (the review)
	sim.hp = sim.max_hp() * 0.2
	main.refresh()
	_check(run._crates._head.text.begins_with("HP LOW") and not run._note.visible, "HP low under the crates does not warn: '%s'" % run._crates._head.text)
	_check_fit(main, "Run (the crates, HP low)")
	sim.hp = sim.max_hp()
	main.refresh()
	_check(not run._crates._head.text.begins_with("HP LOW"), "the warning stayed on the crates' head with HP back")
	# the pictures inside their tiles (a TextureRect sized before its expand mode keeps the texture's 64 px)
	var tile_box := Rect2(Vector2.ZERO, run._crates._tiles[0]["panel"].size)
	for tl in run._crates._tiles:
		for part in ["art", "glass", "lock", "name", "pips"]:
			var rc := Rect2(tl[part].position, tl[part].size)
			_check(tile_box.encloses(rc), "a crate tile's %s runs out of it: %s in %s" % [part, str(rc), str(tile_box)])
	_check(Rect2(Vector2.ZERO, run._crates._query.size).encloses(Rect2(run._crates._query_glass.position, run._crates._query_glass.size)), "the ? cell's magnifier runs out of it")
	# opening: the first crate's searches, its finds kept on it, then the next in hand
	var first: Dictionary = m["crates"][first_i]
	var finds0: int = int(m.get("finds", 0))
	for k in range(int(4.0 * sim.search_s(t)) + 4):
		sim.hp = sim.max_hp()
		sim.advance(1.0)
		main.refresh()                       # the view looks as it plays: an opening seen at once is "just opened"
		if not sim.on_mission() or int(m["crate_i"]) > first_i:
			break
	_check(sim.on_mission() and int(m["crate_i"]) > first_i and int(first["done"]) == int(first["searches"]), "the first crate did not open in its searches: %d of %d, on %d" % [int(first["done"]), int(first["searches"]), int(m["crate_i"])])
	_check(first["finds"].size() > 0 and first["finds"].size() <= int(m.get("finds", 0)) - finds0, "the first crate kept %d finds against %d found" % [first["finds"].size(), int(m.get("finds", 0)) - finds0])
	main.refresh()
	_check(run._crates._finds_head.text.begins_with("ON THE FLOOR") or run._crates._finds_head.text.begins_with("STRAIGHT INTO THE PACK"), "the reveal's head reads '%s'" % run._crates._finds_head.text)
	# the one just opened (14 Oct, Matt: "a small view of it open"): its tile reads opened, and in the frame it's set
	# down open, the bar naming it, for its moment; then gone, the bar back on the one in hand
	var first_k: int = first_i - clampi(int(m["crate_i"]) - 1, 0, maxi(0, m["crates"].size() - CratesPanel.SHOWN))
	_check(first_k < 0 or first_k >= CratesPanel.SHOWN or (run._crates._more.visible and first_k == CratesPanel.SHOWN - 1) or run._crates._tiles[first_k]["pips"].text == "opened", "the opened crate's tile does not say so")
	var v = run._view
	if v != null:
		_check(v.state()["open"] and str(v.opened().get("name", "")) == str(first["name"]) and int(v.opened()["finds"]) == first["finds"].size(), "the crate just opened is not set down open in the frame: %s" % str(v.opened()))
		_check(v._open_c.texture == CratesPanel.crate_texture(str(first["key"]), true)[0], "the crate just opened is not in its open art")
		main.refresh()
		_check(run._fight["bar_text"].text.begins_with(str(first["name"]) + " opened"), "the search bar does not name the crate just opened: '%s'" % run._fight["bar_text"].text)
		v._process(0.0)
		_check(Rect2(Vector2.ZERO, Vector2(RunView.W, RunView.H)).encloses(Rect2(v._open_tag.position, v._open_tag.size)) and v._open_tag.position.y + v._open_tag.size.y <= run.OVER_Y - run.FIGHT_BOX_Y, "the opened crate's tag leaves the frame or sits on the bar")
		_check_fit(main, "Run (a crate open)")
		v._process(RunView.OPEN_S + 0.1)
		main.refresh()
		_check(not v.state()["open"] and not v._open_c.visible and not run._fight["bar_text"].text.contains(" opened"), "the crate just opened stayed past its moment: '%s'" % run._fight["bar_text"].text)
		# a gang comes: it goes at once
		v._show_open(first)
		m["remaining"] = 2
		main.refresh()
		_check(not v.state()["open"], "the crate just opened stayed up through a gang")
		m["remaining"] = 0
		main.refresh()
	_check_fit(main, "Run (a crate open, after)")
	# the pick panel stays the pick's (14 Oct, Matt): a pick in the pack compares there with the crates still up
	if not m["found"].is_empty():
		run._inv.selected = int(m["found"][0]["id"])
		run._on_inv_pick(int(m["found"][0]["id"]))
		main.refresh()
		_check(run._pick.visible and run._crates.visible, "a pick hid the crates or the pick panel")
		run._inv.selected = -1
	# the floor (13 Oct, Matt): by hand, a search's finds wait on the floor; taken into the pack only if they fit; a
	# thing ditched is gone, its scrap paid (21 Oct, Matt: no taking it back); the row shows them; a click compares, Take
	# takes; "Fill up, then go" picks up what fits; what's left is passed over at the door; the bot takes as it goes
	_check(sim.by_hand(m) and not sim.floor_items().is_empty(), "a search by hand left nothing on the floor")
	_check(m["found"].all(func(x): return not m["crates"].any(func(q): return q["finds"].any(func(f): return int(f["id"]) == int(x["id"]) and not Items.stacks(x)))), "a search by hand put a find straight in the pack")
	main.refresh()
	_check(run._crates._finds_head.text.begins_with("ON THE FLOOR") and run._crates._cells[0].visible and run._crates._floor_ids[0] >= 0, "the floor's row does not show the floor: '%s'" % run._crates._finds_head.text)
	_check_fit(main, "Run (the floor)")
	var fl0: Dictionary = sim.floor_items().back()
	run._pick_floor(int(fl0["id"]))
	main.refresh()
	_check(run._pick.visible and run._crates.visible and run._pick._kickers[0].text.to_lower().contains("on the floor") and run._pick._buttons[0].visible and run._pick._buttons[0].text == "Take", "a click on the floor did not show its comparison and Take: %s" % run._pick._kickers[0].text)
	_check_fit(main, "Run (a pick on the floor)")
	var fits0: bool = sim.floor_fits(fl0)
	var found_n: int = m["found"].size()
	run._take_floor(int(fl0["id"]))
	main.refresh()
	_check(fits0 == (not sim.floor_items().has(fl0) or Items.stacks(fl0)) and (not fits0 or m["found"].size() >= found_n), "Take did not move the thing off the floor when it fit, or did when it didn't")
	if not m["found"].is_empty():
		var back: Dictionary = m["found"].back()
		var scrap0: int = int(m.get("scrap", 0))
		if not Items.is_deeds(back) and sim.ditch(int(back["id"])):
			_check(not sim.floor_items().has(back) and not m["found"].has(back) and int(m.get("scrap", 0)) == scrap0 + sim.scrap_of(back), "a ditched thing wasn't destroyed with its scrap paid: on the floor %s, scrap %d from %d" % [str(sim.floor_items().has(back)), int(m.get("scrap", 0)), scrap0])
			_check(not sim.take_floor(int(back["id"])) and not m["found"].has(back), "a ditched thing could be taken back")
	# no room: it stays down
	var hold_cap_pack = sim.equipped["Backpack"]
	var floor_n: int = sim.floor_items().size()
	if floor_n > 0:
		var cells_free: int = sim.capacity() - sim.pack_used(m)
		var big: Dictionary = sim.floor_items()[0]
		if Items.size(big) > cells_free and not Items.stacks(big):
			_check(not sim.take_floor(int(big["id"])) and sim.floor_items().size() == floor_n, "a thing too big for the pack was taken")
	sim.equipped["Backpack"] = hold_cap_pack
	# the bot's way: straight in
	sim.loot_by_hand = false
	_check(not sim.by_hand(m), "the bot's searches go on the floor")
	sim.loot_by_hand = true
	m["leave_full"] = true
	_check(not sim.by_hand(m), "Fill up, then go still leaves finds on the floor")
	m["leave_full"] = false
	# a stack found shows what was found, not what was left once it joined the pack's (the review, 13 Oct)
	for q in m["crates"]:
		for f in q["finds"]:
			if Items.is_ammo(f):
				_check(int(f["rounds"]) > 0, "a crate shows %s found with %d rounds" % [f["base"], int(f["rounds"])])
	# a clear on a site already searching (a Ghost's first gang beaten) keeps its crates
	var queue_before: Array = m["crates"]
	var at_i: int = int(m["crate_i"])
	sim._clear(m, m["t"])
	_check(m["crates"] == queue_before and int(m["crate_i"]) == at_i, "a second clear rolled the crates again")
	# the save keeps them
	var mid: Dictionary = JSON.parse_string(JSON.stringify(sim.to_dict()))
	var crate_i: int = int(m["crate_i"])
	var count: int = m["crates"].size()
	sim.load_dict(mid)
	m = sim.mission
	_check(m != null and m.has("crates") and m["crates"].size() == count and m["crate_i"] is int and m["crate_i"] == crate_i and m["crates"][0]["searches"] is int,
		"the save did not keep the crates")
	main.refresh()
	# all open: picked clean, nothing more found
	m["patrol_timer"] = -1e9
	m["clock"] = 1e12                # time for the gang that never comes: picked clean, it stays (the run home on its own is checked apart)
	m["event_at"] = -1.0
	for k in range(int((total + 2) * sim.search_s(m["t"])) + 4):
		sim.hp = sim.max_hp()
		m["remaining"] = 0
		sim.advance(1.0)
		main.refresh()
		if not sim.on_mission() or sim.crates_done(m):
			break
	_check(sim.on_mission() and sim.crates_done(m), "the crates did not all open")
	if sim.on_mission() and run._view != null:
		# the last one opened is named for its moment too, then picked clean (the review)
		var last_j: int = m["crates"].size() - 1
		while last_j >= 0 and m["crates"][last_j].get("passed", false):
			last_j -= 1
		main.refresh()
		_check(last_j < 0 or run._fight["bar_text"].text.begins_with(str(m["crates"][last_j]["name"]) + " opened"), "the last crate's opening is not named: '%s'" % run._fight["bar_text"].text)
		run._view._process(RunView.OPEN_S + 0.1)
	if sim.on_mission():
		var f_done: int = int(m.get("finds", 0))
		var s_done: int = int(m["searches"])
		for k in range(int(3.0 * sim.search_s(m["t"])) + 2):
			sim.hp = sim.max_hp()
			m["remaining"] = 0
			sim.advance(1.0)
		_check(sim.on_mission() and int(m.get("finds", 0)) == f_done and int(m["searches"]) == s_done, "a picked-clean site still finds: %d → %d" % [f_done, int(m.get("finds", 0))])
		main.refresh()
		_check(run._crates._head.text.contains("ALL %d OPEN" % m["crates"].filter(func(q): return not q.get("locked", false)).size()) and run._fight["bar_text"].text.begins_with("Picked clean"), "picked clean does not read so: '%s' / '%s'" % [run._crates._head.text, run._fight["bar_text"].text])
		_check_fit(main, "Run (picked clean)")
		# "Fill up, then go" goes: nothing more to stay for
		m["leave_full"] = true
		sim.advance(0.5)
		_check(not sim.on_mission(), "Fill up, then go stayed on a picked-clean site")
	# the leans: an ammo tin's finds mostly rounds, a medicine cabinet's meds (rounds come only for a gun owned: a
	# pistol in the stash for the read, 22 Oct)
	sim.deploy(3)
	m = sim.mission
	var lean_pistol: Dictionary = sim._plain("Secondary", "Service pistol")
	sim.stash.append(lean_pistol)
	for pair in [["ammo_tin", Data.AMMO, 0.55], ["medicine", Data.MEDICAL, 0.45], ["filing", Data.PAPER, 0.3]]:
		var hit := 0
		var all := 0
		for k in range(300):
			var got: Dictionary = sim._find(m, m["t"], false, sim.crate_def(pair[0]), true)
			if got.is_empty():
				continue
			all += 1
			hit += 1 if got["it"]["slot"] == pair[1] else 0
		_check(all > 0 and float(hit) / float(all) >= float(pair[2]), "a %s's finds are %d of %d %s (ammo types owned: %s)" % [pair[0], hit, all, pair[1], str(sim.owned_ammo_types(m))])
	sim.stash.erase(lean_pistol)
	# a site's own: the Barracks' military crates, the Bank's safes, none of either in the Outskirts
	var w_barracks: Dictionary = sim.crate_weights({"tier": Data.TIERS.size() - 1, "depth": 1})
	var w_bank: Dictionary = sim.crate_weights({"tier": 8, "depth": 1})
	var w_allot: Dictionary = sim.crate_weights({"tier": 0, "depth": 1})
	_check(w_barracks.get("military", 0.0) > w_barracks.get("toolbox", 0.0) and w_bank.get("safe", 0.0) > w_bank.get("toolbox", 0.0), "the Barracks' or the Bank's own crates don't lead: %s / %s" % [str(w_barracks), str(w_bank)])
	_check(not w_allot.has("military") and not w_allot.has("safe"), "a safe or a military crate in the Outskirts: %s" % str(w_allot))
	_check(sim.crate_weights({"tier": 8, "depth": 6})["safe"] > w_bank["safe"], "depth did not grow the safes")
	# a code's crates (13 Oct): Delivery day brings military crates, even to a site that wouldn't have them yet; its
	# tier grows it; the pay says so
	var dd: Dictionary = sim.word_effect("Delivery day", 1)
	_check(is_equal_approx(float(dd.get("crates", {}).get("military", 0.0)), 2.0) and float(sim.word_effect("Delivery day", 2)["crates"]["military"]) > 2.0, "Delivery day's crates read %s" % str(dd.get("crates", {})))
	var w_coded: Dictionary = sim.crate_weights({"tier": 0, "depth": 1, "crates": dd["crates"]})
	_check(w_coded.get("military", 0.0) > 0.0 and not w_coded.has("safe"), "a code's military crate is not on an Outskirts site: %s" % str(w_coded))
	_check(is_equal_approx(float(sim.crate_weights({"tier": 11, "depth": 1, "crates": dd["crates"]})["military"]), 2.0 * float(w_barracks["military"])), "a code did not double the Barracks' military crates")
	_check(str(sim.word_words("Delivery day", 1)[1]).contains("military crates ×2") and str(sim.word_words("Pawned", 1)[1]).contains("jewellery boxes ×2.5"), "the pay does not say the crates: '%s' / '%s'" % [sim.word_words("Delivery day", 1)[1], sim.word_words("Pawned", 1)[1]])
	for w in Data.WORDS:
		for key in w["pay"].get("crates", {}):
			_check(not sim.crate_def(key).is_empty(), "%s names a crate there isn't: %s" % [w["name"], key])
	sim.extract_now()
	# the dog's nose (the Kennel's top rank): each crate's best find rolled at the clear, shown, and the crate's first
	_yard_set(sim, "kennel", 4, "a")
	_check(sim.dog_sniffs(), "the Kennel's top rank does not nose the crates")
	sim.deploy(3)
	m = sim.mission
	m["remaining"] = 0
	m["cleared"] = true
	m["patrol_timer"] = -1e9
	m["clock"] = 1e12                # time for the gang that never comes: picked clean, it stays (the run home on its own is checked apart)
	m["event_at"] = -1.0
	sim._roll_crates(m, m["t"])
	_check(m["crates"].all(func(q): return q.has("held")), "a crate with nothing nosed in it")
	var nosed_q: Dictionary = sim.crate_now(m)          # the first one opened: a locked one before it is passed over without the Keys
	var held_id: int = int(nosed_q["held"]["it"]["id"])
	for k in range(int(2.0 * sim.search_s(m["t"])) + 4):
