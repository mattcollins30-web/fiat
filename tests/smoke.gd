## A skill's hit as the sim lands it: the runner's hits, cut by the man's resist (less what a pat-down took) and lifted
## by a shock, as a gun's are (25 Oct, the review: skills had skipped the resist).
func _skill_hit_expected(sim, m: Dictionary, mult: float, ty := "physical") -> float:
	var r_ty: float = float(m["t"].get("res", {}).get(ty, 0.0)) if m.has("t") else 0.0
	if ty == "physical":
		r_ty = sim.phys_resist(r_ty)
	r_ty *= 1.0 - sim._skill_pat(m)
	var shock: float = (1.0 + sim.shock_amount()) if float(m.get("shock_t", 0.0)) > 0.0 else 1.0
	return sim._skill_base() * mult * (1.0 - r_ty) * shock


## The Issue (25 Oct, docs/design/the_issue.md): the switch to fiat, hard on piles; prices by the circulation; the rate;
## the burn; issued kit; the card and the Issuer's counter.
func _issue_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var hold: Dictionary = sim.to_dict()
	sim.issued = false
	sim.elapsed = 30.0 * 3600.0
	sim.cash = 48213906.0
	sim._notes = 1240
	var inf0: float = sim.inflation()
	var money: float = 48213906.0 + 1240.0 * Data.NOTE_TINS * inf0
	var held := 0.0
	var a_piece = null
	var worn_one: Dictionary = Items.roll("Armour", 5, RandomNumberGenerator.new()) if sim.equipped.get("Armour") == null else {}
	if not worn_one.is_empty():
		sim.equipped["Armour"] = worn_one     # the fixture wears a piece through the Issue
	for it in sim._kit_held():
		held += float(sim.sell_price(it))
		if a_piece == null and sim.sell_price(it) > 0 and not sim.stash.has(it):
			a_piece = it                     # a worn one: taken off after, it sells at the pile's rate too (the review)
	_check(a_piece != null, "the Issue's fixture: no worn piece to sell after it")
	var tins_was: int = sim.sell_price(a_piece) if a_piece != null else 0
	held += sim.exchange_held_worth()          # scrap, salvage and materials held join the pile (28 Oct, the review's A2)
	var pile: float = money + held
	var want: float = money * Data.FIAT_PILE_K * sqrt(pile) / pile
	# the Mint's card says what the win turns the pile into, before it (the third review's A1(a))
	var pv: Dictionary = sim.issue_preview()
	_check(absf(float(pv["fiat"]) - want) < 1.0, "the Mint's preview says ƒ%.0f, the Issue gives ƒ%.0f" % [float(pv["fiat"]), want])
	var mint_was: int = sim.rebuild_rank("mint")
	sim.rebuilt["mint"] = maxi(1, mint_was)
	var od_m = main._missions._order
	od_m._shown = ""
	od_m.show_state(sim)
	var mc: Dictionary = od_m.col("mint")
	var tipped_m: Array = mc["chips"]._panels.filter(func(p): return p.visible and p.tooltip_text.contains("his money"))
	_check(not tipped_m.is_empty() and mc["chips"]._labels.any(func(l): return l.get_parent().visible and l.text.contains("≈ƒ")), "the Mint's card doesn't warn what the win turns the pile into")
	if mint_was == 0:
		sim.rebuilt.erase("mint")
	od_m._shown = ""
	sim.issue()
	_check(sim.issued and absf(sim.cash - want) < 1.0 and sim._notes == 0, "the Issue: ƒ%.0f from a pile of %.0f with the stash's %.0f (want ƒ%.0f), notes %d" % [sim.cash, pile, held, want, sim._notes])
	if a_piece != null:
		var hard: float = Data.FIAT_PILE_K * sqrt(pile) / pile
		var expect: float = tins_was * hard     # its tins at the pile's rate, as the cash went
		_check(absf(float(sim.sell_price(a_piece)) - expect) <= maxf(2.0, expect * 0.02), "a piece held through the Issue sells for ƒ%d, not the pile's ƒ%.0f" % [sim.sell_price(a_piece), expect])
	_check(is_equal_approx(sim.inflation(), inf0 * Data.FIAT_SCALE), "fiat prices don't start from the Issue's: ×%.6f against ×%.6f" % [sim.inflation(), inf0 * Data.FIAT_SCALE])
	var big: float = Data.FIAT_PILE_K * sqrt(pile * 10.0)
	_check(big < sim.cash * 3.5, "a pile ten times bigger isn't hard on it: ƒ%.0f against ƒ%.0f" % [big, sim.cash])
	# prices follow the money
	var m0: float = sim.circ_mult()
	sim._earn(Data.FIAT_CIRC_SPAN * 0.5)
	_check(is_equal_approx(sim.circ_mult(), m0 + 0.5) and sim.inflation_pct() == 50, "the circulation's prices: ×%.2f, %d%%" % [sim.circ_mult(), sim.inflation_pct()])
	# a note reads as fiat: the crews' prices keep working
	var c0: float = sim.cash
	sim.notes -= 10
	_check(absf((c0 - sim.cash) - 10.0 * sim.note_price()) < 0.01, "ten notes after the Issue took ƒ%.2f, not ƒ%.2f" % [c0 - sim.cash, 10.0 * sim.note_price()])
	# the rate: a sale down, time back; a burn up and the circulation down
	sim.fiat_rate = 1.0
	sim._rate_after_sale(sim._rate_unit() * 5.0)
	_check(is_equal_approx(sim.fiat_rate, 1.0 - 5.0 * Data.RATE_SALE_STEP), "a sale didn't move the rate: %.3f" % sim.fiat_rate)
	var r0: float = sim.fiat_rate
	sim.advance(3600.0)
	_check(sim.fiat_rate > r0, "the rate didn't drift back: %.3f" % sim.fiat_rate)
	sim.cash = 1e9
	var circ_hold: float = sim.circulation
	sim.circulation = 0.0
	_check(not sim.burn_moves() and not sim.can_burn() and not sim.burn(), "a burn with nothing in circulation still spends (the third review)")
	sim.circulation = circ_hold
	var circ0: float = sim.circulation
	var rb: float = sim.fiat_rate
	_check(sim.burn() and sim.circulation < circ0 and sim.fiat_rate > rb, "a burn: circulation %.0f from %.0f, the rate %.3f from %.3f" % [sim.circulation, circ0, sim.fiat_rate, rb])
	# the money's calls (Matt, 26 Oct): circulation drains, a burn takes a share, notes paid are income, held kit's
	# fiat is the Issue's
	sim.circulation = Data.FIAT_CIRC_SPAN
	sim.advance(Data.CIRC_HALF_H * 3600.0)
	_check(absf(sim.circulation - Data.FIAT_CIRC_SPAN * 0.5) < Data.FIAT_CIRC_SPAN * 0.02, "circulation didn't halve in its half-life: %.0f" % sim.circulation)
	var cb: float = sim.circulation
	var seal: float = Data.FX["rule/issued_seal.burn"] if sim.has_rule("issued_seal") else 1.0
	_check(sim.burn() and absf(sim.circulation - cb * (1.0 - Data.BURN_SHARE * seal)) < 2.0, "a burn didn't take its share: %.0f from %.0f" % [sim.circulation, cb])
	var cn: float = sim.circulation
	var cin: float = sim.cash_in
	sim.notes += 10
	_check(sim.circulation > cn and sim.cash_in > cin, "notes paid after the Issue aren't income: circulation %.0f from %.0f" % [sim.circulation, cn])
	if a_piece != null:
		var c_hold: float = sim.circulation
		sim.circulation = 0.0
		var at_one: int = sim.sell_price(a_piece)
		sim.circulation = Data.FIAT_CIRC_SPAN * 2.0
		_check(absi(sim.sell_price(a_piece) - at_one) <= 1, "a piece held through the Issue rides prices up: ƒ%d at ×1, ƒ%d at ×3" % [at_one, sim.sell_price(a_piece)])
		sim.circulation = c_hold
	# prices after the Issue: never ƒ0 for what cost something, the Clinic's shelf at today's (the third review)
	for box in Data.BASES[Data.AMMO].filter(func(b): return not b.has("damage_pct")):
		_check(sim.ammo_price(str(box["type"])) >= 1, "after the Issue %s costs ƒ%d" % [box["name"], sim.ammo_price(str(box["type"]))])
	var shelf_kit: Dictionary = sim._plain(Data.MEDICAL, "First aid kit")
	_check(sim.clinic_price(shelf_kit) >= 1, "after the Issue the Clinic's shelf reads ƒ%d" % sim.clinic_price(shelf_kit))     # med_price (the list, the same sum) gone (31 Oct)
	# issued kit over the runner's level: shown, not sold (the third review)
	var xp_hold: float = sim.xp
	sim.xp = 0.0
	for u in Data.ISSUED:
		var sl0: String = str(u["slot"])
		_check(sim.wear_lock(sim.issued_piece(sl0)) == 0 or (sim.issued_block(sl0).begins_with("Wear at") and not sim.buy_issued(sl0)), "the Issuer sells a level-1 runner a %s it can't wear: '%s'" % [sl0, sim.issued_block(sl0)])
	sim.xp = maxf(xp_hold, Data.xp_for_level(Data.MAX_LEVEL))
	# issued kit: a piece a slot, numbered, kept on a death (an empty stash, so a full one from the run so far can't refuse)
	var stash_hold: Array = sim.stash.duplicate()
	sim.stash.clear()
	var bought: Array = []
	for u in Data.ISSUED:
		var sl: String = str(u["slot"])
		var before: int = sim.stash.filter(func(x): return not Items.is_mag(x)).size()     # a gun's magazine comes with it (30 Oct)
		var shown: Dictionary = sim.issued_piece(sl)
		_check(sim.buy_issued(sl) and sim.stash.filter(func(x): return not Items.is_mag(x)).size() == before + 1, "the Issuer didn't sell the %s: '%s'" % [sl, sim.issued_block(sl)])
		var it: Dictionary = sim.stash.back()
		bought.append(it)
		_check(it.get("issued", false) and Items.full_name(it).contains("No.") and str(it["rule"]) == str(u["rule"]) and Items.ilvl(it) == Items.ilvl(shown), "the %s came without its stamp, rule or level: %s" % [sl, Items.full_name(it)])
		_check(not load("res://scripts/ui/item_head.gd").unique_rule(it).is_empty(), "the %s's rule has no words" % sl)
	sim.stash.assign(stash_hold + bought)     # the bought pieces kept: the webbing check below wants one
	# the third review's A9, C5, C6, M2: loot once a search; the counter's piece one roll; issued kit off the shelf; a
	# death past 50 keeps 50 and (BUILD41, 1 Nov) the paragon levels
	_check(sim.thin_after({"depth": 3}) == int(roundf(Data.THIN_AFTER + Data.THIN_PER_DEPTH * 3)), "a site's searches still grow with loot quantity: %d" % sim.thin_after({"depth": 3}))
	var ip_a: Dictionary = sim.issued_piece("Helmet")
	var ip_b: Dictionary = sim.issued_piece("Helmet")
	var ip_c: Dictionary = sim.issued_piece("Helmet", -1, true)
	_check(int(ip_a["id"]) == int(ip_b["id"]) and int(ip_c["id"]) != int(ip_a["id"]), "the counter's piece rolls afresh each read, or a bought one shares its id")
	_check(not sim.shelf.any(func(nm): return str(nm).begins_with("Issued")), "issued kit went on the uniques shelf: %s" % str(sim.shelf.filter(func(nm): return str(nm).begins_with("Issued"))))
	var hold_d: Dictionary = sim.to_dict()
	sim.xp = Data.xp_for_level(Data.MAX_LEVEL)
	sim.paragon_xp = Data.xp_for_level(Data.MAX_LEVEL + 3) - Data.xp_for_level(Data.MAX_LEVEL)
	sim.hp = sim.max_hp()
	sim.deploy(0)
	if sim.mission != null:
		sim._kia()
		_check(sim.level() == Data.MAX_LEVEL and sim.paragon() == 3, "a death past 50: level %d, paragon %d (want 50, 3: BUILD41, the paragon levels kept)" % [sim.level(), sim.paragon()])
	sim.load_dict(hold_d)
	# stamping (Matt, 26 Oct): a piece of your own, stamped at the slot's issued price, counts towards the County's want
	var own_gun = sim.equipped.get("Primary")
	if own_gun != null and not own_gun.get("issued", false):
		var worn0: int = sim.issued_worn()
		var cash_s: float = sim.cash
		var price_s: int = sim.stamp_price(own_gun)
		_check(price_s == sim.issued_price("Primary") and sim.stamp(int(own_gun["id"])) and own_gun.get("stamped", false) and sim.issued_worn() == worn0 + 1 and is_equal_approx(sim.cash, cash_s - price_s), "stamping the gun: worn %d from %d, cash %.0f from %.0f" % [sim.issued_worn(), worn0, sim.cash, cash_s])
		_check(not sim.stamp(int(own_gun["id"])) and sim.stamp_block(own_gun) == Words.STAMP["done"], "a piece stamped twice")
		own_gun.erase("stamped")
		# the Bench's stamp tile (the canvas 'The stamp at the Bench', A): priced, pressed, then Stamped
		sim.cash = maxf(sim.cash, float(price_s) * 2.0)
		main.open_stamp()
		main.refresh()
		var wsp = main._workshop
		var sk: int = wsp.JOBS.find("stamp")
		var st_t: Dictionary = wsp._job_tiles[sk]
		_check(main.room == main.WORKSHOP and wsp.view == "craft" and st_t["price"].text == Fmt.money(float(price_s)) and not st_t["button"].disabled, "the Bench's stamp tile: room %s, price '%s', off %s" % [main.room, st_t["price"].text, st_t["button"].disabled])
		_check_fit(main, "the Bench with the stamp")
		for jt in wsp._job_tiles:
			for jl in jt["words"]:
				_check(not str(jl.text).ends_with("…"), "a job tile's words cut, four across: '%s'" % jl.text)
		wsp._press_job(sk)
		main.refresh()
		_check(own_gun.get("stamped", false) and st_t["name"].text == Words.STAMP["tag_short"] and st_t["button"].disabled, "the stamp tile didn't stamp: '%s'" % st_t["name"].text)
		own_gun.erase("stamped")
	var web = sim.stash.filter(func(x): return x.get("issued", false) and str(x.get("rule", "")) == "issued_webbing")
	_check(not web.is_empty(), "no issued webbing in the stash to test its meds")
	if not web.is_empty():
		var rig_hold = sim.equipped["Rig"]
		sim.equipped["Rig"] = null
		sim._dry_memo.clear()
		var h0: float = sim.med_heal(shelf_kit)
		sim.equipped["Rig"] = web[0]
		sim._dry_memo.clear()
		_check(sim.med_heal(shelf_kit) > h0 * 1.4, "the issued webbing's meds +50%% does nothing: %.1f against %.1f" % [sim.med_heal(shelf_kit), h0])
		sim.equipped["Rig"] = rig_hold
		sim._dry_memo.clear()
	# the money on screen: ƒ
	main.refresh()
	_check(Fmt.money(1234.0) == "ƒ1,234" and Fmt.notes(10).begins_with("ƒ"), "fiat on screen reads '%s', notes '%s'" % [Fmt.money(1234.0), Fmt.notes(10)])
	_check(Fmt.money_k(4800.0).begins_with("ƒ") and Fmt.money_forms(48000.0).all(func(f): return not str(f).contains("tin")) and Fmt.unit() == "fiat" and sim.money_word() == "fiat" and not sim._cash_words(1200.0).contains("tin"), "after the Issue the short money still says tins: '%s'" % Fmt.money_k(4800.0))
	# the card, once, then the Fence; the counter's tab
	sim.met = sim.met.filter(func(x): return x != "issue")
	main.show_issue_card()
	_check(main._room_card != null and main._room_card.key == "issue", "the Issue's card didn't come up")
	if main._room_card != null:
		for l in main._room_card._lines:
			_check(UI.text_width(l, l.text) <= l.size.x + 0.5, "the Issue's card line runs off: '%s'" % l.text)
		var hint_l: Label = main._room_card._hint
		_check(UI.text_width(hint_l, hint_l.text) <= hint_l.size.x + 0.5 and not hint_l.text.ends_with("…"), "the Issue's card hint is cut: '%s'" % hint_l.text)     # the third review
		_check(main._room_card._lines.any(func(l): return l.text.contains("kit and goods worth")), "the Issue's card leaves out the kit and goods' worth")
		_check_fit(main, "the Issue's card")
		main._room_card.finish()
	_check("issue" in sim.met and main.room == main.MARKET, "after the Issue's card: met %s, the room %s" % ["issue" in sim.met, main.room])
	main._fence._show("shelf")
	main.refresh()
	var band_words: String = " ".join(main._fence._band.text_nodes().filter(func(n): return n is Label and n.is_visible_in_tree()).map(func(n): return n.text))
	_check(not band_words.contains("tins") and not band_words.contains("full value"), "the Fence's band after the Issue still says tins or full value: '%s'" % band_words)
	main._fence._show("issuer")
	main.refresh()
	var ic = main._fence._issuer
	_check(ic != null and ic.visible and main._fence._tabs[4].visible, "the Issuer's counter isn't up after the Issue")
	var tx := 0.0
	for t in main._fence._tabs:
		_check(t.visible and t.position.x >= main._fence._band.kicker.position.x + Pal.BAND_TEXT_W and t.position.x + t.size.x <= Pal.GRID_W - main._fence.PAD + 0.5 and t.position.x >= tx, "five fence tabs don't sit in the band's foot, in order: %s" % str(Rect2(t.position, t.size)))
		tx = t.position.x + t.size.x
	if ic != null:
		for l in ic.labels():
			_check(UI.text_width(l, l.text) <= l.size.x + 0.5, "the counter's words run off: '%s'" % l.text)
		_check_fit(main, "the Issuer's counter")
		# a runner under the pieces' level: each row padlocked, its Buy off (the third review)
		var xp_was: float = sim.xp
		sim.xp = 0.0
		ic.show_state(sim)
		for k in range(Data.ISSUED.size()):
			var lockd: bool = sim.wear_lock(sim.issued_piece(str(Data.ISSUED[k]["slot"]))) > 0
			_check(not lockd or (ic.row_locked(k) and ic.buttons()[k].disabled), "the counter's %s row isn't padlocked and off for a runner under it" % Data.ISSUED[k]["slot"])
		sim.xp = xp_was
		# the burn asks twice; with nothing in circulation it's off
		sim.cash = 1e9
		var circ_was: float = sim.circulation
		sim.circulation = 0.0
		ic._shown = ""
		ic.show_state(sim)
		_check(ic.buttons().back().disabled, "the Burn is live with nothing in circulation (the third review)")
		sim.circulation = maxf(circ_was, Data.FIAT_CIRC_SPAN)
		ic._shown = ""
		ic.show_state(sim)
		var cash_a: float = sim.cash
		var circ_a: float = sim.circulation
		ic._on_burn()
		_check(is_equal_approx(sim.cash, cash_a) and is_equal_approx(sim.circulation, circ_a), "one press of Burn spent: it should ask twice")
		sim.advance(1.0)                          # the circulation drains between the presses (the review)
		cash_a = sim.cash
		circ_a = sim.circulation
		ic._on_burn()
		_check(sim.cash < cash_a and sim.circulation < circ_a, "the second press of Burn didn't burn")
		sim.circulation = circ_was
	main._fence._show("shelf")
	sim.load_dict(hold)
	main.refresh()
	_check(not Fmt.fiat, "the money still reads fiat on a camp before the Issue")
	var pre_gun = sim.equipped.get("Primary")
	_check(pre_gun == null or (sim.stamp_block(pre_gun) == Words.STAMP["not_yet"] and not sim.stamp(int(pre_gun["id"]))), "a stamp before the Issue")
	_check(not sim.issued and not main._fence._tabs[4].visible, "the counter's tab stayed up on a camp before the Issue")
	_check(int(sim.order_beaten.get("mint", 0)) > 0 or sim.order_level("mint") == int(Data.pinnacle("mint")["level"]), "the Mint's first level isn't its set one: %d" % sim.order_level("mint"))
	_check(absf(sim.print_haul(3) - sim.print_haul(2) * Data.PRINT_DECAY) <= 1.0 and sim.print_haul(2) > sim.print_haul(5), "the Mint's prints don't shrink: %.0f, %.0f" % [sim.print_haul(2), sim.print_haul(3)])
	print("the Issue ok: hard on piles, prices by the circulation, notes as fiat, the rate, the burn, six issued pieces, the card, the counter")



## The County (25 Oct): its zones and places open in turn, each zone wanting issued kit worn; a place runs as the
## order's on its host's crew, a head's with his own fight and issued kit off him; the Map's County board; the remix.
func _county_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var hold: Dictionary = sim.to_dict()
	for i in range(Data.TIERS.size()):
		sim.best_depth[i] = maxi(1, int(sim.best_depth[i]))     # the campaign done, as the Issue's camp would be
	for z in range(sim.bosses_beaten.size()):
		sim.bosses_beaten[z] = true
	sim.xp = maxf(sim.xp, Data.xp_for_level(50))
	_check(Data.COUNTY.size() == 12 and Data.COUNTY_ZONES.size() == 4 and Data.ISSUED_WANT.size() == 4, "the County isn't four zones of three")
	for z in range(4):
		var ks: Array = sim.county_places(z)
		_check(ks.size() == 3 and Data.county(str(ks[2])).has("who") and not Data.county(str(ks[0])).has("who"), "the County's zone %d: its head isn't its last place" % z)
		_check(str(Data.county(str(ks[2]))["who"]) == str(Data.COUNTY_ZONES[z]["head"]), "zone %d's head isn't its zone's" % z)
	for c in Data.COUNTY:
		_check(Words.COUNTY_WORDS.has(str(c["key"])) and int(c["site"]) < Data.TIERS.size(), "%s has no line or no host" % c["place"])
	sim.issued = false
	sim.order_beaten = {}
	_check(not sim.county_zone_open(0) and sim.order_block("toll_plaza") == Words.COUNTY["not_yet"], "the County open before the Issue")
	sim.issue()
	sim.reach = 30
	for sl in Data.SLOTS:
		var w = sim.equipped.get(sl)
		if w != null and w.get("issued", false):
			sim.equipped[sl] = null
	_check(sim.county_zone_open(0) and sim.order_open("toll_plaza") and not sim.order_open("distribution") and not sim.county_zone_open(1), "after the Issue: the Motorway's first place alone open")
	_check(sim.order_block("toll_plaza") == Words.COUNTY["want"] % [2, 0], "the Toll Plaza doesn't want issued kit: '%s'" % sim.order_block("toll_plaza"))
	_check(sim.order_level("toll_plaza") == int(Data.county("toll_plaza")["level"]), "the Toll Plaza's level %d, not its set one" % sim.order_level("toll_plaza"))
	# two issued pieces worn
	sim.cash = 1e12
	var stash_was: Array = sim.stash.duplicate()
	sim.stash.clear()     # room for the buys, whatever the run so far left
	for sl in ["Armour", "Helmet"]:
		_check(sim.buy_issued(sl), "the fixture: no issued %s" % sl)
		var it: Dictionary = sim.stash.back()
		sim.stash.erase(it)
		sim.equipped[sl] = it
	sim.stash.assign(stash_was)
	_check(sim.issued_worn() == 2 and sim.order_block("toll_plaza") == "", "two worn, the Toll Plaza still shut: '%s'" % sim.order_block("toll_plaza"))
	# issued kit counts as a piece of the set you wear, in a slot the set has a piece for (26 Oct)
	var army: Dictionary = Items.set_named("The Army's")
	var army_slots: Array = army["pieces"].map(func(pc): return str(pc["slot"]))
	var kit_was: Dictionary = sim.equipped.duplicate()
	for sl in Data.SLOTS:
		sim.equipped[sl] = null
	sim._dry_memo.clear()
	var issued_one: Dictionary = sim.issued_piece(str(army_slots[1]))
	sim.equipped[str(army_slots[1])] = issued_one
	sim._dry_memo.clear()
	_check(sim.set_count("The Army's") == 0, "issued kit alone counted as a set: %d" % sim.set_count("The Army's"))
	sim.equipped[str(army_slots[0])] = Items.roll_set_piece(army["name"], army["pieces"][0], sim.rng)
	sim._dry_memo.clear()
	_check(sim.set_count("The Army's") == 2, "an issued piece in the Army's slot didn't count with its piece: %d" % sim.set_count("The Army's"))
	_check(sim.set_issued("The Army's") == 1, "the Kit's set line won't say the issued piece: set_issued %d" % sim.set_issued("The Army's"))     # "2 of 4 worn (1 issued)"
	main.show_room(main.ARMOURY)
	main.refresh()
	main._armoury._pick_slot(str(army_slots[0]))
	main.refresh()
	var pick_words: String = " ".join(main._armoury._pick.text_nodes().filter(func(n): return n is Label and n.visible).map(func(n): return n.text))
	_check(pick_words.contains("issued)"), "the Kit's set line doesn't say the issued piece: '%s' (room up %s, on a run %s)" % [pick_words.left(300), main._armoury.is_visible_in_tree(), sim.on_mission()])
	main.show_room(main.MISSIONS)
	# one set a piece: another set sharing that slot, a piece of its own on, doesn't count it too (the review)
	var shared := ""
	for st2 in Data.SETS:
		if st2["name"] != army["name"] and st2["pieces"].any(func(pc): return str(pc["slot"]) == str(army_slots[1])):
			var free_pc = st2["pieces"].filter(func(pc): return not (str(pc["slot"]) in [str(army_slots[0]), str(army_slots[1])]))
			if not free_pc.is_empty():
				sim.equipped[str(free_pc[0]["slot"])] = Items.roll_set_piece(st2["name"], free_pc[0], sim.rng)
				shared = str(st2["name"])
				break
	sim._dry_memo.clear()
	if shared != "":
		_check(sim.set_count("The Army's") + sim.set_count(shared) == 3, "one issued piece counted for two sets: %s %d, %s %d" % [army["name"], sim.set_count("The Army's"), shared, sim.set_count(shared)])
	sim.equipped = kit_was
	sim._dry_memo.clear()
	# the Map's County board
	main.show_room(main.MISSIONS)
	main.refresh()
	_check(main._missions._county_btn.visible, "no County button on the Map after the Issue")
	main._missions.set_county(true)
	main.refresh()
	var cb = main._missions._county
	_check(cb.visible and not main._missions._map.visible, "the County board didn't take the map's place")
	main._missions._came_open = true
	main.refresh()
	_check(not main._missions._came.visible, "what came back sits over the County's board")
	main._missions._came_open = false
	main.refresh()
	_check(cb.card("toll_plaza")["button"].visible and not cb.card("distribution")["button"].visible and cb.card("distribution")["note"].text.begins_with("Take"), "the County's cards: the Toll Plaza's Go %s, the next's note '%s'" % [cb.card("toll_plaza")["button"].visible, cb.card("distribution")["note"].text])
	for n in cb.text_nodes():
		if n is Label:
			_check(UI.text_width(n, n.text) <= n.size.x + 0.5, "the County's words run off: '%s'" % n.text)
	# the canvas 'The County board' (26 Oct): the slots worn, a tick a taken pin, the key inside the map, a shut zone's
	# card, the two links to their rooms
	for z in range(Data.COUNTY_ZONES.size()):
		if not sim.county_zone_open(z):
			var zl: Label = cb._zone_labels[z]
			_check(zl.text != str(Data.COUNTY_ZONES[z]["name"]), "a shut zone's name isn't scrambled: '%s'" % zl.text)
			for k in sim.county_places(z):
				_check(not str(cb._pin_labels[str(k)].text).contains(str(Data.county(str(k))["place"]).trim_prefix("The ")), "a shut zone's place reads plain: '%s'" % cb._pin_labels[str(k)].text)
	var sw: Array = cb.slot_words()
	_check(sw.size() == 6 and sw.filter(func(w): return str(w).begins_with("✓")).size() == mini(6, sim.issued_worn()), "the County card's slots: %s with %d worn" % [str(sw), sim.issued_worn()])
	for c in Data.COUNTY:
		_check((cb.pin_state(str(c["key"])) == "taken") == (int(sim.order_beaten.get(str(c["key"]), 0)) > 0), "%s's pin reads %s" % [c["place"], cb.pin_state(str(c["key"]))])
	var kp: Panel = cb.key_strip()
	_check(kp.position.x >= 0.0 and kp.position.y >= 0.0 and kp.position.x + kp.size.x <= cb._frame.size.x and kp.position.y + kp.size.y <= cb._frame.size.y and kp.get_parent() == cb._frame, "the County's key runs off the map: %s" % str(Rect2(kp.position, kp.size)))     # on the view, not the land (BUILD51-U)
	var shut_z := -1
	for z in range(Data.COUNTY_ZONES.size()):
		if not sim.county_zone_open(z):
			shut_z = z
	if shut_z >= 0:
		var cen := Vector2.ZERO
		for v in CountyRef.ZONE_SHAPES[shut_z]:
			cen += v
		cen /= float(CountyRef.ZONE_SHAPES[shut_z].size())
		var clk := InputEventMouseButton.new()
		clk.button_index = MOUSE_BUTTON_LEFT
		clk.pressed = true
		clk.position = CountyRef._px(cen)          # the land's point (BUILD51-U)
		cb._map_input(clk)
		var sc: Panel = cb.shut_card()
		var sct: String = " ".join(sc.get_children().filter(func(n): return n is Label).map(func(n): return n.text))
		_check(sc.visible and sct.contains("first") and sct.contains("issued"), "a click on a shut zone: card %s, '%s'" % [sc.visible, sct])
		for n in sc.get_children():
			if n is Label:
				_check(UI.text_width(n, n.text) <= n.size.x + 0.5, "the shut zone's card runs off: '%s'" % n.text)
		cb._map_input(clk)
		cb._map_input(clk)
		_check(cb.shut_card().visible, "the shut card didn't come back on a second click")
		main.show_room(main.MARKET)
		main.show_room(main.MISSIONS)
		main.refresh()
		var hidden_names: Array = cb.text_nodes().filter(func(n): return n is Label and not n.visible and n.get_parent() == cb._map)
		_check(not cb.shut_card().visible and hidden_names.is_empty(), "the shut card outlived the board: card %s, %d names hidden" % [cb.shut_card().visible, hidden_names.size()])
		main._missions.set_county(true)
		main.refresh()
	cb.card("toll_plaza")["to_issuer"].pressed.emit()
	_check(main.room == main.MARKET and main._fence._issuer != null and main._fence._issuer.visible, "the County card's Issuer link didn't open his counter")
	main.show_room(main.MISSIONS)
	main._missions.set_county(true)
	main.refresh()
	# the third review: the head's fight said before Go; where issued kit comes from, not the want twice; the came-back
	# button on the board isn't dead
	var ts_words: String = " ".join(cb.card("truck_stop")["words"].map(func(l): return l.text))
	_check(ts_words.replace("  ", " ").contains("seizes your best piece"), "the Truck Stop's card doesn't say the Bailiff's fight: '%s'" % ts_words)
	var off_kit: Dictionary = {}
	for sl in Data.SLOTS:
		var w = sim.equipped.get(sl)
		if w != null and (w.get("issued", false) or w.get("stamped", false)):
			off_kit[sl] = w
			sim.equipped[sl] = null
	cb._shown = ""
	main.refresh()
	var tp: Dictionary = cb.card("toll_plaza")
	_check(not off_kit.is_empty() and tp["note"].visible and tp["note"].text != tp["want"].text and tp["note"].text.contains("Issuer"), "the Toll Plaza short of issued kit: note '%s', want '%s'" % [tp["note"].text, tp["want"].text])
	for sl in off_kit:
		sim.equipped[sl] = off_kit[sl]
	cb._shown = ""
	main.refresh()
	main._missions._came_open = false
	main._missions._toggle_came()
	_check(not main._missions.county_on, "What came back on the County board did nothing")
	main._missions._came_open = false
	main._missions.set_county(true)
	main.refresh()
	# the drawn County (26 Oct, Matt's painting): every pin inside its own zone and clear of its edge, the pins far
	# enough apart to click, a click on a pin picks it
	var CM = load("res://scripts/ui/county.gd")
	for c in Data.COUNTY:
		var at: Vector2 = CM.PLACE_AT[str(c["key"])][0]
		var shape := PackedVector2Array(CM.ZONE_SHAPES[int(c["cz"])])
		var clear := INF
		for n in range(shape.size()):
			var a: Vector2 = shape[n]
			var b: Vector2 = shape[(n + 1) % shape.size()]
			if (a.x == 0 and b.x == 0) or (a.x == 512 and b.x == 512) or (a.y == 0 and b.y == 0) or (a.y == 424 and b.y == 424):
				continue                         # the painting's own edge isn't a zone's
			clear = minf(clear, at.distance_to(Geometry2D.get_closest_point_to_segment(at, a, b)))
		_check(Geometry2D.is_point_in_polygon(at, shape) and clear >= 12.0, "%s's pin isn't inside its zone, 12 px clear: %.0f" % [c["place"], clear])
		for c2 in Data.COUNTY:
			if str(c2["key"]) > str(c["key"]):
				_check(cb.pin_at(str(c["key"])).distance_to(cb.pin_at(str(c2["key"]))) >= 2.0 * CM.HIT_R, "%s and %s's pins too close to click apart" % [c["place"], c2["place"]])
	for l in cb._zone_labels + cb._pin_labels.values():
		var tx: float = l.position.x + (l.size.x - UI.text_width(l, l.text) if l.horizontal_alignment == HORIZONTAL_ALIGNMENT_RIGHT else 0.0)
		_check(tx >= 0.0 and tx + UI.text_width(l, l.text) <= cb._map.size.x and l.position.y + l.size.y <= cb._map.size.y, "the County's name '%s' runs off the map's edge (the review)" % l.text)
	var ev := InputEventMouseButton.new()
	ev.button_index = MOUSE_BUTTON_LEFT
	ev.pressed = true
	ev.position = cb.pin_at("distribution")
	cb._map_input(ev)
	_check(cb.selected == "distribution", "a click on the Distribution Centre's pin picked '%s'" % cb.selected)
	ev.position = cb.pin_at("container_port")
	cb._map_input(ev)
	_check(cb.selected == "distribution", "a pin in a shut zone picked")
	_check_fit(main, "the County")
	# a place run: its host's crew, no head; won, the next opens
	sim.hp = sim.max_hp()
	sim.wounds = {}
	var e: Dictionary = sim.order_read("toll_plaza")
	_check(not e.has("boss") and e["name"] == "The Toll Plaza" and bool(e.get("county", false)), "the Toll Plaza reads %s" % str(e.get("boss", {})))
	_check(sim.deploy_order("toll_plaza") and sim.mission != null and not sim.mission.has("boss"), "the Toll Plaza would not set off: %s" % sim.order_block("toll_plaza"))
	if sim.mission != null:
		var mm: Dictionary = sim.mission
		mm["remaining"] = 0
		mm["cleared"] = true
		sim.extract_now()
		_check(int(sim.order_beaten.get("toll_plaza", 0)) == 1 and sim.order_open("distribution") and sim._sig.is_empty(), "the Toll Plaza's win didn't open the Distribution Centre")
	# the head's place: his fight, issued kit off him, the next zone
	sim.order_beaten["distribution"] = 1
	sim.hp = sim.max_hp()
	var eh: Dictionary = sim.order_read("truck_stop")
	_check(eh.has("boss") and str(eh["boss"]["name"]) == "The Bailiff" and str(eh["boss"].get("mech", "")) == "bailiff", "the Truck Stop's head reads %s" % str(eh.get("boss", {})))
	_check(sim.deploy_order("truck_stop") and sim.mission != null and sim.mission.has("boss"), "the Truck Stop would not set off: %s" % sim.order_block("truck_stop"))
	if sim.mission != null:
		main.refresh()
		var outs: Array = sim.events.filter(func(line): return str(line[1]).begins_with("Out to"))
		var out_line: String = str(outs.back()[1]) if not outs.is_empty() else ""
		_check(main._top_labels["where"].text.contains("Truck Stop") and out_line.contains("Motorway") and not out_line.contains("the City"), "a County run tells the top bar '%s' and the log '%s' (the third review: the host site's)" % [main._top_labels["where"].text, out_line])
		var mh: Dictionary = sim.mission
		var serial0: int = sim.issued_serial
		mh["remaining"] = 0
		mh["cleared"] = true
		sim._boss_down(mh, mh["t"])
		_check(mh["found"].any(func(x): return x.get("issued", false)) and sim.issued_serial == serial0 + Data.COUNTY_HEAD_ISSUED, "the Bailiff dropped no issued kit")
		var head_its: Array = mh["found"].filter(func(x): return x.get("issued", false))
		_check(head_its.is_empty() or Items.ilvl(head_its[0]) > Items.ilvl(sim.issued_piece("Armour")), "the Bailiff's issued piece isn't over the counter's: %d against %d" % [Items.ilvl(head_its[0]) if not head_its.is_empty() else 0, Items.ilvl(sim.issued_piece("Armour"))])
		sim.extract_now()
		_check(sim.county_zone_open(1) and sim.order_open("container_port") and sim.order_block("container_port") == Words.COUNTY["want"] % [3, 2], "the Bailiff's fall didn't open the Docks, wanting three: '%s'" % sim.order_block("container_port"))
	# the head's issued kit comes home on a death after him, as a mythic does (the third review: it was in the pack)
	var hold_k: Dictionary = sim.to_dict()
	sim.order_beaten["truck_stop"] = 0
	sim.hp = sim.max_hp()
	if sim.deploy_order("truck_stop"):
		var md: Dictionary = sim.mission
		md["remaining"] = 0
		md["cleared"] = true
		sim._boss_down(md, md["t"])
		var n_iss: int = sim.stash.filter(func(x): return x.get("issued", false)).size()
		sim._kia()
		_check(sim.stash.filter(func(x): return x.get("issued", false)).size() >= n_iss + Data.COUNTY_HEAD_ISSUED, "the Bailiff's issued kit was lost on a death after him")
	sim.load_dict(hold_k)
	# a County run saved mid-fight and loaded finishes as the County's (the review)
	sim.order_beaten["truck_stop"] = 0
	sim.hp = sim.max_hp()
	if sim.deploy_order("truck_stop"):
		var ms: Dictionary = sim.mission
		ms["remaining"] = 0
		ms["boss"]["started"] = true
		ms["target_hp"] = float(ms["boss"]["hp"])
		sim._order_tick(ms, ms["t"], 0.1, "bailiff")
		var s5 = Sim.new()
		s5.load_dict(JSON.parse_string(JSON.stringify(sim.to_dict())))
		_check(str(s5._sig.get("order", "")) == "truck_stop" and str(s5.mission["boss"].get("mech", "")) == "bailiff" and str(s5.mission.get("seized", "")) == str(ms.get("seized", "")) and bool(s5.mission.get("seize_on", false)) == bool(ms.get("seize_on", false)), "a loaded County run lost its head's fight: %s" % str(s5.mission.get("boss", {})))
		var m5: Dictionary = s5.mission
		m5["cleared"] = true
		s5._boss_down(m5, m5["t"])
		s5.extract_now()
		_check(int(s5.order_beaten.get("truck_stop", 0)) == 1 and s5._sig.is_empty(), "a loaded County run didn't finish as the County's")
		sim.extract_now()
	else:
		_check(false, "the fixture: the Truck Stop wouldn't set off again: %s" % sim.order_block("truck_stop"))
	sim.order_beaten["truck_stop"] = 1
	var RVc = load("res://scripts/ui/run_view.gd")
	# the County's art (tools3): every crew whole and its face, every head's three poses and his face, all twelve
	# places' plates and walls once any are, the issued kit's pictures
	for z in range(Data.COUNTY_ZONES.size()):
		var ckey: String = RVc.county_gang({"signal": {"order": str(sim.county_places(z)[0])}})
		var missing: Array = []
		for w in ["a", "b"]:
			for ps in ["stand", "fire", "down"]:
				if RVc.tex("gang_%s_%s_%s" % [ckey, w, ps]) == null:
					missing.append("%s %s" % [w, ps])
		_check(missing.is_empty() and People.portrait("gang_" + ckey) != null, "the %s crew isn't whole: missing %s, face %s" % [ckey, str(missing), People.portrait("gang_" + ckey) != null])
		var who: String = str(Data.COUNTY_ZONES[z]["head"])
		var hk: String = Items.slug(who)
		_check(["stand", "fire", "down"].all(func(ps): return RVc.tex("head_%s_%s" % [hk, ps]) != null) and People.portrait(who) != null, "%s isn't drawn for his fight: %s" % [who, hk])
	var pairs_in: Array = Data.COUNTY.filter(func(c): return RVc._pair_in(RVc.COUNTY_DIR, Items.slug(str(c["place"]))))
	_check(pairs_in.is_empty() or pairs_in.size() == Data.COUNTY.size(), "only %d of the County's 12 plates and walls drawn" % pairs_in.size())
	# (the issued kit's pictures: _art_inventory_checks, the fix round, 30 Oct)
	# a remix head: one of the Issuer's people on a plain signal - his issued kit, no County run counted
	_check(sim.signal_head_name({"county_head": "manor", "zone": 1}) == "The Collector" and sim.signal_head_name({"zone": 1}) == "The Carpet Man", "the Radio names a remix head '%s'" % sim.signal_head_name({"county_head": "manor", "zone": 1}))
	sim.hp = sim.max_hp()
	sim.deploy(3)
	if sim.mission != null:
		var mr: Dictionary = sim.mission
		mr["boss"] = sim._boss_entry({"name": "The Collector", "hp": 100.0, "dps": 1.0, "zone": 1, "order": "manor", "mech": "collector", "remix": true})
		mr["remaining"] = 0
		var beaten0: Dictionary = sim.order_beaten.duplicate()
		var heads0: int = sim.chronicle.filter(func(x): return str(x.get("k", "")) == "county_head").size()
		var ser0: int = sim.issued_serial
		sim._boss_down(mr, mr["t"])
		_check(sim.issued_serial == ser0 + Data.COUNTY_HEAD_ISSUED and sim.order_beaten == beaten0 and sim.chronicle.filter(func(x): return str(x.get("k", "")) == "county_head").size() == heads0, "a remix head's kill: serial %d from %d, beaten %s" % [sim.issued_serial, ser0, str(sim.order_beaten)])
		sim.extract_now()
	# the heads' fights
	var head_run := func(key: String) -> Dictionary:
		if sim.on_mission():
			sim.extract_now()
		sim.hp = sim.max_hp()
		sim.deploy(3)
		var mx: Dictionary = sim.mission
		mx["boss"] = sim._boss_entry({"name": "A head", "hp": 1000.0, "dps": 1.0, "zone": 0, "order": "x", "mech": key})
		mx["boss"]["started"] = true
		mx["remaining"] = 1
		mx["target_hp"] = 1000.0
		mx["dots"] = {}
		return mx
	var fate0: String = sim.deeds_fate
	var back0: bool = sim.deeds_back
	sim.deeds_fate = "sold"                   # the deeds sold: he takes your best piece, as before
	var m: Dictionary = head_run.call("bailiff")
	sim._order_tick(m, m["t"], 0.1, "bailiff")
	_check(str(m.get("seized", "")) != "" and bool(m["seize_on"]), "the Bailiff seized nothing")
	_check(sim.order_chips(true).any(func(c): return str(c[0]).begins_with("Seized: your ") and (str(c[0]).contains("fire") or str(c[0]).contains("taken"))), "the Seized chip doesn't name the piece and its cost: %s" % str(sim.order_chips(true)))
	m["target_hp"] = 400.0
	sim._order_tick(m, m["t"], 0.1, "bailiff")
	_check(not bool(m["seize_on"]), "the Bailiff kept your piece under half")
	_deeds_bailiff_checks(sim, head_run)
	sim.deeds_fate = fate0
	sim.deeds_back = back0
	m = head_run.call("collector")
	_check(is_equal_approx(sim.county_taken(m), 1.0), "the Collector's bill started above nothing")
	for k in range(14):
		sim._order_tick(m, m["t"], 0.5, "collector")
	_check(is_equal_approx(sim.county_taken(m), 1.0 + 2.0 * Data.COLLECTOR_GROW) and int(m.get("printed", 0)) == 1, "the Collector after 7 s: ×%.2f, %d debtors" % [sim.county_taken(m), int(m.get("printed", 0))])
	m["target_hp"] = 1000.0 - float(m["t"]["hp"]) - 1.0
	sim._order_absorb(m, m["t"], 1000.0, "collector")
	_check(is_equal_approx(sim.county_taken(m), 1.0), "a debtor down didn't clear the bill: ×%.2f" % sim.county_taken(m))
	m = head_run.call("auditor")
	var slots_was: Array = sim.skill_slots.duplicate()
	sim.skill_slots = ["make_ready", "", ""]          # one slotted, so the tax is read (tools3: it sat under an if that never ran)
	var id0: String = str(sim.skill_slots[0])
	_check(id0 != "" and sim.skill(id0).size() > 0, "the Auditor's fixture: no skill to tax")
	if id0 != "":
		var taxed: float = sim.skill_cost_now(0)
		var mbk = sim.mission
		sim.mission = null
		var plain: float = sim.skill_cost_now(0)
		sim.mission = mbk
		_check(is_equal_approx(taxed, plain * Data.AUDITOR_TAX), "the Auditor's tax: %.1f against %.1f" % [taxed, plain])
		for k in range(int(Data.ORDER_SEAL_EVERY / 0.5) + 2):
			sim._order_tick(m, m["t"], 0.5, "auditor")
		_check(not m.get("sealed", {}).is_empty() or float(m.get("taped_t", 0.0)) > 0.0, "the Auditor never stamped a skill in %.0f s" % Data.ORDER_SEAL_EVERY)
	sim.skill_slots = slots_was
	m = head_run.call("treasurer")
	for k in range(int(Data.ORDER_PRINT_EVERY / 0.5) + 1):
		sim._order_tick(m, m["t"], 0.5, "treasurer")
	_check(float(m.get("shield", 0.0)) > 0.0 and int(m.get("printed", 0)) >= 1, "the Treasurer: shield %.0f, printed %d" % [float(m.get("shield", 0.0)), int(m.get("printed", 0))])
	if sim.on_mission():
		sim.extract_now()
	# the remix: nothing before the Treasurer (tools3)
	_check(not sim.county_done(), "the County done before the Treasurer")
	for k in range(20):
		var sg0 := {"id": 0, "site": 4, "zone": 1, "depth": 1, "head": true}
		sim._remix(sg0, 0)
		_check(not sg0.has("county") and not sg0.has("county_head"), "the remix laid a signal on the County before the Treasurer")
	var ser_r: int = sim.issued_serial
	sim._remix_issued(sim.reach + 5)
	_check(sim.issued_serial == ser_r, "the remix brought issued kit before the Treasurer")
	# the remix: the Treasurer down, signals on the County's places, its heads away from home
	sim.order_beaten["treasury"] = 1
	_check(sim.county_done(), "the Treasurer down and the County not done")
	var on_county := false
	var away := false
	for k in range(60):
		var sg := {"id": 0, "site": 4, "zone": 1, "depth": 1, "head": true}
		sim._remix(sg, 0)
		if sg.has("county"):
			on_county = true
			_check(sim.signal_place(sg) == str(Data.county(str(sg["county"]))["place"]) and int(sg["site"]) == int(Data.county(str(sg["county"]))["site"]), "a remixed signal's place: %s" % sim.signal_place(sg))
		if sg.has("county_head"):
			away = true
	_check(on_county and away, "sixty remixed signals: on the County %s, a head away %s" % [on_county, away])
	# a remixed signal on a County place sets off and names its zone (the review: its "Out to" line read a key it hasn't)
	for k in range(60):
		var sg2 := {"id": 900 + k, "site": 4, "zone": 1, "depth": 1, "codes": [], "papers": [], "head": false, "convoy": false, "line": 0, "grade": 0}
		sim._remix(sg2, 0)
		if sg2.has("county") and not sg2.has("county_head"):
			if sim.on_mission():
				sim.extract_now()
			sim.hp = sim.max_hp()
			var sig_hold: Array = sim.signals.duplicate(true)
			sim.signals = [sg2]
			_check(sim.deploy_signal(0) and sim.on_mission(), "a remixed County signal would not set off")
			var outs2: Array = sim.events.filter(func(line): return str(line[1]).begins_with("Out to"))
			var zone_of: String = str(Data.COUNTY_ZONES[int(Data.county(str(sg2["county"]))["cz"])]["name"]).trim_prefix("The ")
			_check(not outs2.is_empty() and str(outs2.back()[1]).contains(zone_of), "a remixed County signal's log: '%s'" % (str(outs2.back()[1]) if not outs2.is_empty() else ""))
			if sim.on_mission():
				sim.extract_now()
			sim.signals = sig_hold
			break
	# a burn at the price cap still burns (the review: both multipliers read ×4 there)
	var circ_cap_hold: float = sim.circulation
	var cash_cap_hold: float = sim.cash
	var was_issued: bool = sim.issued
	sim.issued = true
	sim.circulation = Data.FIAT_CIRC_SPAN * (Data.FIAT_CIRC_CAP - 1.0) * 3.0
	sim.cash = 1e12
	_check(sim.burn_moves() and sim.can_burn(), "no burn at the price cap: circulation %.0f" % sim.circulation)
	sim.issued = was_issued
	sim.circulation = circ_cap_hold
	sim.cash = cash_cap_hold
	main._missions.set_county(false)
	sim.load_dict(hold)
	main.refresh()
	_check(not main._missions._county_btn.visible and not main._missions._county.visible, "the County's button stayed up on a camp before the Issue")
	# the County's own fight art (26 Oct): a run on a place reads its pair once drawn, and its wall hides the duck
	var RV = load("res://scripts/ui/run_view.gd")
	_check(RV.county_gang({"signal": {"order": "truck_stop"}}) == "the_motorway" and RV.county_gang({"signal": {"county": "treasury", "zone": 1}}) == "" and RV.county_gang({}) == "", "the County's crew key: '%s'" % RV.county_gang({"signal": {"order": "truck_stop"}}))
	_check(RV.county_key({"signal": {"order": "truck_stop"}}) == "the_truck_stop" and RV.county_key({"signal": {"county": "manor"}}) == "the_manor" and RV.county_key({}) == "", "the run's County place key: '%s'" % RV.county_key({"signal": {"order": "truck_stop"}}))
	for c in Data.COUNTY:
		var pk: String = Items.slug(str(c["place"]))
		if RV._pair_in(RV.COUNTY_DIR, pk):
			_check(RV.tex_from(pk + "_plate") == RV.COUNTY_DIR and RV.tex_from(pk + "_cover") == RV.COUNTY_DIR, "%s's pair isn't read from art/fight_county" % c["place"])
			_check(RV.cover_reaches(RV.tex(pk + "_cover")), "%s's wall doesn't reach the frame's foot at the full duck" % c["place"])
	print("the County ok: four zones of three, issued kit wanted, places in turn, the heads' fights, the board, the remix")


## A run picked clean with the next gang after the clock comes home on its own, pack and all (Matt, 26 Oct; the first
## review's 2(a)); with time for a gang, it stays out.
func _picked_clean_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var hold: Dictionary = sim.to_dict()
	for late in [true, false]:
		sim.hp = sim.max_hp()
		sim.deploy(0)
		if sim.mission == null:
			_check(false, "the picked-clean check couldn't deploy")
			break
		var m: Dictionary = sim.mission
		m["remaining"] = 0
		m["cleared"] = true
		m["clock"] = 1e6
		sim.advance(0.1)
		if sim.mission == null or not m.has("crates"):
			_check(false, "the picked-clean check's run has no crates")
			break
		m["crate_i"] = m["crates"].size()
		m["patrol_timer"] = 0.0
		m["clock"] = 0.5 if late else 1e6
		var found_n: int = m["found"].size()
		sim.advance(0.2)
		if late:
			_check(sim.mission == null and sim.events.any(func(line): return str(line).contains("home with the pack")), "a picked-clean run with no gang before time's up didn't come home (pack %d)" % found_n)
		else:
			_check(sim.mission != null and not sim.nothing_left(sim.mission), "a picked-clean run with a gang to come went home early")
			sim.extract_now()
	sim.load_dict(hold)
	main.refresh()
	print("picked clean ok: home on its own when nothing comes before time's up, out when a gang will")


## Esc shuts the overlay on top before it pauses (the first review's 18): the collection, the rules, the Radio's book,
## a build code's plan; with nothing open it pauses.
func _esc_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var esc := InputEventKey.new()
	esc.keycode = KEY_ESCAPE
	esc.pressed = true
	var press_esc := func():
		main._overlay_closed = -1
		main._unhandled_input(esc)
	main.show_room(main.RUNNER)
	main.refresh()
	main._stats.show_collection()
	press_esc.call()
	_check(main._stats.collection_panel == null and not main._menu.visible, "Esc over the collection: still open %s, the pause up %s" % [main._stats.collection_panel != null, main._menu.visible])
	main.show_room(main.ARMOURY)
	main.refresh()
	main._armoury.open_rules()
	press_esc.call()
	_check(not main._armoury.rules_panel.visible and not main._menu.visible, "Esc over the loot rules: still open %s, the pause up %s" % [main._armoury.rules_panel.visible, main._menu.visible])
	main.show_room(main.COMMS)
	main.refresh()
	main._radio.open_book("filter")
	if main._radio.book_kind != "":
		press_esc.call()
		_check(main._radio.book_kind == "" and not main._menu.visible, "Esc over the Radio's book: '%s', the pause up %s" % [main._radio.book_kind, main._menu.visible])
	if main._menu.visible:
		main._menu.close()
	main.show_room(main.BARRACKS)
	main.refresh()
	main._barracks.pending_build = {"plan": true}
	press_esc.call()
	_check(main._barracks.pending_build.is_empty() and not main._menu.visible, "Esc over a build code's plan didn't cancel it, or paused")
	main.show_room(main.MISSIONS)
	main.refresh()
	main._missions._skill_pick.open(sim)
	main._missions._skill_pick.visible = true
	press_esc.call()
	_check(not main._missions._skill_pick.visible and not main._menu.visible, "Esc over the skill picker: still open %s, the pause up %s" % [main._missions._skill_pick.visible, main._menu.visible])
	main._missions._came_open = true
	main._missions._came.visible = true
	press_esc.call()
	_check(not main._missions._came_open and not main._menu.visible, "Esc over the came-back card didn't shut it, or paused")
	# nothing open: Esc pauses, and Esc again closes the pause
	press_esc.call()
	_check(main._menu.visible, "Esc with nothing open didn't pause")
	press_esc.call()
	_check(not main._menu.visible, "Esc didn't close the pause")
	main.show_room(main.MISSIONS)
	main.refresh()
	print("Esc ok: the collection, the rules, the book and a code's plan shut first; then the pause")




## The exploits (Matt, 27 Oct, docs/design/pinnacle_and_exploits.md): each on with its two nodes and its unique, off a
## piece short or with the balance's switch, and what it does.
func _exploit_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var hold: Dictionary = sim.to_dict()
	Sim.exploits_off = false
	for key in Data.EXPLOITS:
		var x: Dictionary = Data.EXPLOITS[key]
		var u: Dictionary = {}
		for uu in Data.UNIQUES:
			if str(uu.get("rule", "")) == str(x["rule"]):
				u = uu
		_check(not u.is_empty(), "%s: no unique has its rule %s" % [key, x["rule"]])
		if u.is_empty():
			continue
		sim.load_dict(hold)
		sim.cls = str(x["class"])
		var ids: Array = x["nodes"].map(func(pth): return Data.node_id_named(str(pth)))
		_check(not ids.has(""), "%s names a node the web hasn't: %s" % [key, str(x["nodes"])])
		for id in ids:
			if not sim.tree.has(id):
				sim.tree.append(id)
		sim.equipped[str(u["slot"])] = Items.roll_unique(u, sim.rng)
		sim._dry_memo.clear()
		_check(sim.exploit_on(key), "%s isn't on with its nodes and %s" % [key, u["name"]])
		var others: Array = Data.EXPLOITS.keys().filter(func(k2): return k2 != key and sim.exploit_on(str(k2)))
		_check(others.is_empty(), "%s turns on another: %s" % [key, str(others)])
		Sim.exploits_off = true
		_check(not sim.exploit_on(key), "%s is on with the balance's switch off" % key)
		Sim.exploits_off = false
		sim._dry_memo.clear()
		sim.tree.erase(ids[0])
		sim._dry_memo.clear()
		_check(not sim.exploit_on(key), "%s is on without %s" % [key, x["nodes"][0]])
		sim.tree.append(ids[0])
		var worn = sim.equipped[str(u["slot"])]
		sim.equipped[str(u["slot"])] = null
		sim._dry_memo.clear()
		_check(not sim.exploit_on(key), "%s is on without %s" % [key, u["name"]])
		sim.equipped[str(u["slot"])] = worn
		sim._dry_memo.clear()
		# what it does
		if x.has("grow") and key != "bad_blood":
			var m := {}
			for k in range(5):
				sim._exploit_grow(m, key)
			_check(is_equal_approx(Sim.exploit_x(m), pow(float(x["grow"]), 5.0)), "%s doesn't run away: x%.2f after five" % [key, Sim.exploit_x(m)])
		if key == "overdrawn":
			_check(is_equal_approx(sim.skill_cooldown("smoke"), Data.EXPLOIT_CD) and sim.skill_cost_mult() == 0.0, "Overdrawn: a skill's cooldown %.2f, its cost x%.2f" % [sim.skill_cooldown("smoke"), sim.skill_cost_mult()])
		if key == "second_opinion":
			sim.hp = sim.max_hp()
			sim.deploy(0)
			if sim.mission != null:
				var med: Dictionary = sim._plain(Data.MEDICAL, "First aid kit")
				sim.rig.append(med)
				for k in range(3):
					sim.mission["using"] = null
					sim.hp = sim.max_hp() * 0.3
					sim.use_med(int(med["id"]))
				_check(sim.rig.has(med), "Second opinion spent its med")
				sim.extract_now()
	sim.load_dict(hold)
	Sim.exploits_off = true
	main.refresh()
	print("the exploits ok: each on with its three pieces, off a piece short or switched off, each running away")



