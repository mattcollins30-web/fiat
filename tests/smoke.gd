	_check(int(mm["t"]["depth"]) == 8, "the salvage run is not at depth 8: %d" % int(mm["t"]["depth"]))
	sim.rng.seed = 11
	for k in range(400):
		sim._kill(mm, mm["t"])
	var got: int = int(mm.get("salvage", {}).get("copper", 0))
	_check(got > 0 and mm.get("salvage", {}).size() == 1, "a deep Estate site gave no copper, or the wrong kind: %s" % str(mm.get("salvage", {})))
	var cu0: int = int(sim.salvage["copper"])
	sim.extract_now()
	_check(int(sim.salvage["copper"]) == cu0 + got, "the run's salvage did not come home: %d from %d" % [int(sim.salvage["copper"]), cu0])
	sim.cash = 1000000.0
	sim.notes = 400
	_yard_ids(sim, ["a_dog", "good_nose"], "a_dog")
	_yard_ids(sim, ["dry_store", "annex"], "dry_store")
	sim.yard_ranks["kennel"] = 3
	sim.yard_mark_seen()
	sim.yard_picks = {}
	sim._yard_changed("")
	sim.cash = 1.0e9
	_check(sim.yard_pick_block("bench", 1, "a") == "After Steady hands" and not sim.yard_pick("bench", 1, "a"), "a line's second step built before its first: '%s'" % sim.yard_pick_block("bench", 1, "a"))
	_check(sim.yard_pick("bench", 0, "a") and sim.yard_pick("bench", 1, "a") and sim.yard_has("two_locks") and sim.yard_pick_block("bench", 1, "b") == "After Cheap parts", "the Rolls line didn't climb in order")
	_check(sim.yard_rank_block("bench").begins_with("After a line's fifth") or sim.yard_cols() < Data.YARD_COLS, "a rank opened before a line's fifth step: '%s'" % sim.yard_rank_block("bench"))
	sim.load_dict(saved)
	main.refresh()
	print("the Pitch's lanes ok: the screen, a build and its other side, the gates kept, salvage, ranks, every building's picks, the move")


## The sum strip's tiles sit inside their panel (7 Oct: the strip was sized by the node tile's height, four
## pixels short, and the tiles' feet were cut off).
func _sum_strip_check(main) -> void:
	var bk = main._barracks
	var inside := Rect2(Vector2.ZERO, bk._sum.size)
	# every chip the trees call for is on the row, and none the trees convert to or increase was dropped to fit -
	# read off the screen before anything re-lays it
	var shown_tags: Array = []
	for k in range(bk._sum_chips.shown()):
		shown_tags.append(bk._sum_chips._tags[k].text)
	var want: Array = bk.sum_items([])
	_check(shown_tags.size() == want.size(), "the sum strip shows %d of its %d chips" % [shown_tags.size(), want.size()])
	_check(not shown_tags.has("Pairs") or shown_tags.back() == "Pairs", "the Pairs chip is not last: %s" % str(shown_tags))
	for el in Data.ELEMENTS:
		if bk.sim.tree_sum("conv_%s_pct" % el) > 0.0 or bk.sim.tree_sum("%s_pct" % el) > 0.0:
			_check(shown_tags.has(el.capitalize()), "the %s the trees give is not on the sum strip: %s" % [el, str(shown_tags)])
	for k in range(bk._sum_chips.shown()):
		var pnl = bk._sum_chips._panels[k]
		var r := Rect2(bk._sum_chips.position + pnl.position, pnl.size)
		_check(inside.encloses(r), "a sum chip runs out of its strip: %s in %s" % [str(r), str(inside)])
	# a node's panel: the figure as a chip beside the title, the sentence under them (Matt, 10 Oct), apart
	if bk.selected != "" and bk._chips.visible:
		var said: String = (bk._words.text + " " + bk._words2.text).strip_edges()
		_check(bk._words.position.y >= bk._chips.position.y + Chips.CHIP_H and bk._words.text != "" and said.ends_with("."), "the node's chip and sentence are off: words at y %.0f, chips to %.0f, '%s'" % [bk._words.position.y, bk._chips.position.y + Chips.CHIP_H, said])
	_check(bk._panel.position.y >= bk.HEAD_H, "the node panel sits on the band")


## The rarities' colours (Rarity-A, 7 Oct): seven tones a cell can wear, every one its own, none the pick ring's;
## a unique pink, a legendary gold, a rare blue, on the cell and on the head's chip.
func _rarity_tone_checks(sim) -> void:
	var tones := ["good", "rare", "epic", "legendary", "unique", "set"]
	var seen := []
	for t in tones:
		var c: Color = Pal.tone_color(t)
		_check(c != Pal.PICK and c != Pal.TEXT_2, "the %s tone is the pick ring's or the plain text's" % t)
		_check(not seen.has(c), "the %s tone is another rarity's colour" % t)
		seen.append(c)
	var rare: Dictionary = sim._plain("Helmet", "Hard hat")
	rare["rarity"] = 2
	var leg: Dictionary = sim._plain("Helmet", "Hard hat")
	leg["rarity"] = 4
	var uniq: Dictionary = sim._plain("Helmet", "Hard hat")
	uniq["rarity"] = 4
	uniq["unique"] = "Test"
	_check(Pal.item_tone(rare) == "rare" and Pal.item_tone(leg) == "legendary" and Pal.item_tone(uniq) == "unique", "an item's tone is off: %s / %s / %s" % [Pal.item_tone(rare), Pal.item_tone(leg), Pal.item_tone(uniq)])
	var Cell = load("res://scripts/ui/item_cell.gd")
	var cell = Cell.new()
	cell.show_item(uniq, false)
	_check((cell.get_theme_stylebox("normal") as StyleBoxFlat).border_color == Pal.UNIQUE, "a unique's cell is not pink")
	cell.show_item(leg, true)
	_check((cell.get_theme_stylebox("normal") as StyleBoxFlat).border_color == Pal.PICK, "a picked cell's ring is not the pick ring")
	cell.queue_free()


## The shell's odds, settled: frames of main._read_odds until every open tier has read (the Runs and Radio
## screens show "reading the odds" until then).
func _settle_odds(main) -> void:
	var sel: int = main._missions.selected
	for k in range(4000):
		if main.room == main.MISSIONS:
			for i in range(Data.TIERS.size()):
				if main.sim.tier_open(i) and not main.sim.odds_settled(i):
					main._missions.selected = i     # each picked in turn: the Map reads the place picked alone (BUILD48 A, item 3)
					break
		main._read_odds()
		var done := true
		for i in range(Data.TIERS.size()):
			if main.sim.tier_open(i) and not main.sim.odds_settled(i):
				done = false
		if done:
			main._missions.selected = sel
			return
	main._missions.selected = sel


## A site's level (the endgame, 7 Oct): tier plus depth drives the curve, the bases and the item level, so the
## streets' ladder is gentle and long and the Barracks' steep and short; the Runs card says the level.
## The deep bases (10 Oct, docs/design/deep_guns.md): tiers 7-9 from level 12, 16 and 20, on every slot a runner
## wears; a campaign site's "a tier up" never reaches them; every deep base has its words and a footprint that fits.
func _deep_tier_checks(main) -> void:
	var sim = main.sim
	# the signals' tiers (29 Oct, the itemisation: T5 from level 10, T6 13, T7 16, T8 20, T9 24)
	_check(sim.loot_tier_at(9) == 1 and sim.loot_tier_at(10) == 5 and sim.loot_tier_at(12) == 5 and sim.loot_tier_at(13) == 6 and sim.loot_tier_at(16) == 7 and sim.loot_tier_at(19) == 7 and sim.loot_tier_at(20) == 8 and sim.loot_tier_at(23) == 8 and sim.loot_tier_at(24) == 9,
		"the signals' tiers by level are off: %d %d %d %d %d" % [sim.loot_tier_at(10), sim.loot_tier_at(13), sim.loot_tier_at(16), sim.loot_tier_at(20), sim.loot_tier_at(24)])
	_check(sim.loot_cap(9) == Data.CAMPAIGN_TIER and sim.loot_cap(10) == Data.MAX_TIER, "a campaign site's tier up reaches the signals' bases")
	for slot in ["Primary", "Secondary", "Helmet", "Armour", "Gloves", "Rig", "Backpack", "Charm"]:
		for tier in [7, 8, 9]:
			var n := 0
			for b in Data.BASES[slot]:
				if int(b["tier"]) == tier:
					n += 1
					_check(Words.ITEMS.has(b["name"]), "the deep base %s has no words" % b["name"])
					var f: Vector2i = Items.footprint({"slot": slot, "base": b["name"]})
					_check(f.x <= 5 and f.y <= 4, "the deep base %s does not fit a cell grid" % b["name"])
			_check(n > 0, "no %s base at tier %d" % [slot, tier])
		var deep_rng := RandomNumberGenerator.new()
		deep_rng.seed = 7
		var seen_deep := false
		for k in range(400):
			var it: Dictionary = Items.roll(slot, Data.CAMPAIGN_TIER, deep_rng)
			_check(int(it["tier"]) <= Data.CAMPAIGN_TIER, "a campaign roll gave a deep %s" % it["base"])
			var deep: Dictionary = Items.roll(slot, Data.MAX_TIER, deep_rng)
			seen_deep = seen_deep or int(deep["tier"]) > Data.CAMPAIGN_TIER
		_check(seen_deep, "a tier-9 roll never gave a deep %s" % slot)
	for t in Data.TIERS:
		_check(int(t["loot_tier"]) <= Data.CAMPAIGN_TIER, "the campaign's %s drops a deep tier" % t["name"])
	# the Workshop's gun builds: a deep improvised base only once a site drops its tier (the review, 10 Oct)
	var hold_bd: Array = sim.best_depth.duplicate()
	for i in range(sim.best_depth.size()):
		sim.best_depth[i] = 1
	var top_build := 0
	for e in sim.build_options("gun"):
		top_build = maxi(top_build, int(e["tier"]))
	_check(top_build == Data.CAMPAIGN_TIER, "the campaign's gun builds reach T%d" % top_build)
	for i in range(sim.best_depth.size()):
		sim.best_depth[i] = 20
	top_build = 0
	for e in sim.build_options("gun"):
		top_build = maxi(top_build, int(e["tier"]))
	_check(top_build == Data.MAX_TIER, "the deep gun builds stop at T%d at depth 20" % top_build)
	sim.best_depth = hold_bd
	# a shop's unique or set piece carries its own base's level, not a deep throwaway's
	var u_rng := RandomNumberGenerator.new()
	u_rng.seed = 11
	for k in range(60):
		var u: Dictionary = Data.UNIQUES[k % Data.UNIQUES.size()]
		var it: Dictionary = Items.roll_unique(u, u_rng)
		_check(Items.ilvl(it) <= Items.unique_tier(u, int(Items.base_named(u["slot"], u["base"])["tier"])), "%s rolled at level %d over its base's tier, held in its range" % [u["name"], Items.ilvl(it)])
	# each gun line climbs: every deep tier beats the line's best below it
	for slot in ["Primary", "Secondary"]:
		var best := {}
		for b in Data.BASES[slot]:
			if b.has("rof"):
				var k := "%s/%d" % [str(b.get("type", "")), int(b["tier"])]
				best[k] = maxf(float(best.get(k, 0.0)), float(b["damage"]) * float(b["rof"]))
		for k in best.keys():
			var bits: PackedStringArray = k.split("/")
			var tier := int(bits[1])
			if tier >= 7:
				var below := 0.0
				for k2 in best.keys():
					var b2: PackedStringArray = k2.split("/")
					if b2[0] == bits[0] and int(b2[1]) < tier:
						below = maxf(below, float(best[k2]))
				_check(float(best[k]) > below, "the deep %s at T%d (%.0f) doesn't beat its line below (%.0f)" % [bits[0], tier, float(best[k]), below])


func _site_level_checks(main) -> void:
	var sim = main.sim
	var hold_depth: Array = sim.depth.duplicate()
	var hold_best: Array = sim.best_depth.duplicate()
	for i in range(Data.TIERS.size()):
		sim.best_depth[i] = 20
	_check(sim.loot_tier_at(1) == 1 and sim.loot_tier_at(9) == 1 and sim.loot_tier_at(10) == 5 and sim.loot_tier_at(30) == Data.MAX_TIER and sim.site_tier_at(3, 8) == 2 and sim.site_tier_at(11, 9) == Data.CAMPAIGN_TIER, "the gear tier by level is off: %d %d %d" % [sim.loot_tier_at(1), sim.loot_tier_at(10), sim.site_tier_at(11, 9)])
	_deep_tier_checks(main)
	sim.set_depth(3, 8)
	sim.set_depth(11, 2)
	var hold_intel: Array = [sim.words[3].duplicate(true), sim.words[11].duplicate(true)]
	sim.words[3] = []                     # the plain sites: a word on the air can add a gear tier
	sim.words[11] = []
	var streets: Dictionary = sim.effective(3)
	var barracks: Dictionary = sim.effective(11)
	_check(int(streets["level"]) == 8 and int(barracks["level"]) == 10 and sim.site_level(3) == 8, "the sites' levels are off: %d / %d" % [int(streets["level"]), int(barracks["level"])])
	_check(float(barracks["hp"]) > float(streets["hp"]) and float(barracks["dps"]) > float(streets["dps"]), "the Barracks at depth 2 is no harder than the streets at depth 8: %.0f vs %.0f HP" % [float(barracks["hp"]), float(streets["hp"])])
	_check(int(streets["loot_tier"]) == 2 and int(barracks["loot_tier"]) == 5, "the bases by level are off: streets tier %d, barracks tier %d" % [int(streets["loot_tier"]), int(barracks["loot_tier"])])     # the Streets' own T2 at level 8; the Barracks at level 10 a signal's T5 (29 Oct)
	# a find carries the site's level
	var f0: Dictionary = Items.roll("Primary", int(streets["loot_tier"]), sim.rng, 0.0, false, false, "", "", 0.33, 8, int(streets["level"]))
	var f8: Dictionary = Items.roll("Primary", int(barracks["loot_tier"]), sim.rng, 0.0, false, false, "", "", 0.33, 2, int(barracks["level"]))
	_check(int(f0["ilvl"]) == 8 and int(f8["ilvl"]) == 10, "a find's item level is not the site's: %d / %d" % [int(f0["ilvl"]), int(f8["ilvl"])])
	# never under the site's own campaign curve: the Barracks at depth 2 keeps the campaign's climb
	var camp_d2: float = float(Data.TIERS[11]["hp"]) * (1.0 + Data.DEPTH_HOSTILE)
	_check(float(barracks["hp"]) >= camp_d2 - 0.01, "the Barracks at depth 2 fell under its campaign curve: %.0f < %.0f" % [float(barracks["hp"]), camp_d2])
	# the Runs card says it: the level on the kicker, the finds' level on a tile, the stations on the note
	main.show_room(main.MISSIONS)
	main._missions._pick_zone(1)
	main._missions._shown = ""
	main.refresh()
	var c0: Dictionary = main._missions._cols[0]
	_check(c0["card"].kicker.text == "The Estate · Tier 1", "the streets' kicker isn't its zone and tier: '%s'" % c0["card"].kicker.text)     # the gear's level is the tile's (18 Oct, said once)
	var gear_t: String = c0["card"].tiles[0]["text"].text     # the bring-home tile since BUILD46-S: "Gear, level N"
	_check(gear_t.ends_with("level %d" % sim.wear_of(8)) or gear_t == "Level %d" % sim.wear_of(8), "the streets' gear tile is off: '%s'" % gear_t)
	main._missions._pick_zone(3)
	main._missions._shown = ""
	main.refresh()
	var c6: Dictionary = main._missions._cols[0]       # the Services, the city's first
	_check(not c6["note"].text.contains("Depth"), "the Services' card still names a depth's station: '%s'" % c6["note"].text)     # the depths are the signals' (15 Oct)
	_check_fit(main, "Runs (levels)")
	main._missions._pick_zone(1)
	_find_at_mine_checks(main)
	_tier_guide_checks(main)
	_site_unique_checks(main)
	_smg_line_checks(main)
	_growth_checks(main)
	_combo_checks(main)
	_auto_gone_checks(main)
	_socket_find_checks(main)
	sim.words[3] = hold_intel[0]
	sim.words[11] = hold_intel[1]
	sim.depth = hold_depth
	sim.best_depth = hold_best
	sim._surv_cache = {}


## A fifth of the finds at the runner's level (16 Oct, Matt's playtest: level 10 at the Bank, every drop for 14): the
## level to wear on the cards, a fifth of the plain gear at the wearable item level and the rest at the site's, on a
## site and a signal alike; a runner past the site gets all of it at the site's.
func _find_at_mine_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var keep_xp: float = sim.xp
	sim.xp = Data.xp_for_level(9)               # a level under the Bank's drops (10 at 2 x - 2, 19 Oct)
	var mine: int = sim.wearable_level()
	_check(sim.wear_of(mine) <= 9 and sim.wear_of(mine + 1) > 9, "the wearable item level at 9 is %d (wears at %d)" % [mine, sim.wear_of(mine)])
	var bank: Dictionary = sim.effective(8)
	var site_lv: int = int(bank["level"])
	var w: Array = sim.finds_words(site_lv)
	_check(site_lv > mine and w == [str(sim.wear_of(site_lv))], "the Bank's Gear level reads '%s', not its number" % str(w))
	var tally := func(t: Dictionary) -> Array:
		sim.rng.seed = 1616
		var low := 0
		var gear := 0
		var m := {"found": [], "tier": int(t["tier"]), "kills": 0, "patrols": 0}
		for k in range(1500):
			var got: Dictionary = sim._find(m, t, false, {}, true)
			var it: Dictionary = got["it"]
			if str(it.get("slot", "")) in Data.SLOTS and not it.has("unique") and not it.has("set") and not it.get("mythic", false):
				gear += 1
				if int(it.get("ilvl", 0)) == mine:
					low += 1
		return [low, gear]
	var on_site: Array = tally.call(bank)
	var share: float = float(on_site[0]) / maxf(1.0, float(on_site[1]))
	_check(on_site[1] > 200 and share > 0.14 and share < 0.27, "the Bank's plain gear at the runner's level: %d of %d" % [on_site[0], on_site[1]])
	var sig: Dictionary = bank.duplicate(true)
	sig["level"] = site_lv + 6                 # a signal's fix, deeper than the campaign site
	var on_sig: Array = tally.call(sig)
	var sig_share: float = float(on_sig[0]) / maxf(1.0, float(on_sig[1]))
	sig["loot_tier"] = Data.MAX_TIER           # a deep fix's bases: the runner's fifth comes on the campaign's, as a gamble's
	sim.rng.seed = 77
	var deep_ok := true
	var mm := {"found": [], "tier": 8, "kills": 0, "patrols": 0}
	for k in range(600):
		var g: Dictionary = sim._find(mm, sig, false, {}, true)["it"]
		if str(g.get("slot", "")) in Data.SLOTS and not g.has("unique") and not g.has("set") and int(g.get("ilvl", 0)) == mine and int(g["tier"]) > sim.gear_tier():
			deep_ok = false
	_check(deep_ok, "a find at the runner's level came on a deep base, past the campaign's tier %d" % sim.gear_tier())
	_check(sig_share > 0.14 and sig_share < 0.27, "a signal's plain gear at the runner's level: %d of %d" % [on_sig[0], on_sig[1]])
	sim.xp = Data.xp_for_level(40)
	var past: Array = tally.call(bank)
	_check(past[0] == 0 or sim.wearable_level() == site_lv, "a runner past the site got finds under it: %d" % past[0])
	sim.xp = keep_xp
	# the Runs card says when the rig's short of the fight's rounds (16 Oct), first so it's never the chip left off, and fits
	var keep_rig: Array = sim.rig.duplicate()
	var keep_gun = sim.equipped["Primary"]
	var aside: Array = sim.stash.filter(func(x): return Items.is_ammo(x))     # the stash's rounds would go out with it (the gate's top-up)
	for it in aside:
		sim.stash.erase(it)
	sim.equipped["Primary"] = sim._plain("Primary", _base_of_type("shotgun"))
	sim.rig = []                                  # none at all: short on any fight, however strong the runner (3 shells weren't, on a strong one)
	main.show_room(main.MISSIONS)
	main._missions._pick_zone(1)
	main._missions._shown = ""
	main.refresh()
	var cc: Dictionary = main._missions._cols[0]
	var card_chips: Array = cc["card"].chips.filter(func(b): return b.visible).map(func(b): return str(b.text))
	_check(not card_chips.is_empty() and str(card_chips[0]).begins_with(Words.SITE_CARD["fix_rounds"]) and cc["card"].vals[4].text.contains("hort"), "the Runs card doesn't say the rig's short: %s / '%s'" % [str(card_chips), cc["card"].vals[4].text])
	_check_fit(main, "Runs (rounds short)")
	sim.rig = keep_rig
	sim.equipped["Primary"] = keep_gun
	sim.stash.append_array(aside)
	main._missions._shown = ""
	print("a fifth of the finds at the runner's level ok: the Bank %d of %d, a signal %d of %d" % [on_site[0], on_site[1], on_sig[0], on_sig[1]])


## The map's tier guide (16 Oct, item 11): the button opens it over the Runs room on the zone's first site; its rows are
## the sim's guide_rows (depth 1 the baseline, the gear's level as finds carry it, what opens at its depth); the Where
## to farm tab names every head and every site's own unique; both tabs fit; the close puts the room back.
func _tier_guide_checks(main) -> void:
	var sim = main.sim
	var ms = main._missions
	main.show_room(main.MISSIONS)
	main.refresh()
	if sim.on_mission():
		print("the tier guide: skipped on a run")
		return
	var g = ms._guide
	g.site = -1
	g.tab = "depths"
	ms._guide_btn.pressed.emit()
	main.refresh()
	_check(g.visible and g.site == ms._tier(0) and g._site_title.text == str(Data.TIERS[g.site]["name"]), "the guide didn't open on the zone's first site: visible %s, site %d, '%s'" % [str(g.visible), g.site, g._site_title.text])
	_check_fit(main, "Runs (the tier guide, depths)")
	# the ladder as a signal plays it (the review: depth comes by signals, by level): from the site's own level, the
	# first row a signal at it against the campaign's run; the site's own unique at the level its depth reaches; the
	# deep tiers marked; the gangs never easing as the levels climb past the campaign's
	for i in [3, 8, 11]:
		var lv0: int = sim.lv_at(i, 1)
		var rows: Array = sim.guide_rows(i, lv0, 24)
		var r0: Dictionary = rows[0]
		_check(rows.size() == 24 and int(r0["level"]) == lv0 and int(r0["wear"]) == sim.wear_of(lv0) and int(r0["depth"]) == sim.tier_depth(lv0), "%s's first row isn't its own level: %s" % [Data.TIERS[i]["name"], str(r0)])
		var own: Dictionary = sim.site_unique(i)
		var own_lv: int = sim.site_unique_level(i)
		var own_row: Array = rows.filter(func(r): return int(r["level"]) == own_lv)
		_check(own.is_empty() or own_lv < lv0 or own_lv >= lv0 + 24 or (not own_row.is_empty() and own_row[0]["marks"].any(func(m): return str(m[0]).begins_with(str(own["name"])))), "%s's own unique isn't marked at level %d" % [Data.TIERS[i]["name"], own_lv])
		_check(own.is_empty() or sim.tier_depth(own_lv) == sim.site_unique_depth(i), "%s's own unique level %d isn't where a signal's depth reaches %d" % [Data.TIERS[i]["name"], own_lv, sim.site_unique_depth(i)])
		var ok := true
		for k in range(rows.size()):
			var r: Dictionary = rows[k]
			if int(r["level"]) in Data.DEEP_TIER_LEVELS:
				ok = ok and r["marks"].any(func(m): return str(m[1]) == "deep")
			if k >= 1 and int(r["depth"]) >= 3:
				ok = ok and float(r["gangs"]) >= float(rows[k - 1]["gangs"]) * (1.0 - 1e-6)
		_check(ok, "%s's ladder: a deep tier unmarked, or the gangs easing with level: %s" % [Data.TIERS[i]["name"], str(rows.map(func(r): return [int(r["level"]), snappedf(float(r["gangs"]), 0.01), r["marks"].map(func(m): return m[1])]))])
	# a ladder from part-way up doesn't mark again what opened under its first row
	var part: Array = sim.guide_rows(8, sim.lv_at(8, 1) + 10, 6)
	_check(not part[0]["marks"].any(func(m): return str(m[1]) == "set"), "a ladder from part-way up marks the set pieces again: %s" % str(part[0]["marks"]))
	# the table shows the rows from a few under the reach, the reach marked
	g._pick_site(11)
	var from: int = sim.guide_from(11, g.ROWS)
	var br: Array = sim.guide_rows(11, from, g.ROWS)
	var here: int = sim.reach - from
	var shown_ok: bool = g._rows[0]["cells"][0].text.ends_with("%d" % int(br[0]["level"])) and g._rows[11]["cells"][1].text == "Level %d" % int(br[11]["wear"])
	_check(shown_ok and (here < 0 or here > 11 or (g._rows[here]["cells"][0].text.begins_with("▶") and g._rows[here]["edge"].visible)), "the guide's table doesn't show the Barracks' rows: '%s', '%s' (reach %d from %d)" % [g._rows[0]["cells"][0].text, g._rows[11]["cells"][1].text, sim.reach, from])
	_check_fit(main, "Runs (the tier guide, the Barracks)")
	# where to farm
	g._pick_tab("farm")
	var farm_text: String = " | ".join(g.text_nodes().map(func(l): return str(l.text)))
	var missing: Array = []
	for b in Data.BOSSES:
		var bn: String = str(b["name"]) if g.known(sim, int(b["tier"])) else Fmt.scramble(str(b["name"]))     # not yet known: scrambled (20 Oct)
		if not farm_text.contains(bn):
			missing.append(b["name"])
	for i in range(Data.TIERS.size()):
		var u: Dictionary = sim.site_unique(i)
		if not u.is_empty() and not farm_text.contains(str(u["name"]) if g.known(sim, i) else Fmt.scramble(str(u["name"]))):
			missing.append(u["name"])
	var lf: Array = g.looking_for(sim)
	_check(missing.is_empty() and lf.any(func(x): return str(x[0]) == "Rifles" and str(x[1]).contains(g.site_name(sim, 11))), "Where to farm leaves out %s (looking for: %s)" % [str(missing), str(lf.slice(0, 3))])
	# a guide on a fresh camp: only the Outskirts known, the rest scrambled and not to be picked
	var fresh_s = Sim.new()
	fresh_s.start()
	_check(g.site_name(fresh_s, 0) == str(Data.TIERS[0]["name"]) and g.site_name(fresh_s, 11) == Fmt.scramble(str(Data.TIERS[11]["name"])) and not g.known(fresh_s, 11), "the guide knows a fresh camp's Barracks")
	_check(g.looking_for(fresh_s).all(func(x): return not str(x[1]).contains("The Barracks")), "the guide names the Barracks to a fresh camp")
	_check_fit(main, "Runs (the tier guide, where to farm)")
	g._close.pressed.emit()
	main.refresh()
	_check(not g.visible and ms.text_nodes().has(ms._title), "the guide's close didn't put the room back")
	g.tab = "depths"
	print("the tier guide: the ladders, the marks, where to farm ok")


## What grows without end (7 Oct): paragon levels past the cap on the same curve, the lorries' multiplier, and an affix's
## value by item level - so the second leg reaches further than the first and a deep drop beats a shallow one.
## Socketables, a find of their own (21 Oct, Matt's save: 4 in 300 finds): SOCKET_FIND of every find, kills too, about half
## the class's own pair's elements; the roll at the find's tier or under, a plain one in a stack of one.
func _socket_find_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var hold: Dictionary = sim.to_dict()
	_set_cls(sim, "Drifter")
	var own := 0
	var n := 400
	for k in range(n):
		var it: Dictionary = sim.socket_find_roll(9)
		_check(Items.is_socketable(it) and it["affixes"].is_empty() and int(it.get("count", 1)) == 1, "a socketable find isn't a plain socketable: %s" % str(it).substr(0, 120))
		if float(Items.base_of(it).get("conv_fire_pct", 0)) > 0.0 or float(Items.base_of(it).get("conv_shock_pct", 0)) > 0.0:
			own += 1
	_check(own > n * 0.45 and own < n * 0.85, "a Drifter's socketables: %d of %d fire or shock" % [own, n])
	_check(int(Items.base_of(sim.socket_find_roll(1))["tier"]) <= 1, "a tier-1 find's socketable came over its tier")
	# through the finds themselves, searches and kills
	sim.hp = sim.max_hp()
	sim.deploy(0)
	var socks := [0, 0]
	var finds := 1500
	for from_kill in [false, true]:
		for k in range(finds):
			var f: Dictionary = sim._find(sim.mission, sim.mission["t"], from_kill, {}, true)
			if not f.is_empty() and Items.is_socketable(f["it"]):
				socks[1 if from_kill else 0] += 1
	_check(socks[1] >= finds * Data.SOCKET_FIND * 0.6 and socks[0] >= finds * Data.SOCKET_FIND * 0.6, "socketables a find: %d of %d searches, %d of %d kills" % [socks[0], finds, socks[1], finds])
	sim.extract_now()
	sim.load_dict(hold)
	print("socketable finds ok")


## What came in auto-run's place (21 Oct, Matt): the Lookout's Early warning - after the clear, no gang till the first
## crate's searched - and the bus depot's pack cells.
func _auto_gone_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var hold: Dictionary = sim.to_dict()
	_check(not ("auto_tier" in sim.to_dict()) and not sim.has_method("set_auto"), "auto-run is still in the sim")
	_yard_ids(sim, ["early_warning", "watch_rota"], "early_warning")
	_yard_ids(sim, ["hold_fire", "tripwires"], "tripwires")      # Tripwires, not Hold fire: Early warning alone
	_check(sim.yard_has("early_warning") and not sim.yard_has("hold_fire"), "the Lookout's fourth pick is not Early warning")
	var m := {"patrols": 0, "crate_i": 0, "crates": [{"kind": "x"}], "found": []}
	_check(sim.gang_held(m), "Early warning let a gang come before the first crate")
	m["crate_i"] = 1
	_check(not sim.gang_held(m), "Early warning held the gang past the first crate")
	m["crate_i"] = 0
	m["dry"] = true
	_check(not sim.gang_held(m), "Early warning held a dry run's gang")
	var cap0: int = sim.capacity_raw()
	sim.rebuilt["bus_depot"] = 1
	var cap1: int = sim.capacity_raw()
	sim.rebuilt["bus_depot"] = 3
	_check(cap1 - cap0 == 2 * (2 if sim.has_node("hoarder") else 1) and sim.capacity_raw() - cap0 == 4 * (2 if sim.has_node("hoarder") else 1), "the bus depot's pack: +%d at rank 1, +%d at rank 3" % [cap1 - cap0, sim.capacity_raw() - cap0])
	sim.load_dict(hold)
	print("auto-run gone: Early warning, the bus depot's pack ok")


## The broken builds (21 Oct, Data.COMBOS): on with every part, off with any one gone or the balance's switch, and a
## run's stacks growing with no top - the class, its set at its count, the unique, the element's keystone and capstone.
const COMBO_TREES := {"embers": "Petrol", "clean_kills": "The cold", "flatline": "Live", "opened_for_good": "Blades", "live_load": "Live", "drilled": "Knuckles"}
const COMBO_STOPPERS := ["never_there", "hit_and_run", "walking_wounded"]     # the nodes that would stop a run's stacks: no recipe walks through one
func _combo_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var hold: Dictionary = sim.to_dict()
	# the first of each gang off the kit (21 Oct, Matt: "fix both"): an affix's line and a set's count in the fight's figure
	for sl in Data.SLOTS:
		sim.equipped[sl] = null
	sim._dry_memo.clear()
	var f0: float = sim.first_pct_total()
	var hat: Dictionary = sim._plain("Helmet", "Hard hat")
	hat["affixes"] = [{"stat": "first_pct", "value": 20, "tier": 2}]
	sim.equipped["Helmet"] = hat
	_check(is_equal_approx(sim.first_pct_total(), f0 + 20.0), "an affix's first of each gang isn't the fight's: %.0f from %.0f" % [sim.first_pct_total(), f0])
	var army: Dictionary = Items.set_named("The Army's")
	for k in range(3):
		sim.equipped[army["pieces"][k]["slot"]] = Items.roll_set_piece(army["name"], army["pieces"][k], sim.rng)
	var f3: float = sim.first_pct_total()
	_check(f3 >= f0 + 40.0, "the Army's three-piece first of each gang isn't the fight's: %.0f from %.0f" % [f3, f0])
	sim.load_dict(hold)
	for key in Data.COMBOS:
		var c: Dictionary = Data.COMBOS[key]
		sim.load_dict(hold)
		_set_cls(sim, str(c["class"]))
		var et: String = COMBO_TREES[key]
		var trees: Array = [et]
		for j in Data.JOINTS:
			if j["class"] == c["class"] and j["element_tree"] == et:
				trees.append(j["tree"])            # the joint's class half: the element's tops open with it
		sim.tree = []
		for tn in trees:
			for i in range(Data.tree_named(tn)["nodes"].size()):
				sim.tree.append("%s/%d" % [tn, i])
		for sl in Data.SLOTS:
			sim.equipped[sl] = null
		var st: Dictionary = Items.set_named(str(c["set"]))
		for k in range(int(c["pieces"])):
			var pc: Dictionary = st["pieces"][k]
			sim.equipped[pc["slot"]] = Items.roll_set_piece(st["name"], pc, sim.rng)
		var u: Dictionary = {}
		for x in Data.UNIQUES:
			if x.get("rule", "") == c["rule"]:
				u = x
		if u.is_empty():
			_check(not sim.combo_on(key), "%s turned on with no unique for its rule" % key)
			continue                            # Flatline's bag comes with the pinnacles' uniques (24 Oct)
		sim.equipped[u["slot"]] = Items.roll_unique(u, sim.rng, 10)
		if sim.equipped["Primary"] == null:
			sim.equipped["Primary"] = sim._plain("Primary", "Pump shotgun")     # Flatline's unique is a bag: a gun to make the kills with (25 Oct, a flake: bare hands)
		sim._dry_memo.clear()
		# its recipe (24 Oct): each node it needs walked to from nothing under the real gates, the build on at the end
		var tree_full: Array = sim.tree.duplicate()
		var gates_was: bool = sim.core_gates
		sim.core_gates = true
		sim.tree = []
		sim.xp = maxf(sim.xp, Data.xp_for_level(50))
		sim.best_level = maxi(sim.best_level, 50)    # the Pitch's points: an element's starter is theirs (24 Oct)
		var walked: Array = []
		for path in c.get("recipe", []):
			var rid: String = Data.node_id_named(str(path))
			_check(rid != "" and _walk_gated(sim, rid, COMBO_STOPPERS), "%s's recipe: %s does not train from nothing ('%s')" % [key, path, sim.train_block(rid) if rid != "" else "no such node"])
			walked.append(rid)
		_check(c.get("recipe", []).size() == 4 and sim.combo_on(key), "%s's recipe doesn't turn the build on: %s" % [key, str(c.get("recipe", []))])
		_check(not COMBO_STOPPERS.any(func(e): return sim.has_node(e)), "%s's recipe walks through a node that stops the stacks" % key)
		sim.core_gates = gates_was
		sim.tree = tree_full
		sim._dry_memo.clear()
		_check(sim.combo_on(key), "%s's build is not on with every part: class %s, set %d, rule %s, nodes %s" % [key, sim.cls, sim.set_count(str(c["set"])), str(sim.has_rule(str(c["rule"]))), str(c["nodes"].map(func(n): return sim.has_node(str(n))))])
		var others: Array = Data.COMBOS.keys().filter(func(k2): return k2 != key and sim.combo_on(k2))
		_check(others.is_empty(), "%s's build turns on another's: %s" % [key, str(others)])
		# its defensive half (Matt, 27 Oct): a stack takes COMBO_GUARD_STEP off their fire, to the cap; none with no stacks
		_check(is_equal_approx(sim.combo_guard({"combo": 30.0}), 1.0 - 30.0 * Data.COMBO_GUARD_STEP) and is_equal_approx(sim.combo_guard({"combo": 1e6}), 1.0 - Data.COMBO_GUARD_CAP) and is_equal_approx(sim.combo_guard({}), 1.0),
			"%s's stacks don't guard: %.2f at 30, %.2f at a million" % [key, sim.combo_guard({"combo": 30.0}), sim.combo_guard({"combo": 1e6})])
		var warm_m := {}
		_check(sim._combo_warm(warm_m) == key and is_equal_approx(float(warm_m.get("combo", 0.0)), Data.COMBO_WARM), "%s's run doesn't start warm: %s" % [key, str(warm_m)])     # Matt, 27 Oct
		Sim.combos_off = true
		var cold_m := {}
		_check(sim._combo_warm(cold_m) == "" and not cold_m.has("combo"), "%s starts warm with the balance's switch off" % key)
		_check(is_equal_approx(sim.combo_guard({"combo": 30.0}), 1.0), "%s's guard holds with the balance's switch off" % key)
		_check(not sim.combo_on(key), "%s's build is on with the balance's switch off" % key)
		Sim.combos_off = false
		var piece_slot: String = st["pieces"][0]["slot"]
		var piece = sim.equipped[piece_slot]
		sim.equipped[piece_slot] = null
		_check(not sim.combo_on(key), "%s's build is on a set piece short" % key)
		sim.equipped[piece_slot] = piece
		# a run: the stacks grow, kill on kill
		for sl in ["Primary", "Secondary"]:
			if sim.equipped[sl] != null:
				var box: Dictionary = sim.ammo_box(Items.ammo_type(sim.equipped[sl]))
				if not box.is_empty():
					for fed in _rmags(sim, box["name"], 8):     # a pile at real size (the three-stage review, tools 4: 2000 in one was trimmed at the gate)
						sim.rig.push_front(fed)
		if key == "drilled":                   # the Recruit's: a kill while a skill of his runs - three of his slotted, auto
			var sk_d: Dictionary = _skill_node_ids()
			for sid in ["make_ready", "suppressing_fire", "smoke"]:
				if not sim.tree.has(sk_d[sid]):
					sim.tree.append(sk_d[sid])
			sim.skill_slots = ["make_ready", "suppressing_fire", "smoke"]
			sim.skill_auto = [true, true, true]
			sim._dry_memo.clear()
		sim.hp = sim.max_hp()
		sim.deploy(3)
		sim.mission["remaining"] = 400
		var seen: Array = []
		for k in range(40):
			sim.hp = sim.max_hp()
			sim.advance(1.0)
			if sim.mission == null:
				break
			if k == 19 or k == 39:
				seen.append(Sim.combo_stacks(sim.mission))
				seen.append(int(sim.mission["remaining"]))
		_check(seen.size() == 4 and float(seen[0]) > 0.0 and (float(seen[2]) > float(seen[0]) or int(seen[1]) == 0) and is_finite(float(seen[2])), "%s's stacks did not grow on a run (stacks, left): %s" % [key, str(seen)])
		if sim.on_mission():
			sim.extract_now()
		if key == "drilled":                   # and none with no skill of his running (the review: the condition alone)
			sim.skill_slots = ["", "", ""]
			sim._dry_memo.clear()
			sim.hp = sim.max_hp()
			sim.deploy(3)
			sim.mission["remaining"] = 400
			for k in range(20):
				sim.hp = sim.max_hp()
				sim.advance(1.0)
				if sim.mission == null:
					break
			_check(sim.mission != null and int(sim.mission["kills"]) > 0 and Sim.combo_stacks(sim.mission) == Data.COMBO_WARM, "Drilled stacked with no skill of his running: %s" % (str(Sim.combo_stacks(sim.mission)) if sim.mission != null else "no run"))
			if sim.on_mission():
				sim.extract_now()
	# their figures on screen: past an int's top, a figure in e-notation that fits its tile (the review)
	_check(Fmt.num(1e30) == "1.0e30" and Fmt.num(2.5e12) == "2.5T" and Fmt.num(3e9) == "3.0B" and Fmt.num(-1e30) == Fmt.MINUS + "1.0e30", "a broken build's figures read %s / %s / %s" % [Fmt.num(1e30), Fmt.num(2.5e12), Fmt.num(3e9)])
	sim.load_dict(hold)
	sim.record["dealt"] = 1e30
	main.show_room(main.RUNNER)
	main.refresh()
	_check_fit(main, "the stats, a broken build's most damage")
	sim.load_dict(hold)
	print("the broken builds ok")


func _growth_checks(main) -> void:
	var sim = main.sim
	var hold: Dictionary = sim.to_dict()
	sim.lorries = 0
	sim.hp = 1e12                          # never under half: the under-half damage would ride on the growth (10 Oct)
	sim.xp = Data.xp_for_level(Data.MAX_LEVEL)
	var hp50: float = sim.max_hp()
	var dps50: float = sim.dps()
	_check(sim.level() == Data.MAX_LEVEL and sim.paragon() == 0 and is_equal_approx(sim.growth_mult(), 1.0), "at the cap the growth reads %.2f with %d paragon" % [sim.growth_mult(), sim.paragon()])
	sim.paragon_xp = 0.0
	sim.paragon_reset_free()
	# the paragon board (21 Oct, the crew; the web's ring from 22 Oct, slice 4): XP past the cap is the crew's; a level a
	# point, nothing paid until it's spent; a point goes on a ring node (RING_STACK to a node, pathed round from a
	# class's entry)
	sim._gain_xp(Data.xp_for_level(Data.MAX_LEVEL + 10) - Data.xp_for_level(Data.MAX_LEVEL))
	_check(sim.level() == Data.MAX_LEVEL and is_equal_approx(sim.xp, Data.xp_for_level(Data.MAX_LEVEL)) and sim.paragon() == 10 and sim.paragon_free() == 10, "ten levels past the cap read level %d, paragon %d, %d free, the runner's XP %.0f" % [sim.level(), sim.paragon(), sim.paragon_free(), sim.xp])
	_check(is_equal_approx(sim.max_hp(), hp50) and is_equal_approx(sim.dps(), dps50), "paragon levels paid with no point spent: hp ×%.2f" % (sim.max_hp() / hp50))
	for k in range(6):
		sim.paragon_add("damage")
	for k in range(4):
		sim.paragon_add("hp")
	var pct_d: float = float(Data.paragon_row("damage")["pct"])
	var pct_h: float = float(Data.paragon_row("hp")["pct"])
	_check(not sim.paragon_add("find") and sim.paragon_free() == 0, "a point past the paragon levels went on the board")
	_check(is_equal_approx(sim.max_hp() / hp50, 1.0 + 4.0 * pct_h / 100.0) and is_equal_approx(sim.dps() / dps50, 1.0 + 6.0 * pct_d / 100.0), "the board's points did not pay (adding, the designer's call 31 Oct): hp ×%.3f dps ×%.3f" % [sim.max_hp() / hp50, sim.dps() / dps50])
	var pg: Array = sim.paragon_progress()
	_check(is_equal_approx(pg[0], 0.0) and pg[1] > 0.0, "the next paragon level reads %s" % str(pg))
	# the paragon's levels grow gently past 50, not doubling every seven (24 Oct: they stopped coming and the reach walled)
	var step_at := func(l: int) -> float: return Data.xp_for_level(l + 1) - Data.xp_for_level(l)
	_check(is_equal_approx(step_at.call(Data.MAX_LEVEL), floorf(step_at.call(Data.MAX_LEVEL - 1) * (1.0 + Data.PARAGON_XP_GROW))) and absf(step_at.call(Data.MAX_LEVEL + 20) / step_at.call(Data.MAX_LEVEL) - (1.0 + 21.0 * Data.PARAGON_XP_GROW) / (1.0 + Data.PARAGON_XP_GROW)) < 0.01, "the paragon's levels (linear at PARAGON_XP_GROW): %.0f at 50, %.0f at 70" % [step_at.call(Data.MAX_LEVEL), step_at.call(Data.MAX_LEVEL + 20)])
	# resists and find, and a reset for tins: the points free again
	var fire0: float = sim.resist_raw("fire")
	var find0: float = sim.rarity_bonus()
	sim.cash = 1e9
	var cost: int = sim.paragon_reset_cost()
	_check(cost > 0 and sim.paragon_reset() and sim.paragon_free() == 10 and is_equal_approx(sim.cash, 1e9 - cost), "the board's reset: %d free, cost %d" % [sim.paragon_free(), cost])
	for k in range(4):
		sim.paragon_add("resists")           # the ring: the Recruit's spoke at 0° is a resists entry (24 Oct; it was a step round from hp)
	for k in range(2):
		sim.paragon_add("find")
	_check(sim.paragon_pts("resists") == 4 and sim.paragon_pts("hp") == 0 and sim.paragon_pts("find") == 2, "the way round the ring to resists reads wrong: %s" % str(sim.ring))
	_check(Data.RING["nodes"].filter(func(nd): return nd["entry"]).map(func(nd): return str(nd["key"])).size() == Data.CLASSES.size(), "the ring has an entry off a class's spoke")
	_check(is_equal_approx(sim.resist_raw("fire") - fire0, 4.0 * float(Data.paragon_row("resists")["pct"])) and is_equal_approx(sim.rarity_bonus() - find0, 2.0 * float(Data.paragon_row("find")["pct"]) / 100.0), "resists +%.1f and find +%.3f off the board" % [sim.resist_raw("fire") - fire0, sim.rarity_bonus() - find0])
	# the crew's, saved with the camp, not a runner's
	var d: Dictionary = JSON.parse_string(JSON.stringify(sim.to_dict()))
	var back = Sim.new()
	back.load_dict(d)
	_check(back.paragon() == 10 and back.paragon_pts("resists") == 4 and back.paragon_pts("find") == 2 and back.ring.values().all(func(v): return typeof(v) == TYPE_INT), "the ring did not survive a save: %s" % str(back.ring))
	# a resist point re-reads the odds (the review: it moves no bucket in their key); the board's resists stop at the cap
	var key0: Array = sim._odds_key(0)
	sim.paragon_add("resists")
	sim._key_memo = []
	_check(sim._odds_key(0) != key0, "a resist point on the board left the odds' key as it was")
	var over0: float = sim.over_cap("fire")
	for id in sim.ring:
		if sim.node(str(id))["key"] == "resists":
			sim.ring[id] = 500                   # past any stack: the cap holds
			sim._stats_dirty()                     # a fixture set straight in (BUILD43: the live stat memo hears of it)
	sim._dry_memo.clear()
	_check(is_equal_approx(sim.resist_raw("fire"), maxf(fire0, Data.RESIST_CAP)) and is_equal_approx(sim.over_cap("fire"), over0), "the board's resists went past the cap: %.1f, over the cap %.1f from %.1f" % [sim.resist_raw("fire"), sim.over_cap("fire"), over0])
	# the Barracks (slice 4): the ring on the web - a node picked says its stack, Train puts a paragon point on it, the
	# reset button is the ring's; the ring's label carries the points free
	sim.paragon_reset_free()
	sim._dry_memo.clear()
	main.show_room(main.BARRACKS)
	var bk = main._barracks
	var wv = bk.web()
	_check(not bk.also_names().has("Paragon"), "the paragon board is still in the Also row: %s" % str(bk.also_names()))
	var ring_t: Dictionary = Data.RING
	_check(ring_t["nodes"].size() == Data.RING_NODES and wv.layout.has("%s/0" % Data.RING_TREE), "the ring is not on the web")
	var entry_id := ""
	for i in range(ring_t["nodes"].size()):
		if ring_t["nodes"][i].get("entry", false) and ring_t["nodes"][i]["key"] == Data.PARAGON_BOARD[0]["key"]:
			entry_id = "%s/%d" % [Data.RING_TREE, i]
	if entry_id == "":
		for i in range(ring_t["nodes"].size()):
			if ring_t["nodes"][i].get("entry", false):
				entry_id = "%s/%d" % [Data.RING_TREE, i]
	_check(entry_id != "" and sim.can_train(entry_id), "a ring entry can't take a paragon point: '%s'" % sim.train_block(entry_id))
	var off_id := "%s/%d" % [Data.RING_TREE, (int(entry_id.get_slice("/", 1)) + 3) % Data.RING_NODES]
	_check(sim.train_block(off_id).begins_with("wants a path"), "a ring node three on from an entry took a point with nothing before it: '%s'" % sim.train_block(off_id))
	wv.pick(entry_id)
	main.refresh()
	_check(bk._where.text.to_lower().contains("the paragon ring") and bk._where.text.contains("0 of %d" % Data.RING_STACK) and bk._train.visible and bk._train.text.contains("paragon point"), "a ring node picked reads '%s' / '%s'" % [bk._where.text, bk._train.text])     # its place and its stack under its name (3 Nov, the card)
	_check_fit(main, "Caravan (a ring node picked)")
	bk._on_train()
	main.refresh()
	_check(int(sim.ring.get(entry_id, 0)) == 1 and sim.paragon_free() == 9 and bk._where.text.contains("1 of %d" % Data.RING_STACK), "Train did not put a paragon point on the ring node: '%s'" % bk._where.text)
	var next_id := "%s/%d" % [Data.RING_TREE, (int(entry_id.get_slice("/", 1)) + 1) % Data.RING_NODES]
	_check(sim.can_train(next_id), "the next ring node is not reached from a stacked one: '%s'" % sim.train_block(next_id))
	for k in range(Data.RING_STACK):
		sim.train_node(entry_id)
	_check(sim.train_block(entry_id).begins_with("full") and int(sim.ring[entry_id]) == Data.RING_STACK, "a ring node took points past its stack: %d, '%s'" % [int(sim.ring[entry_id]), sim.train_block(entry_id)])
	_check(bk._respec.text.begins_with("Reset the ring") and not bk._respec.disabled, "the ring's reset button reads '%s'" % bk._respec.text)
	bk._on_respec()
	bk._on_respec()     # the reset asks twice now (25 Oct, the review)
	_check(sim.paragon_spent() == 0 and sim.ring.is_empty() and not sim.tree.any(func(id): return sim.is_ring(str(id))), "the ring's reset button did not reset it")
	wv.pick("")
	sim.paragon_xp = Data.xp_for_level(Data.MAX_LEVEL + 10) - Data.xp_for_level(Data.MAX_LEVEL)
	_check(Data.xp_for_level(Data.MAX_LEVEL + 11) > Data.xp_for_level(Data.MAX_LEVEL + 10) and Data.xp_for_level(Data.MAX_LEVEL + 10) > Data.xp_for_level(Data.MAX_LEVEL), "the XP curve stops at the cap")
	main.refresh()
	_check(main._top_labels["level"].text == "%d +10" % Data.MAX_LEVEL and main._top_labels["xp"].text.contains(" / "), "the top bar does not say the paragon: '%s' / '%s'" % [main._top_labels["level"].text, main._top_labels["xp"].text])   # the figure with LEVEL beside it since the sheet (8 Oct)
	_check_fit(main, "Top bar (paragon)")
	sim.xp = Data.xp_for_level(Data.MAX_LEVEL)
	sim.paragon_xp = 0.0
	sim.paragon_reset_free()
	sim._dry_memo.clear()
	sim.lorries = 3
	_check(is_equal_approx(sim.max_hp() / hp50, pow(Data.LORRY_MULT, 3)) and is_equal_approx(sim.dps() / dps50, pow(Data.LORRY_MULT, 3)), "three lorries did not multiply the Pitch: hp ×%.2f" % (sim.max_hp() / hp50))
	# an affix's value by item level: nothing to ILVL_FROM, a fifth more at five past, the same tier
	var a := {"stat": "hp", "min": 10, "max": 50}
	var at15 := Items.roll_affix(a, Data.ILVL_FROM, sim.rng, 5)
	var at25 := Items.roll_affix(a, Data.ILVL_FROM + 10, sim.rng, 5)
	_check(int(at15["value"]) <= 50 and int(at25["value"]) >= int(round(Items.tier_range(a, 5)[0] * Items.ilvl_mult(Data.ILVL_FROM + 10))) and int(at25["tier"]) == 5, "the deep affix did not grow: %d at %d, %d at %d" % [int(at15["value"]), Data.ILVL_FROM, int(at25["value"]), Data.ILVL_FROM + 10])
	_check(is_equal_approx(Items.ilvl_mult(Data.ILVL_FROM + 10), 1.0 + Data.ILVL_SCALE * 10.0) and is_equal_approx(Items.ilvl_mult(5), 1.0), "the item level's multiplier is off")
	var u_shallow: Dictionary = Items.roll_unique(sim._unique_named("Lucky Cap"), sim.rng, 5)
	var u_deep: Dictionary = Items.roll_unique(sim._unique_named("Lucky Cap"), sim.rng, Data.ILVL_FROM + 20)
	_check(Items.ilvl(u_deep) == Data.ILVL_FROM + 20 and str(u_deep["affixes"][0]["stat"]) == "loot_pct" and int(u_deep["affixes"][0]["value"]) == int(round(20 * Items.ilvl_mult(mini(Data.ILVL_FROM + 20, Data.PCT_LINE_TOP)))) and int(u_shallow["affixes"][0]["value"]) == 20, "a unique found deep does not carry the depth: %d / %d" % [int(u_shallow["affixes"][0]["value"]), int(u_deep["affixes"][0]["value"])])
	# the find carries the site's level into a unique
	sim.best_depth[11] = 30
	sim.set_depth(11, 25)
	var t: Dictionary = sim.effective(11)
	var found: Dictionary = Items.roll_unique(sim.site_unique(11), sim.rng, int(t["level"]))
	_check(Items.ilvl(found) == 33, "the Barracks at depth 25 did not give a level-33 unique: %d" % Items.ilvl(found))
	# gear scaling (21 Oct): past ILVL_GROW_FROM a base's damage and armour and a flat line compound, a percent line doesn't
	var g0: int = Data.ILVL_GROW_FROM
	var g10: float = pow(1.0 + Data.ILVL_GROW, 10.0)
	_check(is_equal_approx(Items.grow(g0), 1.0) and is_equal_approx(Items.grow(5), 1.0) and is_equal_approx(Items.grow(g0 + 10), g10), "the bases' growth reads %.3f at %d" % [Items.grow(g0 + 10), g0 + 10])
	var gun: Dictionary = sim._plain("Primary", "Pipe shotgun")
	var vest: Dictionary = sim._plain("Armour", "Work jacket")
	vest["affixes"] = []
	gun["ilvl"] = g0
	vest["ilvl"] = g0
	var gun0: float = Items.dps(gun)
	var vest0: float = Items.armour(vest)
	gun["ilvl"] = g0 + 10
	vest["ilvl"] = g0 + 10
	_check(gun0 > 0.0 and vest0 > 0.0 and is_equal_approx(Items.dps(gun) / gun0, g10) and is_equal_approx(Items.armour(vest) / vest0, g10), "a base's damage or armour did not grow past the deep tier: ×%.3f, ×%.3f" % [Items.dps(gun) / maxf(gun0, 0.001), Items.armour(vest) / maxf(vest0, 0.001)])
	var flat: Array = Items._scaled([{"stat": "hp", "value": 100}, {"stat": "damage_pct", "value": 100}], g0 + 10)
	_check(int(flat[0]["value"]) == int(round(100.0 * Items.ilvl_mult(g0) * g10)) and int(flat[1]["value"]) == int(round(100.0 * Items.ilvl_mult(Data.PCT_LINE_TOP))), "a fixed list at a deep level: hp %d, damage %% %d" % [int(flat[0]["value"]), int(flat[1]["value"])])
	# a set piece at a deep find keeps its own base (its resist, its conversion, its look), lifted to its type's best there
	var lifted := 0
	for st in Data.SETS:
		for pc in st["pieces"]:
			var deep_pc: Dictionary = Items.roll_set_piece(st["name"], pc, sim.rng, g0 + 10, Data.MAX_TIER)
			var own_pc: Dictionary = Items.roll_set_piece(st["name"], pc, sim.rng, g0 + 10)
			var b: Dictionary = Items.base_named(pc["slot"], pc["base"])
			_check(deep_pc["base"] == pc["base"] and own_pc["base"] == pc["base"] and Items.base_of(deep_pc).get("res", {}) == b.get("res", {}) and Items.base_of(deep_pc).get("conv_bleed_pct", 0) == b.get("conv_bleed_pct", 0) and Items.score(deep_pc) >= Items.score(own_pc) - 0.001, "%s's %s at a deep find: on %s, %.0f against its own %.0f" % [st["name"], pc["name"], deep_pc["base"], Items.score(deep_pc), Items.score(own_pc)])
			lifted += 1 if float(deep_pc.get("lift", 1.0)) > 1.0 else 0
	_check(lifted > 0, "no set piece found deep was lifted")
	for st in Data.SETS:                   # a charm's lift reads in its find and cash; a bag's or a rig's none (the review)
		for pc in st["pieces"]:
			var deep_pc: Dictionary = Items.roll_set_piece(st["name"], pc, sim.rng, g0 + 10, Data.MAX_TIER)
			var lf: float = float(deep_pc.get("lift", 1.0))
			if pc["slot"] in [Data.CHARM]:
				_check(lf <= 1.0 or Items.find(deep_pc) + Items.cash_pct(deep_pc) > Items.find(Items.roll_set_piece(st["name"], pc, sim.rng, g0 + 10)) + Items.cash_pct(Items.roll_set_piece(st["name"], pc, sim.rng, g0 + 10)), "%s's lift does nothing to its find" % pc["name"])
			elif not (Data.SLOT_SCORE[pc["slot"]] in ["dps", "armour"]):
				_check(lf <= 1.0, "%s carries a lift its slot never reads: %.2f" % [pc["name"], lf])
	# the armour's cut, a med's heal and a grenade's hit read the level fought: a deep run's, the campaign's as they were
	var m_was = sim.mission
	sim.mission = {"t": {"level": g0 + 10}}
	_check(sim.fight_level() == g0 + 10 and is_equal_approx(sim.armour_k(), Data.ARMOUR_K * g10) and is_equal_approx(sim.fight_grow(), g10), "the armour's cut on a deep run reads %.1f" % sim.armour_k())
	sim.mission = {"t": {"level": 5}}
	_check(is_equal_approx(sim.armour_k(), Data.ARMOUR_K) and is_equal_approx(sim.fight_grow(), 1.0), "the armour's cut in the campaign moved: %.1f" % sim.armour_k())
	sim.mission = m_was
	# a shop's unique scales as the gamble does
	sim.mate = {"unique": "Lucky Cap", "notes": 0}
	var shop_u: Dictionary = sim._mate_item()
	_check(not shop_u.is_empty() and Items.ilvl(shop_u) == sim.gamble_level(), "the mate's unique at level %d, the gamble's %d" % [Items.ilvl(shop_u), sim.gamble_level()])
	sim.load_dict(hold)
	print("the growth ok: paragon, the lorries, the deep affix, the bases")


## The SMG line (7 Oct): a gun a tier from T2 to T6, two at T6, the top over the shotguns'; every SMG primary
## carries walking fire, read in the fight's stream and said on the panel's tail.
func _smg_line_checks(main) -> void:
	var sim = main.sim
	# the itemisation (29 Oct): three a tier T2-4, two a tier T5-9; each tier's best close to the other types' best (the
	# type's edge decides the fight, not the figure)
	var smgs: Array = []
	for b in Data.BASES["Primary"]:
		if b.get("type", "") == "smg":
			smgs.append(b)
	var tiers: Array = smgs.map(func(b): return int(b["tier"]))
	for t in range(2, 10):
		_check(tiers.count(t) == (3 if t <= Data.CAMPAIGN_TIER else 2), "the SMG line has %d at T%d" % [tiers.count(t), t])
	for t in range(2, 10):
		var top_smg := 0.0
		var top_other := 0.0
		for b in Data.BASES["Primary"]:
			if not b.has("rof") or int(b["tier"]) != t or b.get("start", false):
				continue
			var dps: float = float(b["damage"]) * float(b["rof"])
			if b.get("type", "") == "smg":
				top_smg = maxf(top_smg, dps)
			elif b.get("type", "") != "melee":
				top_other = maxf(top_other, dps)
		_check(top_smg > top_other * 0.8 and top_smg < top_other * 1.2, "the SMG top at T%d is %.0f against the others' %.0f: close was the aim" % [t, top_smg, top_other])
	for b in smgs:
		_check(b.has("sustain"), "%s has no walking fire" % b["name"])
		_check(Words.item_words(b["name"]) != "", "%s has no words" % b["name"])
	# walking fire in the stream: nothing at the gang's first tick, the cap after ten seconds, reset by the next gang
	var hold = sim.equipped["Primary"]
	sim.equipped["Primary"] = sim._plain("Primary", "Riot squad's SMG")
	var m := {"sustain_t": 0.0}
	_check(is_equal_approx(sim.sustain_mult(m), 1.0), "walking fire starts above nothing")
	m["sustain_t"] = 5.0
	_check(is_equal_approx(sim.sustain_mult(m), 1.2), "walking fire at five seconds reads %.2f, not 1.20" % sim.sustain_mult(m))
	m["sustain_t"] = 30.0
	_check(is_equal_approx(sim.sustain_mult(m), 1.4), "walking fire did not cap at +40%%: %.2f" % sim.sustain_mult(m))
	sim.equipped["Primary"] = sim._plain("Primary", "Riot squad's shotgun")
	_check(is_equal_approx(sim.sustain_mult(m), 1.0), "a shotgun walks its fire")
	sim.equipped["Primary"] = hold
	# the panel's tail says it
	var gun: Dictionary = sim._plain("Primary", "Courier's SMG")
	_check(Items.edge_words(gun) == "+4% damage for each second on the same gang, to +40%" and not Items.base_res_words(gun).contains("a second"), "the SMG's edge line does not say walking fire, or says it twice: '%s' / '%s'" % [Items.edge_words(gun), Items.base_res_words(gun)])
	print("the SMG line ok: nine guns, walking fire")


## A site's own unique (endgame part 3): never loose, gated by zone (the streets at 12, the Barracks at 6),
## found on its site past the gate and nowhere shallower; the Runs card names it until it is on the shelf.
func _site_unique_checks(main) -> void:
	var sim = main.sim
	for u in sim.loose_uniques(99):
		_check(not u.has("site"), "%s is a site's own and loose" % u["name"])
	_check(sim.site_unique_depth(3) == 12 and sim.site_unique_depth(7) == 9 and sim.site_unique_depth(11) == 6, "the sites' own depths are off: %d %d %d" % [sim.site_unique_depth(3), sim.site_unique_depth(7), sim.site_unique_depth(11)])
	_check(sim.site_unique(11)["name"] == "The Quartermaster's Manual" and sim.site_unique(3)["name"] == "The Gritter's Hopper", "the sites' own are off")
	var hold_shelf: Array = sim.shelf.duplicate()
	var hold_stash: Array = sim.stash.duplicate()
	sim.shelf = []
	# the Barracks at depth 5: never; at depth 6: within a few hundred finds
	var own := 0
	for d in [5, 6]:
		own = 0
		sim.set_depth(11, d)
		sim.deploy(11)
		var m: Dictionary = sim.mission
		var eff: Dictionary = sim.effective(11)
		for k in range(400):
			m["found"] = []
			sim._find(m, eff)
			if not m["found"].is_empty() and m["found"][0].get("unique", "") == "The Quartermaster's Manual":
				own += 1
		sim.extract_now()
		if d == 5:
			_check(own == 0, "the Barracks' own dropped at depth 5")
		else:
			_check(own > 0 and own < 60, "the Barracks' own is %d of 400 finds at depth 6; 3%% was the aim" % own)
	# the Runs card names it until it is found
	sim.shelf = []
	main.show_room(main.MISSIONS)
	main._missions.select(11)
	main.refresh()
	var c8: Dictionary = main._missions._cols[0]
	_check(main._missions._station_words(11).contains("signal: The Quartermaster's Manual, only here"), "the Barracks' station words do not name its own: '%s'" % main._missions._station_words(11))
	_check(not c8["note"].text.contains("Depth"), "the Barracks' card still names a depth's station: '%s'" % c8["note"].text)
	_check_fit(main, "Runs (a site's own)")
	sim.shelf = ["The Quartermaster's Manual"]
	_check(not main._missions._station_words(11).contains("its own"), "the Barracks' station words still name its own once found")
	# the Fence's gamble never hands out the chase
	var chase_names: Array = []
	for c in sim.shelf_chase():
		chase_names.append(c["name"])
	var leaked := ""
	for k in range(300):
		var g: Dictionary = sim.roll_gamble({"slot": "Charm", "type": ""}, 0.0)
		if g.get("unique", "") in chase_names:
			leaked = g["unique"]
	_check(leaked == "", "the gamble handed out the chase: %s" % leaked)
	main._missions._pick_zone(1)
	sim.shelf = hold_shelf
	sim.stash = hold_stash


## The map at thirty-six (endgame part 4, 7 Oct): the new nodes' effects, each read through the sim.
func _map_nodes_checks(main) -> void:
	var sim = main.sim
	var hold: Dictionary = sim.to_dict()
	sim.atlas = {}
	sim.atlas_points = 100
	sim.words[3] = []
	var take := func(keys: Array):
		for k in keys:
			_check(_rank_to(sim, k), "%s did not take" % k)
	sim.set_depth(3, 2)
	var e0: Dictionary = sim.effective(3)
	# the sites' column, down the chain
	take.call(["picked_over", "deeper_pockets", "quiet_roads", "after_dark"])
	var e1: Dictionary = sim.effective(3)
	_check("Night" in e1["intel"] and float(e1["rarity"]) - float(e0["rarity"]) >= 0.5 * 1.5 - 0.001, "After dark did not make the run a night run with the dark's half again: %.2f" % (float(e1["rarity"]) - float(e0["rarity"])))
	var ep1: int = sim.atlas_rank("easy_pickings")     # the Map's web (22 Oct): the way to After dark ranks Easy pickings on the rich way
	take.call(["second_look", "second_look", "open_ground", "short_cuts", "short_cuts", "worn_in", "worn_in"])     # the quiet way in its order: a shortcut through the keystone would rank it
	_check(is_equal_approx(sim.crate_trickle_s(), Data.CRATE_TRICKLE_S / 2.0), "Worn in did not halve the crates' trickle: %.0f" % sim.crate_trickle_s())
	take.call(["easy_pickings", "easy_pickings", "local_knowledge", "every_penny", "every_penny"])
	var e2: Dictionary = sim.effective(3)
	_check(is_equal_approx(float(e2["drop"]) / float(e1["drop"]), (1.0 + 0.1 * 2.0) / (1.0 + 0.1 * ep1)), "Easy pickings is off: %.2f" % (float(e2["drop"]) / float(e1["drop"])))
	_check(int(e2["loot_tier"]) == int(e1["loot_tier"]) + 1, "Local knowledge did not add a gear tier")
	_check(is_equal_approx(float(e2["pace"]) / float(e1["pace"]), 1.1), "Short cuts is off")
	_check(int(e2["contact"]) == int(e1["contact"]) - 1, "Open ground did not take one off")
	_check(is_equal_approx(float(e2["cash"]) / float(e1["cash"]), 1.2), "Every penny is off")
	var best0: int = sim.best_depth[3]
	sim.best_depth[3] = 3
	sim.set_depth(3, 6)
	_check(sim.depth[3] == 4, "without the keystone the ladder opened past the deepest plus one: %d" % sim.depth[3])
	var reach0: int = sim.reach
	sim.reach = 20
	var band0: Array = sim.signal_band([-1])     # one paper (20 Oct): the faint band reaches furthest under
	take.call(["lie_of_the_land"])
	var band1: Array = sim.signal_band([-1])
	_check(int(band0[0]) == 20 + int(Data.SIGNAL_GRADES[0]["roll"][0][0]) and int(band1[0]) == 20 - int(Data.FX["atlas/lie_of_the_land"]), "The lie of the land did not stop the low rolls: %s -> %s (18 Oct)" % [str(band0), str(band1)])
	sim.reach = reach0
	sim.set_depth(3, 2)
	sim.best_depth[3] = best0
	# the crews' column
	take.call(["paid_in_notes", "two_of_everything", "heads_up", "heads_up"])
	sim.boss_paid[5] = []                 # the runs above paid him: Long memory reads from here
	sim.bosses_beaten[1] = true
	sim.depth[5] = 3                     # the ladder by hand: the Lie of the land no longer opens it (18 Oct)
	var full: int = int(sim.boss_of(5)["notes"]) * 3
	_check(sim.boss_cost(5) == int(round(full / 3.0)), "Heads up is off: %d of %d" % [sim.boss_cost(5), full])
	_check(sim.pinnacle_depth(11) == int(Data.PINNACLE_DEPTH[3]), "the pinnacle moved before Full strength")
	take.call(["full_strength"])
	_check(sim.pinnacle_depth(11) == int(Data.PINNACLE_DEPTH[3]) - 2, "Full strength did not bring the pinnacle two sooner")
	take.call(["bounties", "bounties", "wages", "wages", "wages", "heavy_crews"])
	var e3: Dictionary = sim.effective(3)
	_check(is_equal_approx(float(e3["xp"]) / float(e2["xp"]), 1.3 * 1.5) and is_equal_approx(float(e3["cash"]) / float(e2["cash"]), 1.5) and int(e3["contact"]) == int(e2["contact"]) + 1, "Wages and Heavy crews are off")
	take.call(["their_own_kit", "their_own_kit", "marked_men", "long_memory"])
	sim.notes += 10000
	sim.arm_boss(5, true)
	sim.deploy(5)
	var paid_at: Array = sim.boss_paid[5].duplicate()
	sim.extract_now()
	_check(paid_at == [3] and sim.boss_cost(5) == 0, "Long memory did not make the next run at that depth free: %d, %s" % [sim.boss_cost(5), str(paid_at)])
	sim.set_depth(5, 2)
	_check(sim.boss_cost(5) > 0, "Long memory made another depth free")
	sim.arm_boss(5, true)
	sim.deploy(5)
	sim.extract_now()
	_check(sim.boss_paid[5] == [3, 2] and sim.boss_cost(5) == 0, "Long memory forgot a depth: %s" % str(sim.boss_paid[5]))
	sim.depth[5] = 3                     # the ladder by hand: the Lie of the land no longer opens it (18 Oct)
	_check(sim.boss_cost(5) == 0, "Long memory forgot the first depth paid")
	take.call(["head_start"])
	var pts: int = sim.atlas_points
	sim.deploy(5)
	var m: Dictionary = sim.mission
	m["boss"] = {"name": sim.boss_of(5)["name"], "zone": 0, "alive": true, "hp": 1.0, "started": true, "pinnacle": true}
	sim._boss_down(m, sim.effective(5))
	sim.extract_now()
	_check(sim.atlas_points == pts + 1, "Head start did not pay a point for a head at full strength")
	_check(int(m.get("notes", 0)) >= Data.NOTES_BOSS * 3 * 2, "Bounties did not double the head's notes: %d" % int(m.get("notes", 0)))
	var hi0: int = int(sim.signal_band([])[1])
	take.call(["lorrys_route"])
	_check(int(sim.signal_band([])[1]) == hi0 + 1, "The lorry's route did not widen the decoder's band at the top: %d from %d" % [int(sim.signal_band([])[1]), hi0])     # 15 Oct
	# the air (9 Oct): the juicing lane, each read through the sim on the streets at depth 2
	sim.yard_picks.erase("radio")              # the Radio's Scanner and band read alone elsewhere
	sim.yard_ranks = {}
	sim._yard_changed("")
	sim.words[3] = []
	sim.sealed[3] = false
	sim.notes += 100000
	var rc0: int = sim.word_craft_cost(3, "retune")
	take.call(["good_reception", "good_reception"])
	_check(sim.word_craft_cost(3, "retune") == maxi(1, int(ceil(rc0 * 0.7 - 0.0001))), "Good reception is off: %d of %d" % [sim.word_craft_cost(3, "retune"), rc0])
	_check(not sim.atlas_open("long_wave") or sim.atlas_rank("clear_air") > 0, "the codes' third spine node opened with the second not ranked")
	take.call(["clear_air"])
	_check(sim.set_filtered("Numbers") and sim.filtered == "Numbers", "Clear air did not take a filter")
	var heard := false
	for k in range(40):
		heard = heard or sim._roll_words(3, [], 2).any(func(wd): return wd["w"] == "Numbers")
	_check(not heard, "Clear air's word was still heard")
	var mw2: int = sim.max_words(3)
	var er0: Dictionary = sim.effective(3)
	take.call(["tip_offs", "tip_offs", "booster", "booster", "booster", "long_wave"])     # the quality way in its order (22 Oct: Booster sits past Tip-offs)
	_check(is_equal_approx(float(sim.word_effect("Numbers", 1)["drop"]), 1.0 + 0.3 * 1.3), "Booster is off: %s" % str(sim.word_effect("Numbers", 1)))
	_check(sim.max_words(3) == mw2 + 1 and mw2 == 2, "Long wave did not add a word at depth 2: %d from %d" % [sim.max_words(3), mw2])
	_check(is_equal_approx(float(sim.effective(3)["rarity"]) - float(er0["rarity"]), 0.1), "Tip-offs is off")
	take.call(["strong_signal", "strong_signal"])
	var twos := 0
	for k in range(40):
		twos += 1 if sim._roll_tier(3) == 2 else 0
	_check(twos > 10 and sim.word_tier_now(3, 2) == 2, "Strong signal did not land tier II at depth 2: %d of 40" % twos)
	var call0: int = sim.word_craft_cost(3, "call")
	take.call(["early_word", "early_word", "held_frequency"])
	_check(sim.word_craft_cost(3, "call") == maxi(1, int(ceil(float(call0) * 0.5 - 0.6))) or absi(sim.word_craft_cost(3, "call") - int(ceil(call0 * 0.5))) <= 1, "Early word is off: %d of %d" % [sim.word_craft_cost(3, "call"), call0])
	take.call(["relay"])
	_check(sim.set_standing(0, "Tooled up") and "Tooled up" in sim.effective(3)["intel"] and sim.active_words(3).size() == 1, "the Relay's standing word is not on the site: %s" % str(sim.active_words(3)))
	_check(not sim.set_standing(1, "Ex-army"), "a second standing word without the whole band")
	take.call(["bent", "whole_band"])
	_check(sim.set_standing(1, "Ex-army") and sim.active_words(3).size() == 2, "the whole band's second word is not on the site: %s" % str(sim.active_words(3)))
	sim.words[3] = [{"w": "Bailiffs", "t": 1}]
	_check(sim.active_words(3).size() == 3, "a site's own word and the two standing ones do not all work: %s" % str(sim.active_words(3)))
	var ranks := 0
	for a in Data.ATLAS:
		ranks += int(a["max"])
	_check(ranks == 59 and Data.ATLAS_ALL.size() >= Data.ATLAS.size() + 24 and sim.atlas_free() == sim.atlas_points - sim.atlas_spent(), "the map's ranks do not add to fifty-nine with the fillers: %d, %d free" % [ranks, sim.atlas_free()])
	_open_map(main)
	main._radio._atlas._shown = ""
	main.refresh()
	_check_fit(main, "Radio (the map, full)")
	main._radio._pick_view("air")
	# Held frequency (21 Oct): Hold at half price
	var hold_price: int = sim.word_craft_cost(3, "hold")
	sim.atlas.erase("held_frequency")
	_check(sim.word_craft_cost(3, "hold") >= hold_price * 2 - 1, "Held frequency does not halve Hold: %d with, %d without" % [hold_price, sim.word_craft_cost(3, "hold")])
	sim.load_dict(hold)


## The map in the Caravan's shape (Map-A, 7 Oct); the Dial as columns (28 Oct, RadioDial): every region a column, every
## node and filler a tile inside it, none on another; the taken tiles lit; the sum strip; and the panel filled by a
## pick with a rank taken through it.
func _map_screen_checks(main) -> void:
	var sim = main.sim
	var at = main._radio._atlas
	var wv = at.web()
	# every atlas node and every filler a tile, inside its region's column, none on another, all in the Dial's room
	var ids: Array = []
	for t in Data.MAP_WEB:
		for i in range(t["nodes"].size()):
			ids.append("%s/%d" % [t["name"], i])
	_check(at.visible and wv.visible and ids.size() == Data.ATLAS_ALL.size() and ids.size() >= Data.ATLAS.size() + 24, "the Dial has %d nodes for %d atlas nodes" % [ids.size(), Data.ATLAS_ALL.size()])
	for a in Data.ATLAS:
		_check(Data.map_id(a["key"]) != "", "%s is not on the Dial" % a["key"])
	_check(wv.col_rects.size() == Data.MAP_WEB.size(), "the Dial has %d columns for %d regions" % [wv.col_rects.size(), Data.MAP_WEB.size()])
	for c in range(wv.col_rects.size()):
		var cr: Rect2 = wv.col_rects[c]
		_check(cr.position.x >= 0.0 and cr.end.x <= wv.size.x + 0.5 and cr.end.y <= wv.size.y + 0.5, "the Dial's column %d runs out of its room: %s" % [c, str(cr)])
		if c > 0:
			_check(cr.position.x >= wv.col_rects[c - 1].end.x, "the Dial's columns %d and %d overlap" % [c - 1, c])
	var outside := 0
	for id in ids:
		_check(wv.layout.has(id), "%s has no tile on the Dial" % id)
		var c: int = Data.MAP_WEB.map(func(t): return t["name"]).find(str(id).get_slice("/", 0))
		if not wv.col_rects[c].grow(-2.0).encloses(wv.layout[id]):
			outside += 1
			if outside <= 3:
				_check(false, "%s's tile %s runs out of its column %s" % [id, str(wv.layout[id]), str(wv.col_rects[c])])
	_check(outside == 0, "%d Dial tiles run out of their column" % outside)
	var overlaps := 0
	for a_i in range(ids.size()):
		for b_i in range(a_i + 1, ids.size()):
			if wv.layout[ids[a_i]].grow(1.0).intersects(wv.layout[ids[b_i]]):
				overlaps += 1
				if overlaps <= 3:
					_check(false, "the Dial's tiles %s and %s sit on each other" % [ids[a_i], ids[b_i]])
	_check(overlaps == 0, "%d pairs of Dial tiles sit on each other" % overlaps)
	# the spine down the middle, the entry at the top and the keystone at the foot; a filler smaller than a node
	for t in Data.MAP_WEB:
		var e: Rect2 = wv.layout["%s/0" % t["name"]]
		var ks: Rect2 = wv.layout["%s/3" % t["name"]]
		var c: int = Data.MAP_WEB.find(t)
		var mid: float = wv.col_rects[c].get_center().x
		_check(absf(e.get_center().x - mid) < 2.0 and absf(ks.get_center().x - mid) < 2.0 and e.position.y < ks.position.y, "%s's spine isn't down the middle, entry over keystone" % t["name"])
		for i in range(t["nodes"].size()):
			var r: Rect2 = wv.layout["%s/%d" % [t["name"], i]]
			if t["nodes"][i].get("filler", false):
				_check(r.size.y < e.size.y and r.size.x < e.size.x, "%s's filler %d is no smaller than a node" % [t["name"], i])
			elif float(t["nodes"][i]["at"][1]) != 0.0:
				_check(absf(r.get_center().x - mid) > e.size.x * 0.5, "%s's branch node %d sits on the spine" % [t["name"], i])
	wv.show_state(sim)
	for key in sim.atlas:
		if sim.atlas_rank(key) > 0 and Data.map_id(key) != "":
			_check(wv.state_of(Data.map_id(key)).get("taken", false), "%s is ranked and the Dial doesn't show it" % key)
	var taken := 0
	for key in sim.atlas:
		if sim.atlas_rank(key) > 0 and not Data.atlas_of(key).get("filler", false):
			taken += 1
	_check(at._sum_chips.shown() >= mini(taken, at.SUM_CHIPS) - 1 and at._sum_chips.shown() <= mini(taken, at.SUM_CHIPS) + 1, "the map's sum strip shows %d chips for %d taken" % [at._sum_chips.shown(), taken])
	# the regions: a spine ending in the keystone, two branches; a shut node's panel says what it needs
	for t in Data.MAP_WEB:
		var keys: Array = t["nodes"].filter(func(n): return not n.get("filler", false)).map(func(n): return n["key"])
		var last: Dictionary = Data.atlas_of(t["nodes"][3]["key"])
		_check(keys.size() == (12 if t["column"] != 2 else 11) and last.get("keystone", false), "%s is not its nodes with the keystone at the spine's end" % t["name"])
	_check(wv._tiles[Data.map_id("lie_of_the_land")]["line"].text.begins_with("keystone") or sim.atlas_rank("lie_of_the_land") > 0, "the keystone's tile doesn't say so: '%s'" % wv._tiles[Data.map_id("lie_of_the_land")]["line"].text)
	at._pick("lie_of_the_land")
	_check(at._pic.visible == (at.WebView.picture("map_lie_of_the_land") != null) and (not at._pic.visible or at._title.position.x >= at._pic.position.x + at._pic.size.x), "the Dial's pick doesn't show its painted picture, or its words sit on it")
	# a filler's picture by its own name, map_f_ (the tools review's B24: the path untested since the web went)
	var filler_key := ""
	for t in Data.MAP_WEB:
		for n in t["nodes"]:
			if n.get("filler", false) and filler_key == "":
				filler_key = str(n["key"])
	_check(filler_key != "", "the fixture: the Dial has no filler")
	if filler_key != "":
		at._pick(filler_key)
		var fa: Dictionary = Data.atlas_of(filler_key)
		_check(at._pic.visible == (at.WebView.picture("map_f_" + Items.slug(str(fa.get("name", "")))) != null), "a filler's panel picture isn't its map_f_ one: %s" % filler_key)
		at._pick("lie_of_the_land")
	_check((at._title.text.to_lower().contains("wants a path") or at._title.text.to_lower().contains("opens at %d points" % Data.MAP_KEYSTONE_POINTS) or sim.can_rank_atlas("lie_of_the_land")) and (at._take.disabled or sim.can_rank_atlas("lie_of_the_land")), "a shut node's panel does not say what it needs: '%s'" % at._title.text)
	# a tile pressed picks it; the panel's words keep clear of its buttons
	wv._tiles[Data.map_id("quiet_roads")]["button"].pressed.emit()
	_check(at.selected == "quiet_roads" and wv.selected == Data.map_id("quiet_roads"), "a Dial tile pressed didn't pick it: '%s'" % at.selected)
	_check(at._title.position.y + at._title.size.y <= at._take.position.y and at._words.position.x + at._words.size.x <= at._take.position.x, "the Dial panel's words run under its buttons")
	# a pick fills the panel; a rank through it takes; the pips follow
	var rank0: int = sim.atlas_rank("quiet_roads")
	sim.atlas_points += 1
	at._pick("quiet_roads")
	_check(at._title.text.to_lower().begins_with("quiet roads · rank %d of 3" % rank0) and at._take.visible and not at._take.disabled and at._words.text.ends_with("."), "the map's panel after a pick is off: '%s' / '%s'" % [at._title.text, at._words.text])
	_check(at._words.position.y >= at._chips.position.y + Chips.CHIP_H, "the map panel's sentence sits on its chips")
	at._on_take()
	_check(sim.atlas_rank("quiet_roads") == rank0 + 1 and at._title.text.to_lower().begins_with("quiet roads · rank %d of 3" % (rank0 + 1)), "a rank through the panel did not take: %d, '%s'" % [sim.atlas_rank("quiet_roads"), at._title.text])
	_check(wv.state_of(Data.map_id("quiet_roads"))["taken"] and wv._tiles[Data.map_id("quiet_roads")]["rank"].text == "%d/3" % (rank0 + 1), "the ranked tile doesn't say its rank: '%s'" % wv._tiles[Data.map_id("quiet_roads")]["rank"].text)     # its badge on the picture (BUILD49 U, item 14)
	_check_fit(main, "Runs (the map, picked)")
	sim.atlas_points -= 1                 # the point lent above goes back: the save check after counts them


## The rail (9 Oct, Matt's order and names): the loadout is Runner, the sheet is Stats, the Bench is the Workshop.
func _rail_order_checks(main) -> void:
	var want := ["Stats", "The Kit", "The Map", "Training", "The Clinic", "Workshop", "The Fence", "The Pitch", "Radio"]     # the order the rooms open (3 Nov, Matt; BUILD47): the Workshop before the Fence; the names as today (Home's rename parked)
	_check(main.ROOMS == want, "the rail's rooms are %s" % str(main.ROOMS))
	var ys := []
	for name in want:
		var b = main._rail_buttons[name]
		ys.append(b.position.y)
		_check(b._name.text == name, "the rail's %s row reads '%s'" % [name, b._name.text])
	for k in range(1, ys.size()):
		_check(ys[k] > ys[k - 1], "the rail's %s row is not under %s" % [want[k], want[k - 1]])
	main.show_room(main.ARMOURY)
	main.refresh()
	_check(main._armoury.visible and main.ARMOURY == "The Kit", "the Kit does not open the loadout")
	main.show_room(main.RUNNER)
	main.refresh()
	_check(main.RUNNER == "Stats" and main._stats.visible and not main._grid.visible, "Stats does not open the runner's sheet")
	_check(main._rail_buttons["Workshop"]._glyph.texture != null and main._rail_buttons["The Kit"]._glyph.texture != null, "Workshop or the Kit lost its glyph")


## Place art (9 Oct): a painted site shows in its band, a painted zone behind its tab; none painted, the skyline.
func _place_art_checks(main) -> void:
	main.show_room(main.MISSIONS)
	main._missions._pick_zone(1)
	main._missions._shown = ""
	main.refresh()
	var card = main._missions._cols[0]["card"]
	var site: String = Data.TIERS[Data.ZONES[1]["tiers"][0]]["name"]
	_check(card._art.texture == UI.place_texture(site), "the site card's picture does not follow art/places/%s.png" % Items.slug(site))
	var img := Image.create(64, 21, false, Image.FORMAT_RGBA8)
	img.fill(Color("8899aa"))
	var tex := ImageTexture.create_from_image(img)
	var had_site = UI._places.get(Items.slug(site), null)
	UI._places[Items.slug(site)] = tex
	main._missions._shown = ""
	main.refresh()
	_check(card._art.texture == tex and card._fade.visible, "a painted site does not show in its picture")
	_check(card._art.get_index() < card._fade.get_index() and card.title.get_parent() == card.pic and card._fade.get_index() < card.title.get_index(), "the site art sits over the picture's words")
	_check_fit(main, "Runs (site art)")
	if had_site == null:
		UI._places.erase(Items.slug(site))
	else:
		UI._places[Items.slug(site)] = had_site
	main._missions._shown = ""
	main.refresh()
	# the Clinic's and the Fence's bands read their own places (art/places/the_clinic.png, the_fence.png), the Map's its own
	_check(main._fence._band._seed == hash("The Fence") and main._clinic._band._seed == hash("The Clinic"), "the Fence's or the Clinic's band does not name its place for its art")
	_check(main._radio._atlas._band._seed == hash("the map"), "the Map's band does not name its place for its art")
	# with the Fence's art painted, its face still reads clear (the backdrop sits under it, 9 Oct: the Legion's first run with the art)
	var had_fence = UI._places.get("the_fence", null)
	UI._places["the_fence"] = tex
	main._fence._band._seed = 0
	main._fence._band.set_site("The Fence")
	main.show_room(main.MARKET)
	main.refresh()
	_check(main._fence._band.has_art() and main._fence.face_clear() and main._fence._band.get_child(0) == main._fence._band._art, "the Fence's painted band sits over its face, or isn't shown")
	if had_fence == null:
		UI._places.erase("the_fence")
	else:
		UI._places["the_fence"] = had_fence
	main._fence._band._seed = 0
	main._fence._band.set_site("The Fence")


func _yard_checks(main) -> void:
	var sim = main.sim
	_loot_roll_checks(main)
	if sim.on_mission():
		sim.extract_now()
	# the Stats room as a sheet (10 Oct, Stats-R A): the seven parts, each with its picture; every figure the cards had
	main.show_room(main.RUNNER)
	main.refresh()
	var st = main._stats
	for want in ["runner", "attack", "defence", "finds", "record", "last", "wall"]:
		_check(st.cards.has(want) and st.cards[want]["panel"].visible, "the sheet has no %s" % want)
	_check_fit(main, "Stats")
	_yard_wide_checks(main)
	main.show_room(main.RUNNER)
	main.refresh()
	var defence: Dictionary = st.cards["defence"]
	var fire_row: Dictionary = defence["res"][Data.ELEMENTS.find("fire")]
	_check(fire_row["key"].text == "Fire" and fire_row["value"].text.begins_with("%.0f%%" % (sim.resist("fire") * 100.0)) and (fire_row["value"].get_theme_color("font_color") == Pal.ELEMENT_COLOURS["fire"] or fire_row["value"].get_theme_color("font_color") == Pal.BAD), "the sheet's fire resist is off: %s" % fire_row["value"].text)
	_check(defence["headline"].text == "%d" % sim.max_hp_shown() and defence["unit"].text == "max HP", "the Defence headline is not the max HP: '%s'" % defence["headline"].text)
	_check(is_equal_approx(fire_row["tick"].position.x + 1.0, fire_row["track"].size.x * Data.RESIST_CAP / 100.0), "the resist bar's tick is not at the cap")
	# a torch makes the deal share show on Attack: a chip and its segment of the split
	var hold_gun = sim.equipped["Primary"]
	var torch: Dictionary = sim._plain("Primary", "Nail gun")
	torch["affixes"] = [{"stat": "conv_fire_pct", "value": 50, "tier": 2}]     # 50, not 20: a 20% burn off a weak nail gun sat on the 0.5 a second the split shows from (18 Oct flake)
	sim.equipped["Primary"] = torch
	main.refresh()
	var attack: Dictionary = st.cards["attack"]
	var fire_share: int = int(round(float(sim.conversion().get("fire", 0.0)) * 100.0))
	var attack_chips: Array = _chip_texts(attack["chips"])
	_check(fire_share >= 20 and attack_chips.has("Fire %d%%" % fire_share) and attack["segs"][Data.TYPES.find("fire")].visible, "with %d%% as fire the Attack chips read %s" % [fire_share, str(attack_chips)])
	var split: Dictionary = sim.damage_split()
	_check(attack["headline"].text == "%.0f" % float(split["total"]) and attack["unit"].text == "dmg/s", "the Attack headline is '%s', not the damage a second (the hits and the dots)" % attack["headline"].text)
	_check(float(split["dot"]) > 0.0 and attack["note"].text in [sim.split_words(split), sim.split_words(split, true)] and sim.split_words(split).to_lower().contains("burn"), "with a torch the Attack card's split reads '%s' (long: '%s')" % [attack["note"].text, sim.split_words(split)])     # the short form names the biggest dot only: a bot's poison build can outweigh the torch's burn (18 Oct flake)
	_check(main._top_labels["dps"].text == "%.0f dmg/s" % float(split["total"]) and main._top_labels["dps"].tooltip_text == sim.split_words(split), "the top bar's damage reads '%s' (tip '%s'), not the one figure" % [main._top_labels["dps"].text, main._top_labels["dps"].tooltip_text])
	var total_row: Dictionary = attack["chain"][5]
	var edge_row: Dictionary = attack["chain"][4]
	_check(total_row["value"].text == "%.0f/s" % (sim.dps() * sim.edge_read()) and edge_row["key"].text == load("res://scripts/ui/stats_room.gd").edge_key(sim.equipped["Primary"]) and edge_row["key"].text.ends_with(" edge") and edge_row["value"].text == (("×%.2f" % sim.edge_read()) if absf(sim.edge_read() - 1.0) >= 0.005 else "—"), "the chain's total is off: %s, its edge %s" % [total_row["value"].text, edge_row["value"].text])     # the gun type's edge a row (29 Oct): the rows add up to the hits
	for r in attack["chain"]:
		_check(r["fill"].size.x <= r["track"].size.x + 0.5, "a chain bar runs past its track: %s" % r["key"].text)
	var dp: Dictionary = sim.damage_parts()
	var made: float = float(dp["guns"]) * (1.0 + float(dp["level"]) + float(dp["pct"])) * (1.0 + float(dp["attack"])) * float(dp["past"]) * float(dp["trait"]) * float(dp["growth"])
	_check(absf(made - sim.dps()) <= 0.01 * maxf(1.0, sim.dps()), "the damage's parts do not make dps(): %.1f against %.1f" % [made, sim.dps()])
	# a moved Yard's banked paragon is not this runner's XP: the bar's figures never go below nought
	# a time-out is no success on the last run
	var hold_report = sim.last_report
	if hold_report != null:
		var to_report: Dictionary = hold_report.duplicate()
		to_report["outcome"] = "Out of time"
		to_report["timed_out"] = true
		sim.last_report = to_report
		main.refresh()
		_check(st.cards["last"]["headline"].get_theme_color("font_color") == Pal.ACCENT and st.cards["last"]["status"].text.begins_with("Out of time"), "a time-out reads as a success on the last run")
		_check_fit(main, "Stats (out of time)")
		sim.last_report = hold_report
		main.refresh()
	_check_fit(main, "Stats (a torch)")
	sim.equipped["Primary"] = hold_gun
	# the runner's trait reads as a stat: a chip with its figures on the sheet, a line on the Caravan
	var tdata: Dictionary = sim.trait_data()
	if not tdata.is_empty():
		var chip_texts2: Array = _chip_texts(st.cards["runner"]["chips"])
		_check(chip_texts2.any(func(t): return str(t).begins_with(tdata["name"] + ": ")), "the sheet has no trait chip: %s" % str(chip_texts2))
		main.show_room(main.BARRACKS)
		main._barracks.selected = ""
		main.refresh()
		_check(main._barracks._words.text.begins_with(tdata["name"] + ": "), "Training does not give the trait's figures: '%s'" % main._barracks._words.text)
		_check(main._barracks._class_cards.all(func(c): return c["name"].text != "") and main._barracks._class_buttons.all(func(cb): return cb.visible), "Training does not keep the pasts' cards up")
		_check_fit(main, "Caravan (trait)")
		main.show_room(main.OVERVIEW)
		main.refresh()
	main.show_room(main.RUNNER)
	main.refresh()
	var finds: Dictionary = st.cards["finds"]
	_check(finds["unit"].text == "loot quality" and finds["bars"][0]["key"].text == "Loot quantity", "the Finds part is off: %s / %s" % [finds["unit"].text, finds["bars"][0]["key"].text])
	# a bonus below nought reads with a minus, never "+-5%": the rat's share takes 20% off quantity
	var hold_tree: Array = sim.tree.duplicate()
	if not sim.tree.has("The Rat Man/9"):
		sim.tree.append("The Rat Man/9")
	main.refresh()
	var figures: Array = [finds["headline"].text] + finds["bars"].map(func(r): return r["value"].text)
	_check(not figures.any(func(t): return str(t).contains("+-") or str(t).contains("+−")), "a Finds figure reads with a doubled sign: %s" % str(figures))
	_check(sim.loot_bonus() >= 0.0 or finds["bars"][0]["value"].text.begins_with("−"), "a quantity below nought reads '%s'" % finds["bars"][0]["value"].text)
	_check(StatsRoom.signed_pct(-5.0) == "−5%" and StatsRoom.signed_pct(8.0) == "+8%" and StatsRoom.signed_pct(0.0) == "0%" and StatsRoom.signed_pct(-0.2) == "0%", "signed percents read off")
	sim.tree = hold_tree
	main.refresh()
	_check_fit(main, "The Pitch (option A)")
	# the Runs cards: a chip an element they fire, with your resist; the town fires fire and poison
	main.show_room(main.MISSIONS)
	main._missions._pick_zone(2)
	main.refresh()
	var col: Dictionary = main._missions._cols[0]
	var fire_t: String = col["card"].vals[1].text      # their fire against your resist, in words (BUILD46-S)
	if sim.tier_open(Data.ZONES[2]["tiers"][0]):
		_check((Data.ELEMENTS.any(func(e): return fire_t.to_lower().begins_with(e)) or fire_t.to_lower().begins_with("physical")) and (fire_t.contains("resist") or fire_t.contains("armour")), "the town's card does not say what it fires and what you resist: '%s'" % fire_t)
	# the odds in words, the figure small under them; every verdict fits between the faces
	if sim.tier_open(Data.ZONES[2]["tiers"][0]):
		_check(Words.ODDS.any(func(b): return b[1] == col["card"].verdict.text) and col["card"].odds_line.text.ends_with("to clear") or col["card"].odds_line.text == Words.SITE_CARD["reading"], "the odds don't read in words: '%s' / '%s'" % [col["card"].verdict.text, col["card"].odds_line.text])
	for band in Words.ODDS:
		_check(UI.text_width(col["card"].verdict, band[1]) <= col["card"].verdict.size.x and UI.text_width(col["card"].odds_line, "100% to clear") <= col["card"].odds_line.size.x, "the verdict '%s' doesn't fit between the faces" % band[1])
	main.refresh()
	_check(Words.odds_words(0.95) == "Safe" and Words.odds_words(0.5) == "A coin toss" and Words.odds_words(0.05) == "A bad idea", "the odds bands are off")
	_check_fit(main, "Runs (elements)")
	main._missions._pick_zone(1)
	# the Radio (9 Oct): its own screen; the cards are gone
	main.show_room(main.COMMS)
	_settle_odds(main)
	main.refresh()
	_check(main._radio.visible and not main._cards.any(func(c): return c.visible), "the Radio still shows cards")
	_check_fit(main, "Radio (screen)")
	print("the Pitch as option A ok: Elements, Finds, the works; the Runs cards' chips; the Radio's chips")
	_fill_up_checks(main)


## "Fill up, then go": once the fight's won, a button sets the run to leave by
## itself when the pack's full or the next gang comes.
func _fill_up_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	sim.hp = sim.max_hp()
	sim.words[3] = []
	sim.deploy(3)
	var m: Dictionary = sim.mission
	main.show_room(main.MISSIONS)
	main.refresh()
	# the run screen's column: the band carries the site and the clock, the sections stack without overlap, the buttons at the foot
	var rn = main._run
	_check(rn._band.title.text == sim.mission["t"]["name"] and rn._band.headline.text.contains(":") and rn._band.kicker.text == sim.sky_words(int(sim.mission["tier"])), "the run's band is off: '%s' / '%s' / '%s'" % [rn._band.kicker.text, rn._band.title.text, rn._band.headline.text])
	# the sky on the fight (23 Oct, parked item 8): the view's layer follows the site's weather and the clock; the pack
	# card's empty words are the new ones
	if rn._view != null:
		var sky_v: Dictionary = rn._view._sky.showing()
		var w_now: String = sim.fight_weather_of(int(sim.mission["tier"]))
		_check(bool(sky_v["rain"]) == (w_now == "Rain") and bool(sky_v["fog"]) == (w_now == "Fog") and bool(sky_v["night"]) == sim.is_night(), "the fight's sky disagrees with the sim: %s against %s, night %s" % [str(sky_v), w_now, str(sim.is_night())])
		var held_w: Array = sim.weather.duplicate()
		var held_at = sim.weather_at
		for z in range(Data.ZONES.size()):
			sim.weather[z] = "Rain"
		sim.weather_at = 1e9
		main.refresh()
		var tier_was: int = int(sim.mission["tier"])
		for i in range(Data.TIERS.size()):     # the view itself on every site: outdoors it rains, under a roof it's dry (25 Oct; the reviewer: both branches, every run)
			sim.mission["tier"] = i
			main.refresh()
			var roofed_v: bool = str(Data.TIERS[i]["name"]) in Data.INDOOR_SITES
			if roofed_v:
				_check(not bool(rn._view._sky.showing()["rain"]), "rain set and it's raining inside %s" % Data.TIERS[i]["name"])
			else:
				_check(bool(rn._view._sky.showing()["rain"]) and rn._view._sky._light.emitting and rn._view._sky._light.amount >= 12, "rain set and %s's fight isn't raining: %s" % [Data.TIERS[i]["name"], str(rn._view._sky.showing())])
		sim.mission["tier"] = tier_was
		main.refresh()
		for i in range(Data.TIERS.size()):     # dry under a roof, the Map's card still the zone's (25 Oct)
			var roofed: bool = str(Data.TIERS[i]["name"]) in Data.INDOOR_SITES
			_check(sim.weather_of(i) == "Rain" and sim.fight_weather_of(i) == ("" if roofed else "Rain"), "%s's fight sky reads '%s' in the rain" % [Data.TIERS[i]["name"], sim.fight_weather_of(i)])
		_check(rn._view._sky.get_index() < rn._view._cover.get_index() and rn._view._sky.get_index() > rn._view._plate.get_index(), "the fight's sky isn't between the plate and the wall")
		# the fight's fog thinner than the Map's (23 Oct)
		for z in range(Data.ZONES.size()):
			sim.weather[z] = "Fog"
		main.refresh()
		var fmat = rn._view._sky._fog.material
		_check(bool(rn._view._sky.showing()["fog"]) and fmat is ShaderMaterial and is_equal_approx(float(fmat.get_shader_parameter("max_a")), float(rn._view._sky.FIGHT_FOG["max_a"])) and float(rn._view._sky.FIGHT_FOG["max_a"]) < float(rn._view._sky.MAP_FOG["max_a"]), "fog set and the fight's isn't its thinner banks: %s" % str(rn._view._sky.showing()))
		sim.weather = held_w
		sim.weather_at = held_at
		main.refresh()
	_check(rn._band.bar.visible and rn._band._bar_label.text.ends_with(" down") or rn._band._bar_label.text == "Cleared", "the run's band has no progress bar: '%s'" % rn._band._bar_label.text)
	_check(rn.FIGHT_Y >= rn.BAND_H and rn.RUNNER_Y > rn.FIGHT_BAR_Y + rn.BAR_H and rn.RIG_Y > rn.RUNNER_NOTE_Y and rn.TAKE_Y > rn.RIG_Y + Pal.CELL and rn.STRIP_Y + rn.STRIP_H <= rn.BUTTON_Y, "the run column's sections overlap: fight %d runner %d rig %d take %d strip %d button %d" % [rn.FIGHT_Y, rn.RUNNER_Y, rn.RIG_Y, rn.TAKE_Y, rn.STRIP_Y, rn.BUTTON_Y])
	# them and you each in a box: the box holds its head, tiles and bar, and the two boxes sit apart
	var fb := Rect2(rn._fight["box"].position, rn._fight["box"].size)
	var rb := Rect2(rn._runner["box"].position, rn._runner["box"].size)
	for piece in [rn._fight["head"], rn._fight["tiles"][3]["panel"]] + ([rn._fight["track"]] if rn._view == null else []):     # with the frame their HP's over each of them (item 11)
		_check(fb.encloses(Rect2(piece.position, piece.size)), "the fight's box does not hold its %s" % piece.name)
	for piece in [rn._runner["head"], rn._runner["track"], rn._runner["tiles"][3]["panel"], rn._runner["note"]]:
		_check(rb.encloses(Rect2(piece.position, piece.size)), "the runner's box does not hold its %s" % piece.name)
	_check(fb.end.y + 8 <= rb.position.y and fb.position.y >= rn.BAND_H and rb.end.y < rn.RIG_HEAD_Y, "the fight's and the runner's boxes are not apart: %s / %s" % [str(fb), str(rb)])
	_check(rn._fight["tiles"][0]["key"].text == "On you" and rn._runner["tiles"][0]["key"].text == "Armour" and rn._take_strip["tins"].text != "", "the run's tiles are off")
	# the faces (10 Oct, Run-P A): each in its box at the left, clear of the head, the tiles, the bar and the chips;
	# a face shows art or the drawn figure, never neither
	for pair in ([] if rn._view != null else [[rn._fight_face, fb, rn._fight, "fight"], [rn._runner_face, rb, rn._runner, "runner"]]):     # the run view hides the faces (13 Oct)
		var fr := Rect2(pair[0]["frame"].position, pair[0]["frame"].size)
		var ar := Rect2(pair[0]["art"].position, pair[0]["art"].size)
		_check(pair[1].encloses(fr) and fr.encloses(ar), "the %s's face (%s) is out of its box or its frame (%s)" % [pair[3], str(fr), str(ar)])
		var parts: Array = [pair[2]["head"], pair[2]["track"], pair[2]["key"], pair[2]["chips"]]
		if pair[2].has("note"):
			parts.append(pair[2]["note"])
		for tile in pair[2]["tiles"]:
			parts.append(tile["panel"])
		for piece in parts:
			_check(not fr.intersects(Rect2(piece.position, piece.size)), "the %s's face runs into its %s" % [pair[3], piece.name])
		_check(pair[0]["art"].visible != pair[0]["blank"].visible, "the %s's face shows %s" % [pair[3], "both art and the figure" if pair[0]["art"].visible else "nothing"])
	_check(rn._view != null or rn._runner_face["art"].visible == (People.portrait(sim.cls) != null), "the runner's face does not follow the class's art")
	_check(rn.BOXED_X + 30 >= rn.PAD + rn.FACE + 10, "the fight's numbers can land on the faces")
	_check(rn._face_show(rn._fight_face, ["nobody with a face"]) == "" and rn._fight_face["blank"].visible and not rn._fight_face["art"].visible, "a face with no art does not show the drawn figure")
	main._run._shown = ""
	main.refresh()
	var zi := 0
	for z in range(Data.ZONES.size()):
		if int(m["tier"]) in Data.ZONES[z]["tiers"]:
			zi = z
	var head_out: bool = m.has("boss") and m["boss"]["started"] and m["boss"]["alive"]
	_check(head_out or rn._view != null or rn._fight_face["art"].visible == (People.portrait(rn.gang_face(zi)) != null), "the fight's face does not show the zone's gang where the art is")
	# every zone has its gang's face and every class its own (12 Oct: the new portraits, the Outskirts' gang among them)
	for z in range(Data.ZONES.size()):
		_check(People.portrait(rn.gang_face(z)) != null, "no gang face for %s" % Data.ZONES[z]["name"])
	for cd in Data.CLASSES:
		_check(People.portrait(str(cd["name"])) != null, "no portrait for the %s" % cd["name"])
	_check(not main._run._button2.visible, "the second button shows before the clear on a manual run")
	m["remaining"] = 0
	sim._clear(m, m["t"])
	m["found"] = []                      # room in the pack: a full one leaves on the press, and the check reads a run still on (10 Oct)
	main.refresh()
	_check(main._run._button2.visible and main._run._button2.text == "Fill up, then go", "after the clear the second button reads '%s'" % main._run._button2.text)
	main._run._second_button()
	main.refresh()
	_check(m.get("leave_full", false) and main._run._button2.text.begins_with("Filling up"), "the button did not set the run to fill up then go")
	_check_fit(main, "Run (fill up)")
	# a gang arriving ends it
	m["patrol_timer"] = sim.patrol_s(m["t"], true) + 1.0
	sim.advance(1.0)
	_check(not sim.on_mission() and sim.last_report["outcome"] != "Dead", "fill up then go did not leave as the gang came: %s" % str(sim.last_report.get("outcome", "")))
	# and a full pack ends it
	sim.hp = sim.max_hp()
	sim.deploy(3)
	m = sim.mission
	m["remaining"] = 0
	sim._clear(m, m["t"])
	sim.set_leave_full(true)
	while sim.pack_used(m) < sim.capacity():
		m["found"].append(sim._plain(Data.MEDICAL, "Bandage"))
	sim.advance(0.5)
	_check(not sim.on_mission(), "fill up then go did not leave with the pack full")
	print("fill up, then go ok")


## The bot's pick past the campaign (15 Oct: the depths are the signals'): every site at its campaign self, the one
## that reads PUSH worth the most - its level and its papers - farmed between signals; no climbing; a head left armed
## comes off at the next pick; a weak runner still picks what reads PUSH.
func _dig_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.candidates = []
	sim.auto_equip = false
	for i in range(Data.TIERS.size()):
		sim.best_depth[i] = 1
		sim.depth[i] = 1
	for z in range(Data.ZONES.size()):
		sim.bosses_beaten[z] = true
	sim.xp = Data.xp_for_level(90)
	for s in ["Primary", "Armour", "Helmet"]:
		sim.equipped[s] = sim._plain(s, Data.BASES[s].back()["name"])
	sim.equipped["Primary"]["affixes"] = [{"stat": "damage_pct", "value": 3000.0, "tier": 6}]
	sim.equipped["Secondary"] = null
	sim.wounds = {}
	sim.cash = 100000.0
	sim.rig = [_rmag(sim, sim.ammo_box("smg")["name"])]
	var bot = Bot.new()
	sim.hp = sim.max_hp()
	var budget0: int = sim.odds_budget
	sim.odds_budget = 0                   # the odds in full: the shell reads them a few dry runs a frame, and two reads a moment apart differ
	_check(sim.campaign_done(), "the dig check did not finish the campaign")
	_check(sim.has_rounds(sim.equipped["Primary"]), "the dig check's gun is dry")
	var t: int = bot.pick_tier(sim)
	var better := -1
	for i in range(Data.TIERS.size()):
		if sim.tier_open(i) and bot._aim_level(sim, i) > bot._aim_level(sim, t) and sim.survival(i) >= Bot.PUSH:
			better = i
	_check(sim.survival(t) >= Bot.PUSH and better < 0 and sim.depth[t] == 1, "past the campaign the bot did not farm the site worth most that reads PUSH: T%d at depth %d (odds %.2f), T%d better" % [t, sim.depth[t], sim.survival(t), better])
	bot.last_tier = t
	bot._climb(sim)
	_check(sim.depth[t] == 1, "the bot climbed a campaign site past the campaign: depth %d" % sim.depth[t])
	# a boss left armed on another tier is turned off by the next pick (the twelfth read's T8 at 0%)
	sim.boss_armed[11] = true
	t = bot.pick_tier(sim)
	_check(t == 11 or not sim.boss_armed.get(11, false), "the bot's pick left the Quartermaster armed on T11 (picked T%d)" % t)
	sim.boss_armed.clear()
	# a weak runner still picks what reads PUSH, or the best it can and rests
	sim.equipped["Primary"]["affixes"] = []
	sim.equipped["Armour"] = null
	sim.equipped["Helmet"] = null
	sim.xp = Data.xp_for_level(3)
	sim.hp = sim.max_hp()
	t = bot.pick_tier(sim)
	_check(t >= 0 and sim.depth[t] == 1, "a weak runner past the campaign picked T%d at depth %d" % [t, sim.depth[t]])
	sim.boss_armed.clear()
	sim.odds_budget = budget0
	sim.load_dict(saved)
	print("the dig rule ok")
	_leave_checks(main)


## The bot leaves a picked-over site: a runner no gang moves on (Never
## there) with a pack that won't fill would otherwise stand on the site for
## good - the plain Drifter did, for six hours of the first read.
func _leave_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.candidates = []
	sim.auto_equip = false
	sim.tree = []
	for t in Data.TREES:
		for k in range(t["nodes"].size()):
			if t["nodes"][k].get("effect", "") == "never_there":
				sim.tree.append("%s/%d" % [t["name"], k])
	_check(sim.has_node("never_there"), "the leave check could not train Never there: %s" % sim.tree)
	sim.hp = sim.max_hp()
	sim.deploy(3)
	_check(sim.on_mission(), "the leave check did not deploy")
	var m: Dictionary = sim.mission
	m["remaining"] = 0
	m["cleared"] = true
	m["event_at"] = -1.0
	var bot = Bot.new()
	_check(not bot.should_leave(sim), "the bot leaves a fresh cleared site")
	sim._roll_crates(m, m["t"])
	m["crate_i"] = m["crates"].size()          # picked clean: every crate open (13 Oct)
	_check(sim.crates_done(m), "the leave check's site is not picked clean")
	_check(bot.should_leave(sim), "the bot stays on a picked-over site")
	sim.extract_now()
	sim.load_dict(saved)
	# the next run (28 Oct): a site picked clean is passed over for another that holds - the odds set by the fixture
	# (28 Oct, the tools review: with one holding site the check passed testing nothing), both of pick_tier's branches
	var odds_at := func(i: int, v: float) -> void:
		sim._surv_cache[i] = [sim._odds_key(i), v, 1 << 20, 1 << 20, RandomNumberGenerator.new(), 1.0]
	for campaign in [false, true]:
		sim.load_dict(saved)
		sim.candidates = []
		var last_z: int = Data.ZONES.size() - 1
		for i in range(Data.TIERS.size()):
			sim.best_depth[i] = maxi(1, int(sim.best_depth[i]))
			sim.depth[i] = 1
		for z in range(sim.bosses_beaten.size()):
			sim.bosses_beaten[z] = true
		if not campaign:
			sim.bosses_beaten[last_z] = false
			for i in Data.ZONES[last_z]["tiers"]:
				sim.best_depth[i] = 0
		_check(sim.campaign_done() == campaign, "the fixture: the campaign done reads %s" % str(sim.campaign_done()))
		for i in range(Data.TIERS.size()):
			if sim.tier_open(i):
				odds_at.call(i, 0.0 if (not campaign and int(Data.TIERS[i]["zone"]) == last_z) else 1.0)
		var t1: int = bot.pick_tier(sim)
		var others: Array = []
		for i in range(Data.TIERS.size()):
			if i != t1 and sim.tier_open(i) and sim.best_depth[i] > 0 and sim.survival(i) >= Bot.PUSH:
				others.append(i)
		_check(t1 >= 0 and not others.is_empty(), "the fixture (campaign %s): T%d and no other site holding" % [str(campaign), t1])
		sim.site_crates[str(t1)] = {"left": [], "at": sim.elapsed, "full": 5}
		_check(Bot.picked_clean(sim, t1), "the fixture: T%d isn't picked clean" % t1)
		var t2: int = bot.pick_tier(sim)
		_check(t2 != t1 and others.has(t2), "the bot (campaign %s) went back to T%d picked clean, not one of %s: T%d" % [str(campaign), t1, str(others), t2])
		# every one picked clean: the one that holds anyway, not nothing
		for i in range(Data.TIERS.size()):
			if sim.tier_open(i) and sim.best_depth[i] > 0:
				sim.site_crates[str(i)] = {"left": [], "at": sim.elapsed, "full": 5}
		var t3: int = bot.pick_tier(sim)
		_check(t3 >= 0 and sim.survival(t3) >= Bot.PUSH, "the bot (campaign %s) with every site picked clean took T%d at %.2f" % [str(campaign), t3, sim.survival(t3)])
	sim.load_dict(saved)
	print("the bot leaves a picked-over site ok, and passes one picked clean over")
	_bench_worn_checks(main)


## The bot's Bench (the pass, 20 Oct: needs-led): a dead affix rolled away with the build's padlocked, nothing under
## the two grand it keeps, and a piece with nothing dead and every tier at its cap left alone.
func _bench_worn_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	for sl in Bot.BENCH_SLOTS:
		if sl != "Helmet":
			sim.equipped[sl] = null              # the helmet alone on the Bench (21 Oct, a flake: an affix added to the primary first fired the "dead" element)
	var it: Dictionary = sim._plain("Helmet", "Hard hat")
	var unfired := "frost"
	for el in Data.ELEMENTS:
		if float(sim.conversion().get(el, 0.0)) <= 0.0:
			unfired = el                       # an element the runner fires none of: its increase is dead
	it["affixes"] = [{"stat": "hp", "value": 20.0, "tier": 2}, {"stat": "%s_pct" % unfired, "value": 10.0, "tier": 2}]
	it["rarity"] = Data.RARITIES.size() - 1     # no room to add: the re-roll alone
	sim.equipped["Helmet"] = it
	sim.notes = 0
	var bot = Bot.new()
	var sh: Array = bot._shares(sim, "Helmet")
	_check(str(sh[0][0]) == "hp" and float(sh[0][1]) > bot.DEAD and float(sh[1][1]) < bot.DEAD, "the bot's Bench doesn't read HP as the helmet's and an unfired element as dead: %s" % str(sh))
	sim.cash = 1999.0
	bot._bench_needs(sim)
	_check(bot.bought.is_empty(), "the bot's Bench spent under the two grand it keeps: %s" % str(bot.bought))
	sim.cash = 500000.0
	bot._bench_at = -1e9
	bot._bench_needs(sim)
	var helm: Dictionary = sim.equipped["Helmet"]
	_check(bot.bought.any(func(b): return str(b[1]).contains("helmet's affixes re-rolled")) and helm["affixes"].any(func(a): return str(a["stat"]) == "hp" and is_equal_approx(float(a["value"]), 20.0)), "the bot's Bench did not roll the dead affix away with HP padlocked: %s %s" % [str(bot.bought), str(helm["affixes"])])
	bot.bought = []
	bot._bench_at = -1e9
	helm["affixes"] = [{"stat": "hp", "value": 40.0, "tier": Data.AFFIX_TIERS}, {"stat": "armour", "value": 24.0, "tier": Data.AFFIX_TIERS}]
	bot._bench_needs(sim)
	_check(bot.bought.filter(func(b): return str(b[1]).contains("helmet")).is_empty(), "the bot's Bench re-rolled a helmet with nothing dead and every tier at the top: %s" % str(bot.bought))
	bot.bought = []
	bot._bench_at = -1e9
	sim.cash = 500000.0
	var cash0: float = sim.cash
	bot._bench_needs(sim)
	_check(sim.cash <= cash0, "the bot's Bench paid out")
	# what the figure can't read is kept, never rolled away (the review): loot on the helmet beside HP at the top
	bot.bought = []
	bot._bench_at = -1e9
	helm = sim.equipped["Helmet"]
	helm["affixes"] = [{"stat": "hp", "value": 40.0, "tier": Data.AFFIX_TIERS}, {"stat": "loot_pct", "value": 30.0, "tier": Data.AFFIX_TIERS}]
	bot._bench_needs(sim)
	_check(bot.bought.filter(func(b): return str(b[1]).contains("helmet")).is_empty() and helm["affixes"].any(func(a): return str(a["stat"]) == "loot_pct"), "the bot's Bench rolled a loot line away: %s %s" % [str(bot.bought), str(helm["affixes"])])
	sim.load_dict(saved)
	print("the bot's bench rule ok")
	_bot_crew_checks(main)
	_build_one_checks(main)


## The bot's crew (21 Oct, step 7): stood with nothing to run, it sends out the next class not played at the crew's
## build for it, and the read's own class keeps its build to come back to.
func _bot_crew_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	if sim.cls == "":
		sim.set_class("Doorman")
	var bot = Bot.new()
	bot.cls = sim.cls
	bot.element = "physical"
	sim.signals = []                       # nothing held: no played class can run anything
	sim.roster = {}                        # no other class played: the turn's only choice is a new one
	sim.xp = 0.0
	var cls0: String = sim.cls
	var k0: int = bot._crew_turn(sim)
	_check(k0 == -1 and sim.cls == cls0 and bot.crew_swaps == 0, "the bot sent a new class out from a runner still growing (level %d)" % sim.level())
	sim.xp = Data.xp_for_level(Data.MAX_LEVEL)          # at the cap: a new class next
	bot.lorry_ok = true                    # the last runner's lorry read: gone with the swap (the review)
	var was: String = sim.cls
	var k: int = bot._crew_turn(sim)
	var next: String = ""
	for nm in Bot.CREW_BUILDS:
		if nm != was and sim.class_open(nm):
			next = nm                          # the next that's open: a shut class is passed over, as Training does (25 Oct)
			break
	_check(k == -1 and sim.cls != was and bot.cls == sim.cls and bot.element == str(Bot.CREW_BUILDS[sim.cls]) and bot.crew_swaps == 1 and str(bot.builds.get(was, {}).get("element", "")) == "physical" and not bot.lorry_ok, "the bot's crew turn: %s out (from %s), its build '%s', the first's kept '%s'" % [sim.cls, was, bot.element, str(bot.builds.get(was, {}))])
	_check(sim.cls == next or sim.crew_played().has(next), "the bot's crew turn skipped %s for %s" % [next, sim.cls])
	sim.load_dict(saved)
	print("the bot's crew ok")


## The bot's build rule: the best grade of its primary's rounds the stash can
## make, one a run, while the scrap stays at twice the price.
func _build_one_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.equipped["Primary"] = sim._plain("Primary", "Nail gun")
	sim.stash = []
	sim.stash_put(sim._plain(Data.AMMO, "Nails"))
	var bot = Bot.new()
	var want: Dictionary = sim.build_option("grade", "Hardened bolts")
	_check(not want.is_empty(), "the build check found no Hardened bolts to build")
	sim.scrap = int(want["scrap"]) * 2 - 1
	bot._build_one(sim)
	_check(bot.bought.is_empty(), "the bot built with the scrap under twice the price")
	sim.scrap = int(want["scrap"]) * 2
	bot._build_one(sim)
	_check(bot.bought.size() == 1 and sim.scrap == int(want["scrap"]) and sim.stash.any(func(it): return it["base"] == "Hardened bolts"), "the bot did not build the grade for its rounds: %s, scrap %d" % [str(bot.bought), sim.scrap])
	# the Pitch (two lines a building, 28 Oct): every line it climbs as far as it opens, the bot builds another line's next
	var yard_keep: Dictionary = sim.yard_picks.duplicate(true)
	for yb in Data.YARD:
		var sides: Array = []
		for c in range(yb["picks"].size()):
			sides.append(Bot.BOT_LINE.get(yb["key"], "a") if c < sim.yard_cols() else "")
		sim.yard_picks[yb["key"]] = sides
	sim._yard_dirty = true
	sim.cash = 1.0e9
	var bot_y = Bot.new()
	bot_y._build_yard(sim)
	_check(bot_y.bought.size() == 1 and str(bot_y.bought[0][1]).contains("its other line") and Data.YARD.any(func(yb): return sim.yard_picks[yb["key"]].has("ab")), "the bot didn't build another line's step with its own lines built: %s" % str(bot_y.bought))
	# and not while an open column still wants its first side, too dear for now (the review: the cash hid it)
	var dear_key: String = str(Data.YARD[0]["key"])
	sim.yard_picks[dear_key][0] = ""
	for yb in Data.YARD:
		for c in range(yb["picks"].size()):
			if sim.yard_side(yb["key"], c) == "a":
				sim.yard_picks[yb["key"]][c] = "ab"
	sim.yard_picks[str(Data.YARD[1]["key"])][0] = "a"     # one other side left to buy, cheap
	sim._yard_dirty = true
	sim.cash = float(sim.yard_pick_cost(str(Data.YARD[1]["key"]), 0)) * 2.0
	if sim.cash >= float(sim.yard_pick_cost(dear_key, 0)):
		sim.cash = float(sim.yard_pick_cost(dear_key, 0)) - 1.0
	var bot_y2 = Bot.new()
	bot_y2._build_yard(sim)
	_check(sim.yard_side(dear_key, 0) == "" and sim.yard_side(str(Data.YARD[1]["key"]), 0) == "a", "the bot built a column's other side with a first side still to buy: %s" % str(bot_y2.bought))
	sim.yard_picks = yard_keep
	sim._yard_dirty = true
	sim.load_dict(saved)
	print("the bot's build rule ok")
	_gamble_checks(main)


## The Fence's gamble (Matt, 6 Oct): five kinds on offer, rotated with the restock; pay and get a
## random one of the kind at the top tier opened, never Common; one time in fifty a unique of the kind.
func _gamble_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.candidates = []
	sim.auto_equip = false
	sim.restock()
	_check(sim.gamble.size() == Data.GAMBLE_SHOWN and sim.gamble.all(func(k_in): return not sim.gamble_kind(k_in).is_empty()), "the Fence's offer is not %d kinds: %s" % [Data.GAMBLE_SHOWN, str(sim.gamble)])
	var before: Array = sim.gamble.duplicate()
	var rotated := false
	for k in range(12):
		sim.restock()
		rotated = rotated or sim.gamble != before
	_check(rotated, "twelve restocks never changed the Fence's offer: %s" % str(sim.gamble))
	# the price: runs' pay on the top open tier, never under the floor
	var kind: String = sim.gamble[0]
	var price: int = sim.gamble_price(kind)
	_check(price >= sim._inf(Data.GAMBLE_FLOOR) and absi(price - int(round(maxf(float(sim._inf(Data.GAMBLE_FLOOR)), sim.a_gamble_base() * Data.GAMBLE_RUNS)))) <= 1, "the gamble's price is off: %d (its base %.0f)" % [price, sim.a_gamble_base()])
	# a clear-out at the Fence creeps the price, never lurches it (13 Oct, Matt's save: 305 then 2366): a run home
	# after a sale twenty times the base moves it GAMBLE_STEP, and a few more runs keep climbing
	var gb0: float = sim.a_gamble_base()
	var tk_g0: float = sim.takings
	sim.deploy(0)
	sim._takings_run += gb0 * 20.0
	var run_in: float = sim._takings_run
	sim.mission["cleared"] = true
	sim.extract_now()
	var gb1: float = sim.a_gamble_base()
	_check(gb1 <= gb0 * (1.0 + Data.GAMBLE_STEP) + 1.0 and gb1 > gb0, "one sale moved the gamble's base %.0f to %.0f" % [gb0, gb1])
	# the takings are a run's moving average (20 Oct: "took the sale" failed whenever they already sat above it): the
	# sale and the run's cash go in at a quarter's weight, the first run whole
	var run_total: float = run_in + float(sim.last_report.get("cash", 0.0))
	var tk_want: float = run_total if tk_g0 <= 0.0 else lerpf(tk_g0, run_total, 0.25)
	_check(absf(sim.takings - tk_want) <= 0.5, "the takings didn't take the sale at a quarter's weight (the contracts read them): %.1f, want %.1f from %.1f, the sale %.1f, the run's report %s" % [sim.takings, tk_want, tk_g0, gb0 * 20.0, str(sim.last_report.get("cash", "-"))])
	var loaded = load("res://scripts/sim/sim.gd").new()
	loaded.load_dict(sim.to_dict())
	_check(is_equal_approx(loaded.gamble_base, sim.gamble_base), "the gamble's base did not save")
	# an older save, no base: it starts from that save's takings
	var old_save: Dictionary = sim.to_dict()
	old_save.erase("gamble_base")
	loaded.load_dict(old_save)
	_check(is_equal_approx(loaded.gamble_base, sim.takings), "an old save's gamble base is %.0f, not its takings %.0f" % [loaded.gamble_base, sim.takings])
	# and down: a run home with nothing in moves it GAMBLE_STEP at most
	sim.deploy(0)
	sim._takings_run = 0.0
	sim.mission["cash"] = 0.0
	sim.mission["cleared"] = true
	sim.extract_now()
	_check(sim.a_gamble_base() >= gb1 * (1.0 - Data.GAMBLE_STEP) - 1.0 and sim.a_gamble_base() < gb1, "a quiet run moved the gamble's base %.0f to %.0f" % [gb1, sim.a_gamble_base()])
	kind = sim.gamble[0]                  # the run home restocked the offer
	price = sim.gamble_price(kind)
	_check(sim.gamble_price("no such kind") < 0 and not sim.can_gamble("no such kind"), "a kind not on offer can be gambled")
	# short of cash: refused; paid: a thing of the kind in the stash, never Common, the kind off the offer
	sim.cash = price - 1
	_check(sim.gamble_buy(kind).is_empty(), "a gamble went through short of cash")
	sim.cash = 1000000.0
	sim.stash = []
	var k: Dictionary = sim.gamble_kind(kind)
	var it: Dictionary = sim.gamble_buy(kind, 0.99)
	_check(not it.is_empty() and it["slot"] == k["slot"] and (k["type"] == "" or Items.base_of(it).get("type", "") == k["type"]), "the gamble did not give a %s: %s" % [kind, str(it.get("base", "nothing"))])
	_check(int(it.get("rarity", 0)) >= 1 and not it.has("unique"), "a plain gamble came up Common or unique: %s" % str(it))
	_check(is_equal_approx(sim.cash, 1000000.0 - price) and sim.stash.any(func(s): return s["id"] == it["id"]) and not (kind in sim.gamble), "the gamble did not take the price, land in the stash and leave the offer")
	# the unique, on the dice: a unique of the kind, when the pool has one for it
	sim.restock()
	for kk in sim.gamble:
		var kd: Dictionary = sim.gamble_kind(kk)
		var fits: bool = Data.UNIQUES.any(func(u_in): return not u_in.has("site") and not u_in.get("boss", false) and not u_in.get("mythic", false) and u_in["slot"] == kd["slot"] and (kd["type"] == "" or Items.base_named(kd["slot"], u_in["base"]).get("type", "") == kd["type"]) and Items.unique_fits(u_in, sim.shop_unique_tier()))   # the chase is never the Fence's (part 3); its range takes the deepest tier dug (12 Oct)
		var u: Dictionary = sim.gamble_buy(kk, 0.0)
		_check(not u.is_empty() and (u.has("unique") == fits) and u["slot"] == kd["slot"], "the unique roll on %s gave %s (a unique fits: %s)" % [kk, str(u.get("unique", u.get("base", "nothing"))), str(fits)])
		break
	# a fresh yard can gamble a unique: the offer is up from the first restock and the dice are the dice
	var fresh = Sim.new()
	fresh.start()
	_check(fresh.gamble.size() == Data.GAMBLE_SHOWN, "a fresh yard has no gamble on offer")
	# the bot's rule: a gamble of its primary's kind when flush, none when not
	var bot = Bot.new()
	sim.restock()
	sim.equipped["Primary"] = sim._plain("Primary", "Stalking rifle")
	sim.gamble = ["rifle", "charm", "rig", "pistol", "melee"]
	sim.wounds = {}                    # whole: the bot keeps the Clinic's price back from the gamble when there is one to pay
	sim.hp = sim.max_hp()              # (the wound first: an HP wound lifts the maximum when it goes)
	var lorry_hold: bool = sim.lorry_done
	sim.lorry_done = true              # no Lorry watch saved for: the rule's own reserve is what's read here
	sim.cash = sim.gamble_price("rifle") * 3 - 1
	bot._gamble_one(sim)
	_check(bot.bought.is_empty(), "the bot gambled under three times the price")
	sim.cash = sim.gamble_price("rifle") * 3
	bot._gamble_one(sim)
	_check(bot.bought.size() == 1 and "rifle" in str(bot.bought[0][1]) and not ("rifle" in sim.gamble), "the bot did not gamble a rifle when flush: %s (cash %.0f, price %d, reserve %.0f, can %s, room %s)" % [str(bot.bought), sim.cash, sim.gamble_price("rifle"), bot._reserve(sim), str(sim.can_gamble("rifle")), str(sim.stash_room(4))])
	sim.lorry_done = lorry_hold
	# the takings: a run's cash and the Fence's money, averaged over the last few runs
	var tk0: float = sim.takings
	sim.deploy(3)
	sim.mission["cash"] = 5000.0
	sim.extract_now()
	_check(sim.takings > 0.0 and (tk0 <= 0.0 or absf(sim.takings - lerp(tk0, 5000.0, 0.25)) <= 1.0 or sim.takings >= 5000.0 * 0.25), "a run's cash did not reach the takings: %.0f from %.0f" % [sim.takings, tk0])
	sim.load_dict(saved)
	print("the Fence's gamble ok")
	_start_kit_checks(main)


## The starting kit is the worst kit in the game (Matt, 6 Oct): a pair of its
## own under the pool, never found, so every base in the pool beats the start
## of its slot on its own figures and the first find is somebody's upgrade.
func _start_kit_checks(_main) -> void:
	var fresh = Sim.new()
	fresh.start()
	var start := {"Primary": fresh.equipped["Primary"]["base"], "Armour": fresh.equipped["Armour"]["base"], "Backpack": fresh.equipped["Backpack"]["base"]}
	for slot in start:
		var mine: Dictionary = Items.base_named(slot, start[slot])
		_check(mine.get("start", false), "the starting %s is not flagged as the start: %s" % [slot, start[slot]])
		for b in Data.BASES[slot]:
			if b.get("start", false):
				continue
			var worse := false
			match slot:
				"Primary":
					worse = float(b["damage"]) * float(b["rof"]) <= float(mine["damage"]) * float(mine["rof"])
				"Armour":
					worse = float(b["armour"]) <= float(mine["armour"])
				"Backpack":
					worse = int(b["capacity"]) <= int(mine["capacity"])
			_check(not worse, "%s is no better than the starting %s (%s)" % [b["name"], slot.to_lower(), start[slot]])
	# never found: a thousand rolls a slot at the top tier, none of them the start
	var r := RandomNumberGenerator.new()
	r.seed = 7
	for slot in start:
		var seen := 0
		for k in range(1000):
			if Items.roll(slot, Data.MAX_TIER, r)["base"] == start[slot]:
				seen += 1
		_check(seen == 0, "the starting %s turned up in the loot %d times" % [slot.to_lower(), seen])
	print("the starting kit is the worst kit ok")


## Map juicing (9 Oct, docs/design/juicing.md): no words on campaign sites; papers teach the Radio its words;
## tiers and the words a site holds by depth; pools by zone and depth; the seven crafts and their prices; Twist
## seals; the words' bite and pay and their flags in the run; they stay through a run and a save; the screen.
func _radio_juice_checks(main) -> void:
	var sim = main.sim
	# the band (Bands-U A); the Radio's three columns inside the room (15 Oct: the signals')
	var rdo = main._radio
	_check(rdo.HEAD_H == Pal.BAND_H and rdo.SIGNALS_X + rdo.SIGNALS_W <= Pal.GRID_W and rdo.BODY_Y + rdo.BODY_H <= Pal.ROOM_H, "the Radio's columns run out of the room")
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	# before the depths open: nothing known, nothing worked, nothing crafted
	if not sim.campaign_done():
		sim.words[3] = [{"w": "Numbers", "t": 1}]
		_check(sim.words_known().is_empty() and not sim.juiceable(3) and sim.active_words(3).is_empty() and not ("Numbers" in sim.effective(3)["intel"]) and not sim.can_word_craft(3, "tune"), "a campaign site carries the Radio's words")
		sim.words[3] = []
		main.show_room(main.COMMS)
		_check(main._radio._quiet[0].visible and main._radio._headline.text == "Quiet", "the Radio does not say nothing's on the air in the campaign")
		_check_fit(main, "Radio (the campaign)")
	_finish_campaign(sim)
	sim.atlas = {}
	sim.yard_picks.erase("radio")
	sim.yard_ranks = {}
	sim._yard_changed("")
	for i in range(Data.TIERS.size()):
		sim.words[i] = []
		sim.sealed[i] = false
	sim.book = []
	sim.notes = 100000
	for k in range(Data.TIERS.size()):
		sim.best_depth[k] = 1                  # the zones heard: only the streets', below
	sim.best_depth[3] = 30
	sim.set_depth(3, 1)
	_check(not sim.juiceable(3) and not sim.can_word_craft(3, "broadcast"), "a site at depth 1 takes words")
	# the book: four to start, a zone's three once one of its sites is cleared at depth 2, a paper's when read
	var known: Array = sim.words_known()
	_check(known.size() == 4 + 3 and "Numbers" in known and "Dogs off the lead" in known and not ("Market day" in known) and not ("Bailiffs" in known), "the words known at the depths' opening are off: %s" % str(known))
	var p45: Dictionary = sim._plain(Data.PAPER, "A P45")
	sim._read(p45)
	_check(sim.knows_word("Laid off") and sim.word_taught_by("A P45") == "Laid off" and sim.events.back()[1].contains("Laid off".to_lower()), "reading the P45 did not teach Laid off: %s" % str(sim.events.back()))
	# how many and how strong by depth
	for row in [[2, 2, 1], [5, 3, 1], [8, 3, 2], [9, 4, 2], [15, 4, 3]]:
		sim.set_depth(3, row[0])
		_check(sim.max_words(3) == row[1] and sim.word_tier_cap(row[0]) == row[2], "depth %d holds %d words to tier %d, not %d to %d" % [row[0], sim.max_words(3), sim.word_tier_cap(row[0]), row[1], row[2]])
	# the pools: the site's zone's own, the general, the deep only from their depth; never twice on a site
	sim.set_depth(3, 15)
	sim._read(sim._plain(Data.PAPER, "A ration book"))
	sim._read(sim._plain(Data.PAPER, "A council minute"))
	var seen := {}
	for k in range(120):
		var rw: Array = sim._roll_words(3, [], 4)
		var names: Array = rw.map(func(wd): return wd["w"])
		for n in names:
			seen[n] = true
		var uniq := {}
		for n in names:
			uniq[n] = true
		_check(names.size() == 4 and uniq.size() == 4, "a roll put a word on twice or came up short: %s" % str(names))
		_check(rw.all(func(wd): return int(wd["t"]) >= 1 and int(wd["t"]) <= 3), "a roll's tier is off: %s" % str(rw))
	_check(seen.has("Rationed") and not seen.has("Curfew") and not seen.has("Market day") and not seen.has("Squaddies") and seen.has("Dogs off the lead") and seen.has("Laid off"), "the pools are off at depth 15 on the streets: %s" % str(seen.keys()))
	# the crafts: prices in notes by depth; each does its one thing
	sim.set_depth(3, 9)
	var n0: int = sim.notes
	var cost: int = sim.word_craft_cost(3, "broadcast")
	_check(cost == 27 and not sim.can_word_craft(3, "retune") and not sim.can_word_craft(3, "hold") and sim.word_craft(3, "broadcast") and sim.words[3].size() == 4 and sim.notes == n0 - cost, "Broadcast did not fill the site for 27 notes: %s, %d" % [str(sim.words[3]), n0 - sim.notes])
	_check(not sim.can_word_craft(3, "broadcast") and not sim.can_word_craft(3, "tune") and sim.word_craft_block(3, "tune").begins_with("Full"), "a full site takes another word")
	var held: String = sim.words[3][1]["w"]
	_check(sim.word_craft(3, "hold", held) and sim.words[3].size() == 4 and held in sim.word_names(3), "Hold lost the held word: %s" % str(sim.words[3]))
	_check(sim.word_craft(3, "retune") and sim.words[3].size() == 4, "Retune changed the count")
	_check(sim.word_craft(3, "clear") and sim.words[3].is_empty(), "Clear left words on")
	_check(sim.word_craft(3, "tune") and sim.words[3].size() == 1, "Tune in did not add one")
	var opts: Array = sim.call_options(3)
	_check(not opts.is_empty() and not (sim.words[3][0]["w"] in opts) and not ("Curfew" in opts), "Call in offers what's on the site or too deep: %s" % str(opts))
	_check(sim.word_craft(3, "call", opts[0]) and opts[0] in sim.word_names(3), "Call in did not add the word asked for")
	_check(not sim.word_craft(3, "call", "Curfew"), "Call in took a word deeper than the site")
	# the words in the run: their bite and pay, tiers by depth, held to what the depth allows
	sim.words[3] = []
	var plain: Dictionary = sim.effective(3)
	sim.words[3] = [{"w": "Numbers", "t": 2}]
	var e2: Dictionary = sim.effective(3)
	_check(is_equal_approx(e2["hp"] / plain["hp"], pow(1.4, 1.75)) and is_equal_approx(e2["drop"] / plain["drop"], pow(1.3, 1.75)) and int(e2["word_tiers"]["Numbers"]) == 2, "Numbers at tier II is off: hp ×%.3f" % (e2["hp"] / plain["hp"]))
	sim.set_depth(3, 2)
	_check(sim.word_tier_now(3, 3) == 1 and int(sim.effective(3)["word_tiers"]["Numbers"]) == 1, "a tier II word ran at tier II at depth 2")
	sim.set_depth(3, 9)
	_check(sim.word_words("Numbers", 1) == ["their HP +40%", "finds +30%"], "a word's words are off: %s" % str(sim.word_words("Numbers", 1)))
	# the flags: no meds, no kill cash, a clock, your armour cut, the head walking
	sim.words[3] = [{"w": "Rationed", "t": 1}, {"w": "Overdrawn", "t": 1}]
	sim.set_depth(3, 15)
	sim.rig.append(sim._plain(Data.MEDICAL, "Bandage"))
	sim.hp = sim.max_hp()
	sim.deploy(3)
	var m: Dictionary = sim.mission
	_check(m != null and m["t"].get("no_meds", false) and not sim.use_med(sim.first_med()["id"]), "Rationed let a med be used")
	var cash0: float = float(m["cash"])
	sim._kill(m, m["t"])
	_check(is_equal_approx(float(m["cash"]), cash0), "Overdrawn paid cash for a kill: %.0f" % (float(m["cash"]) - cash0))
	sim.extract_now()
	if sim.on_mission():
		sim._extract()
	_check(sim.word_names(3) == ["Rationed", "Overdrawn"], "a run home spent the site's words: %s" % str(sim.word_names(3)))
	var vest_was = sim.equipped["Armour"]
	sim.equipped["Armour"] = sim._plain("Armour", "Stab vest")
	sim._dry_memo.clear()
	sim.words[3] = [{"w": "Pawned", "t": 1}]
	var t_p: Dictionary = sim.effective(3)
	t_p["types"] = {"physical": 1.0}
	sim.words[3] = []
	var t_0: Dictionary = sim.effective(3)
	t_0["types"] = {"physical": 1.0}
	t_p["dps"] = t_0["dps"]
	_check(sim.armour() > 0.0 and sim.incoming_rate(t_p, 1) > sim.incoming_rate(t_0, 1), "Pawned did not cut your armour: %.2f vs %.2f with %.0f armour" % [sim.incoming_rate(t_p, 1), sim.incoming_rate(t_0, 1), sim.armour()])
	sim.equipped["Armour"] = vest_was
	sim._dry_memo.clear()
	sim._read(sim._plain(Data.PAPER, "The Manager's note"))
	sim.best_depth[6] = 60
	sim.set_depth(6, 50)
	sim.words[6] = [{"w": "The Manager walks", "t": 1}]
	var tw: Dictionary = sim.effective(6)
	var notes_w: int = sim.notes
	sim.hp = sim.max_hp()
	sim.deploy(6)
	_check(tw.has("boss") and str(tw["boss"]["name"]) == str(Data.BOSSES[2]["name"]) and sim.on_mission() and sim.notes == notes_w and sim.mission.has("boss"), "The Manager walks did not bring the Town's head for free: %s, notes %d → %d" % [str(tw.get("boss", {})), notes_w, sim.notes])
	sim.extract_now()
	if sim.on_mission():
		sim._extract()
	sim.words[6] = []
	sim.best_depth[3] = 30
	sim.set_depth(3, 24)
	sim.words[3] = []
	var clock_plain: float = sim.clock_of(3)
	sim.words[3] = [{"w": "Last bus", "t": 1}]
	_check(is_equal_approx(sim.clock_of(3), clock_plain * 0.5), "Last bus did not halve the clock: %.0f of %.0f" % [sim.clock_of(3), clock_plain])
	sim.words[3] = [{"w": "Numbers", "t": 3}, {"w": "Market day", "t": 3}]
	_check(is_equal_approx(sim.clock_of(3), clock_plain), "the Radio's words moved the clock: %.0f of %.0f" % [sim.clock_of(3), clock_plain])
	sim.words[3] = []
	# Twist: one of four, always sealed; a sealed site takes nothing but a dear Clear
	sim.set_depth(3, 15)
	var fours := 0
	var deeps := 0
	for k in range(30):
		sim.sealed[3] = false
		sim.words[3] = [{"w": "Numbers", "t": 1}, {"w": "Ex-army", "t": 1}]
		_check(sim.word_craft(3, "twist") and sim.sealed[3], "Twist did not seal the site")
		fours += 1 if sim.words[3].any(func(wd): return int(wd["t"]) == 4) else 0
		deeps += 1 if sim.words[3].any(func(wd): return Data.word_of(wd["w"])["learn"] == "deep") else 0
	_check(fours > 3 and deeps > 1, "Twist's outcomes are off in thirty: %d tier IV, %d deep" % [fours, deeps])
	_check(not sim.can_word_craft(3, "tune") and not sim.can_word_craft(3, "twist") and sim.word_craft_block(3, "retune").begins_with("Sealed"), "a sealed site took a craft")
	_check(sim.word_craft_cost(3, "clear") == int(ceil(0.5 * 15 * Data.SEALED_CLEAR)) and sim.word_craft(3, "clear") and not sim.sealed[3], "Clear on a sealed site is not ten times, or did not unseal")
	# the words and the book survive a save
	sim.words[3] = [{"w": "Bailiffs", "t": 2}]
	sim.sealed[3] = true
	var rt: Dictionary = sim.to_dict()
	sim.words[3] = []
	sim.sealed[3] = false
	sim.load_dict(rt)
	_check(sim.words[3] == [{"w": "Bailiffs", "t": 2}] and sim.sealed[3] and sim.knows_word("Laid off"), "the Radio's words did not survive a save: %s" % str(sim.words[3]))
	var old: Dictionary = sim.to_dict()
	old.erase("words")
	old["intel"] = [["Numbers"]]
	sim.load_dict(old)
	_check(sim.words.all(func(w): return w.is_empty()), "an old save's words were kept")
	# the screen: a row a site with a ladder, the picked site's words and crafts, the book
	sim.sealed[3] = false
	sim.words[3] = []
	sim.set_depth(3, 9)
	# a site's codes, crafted in the sim (the Radio's screen crafts signals now, 15 Oct; _signal_checks)
	var rd = main._radio
	_check(sim.word_craft(3, "broadcast") and sim.words[3].size() == 4, "a broadcast on a deep site: %s" % str(sim.words[3]))
	main.show_room(main.COMMS)
	main.refresh()
	_check(rd.visible and not rd._quiet[0].visible and rd._papers_box.visible, "the Radio isn't on the air once the campaign's done")
	_check_fit(main, "Radio (on the air)")
	sim.atlas_points = 40
	for k in ["good_reception", "good_reception", "clear_air", "booster", "booster", "booster", "long_wave", "tip_offs", "tip_offs", "strong_signal", "strong_signal", "early_word", "early_word", "held_frequency", "relay"]:
		_rank_to(sim, k)
	_check(sim.atlas_rank("relay") == 1, "the air lane did not open to the Relay")
	main.refresh()
	_check(rd._stand_head.visible and rd._stand[0]["button"].visible and not rd._stand[0]["button"].disabled and not rd._stand[2]["button"].disabled, "the Radio has no standing code or filter slot")
	_check(rd._stand[1]["button"].disabled and rd._stand[1]["top"].text.to_lower().contains("not open yet"), "standing 2 isn't shut before the whole band: '%s'" % rd._stand[1]["top"].text)
	# the code book (21 Oct, the canvas): over the decoder and the signals, None then the known codes, the rest scrambled
	var menu_was: bool = main._menu.visible
	rd._stand[0]["button"].pressed.emit()
	main.refresh()
	_check(rd._book.visible and not rd._decoder_box.visible and not rd._signals_box.visible and main._menu.visible == menu_was, "the code book did not open over the decoder and the signals")
	_check(rd._book_title.text == "The code book · Standing 1" and rd._stand[0]["top"].text.to_lower().contains("picking"), "the book's title or its slot is off: '%s' / '%s'" % [rd._book_title.text, rd._stand[0]["top"].text])
	var bk: Array = rd.book_entries()
	var known_n: int = sim.words_known().size()
	_check(bk[0]["code"] == "" and bk.filter(func(e): return e["known"]).size() == known_n + 1, "the book's cards aren't None and the %d known codes" % known_n)
	_check(rd._book_cards[1]["chips"].visible and rd._book_cards[1]["chips"].shown() >= 1, "a known code's card has no cost or pay")
	var unk: Array = bk.filter(func(e): return not e["known"])
	if not unk.is_empty():
		var uk: int = bk.find(unk[0]) % rd._book_cards.size()
		_check(rd._book_cards[uk]["button"].disabled and rd._book_cards[uk]["name"].text != str(unk[0]["code"]), "a code not learnt shows plain, or can be picked")
	_check(rd._book_left.visible and rd._book_left.shown() >= 1, "the book doesn't say what's still to learn")
	_check_fit(main, "Radio (the code book)")
	var ex: int = -1
	for k in range(rd._book_cards.size()):
		if rd._book_cards[k]["code"] == "Ex-army":
			ex = k
	_check(ex >= 0, "Ex-army isn't on the book's first page")
	if ex >= 0:
		rd._book_cards[ex]["button"].pressed.emit()
	main.refresh()
	_check(sim.standing.size() > 0 and sim.standing[0] == "Ex-army" and not rd._book.visible and rd._decoder_box.visible, "picking a code didn't set it and shut the book: %s" % str(sim.standing))
	rd._stand[2]["button"].pressed.emit()
	main.refresh()
	_check(rd._book.visible and rd._book_title.text.to_lower().ends_with("the filter"), "the filter's book is off: '%s'" % rd._book_title.text)
	rd._book_done.pressed.emit()
	main.refresh()
	_check(not rd._book.visible and rd._signals_box.visible, "Done did not shut the book")
	sim.set_filtered("Numbers")
	main.refresh()
	_check(rd._stand[0]["name"].text == "Ex-army" and rd._stand[2]["name"].text == "Numbers", "the slots don't name their codes: '%s' / '%s'" % [rd._stand[0]["name"].text, rd._stand[2]["name"].text])
	_check_fit(main, "Radio (the book, the standing word)")
	# the Runs card: a word's tier as its chip's tag
	main.show_room(main.MISSIONS)
	main._missions._pick_zone(1)
	main._missions._shown = ""
	main.refresh()
	var c: Dictionary = main._missions._cols[0]
	_check(c["card"].foot.text != "" and not c["card"].foot.text.contains("from the Radio"), "the Runs card's conditions are off (the sky only since 18 Oct; the codes are on signals): '%s'" % c["card"].foot.text)
	_check_fit(main, "Runs (juiced)")
	sim.load_dict(saved)
	main.refresh()
	print("map juicing ok: campaign sites plain, the book, depth's words and tiers, the pools, seven crafts, Twist, the flags, the save, the screen")


## Run timers (9 Oct, docs/design/timers.md): a site's clock, the same for every build; it runs only while a gang
## is on you; a head brings his own time; out of time the runner lives, the pack and two pieces of kit don't
## (the insurance pays for the kit); the dry runs read it; the run screen and the Runs card show it.
## Matt's notes of 10 Oct: a node's sentence under its title and never "wants N points" (the tree and the button say
## the cost); the Workshop's heading says Workshop; the top bar's XP is this runner's after a move.
func _panel_words_checks(main) -> void:
	var sim = main.sim
	var hold_pts: int = sim.training_points
	var hold_rw: Dictionary = sim.rewards_earned.duplicate(true)
	sim.rewards_earned = {}                   # the camp's reward points aside (BUILD50-T: the bot's camp earned one)
	main.show_room(main.BARRACKS)
	var bk = main._barracks
	# the card (3 Nov, the skill web): a node's words under its name and its place, over the button; the points are the
	# button's to say, never the words'
	var pick := ""
	for id in sim.web_frontier(true):
		if pick == "" and not sim.web_owned(str(id)):
			pick = str(id)
	sim.training_points = sim.web_spent()           # none free: the button says so
	bk.selected = pick
	bk._shown = ""
	main.refresh()
	if pick != "":
		_check(not bk._words.text.to_lower().contains("point") and bk._train.text == Words.WEB_BLOCK["points"], "a node's words say the points, or the button doesn't: '%s' / '%s'" % [bk._words.text, bk._train.text])
		_check(bk._words.position.y >= bk._where.position.y + bk._where.size.y and bk._words3.position.y + bk._words3.size.y <= bk._train.position.y and bk._where.position.y >= bk._title.position.y + bk._title.size.y - 2.0, "a node's words are not under its name and place, over the button")
		_check(bk._train.disabled, "Take it is not off with no point free")
		bk._shown = ""
		main.refresh()
		_check_fit(main, "Training (a node, no point free)")
	sim.training_points = hold_pts
	sim.rewards_earned = hold_rw
	bk.selected = ""
	bk._shown = ""
	main.show_room(main.WORKSHOP)
	main.refresh()
	_check(main._workshop._kicker.text == "Workshop", "the Workshop's heading says '%s'" % main._workshop._kicker.text)
	main.show_room(main.OVERVIEW)
	main.refresh()
	print("the panel's words ok: under the title, no points; the Workshop's heading; the top bar's XP after a move")


## The rooms' bands (10 Oct, Rooms-B): Training, the Workshop, the Radio and the Yard under their painted places once
## painted (Stats has its band); the art under the words, covering the heading, shaded from the left, the words with a
## shadow; nothing while the file is missing.
func _room_band_checks(main) -> void:
	var rooms := [[main.BARRACKS, main._barracks, "the_caravan"], [main.WORKSHOP, main._workshop, "the_workshop"], [main.COMMS, main._radio, "the_radio"], [main.OVERVIEW, main._yard_tree, "the_yard"]]
	var stand_in: Texture2D = UI.place_texture("Ransacked Streets")
	for r in rooms:
		var hb: Dictionary = r[1].head_band
		var art: TextureRect = hb["art"]
		var head: Panel = art.get_parent()
		var file := "res://art/places/%s.png" % r[2]
		var painted: bool = ResourceLoader.exists(file) or FileAccess.file_exists(file)
		_check(Items.slug(hb["place"]) == r[2], "%s's band names %s, not %s" % [r[2], Items.slug(hb["place"]), r[2]])
		_check(art.visible == painted and hb["shade"].visible == painted, "%s's band does not follow its art (painted %s)" % [r[2], str(painted)])
		_check(art.get_index() == 0 and hb["shade"].get_index() == 1 and head.clip_contents and art.size == head.size - Vector2(2, 2) and art.position == Vector2(1, 1) and art.mouse_filter == Control.MOUSE_FILTER_IGNORE, "%s's band is not under the heading's words, or not inside its line" % r[2])
		if stand_in != null and not painted:
			UI.set_head_art(hb, stand_in)
			var unshadowed := 0
			for c in head.get_children():
				if c is Label and c.get_theme_color("font_shadow_color").a < 0.5:
					unshadowed += 1
			_check(art.visible and hb["shade"].visible and unshadowed == 0, "%s's band, painted, leaves %d words without a shadow" % [r[2], unshadowed])
			var sc: float = maxf(art.size.x / stand_in.get_width(), art.size.y / stand_in.get_height())
			_check((art.texture_filter == CanvasItem.TEXTURE_FILTER_NEAREST) == is_equal_approx(sc, roundf(sc)), "%s's band filters a %.2fx scale the wrong way" % [r[2], sc])
			main.show_room(r[0])
			main.refresh()
			_check_fit(main, "%s (a stand-in band)" % r[2])
			UI.set_head_art(hb, null)
			for c in head.get_children():
				if c is Label:
					_check(c.get_theme_color("font_shadow_color").a < 0.01, "%s's words kept a shadow on the plain card" % r[2])
	main.show_room(main.OVERVIEW)
	main.refresh()
	print("the rooms' bands ok: four headings under their places, the words over them")


## The Runner room's backdrop (10 Oct, Kit-B): under the figure and the slots, the frame round them; the painted
## lock-up at 40% with the slots as glass where the art is, the drawn light where it isn't.
func _backdrop_checks(main) -> void:
	var sim = main.sim
	main.show_room(main.ARMOURY)
	main.refresh()
	var body = main._armoury._body
	_check(body.get_child(0) == body.backdrop and body.backdrop.size == body.size and body.backdrop.mouse_filter == Control.MOUSE_FILTER_IGNORE, "the backdrop is not under the figure and the slots, or takes the mouse")
	# the kit room's art back under the loadout (Matt, 10 Oct: "add the art we have for that screen back in"): painted
	# when the file is there, the drawn light while it isn't
	var kit_file := "res://art/places/the_kit_room.png"
	var kit_painted: bool = ResourceLoader.exists(kit_file) or FileAccess.file_exists(kit_file)
	_check(body.has_backdrop_art() == kit_painted and body._backdrop_art.get_parent() == body.backdrop and body._vignette.visible == kit_painted, "the kit room's art does not follow its file (painted %s)" % str(kit_painted))
	_check(body.get_child(1) == body._frame and body._frame.mouse_filter == Control.MOUSE_FILTER_IGNORE and body._flat.get_index() > body._frame.get_index(), "the backdrop's frame or the flat figure's layer is out of order, or takes the mouse")
	for slot in Data.SLOTS:
		var b: Dictionary = body._boxes[slot]
		_check(b["zone"].get_index() > body._flat.get_index(), "the %s slot is under the backdrop's layers" % slot)
		var sb: StyleBoxFlat = b["outline"].get_theme_stylebox("panel")
		var filled: bool = sim.equipped[slot] != null
		# the card is glass whether full or not (Runner-R A: it carries the words); the picture's cell is glass too
		_check(is_equal_approx(sb.bg_color.a, body.GLASS_ALPHA), "the %s card is not glass: %.2f (%s)" % [slot, sb.bg_color.a, "filled" if filled else "empty"])
		# the loadout (Runner-R A): the slot named always; a full card names its item and its figure; Matt's order -
		# the weapons and the charm down the left, the helmet over the armour, the rig and the pack down the right
		_check(b["name"].text == body.slot_name(slot).to_upper() and b["name"].visible, "the %s card does not name its slot" % slot)
		if filled:
			# the picture big enough to read: a long gun across the card, the rest at its left
			var cz: Vector2 = b["cell"].size
			var fp: Vector2i = Items.footprint(sim.equipped[slot])
			var shown_h: float = minf(cz.y, cz.x * float(fp.y) / float(fp.x))
			_check(shown_h >= 36.0, "the %s card's picture is a sliver: %.0f px tall in %s" % [slot, shown_h, str(cz)])
			# the art fills the card (Runner-R B's way, Matt 10 Oct): the name is the art's and the tooltip's, the figure over it
			var fig_ok: bool = (b["fig"].text in sim.kit_mag_line(sim.equipped[slot])) if slot in ["Primary", "Secondary"] else b["fig"].text == ""     # a gun's magazines and rounds (30 Oct)
			_check(b["cell"].tooltip_text.begins_with(Items.full_name(sim.equipped[slot])) and fig_ok and b["cell"].size.x >= body.box_rect(slot).size.x - 8 and b["cell"].size.y >= body.box_rect(slot).size.y - body.TOP_STRIP - body.FOOT_STRIP - 2 and not Rect2(b["cell"].position, b["cell"].size).intersects(Rect2(b["name"].position, Vector2(b["name"].size.x, 18))), "the %s card's art or words are off: '%s' / '%s' %s" % [slot, b["cell"].tooltip_text, b["fig"].text, str(b["cell"].size)])
		var cr: Rect2 = body.box_rect(slot)
		_check((cr.position.x < body.FIGURE_X) == (slot in ["Backpack", "Primary", "Secondary"]), "the %s card is on the wrong side" % slot)
		_check(not cr.intersects(Rect2(body.FIGURE_X - body.FIGURE_W / 2.0, body.FIGURE_Y, body.FIGURE_W, body.FIGURE_H)), "the %s card sits on the figure" % slot)
		_check(b["cell"].glass, "the %s slot's cell is not glass" % slot)
		_check(Rect2(Vector2.ZERO, body.size).encloses(Rect2(b["zone"].position, b["zone"].size)), "the %s slot leaves the backdrop's frame" % slot)
	_check_fit(main, "Runner (the backdrop)")
	# Matt's order (10 Oct): the pack big over the primary and the secondary down the left; the helmet, the armour, the
	# rig and the charm down the right; no worn card; the charm smaller than the armour; each column filling the loadout
	var by := func(sl): return body.box_rect(sl).position.y
	_check(by.call("Backpack") < by.call("Primary") and by.call("Primary") < by.call("Secondary") and by.call("Helmet") < by.call("Armour") and by.call("Armour") < by.call("Rig") and by.call("Rig") < by.call("Charm"), "the loadout's order is not Matt's")
	_check(not body.has_method("worn_rect") and body.box_rect("Charm").size.y < body.box_rect("Armour").size.y and body.box_rect("Backpack").size.y >= body.box_rect("Primary").size.y, "the worn card is back, or the charm, armour or pack sized wrong")
	for col in [body.LEFT, body.RIGHT]:
		_check(absf(body.box_rect(col.back()).end.y - (body.HEIGHT - body.PAD)) < 0.5, "the %s column does not fill the loadout" % col.back())
	# the figure fills the gap between the columns (Matt, 10 Oct: his redraw looked too small), every past's the same
	# height (Matt, 12 Oct: "even them out"): the widest binds on the gap's width or height, none overruns it
	var fd: Vector2 = body.figure_drawn()
	_check(fd == Vector2.ZERO or (fd.x <= body.FIGURE_W + 0.5 and fd.y <= body.FIGURE_H + 0.5), "the figure is drawn %s in a %d × %d gap" % [str(fd), body.FIGURE_W, body.FIGURE_H])
	# a figure a class (Matt, 10 Oct): the runner's past's own drawing when there is one, art/body.png when not; it
	# follows a change of past
	var talls := []
	var widest := 0.0
	var cls_hold: String = sim.cls
	for cd in Data.CLASSES:
		sim.cls = cd["name"]
		body.show_state(sim)
		var own: String = body.BODY_CLASS_ART % str(cd["name"]).to_lower()
		var new_own: String = body.BODY_NEW_ART % str(cd["name"]).to_lower()     # the manifest's figure first where there is one (23 Oct, Matt: "swap")
		var has_new: bool = ResourceLoader.exists(new_own) or FileAccess.file_exists(new_own)
		var has_own: bool = ResourceLoader.exists(own) or FileAccess.file_exists(own)
		_check(body.figure_path == (new_own if has_new else (own if has_own else body.figure_for(""))), "%s shows %s, not its own figure" % [cd["name"], body.figure_path])
		var fd2: Vector2 = body.figure_drawn()
		_check(body.figure_path == "" or (fd2.x <= body.FIGURE_W + 0.5 and fd2.y <= body.FIGURE_H + 0.5), "%s's figure is drawn %s, past the %d × %d gap" % [cd["name"], str(fd2), body.FIGURE_W, body.FIGURE_H])
		if body.figure_path != "":
			talls.append(fd2.y)
			widest = maxf(widest, fd2.x)
	_check(talls.is_empty() or (talls.max() - talls.min() < 1.0 and (widest >= body.FIGURE_W - 1.0 or talls.max() >= body.FIGURE_H - 1.0)), "the pasts' figures are not one height filling the gap: %s tall, the widest %.0f" % [str(talls), widest])
	sim.cls = cls_hold
	body.show_state(sim)
	# the strip over it: who, HP, damage, armour, inside the strip and above the loadout
	var arm = main._armoury
	_check(arm._hp.text.contains("HP") and arm._dps.text.contains("dmg/s") and arm._who.text.to_lower().contains("level") and arm.BODY_Y >= arm.STRIP_H and arm.CONTAINERS_Y + arm._containers.size.y <= Pal.ROOM_H, "the runner strip or the column's stack is off: '%s' '%s' '%s'" % [arm._who.text, arm._hp.text, arm._dps.text])
	print("the loadout ok: the strip, the cards in Matt's order, the kit room under it, glass cards")


## The purse on the top bar (10 Oct, Bar-C): notes and scrap through the campaign, each salvage kind joining once
## there's any; the worst figures out on a run still clear of the runner's figures (the fit's purse check).
func _purse_checks(main) -> void:
	var sim = main.sim
	var hold: Array = [sim.salvage.duplicate(), sim.scrap, sim.notes]
	sim.salvage = {"copper": 0, "steel": 0, "army": 0}
	main.refresh()
	_check(main._top_labels["scrap"].visible and main._top_labels["scrap"].text == Fmt.num(sim.scrap) and not main._top_labels["copper"].visible and not main._top_glyphs["army"].visible, "the campaign's purse is not notes and scrap")
	_check_fit(main, "Top bar (the campaign's purse)")
	# a painted art/ui/<k>.png where there is one (the purse manifest), else the engine's line glyph
	for k in ["scrap", "copper", "steel", "army"]:
		var painted: Texture2D = UI.glyph_texture(k)
		_check(main._top_glyphs[k].texture == (painted if painted != null else NodeGlyphs.texture(k)), "the top bar's %s glyph is not its art or its line" % k)
	sim.salvage = {"copper": 0, "steel": 7, "army": 0}
	main.refresh()
	_check(main._top_labels["steel"].visible and main._top_labels["steel"].text == "7" and not main._top_labels["copper"].visible, "safe steel did not join the purse alone")
	sim.salvage = {"copper": 9999, "steel": 9999, "army": 9999}
	sim.scrap = 99999
	sim.notes = 999999
	sim.hp = sim.max_hp()
	sim.deploy(3)
	main.refresh()
	_check(main._top_glyphs["where"].tooltip_text.begins_with("Out: ") and main._top_glyphs["where"].mouse_filter != Control.MOUSE_FILTER_IGNORE, "the place's glyph does not keep its words where a hover finds them: '%s'" % main._top_glyphs["where"].tooltip_text)
	# each purse label's box is its figure: a tooltip never lies over its neighbour
	for k in ["notes", "scrap", "copper", "steel", "army", "cash"]:
		var pl: Label = main._top_labels[k]
		if pl.visible:
			_check(pl.size.x <= UI.text_width(pl, pl.text) + 4.0, "the top bar's %s box runs past its figure: %.0f for %.0f" % [k, pl.size.x, UI.text_width(pl, pl.text)])
	_check_fit(main, "Top bar (every currency, out on a run)")
	# the cog (14 Oct): at the bar's end, clear of the purse at its widest, the pause and back
	var cog: Button = main._cog_btn
	_check(cog.visible and cog.position.x + cog.size.x <= 1920.0 - 2 * Pal.MARGIN + 0.5, "the cog isn't at the top bar's end")
	for k in main.TOP_RIGHT:
		for n in [main._top_glyphs[k], main._top_labels[k]]:
			if n.visible:
				_check(n.position.x + n.size.x <= cog.position.x - 8.0, "the top bar's %s runs into the cog (%.0f > %.0f)" % [k, n.position.x + n.size.x, cog.position.x - 8.0])
	cog.pressed.emit()
	_check(main._menu.visible and main._menu._title.text == "Paused", "the cog didn't open the pause")
	cog.pressed.emit()
	_check(not main._menu.visible, "the cog didn't shut the pause again")
	sim.extract_now()
	sim.salvage = hold[0]
	sim.scrap = hold[1]
	sim.notes = hold[2]
	main.refresh()
	print("the purse ok: notes and scrap, the salvage as it's found, clear of the figures at the worst")


## The way out (10 Oct, docs/design/way_out.md, Run-P B): Get out now before the clear is a last gang at the door and
## so long to see them off - seen off, home with the pack; out of time, a time-out; after the clear, free as before.
func _way_out_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var autos: Array = [sim.auto_equip, sim.junk_upto]
	sim.auto_equip = false
	sim.junk_upto = -1                          # the pack's find is read in the stash as it came home
	_check(sim.way_out_s(sim.effective(11)) > sim.way_out_s(sim.effective(3)) and is_equal_approx(sim.way_out_s(sim.effective(3)), Data.WAY_OUT_S), "the way out does not grow with the tier: %.0f / %.0f" % [sim.way_out_s(sim.effective(3)), sim.way_out_s(sim.effective(11))])
	sim.hp = sim.max_hp()
	sim.deploy(3)
	var m: Dictionary = sim.mission
	m["target_hp"] = 1e12
	sim.hp = 1e9
	main.show_room(main.MISSIONS)
	main.refresh()
	var rs = main._run
	_check(rs._button.text.begins_with("Get out · ") and rs._button.text.ends_with("and one last gang"), "before the clear Get out now does not say its price: '%s'" % rs._button.text)
	_check_fit(main, "Run (the way out's price)")
	var found: Dictionary = sim._plain("Helmet", "Hard hat")
	m["found"].append(found)
	var pool: int = int(m["remaining"])
	rs._get_out()
	_check(sim.on_mission() and m.get("way_out", false) and int(m["remaining"]) == sim.door_gang(m["t"]) and int(m["left_behind"]) == pool, "Get out now before the clear did not start the way out: %s / %d at the door" % [str(m.get("way_out", false)), int(m["remaining"])])
	_check(is_equal_approx(float(m["way_out_t"]), minf(sim.way_out_s(m["t"]), float(m["clock"]))), "the way out's time is off: %.1f" % float(m["way_out_t"]))
	main.refresh()
	_check(rs._band.kicker.text == "The way out" and rs._band.headline.text == Fmt.mss(ceilf(float(m["way_out_t"]))) and rs._fight["head"].text == "THE FIGHT · THE WAY OUT" and rs._button.text.begins_with("Getting out"),
		"the run screen does not show the way out: '%s' / '%s' / '%s' / '%s'" % [rs._band.kicker.text, rs._band.headline.text, rs._fight["head"].text, rs._button.text])
	_check(rs._band._bar_label.text.ends_with("seen off at the door"), "the way out's bar does not count the door: '%s'" % rs._band._bar_label.text)
	_check_fit(main, "Run (the way out)")
	rs._get_out()
	_check(sim.on_mission() and m.get("way_out", false), "a second press left the way out")
	var w0: float = float(m["way_out_t"])
	sim.advance(1.0)
	_check(sim.on_mission() and is_equal_approx(float(m["way_out_t"]), w0 - 1.0), "the way out's time did not run: %.1f from %.1f" % [float(m["way_out_t"]), w0])
	# seen off: home with the pack
	m["remaining"] = 1
	m["target_hp"] = 0.01
	for w in range(6):                         # past a melee wait or an underlay's grace
		if sim.on_mission():
			sim.advance(1.0)
	_check(not sim.on_mission() and sim.last_report.get("way_out", false) and not sim.last_report.get("timed_out", false) and sim.stash.has(found), "seeing them off did not bring the pack home: %s" % str(sim.last_report.get("outcome", "")))
	# out of time at the door: a time-out
	sim.hp = sim.max_hp()
	sim.deploy(3)
	m = sim.mission
	m["target_hp"] = 1e12
	sim.hp = 1e9
	sim.get_out()
	m["target_hp"] = 1e12
	m["way_out_t"] = 0.5
	sim.advance(1.0)
	_check(not sim.on_mission() and sim.last_report.get("timed_out", false) and sim.last_report.get("outcome", "") == "Out of time", "out of time at the door was not a time-out: %s" % str(sim.last_report.get("outcome", "")))
	# never longer than the run's clock has left
	sim.hp = sim.max_hp()
	sim.deploy(3)
	m = sim.mission
	m["clock"] = 6.0
	sim.get_out()
	_check(float(m["way_out_t"]) <= 6.0, "the way out ran past the run's clock: %.1f" % float(m["way_out_t"]))
	sim.extract_now()
	# after the clear: free and at once
	sim.hp = sim.max_hp()
	sim.deploy(3)
	m = sim.mission
	m["remaining"] = 0
	sim._clear(m, m["t"])
	sim.get_out()
	_check(not sim.on_mission() and not sim.last_report.get("way_out", false), "after the clear Get out now was not free and at once")
	# a Ghost's run is cleared from the start, but its first gang on you is no clear: the way out (the review, 10 Oct)
	sim.hp = sim.max_hp()
	sim.deploy(3)
	m = sim.mission
	m["cleared"] = true
	m["ghost_pending"] = true
	m["remaining"] = 3
	m["target_hp"] = 1e12
	sim.get_out()
	_check(sim.on_mission() and m.get("way_out", false), "a Ghost's run left for free with its first gang on")
	sim.extract_now()
	# a head who has come out is left behind; the door's gang down is out, never the head coming back
	sim.hp = 1e9
	sim.deploy(3)
	m = sim.mission
	m["boss"] = sim._boss_entry({"name": "The Carpet Man", "hp": 1e9, "dps": 1.0, "zone": 0})
	m["boss"]["started"] = true
	m["remaining"] = 1
	m["target_hp"] = 1e9
	sim.get_out()
	_check(not m["boss"]["started"], "the head kept fighting through the way out")
	m["remaining"] = 1
	m["target_hp"] = 0.01
	for w in range(6):                         # past a melee wait or an underlay's grace
		if sim.on_mission():
			sim.advance(1.0)
	_check(not sim.on_mission() and sim.last_report.get("way_out", false), "the door's gang down did not end the run with a head left behind")
	# saved and loaded mid way out, it carries on
	sim.hp = 1e9
	sim.deploy(3)
	m = sim.mission
	m["target_hp"] = 1e12
	sim.get_out()
	var mid: Dictionary = sim.to_dict()
	sim.load_dict(JSON.parse_string(JSON.stringify(mid)))
	m = sim.mission
	_check(sim.on_mission() and m.get("way_out", false) and float(m["way_out_t"]) > 0.0, "a load mid way out lost it")
	m["remaining"] = 1
	m["target_hp"] = 0.01
	sim.hp = 1e9
	for w in range(6):
		if sim.on_mission():
			sim.advance(1.0)
	_check(not sim.on_mission() and sim.last_report.get("way_out", false), "a loaded way out did not end when seen off")
	# the price follows the run's clock as it falls under the way out's time
	sim.hp = 1e9
	sim.deploy(8 if sim.tier_open(11) else 0)
	m = sim.mission
	m["target_hp"] = 1e12
	main.refresh()
	m["clock"] = 7.0
	main.refresh()
	_check(rs._button.text.contains(Fmt.mss(7.0)), "the price did not follow the run's clock: '%s'" % rs._button.text)
	sim.extract_now()
	sim.load_dict(saved)
	sim.auto_equip = autos[0]
	sim.junk_upto = autos[1]
	main.refresh()
	print("the way out ok: the price, the door's gang, the time, seen off, out of time, the clock's cap, free after the clear")


func _clock_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var t0: Dictionary = sim.effective(3)
	_check(is_equal_approx(sim.clock_of(3), (Data.CLOCK_BASE + Data.CLOCK_PER_HEAD * (int(t0["plain_pool"]) + Data.CLOCK_GANGS)) * float(t0.get("clock_mult", 1.0))), "the streets' clock is off: %.0f" % sim.clock_of(3))     # the level's tax on the fight keeps the clock's pace (21 Oct)
	_check(is_equal_approx(sim.clock_for_head(t0, float(t0["plain_hp"]) * 10.0), Data.CLOCK_PER_HEAD * 10.0), "a head ten heads strong does not bring ten heads' time")
	# it runs while they're on you, and stands while the site's clear
	sim.hp = sim.max_hp()
	sim.deploy(3)
	var m: Dictionary = sim.mission
	_check(m != null and is_equal_approx(float(m["clock"]), sim.clock_budget(m["t"])) and is_equal_approx(float(m["clock_max"]), float(m["clock"])), "the run did not start on the site's clock")
	m["target_hp"] = 1e12
	sim.hp = 1e9
	var c0: float = float(m["clock"])
	sim.advance(2.0)
	_check(sim.on_mission() and is_equal_approx(float(m["clock"]), c0 - 2.0), "the clock did not run in the fight: %.1f from %.1f" % [float(m["clock"]), c0])
	main.show_room(main.MISSIONS)
	main.refresh()
	var rs = main._run
	_check(rs._band.headline.text == Fmt.mss(ceilf(float(m["clock"]))) and rs._band.unit.text.begins_with("left"), "the run's headline is not the clock: '%s' / '%s'" % [rs._band.headline.text, rs._band.unit.text])
	_check_fit(main, "Run (the clock)")
	m["remaining"] = 0
	m["cleared"] = true
	m["patrol_timer"] = -1e9                     # no gang for a while
	var c1: float = float(m["clock"])
	sim.advance(3.0)
	_check(sim.on_mission() and absf(float(m["clock"]) - (c1 - 3.0 * Data.CLOCK_SEARCH_RATE)) < 0.05, "the clock did not run at %.1f through the search: %.1f from %.1f" % [Data.CLOCK_SEARCH_RATE, float(m["clock"]), c1])
	# run out in a search: the run times out as it would in a fight
	m["clock"] = 0.5
	sim.advance(3.0)
	_check(not sim.on_mission() and sim.last_report.get("timed_out", false), "the clock running out in a search did not end the run")
	sim.hp = sim.max_hp()
	sim.deploy(3)
	m = sim.mission
	m["target_hp"] = 1e12
	sim.hp = 1e9
	m["remaining"] = 0
	m["cleared"] = true
	m["patrol_timer"] = -1e9
	main.refresh()
	_check(rs._band.unit.text.contains("stopped") or rs._band.unit.text == "left", "the run's clock does not say it's stopped: '%s'" % rs._band.unit.text)
	# out of time: the runner home, the pack lost, two pieces of kit with it
	m["remaining"] = 5
	m["cleared"] = false
	m["target_hp"] = 1e12
	var junk: Dictionary = sim._plain("Helmet", "Hard hat")
	m["found"].append(junk)
	for s in ["Helmet", "Armour", "Secondary"]:
		if sim.equipped[s] == null:
			sim.equipped[s] = sim._plain(s, Data.BASES[s][0]["name"])
	var worn0: int = 0
	var ids0 := {}
	for s in Data.SLOTS:
		worn0 += 1 if sim.equipped[s] != null else 0
		ids0[s] = sim.equipped[s]["id"] if sim.equipped[s] != null else -1
	var lost0: int = sim.operators_lost
	var auto_eq0 = sim.auto_equip
	sim.auto_equip = false                       # the slot check reads the kit as the clock left it
	m["clock"] = 0.5
	sim.advance(1.0)
	var worn1: int = 0
	for s in Data.SLOTS:
		worn1 += 1 if sim.equipped[s] != null else 0
	_check(not sim.on_mission() and sim.last_report.get("outcome", "") == "Out of time" and sim.operators_lost == lost0 and sim.hp > 0.0, "running out of time did not end the run with the runner home: %s" % str(sim.last_report.get("outcome", "")))
	var fresh := 0
	for s in Data.SLOTS:
		if sim.equipped[s] != null and sim.equipped[s]["base"] in [sim.START_WEAPON, "Work jacket", "Plastic bag", "Bum bag"] and int(sim.equipped[s]["rarity"]) == 0:
			fresh += 1
	_check(worn0 - worn1 + fresh >= Data.CLOCK_LOSE_KIT and worn1 >= worn0 - Data.CLOCK_LOSE_KIT and (not sim.stash.has(junk) or sim.yard_has("fetch")), "out of time lost %d pieces of kit (%d hand-me-downs in), or the pack came home" % [worn0 - worn1, fresh])
	_check(sim.equipped["Primary"] != null, "out of time left the runner with no gun")
	var changed := 0
	for s in Data.SLOTS:
		var id1: int = sim.equipped[s]["id"] if sim.equipped[s] != null else -1
		changed += 1 if id1 != ids0[s] else 0
	_check(changed == Data.CLOCK_LOSE_KIT, "out of time changed %d slots, not %d" % [changed, Data.CLOCK_LOSE_KIT])
	sim.auto_equip = auto_eq0
	_check(sim.events.slice(-8).any(func(ev): return str(ev[1]).begins_with("Out of time")), "out of time has no line")
	_check(sim.events.slice(-8).any(func(ev): return str(ev[1]) in Words.TIME_OUT_LOOSE), "out of time doesn't say where the kit went")     # 16 Oct
	# insured, the kit comes back to the stash
	for s in ["Helmet", "Armour", "Secondary"]:
		if sim.equipped[s] == null:
			sim.equipped[s] = sim._plain(s, Data.BASES[s][0]["name"])
	sim.cash += 1e6
	sim.hp = sim.max_hp()
	if sim.can_insure(3):
		sim.set_insure(true)
	sim.deploy(3)
	m = sim.mission
	_check(m != null and m.get("insured", false), "the insured time-out test could not insure its run")
	if m != null and m.get("insured", false):
		var stash0: int = sim.stash.size()
		m["clock"] = 0.5
		m["target_hp"] = 1e12
		sim.hp = 1e9
		sim.advance(1.0)
		_check(not sim.on_mission() and sim.stash.size() >= stash0 + Data.CLOCK_LOSE_KIT, "the insurance did not pay for the kit lost to the clock: %d → %d" % [stash0, sim.stash.size()])
	elif m != null:
		sim.extract_now()
	# the dry runs read the clock: out of time is a run lost
	var dm := {"dry": true}
	sim._time_out(dm)
	_check(dm.get("dead", false) and dm.get("timed_out", false), "a dry run out of time did not read as lost")
	# and a real dry run: fists against the streets, the runner unkillable, loses to the clock
	var gun0 = sim.equipped["Primary"]
	var sec0 = sim.equipped["Secondary"]
	var hat0 = sim.equipped["Helmet"]
	var hp0: float = sim.hp
	sim.equipped["Primary"] = null
	sim.equipped["Secondary"] = null      # fists means fists: a good secondary took the streets in time (10 Oct)
	var hat: Dictionary = sim._plain("Helmet", Data.BASES["Helmet"][0]["name"])
	hat["affixes"].append({"stat": "hp", "value": 1e7})          # a runner who can't go down: only the clock beats him
	sim.equipped["Helmet"] = hat
	sim.hp = sim.max_hp()
	var to0: int = int(sim.prof.get("dry_timeouts", 0))
	var rr := RandomNumberGenerator.new()
	rr.seed = 7
	var won: bool = sim._dry_run(3, rr)
	_check(not won and int(sim.prof.get("dry_timeouts", 0)) == to0 + 1, "fists against the streets' clock did not time out in the odds (won %s)" % str(won))
	# the Runs card goes red when the fight won't fit
	main.show_room(main.MISSIONS)
	main._missions._pick_zone(1)
	main._missions._shown = ""
	main.refresh()
	var cr: Dictionary = main._missions._cols[0]
	var t00 = Data.ZONES[1]["tiers"][0]
	_check(sim.estimate(t00) > sim.clock_of(t00) and cr["card"].vals[0].get_theme_color("font_color") == Pal.BAD, "fists' Runs card is not red over the clock: %.0f of %.0f" % [sim.estimate(t00), sim.clock_of(t00)])
	sim.equipped["Primary"] = gun0
	sim.equipped["Secondary"] = sec0
	sim.equipped["Helmet"] = hat0
	sim.hp = hp0
	# the Runs card: the clock beside the fight, red when the fight won't fit
	sim.load_dict(saved)
	main.show_room(main.MISSIONS)
	main._missions._pick_zone(1)
	main._missions._shown = ""
	main.refresh()
	var c: Dictionary = main._missions._cols[0]
	var over_c: bool = sim.estimate(Data.ZONES[1]["tiers"][0]) > sim.clock_of(Data.ZONES[1]["tiers"][0])     # "You last" against the run's clock (BUILD46-S)
	var last_t: String = c["card"].vals[0].text
	_check(not over_c or (last_t.contains(Fmt.mss(sim.clock_of(Data.ZONES[1]["tiers"][0]))) or last_t == Words.SITE_CARD["over_short"]) and c["card"].vals[0].get_theme_color("font_color") == Pal.BAD, "the Runs card's clock is off: '%s'" % last_t)
	_check(over_c or not last_t.contains("on the clock"), "the Runs card says over the clock when it isn't: '%s'" % last_t)
	_check_fit(main, "Runs (the clock)")
	sim.load_dict(saved)
	main.refresh()
	print("run timers ok: the budget, the head's time, ticking only in a fight, out of time, the insurance, the dry runs, the screens")


## Every visible label's text under a node, for checks on what a panel says.
func _texts(n: Node) -> Array:
	var out: Array = []
	if n is CanvasItem and not n.visible:
		return out
	if n is Label and n.text != "":
		out.append(n.text)
	for c in n.get_children():
		out.append_array(_texts(c))
	return out


## The playtest record (11 Oct): what the player does lands in sim.chronicle, a dry run adds nothing, the record
## rides the save and the move, the clock at the game snapshots every ten minutes, and the read makes its page from it.
func _chronicle_checks() -> void:
	var s = Sim.new()
	s.start()
	var kinds := func() -> Dictionary:
		var k_in := {}
		for e in s.chronicle:
			k_in[e["k"]] = int(k_in.get(e["k"], 0)) + 1
		return k_in
	s.cash += 100000.0
	s.set_class("Doorman")
	_check(kinds.call().get("class", 0) == 1, "a class change wrote no line: %s" % str(kinds.call()))
	var n0: int = s.chronicle.size()
	s.survival(3)                                  # the odds: dry runs
	_check(s.chronicle.size() == n0, "a dry run wrote %d lines to the record" % (s.chronicle.size() - n0))
	for i in range(4):
		s.deploy(0)
		var guard := 0
		while s.on_mission() and guard < 3000:
			s.hp = s.max_hp()                      # kept alive: a death would hand the record a fresh, classless runner
			s.advance(1.0)
			guard += 1
		if s.on_mission():
			s.extract_now()
	_check(s.cls == "Doorman", "the record's runner died on tier 1")
	var lv0: int = s.level()
	while s.level() < lv0 + 3:
		s.xp += 50.0
	s._earn_points(lv0)                           # what a run's XP does on the way back
	var k: Dictionary = kinds.call()
	_check(k.get("run", 0) == 4, "four runs wrote %d run lines" % k.get("run", 0))
	_check(k.get("level", 0) >= 1 and s.level() > 1, "levelling to %d wrote no level line" % s.level())
	_check(s.chronicle.filter(func(e): return e["k"] == "level")[-1].get("to", 0) == s.level(), "the level line does not read the level reached")
	var run: Dictionary = s.chronicle.filter(func(e): return e["k"] == "run")[0]
	for f in ["t", "p", "w", "lv", "cls", "tier", "site", "outcome", "time", "kills", "of", "dps", "kit",
			"dealt", "ticked", "ticked_by", "split_total", "split_dot", "dot_gear", "dot_tree", "signal", "gear", "gear_wearable", "gear_at_mine"]:     # the dots and the drops (17 Oct)
		_check(run.has(f), "a run line has no '%s': %s" % [f, str(run.keys())])
	_check(int(run.get("ticked", 0)) <= int(run.get("dealt", 0)) and int(run.get("gear_wearable", 0)) <= int(run.get("gear", 0)) and int(run.get("gear_at_mine", 0)) <= int(run.get("gear", 0)), "a run line's dots or drops don't add up: %s" % str(run))
	var rec_id: String = str(Data.web_links(Data.web_start(s.cls))[0])     # beside the start (the start's owned from the first, 3 Nov)
	_check(_walk(s, rec_id), "%s did not train for the record: %s" % [rec_id, s.train_block(rec_id)])
	_check(kinds.call().get("train", 0) == 1, "training wrote no line")
	s.unlock_all()                               # the Yard's the Manager's deeds on a real camp (13 Oct)
	_check(s.yard_pick("generator", 0, "a"), "the generator pick did not buy: %s" % s.yard_pick_block("generator", 0, "a"))
	_check(kinds.call().get("yard", 0) == 1, "a yard pick wrote no line")
	# the clock at the game: a snapshot each SNAP_S played, none between
	var snaps0: int = kinds.call().get("snap", 0)
	for i in range(int(Sim.SNAP_S * 2.5)):
		s.tick_played(1.0)
	_check(kinds.call().get("snap", 0) - snaps0 == 2, "two and a half snapshots' time played wrote %d" % (kinds.call().get("snap", 0) - snaps0))
	# the save carries the count and the clock, never the lines (they go to the record file: _record_file_checks)
	_check(s.chron_count == s.chronicle.size(), "the record counts %d lines and holds %d" % [s.chron_count, s.chronicle.size()])
	var d: Dictionary = s.to_dict()
	_check(not d.has("chronicle"), "the save carries the record's lines")
	var t = Sim.new()
	t.load_dict(JSON.parse_string(JSON.stringify(d)))
	_check(t.chron_count == s.chron_count and t.chronicle.is_empty() and absf(t.played_s - s.played_s) < 0.01, "the count and the clock did not ride the save: %d of %d lines, %.0f of %.0f s" % [t.chron_count, s.chron_count, t.played_s, s.played_s])
	t.tick_played(1.0)
	_check(t.chronicle.is_empty(), "a loaded save snapshotted again at once")
	var kept: int = s.chronicle.size()
	_finish_campaign(s)
	_check(s.chronicle.size() >= kept, "the campaign lost the record: %d lines of %d" % [s.chronicle.size(), kept])
	# the read
	var page: String = PlaytestRead.summarize(s.to_dict(), s.chronicle, "smoke")
	for h in ["## The time", "## Milestones", "## The gates, read from play", "## Runs, site by site", "## Hour by hour", "## Where the money and the points went", "## The kit, as it changed"]:
		_check(page.contains(h), "the playtest read has no '%s'" % h)
	_check(page.contains("Class: none to Doorman") and page.contains("Level "), "the playtest read's milestones miss the class or a level")
	# the odds set off at (12 Oct): a run line carries the card's reading and the regen worn, and the read bands them
	var with_odds: Array = s.chronicle.duplicate(true)
	with_odds.append({"k": "run", "site": "The Allotments", "tier": 0, "depth": 1, "outcome": "Back", "odds": 0.95, "regen": 2.5, "time": 60.0, "kills": 4, "of": 4, "cash": 10, "xp": 5, "p": 100.0, "t": 100.0, "lv": 1, "cls": "Doorman"})
	with_odds.append({"k": "run", "site": "The Allotments", "tier": 0, "depth": 1, "outcome": "Dead", "odds": 0.5, "regen": 0.0, "time": 60.0, "kills": 1, "of": 4, "cash": 0, "xp": 0, "p": 200.0, "t": 200.0, "lv": 1, "cls": "Doorman"})
	var page2: String = PlaytestRead.summarize(s.to_dict(), with_odds, "smoke")
	with_odds.append({"k": "run", "site": "The Bank", "tier": 8, "depth": 1, "outcome": "Back", "time": 60.0, "kills": 4, "of": 4, "cash": 10, "xp": 5, "p": 300.0, "t": 300.0, "lv": 9, "cls": "Drifter",
		"dealt": 1000, "ticked": 250, "ticked_by": {"fire": 250}, "split_total": 40.0, "split_dot": 10.0, "dot_gear": 0.0, "dot_tree": 20.0, "signal": false, "gear": 10, "gear_wearable": 3, "gear_at_mine": 2})
	var dots_only: Array = s.chronicle.filter(func(e): return str(e.get("k", "")) != "run") + [with_odds.back()]     # the one run read alone (27 Oct: the camp's own runs find gear now the wear's gone)
	var page_dots: String = PlaytestRead.summarize(s.to_dict(), dots_only, "smoke")
	_check(page_dots.contains("## The dots and the drops") and page_dots.contains("| 1 | 0%, 20% | 1000 | 25% (250) | 25% |") and page_dots.contains("30% (3) | 20% (2) |"), "the playtest read doesn't read the dots and the drops: %s" % page_dots.substr(page_dots.find("## The dots"), 600))
	_check(page2.contains("## The odds set off at") and page2.contains("| Safe (90-100%) | 1 | 0 |") and page2.contains("| A coin toss (40-60%) | 1 | 1 |") and page2.contains("the lowest taken: 50%"), "the playtest read doesn't band the odds set off at: %s" % page2.substr(page2.find("## The odds"), 500))
	# and the sim writes them: a run read at the gate carries its odds, the site's fire and HP, the regen
	var g = Sim.new()
	g.start()
	g.set_class("Doorman")
	var o0: float = g.survival(0)
	g.deploy(0)
	while g.on_mission():
		g.advance(1.0)
	var run_line: Dictionary = {}
	for e in g.chronicle:
		if e["k"] == "run":
			run_line = e
	_check(not run_line.is_empty() and is_equal_approx(float(run_line.get("odds", -2.0)), snappedf(o0, 0.01)) and run_line.has("their_hp") and run_line.has("their_dps") and run_line.has("regen"), "a run's line doesn't carry the odds at the gate (%.2f): %s" % [o0, str(run_line)])
	# a card still reading logs -1, never its part-read share (the reviewer)
	g.hp = g.max_hp()
	g._surv_cache[0] = [g._odds_key(0), 0.0, 0, 0, RandomNumberGenerator.new(), 1.0]     # the shape survival() keeps, no runs read
	g.deploy(0)
	while g.on_mission():
		g.advance(1.0)
	var last_run: Dictionary = {}
	for e in g.chronicle:
		if e["k"] == "run":
			last_run = e
	_check(float(last_run.get("odds", 0.0)) == -1.0, "a part-read card's odds were logged as read: %s" % str(last_run.get("odds", "")))


## The record file (11 Oct, the reviewer): the lines go to the .record.jsonl beside the save on each save and leave
## the sim; a slot takes a copy and brings it back; a new game moves the old record aside; the read takes the save
## through JSON with the file, as on the player's machine.
func _record_file_checks(main) -> void:
	main.new_game()
	main.sim.mythics_on = false            # the smoke's camps find no mythics on their own (17 Oct: a full pack keeps one now - a bot's Bomb Disposal Suit stopped the clock, its moment held the game); the mythics' own checks make theirs
	_open_camp(main.sim)
	var rec: String = main.record_file()
	_check(rec == SMOKE_SAVE.get_basename() + ".record.jsonl", "the smoke's record is at %s" % rec)
	_check(main.sim.chronicle.is_empty() and PlaytestRead.read_record(rec).size() == main.sim.chron_count and main.sim.chron_count >= 1, "a new game's save did not write its start to the record: %d in the file, %d counted, %d waiting" % [PlaytestRead.read_record(rec).size(), main.sim.chron_count, main.sim.chronicle.size()])
	_set_cls(main.sim, "Doorman")
	main.sim.cash += 100000.0
	main.sim.yard_pick("generator", 0, "a")
	for i in range(int(Sim.SNAP_S) + 1):
		main.sim.tick_played(1.0)
	main.save_game()
	var lines: Array = PlaytestRead.read_record(rec)
	_check(lines.size() == main.sim.chron_count and main.sim.chronicle.is_empty(), "the save left the record at %d lines of %d" % [lines.size(), main.sim.chron_count])
	_check(lines.any(func(e): return e["k"] == "class") and lines.any(func(e): return e["k"] == "yard") and lines.any(func(e): return e["k"] == "snap"), "the record file misses the class, the pick or the snapshot: %s" % str(lines.map(func(e): return e["k"])))
	var bytes := FileAccess.get_file_as_string(SMOKE_SAVE).length()
	main.save_game()
	_check(PlaytestRead.read_record(rec).size() == lines.size() and absi(FileAccess.get_file_as_string(SMOKE_SAVE).length() - bytes) < 200, "a second save wrote the record again or grew the save")
	# a slot takes the record with it
	main.save_game(SMOKE_SLOT % 3)
	_check(PlaytestRead.read_record(main.record_file(SMOKE_SLOT % 3)).size() == lines.size(), "the slot did not take the record")
	# loading: a session line, ahead of the settle's runs
	main.load_game(SMOKE_SAVE)
	main.sim.mythics_on = false            # the smoke's camps find no mythics on their own (17 Oct: a full pack keeps one now - a bot's Bomb Disposal Suit stopped the clock, its moment held the game); the mythics' own checks make theirs
	main.save_game()
	var after: Array = PlaytestRead.read_record(rec)
	_check(after.size() == lines.size() + 1 and after[-1]["k"] == "session", "loading did not write one session line: %s" % str(after.slice(lines.size()).map(func(e): return e["k"])))
	# the read, from the files as the player has them: the save through JSON, every number a float
	var d: Dictionary = main._read_save(SMOKE_SAVE)
	var page: String = PlaytestRead.summarize(d["sim"], PlaytestRead.read_record(rec), SMOKE_SAVE)
	_check(page.contains("## Milestones") and page.contains("Class: none to Poacher") and page.contains("## Hour by hour") and not page.contains("were lost") and not page.contains("past the save"), "the read from the files is short: %s" % page.substr(0, 300))
	# a slot loaded brings its record back as the autosave's, the one there moved aside
	main.sim.chron("after the slot")
	main.save_game()
	main.load_game(SMOKE_SLOT % 3)
	main.sim.mythics_on = false            # the smoke's camps find no mythics on their own (17 Oct: a full pack keeps one now - a bot's Bomb Disposal Suit stopped the clock, its moment held the game); the mythics' own checks make theirs
	_check(PlaytestRead.read_record(rec).size() == lines.size(), "the loaded slot's record is not the autosave's: %d lines, not %d" % [PlaytestRead.read_record(rec).size(), lines.size()])
	var kept: Array = Array(DirAccess.get_files_at("user://")).filter(func(f): return f.begins_with(SMOKE_SAVE.get_file().get_basename() + ".record.") and f != rec.get_file())
	_check(not kept.is_empty(), "the autosave's record was not kept aside when the slot came in")
	# a new game starts an empty record and keeps the old one
	main.new_game()
	main.sim.mythics_on = false            # the smoke's camps find no mythics on their own (17 Oct: a full pack keeps one now - a bot's Bomb Disposal Suit stopped the clock, its moment held the game); the mythics' own checks make theirs
	_open_camp(main.sim)
	_check(PlaytestRead.read_record(rec).size() == main.sim.chron_count and main.sim.chron_count <= 2, "a new game's record holds the last game's lines: %d" % PlaytestRead.read_record(rec).size())


## The junk rules (11 Oct, Matt's list): the rarity the Fence takes up to, never an upgrade on what's worn, never a
## kind kept, the buttons going round, the line saying it, the rules saved.
func _junk_rule_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	main.show_room(main.ARMOURY)
	main._armoury.selected = {}
	sim.junk_upto = -1
	sim.junk_keep = ""
	main.refresh()
	var words := []
	for k in range(4):
		main._armoury._toggle(1)
		words.append(main._armoury._toggles[1].text)
		_check_fit(main, "Lock-up (sell %s)" % main._armoury._toggles[1].text)
	_check(words == ["Sell when home: commons", "Sell when home: up to Uncommon", "Sell when home: up to Rare", "Sell when home: off"] and sim.junk_upto == -1, "the sell rule does not go round: %s" % str(words))
	_check(main._armoury._toggles[2].disabled, "the keep rule is live with nothing sold")
	main._armoury._toggle(1)
	main._armoury._toggle(1)                  # to uncommon
	var keeps := []
	for k in range(sim.JUNK_KEEPS.size()):
		main._armoury._toggle(2)
		keeps.append(sim.junk_keep)
		_check_fit(main, "Lock-up (keep %s)" % main._armoury._toggles[2].text)
	_check(keeps == ["guns", "body", "bags", "parts", ""], "the keep rule does not go round: %s" % str(keeps))
	_check(main._armoury.junk_words(sim).contains("commons and uncommons") and main._armoury.junk_words(sim).contains("never an upgrade"), "the rules' line is off: %s" % main._armoury.junk_words(sim))
	# what goes: an uncommon spare under what's worn; what stays: a rare, an upgrade, a kept kind
	sim.equipped["Armour"] = sim._plain("Armour", "Riot suit")
	sim.equipped["Helmet"] = sim._plain("Helmet", "Visored helmet")
	var spare: Dictionary = sim._plain("Helmet", "Cycle helmet")
	spare["rarity"] = 1
	var rare: Dictionary = sim._plain("Helmet", "Cycle helmet")
	rare["rarity"] = 2
	var up: Dictionary = sim._plain("Armour", "Riot suit")
	up["rarity"] = 1
	up["affixes"] = [{"stat": "hp", "value": 60.0, "tier": 3}]
	var gun: Dictionary = sim._plain("Secondary", "Knife")
	gun["rarity"] = 0
	_check(sim.is_upgrade(up) and not sim.is_upgrade(spare), "the upgrade reads wrong: up %s, spare %s" % [sim.is_upgrade(up), sim.is_upgrade(spare)])
	sim.junk_keep = "guns"
	_check(sim.is_junk(spare) and not sim.is_junk(rare) and not sim.is_junk(up) and not sim.is_junk(gun), "the rules read wrong: spare %s rare %s upgrade %s gun %s" % [sim.is_junk(spare), sim.is_junk(rare), sim.is_junk(up), sim.is_junk(gun)])
	sim.junk_keep = ""
	_check(sim.is_junk(gun) == (not sim.is_upgrade(gun)), "with nothing kept the gun is not by the other rules")
	sim.junk_upto = -1
	_check(not sim.is_junk(spare), "the rules sell with the rule off")
	# the save: the rules
	sim.junk_upto = 2
	sim.junk_keep = "bags"
	var d: Dictionary = JSON.parse_string(JSON.stringify(sim.to_dict()))
	sim.load_dict(d)
	_check(sim.junk_upto == 2 and sim.junk_keep == "bags", "the rules did not save: %d %s" % [sim.junk_upto, sim.junk_keep])
	sim.load_dict(saved)
	main.refresh()
	print("junk rules ok: the rarity, the upgrade kept, the kind kept, the buttons, the line, the save")


## The upgrade's arrow (11 Oct, Matt's list): on a stash item that beats what's worn in its slot, nowhere else, gone
## once it's on; inside its cell; in the pack and on the Fence's shelf the same.
func _upgrade_arrow_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	while not sim.stash_room(12) and not sim.stash.is_empty():
		sim.sell(sim.stash[0])
	sim.equipped["Helmet"] = sim._plain("Helmet", "Hard hat")
	# no pace on any of them (13 Oct): a slower helmet's spare reads faster, and on a front that can't touch the runner
	# the faster one is the better - the check flaked on the Visored helmet and the Cycle helmet
	var better: Dictionary = sim._plain("Helmet", "Army helmet")
	var worse: Dictionary = sim._plain("Helmet", "Hard hat")
	sim.stash_put(better)
	sim.stash_put(worse)
	main.show_room(main.ARMOURY)
	main._armoury.selected = {}
	main._armoury._inv.kind = 0
	main._armoury._inv.rarity = -1
	main.refresh()
	var inv = main._armoury._inv
	inv.judge_all()                          # the page's arrows judged (BUILD45: a few a frame in play)
	var cb = inv.cell_node(inv.cell_of(better["id"]))
	var cw = inv.cell_node(inv.cell_of(worse["id"]))
	_check(cb != null and cb._up.visible and cw != null and not cw._up.visible, "the arrow is not on the better helmet alone: better %s, worse %s" % [cb != null and cb._up.visible, cw != null and cw._up.visible])
	if cb != null:
		_check(Rect2(Vector2.ZERO, cb.size).encloses(Rect2(cb._up.position, cb._up.size)), "the arrow leaves its cell")
	_check_fit(main, "Lock-up (an upgrade's arrow)")
	for slot in Data.SLOTS:
		var c = main._armoury._body._boxes[slot]["cell"]
		_check(not c._up.visible, "a worn %s carries the arrow" % slot)
	var was_worn: Dictionary = sim.equipped["Helmet"]
	sim.equip_item(better["id"])
	main.refresh()
	inv.judge_all()
	var cw2 = inv.cell_node(inv.cell_of(worse["id"]))
	# the plain hat that came off, by its id: a hard hat the camp already had (a magic one off a run) can beat the
	# Army helmet and rightly carry the arrow - the flake of 13 and 15 Oct
	var hard = inv.cell_node(inv.cell_of(int(was_worn["id"]))) if sim.stash.has(was_worn) else null
	var hats: Array = [worse] + ([was_worn] if sim.stash.has(was_worn) else [])
	_check(cw2 != null and not cw2._up.visible and (hard == null or not hard._up.visible), "an arrow stayed once the better helmet went on: worn %s, the hats' verdicts %s, front %d (%s, night %s), HP %.0f of %.0f" % [str(sim.equipped["Helmet"]["base"]) if sim.equipped["Helmet"] != null else "none", str(hats.map(func(x): return sim.compare(x))), sim.front_tier(), sim.weather_of(sim.front_tier()), sim.is_night(), sim.hp, sim.max_hp()])
	sim.load_dict(saved)
	main.refresh()
	_try_on_checks(main)
	print("upgrade arrows ok: the better piece alone, inside its cell, never on the body, gone once worn")


## Tried on (11 Oct, Matt: the Van's Spare's +18% damage read worse than a machine pistol that cost him damage):
## better is the runner's damage with the piece worn, so the verdict, the arrow, the deltas, the junk rules and
## Equip if better all agree with the top bar; and a plain better piece still reads better.
func _try_on_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	while not sim.stash_room(12) and not sim.stash.is_empty():
		sim.sell(sim.stash[0])
	var vans: Dictionary = Items.roll_unique(sim._unique_named("The Van's Spare"), sim.rng)
	sim.xp = maxf(sim.xp, Data.xp_for_level(Items.wear_level(vans)))     # a runner who can wear it (D5: the levels come slower)
	vans["base"] = "Old revolver"            # the case as Matt met it (11 Oct), on its old body: tiered (12 Oct) it rolls at T3 or up
	vans["tier"] = 2
	vans["attachments"] = {"optic": null}
	sim.equipped["Secondary"] = vans
	var mp: Dictionary = sim._plain("Secondary", "Machine pistol")
	mp["affixes"] = [{"stat": "damage_pct", "value": 4.0, "tier": 2}]     # 15 Oct: the Van's Spare at two thirds; a +10% pistol now beats it, rightly
	sim.stash_put(mp)
	_check(Items.score(mp) > Items.score(vans), "the case no longer stands: the pistol's own score is under the Van's Spare's")
	var before: float = sim.fit_value({}, "Secondary")
	var with_mp: float = sim.fit_value(mp)
	_check(with_mp < before and sim.compare(mp) == -1 and not sim.is_upgrade(mp), "the machine pistol over the Van's Spare reads %d (%.1f against %.1f dmg/s)" % [sim.compare(mp), with_mp, before])
	sim.auto_equip = true
	var others: Array = sim.stash.filter(func(o): return o["slot"] == "Secondary" and o["id"] != mp["id"])
	for o in others:
		sim.stash.erase(o)                      # the case is the pistol against the Van's Spare alone: another secondary an earlier test left could rightly beat it (12 Oct: the flake)
	_check(not sim.equip_best("Secondary") and sim.equipped["Secondary"]["id"] == vans["id"], "Equip if better put the %s on over the Van's Spare" % sim.equipped["Secondary"]["base"])
	sim.junk_upto = 2
	_check(sim.is_junk(mp), "the junk rules keep the pistol that costs damage")
	main.show_room(main.ARMOURY)
	main._armoury.selected = {"kind": "stash", "id": mp["id"]}
	main.refresh()
	main._armoury._inv.judge_all()
	var cell = main._armoury._inv.cell_node(main._armoury._inv.cell_of(mp["id"]))
	_check(cell != null and not cell._up.visible, "the pistol that costs damage carries the arrow")
	_check(main._armoury._pick._verdict.text == "▼ Downgrade", "the verdict on the pistol reads '%s'" % main._armoury._pick._verdict.text)
	var ds: Array = PickPanel.deltas_for(sim, mp, vans)
	# no delta twice (13 Oct, Matt's Branch Pistol against the Van's Spare: "2% dmg" twice, from damage % listed for the
	# guns and the attachments, and the deltas that decided it pushed off the line)
	var branch: Dictionary = Items.roll_unique(sim._unique_named("The Branch Pistol"), sim.rng)
	var bd: Array = PickPanel.deltas_for(sim, branch, vans)
	var bwords: Array = bd.map(func(d): return str(d[1]).substr(str(d[1]).find(" ") + 1))     # the words after the figure
	var dup := ""
	for k in range(bwords.size()):
		if bwords.find(bwords[k]) != k:
			dup = bwords[k]
	_check(dup == "", "a delta shows twice (%s): %s" % [dup, str(bd)])
	_check(bd.any(func(d): return str(d[1]).ends_with("dmg <½HP")) and bd.any(func(d): return str(d[1]).ends_with("dmg pre-clear")), "the Branch Pistol's deltas miss its own: %s" % str(bd))
	# a unique's rule on its card (13 Oct, Matt: chips): every unique, at every width an item head is drawn, shows its rule
	# chip first and every affix after it, the rule shortened where the long form would push one off
	var IH = load("res://scripts/ui/item_head.gd")
	var widths: Array = [main._armoury._pick._heads[0].width, load("res://scripts/ui/vendor.gd").COL_W]
	for w in widths:
		var head = IH.new(w, true)
		main.add_child(head)
		for u in Data.UNIQUES:
			var ui: Dictionary = Items.roll_unique(u, sim.rng)
			head.show_item(ui, sim)
			var want_in: int = 1 + Items.affix_lines(ui, false, false).size()     # the rule and every affix; a base's element chip after them, if there's room
			var first: String = head._affixes._labels[0].text
			_check(head._affixes.shown() >= want_in and (first == str(u["words"]) or first == str(u.get("short", ""))), "%s at %d px: %d of %d chips, the first '%s'" % [u["name"], w, head._affixes.shown(), want_in, first])
		# a base that turns its hits to an element says so on a chip in the element's colour, first under the headline,
		# with the rarity and level still on top at the longest rarity (14 Oct, Matt: the claw hammer bleeds and its card
		# didn't say)
		var conv_n := 0
		for slot in Data.BASES.keys():
			for b in Data.BASES[slot]:
				var want_in: Array = IH.conv_chips({"slot": slot, "base": b["name"]})
				if want_in.is_empty():
					continue
				var it: Dictionary = sim._plain(slot, b["name"])
				if it.is_empty():
					continue
				conv_n += 1
				it["rarity"] = Data.RARITIES.size() - 1
				head.show_item(it, sim)
				var seen: Array = range(IH.CHIPS).filter(func(j): return head._chips[j].visible).map(func(j): return head._chip_labels[j].text)
				var leveled: bool = not (Items.is_ammo(it) or Items.is_paper(it) or Items.is_medical(it) or Items.is_grenade(it))
				_check(seen.has(Items.rarity_name(it)) and (not leveled or seen.any(func(t): return (str(t).begins_with("Level ") or str(t).begins_with("Item level ")))), "%s at %d px lost its rarity or level: %s" % [b["name"], w, str(seen)])
				var first: String = head._affixes._labels[0].text     # a plain base, no affixes: its element chip first
				_check(head._affixes.shown() >= 1 and first in want_in[0]["forms"], "%s at %d px doesn't lead with '%s': '%s'" % [b["name"], w, want_in[0]["forms"][1], first])
				_check(head._affixes._labels[0].get_theme_color("font_color") == want_in[0]["colour"], "%s's element chip isn't in its colour" % b["name"])
		_check(conv_n > 0, "no base with an element share was checked")
		head.queue_free()
	_check(str(Data.AFFIXES.filter(func(a): return a["stat"] == "armour_pct")[0]["short"]) != str(Data.AFFIXES.filter(func(a): return a["stat"] == "armour")[0]["short"]), "armour % and flat armour share a short name")
	_check(not ds.is_empty() and float(ds[0][0]) < 0.0 and str(ds[0][1]).ends_with("dmg/s"), "the deltas don't lead with the damage lost: %s" % str(ds))
	_check_fit(main, "Lock-up (a pistol against the Van's Spare)")
	# the other way: the Van's Spare over the pistol is the upgrade, and Equip if better takes it
	sim.equipped["Secondary"] = mp
	sim.stash.erase(mp)
	sim.stash_put(vans)
	_check(sim.compare(vans) == 1 and sim.equip_best("Secondary") and sim.equipped["Secondary"]["id"] == vans["id"], "the Van's Spare over the pistol is not the upgrade (%s went on)" % sim.equipped["Secondary"]["base"])
	sim.stash.append_array(others)            # the case done: what an earlier test left goes back
	# a plain better vest still reads better; the same vest a trade when it costs the damage a worn helmet gave
	var vest: Dictionary = sim._plain("Armour", "Stab vest")
	sim.equipped["Armour"] = vest
	var riot: Dictionary = sim._plain("Armour", "Riot suit")
	_check(sim.compare(riot) == 1, "a riot suit over a stab vest is not the upgrade")
	var dmg_vest: Dictionary = sim._plain("Armour", "Stab vest")
	dmg_vest["affixes"] = [{"stat": "damage_pct", "value": 30.0, "tier": 4}]
	sim.equipped["Armour"] = dmg_vest
	_check(sim.compare(riot) == 0, "a riot suit that costs the vest's damage is not a trade: %d" % sim.compare(riot))
	# the body's figure (12 Oct, Matt kept a 5-armour helmet and a charm for their +5 HP/s over 50-armour drops, and the
	# arrow called the drops better): regen counts, the verdict follows the figure, and a charm's find against its
	# regen is a trade
	sim.equipped["Armour"] = vest
	var hat: Dictionary = sim._plain("Helmet", "Hard hat")
	sim.equipped["Helmet"] = hat
	# the regen sized to the fight the smoke has reached (the review): a fifth of the HP back over the fight, never under 5
	var rg: float = maxf(5.0, 0.2 * sim.max_hp() / sim.front_fight())
	var regen_hat: Dictionary = sim._plain("Helmet", "Hard hat")
	regen_hat["affixes"] = [{"stat": "regen", "value": rg, "tier": 4}]
	var s0: float = sim.survival_value()
	_check(sim.survival_gain(regen_hat) > 0.0 and sim.compare(regen_hat) == 1, "a hard hat with +%.0f HP/s over a plain one: survival %+.3f, verdict %d" % [rg, sim.survival_gain(regen_hat), sim.compare(regen_hat)])
	_check(is_equal_approx(sim.survival_value(), s0), "trying the regen hat on moved the kit's own figure: %.3f against %.3f" % [sim.survival_value(), s0])
	# a unique's rule on the body counts in its figure (23 Oct, Matt's compare: the Doorman's Jacket read a downgrade to
	# lighter plates - its quarter off with three on you was the fight's alone): the same vest with the Jacket's rule
	# reads better by the rule's share where three are on you, the same where fewer are
	var ruled: Dictionary = sim._plain("Armour", "Stab vest")
	ruled["rule"] = "doormans"
	var front_t: Dictionary = sim.effective(sim.front_tier())
	var on_you: int = sim.contact(front_t)
	var with_rule: float = sim._try(ruled, sim.survival_value)
	var plain_v: float = sim._try(vest, sim.survival_value)
	if on_you >= 3:
		_check(is_equal_approx(snappedf(with_rule / plain_v, 0.01), snappedf(1.0 / Data.FX["rule/doormans"], 0.01)), "the Jacket's rule isn't in the body's figure: %.3f against %.3f with %d on you" % [with_rule, plain_v, on_you])
	else:
		_check(is_equal_approx(with_rule, plain_v), "the Jacket's rule counted with under three on you: %.3f against %.3f" % [with_rule, plain_v])
	var hd: Array = PickPanel.deltas_for(sim, regen_hat, hat)
	_check(not hd.is_empty() and float(hd[0][0]) > 0.0 and str(hd[0][1]).ends_with(sim.surv_against()), "the helmet's deltas don't lead with the survival: %s" % str(hd))     # its yardstick named (BUILD48 A, item 22)
	sim.equipped["Helmet"] = regen_hat
	var comp: Dictionary = sim._plain("Helmet", "Composite helmet")
	var sg: float = sim.survival_gain(comp)
	var want: int = 1 if sg > sim.TRY_EPS else (-1 if sg < -sim.TRY_EPS else 0)
	_check(sim.compare(comp) == want, "a composite helmet over the regen hat reads %d with the survival at %+.3f (damage %.2f against %.2f, on a run %s, rig %s)" % [sim.compare(comp), sg, float(sim._try(comp, sim.damage_total)), float(sim._try({}, sim.damage_total)), str(sim.on_mission()), str(sim.rig.map(func(x): return x["base"]))])
	var tag: Dictionary = sim._plain("Charm", "Dog tag")
	tag["affixes"] = [{"stat": "regen", "value": rg, "tier": 4}]
	sim.equipped["Charm"] = tag
	var finder: Dictionary = sim._plain("Charm", "Dog tag")
	finder["affixes"] = [{"stat": "rarity_pct", "value": 40.0, "tier": 4}]
	_check(sim.compare(finder) == 0, "a find charm over a regen charm is not a trade: %d" % sim.compare(finder))
	var both: Dictionary = sim._plain("Charm", "Dog tag")
	both["affixes"] = [{"stat": "regen", "value": rg, "tier": 4}, {"stat": "rarity_pct", "value": 40.0, "tier": 4}]
	_check(sim.compare(both) == 1, "a charm with the same regen and find on top is not the upgrade: %d" % sim.compare(both))
	sim.equipped["Charm"] = finder
	_check(sim.upgrade_gain(both) >= sim.survival_gain(both) and sim.upgrade_gain(both) > 0.0, "a charm's regen counts nothing in the bot's shop: %.3f" % sim.upgrade_gain(both))
	# the answers hold through a run's shooting: rounds spent aren't a change of kit (the first cut threw them away
	# each second, the rig's counts in the key)
	sim.load_dict(saved)
	if sim.equipped["Primary"] == null or Items.ammo_type(sim.equipped["Primary"]) in ["none", ""]:
		sim.equipped["Primary"] = sim._plain("Primary", "Pipe shotgun")     # a gun that spends rounds (the Allotments lean to melee: 12 Oct)
	var box: Dictionary = sim.ammo_box(Items.ammo_type(sim.equipped["Primary"]))
	if not box.is_empty():
		var ty_fed: String = Items.ammo_type(sim.equipped["Primary"])
		sim.rig = sim.rig.filter(func(x): return not (Items.is_mag(x) and Items.mag_type(x) == ty_fed))     # the gun's other magazines out: it fires its best first, and a small one runs dry in the window (a flake, 25 Oct; the three-stage review, tools 4)
		for fed in _rmags(sim, box["name"], 8):     # a pile at real size that can't run dry in the window (500 in one was trimmed at the gate)
			sim.rig.push_front(fed)              # fed whatever the smoke left in the rig
	sim.rig.append(sim._plain(Data.MEDICAL, "Bandage"))
	sim.hp = sim.max_hp()
	sim.deploy(3)
	sim.mission["target_hp"] = 1e9
	sim.advance(1.0)
	var k0: int = 0
	var r0: int = 0
	var r1: int = 0
	var parts0: Array = []
	for tries in range(3):                   # 21 Oct, a flake: the window again if dusk or the weather turned in it
		var sky: Array = [sim.is_night(), sim.weather_of(sim.front_tier()), sim.front_tier()]
		k0 = sim._kit_key()
		parts0 = sim._kit_parts()
		r0 = sim.rounds_for(sim.equipped["Primary"]) if sim.equipped["Primary"] != null else 0
		for k in range(5):
			sim.hp = sim.max_hp()
			sim.advance(1.0)
		sim.hp = sim.max_hp()                # a hit in the last second is a change of kit too (under half)
		r1 = sim.rounds_for(sim.equipped["Primary"]) if sim.equipped["Primary"] != null else 0
		if [sim.is_night(), sim.weather_of(sim.front_tier()), sim.front_tier()] == sky:
			break
	_check(r1 < r0 and sim._kit_key() == k0, "the try-on's answers were thrown away by rounds spent (%d -> %d rounds, key %s%s)" % [r0, r1, "same" if sim._kit_key() == k0 else "changed", _parts_changed(parts0, sim._kit_parts())])
	# but a thing leaving the rig is a change (armour a med, the review): a med used throws them away
	var med: Dictionary = sim.first_med()
	if not med.is_empty():
		sim.hp = sim.max_hp() * 0.6               # hurt, not under half (the key reads that): a med goes (at full, one with nowhere to spill is kept, 19 Oct)
		sim.use_med(med["id"])
		_check(sim._kit_key() != k0, "a med used left the try-on's answers standing (armour a med counts the rig)")
	sim.extract_now()
	sim.load_dict(saved)
	main._armoury.selected = {}
	main.refresh()
	print("tried on ok: the Van's Spare kept, the arrow, the verdict, the deltas, the junk, equip if better, a trade, held through a run")


## What came back (11 Oct, Matt's list): every run since the last Seen added up on a card over the Runs screen -
## the runs, cash, XP, items, levels, the dearest find, the firsts - over a column the last run didn't come from,
## put away by Seen, kept by the save, never added to by a dry run.
func _came_back_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.came_back_seen()
	main.show_room(main.MISSIONS)
	main._missions.select(0)
	main.refresh()
	_check(not main._missions._came.visible, "the card shows with no run since Seen")
	sim.survival(3)
	_check(int(sim.came_back["runs"]) == 0, "a dry run added to what came back")
	for k in range(2):
		sim.hp = sim.max_hp()
		sim.deploy(3)
		var g := 0
		while sim.on_mission() and g < 3000:
			sim.hp = sim.max_hp()
			sim.advance(1.0)
			g += 1
		if sim.on_mission():
			sim.extract_now()
	var cb: Dictionary = sim.came_back
	_check(int(cb["runs"]) == 2, "two runs read %d on the card" % int(cb["runs"]))
	_check(float(cb["xp"]) > 0.0 and float(cb["cash"]) >= 0.0, "the card's XP and cash did not add: %s" % str(cb))
	# a find, a first and a level, as a run would bring them
	var find: Dictionary = sim._plain("Armour", "Riot suit")
	find["rarity"] = 3
	find["value"] = 99999
	sim.stash_put(find)
	sim._came_back_find(find)
	var cheap: Dictionary = sim._plain("Helmet", "Cycle helmet")
	sim._came_back_find(cheap)
	_check(int(sim.came_back["find"]["id"]) == int(find["id"]), "the card's find is not the dearest")
	sim.came_back["firsts"] = []              # what the two runs read on the way (13 Oct: a P45 and a pawn ticket) is not the test's
	sim.came_back["more"] = 0
	for k in range(6):
		sim.chron("clear", {"site": "Test site %d" % k, "depth": 2 + k, "first": k == 0})
	_check(sim.came_back["firsts"].size() == sim.CAME_BACK_FIRSTS and int(sim.came_back["more"]) >= 2, "the firsts did not cap: %s" % str(sim.came_back["firsts"]))
	var lv0: int = sim.level()
	sim.came_back["lv_from"] = lv0
	while sim.level() < lv0 + 2:
		sim.xp += 50.0
	main.refresh()
	var card = main._missions._came
	var cbtn: Button = main._missions._came_btn
	# the tally's button at the zone row's right (12 Oct): the card stays up until it's pressed, then drops under it
	_check(cbtn.visible and not card.visible and cbtn.text.contains("2 runs"), "the tally's button did not show, or the card came up unasked: '%s'" % cbtn.text)
	var zr: Rect2 = Rect2(main._missions._title.position, main._missions._title.size)
	var gbtn: Button = main._missions._guide_btn
	_check(zr.end.x + 8 <= cbtn.position.x and cbtn.position.x + cbtn.size.x + 8 <= gbtn.position.x and gbtn.position.x + gbtn.size.x <= Pal.GRID_W + 0.5, "the row's title, the tally's button and the guide's run into each other")
	_check_fit(main, "Runs (the tally's button)")
	cbtn.pressed.emit()
	_check(card.visible, "the card did not show after two runs and a press")
	_check(card._head.text.begins_with("WHAT CAME BACK · 2 RUNS"), "the card's head reads '%s'" % card._head.text)
	_check(card._tiles[3]["value"].text.contains("→"), "the card's level does not read the climb: '%s'" % card._tiles[3]["value"].text)
	_check(card._cell.visible and card._find_name.text.begins_with(Items.full_name(find).get_slice(" ", 0)) and card._find_line.text.contains(Fmt.money(99999.0)), "the card's find is off: '%s' / '%s'" % [card._find_name.text, card._find_line.text])
	_check(card._firsts[card.FIRSTS - 1].text.begins_with("and ") and card._firsts.any(func(l): return l.text == "First clear: Test site 0"), "the card's firsts read: %s" % str(card._firsts.map(func(l): return l.text)))
	_check(Rect2(Vector2.ZERO, main._missions.size).encloses(Rect2(card.position, card.size)) and card.position.y >= main._missions.ZONE_H, "the card leaves the Runs screen or sits on the zone row")
	var c3: Dictionary = main._missions._cols[0]                 # the card, the right third (the drawn Map)
	for db in [c3["deploy"], c3["insure"]]:     # (the foot's Head button went: the card's own toggle takes him on, BUILD48 item 1)
		_check(not card.get_global_rect().intersects(db.get_global_rect()), "the card would cover the right-hand column's '%s' when it shows" % db.text)
	_check_fit(main, "Runs (what came back)")
	_came_back_buttons_clear(main, "the run from tier 1")
	# the endgame's figures in a quarter-width tile (the first smoke: £47,082 ran out of it)
	var hold_cb: Dictionary = sim.came_back.duplicate(true)
	sim.came_back["cash"] = 12345678.0
	sim.came_back["xp"] = 9876543.0
	sim.came_back["runs"] = 1234
	sim.came_back["deaths"] = 12
	main.refresh()
	_check_fit(main, "Runs (what came back, the endgame's figures)")
	sim.came_back = hold_cb
	main.refresh()
	# pressed again, it folds away and the tally stays
	cbtn.pressed.emit()
	_check(not card.visible and cbtn.visible and int(sim.came_back["runs"]) == 2, "the button did not fold the card away, or the tally went with it")
	cbtn.pressed.emit()
	# the save keeps it; Seen puts it away and starts again
	var d: Dictionary = JSON.parse_string(JSON.stringify(sim.to_dict()))
	sim.load_dict(d)
	_check(int(sim.came_back["runs"]) == 2 and int(sim.came_back["find"]["id"]) == int(find["id"]), "the save lost what came back")
	main.refresh()
	card._on_seen()
	main.refresh()
	_check(not card.visible and not cbtn.visible and int(sim.came_back["runs"]) == 0 and sim.came_back["firsts"].is_empty() and int(sim.came_back["lv_from"]) == sim.level(), "Seen did not put the card and its button away and start again")
	sim.load_dict(saved)
	main.refresh()
	print("what came back ok: the runs, the money, the find, the firsts capped, the level, the column, the buttons clear, the save, the move, Seen")


## No button on the Runs screen under the card: the column it sits over keeps its Set off, auto and insure clear.
func _came_back_buttons_clear(main, where: String) -> void:
	var card = main._missions._came
	var cr: Rect2 = card.get_global_rect()
	for c in main._missions._cols:
		for b in [c["deploy"], c["insure"]]:     # (the foot's Head button went, BUILD48 item 1)
			if _shown(b):                         # not is_visible_in_tree: the smoke's main is never in the tree (20 Oct)
				_check(not cr.intersects(b.get_global_rect()), "the card covers '%s' (%s)" % [b.text, where])
		if c["note"].text != "":
			_check(not cr.intersects(c["note"].get_global_rect()), "the card covers the column's note '%s' (%s)" % [c["note"].text, where])


## The rig on a run (11 Oct, Matt): the best grade of a gun's rounds fires first and the next takes over; rounds go
## from the rig into the pack (a better gun's rounds need the pouch); a med says what it heals, on the hover and in
## the pick, the heal is that figure, and the log says what it healed after the cap.
func _rig_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.equipped["Primary"] = sim._plain("Primary", "Stalking rifle")
	sim.equipped["Secondary"] = null
	sim.equipped["Rig"] = sim._plain("Rig", "Webbing")     # room for the two magazines and the med (31 Oct: the bot's run left a smaller rig on another seed's camp, the med off the grid); saved puts it back
	sim.rig.clear()
	var plain: Dictionary = _rmag(sim, "Rifle rounds")
	var depot: Dictionary = _rmag(sim, "Depot rounds")
	depot["rounds"] = 5
	sim.rig.append(plain)
	sim.rig.append(depot)
	var band: Dictionary = sim._plain(Data.MEDICAL, "Bandage")
	sim.rig.append(band)
	sim.stash = sim.stash.filter(func(x): return not Items.is_ammo(x) and not Items.is_mag(x))     # deploy tops the rig up from the stash: only these stacks (the fix round, 40-E: a stash's loaded Match magazine came in on other dice and fired before the plain one)
	_check(sim.feed_stack(sim.equipped["Primary"]) == depot and sim.grade_bonus(sim.equipped["Primary"]) == 25.0, "the Depot rounds behind the plain ones don't fire first")
	sim.hp = sim.max_hp()
	sim.deploy(3)
	sim.mission["target_hp"] = 1e9
	var p0: int = int(plain["rounds"])
	var g := 0
	while int(depot["rounds"]) > 0 and g < 120:
		sim.hp = sim.max_hp()
		sim.advance(1.0)
		g += 1
	_check(int(depot["rounds"]) == 0 and sim.rig.has(depot) and int(plain["rounds"]) <= p0, "the Depot rounds did not run out first (plain %d of %d)" % [int(plain["rounds"]), p0])     # a spent magazine stays in the rig (30 Oct)
	for k in range(15):                       # past the reload into the next magazine (30 Oct); up to 15 s, the reload's length on any dice (the fix round, 40-E: the dice found it at 5)
		sim.hp = sim.max_hp()
		sim.advance(1.0)
		if int(plain["rounds"]) < p0:
			break
	var diag: String = ("%s on, cleared %s, reload %s, fire_x %s, mag_in %s, refill %s, %s, skills %s" % [str(sim.mission["remaining"]), str(sim.mission["cleared"]), str(sim.mission.get("reload_t", {})),
		str(sim.mission.get("fire_x", {})), str(sim.mission.get("mag_in", {})), str(sim.mission.get("refill", {})), sim.cls, str(sim.skill_slots)]) if sim.on_mission() else "the run's over"
	_check(int(plain["rounds"]) < p0 and sim.feed_stack(sim.equipped["Primary"]) == plain, "the plain rounds did not take over when the Depot rounds ran out (%d of %d, feeding %s; %s)" % [int(plain["rounds"]), p0, str(sim.feed_stack(sim.equipped["Primary"]).get("base", "-")), diag])
	# into the pack, from the run screen
	main.show_room(main.MISSIONS)
	main.refresh()
	var run_ui = main._run
	var k: int = sim.rig.find(plain)
	run_ui._rig_pressed(k)
	main.refresh()
	_check(run_ui._rig_pick == int(plain["id"]) and run_ui._pick._buttons[0].visible and run_ui._pick._buttons[0].text == "Into the pack" and not run_ui._pick._buttons[0].disabled, "the rig's rounds don't offer Into the pack")
	_check_fit(main, "Run (rounds picked in the rig)")
	run_ui._pick._press(0)
	main.refresh()
	_check(not sim.rig.has(plain) and sim.mission["found"].has(plain) and run_ui._rig_pick == -1, "Into the pack did not move the rounds")
	_check(not sim.can_rig_to_pack(band["id"]), "a med can be stowed in the pack")
	# no room: the button says so
	var stack2: Dictionary = _rmag(sim, "Rifle rounds")
	sim.rig.push_front(stack2)
	while sim.pack_used(sim.mission) < sim.capacity():
		sim.mission["found"].append(sim._plain(Data.MEDICAL, "Bandage"))
	run_ui._rig_pressed(0)
	main.refresh()
	_check(not sim.can_rig_to_pack(stack2["id"]) and run_ui._pick._buttons[0].disabled, "Into the pack is offered into a full pack")
	_check_fit(main, "Run (rounds picked, the pack full)")
	run_ui._rig_pressed(0)                   # a second tap lets go
	main.refresh()
	_check(run_ui._rig_pick == -1, "a second tap on the rounds did not let go")
	# a med in the pack says what it heals in the pick
	var spare: Dictionary = sim.mission["found"][sim.mission["found"].size() - 1]
	var kk: int = run_ui._inv.cell_of(spare["id"])
	if kk >= 0:
		run_ui._inv._pick(kk)
		main.refresh()
		_check(run_ui._pick._right_lines.any(func(l): return l.text.contains(sim.med_words(spare))), "the pack's med does not say what it heals")
		_check_fit(main, "Run (a med picked in the pack)")
		run_ui._inv.selected = -1
		main.refresh()
	# the med: the hover, the pick, the heal, the log
	var cell = null
	for c in run_ui._rig_cells:
		if c.visible and c.id == int(band["id"]):
			cell = c
	var words: String = sim.med_words(band)
	_check(words.begins_with("+%d HP" % int(round(sim.med_heal(band)))) and cell != null and cell.tooltip_text.contains(words), "the med's hover does not say what it heals: '%s'" % (cell.tooltip_text if cell != null else "no cell"))
	sim.hp = maxf(1.0, sim.max_hp() - sim.med_heal(band) - 20.0)
	var hp0: float = sim.hp
	sim.mission["target_hp"] = 1e9
	sim.mission["remaining"] = 0
	_check(sim.use_med(band["id"]), "the bandage would not use")
	var g2 := 0
	while sim.mission != null and sim.mission["using"] != null and g2 < 30:
		sim.advance(0.5)
		g2 += 1
	var line: String = ""
	for ev in sim.events:
		if str(ev[1]).begins_with("Bandage used: +"):
			line = str(ev[1])
	_check(line != "" and line.contains("+%d HP" % int(round(sim.med_heal(band)))), "the log does not say what the bandage healed: '%s' (HP %d to %d)" % [line, int(hp0), int(sim.hp)])
	sim.extract_now()
	# rounds moved to the pack come home to the rig (or the stash), not as loot, even with the stash full
	sim.hp = sim.max_hp()
	sim.rig.clear()
	var mine: Dictionary = _rmag(sim, "Rifle rounds")
	sim.rig.append(mine)
	while sim.stash_room(1):
		sim.stash.append(sim._plain("Helmet", "Cycle helmet"))
	sim.deploy(3)
	sim.mission["found"] = []
	_check(sim.rig_to_pack(mine["id"]), "the rounds would not go into the pack")
	sim.extract_now()
	_check(sim.rig.any(func(x): return int(x["id"]) == int(mine["id"])) and int(sim.last_report["loot"]) == 0, "the runner's rounds did not come home to the rig, or counted as loot (loot %d)" % int(sim.last_report["loot"]))
	_check(not mine.has("from_rig"), "the rounds came home still marked as the rig's")
	sim.load_dict(saved)
	main.refresh()
	print("rig ok: the best grade first and the next after, into the pack and its room, home to the rig, the med's hover, its heal and the log")


## Three calls of Matt's (11 Oct): a build's own element's rounds fire before a dearer grade; nothing reads as better
## than a worn unique without a clear margin; a gun with no rounds in the rig says so under its verdict.
func _build_rounds_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.equipped["Primary"] = sim._plain("Primary", "Stalking rifle")
	sim.rig.clear()
	var depot: Dictionary = _rmag(sim, "Depot rounds")
	var salted: Dictionary = _rmag(sim, "Salted rounds")
	sim.rig.append(depot)
	sim.rig.append(salted)
	sim.tree = []
	_check(sim.feed_stack(sim.equipped["Primary"]) == depot, "with no element trained the dearest grade does not fire first")
	sim.tree.append("The cold/0")
	_check(sim.build_elements().has("frost") and sim.feed_stack(sim.equipped["Primary"]) == salted, "a frost build does not fire its salted rounds before Depot: %s" % str(sim.build_elements()))
	sim.tree = []
	_check(sim.feed_stack(sim.equipped["Primary"]) == depot, "the frost rounds still fire first with the tree gone")
	# a respec to the same count is another build (the review): fire then frost, one node each
	sim.tree = ["Petrol/0"]
	sim.feed_stack(sim.equipped["Primary"])
	sim.tree = ["The cold/0"]
	_check(sim.feed_stack(sim.equipped["Primary"]) == salted, "a respec from fire to frost at the same count left the fire build's rounds order")
	# the secondary's grade is damage only: no element first for it. A fire build with SMGs both hands: the primary
	# fires the incendiary rounds first, the machine pistol behind it the belt links (dearer, damage only)
	sim.tree = ["Petrol/0"]
	sim.equipped["Primary"] = sim._plain("Primary", "Workshop SMG")
	sim.equipped["Secondary"] = sim._plain("Secondary", "Machine pistol")
	var belt: Dictionary = _rmag(sim, "Belt links")
	var fire: Dictionary = _rmag(sim, "Incendiary SMG rounds")
	sim.rig.append(belt)
	sim.rig.append(fire)
	_check(sim.feed_stack(sim.equipped["Primary"]) == fire and sim.feed_stack(sim.equipped["Secondary"]) == belt, "the primary and secondary don't each fire their own best: %s / %s" % [sim.feed_stack(sim.equipped["Primary"]).get("base", ""), sim.feed_stack(sim.equipped["Secondary"]).get("base", "")])
	sim.equipped["Secondary"] = null
	sim.equipped["Primary"] = sim._plain("Primary", "Stalking rifle")
	sim.tree = []
	# a worn unique gun is judged on the runner's damage like anything else: a pistol that beats the Van's Spare with
	# it on is the upgrade (a margin held the bot to it all game, the 11 Oct read)
	var vans: Dictionary = Items.roll_unique(sim._unique_named("The Van's Spare"), sim.rng)
	sim.equipped["Secondary"] = vans
	var pct := 0.0
	var found := false
	while pct < 400.0:
		var mp: Dictionary = sim._plain("Secondary", "Machine pistol")
		mp["affixes"] = [{"stat": "damage_pct", "value": pct, "tier": 3}]
		if sim.upgrade_gain(mp) > 0.02:
			found = true
			_check(sim.compare(mp) == 1, "a pistol %.0f%% better on the runner's damage does not read better than a worn Van's Spare" % (sim.upgrade_gain(mp) * 100.0))
			break
		pct += 5.0
	_check(found, "no pistol up to 400 per cent damage beat the Van's Spare: the case doesn't stand")
	# a gun with no rounds in the rig says so
	sim.equipped["Secondary"] = null
	sim.rig.clear()
	while not sim.stash_room(12) and not sim.stash.is_empty():
		sim.sell(sim.stash[0])
	var smg: Dictionary = sim._plain("Primary", "Workshop SMG")
	sim.stash_put(smg)
	main.show_room(main.ARMOURY)
	main._armoury.selected = {"kind": "stash", "id": smg["id"]}
	main._armoury._shown = ""
	main.refresh()
	var smg_words: String = main._armoury._pick._words.text
	_check((main._armoury._pick.hint_text().begins_with("No rounds") or main._armoury._pick.hint_text().begins_with("No magazine")) and smg_words != "" and Words.item_words("Workshop SMG").begins_with(smg_words), "a gun with no rounds in the rig does not say so, or lost its own line: '%s' / '%s'" % [main._armoury._pick.hint_text(), main._armoury._pick._words.text])
	# and over an empty slot, where it matters most
	sim.equipped["Primary"] = null
	main._armoury._shown = ""
	main.refresh()
	_check(main._armoury._pick.hint_text().begins_with("No rounds") or main._armoury._pick.hint_text().begins_with("No magazine"), "a gun for an empty slot with no rounds does not say so: '%s'" % main._armoury._pick.hint_text())
	_check_fit(main, "Lock-up (a gun with no rounds, nothing fitted)")
	# both hints at once, on the run screen where the pick has Equip and Ditch beside it
	sim.equipped["Primary"] = sim._plain("Primary", "Stalking rifle")
	sim.rig = [_rmag(sim, "Rifle rounds")]       # rounds for the rifle, none for the SMG
	sim.hp = sim.max_hp()
	sim.deploy(3)
	sim.mission["target_hp"] = 1e9
	var big: Dictionary = sim._plain("Primary", "Workshop SMG")
	sim.mission["found"] = [big]
	while sim.pack_used(sim.mission) < sim.capacity():
		sim.mission["found"].append(sim._plain(Data.MEDICAL, "Bandage"))
	main.show_room(main.MISSIONS)
	main.refresh()
	main._run._inv._pick(main._run._inv.cell_of(big["id"]))
	main.refresh()
	var hw: String = main._run._pick.hint_text()
	_check((hw.begins_with("No rounds") or hw.begins_with("No magazine")) and hw.contains("to the floor") and not hw.contains("No room"), "the run's pick does not carry both hints (1 Nov: what comes off goes down): '%s'" % hw)
	_check_fit(main, "Run (no rounds and no room)")
	sim.extract_now()
	# a charm over a worn unique charm is never the upgrade (its rule is beyond the charm's score)
	var keys: Dictionary = Items.roll_unique(sim._unique_named("The Van Keys"), sim.rng)
	sim.equipped["Charm"] = keys
	var plain_charm: Dictionary = sim._plain("Charm", "Dog tag")
	plain_charm["rarity"] = 3
	plain_charm["affixes"] = [{"stat": "loot_pct", "value": 60.0, "tier": 5}]
	_check(sim.compare(plain_charm) != 1, "a plain charm reads better than the worn Van Keys")
	_check_fit(main, "Lock-up (a gun with no rounds)")
	sim.load_dict(saved)
	main._armoury.selected = {}
	main.refresh()
	print("build rounds ok: the build's element first, a worn unique gun judged like any other, no rounds said")


## The bar's skull (11 Oct, Matt): shown when what the dots still have to take off covers the HP left, on their bar
## and on yours; gone when it doesn't. Shown only - the fight goes on as it would.
func _skull_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.hp = sim.max_hp()
	sim.deploy(3)
	var m: Dictionary = sim.mission
	main.show_room(main.MISSIONS)
	m["target_hp"] = 100.0
	m["dots"] = {"poison": 40.0}
	main.refresh()
	var run_ui = main._run
	_check(not run_ui._fight["skull"].visible, "the skull shows with the dots short of the HP left")
	m["dots"] = {"poison": 70.0, "fire": 40.0}
	main.refresh()
	_check(run_ui._fight["skull"].visible, "no skull with the dots covering the HP left (110 against 100)")
	var hp_before: float = m["target_hp"]
	_check(is_equal_approx(hp_before, 100.0), "the skull changed the fight")
	m["my_dots"] = {"bleed": sim.hp + sim.guard() + 10.0}     # the dots come off Guard first: a kit with Guard outlasted hp + 10 (19 Oct, the flaky check)
	main.refresh()
	_check(run_ui._runner["skull"].visible, "no skull on your own bar with a bleed that will have you (HP %.0f, Guard %.0f, bleed %.0f)" % [sim.hp, sim.guard(), float(m["my_dots"]["bleed"])])
	m["my_dots"] = {}
	main.refresh()
	_check(not run_ui._runner["skull"].visible, "the skull stayed on your bar with nothing on you")
	_check(run_ui.dots_finish(50.0, {"bleed": 50.0}) and not run_ui.dots_finish(0.0, {"bleed": 5.0}) and not run_ui.dots_finish(50.0, {}), "dots_finish reads wrong")
	sim.extract_now()
	sim.load_dict(saved)
	main.refresh()
	print("skull ok: on their bar and yours when the dots cover what's left, gone when they don't")


## The web (22 Oct, docs/design/web.md, slice 1): every tree a region on one canvas - each node placed, none on
## another, the links between neighbours; the camera pans and zooms about the pointer; a click picks the node under it
## and the panel shows it; the corner's buttons jump the zoom; the whole web fits at its widest.
func _web_checks(main) -> void:
	var sim = main.sim
	var bk = main._barracks
	var wv = bk.web()
	main.show_room(main.BARRACKS)
	main.refresh()
	# the skill web (3 Nov, docs/design/skill_web.md; BUILD47): the canvas left under the band, the card's column right
	_check(wv != null and wv.visible and wv.position == Vector2(0, bk.LANES_Y) and wv.size == Vector2(bk.WEB_W, bk.LANES_H), "the web is not in its place: %s %s" % [str(wv.position), str(wv.size)])
	_check(bk.SIDE_X >= wv.size.x and bk.SIDE_X + bk.SIDE_W <= Pal.GRID_W and bk.ALSO_Y >= bk.LANES_Y + bk.LANES_H and bk.ALSO_Y + bk.ALSO_H <= Pal.ROOM_H and bk.BIG_Y + bk.BIG_H <= bk.CODE_Y and bk.RESET_Y + bk.BTN_H <= Pal.ROOM_H, "the Training screen's parts overlap or run out of the room")
	# every node at the sim's place, the ring's thirty round the outside, no two on each other
	var ids: Array = Data.web_ids()
	var off_place: Array = ids.filter(func(id): return not wv.layout.has(id) or wv.layout[id].distance_to(Data.web_at(str(id))) > 0.01)
	_check(ids.size() > 1500 and off_place.is_empty() and wv.layout.size() == ids.size() + Data.RING["nodes"].size(), "the web's nodes aren't at the sim's places: %d of %d off, %d laid" % [off_place.size(), ids.size(), wv.layout.size()])
	var overlaps: Array = _web_overlaps(wv)      # bucketed (BUILD49 V: 1,579 nodes)
	for ov in overlaps.slice(0, 3):
		_check(false, "%s sit on each other" % ov)
	_check(overlaps.is_empty(), "%d pairs of nodes overlap on the web" % overlaps.size())
	# the links: every web link drawn (the sim's, both ways), none through a node not its own
	var n_links := 0
	for id in ids:
		for o in Data.web_links(str(id)):
			n_links += 1
			_check(wv.links_all().get(id, []).has(o), "the web doesn't draw the link %s-%s" % [id, o])
	_check(n_links > 4000, "only %d link ends on the web" % n_links)
	var through := 0
	var cv_links: Dictionary = wv.links_all()
	for la in cv_links:
		for lb in cv_links[la]:
			if str(la) > str(lb):
				continue
			if wv._blockers(wv.link_path(str(la), str(lb)), str(la), str(lb)) > wv.BEND_CLEAR - 2.0:
				through += 1
				if through <= 3:
					_check(false, "the link %s-%s runs through a node" % [la, lb])
	_check(through == 0, "%d links run through a node not theirs" % through)
	# the twelve names (the six classes', the six elements') and the ring's: placed for the whole web, each on no node and
	# no other name, near its region's point, and on the canvas there; closer in, still on no node
	var keys: Array = wv._axis.keys()
	_check(keys.size() == Data.CLASSES.size() + Data.ELEMENT_TREES.size() + 2 and keys.has("centre") and keys.has("ring"), "the web names %d regions, not the six classes, six elements, the centre and the ring: %s" % [keys.size(), str(keys)])
	for cd in Data.CLASSES:
		_check(wv._axis.has("class:" + str(cd["name"])) and wv.region_words("class:" + str(cd["name"])) == str(cd["name"]), "%s's name isn't on the web" % cd["name"])
	for et in Data.ELEMENT_TREES:
		var ek: String = "el:" + str(et["name"])
		_check(wv._axis.has(ek) and wv.region_words(ek) == wv.plain_name(str(et["name"])) and not wv.region_words(ek).begins_with("The "), "%s's name isn't on the web, or reads '%s'" % [et["name"], wv.region_words(ek)])
	for k_i in range(keys.size()):
		var ax: Dictionary = wv._axis[keys[k_i]]
		var bx: Rect2 = ax.get("label_box", Rect2())
		_check(ax.has("label_box") and bx.get_center().distance_to(ax["anchor"]) <= wv.label_near(str(keys[k_i])), "%s's name isn't by its region: %s from %s" % [keys[k_i], str(bx), str(ax.get("anchor"))])
		for id in wv.layout:
			if bx.grow(wv.radius_of(wv.node_of(id))).has_point(wv.layout[id]):
				_check(false, "%s's name covers the node %s" % [keys[k_i], id])
		for o_i in range(k_i + 1, keys.size()):
			_check(not bx.intersects(wv._axis[keys[o_i]].get("label_box", Rect2())), "%s's name sits on %s's" % [keys[k_i], keys[o_i]])
	var zoom_held: float = wv.zoom
	var cam_held: Vector2 = wv.cam
	wv.focus_all()
	var z_all: float = wv.zoom
	_check(is_equal_approx(z_all, wv.fit_zoom()) and is_equal_approx(wv.zoom_min, z_all), "the whole web's zoom (%.3f) isn't the names' (%.3f), or the web zooms out past it (%.3f)" % [z_all, wv.fit_zoom(), wv.zoom_min])
	var canvas := Rect2(Vector2.ZERO, wv.size)
	for k in keys:
		_check(canvas.encloses(wv.label_rect(k)), "%s's name runs off the canvas at the whole web: %s" % [k, str(wv.label_rect(k))])
	for zl in [z_all, 1.0, 2.0]:
		wv.zoom = zl
		for k in keys:
			var lr: Rect2 = wv.label_rect(k)
			for id in wv.layout:
				if lr.grow(wv.radius_of(wv.node_of(id)) * zl).has_point(wv.to_screen(wv.layout[id])):
					_check(false, "at zoom %.2f %s's name covers %s" % [zl, k, id])
	wv.focus_all()
	for id in wv.layout:
		var p: Vector2 = wv.to_screen(wv.layout[id])
		_check(canvas.has_point(p), "%s is off the canvas at the whole web's zoom: %s" % [id, str(p)])
	# the frame's calls (23 Oct, Matt's fans): under BATCH_MAX at the whole web and close in; every node drawn at the
	# whole web; every picture packed
	var n_all: int = wv.count_batches()
	_check(wv.nodes_drawn == wv.layout.size(), "the whole web drew %d nodes of %d" % [wv.nodes_drawn, wv.layout.size()])
	wv.zoom = 2.4
	var n_close: int = wv.count_batches()
	_check(n_all > 2 and n_all <= wv.BATCH_MAX and n_close > 2 and n_close <= wv.BATCH_MAX, "a frame takes %d calls at the whole web, %d close in (BATCH_MAX %d)" % [n_all, n_close, wv.BATCH_MAX])
	_check(wv.atlas_misses == 0, "%d of the web's pictures didn't pack into the atlas" % wv.atlas_misses)
	wv.zoom = zoom_held
	wv.cam = cam_held
	# the colours: a dark element link in its colour, faint; a dark class link in its track's colour, faint, where both
	# ends share a track, else grey; a class node its track's colour (BUILD49 V), an element's its own, the centre amber
	var el_links := 0
	var cl_links := 0
	for la in cv_links:
		for lb in cv_links[la]:
			if wv.state_of(la).get("taken", false) or wv.state_of(lb).get("taken", false) or wv.state_of(la).get("reach", false) or wv.state_of(lb).get("reach", false):
				continue
			var lc: Color = wv.link_colour(str(la), str(lb))
			var ra: String = str(wv._region.get(la, ""))
			if ra.begins_with("el:") and wv._region.get(lb, "") == ra:
				el_links += 1
				_check(lc.is_equal_approx(Color(wv.element_tone(ra.substr(3)), wv.ELEMENT_LINK_DIM)), "%s-%s in %s isn't in its colour: %s" % [la, lb, ra, lc])
			elif ra.begins_with("class:") and wv._region.get(lb, "") == ra:
				cl_links += 1
				var ta: String = Data.web_theme(str(la))
				var want_l: Color = Color(wv.TRACK_TONES[ta], wv.TRACK_LINK_DIM) if ta == Data.web_theme(str(lb)) and wv.TRACK_TONES.has(ta) else wv.LINK_CLASS_DIM
				_check(lc.is_equal_approx(want_l), "the class link %s-%s (%s-%s) isn't in its track's colour: %s" % [la, lb, ta, Data.web_theme(str(lb)), lc])
	_check(el_links > 20 and cl_links > 20, "the link colours checked too few links: %d element, %d class" % [el_links, cl_links])
	for id in ids:
		var rg: String = str(wv._region.get(id, ""))
		var want: Color = wv.PITCH_TONE if rg == "centre" else (wv.element_tone(rg.substr(3)) if rg.begins_with("el:") else (wv.element_tone(wv.join_element(str(id))) if rg == "join" else wv.TRACK_TONES.get(Data.web_theme(str(id)), Pal.TEXT)))
		_check(wv.tone_of(str(id)) == want and (rg != "join" or wv.join_element(str(id)) != ""), "%s (%s) isn't in its region's colour" % [id, rg])
	# the camera: a zoom about a point keeps the web under it; a right-drag pans by the drag; a drag let go off the canvas
	# stops
	var at := Vector2(300.0, 200.0)
	var under: Vector2 = wv.to_web(at)
	wv.zoom_at(at, 1.3)
	_check(wv.to_web(at).distance_to(under) < 0.5, "a zoom about a point moved the web under it")
	var cam0: Vector2 = wv.cam
	var press := InputEventMouseButton.new()
	press.button_index = MOUSE_BUTTON_RIGHT
	press.pressed = true
	press.position = Vector2(400.0, 300.0)
	wv._gui_input(press)
	var move := InputEventMouseMotion.new()
	move.position = Vector2(460.0, 320.0)
	move.button_mask = MOUSE_BUTTON_MASK_RIGHT
	wv._gui_input(move)
	var lift := InputEventMouseButton.new()
	lift.button_index = MOUSE_BUTTON_RIGHT
	lift.pressed = false
	lift.position = move.position
	wv._gui_input(lift)
	_check((cam0 - wv.cam).distance_to(Vector2(60.0, 20.0) / wv.zoom) < 0.5, "a right-drag did not pan by the drag: %s" % str(cam0 - wv.cam))
	wv._gui_input(press)
	var cam1: Vector2 = wv.cam
	var loose := InputEventMouseMotion.new()
	loose.position = Vector2(500.0, 340.0)
	loose.button_mask = 0
	wv._gui_input(loose)
	_check(wv.cam == cam1 and not wv._drag, "a drag released off the canvas kept panning")
	wv.focus_all()
	wv.zoom_at(Vector2(200, 200), 0.5)
	_check(is_equal_approx(wv.zoom, z_all), "the web zoomed out past the whole web: %.3f" % wv.zoom)
	# a click on a node picks it, the card names it; a click on nothing clears the pick
	if sim.cls != "":
		var sid: String = Data.web_start(sim.cls)
		wv.centre_on(sid)
		var p0: Vector2 = wv.to_screen(wv.layout[sid])
		_check(wv.node_at(p0) == sid, "the node under the pointer isn't found: %s" % wv.node_at(p0))
		var click := InputEventMouseButton.new()
		click.button_index = MOUSE_BUTTON_LEFT
		click.pressed = true
		click.position = p0
		wv._gui_input(click)
		main.refresh()
		_check(bk.selected == sid and bk._title.text == str(sim.node(sid)["name"]), "a click on the web did not pick the node: '%s'" % bk._title.text)
		_check_fit(main, "Training (a node picked on the web)")
		wv.focus_all()
		var far := Vector2(4.0, wv.size.y / 2.0)
		if wv.node_at(far) == "":
			click.position = far
			wv._gui_input(click)
			main.refresh()
			_check(bk.selected == "", "a click on nothing did not clear the pick")
	# the tabs: the whole web, the runner's corner, the Paragon board (BUILD49 V); no Pitch tab
	_check(bk._web_buttons.size() == 3 and bk._web_buttons[0].text == Words.WEB_SCREEN["whole"] and bk._web_buttons[2].text == Words.WEB_SCREEN2["paragon"] and not bk._web_buttons.any(func(b): return b.text.contains("Pitch")), "the web's tabs read %s" % str(bk._web_buttons.map(func(b): return b.text)))
	_check_fit(main, "Training (the web)")


## The Training screen for the skill web (BUILD47 V, 3 Nov; docs/design/skill_web.md "The screen", the canvas's
## sw_final6): a Poacher with a few nodes - the web's three states as the sim's, the card's button live only when
## web_can_take is "" (else its reason), "Yours" on one owned; the band's one counter; the pairs and the big nodes; the
## corner tab framing the class and its two elements; the reset; and every label fitting, the longest names in the card.
func _web47_checks(main) -> void:
	_web_checks(main)
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	if sim.on_mission():
		sim.extract_now()
	var bk = main._barracks
	var wv = bk.web()
	var WS: Dictionary = Words.WEB_SCREEN
	_set_cls(sim, "Poacher")
	var start: String = Data.web_start("Poacher")
	var gates_were: bool = sim.core_gates
	sim.core_gates = true                     # the big nodes' gates on (an earlier area may have turned them off)
	sim.tree = [start]
	sim.ring = {}
	sim.training_points = 4
	sim.rewards_earned = {}                   # the camp's reward points aside (BUILD50-T: the bot's camp earned one)
	sim._caches_out()
	# the fixture: four nodes out from the start toward the Rat bait (the Poacher's left pair's half)
	var pairs: Array = sim.web_pairs()
	_check(pairs.size() == 2, "the Poacher has %d pairs, not two" % pairs.size())
	var rat_bait: String = str(pairs[0]["halves"][0]) if not pairs.is_empty() else ""
	var path: Array = sim.web_path(rat_bait) if rat_bait != "" else []
	for id in path.slice(0, 4):
		sim.web_take(str(id))
	_check(sim.web_spent() == 4 and sim.web_free() == 0, "the fixture didn't spend its four points: %d spent, %d free" % [sim.web_spent(), sim.web_free()])
	main.show_room(main.BARRACKS)
	bk.selected = ""
	bk._shown = ""
	main.refresh()
	# the three states, as the sim's: owned lit, the frontier (joined and gated, points or not) ringed, the rest dark
	var frontier: Array = sim.web_frontier(true)
	var n_own := 0
	var n_reach := 0
	var wrong: Array = []
	for id in Data.web_ids():
		var st: Dictionary = wv.state_of(str(id))
		var own: bool = sim.web_owned(str(id))
		var reach: bool = frontier.has(id) and not own
		n_own += 1 if own else 0
		n_reach += 1 if reach else 0
		if bool(st.get("taken", false)) != own or bool(st.get("reach", false)) != reach:
			wrong.append(id)
	_check(n_own == 5 and n_reach >= 3 and wrong.is_empty(), "the web's states aren't the sim's: %d owned, %d can take, wrong on %s" % [n_own, n_reach, str(wrong.slice(0, 4))])
	var lit_link := false
	for a in path.slice(0, 3):
		for b in Data.web_links(str(a)):
			if sim.web_owned(str(b)):
				lit_link = true
				_check(wv.link_colour(str(a), str(b)) == wv.tone_of(wv.link_key(str(a), str(b))) and wv.link_key(str(a), str(b)) == (str(a) if wv.tinted(str(a)) else (str(b) if wv.tinted(str(b)) else (str(b) if Data.web_theme(str(a)) == "start" else str(a)))),
					"the owned link %s-%s isn't lit in its region's or its track's colour" % [a, b])
	_check(lit_link, "the fixture lit no link")
	# the band's one counter: no points free, four of four spent
	_check(bk._points.text == WS["free"] % 0 and bk._unit.text == UI.dots(Words.WEB_SCREEN2["spent"] % [4, sim.web_points()]) and bk._unit2.text == UI.dots(Words.WEB_SCREEN2["from"] % "Poacher"), "the band reads '%s' '%s' '%s'" % [bk._points.text, bk._unit.text, bk._unit2.text])
	# the card: a frontier node with none free says why; with a point it's live and takes; an owned one is Yours; a dark
	# one says why
	var fr_id: String = str(frontier.filter(func(x): return not sim.web_owned(str(x)))[0]) if n_reach > 0 else ""
	bk._pick(fr_id)
	main.refresh()
	_check(bk._train.visible and bk._train.disabled and bk._train.text == sim.web_can_take(fr_id) and sim.web_can_take(fr_id) != "", "a frontier node with no points free: '%s' (%s)" % [bk._train.text, sim.web_can_take(fr_id)])
	sim.training_points = 5
	bk._shown = ""
	main.refresh()
	_check(bk._points.text == WS["free_one"] % 1 and sim.web_can_take(fr_id) == "" and bk._train.text == WS["take"] and not bk._train.disabled, "a frontier node with a point free: '%s' disabled %s, the band '%s'" % [bk._train.text, str(bk._train.disabled), bk._points.text])
	_check(bk._title.text == str(sim.node(fr_id).get("name", bk._title.text)) and bk._where.text != "" and bk._icon_ring.get_theme_stylebox("panel").border_color == wv.FRONTIER, "the card doesn't name the frontier node: '%s' '%s'" % [bk._title.text, bk._where.text])
	_check_fit(main, "Training (a node to take)")
	bk._on_train()
	_check(sim.web_owned(fr_id) and sim.web_free() == 0 and wv.state_of(fr_id).get("taken", false) and bk._train.text == WS["yours"] and bk._train.disabled, "Take it didn't take: owned %s, '%s'" % [str(sim.web_owned(fr_id)), bk._train.text])
	var dark := ""
	for id in Data.web_ids():
		if dark == "" and not sim.web_owned(str(id)) and not sim.web_frontier(true).has(id) and Data.web_kind(str(id)) == "notable":
			dark = str(id)
	bk._pick(dark)
	main.refresh()
	_check(dark != "" and bk._train.disabled and bk._train.text == sim.web_can_take(dark) and bk._train.text == Words.WEB_BLOCK["joined"], "a dark node's button: '%s' (%s)" % [bk._train.text, sim.web_can_take(dark)])
	# a keystone next to one owned, under 15 spent: its gate's words; the big nodes say how far
	var ks := ""
	for id in Data.web_ids():
		if ks == "" and Data.web_kind(str(id)) == "keystone" and str(Data.web_region(str(id))) == "class:Poacher":
			ks = str(id)
	var ks_path: Array = sim.web_path(ks)
	sim.training_points = sim.web_spent() + ks_path.size()
	for id in ks_path.slice(0, ks_path.size() - 1):
		sim.web_take(str(id))
	bk._pick(ks)
	main.refresh()
	var spent: int = sim.web_spent()
	_check(spent < Data.KEYSTONE_SPENT and bk._train.disabled and bk._train.text == Words.WEB_BLOCK["keystone"] % Data.KEYSTONE_SPENT, "a keystone under %d spent: '%s' at %d" % [Data.KEYSTONE_SPENT, bk._train.text, spent])
	_check(bk._big_lines[0].text == WS["keys_to_go"] % [Data.KEYSTONE_SPENT, Data.KEYSTONE_SPENT - spent] and bk._big_lines[1].text == WS["caps_to_go"] % [Data.CAPSTONE_SPENT, Data.CAPSTONE_SPENT - spent], "the big nodes read '%s' / '%s'" % [bk._big_lines[0].text, bk._big_lines[1].text])
	_check(is_equal_approx(bk._big_fill.size.x, bk._big_bar.size.x * spent / float(Data.CAPSTONE_SPENT)), "the big nodes' bar isn't at %d of %d" % [spent, Data.CAPSTONE_SPENT])
	_check(bk._where.text == UI.dots(bk.where_words(ks)) and bk._where.text.begins_with("The Poacher · ") and bk._where.text.ends_with(UI.dots(" · " + WS["keystone"])), "the keystone's place reads '%s'" % bk._where.text)
	# the pairs: one done (both halves owned), one away
	for h in pairs[0]["halves"]:
		if not sim.tree.has(h):
			sim.tree.append(h)
	sim._caches_out()
	bk._shown = ""
	main.refresh()
	var row0: Dictionary = bk._pair_rows[0]
	var row1: Dictionary = bk._pair_rows[1]
	var a0: String = str(sim.node(str(pairs[0]["halves"][0]))["name"])
	var line0: String = " ".join(row0["lines"].map(func(l): return l.text)).strip_edges()
	var line1: String = " ".join(row1["lines"].map(func(l): return l.text)).strip_edges()
	_check(row0["dot"].get_theme_stylebox("panel").bg_color == Pal.GOOD and line0.begins_with(a0 + " + ") and row1["dot"].get_theme_stylebox("panel").bg_color == Pal.CARD_LINE and line1.contains(" away"), "the pairs read '%s' / '%s'" % [line0, line1])
	_check(bk.sum_items_raw().any(func(it): return str(it.get("tag", "")) == "Pairs" and str(it["forms"][0]) == "1 of 2") and not bk.sum_items_raw().any(func(it): return str(it.get("tag", "")) == "Joints"), "the band's chips don't count the pairs: %s" % str(bk.sum_items_raw().map(func(it): return it.get("tag", ""))))
	# the corner tab: the Poacher's four flowers and its two elements fill the canvas, closer than the whole web
	bk._lay_tabs()
	_check(bk._web_buttons[1].text == WS["corner"] % "Poacher" and UI.text_width(bk._web_buttons[1], bk._web_buttons[1].text) + 32 <= bk._web_buttons[1].size.x and bk._find.position.x >= bk._web_buttons[1].position.x + bk._web_buttons[1].size.x, "the corner tab reads '%s' or the find box sits on it" % bk._web_buttons[1].text)
	var regs: Array = wv.corner_regions("Poacher")
	_check(regs.size() == 3 and regs.has("class:Poacher") and regs.has("el:The cold") and regs.has("el:The Rat Man"), "the Poacher's corner is %s" % str(regs))
	bk._web_buttons[1].pressed.emit()
	var z_corner: float = wv.zoom
	var outside := 0
	for id in Data.web_ids():
		if str(wv._region.get(id, "")) in regs and not wv.framed_rect().grow(0.5).has_point(wv.to_screen(wv.layout[id])):
			outside += 1
	_check(outside == 0 and z_corner > wv.fit_zoom() * 1.3, "the corner tab leaves %d of its nodes off the canvas, zoom %.2f" % [outside, z_corner])
	bk._web_buttons[0].pressed.emit()
	_check(is_equal_approx(wv.zoom, wv.fit_zoom()), "Whole web did not go back to the whole web")
	# the reset: the web's, its price; live with points spent and the tins for it
	bk._pick("")
	sim.cash = maxf(sim.cash, float(sim.respec_cost()) + 10.0)
	bk._shown = ""
	main.refresh()
	_check(bk._respec.text == WS["reset"] % Fmt.money(sim.respec_cost()) and not bk._respec.disabled, "the reset reads '%s' (disabled %s)" % [bk._respec.text, str(bk._respec.disabled)])
	# the longest names in the card, the pairs and the band; every node's sentence and place over the card's lines; the
	# key; no retired words on the screen
	var longest := ""
	var long_w := 0.0
	var long_where := ""
	var where_w := 0.0
	var unfit: Array = []
	for id in Data.web_ids():
		var nd: Dictionary = sim.node(str(id))
		var w: float = UI.text_width(bk._title, str(nd.get("name", "")))
		if w > long_w:
			long_w = w
			longest = str(id)
		var ww: float = UI.text_width(bk._where, bk.where_words(str(id)))
		if ww > where_w:
			where_w = ww
			long_where = str(id)
		var s: String = bk._sentence(nd)
		bk.fit_lines([s])
		if (bk._words.text + " " + bk._words2.text + " " + bk._words3.text).strip_edges() != s.strip_edges() or UI.text_width(bk._words3, bk._words3.text) > bk._words3.size.x:
			unfit.append(str(nd.get("name", id)))
	_check(unfit.is_empty(), "%d nodes' words don't fit the card's three lines: %s" % [unfit.size(), str(unfit.slice(0, 4))])
	for id in [longest, long_where]:
		bk._pick(id)
		main.refresh()
		_check_fit(main, "Training (the card: %s)" % sim.node(id).get("name", id))
	for cls in ["Paramedic", "Scrapper", "Drifter", "Doorman", "Recruit"]:
		_set_cls(sim, cls)
		sim.tree = [Data.web_start(cls)]
		sim._caches_out()
		bk._pick("")
		main.refresh()
		bk._web_buttons[1].pressed.emit()
		_check(wv.corner_regions(cls).size() == 3, "%s's corner is %s" % [cls, str(wv.corner_regions(cls))])
		_check_fit(main, "Training (the %s's band, pairs and tabs)" % cls)
	_check(bk._key.fit_fails().is_empty(), "the web's key doesn't fit: %s" % str(bk._key.fit_fails()))
	var said: Array = bk.text_nodes().filter(func(n): return n.visible).map(func(n): return str(n.text))
	for w in ["Pitch point", "the Yard", "joint", "Joint", "The Pitch", "key says where"]:
		_check(not said.any(func(t): return t.contains(w)), "the Training screen still says '%s'" % w)
	sim.load_dict(saved)
	sim.core_gates = gates_were
	bk.selected = ""
	bk._shown = ""
	main.refresh()
	print("the skill web's screen ok: %d nodes, the states, the card, the counter, the pairs, the corner" % Data.web_ids().size())

## Merge 47's fix round (3 Nov, the review of build 47): another class's start and skills refused as "<Class> only"
## and never pathed through; a pasted code held to the rule and read in any order; a loaded tree made legal (and the
## b45 fixtures grown on the new web); the two big-node lines alike; the ring's entries at the classes' angles; the
## picked node's name clear of the nodes; Training's card says the web is the runner's own.
func _m47_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	if sim.on_mission():
		sim.extract_now()
	var bk = main._barracks
	var wv = bk.web()
	var gates_were: bool = sim.core_gates
	sim.core_gates = true
	# Training's card: the web is the runner's own, nothing kept by the camp
	var intro: String = " ".join(Words.ROOM_INTROS["training"]["lines"])
	_check(intro.contains("their own web") and not intro.contains("Pitch") and not intro.contains("tree"), "Training's card still says the old rule: '%s'" % intro)
	# another class's start and skills: taken and walked through like any node (the next class by distance, merge 47's
	# second round) - a Doorman walks through the Poacher's start to his Trapline - but the card says they do nothing
	var d = Sim.new()
	d.start()
	d.set_class("Doorman")
	d.core_gates = true
	d.training_points = 120
	var p_start: String = Data.web_start("Poacher")
	var p_skill := ""
	for t in Data.trees_for("Poacher"):
		for i in range(t["nodes"].size()):
			if p_skill == "" and t["nodes"][i].has("skill") and not t["nodes"][i].get("start", false):
				p_skill = "%s/%d" % [t["name"], i]
	var trapline: String = Data.node_id_named("Snares/Trapline")
	var via: Array = d.web_path(trapline)
	_check(trapline != "" and via.any(func(q): return d.web_class_only(str(q)) == "Poacher"), "a Doorman's way to the Trapline doesn't cross the Poacher's start or skills: %s" % str(via))
	_check(_walk_gated(d, trapline) and d.web_owned(trapline) and via.filter(func(q): return d.web_class_only(str(q)) != "").all(func(q): return d.web_owned(str(q))),
		"a Doorman couldn't buy through the Poacher's start to the Trapline: %s" % d.train_block(trapline))
	_check(d.web_class_only(p_start) == "Poacher" and d.web_class_only(p_skill) == "Poacher" and d.web_class_only(Data.web_start("Doorman")) == "", "the class-only read is off: %s / %s" % [d.web_class_only(p_start), d.web_class_only(p_skill)])
	# the card: a Poacher's skill next to a Doorman's own: takeable, "Take it · 1 point", and the line saying it's no use
	_set_cls(sim, "Doorman")
	sim.tree = [Data.web_start("Doorman")]
	sim.training_points = 120
	var to_skill: Array = sim.web_path(p_skill)
	for q in to_skill.slice(0, to_skill.size() - 1):
		sim.web_take(str(q))
	sim._caches_out()
	main.show_room(main.BARRACKS)
	bk._pick(p_skill)
	main.refresh()
	_check(sim.web_can_take(p_skill) == "" and not bk._train.disabled and bk._train.text == Words.WEB_SCREEN["take"] and bk._no_use.visible and bk._no_use.text == Words.WEB_SCREEN["no_use"] % ["Poacher", "Doorman"],
		"the card on a Poacher's skill for a Doorman: '%s' %s, no-use line '%s' %s" % [bk._train.text, str(bk._train.disabled), bk._no_use.text, str(bk._no_use.visible)])
	_check(bk._no_use.position.y >= bk._words3.position.y + bk._words3.size.y - 1.0 and bk._no_use.position.y + bk._no_use.size.y <= bk._train.position.y, "the no-use line isn't under the words, over the button")
	_check_fit(main, "Training (another class's skill)")
	bk._pick(str(to_skill[0]))
	main.refresh()
	_check(not bk._no_use.visible, "the no-use line shows on a node any runner can use: %s" % str(to_skill[0]))
	# a pasted code: an unjoined node and an early keystone both missed, the rest by the rule; the same build reversed whole
	var c = Sim.new()
	c.start()
	c.set_class("Poacher")
	c.core_gates = true
	var start: String = Data.web_start("Poacher")
	var key := ""
	var key_n := 999
	for id in Data.web_ids():
		if Data.web_kind(str(id)) == "keystone" and c.web_steps(str(id)) > 0 and c.web_steps(str(id)) < key_n:
			key = str(id)
			key_n = c.web_steps(str(id))
	var to_key: Array = c.web_path(key)
	var far: String = Data.web_of_slot("e3:res")     # Blades' resist notable: far from the Poacher (the web's version two)
	_check(key != "" and key_n <= Data.KEYSTONE_SPENT and c.web_steps(far) > 3, "the paste fixture: keystone %s %d steps, far node %d steps" % [key, key_n, c.web_steps(far)])
	c.tree = [start] + to_key + [far]
	var code: String = c.build_code()
	var p = Sim.new()
	p.start()
	p.set_class("Poacher")
	p.core_gates = true
	p.training_points = 30
	var got: Dictionary = p.build_apply(p.build_read(code))
	var miss: Array = Array(got.get("missed", [])).duplicate()
	miss.sort()
	var want_miss: Array = [str(p.node(key)["name"]), str(p.node(far)["name"])]
	want_miss.sort()
	_check(miss == want_miss and not p.web_owned(key) and not p.web_owned(far) and p.web_spent() == to_key.size() - 1, "a crafted code: missed %s (want %s), spent %d" % [str(miss), str(want_miss), p.web_spent()])
	var g = Sim.new()
	g.start()
	g.set_class("Poacher")
	g.core_gates = true
	g.training_points = Data.KEYSTONE_SPENT + 6     # past the keystones' gate (30 since the web's version two), a keystone in it
	_walk_gated(g, key)                         # the nearest keystone, its gate opened on the frontier as a player would
	for _k in range(90):
		if g.web_free() <= 0:
			break
		var fr: Array = g.web_frontier()
		if fr.is_empty():
			break
		var pick: String = str(fr[0])
		for f in fr:
			if Data.web_kind(str(f)) == "keystone":
				pick = str(f)
		g.web_take(pick)
	var legal: Array = g.tree.filter(func(id): return str(id) != start and not g.is_ring(str(id)))
	_check(g.web_spent() == Data.KEYSTONE_SPENT + 6 and legal.any(func(id): return Data.web_kind(str(id)) == "keystone"), "the reversed paste's build: %d spent, a keystone %s" % [g.web_spent(), str(legal.any(func(id): return Data.web_kind(str(id)) == "keystone"))])
	var rev: Array = legal.duplicate()
	rev.reverse()
	c.tree = [start] + rev
	var r = Sim.new()
	r.start()
	r.set_class("Poacher")
	r.core_gates = true
	r.training_points = Data.KEYSTONE_SPENT + 6
	var got2: Dictionary = r.build_apply(r.build_read(c.build_code()))
	var mine: Array = r.tree.filter(func(id): return str(id) != start)
	mine.sort()
	var want: Array = legal.duplicate()
	want.sort()
	_check(Array(got2.get("missed", [])).is_empty() and mine == want, "a valid build reversed trains %d of %d, missed %s" % [mine.size(), want.size(), str(got2.get("missed", []))])
	# a load: a tree the rule can't make - unjoined, a capstone at nothing spent, past its points - loads legal, the
	# latest past the points cut first; the crew's too
	var b = Sim.new()
	b.start()
	b.set_class("Poacher")
	b.core_gates = true
	var cap := ""
	for id in Data.web_ids():
		if Data.web_kind(str(id)) == "capstone" and Data.web_region(str(id)) == "class:Poacher":
			cap = str(id)
	var line: Array = []
	var walk = Sim.new()
	walk.start()
	walk.set_class("Poacher")
	walk.core_gates = false
	walk.training_points = 60
	for id in walk.web_path(far):
		if line.size() < 12 and Data.web_kind(str(id)) != "keystone" and Data.web_kind(str(id)) != "capstone":
			if walk.web_take(str(id)):
				line.append(str(id))
	var crew_far: String = Data.web_of_slot("e0:res")     # the cold's resist notable, far from the Doorman (version two)
	b.tree = [start] + line + [cap, far]
	b.training_points = 8
	var bd: Dictionary = JSON.parse_string(JSON.stringify(b.to_dict()))
	bd["crew"] = {"Doorman": {"xp": 0.0, "tree": [Data.web_start("Doorman"), crew_far], "training_points": 5}}
	var back = Sim.new()
	back.load_dict(bd)
	var kept: Array = back.tree.filter(func(id): return str(id) != start and not back.is_ring(str(id)))
	_check(line.size() == 12 and kept == line.slice(0, 8) and back.web_spent() == 8 and not back.web_owned(cap) and not back.web_owned(far),
		"a broken tree loaded as %s (want the first 8 of %s), %d spent" % [str(kept), str(line), back.web_spent()])
	_check(not Array(back.roster.get("Doorman", {}).get("tree", [crew_far])).has(crew_far), "a crew runner's unjoined node survived the load: %s" % str(back.roster.get("Doorman", {}).get("tree", [])))
	# the b45 fixtures: grown on the new web, nothing for the load to cut, the points spent
	for path in B45_FIXTURES:
		var f := FileAccess.open_compressed(path, FileAccess.READ, FileAccess.COMPRESSION_GZIP)
		var fd = JSON.parse_string(f.get_as_text()) if f != null else null
		if f != null:
			f.close()
		_check(fd is Dictionary, "%s won't read" % path)
		if not (fd is Dictionary):
			continue
		var raw: Array = Array(fd["sim"].get("tree", []))
		var fs = Sim.new()
		fs.load_dict(fd["sim"])
		_check(fs.tree.size() == raw.size() and fs.web_spent() > 0 and fs.web_free() == 0, "%s isn't a legal tree on the new web: %d saved, %d loaded, %d spent, %d free" % [path, raw.size(), fs.tree.size(), fs.web_spent(), fs.web_free()])
		for k in fs.roster:
			var rt: Array = Array(fd["sim"]["crew"][k].get("tree", []))
			_check(Array(fs.roster[k].get("tree", [])).size() == rt.size(), "%s's %s cut on load: %d of %d" % [path, k, Array(fs.roster[k].get("tree", [])).size(), rt.size()])
	# the big nodes' two lines read alike: "<Kind>s open at N points spent: open / M to go"
	_set_cls(sim, "Poacher")
	sim.tree = [start] + legal.slice(0, Data.KEYSTONE_SPENT + 5)     # past the keystones' gate, short of the capstones' (30 and 80, version two)
	sim.training_points = Data.KEYSTONE_SPENT + 9
	sim._caches_out()
	bk._pick("")
	main.refresh()
	_check(bk._big_lines[0].text == "Keystones open at %d points spent: open" % Data.KEYSTONE_SPENT and bk._big_lines[1].text == "Capstones open at %d points spent: %d to go" % [Data.CAPSTONE_SPENT, Data.CAPSTONE_SPENT - Data.KEYSTONE_SPENT - 5],
		"the big nodes' lines don't read alike: '%s' / '%s'" % [bk._big_lines[0].text, bk._big_lines[1].text])
	# the ring's entries at the classes' angles
	for cl in Data.CLASSES:
		var a: float = rad_to_deg(Data.web_at(Data.web_start(str(cl["name"]))).angle())
		var hit := false
		for rn in Data.RING["nodes"]:
			if rn.get("entry", false) and absf(wrapf(float(rn["ring"]) - a, -180.0, 180.0)) < 1.0:
				hit = true
		_check(hit, "no ring entry by the %s's start (at %.1f°)" % [cl["name"], a])
	# the picked node's name at the whole web: clear of every node, its own too, on the canvas
	bk._web_buttons[0].pressed.emit()
	main.refresh()
	wv.focus_all()
	var busy: Array = [Data.node_id_named("Stalking/Early doors"), start, key]
	for id in busy:
		wv.selected = str(id)
		wv.count_batches()
		var rc: Rect2 = wv.pick_label_rects.get(str(id), Rect2())
		var me: Vector2 = wv.to_screen(wv.layout[str(id)])
		var my_r: float = wv.radius_of(wv.node_of(str(id))) * wv.zoom
		_check(rc.size.x > 0.0 and int(wv.pick_label_hits.get(str(id), 999)) == 0 and Vector2(clampf(me.x, rc.position.x, rc.end.x), clampf(me.y, rc.position.y, rc.end.y)).distance_to(me) >= my_r and Rect2(Vector2.ZERO, wv.size).encloses(rc),
			"the picked %s's name covers nodes: %d, at %s" % [str(wv.node_of(str(id)).get("name", id)), int(wv.pick_label_hits.get(str(id), 99)), str(rc)])
		# read here too, not on the view's own count: no node's disc and no name's block under the plate
		var under: Array = []
		for oid in wv.layout:
			var q: Vector2 = wv.to_screen(wv.layout[oid])
			if str(oid) != str(id) and Vector2(clampf(q.x, rc.position.x, rc.end.x), clampf(q.y, rc.position.y, rc.end.y)).distance_to(q) < maxf(3.0, wv.radius_of(wv.node_of(str(oid))) * wv.zoom):
				under.append(oid)
		for ak in wv._axis:
			if wv.block_rect(str(ak)).size.x > 0.0 and wv.block_rect(str(ak)).intersects(rc):
				under.append(ak)
		_check(under.is_empty(), "the picked %s's name runs over %s" % [str(wv.node_of(str(id)).get("name", id)), str(under)])
	# the speed (merge 47's second round: 38-41 ms a label a redraw before): a redraw at the whole web with a node picked
	# and another hovered, its labels placed fresh and then read back, well under a node trained's budget (B45_TRAIN)
	_b45_pace = _b45_pace_now()
	wv.selected = str(busy[0])
	wv.hover = str(busy[1])
	var plain_ms := INF
	var fresh_ms := INF
	var again_ms := INF
	for rep in range(3):
		wv.selected = ""
		wv.hover = ""
		var t0 := Time.get_ticks_usec()
		wv.count_batches()
		plain_ms = minf(plain_ms, (Time.get_ticks_usec() - t0) / 1000.0)
		wv.selected = str(busy[0])
		wv.hover = str(busy[1])
		wv._pick_cache = {}
		t0 = Time.get_ticks_usec()
		wv.count_batches()
		fresh_ms = minf(fresh_ms, (Time.get_ticks_usec() - t0) / 1000.0)
		t0 = Time.get_ticks_usec()
		wv.count_batches()
		again_ms = minf(again_ms, (Time.get_ticks_usec() - t0) / 1000.0)
	print("the picked labels' redraw: %.1f ms bare, %.1f placed fresh, %.1f read back (pace %.2f)" % [plain_ms, fresh_ms, again_ms, _b45_pace])
	_check(wv.pick_label_rects.size() == 2 and fresh_ms - plain_ms < _b45_b(B45_TRAIN / 6.0) and again_ms - plain_ms < _b45_b(B45_TRAIN / 30.0),
		"the picked labels cost a redraw %.1f ms placed fresh, %.1f read back (bare %.1f; budgets %.1f / %.1f)" % [fresh_ms - plain_ms, again_ms - plain_ms, plain_ms, _b45_b(B45_TRAIN / 6.0), _b45_b(B45_TRAIN / 30.0)])
	wv.hover = ""
	wv.selected = ""
	sim.load_dict(saved)
	sim.core_gates = gates_were
	bk.selected = ""
	bk._shown = ""
	main.refresh()
	print("merge 47's fixes ok: another class's start and skills, paste by the rule in any order, a load made legal, the fixtures, the big nodes' lines, the ring's entries, the picked name clear")


## 0.12.1 (3 Nov, Matt: "whats with the lack of art?"): the web's art back on the new layout. Every node a picture or its
## effect's glyph; a small one a dot at the whole web, its picture or glyph from SMALL_ART_ZOOM; a picture dropped where
## the lookup reads found by name with no code change (and gone again, the glyph back); the regions' emblems centred over
## their names (0.12.2) - six elements, twelve class trees in their classes' pairs, the centre, the ring - each block on
## no node and no other; the runner's class's portrait centred on its name, under no other name.
func _web_art_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	if sim.on_mission():
		sim.extract_now()
	var bk = main._barracks
	var wv = bk.web()
	_set_cls(sim, "Poacher")
	var start: String = Data.web_start("Poacher")
	sim.tree = [start]
	sim.training_points = 10
	sim._caches_out()
	main.show_room(main.BARRACKS)
	bk._pick("")
	main.refresh()
	# every node a picture or a glyph of its own (not the star every unknown effect falls to)
	var bare: Array = []
	for id in Data.web_ids():
		var nd: Dictionary = wv.node_of(str(id))
		if WebView.picture(wv.picture_slug(nd)) == null and (wv.glyph_of(nd) == "" or wv.glyph_of(nd) == "star"):
			bare.append("%s (%s)" % [nd.get("name", id), nd.get("effect", "")])
	_check(bare.is_empty(), "%d web nodes have neither a picture nor a glyph: %s" % [bare.size(), str(bare.slice(0, 6))])
	# a dot at the whole web; close in, its picture or its glyph, grown as its neighbours allow
	bk._web_buttons[0].pressed.emit()
	main.refresh()
	wv.focus_all()
	var smalls: Array = Data.web_ids().filter(func(x): return Data.web_kind(str(x)) == "small")
	_check(wv.zoom < wv.SMALL_ART_ZOOM and smalls.all(func(x): return wv.small_art_of(str(x)) == "" and is_equal_approx(wv.radius_of(wv.node_of(str(x))), wv.R_SMALL)), "the small nodes aren't dots at the whole web (zoom %.2f)" % wv.zoom)
	wv.zoom = maxf(wv.SMALL_ART_ZOOM, 1.4)
	var no_art: Array = smalls.filter(func(x): return wv.small_art_of(str(x)) == "")
	var grown: int = smalls.filter(func(x): return wv.radius_of(wv.node_of(str(x))) > wv.R_SMALL + 2.0).size()
	_check(no_art.is_empty() and grown * 2 > smalls.size(), "close in, %d small nodes carry nothing, %d of %d grown" % [no_art.size(), grown, smalls.size()])
	var centre_l: String = Data.web_of_slot("h0.1")     # a lesser node of the inner ring's life cluster (the web's version two)
	_check(wv.small_art_of(centre_l) != "" and wv.glyph_of(wv.node_of(centre_l)) == "hp", "the centre's life small shows '%s', glyph %s" % [wv.small_art_of(centre_l), wv.glyph_of(wv.node_of(centre_l))])
	# grown close in, no two nodes on each other (the overlap check of _web_checks at this zoom, the smalls grown)
	var close_over: Array = _web_overlaps(wv)
	_check(close_over.is_empty(), "at zoom %.2f %d pairs of nodes overlap, the smalls grown: %s" % [wv.zoom, close_over.size(), str(close_over.slice(0, 4))])
	# an art drop: a picture put where the lookup reads for a small node with none is drawn on the next look, no code
	# changed; taken away, the glyph again. The lookup pointed at user:// for this (a killed smoke leaves nothing in art/)
	var art_dir_was: String = WebView.node_art_dir
	WebView.node_art_dir = "user://smoke_node_art"
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(WebView.node_art_dir))
	WebView.art_rescan()
	var drop := ""                      # chosen with the lookup pointed away: a machine with every small's picture still has a fixture
	for x in smalls:
		if drop == "" and WebView.picture(wv.picture_slug(wv.node_of(str(x)))) == null:
			drop = str(x)
	var drop_path: String = "%s/%s.png" % [WebView.node_art_dir, wv.picture_slug(wv.node_of(drop))]
	_check(drop != "" and not FileAccess.file_exists(drop_path) and wv.small_art_of(drop) == "glyph", "the art-drop fixture: %s at %s shows '%s'" % [drop, drop_path, wv.small_art_of(drop)])
	if drop != "" and not FileAccess.file_exists(drop_path):
		var img := Image.create(64, 64, false, Image.FORMAT_RGBA8)
		img.fill(Color(0.8, 0.5, 0.2, 1.0))
		img.save_png(ProjectSettings.globalize_path(drop_path))
		# in a running game: the miss looked for again once ART_RECHECK_MS has gone (aged here, not waited for)
		WebView._missed[drop_path] = Time.get_ticks_msec() - WebView.ART_RECHECK_MS - 1
		var seen_pic: bool = WebView.picture(wv.picture_slug(wv.node_of(drop))) != null and wv.small_art_of(drop) == "picture"
		wv.count_batches()
		DirAccess.remove_absolute(ProjectSettings.globalize_path(drop_path))
		WebView.art_rescan()
		_check(seen_pic, "a picture dropped in at %s wasn't drawn for %s" % [drop_path, drop])
		_check(wv.small_art_of(drop) == "glyph" and not FileAccess.file_exists(drop_path), "the dropped picture taken away, %s shows '%s'" % [drop, wv.small_art_of(drop)])
	WebView.node_art_dir = art_dir_was
	WebView.art_rescan()
	# the emblems over their names (0.12.2, Matt: "centered above their names"): an element's one, a class's two (its
	# trees') side by side, the ring's over "Ring"; the centre's dropped (BUILD49 V: no place near the hub holds it on
	# version two's web) - nineteen; over the words, or beside them at their left where over doesn't fit (NAME_AT's 2);
	# each block (the name and its emblems) on no node, no other block, on the canvas
	var want := {}
	for et in Data.ELEMENT_TREES:
		want["el:" + str(et["name"])] = 1
	for cd in Data.CLASSES:
		want["class:" + str(cd["name"])] = 2
	want["centre"] = 0
	want["ring"] = 1
	var n_em := 0
	for k in want:
		n_em += Array(wv._axis.get(k, {}).get("emblems", [])).size()
		_check(Array(wv._axis.get(k, {}).get("emblems", [])).size() == want[k], "%s has %d emblems over its name, not %d" % [k, Array(wv._axis.get(k, {}).get("emblems", [])).size(), want[k]])
	_check(n_em == 19 and wv.region_words("centre") == Words.WEB_SCREEN["centre_name"], "the web's emblems are %d, not nineteen, or the centre's name reads '%s'" % [n_em, wv.region_words("centre")])
	var canvas := Rect2(Vector2.ZERO, wv.size)
	for zl in [wv.fit_zoom(), 1.0, 2.0]:
		wv.focus_all()
		wv.zoom = zl
		wv.count_batches()
		if is_equal_approx(zl, wv.fit_zoom()):
			_check(wv.emblem_rects.size() == 19, "at the whole web %d emblems drawn, not nineteen" % wv.emblem_rects.size())
		var keys: Array = wv._axis.keys()
		for k in keys:
			var words: Rect2 = wv.label_rect(str(k))
			var ers: Array = wv.emblem_rects_of(str(k))
			if not ers.is_empty() and not wv._axis[k].get("inline", false):
				var row := Rect2(ers[0].position, Vector2.ZERO).merge(ers.back())
				_check(absf(row.get_center().x - words.get_center().x) <= 1.0 and words.position.y - row.end.y >= 0.0 and words.position.y - row.end.y <= wv.EMBLEM_LIFT + 1.0,
					"at zoom %.2f %s's emblems aren't centred just over its name: %s over %s" % [zl, k, str(row), str(words)])
			elif not ers.is_empty():
				var row2 := Rect2(ers[0].position, Vector2.ZERO).merge(ers.back())
				_check(row2.end.x <= words.position.x and words.position.x - row2.end.x <= wv.INLINE_GAP + 1.0 and absf(row2.get_center().y - words.get_center().y) <= 1.5,
					"at zoom %.2f %s's emblems aren't just left of its name, its middle: %s by %s" % [zl, k, str(row2), str(words)])
			var blk: Rect2 = wv.block_rect(str(k))
			if is_equal_approx(zl, wv.fit_zoom()):
				_check(canvas.encloses(blk), "%s's name and emblems run off the canvas at the whole web: %s" % [k, str(blk)])
			# a stored name (BUILD49 V, NAME_AT): its block centred on its place at every zoom
			_check(blk.get_center().distance_to(wv.to_screen(wv._axis[k]["label_at"])) <= 2.0, "at zoom %.2f %s's block is %.1f px off its place" % [zl, k, blk.get_center().distance_to(wv.to_screen(wv._axis[k]["label_at"]))])
			var bdim: Dictionary = wv.block_dims(str(k), zl)
			var bs: Array = [bdim["ts"], bdim["es"]]
			_check(bs.size() == 2 and float(bs[0]) >= wv.NAME_MIN and float(bs[0]) <= wv.NAME_SIZE and (Array(wv._axis[k].get("emblems", [])).is_empty() or (float(bs[1]) >= wv.EMBLEM_MIN and float(bs[1]) <= wv.EMBLEM_MAX)),
				"at zoom %.2f %s's words or emblems are out of their sizes: %s" % [zl, k, str(bs)])
			var clash: Array = _block_clash(wv, blk)
			_check(clash.is_empty(), "at zoom %.2f %s's name or emblems run into %s" % [zl, k, ", ".join(clash)])
			for k2 in keys:
				if str(k2) > str(k) and wv.block_rect(str(k2)).intersects(blk):
					_check(false, "at zoom %.2f %s's name and emblems sit on %s's" % [zl, k, k2])
	# every name at its stored place (NAME_AT, BUILD49 V), each clear (none touching a node, none on the ring, none under
	# the tabs or the key), the words LABEL_SLACK wide, at the whole web of this canvas and of one 4 px shorter (Windows'
	# margin); each by its own line (a class's start, an element's column), within NAME_SPAN degrees
	_check(wv._axis.keys().all(func(k): return wv.NAME_AT.has(k) and Vector2(wv._axis[k]["label_at"]).distance_to(Vector2(float(wv.NAME_AT[k][0]), float(wv.NAME_AT[k][1]))) < 0.01), "a name isn't at its stored place")
	for hh in [wv.size.y, wv.size.y - 4.0]:
		var zf: float = clampf(minf(wv.size.x / wv._bounds.size.x, (hh - wv.FRAME_TOP) / wv._bounds.size.y), wv.ZOOM_MIN, wv.ZOOM_MAX)
		var unfit: Dictionary = wv.stored_unfit(zf, hh)
		_check(unfit.is_empty(), "at the whole web of a %d px canvas the stored names touch nodes or sit where they mustn't: %s" % [int(hh), str(unfit)])
	for k in wv._axis:
		if str(k) in ["centre", "ring"]:
			continue
		var line: float = Vector2(wv._axis[k]["anchor"]).angle()
		var off: float = rad_to_deg(absf(angle_difference(line, Vector2(wv._axis[k]["label_at"]).angle())))
		_check(off <= wv.NAME_SPAN + 0.5, "%s's name sits %.1f degrees off its line" % [k, off])
	# the picked node's label (Training's default view: the start's notable) clear of every name's block, and the card's
	# place for a centre node in the web's word for it, "The Pitch" (0.12.2, the review)
	wv.focus_all()
	var dpick: String = wv.find_named("Early doors")
	bk._pick(dpick)
	main.refresh()
	wv.selected = dpick
	wv.count_batches()
	var prc: Rect2 = wv.pick_label_rects.get(dpick, Rect2())
	var on_names: Array = wv._axis.keys().filter(func(ak): return wv.block_rect(str(ak)).intersects(prc))
	_check(prc.size.x > 0.0 and on_names.is_empty(), "the picked label's plate %s sits on %s" % [str(prc), str(on_names)])
	bk._pick(Data.web_of_slot("h0"))
	main.refresh()
	_check(bk._where.text.begins_with("The Pitch") and bk._where.text.begins_with(Words.WEB_SCREEN["centre_name"]), "a centre node's card says it's in '%s'" % bk._where.text)
	bk._pick("")
	wv.selected = ""
	main.refresh()
	# the portrait: centred on the runner's class's name, under no other name or emblem
	wv.focus_all()
	wv.count_batches()
	var pr: Rect2 = wv.portrait_rect
	var mine: String = "class:Poacher"
	_check(pr.size.x > 0.0 and pr.get_center().distance_to(wv.block_rect(mine).get_center()) < 1.0 and canvas.encloses(pr) and pr.encloses(wv.block_rect(mine)),
		"the Poacher's portrait isn't on his name: %s, the name %s" % [str(pr), str(wv.label_rect(mine))])
	for ak in wv._axis:
		if str(ak) != mine:
			_check(not wv.block_rect(str(ak)).intersects(pr), "the portrait sits under %s's name or emblems" % ak)
	_check(wv.count_batches() < wv.BATCH_MAX, "the web's art takes %d draw calls at the whole web" % wv.count_batches())
	wv.zoom = 1.4
	_check(wv.count_batches() < wv.BATCH_MAX, "the web's art takes %d draw calls close in" % wv.count_batches())
	wv.focus_all()
	_check_fit(main, "Training (the web's art)")
	sim.load_dict(saved)
	bk.selected = ""
	bk._shown = ""
	main.refresh()
	print("the web's art ok: %d nodes a picture or a glyph, the smalls close in, an art drop, %d emblems over their names, the portrait on the class's name" % [Data.web_ids().size(), n_em])


## What a name's block runs into on screen (0.12.2): each node whose disc reaches into it, how far in (px), deepest
## first. Links may run under a block (its plate keeps the words read over them).
func _block_clash(wv, blk: Rect2) -> Array:
	var hits: Array = []
	for id in wv.layout:
		var q: Vector2 = wv.to_screen(wv.layout[id])
		var r: float = wv.radius_of(wv.node_of(id)) * wv.zoom
		var d: float = Vector2(clampf(q.x, blk.position.x, blk.end.x), clampf(q.y, blk.position.y, blk.end.y)).distance_to(q)
		if d < r:
			hits.append([r - d, "node %s %.1f px" % [id, r - d]])
	hits.sort_custom(func(x, y): return x[0] > y[0])
	return hits.map(func(h): return h[1])


## BUILD49 V (4 Nov, docs/design/skill_web.md "The screen (Training)"): Training's web at version two's size - every
## node at its place and drawn; the three states as the sim's for a fixture runner; the tracks' colours; lesser nodes
## dots at the whole web; the fourteen names clear; the card's button live only when web_can_take is "", "Skill" on a
## skill node, the two gates' words; the band's counter and its reward line's sources; the three tabs (the corner
## framing the class and its two elements, the Paragon board its ring's arc); one atlas under BATCH_MAX and a frame
## under today's at 379 nodes x 1.5; every label fitting at 1920x1080 and 1920x1200.
const B49_WEB_FRAME_MS := 8.9      # today's (b49, 379 nodes): a restated frame at the whole web, dry, the cloud quiet
func _web49_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	if sim.on_mission():
		sim.extract_now()
	var bk = main._barracks
	var wv = bk.web()
	var WS: Dictionary = Words.WEB_SCREEN
	var W2: Dictionary = Words.WEB_SCREEN2
	var gates_were: bool = sim.core_gates
	sim.core_gates = true
	_set_cls(sim, "Poacher")
	var start: String = Data.web_start("Poacher")
	sim.tree = [start]
	sim.ring = {}
	sim.rewards_earned = {}
	sim.training_points = 6
	sim._caches_out()
	main.show_room(main.BARRACKS)
	bk._pick("")
	bk._shown = ""
	main.refresh()
	bk._web_buttons[0].pressed.emit()
	# every node at its place, the ring past the furthest (skill_web.md: 1,120), and drawn at the whole web
	var ids: Array = Data.web_ids()
	var far := 0.0
