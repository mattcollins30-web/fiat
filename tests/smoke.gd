	m["target_hp"] = 1e6
	m["dots"] = {}
	sim.hp = sim.max_hp() * 0.5
	sim.use_med(sim.rig[0]["id"])
	if m["using"] != null:
		sim._patch(m, 100.0)
	_check(float(m["dots"].get("fire", 0.0)) > 0.0 and m["target_hp"] < 1e6, "the Arsonist's Rig did not set them alight on a med: %.0f left" % m["target_hp"])
	sim.extract_now()
	sim.equipped["Rig"] = hold["Rig"]
