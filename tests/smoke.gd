## A fire build's verdict (18 Oct, Matt's two machine pistols: a Common with +5% damage read as the Upgrade over an Epic
## with fire, conversion and damage over time, and equipping it dropped the top bar's figure): the arrow, the delta and
## the verdict weigh a gun by the figure the top bar shows, the hits and the burn together.
func _dot_compare_checks(_main) -> void:
	var s = Sim.new()
	s.start()
	s.mythics_on = false
	var plain: Dictionary = s._plain("Secondary", "Automatic pistol")
	plain["rarity"] = 1
	plain["affixes"] = [{"stat": "damage_pct", "value": 5, "tier": 1}]
	var burn: Dictionary = s._plain("Secondary", "Automatic pistol")
	burn["rarity"] = 3
	burn["affixes"] = [{"stat": "dot_pct", "value": 24, "tier": 3}, {"stat": "conv_fire_pct", "value": 25, "tier": 4}, {"stat": "fire_pct", "value": 24, "tier": 4}]
	s.equipped["Secondary"] = plain
	var with_plain: float = s.damage_total()
	s.equipped["Secondary"] = burn
	var with_burn: float = s.damage_total()
	s.equipped["Secondary"] = plain
	var want: int = 1 if with_burn > with_plain * 1.005 else (-1 if with_burn < with_plain * 0.995 else 0)
	_check(s.compare(burn) == want, "the burn pistol over the plain one reads %d, the top bar says %d (%.1f to %.1f)" % [s.compare(burn), want, with_plain, with_burn])
	_check(is_equal_approx(s.fit_value(burn) - s.fit_value({}, "Secondary"), with_burn - with_plain), "the pick's delta isn't the top bar's change: %.2f, not %.2f" % [s.fit_value(burn) - s.fit_value({}, "Secondary"), with_burn - with_plain])
	var dl: Array = PickPanel.deltas_for(s, burn, plain)
	_check(not dl.is_empty() and is_equal_approx(absf(float(dl[0][0])), absf(with_burn - with_plain)) and str(dl[0][1]).ends_with("dmg/s"), "the pick panel's damage delta reads %s, not %.1f" % [str(dl[0]) if not dl.is_empty() else "nothing", with_burn - with_plain])
	s.equipped["Secondary"] = burn
	_check(s.compare(plain) == -want, "and back the other way the plain one reads %d, not %d" % [s.compare(plain), -want])
	# and in the Primary, where the secondary's share rides on it
	var p_plain: Dictionary = s._plain("Primary", "Workshop SMG")
	p_plain["rarity"] = 1
	p_plain["affixes"] = [{"stat": "damage_pct", "value": 5, "tier": 1}]
	var p_burn: Dictionary = s._plain("Primary", "Workshop SMG")
	p_burn["rarity"] = 3
	p_burn["affixes"] = [{"stat": "dot_pct", "value": 24, "tier": 3}, {"stat": "conv_fire_pct", "value": 25, "tier": 4}, {"stat": "fire_pct", "value": 24, "tier": 4}]
	s.equipped["Primary"] = p_plain
	var pa: float = s.damage_total()
	s.equipped["Primary"] = p_burn
	var pb: float = s.damage_total()
	s.equipped["Primary"] = p_plain
	var pwant: int = 1 if pb > pa * 1.005 else (-1 if pb < pa * 0.995 else 0)
	_check(s.compare(p_burn) == pwant, "the burn SMG over the plain one reads %d, the top bar says %d (%.1f to %.1f)" % [s.compare(p_burn), pwant, pa, pb])
	# the Workshop's figure for a part is the top bar's with it fitted (18 Oct: it read the gun's raw hits)
	s.equipped["Primary"] = p_burn
	var comp: Dictionary = s._plain(Data.ATTACHMENT, "Compensator")
	if p_burn["attachments"].has("muzzle"):
		var dw: Array = s.damage_with_part("Primary", comp)
		var before: float = s.damage_total()
		p_burn["attachments"]["muzzle"] = comp
		var after: float = s.damage_total()
		p_burn["attachments"]["muzzle"] = null
		_check(is_equal_approx(float(dw[0]), before) and is_equal_approx(float(dw[1]), after), "the Workshop's part figure %.1f → %.1f isn't the top bar's %.1f → %.1f" % [float(dw[0]), float(dw[1]), before, after])
	else:
		_check(false, "the fixture: the Workshop SMG has no muzzle mount")
	print("the burn build's verdict ok: %.1f with the plain pistol, %.1f with the burn one, the arrow agrees" % [with_plain, with_burn])


## The Radio's pile (18 Oct, Matt: contracts took his papers; "papers found never touch the stash"; "a signal run needs
## to provide 2 of low quality"): a paper home goes to the pile, Kev's too with the stash full, an old save's stash
## papers move there; a signal's run home brings two at the least, a death none; the deeds stay in the stash.
func _paper_pile_checks(_main) -> void:
	var s = Sim.new()
	s.start()
	s.mythics_on = false
	_open_camp(s)
	for z in range(Data.ZONES.size()):
		s.bosses_beaten[z] = true
		for i in Data.ZONES[z]["tiers"]:
			s.best_depth[i] = 1
	if not ("radio" in s.unlocked):
		s.unlocked.append("radio")
	s.papers = []
	var cells0: int = s.stash_used()
	s.hp = s.max_hp()
	s.deploy(3)
	var found_paper: Dictionary = s._plain(Data.PAPER, "A P45")
	var deeds: Dictionary = s._plain(Data.PAPER, "The deeds")
	deeds["deeds"] = true
	s.mission["found"].append_array([found_paper, deeds])
	s.mission["cleared"] = true
	s.extract_now()
	_check(s.papers.has(found_paper) and not s.stash.has(found_paper) and s.stash.any(func(x): return Items.is_deeds(x)), "a paper home went to the stash, or the deeds left it: pile %d" % s.papers.size())
	_check(s.stash_used() >= cells0, "the fixture: the stash lost cells")
	# Kev's, the stash full: hammers while two cells are free, then a bandage for the last (23 Oct: the gate's meds top-up
	# left an odd cell, and a hammer refused forever)
	while s.stash_room(Items.size(s._plain("Primary", "Claw hammer"))):
		s.stash_put(s._plain("Primary", "Claw hammer"))
	while s.stash_room(1):
		if not s.stash_put(s._plain(Data.MEDICAL, "Bandage")):
			break
	s.notes = 9999
	var pile0: int = s.papers.size()
	var kev: Dictionary = s.ask_kev()
	_check(not kev.is_empty() and s.papers.size() == pile0 + 1 and not s.stash.has(kev), "Kev's paper didn't reach the pile with the stash full: '%s'" % s.kev_block())
	# an old save's stash papers move to the pile
	var d: Dictionary = s.to_dict()
	d["stash"].append(d["papers"][0])
	d["papers"] = d["papers"].slice(1)
	var s2 = Sim.new()
	s2.load_dict(d)
	_check(s2.papers.size() == s.papers.size() and not s2.stash.any(func(x): return Sim.is_pile_paper(x)), "an old save's stash papers didn't move to the pile")
	# a signal's run home: two at the least; a death, none
	s.stash = []
	s.papers = []
	for b in ["A P45", "A pawn ticket", "A bank statement"]:
		s.papers.append(s._plain(Data.PAPER, b))
	var sg: Dictionary = s.decrypt(s.papers.map(func(x): return int(x["id"])))
	_check(not sg.is_empty() and s.papers.is_empty(), "the fixture: no signal from three papers: %s" % s.decrypt_block([]))
	s.hp = s.max_hp()
	var went: bool = s.deploy_signal(0)
	_check(went, "the fixture: the signal didn't deploy (won)")
	if went:
		s.mission["found"] = []
		s.mission["cleared"] = true
		if s.mission.has("boss"):
			s.mission["boss"]["alive"] = false   # beaten: its head down too
		s.extract_now()
		_check(s.papers.size() >= Data.SIGNAL_PAPERS_HOME and s.papers.all(func(x): return int(x["rarity"]) <= 1), "a signal's run home brought %d papers, or a high one" % s.papers.size())
	var made: Dictionary = {}
	for b in ["A P45", "A pawn ticket", "A bank statement"]:
		s.papers.append(s._plain(Data.PAPER, b))
	made = s.decrypt(s.papers.slice(s.papers.size() - 3).map(func(x): return int(x["id"])))
	var before: int = s.papers.size()
	s.hp = s.max_hp()
	went = not made.is_empty() and s.deploy_signal(0)
	_check(went, "the fixture: the signal didn't deploy (death)")
	if went:
		s._kia()
		_check(s.papers.size() == before, "a death on a signal brought papers home: %d from %d" % [s.papers.size(), before])
	# a lost one (timed out) brings none either
	for b in ["A P45", "A pawn ticket", "A bank statement"]:
		s.papers.append(s._plain(Data.PAPER, b))
	made = s.decrypt(s.papers.slice(s.papers.size() - 3).map(func(x): return int(x["id"])))
	before = s.papers.size()
	s.hp = s.max_hp()
	_check(not made.is_empty(), "the fixture: no signal for the time-out check")
	went = not made.is_empty() and s.deploy_signal(0)
	_check(went, "the fixture: the signal didn't deploy (time-out)")
	if went:
		s.mission["found"] = []
		s.mission["cleared"] = true
		if s.mission.has("boss"):
			s.mission["boss"]["alive"] = false   # beaten: its head down too
		s.mission["timed_out"] = true
		s.extract_now()
		_check(s.papers.size() == before, "a lost signal brought papers home: %d from %d" % [s.papers.size(), before])
	# the top-up at a shallow site: nothing deep, nothing another site's own (the review)
	var site0: String = str(Data.TIERS[0]["name"])
	var bad: Array = []
	for i in range(200):
		s.papers = []
		s._signal_papers_home({"found": [], "t": {"depth": 1, "tier": 0}})
		_check(s.papers.size() == Data.SIGNAL_PAPERS_HOME, "a top-up brought %d" % s.papers.size())
		for x in s.papers:
			var home := Items.exclusive_to(str(x["base"]))
			if int(Items.base_of(x).get("depth", 0)) > 1 or (home != "" and home != site0) or int(x["rarity"]) > 1:
				bad.append(str(x["base"]))
	_check(bad.is_empty(), "a shallow top-up gave a deep, another site's or a high paper: %s" % ", ".join(bad.slice(0, 5)))
	# Kev's in the run's finds don't count towards the two
	var kev_names: Array = Sim.story_papers(0)
	if not kev_names.is_empty():
		s.papers = []
		s._signal_papers_home({"found": [s._plain(Data.PAPER, str(kev_names[0]))], "t": {"depth": 1, "tier": 0}})
		_check(s.papers.size() == Data.SIGNAL_PAPERS_HOME, "Kev's paper counted towards the top-up: %d" % s.papers.size())
	# the Stash's Filing cabinet (19 Oct, Matt; it was the Paper rack): a beaten signal brings one more, and papers and
	# charms take their cells again
	_yard_set(s, "stash", 3, "b")
	_check(s.yard_has("filing_cabinet") and s.signal_papers_min() == Data.SIGNAL_PAPERS_HOME + 1, "the Filing cabinet is not the Stash's fourth pick's other side")
	s.papers = []
	s._signal_papers_home({"found": [], "t": {"depth": 1, "tier": 0}})
	_check(s.papers.size() == Data.SIGNAL_PAPERS_HOME + 1, "with the Filing cabinet a top-up brought %d" % s.papers.size())
	_check(not s.stash_free(s._plain(Data.CHARM, str(Data.BASES[Data.CHARM][0]["name"]))), "a charm still takes no cells with the Filing cabinet")
	_yard_set(s, "stash", 3, "")
	# an old save's papers contract is rolled again
	var d3: Dictionary = s.to_dict()
	d3["contracts"] = [{"kind": "papers", "slot": "", "rarity": 0, "count": 2, "level": 0, "stat": "", "pay": "cash", "amount": 10, "salvage": ""}]
	var s3 = Sim.new()
	s3.load_dict(d3)
	_check(not s3.contracts.any(func(c): return str(c["kind"]) == "papers"), "an old save's papers contract survived the load")
	# the pile's cap (23 Oct, parked item 9): past PILE_CAP the plainest plain papers go, the rarest and Kev's stay
	s.papers = []
	var pages0: Array = s.book_pages() if s.has_method("book_pages") else []
	var page_name: String = str(pages0[0]) if not pages0.is_empty() else str(Data.BASES[Data.PAPER][0]["name"])
	for i in range(Data.PILE_CAP + 10):
		var pp: Dictionary = s._plain(Data.PAPER, page_name)
		pp["rarity"] = 2 if i % 7 == 0 else (1 if i % 2 == 0 else 0)
		s.papers.append(pp)
	var kev_kept := -1
	if not kev_names.is_empty():
		var kp: Dictionary = s._plain(Data.PAPER, str(kev_names[0]))
		kev_kept = int(kp["id"])
		s.papers.append(kp)
	var rare_before: int = s.papers.filter(func(x): return int(x["rarity"]) == 2).size()
	var plain_ids: Array = s.papers.filter(func(x): return int(x["rarity"]) == 0).map(func(x): return int(x["id"]))
	var seen: Array = s.signal_papers()
	var plain_left: Array = seen.filter(func(x): return int(x["rarity"]) == 0).map(func(x): return int(x["id"]))
	_check(plain_left == plain_ids.slice(plain_ids.size() - plain_left.size()), "the trim didn't take the oldest of the plainest first")
	_check(seen.size() == Data.PILE_CAP, "the pile holds %d past its cap of %d" % [seen.size(), Data.PILE_CAP])
	_check(seen.filter(func(x): return int(x["rarity"]) == 2).size() == rare_before, "the trim took a rare paper")
	_check(kev_kept < 0 or seen.any(func(x): return int(x["id"]) == kev_kept), "the trim took Kev's paper")
	_check(seen.filter(func(x): return int(x["rarity"]) == 0).size() * 2 < Data.PILE_CAP, "the plainest didn't go first")
	print("the Radio's pile ok: a paper home and Kev's go to it, the deeds stay, an old save moves, a signal beaten brings %d, a death or a loss none; the top-up shallow, Kev's not counted, old contracts rolled; the cap %d" % [Data.SIGNAL_PAPERS_HOME, Data.PILE_CAP])



