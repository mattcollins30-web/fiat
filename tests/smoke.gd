## The Runner's cards (11 Oct, Matt): the slot's name floats over the card, not inside it, and a picked slot shows
## one frame - the gear's own cell is the card, the empty card's outline hidden under it. And the title's foot carries
## the version, not the window line.
func _card_frame_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	main.show_room(main.ARMOURY)
	var body = main._armoury._body
	for slot in Data.SLOTS:
		body._pick(slot)                      # as a press on the card: the Lock-up picks the slot
		main.refresh()
		var b: Dictionary = body._boxes[slot]
		var full: bool = sim.equipped[slot] != null
		_check(b["name"].position.y + b["name"].size.y <= body.TOP_STRIP + 0.5, "the %s label is not over its card" % slot)
		if full:
			_check(not b["outline"].visible and b["cell"].visible and is_equal_approx(b["cell"].position.y, float(body.TOP_STRIP)) and is_equal_approx(b["cell"].size.x, body.box_rect(slot).size.x), "the picked %s card shows two frames, or its gear doesn't fill it" % slot)
		else:
			_check(b["outline"].visible and b["outline"].position.y >= body.TOP_STRIP - 0.5, "the empty %s card has no outline under its label" % slot)
	_check_fit(main, "Lock-up (labels over the cards)")
	body.selected = ""
	main._armoury.selected = {}
	main.refresh()
	var Menu = load("res://scripts/ui/menu.gd")
	_check(Menu._build_words() == "FIAT · v" + Menu.VERSION and not Menu._build_words().contains("×"), "the title's foot reads '%s', not the version" % Menu._build_words())
	print("card frames ok: the label over the card, one frame picked; the title's version")

## The pasts as cards (14 Oct, Matt; two rows of three from 24 Oct, the Band board): a face, the name and its tag in each
## card, in a row, none overlapping; the runner's lit and ticked; a short line for each part of the sentence (a cost red);
## the sentence a tooltip; a ? in the face's place with no past.
func _class_card_checks(bk) -> void:
	var sim = bk.sim
	for k in range(bk._class_buttons.size()):
		var cb: Button = bk._class_buttons[k]
		var c: Dictionary = bk._class_cards[k]
		var cd: Dictionary = Data.CLASSES[k]
		var box := Rect2(Vector2.ZERO, cb.size)
		for n in [c["face"], c["name"], c["tag"], c["lock"]]:
			_check(not n.visible or box.encloses(Rect2(n.position, n.size)), "%s's card: a part runs out of it: %s" % [cd["name"], str(Rect2(n.position, n.size))])
		_check(c["face"].visible and c["face"].texture != null, "%s's card has no face" % cd["name"])
		var short: Array = cd.get("short", [])
		_check(short.size() >= 2 and short.size() <= 3 and short.size() == str(cd["words"]).split(";").size(), "%s's short lines don't match its sentence: %s" % [cd["name"], str(short)])
		var open: bool = sim.cls == cd["name"] or sim.class_open(str(cd["name"]))     # a locked class: a lock and the head that opens it (24 Oct, option B)
		var lit: bool = (sim.cls == "" or sim.cls == cd["name"] or bk._armed == cd["name"]) and open
		var who: String = str(Words.CLASS_UNLOCK.get(cd["name"], {}).get("who", ""))
		if not open:
			_check(cb.disabled and c["lock"].visible and c["tag"].text == who and c["tag"].get_theme_color("font_color") == Pal.TEXT_3 and c["tag"].position.x >= c["lock"].position.x + c["lock"].size.x and cb.tooltip_text.contains("%s %s" % [Words.OPENS_AFTER, who]), "%s's locked card: '%s', lock %s" % [cd["name"], c["tag"].text, str(c["lock"].visible)])
		else:
			_check(not c["lock"].visible, "%s's card shows a lock and it's open" % cd["name"])
		_check(UI.text_width(c["tag"], c["tag"].text) <= c["tag"].size.x + 0.5 and UI.text_width(c["name"], c["name"].text) <= c["name"].size.x + 0.5, "%s's card's words run past it: '%s' '%s'" % [cd["name"], c["name"].text, c["tag"].text])
		_check(is_equal_approx(c["face"].modulate.a, 1.0 if lit else 0.75), "%s's face is not %s beside the picked past" % [cd["name"], "lit" if lit else "dimmed"])
		_check(cb.tooltip_text.contains(str(cd["words"])), "%s's card does not carry its sentence" % cd["name"])
		var tag_forms: Array = [Words.CLASS_SELECTED] if sim.cls == cd["name"] else (["press again"] if bk._armed == cd["name"] else (bk._crew_tag(cd["name"]) if open else [who]))
		_check(tag_forms.map(func(x): return UI.dots(str(x))).has(c["tag"].text) and not c["tag"].text.begins_with("L1") and not RegEx.create_from_string("^L\\d").search(c["tag"].text), "%s's card's tag reads '%s'" % [cd["name"], c["tag"].text])
		if k > 0:
			_check(not Rect2(cb.position, cb.size).intersects(Rect2(bk._class_buttons[k - 1].position, bk._class_buttons[k - 1].size)), "the pasts' cards overlap")
	_check(bk._face_q.visible == (sim.cls == ""), "the ? in the face's place shows with a past, or not without one")


## The lines over the classes (12 Oct): each on a pill fitted to its words, in the band, clear of the classes and the
## sum; a lone line sits where the notice would, just over the classes, not up a row with a gap under it.
func _line_pill_checks(bk, sum_r: Rect2) -> void:
	var lines: Array = [bk._class_line, bk._notice]
	for k in range(2):
		var l: Label = lines[k]
		var pill: Panel = bk._line_pills[k]
		_check(pill.visible == (l.text != ""), "a line's pill shows without its words, or its words without it: '%s'" % l.text)
		if not pill.visible:
			continue
		var pr := Rect2(pill.position, pill.size)
		var tw: float = UI.text_width(l, l.text)
		var text_r := Rect2(l.position.x + l.size.x - tw, l.position.y + (l.size.y - Pal.CELL_TEXT_BIG) / 2.0, tw, Pal.CELL_TEXT_BIG)
		_check(pr.encloses(text_r) and Rect2(0, 0, Pal.GRID_W, bk.HEAD_H).encloses(pr) and not pr.intersects(sum_r), "a line's pill does not hold its words in the band: %s" % str(pr))
		for cb in bk._class_buttons:
			_check(not pr.intersects(Rect2(cb.position, cb.size)), "a line's pill sits on a class: %s" % str(pr))
	# one line over the cards now (14 Oct): the class's sentence is the cards' tooltip
	_check(not bk._class_line.visible and bk._class_line.text == "", "the class's own line is back over the cards: '%s'" % bk._class_line.text)


## The lore pass (12 Oct, docs/design/lore.md): the opening once on a new camp, the radio's lines after every few runs
## home in order and behind their gates, the gangs by name, the wall's line, the traits, the drawer's new papers at their
## own sites, the Caravan's radio page and the Radio's last line on its pill.
func _lore_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	# the opening is the scenes' alone (18 Oct, Q8): the log starts with the Pitch set, not the old four-day telling
	var y = Sim.new()
	y.start()
	var said: Array = y.events.map(func(e): return str(e[1]))
	_check(said.has(Words.YARD["set"]) and not said.any(func(l): return l in Words.OPENING), "the log still tells the opening: %s" % str(said))
	# the radio: a line every RADIO_EVERY runs home, in order, the zone's and the lorries' gates holding
	_check(y.radio_next().get("key", "") == "loop/0", "the radio's first line is not the loop's: %s" % str(y.radio_next()))
	y.runs_total = Data.RADIO_EVERY
	y._radio_after_run()
	_check(y.heard == ["loop/0"] and str(y.events.back()[1]).begins_with(Words.RADIO_LEAD), "the radio didn't come on after %d runs: %s" % [Data.RADIO_EVERY, str(y.heard)])
	_check(Words.toast_tone(str(y.events.back()[1])) == "none", "the radio's line toasts: the radio line plays it (13 Oct)")
	y.runs_total = Data.RADIO_EVERY + 1
	y._radio_after_run()
	_check(y.heard.size() == 1, "the radio came on off its beat")
	y.runs_total = 2 * Data.RADIO_EVERY
	y._radio_after_run()
	y.runs_total = 3 * Data.RADIO_EVERY
	y._radio_after_run()
	_check(y.heard == ["loop/0", "loop/1"] and y.radio_next().is_empty(), "the Outskirts' radio is past its gate: %s, next %s" % [str(y.heard), str(y.radio_next())])
	var story: Array = Words.RADIO.filter(func(r): return not r.has("gate") and not r.has("room") and not r.has("deeds"))     # the gates', the rooms' and the deeds' lines aren't the story (13 Oct; 27 Oct)
	var last: Dictionary = story.back()
	_check(last.has("lorries") and str(last["text"]).contains("Let it be done"), "the radio's story doesn't close on the decree")
	for r in Words.RADIO:
		_check(Words.RADIO_VOICES.has(r["voice"]) and Words.RADIO_SHORT.has(r["voice"]) and str(r["text"]).ends_with(".") and (r.has("zone") or r.has("lorries")), "a radio line is off: %s" % str(r))
	# the gangs by name, the wall, the traits
	for z in range(Data.ZONES.size()):
		var tz: int = Data.ZONES[z]["tiers"][0]
		var gl: String = y.gang_line({"tier": tz, "patrols": 1}, 3)
		_check(z < Words.GANGS.size() and gl.begins_with(Words.GANGS[z]["name"] + ", 3 of them. "), "%s's gang line is off: '%s'" % [Data.ZONES[z]["name"], gl])
	for cd in Data.CLASSES:
		_check(Words.PASTS.has(cd["name"]) and str(Words.PASTS[cd["name"]].get("wall", "")).ends_with("."), "the %s has no line on the wall" % cd["name"])
	for row2 in Data.TRAITS:
		_check(Words.TRAITS.has(row2["name"]) and str(Words.TRAITS[row2["name"]]).ends_with("."), "the %s trait has no line" % row2["name"])
	# the new papers: each at its own site, with its words
	for pair in [["A seed order", "The Allotments"], ["An allotment waiting list", "The Allotments"], ["A loyalty card", "The Garden Centre"], ["A milk quota letter", "Top Farm"],
			["A delivery note", "The Services"], ["A drug chart", "The Hospital"], ["A leave pass", "The Barracks"], ["A requisition", "The Barracks"]]:
		_check(Items.exclusive_to(pair[0]) == pair[1] and Words.item_words(pair[0]).ends_with("."), "%s is not %s's paper, or has no line" % pair)
	# the Caravan's radio page, and the Radio's last line on its pill
	sim.heard = ["loop/0", "kev/3"]
	main.show_room(main.BARRACKS)
	var bk = main._barracks
	bk._shown = ""
	main.refresh()
	_check(bk.also_names().has("The wireless"), "the radio's page is not in the Also row")
	bk.pick_also("The wireless")
	main.refresh()
	_check(bk._cells[0]["name"].text == "1. " + Words.RADIO_VOICES["loop"] and bk._cells[1]["name"].text == "2. " + Words.RADIO_VOICES["kev"] and bk._cells[1]["lines"][0].text != "", "the radio's page is off: '%s' / '%s'" % [bk._cells[0]["name"].text, bk._cells[1]["name"].text])
	var rb = bk.also_button("The wireless")
	_check(rb != null and rb.visible and rb.text.contains("2 of %d" % Words.RADIO.size()), "the radio's chip is off the Also row, or off: %s" % (rb.text if rb != null else "hidden"))
	_check_fit(main, "Caravan (the radio)")
	# every line the radio has, and every paper's words, fit their cards (the reviewer: two lines ran past two rows)
	sim.heard = []
	for k in range(Words.RADIO.size()):
		sim.heard.append("%s/%d" % [Words.RADIO[k]["voice"], k])
	bk._shown = ""
	main.refresh()
	var radio_pages: int = int(bk._radio_branch()["pages"])
	for pg in range(radio_pages):
		bk.drawer_page = pg
		bk._shown = ""
		main.refresh()
		_check_fit(main, "Caravan (the radio, page %d)" % (pg + 1))
		for c in bk._cells:
			if c["button"].visible:
				for l in c["lines"]:
					if l.visible and l.text != "":
						_check(not l.text.ends_with("…") and UI.text_width(l, l.text) <= l.size.x + 0.5, "a radio line runs past its card: '%s'" % l.text)
	bk.drawer_page = 0
	bk.pick_also("The wireless")
	var book_keep: Array = sim.book.duplicate()
	sim.book = sim.book_pages().duplicate()
	bk.pick_also("The drawer")
	var drawer_pages: int = int(bk._drawer_branch()["pages"])
	for pg in range(drawer_pages):
		bk.drawer_page = pg
		bk._shown = ""
		main.refresh()
		_check_fit(main, "Caravan (the drawer, page %d)" % (pg + 1))
		for c in bk._cells:
			if c["button"].visible:
				for l in c["lines"]:
					if l.visible and l.text != "":
						_check(UI.text_width(l, l.text) <= l.size.x + 0.5, "a paper's words run past its card: '%s'" % l.text)
	bk.drawer_page = 0
	bk.pick_also("The drawer")
	sim.book = book_keep
	sim.heard = ["loop/0", "kev/3"]
	main.show_room(main.COMMS)
	main._radio._shown = ""
	main.refresh()
	_check(str(Words.RADIO[3]["text"]).begins_with(main._radio._heard.text.trim_suffix(".")) and main._radio._heard_pill.visible, "the Radio doesn't show the last line heard: '%s'" % main._radio._heard.text)
	var hp_r := Rect2(main._radio._heard_pill.position, main._radio._heard_pill.size)
	_check(hp_r.position.x >= 0.0 and hp_r.end.x <= Pal.GRID_W and hp_r.end.y <= main._radio.HEAD_H, "the Radio's pill runs out of its band: %s" % str(hp_r))
	_check_fit(main, "Radio (the last line heard)")
	sim.load_dict(saved)
	main.refresh()
	print("the lore ok: the opening, the radio's order and gates, the gangs, the wall, the traits, the new papers, the radio page and its pill")


## Tins at their worst (13 Oct, the reviewer: "4,816 tins" runs past what "£4,816" fitted): the Clinic's tiles and
## buttons at level 50 with a wound, the run's take tile at six figures, the Fence's offers, all fitting.
