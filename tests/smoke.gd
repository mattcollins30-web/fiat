## The stash's tabs (21 Oct, Matt: "a shared tab between all classes and then one or two per class that isn't shared"):
## the class's own tab and its second with the Dry store, a piece moved to one and its cells counted there, the tabs
## going with the class on a swap and back, the save, and the Kit's grid showing a tab's alone, a drop moving it.
func _stash_tab_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	if sim.cls == "":
		sim.set_class("Doorman")
	var me: String = sim.cls
	sim.yard_picks.erase("stash")
	_check(sim.stash_tabs().map(func(t): return t[0]) == ["", "own"] and sim.tab_cap("own") == Data.CLASS_TAB_CELLS and sim.tab_cap("own2") == 0, "the tabs without the Dry store: %s" % str(sim.stash_tabs()))
	var piece: Dictionary = sim._plain("Armour", "Work jacket")
	sim.stash.append(piece)
	var shared0: int = sim.stash_used()
	_check(sim.move_to_tab(int(piece["id"]), "own") and sim.stash_used() == shared0 - Items.size(piece) and sim.tab_used("own") >= Items.size(piece) and not sim.move_to_tab(int(piece["id"]), "own2"), "a piece to the class's tab: shared %d from %d, own %d" % [sim.stash_used(), shared0, sim.tab_used("own")])
	# the tab goes with the class: out of the stash on a swap, back on the swap back
	var other: String = "Poacher" if me != "Poacher" else "Doorman"
	_check(sim.set_class(other) and not sim.stash.has(piece) and sim.roster[me]["tab_items"].has(piece) and sim.item_by_id(int(piece["id"])).is_empty(), "the class's tab stayed in the stash on a swap")
	_check(sim.tab_used("own") == 0, "the next class's tab is not their own: %d cells" % sim.tab_used("own"))
	var d: Dictionary = JSON.parse_string(JSON.stringify(sim.to_dict()))
	var back = Sim.new()
	back.load_dict(d)
	_check(back.roster[me]["tab_items"].size() >= 1 and typeof(back.roster[me]["tab_items"][0]["id"]) == TYPE_INT, "the class's tab did not survive a save")
	_check(sim.set_class(me) and sim.stash.has(piece) and sim.tab_of(piece) == "own", "the class's tab did not come back with them")
	# the second tab, with the Dry store
	_yard_ids(sim, ["dry_store", "annex"], "dry_store")
	_check(sim.yard_has("dry_store") and sim.stash_tabs().size() == 3 and sim.tab_cap("own2") == Data.CLASS_TAB_CELLS and sim.move_to_tab(int(piece["id"]), "own2"), "the Dry store's second tab: %s" % str(sim.stash_tabs()))
	# the Kit's grid: the tabs on bar two, a tab's pieces alone, a drop on a tab moves the piece there
	main.show_room(main.ARMOURY)
	var inv = main._armoury._inv
	inv._set_tab(2)
	main.refresh()
	_check(inv.tab == "own2" and inv.items.size() >= 1 and inv.items.all(func(it): return sim.tab_of(it) == "own2"), "the Kit's grid shows another tab's pieces on the second: %s" % str(inv.items.map(func(it): return sim.tab_of(it))))
	var tabs_r: Array = inv._tab_buttons.filter(func(b): return b.visible).map(func(b): return Rect2(b.position, b.size))
	_check(tabs_r.size() == 3 and tabs_r.all(func(r): return not r.intersects(Rect2(inv._page_prev.position, inv._page_prev.size)) and not r.intersects(Rect2(inv._many_button.position, inv._many_button.size)) and not r.intersects(Rect2(inv._rarity_button.position, inv._rarity_button.size))), "the stash's tabs sit on bar two's buttons: %s" % str(tabs_r))
	_check_fit(main, "the Kit, the class's second tab")
	# the Dry store refitted away: the second tab folds into the first, nothing left in a tab not shown
	_yard_ids(sim, ["dry_store", "annex"], "annex")
	_check(not sim.yard_has("dry_store") and sim.tab_of(piece) == "own" and sim.stash.all(func(it): return sim.stash_tabs().any(func(t): return t[0] == sim.tab_of(it))), "the Dry store's refit left pieces in a tab not shown")
	_yard_ids(sim, ["dry_store", "annex"], "dry_store")
	while not sim.stash_room(Items.size(piece)):     # room on the shared tab for it (21 Oct, a flake: the smoke's leavings filled it)
		var spare: Array = sim.stash.filter(func(x): return x != piece and sim.tab_of(x) == "" and not sim.stash_free(x))
		if spare.is_empty():
			break
		sim.stash.erase(spare[0])
	inv._drop_tab(Vector2.ZERO, {"id": int(piece["id"]), "src": "stash"}, 0)
	_check(sim.tab_of(piece) == "", "a piece dropped on the shared tab did not move there")
	# out of the stash, out of its tab: worn from the class's tab with the shared one full, and back
	sim.move_to_tab(int(piece["id"]), "own")
	var worn_was = sim.equipped["Armour"]
	var fill: Array = []
	while sim.stash_room(1):
		var b: Dictionary = sim._plain(Data.MEDICAL, "Bandage")
		if sim.stash_free(b):
			break
		sim.stash.append(b)
		fill.append(b)
	var can: bool = sim.can_equip_item(int(piece["id"]))
	if can:
		sim.equip_item(int(piece["id"]))
		_check(sim.stash_used() <= sim.stash_cap() and not piece.has("tab"), "worn off the class's tab: the shared tab at %d of %d, the tab kept %s" % [sim.stash_used(), sim.stash_cap(), str(piece.get("tab", ""))])
	else:
		_check(worn_was != null and Items.size(worn_was) > 0, "a piece off the class's tab would not go on with nothing to come off")
	# a stack in the class's tab splits there with the shared tab full; a piece taken off it leaves the tab
	var fluid: Dictionary = sim._plain("Attachment", "Lighter fluid")
	Items.set_stack(fluid, 4)
	sim.stash.append(fluid)
	fluid["tab"] = "own"
	var shared1: int = sim.stash_used()
	_check(Items.stacks(fluid) and sim.split_stack(int(fluid["id"])) and sim.tab_of(sim.stash[-1]) == "own" and sim.stash_used() == shared1, "a stack in the class's tab split into the shared one: shared %d from %d, the half's tab '%s'" % [sim.stash_used(), shared1, sim.tab_of(sim.stash[-1])])
	var one: Dictionary = sim._one_off(fluid)
	_check(not one.has("tab") and sim.tab_of(fluid) == "own", "a piece off a stack in the class's tab kept the tab: '%s'" % str(one.get("tab", "")))
	inv._set_tab(0)
	sim.load_dict(saved)
	main.refresh()


## The runner as a class, in place (21 Oct, the crew: a pick swaps runners now, so the mechanics areas relabel the one
## they have): another class's trees, another class's half and an element off the pair go, as a change's did.
func _set_cls(s, name: String) -> void:
	if s.cls == name:
		return
	if s.cls == "":
		s.set_class(name)                    # a runner with no class: the first pick, as the screen makes it
		return
	s.cls = name
	s.tree = s.tree.filter(func(id):          # the skill web (3 Nov): another class's corner and start go, the rest stays
		var rg: String = Data.web_region(str(id))
		return s.is_ring(str(id)) or not rg.begins_with("class:") or rg == "class:" + name)
	s._ensure_start(false)
	s._caches_out()


## A class through the Training screen: one press for the first pick, two for a swap.
func _press_class(main, name: String) -> void:
	main._barracks._pick_class(name)
	if main._barracks._armed == name:
		main._barracks._pick_class(name)


const SMOKE_SEED := 1025                  # the smoke's dice (25 Oct)
const SMOKE_WALL_MS := 600000            # the bot loops' guard: ten minutes of wall, never reached on a healthy run


func _init() -> void:
	load("res://scripts/ui/barracks.gd").clip_off = true     # the smoke never writes the system clipboard (the fix round, 30 Oct: it ran beside Matt's work)
	Sim.exploits_off = true     # no other check meets an exploit by chance (the review); _exploit_checks turns them on
	# fixed dice (25 Oct, the tools review): a red replays with the same seed; `-- seed N` picks another, `-- seed random` a fresh one, printed
	var args := OS.get_cmdline_user_args()
	var si := args.find("seed")
	var seed_word: String = str(args[si + 1]) if si >= 0 and si + 1 < args.size() else str(SMOKE_SEED)
	if seed_word == "random":
		seed_word = str(1 + (int(Time.get_ticks_usec()) % 999983))     # a fresh one, printed so its red replays with `-- seed N` (the second review)
	Sim.fixed_seed = int(seed_word)
	seed(Sim.fixed_seed)
	print("SMOKE seed %s" % seed_word)
	var main = load("res://scripts/ui/main.gd").new()
	main.intro = false
	# the smoke saves to its own files, never the player's (7 Oct: it wrote slot 1 and took the autosave on the Legion)
	main.save_file = SMOKE_SAVE
	main.slot_file = SMOKE_SLOT
	_player_saves_before = _player_saves()
	root.add_child(main)
	main.new_game()
	if main._barracks.web().has_method("warm_step"):     # (b44's code, the guard's red proof, has none)
		while not main._barracks.web().warm_step(main.sim):
			pass                                 # Training's web laid out, as the title's seconds lay it in the game (BUILD45)
		main._warm_done = true
	_check(main.sim.mythics_on, "a new camp has the mythics off")
	_check(main.sim.cls == "Poacher" and main.sim.next_words() != Words.NEXT["past"], "a new game doesn't start as the Poacher: '%s', '%s'" % [main.sim.cls, main.sim.next_words()])
	main.sim.mythics_on = false            # the smoke's camps find no mythics on their own (17 Oct: a full pack keeps one now - a bot's Bomb Disposal Suit stopped the clock, its moment held the game); the mythics' own checks make theirs
	_gates_checks(main)                          # the shut rooms on a fresh camp, before the smoke opens them all (13 Oct)
	_open_camp(main.sim)
	var sim = main.sim
	_set_cls(sim, "Doorman")
	_check(sim.cls == "Doorman", "sim.cls == 'Doorman'")
	_check(sim.cash == float(Data.STARTING_CASH), "sim.cash == float(Data.STARTING_CASH)")
	_check(sim.equipped["Primary"] != null, "sim.equipped['Primary'] != null")
	var only: Array = _only_areas()
	if not only.is_empty():
		_run_only(main, only)
		return
	_rarity_tone_checks(sim)
	for r in main.ROOMS:
		main.show_room(r)
		_check_fit(main, r + " (start)")
	_part_name_checks(main)
	_rig_layout_checks()
	# the Pitch's prices move in steps (20 Oct, Matt's video: a few tins a click): to the hundred, the thousand past 100k
	_check(Sim._round_price(1234) == 1200 and Sim._round_price(82611) == 82600 and Sim._round_price(154321) == 154000 and Sim._round_price(950) == 950, "the Pitch's prices aren't rounded")
	_try_on_rounds_checks(main.sim)
	_pitch_scramble_checks(main)
	# the bot: deploy to the best open tier the operator can probably survive,
	# gear up from the stash after each mission, sell commons, treat when hurt
	var runs := 0
	var kias := 0
	var meds_used := 0
	var t_start := Time.get_ticks_msec()
	while not sim.depot_cleared and runs < 300 and Time.get_ticks_msec() - t_start < SMOKE_WALL_MS:     # capped by runs; the wall only against a hang (25 Oct: the cloud stopped early and tested another camp)
		var t := _pick_tier(sim)
		if sim.hp < sim.max_hp() * 0.7:
			if not sim.treat():
				sim.advance(120.0)            # rest instead
				continue
		sim.deploy(t)
		var guard := 0
		while sim.on_mission() and guard < 10000:
			sim.advance(1.0)
			if sim.on_mission() and sim.hp < sim.max_hp() * 0.4 and sim.mission["using"] == null and not sim.first_med().is_empty():
				sim.use_med(sim.first_med()["id"])
				meds_used += 1
			if guard == 20 or (sim.searching() and guard % 7 == 0 and runs % 5 == 0):
				main.show_room(main.MISSIONS)
				_check_fit(main, "Missions (live, run %d)" % runs)
			if guard == 5 and runs == 0 and sim.on_mission() and not sim.searching():
				# the damage line moves with the fight (8 Oct): what landed this second is on the mission, and the
				# line eased toward it sits somewhere other than the Yard's share
				_check(float(sim.mission.get("landed_rate", 0.0)) > 0.0, "a fight five seconds in has landed nothing a second")
				var at_rest: float = main._dps_share()
				main.refresh()                 # the line's target is the refresh's (BUILD43): per frame it only eases
				for k in range(30):
					main._move_dps_line(0.1)
				var shown: float = main._top_lines["dps"][1].size.x / main._top_lines["dps"][0].size.x
				# eased to what lands, not left at the Yard's share: the share scaled by landed over the sheet's figure (a
				# fight landing near the sheet's figure barely moves it - the old "moved by 0.01" test flaked there, 10 Oct)
				var want: float = minf(at_rest * clampf(float(sim.mission["landed_rate"]) / maxf(float(sim.damage_split()["hits"]), 1.0), 0.0, 1.6), 1.0)     # the sheet's hits, the type edge in (29 Oct)
				_check(absf(shown - want) < 0.005, "the damage line reads %.3f mid-fight, not %.3f (the Pitch's share %.2f, %.1f landing a second against %.1f)" % [shown, want, at_rest, float(sim.mission["landed_rate"]), sim.dps()])
			# the bot bails at a quarter HP, like a player would
			if sim.on_mission() and (sim.hp < sim.max_hp() * 0.25 or (sim.searching() and sim.pack_used(sim.mission) >= sim.capacity()) or guard > 1200):
				sim.extract_now()
			guard += 1
		runs += 1
		if sim.last_report["outcome"] == "KIA":
			kias += 1
		for s in Data.SLOTS:
			sim.equip_best(s)
		sim.sell_rarity(0)                 # the Fence's Commons button (31 Oct: the tests' sell_commons went)
		_sell_spares(sim)
		_buy_upgrade(sim)
		_restock_meds(sim)
		_train_tree(sim)
		_climb(sim)
		_bench(sim)
		if runs % 10 == 0:
			for r in main.ROOMS:
				main.show_room(r)
				_check_fit(main, "%s (run %d)" % [r, runs])
	print("depot %s after %d missions, %d KIA, %d meds used, %s played: level %d, cash £%d, dps %.0f, armour %.0f, stash %d, depths %s" % [
			"cleared" if sim.depot_cleared else "NOT cleared", runs, kias, meds_used, _hours(sim.elapsed), sim.level(), int(sim.cash),
			sim.dps(), sim.armour(), sim.stash.size(), str(sim.best_depth)])
	# keep climbing for a while after the depot: how deep does the bot get in three hours?
	var started := Time.get_ticks_msec()
	while sim.elapsed < 1.5 * 3600.0 and runs < 200 and Time.get_ticks_msec() - started < SMOKE_WALL_MS:
		var t := _pick_tier(sim)
		if sim.hp < sim.max_hp() * 0.7 and not sim.treat():
			sim.advance(120.0)
			continue
