		var m10: Dictionary = sim.mission
		m10["remaining"] = 5
		m10["target_hp"] = 1e9
		m10["clock"] = 1e6
		var box10: Dictionary = sim._plain(Data.AMMO, "Shells")
		m10["found"].append(box10)
		var fgun: Dictionary = sim._plain("Secondary", "Service pistol")
