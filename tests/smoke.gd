	_check_fit(main, "Fence (salt)")
	# (the papers' picture: _art_inventory_checks, the fix round, 30 Oct)
	sim.load_dict(saved)
	# the boss toggle on the Runs card: one press, one toast, however many refreshes follow
	_finish_campaign(sim)
	sim.notes = 1000
	sim.arm_boss(5, false)
	main._juice._toasts = []
	main.show_room(main.MISSIONS)
	main._missions.select(5)                 # the Retail Park: the Carpet Man's
	main.refresh()
	main._missions._cols[0]["card"].head_btn.pressed.emit()     # the card's Head (BUILD48 item 1: the foot's button went)
	for k in range(4):
		main._missions._shown = ""
		main.refresh()
	var boss_toasts: int = main._juice.lines().filter(func(l): return str(l).begins_with("The Carpet Man: ")).size()
	_check(boss_toasts == 1, "the boss toggle toasted %d times" % boss_toasts)
	main._missions._cols[0]["card"].gang_btn.pressed.emit()
	main.refresh()
	main._missions._cols[0]["card"].head_btn.pressed.emit()
	main.refresh()
	boss_toasts = main._juice.lines().filter(func(l): return str(l).begins_with("The Carpet Man: ")).size()
	_check(boss_toasts == 1, "toggling off and on again toasted again while the first still showed: %d" % boss_toasts)
	# the odds read a few milliseconds a frame (main._read_odds, 7 Oct) and settle; a refresh never runs one;
	# without the shell's brake, all at once
	sim._surv_cache = {}
	sim.odds_budget = main.ODDS_BUDGET
	main.show_room(main.MISSIONS)
	main._missions._shown = ""
	var odds_t0 := Time.get_ticks_usec()
	main.refresh()
	var refresh_ms := (Time.get_ticks_usec() - odds_t0) / 1000.0
	var settled_at_once := 0
	for i in range(Data.TIERS.size()):
		if sim.tier_open(i):
			if sim.odds_settled(i):
				settled_at_once += 1
	_check(settled_at_once == 0, "a refresh of the Runs screen read the odds itself (%d settled)" % settled_at_once)
	odds_t0 = Time.get_ticks_usec()
	main._read_odds()
	var frame_ms := (Time.get_ticks_usec() - odds_t0) / 1000.0
	_check(frame_ms < main.ODDS_MS + 150.0, "one frame's odds took %.0f ms (the brake is %.0f ms and one dry run)" % [frame_ms, main.ODDS_MS])
	if sim.on_mission():
		sim.extract_now()                        # the odds read only at home on the Map (main._read_odds): a run left on reads nothing (the review)
	main.show_room(main.MISSIONS)
	# a gun with rounds for the read (16 Oct): the bot's run can leave the runner dry, and fists against the City's
	# sites make every dry run long enough to starve the read - the frames are what's under test, not a dry gun
	var fed_box: Array = []
	var gun_now = sim.equipped["Primary"]
	if gun_now != null and Items.ammo_type(gun_now) not in ["", "none"] and sim.rounds_for(gun_now) < 6 * Items.mag_size(gun_now):
		var feed_bx: Dictionary = sim.ammo_box(Items.ammo_type(gun_now))
		if not feed_bx.is_empty():
			fed_box = _rmags(sim, str(feed_bx["name"]), 6)     # several magazines: a pile that reloads (the fix round)
			sim.rig.append_array(fed_box)
			sim._surv_cache = {}
	var frames := 0
	var key_moves := {}                         # for the failure's words: a key that moves restarts the read (14 Oct)
	var keys0 := {}
	for i in range(Data.TIERS.size()):
		keys0[i] = str(sim._odds_key(i))
	while frames < 6000:                        # 2000 flaked on the Barracks' long dry runs with the machine still loaded (15 Oct)
		for i in range(Data.TIERS.size()):
			if sim.tier_open(i) and not sim.odds_settled(i):
				main._missions.selected = i     # each picked in turn: the Map reads the place picked alone (BUILD48 A, item 3)
				break
		main._read_odds()
		frames += 1
		for i in range(Data.TIERS.size()):
			var kn := str(sim._odds_key(i))
			if kn != keys0[i]:
				key_moves[i] = int(key_moves.get(i, 0)) + 1
				keys0[i] = kn
		var all_settled := true
		for i in range(Data.TIERS.size()):
			if sim.tier_open(i) and not sim.odds_settled(i):
				all_settled = false
		if all_settled:
			break
	for i in range(Data.TIERS.size()):
		if sim.tier_open(i):
			var oc: Array = sim._surv_cache.get(i, [])
			_check(sim.odds_settled(i), "tier %d's odds never settled in %d frames: on a run %s, %s of %d reads (cap %d), key moved %d times, cache key now %s" % [i, frames, sim.on_mission(), str(oc[2]) if oc.size() > 2 else "none", sim.odds_runs(), sim.odds_runs_max, int(key_moves.get(i, 0)), str(oc.size() > 0 and str(oc[0]) == str(sim._odds_key(i)))])
	main._missions._shown = ""
	main.refresh()
	_check_fit(main, "Runs (odds settled)")
	print("the odds settled in %d frames; a refresh took %.0f ms" % [frames, refresh_ms])
	sim.odds_budget = 0
	sim._surv_cache = {}
	_check(sim.survival(3) >= 0.0 and sim.odds_settled(3), "without a budget the odds did not read at once")
	# a read that is plainly settled settles early: a runner nothing can touch reads 100% after EARLY_RUNS
	var hold_hp: float = sim.hp
	var hold_x: float = sim.xp
	sim.xp = Data.xp_for_level(90)
	sim.hp = sim.max_hp()
	sim._surv_cache = {}
	_check(sim.survival(3) >= 0.999 and sim._surv_cache[3][2] == sim.odds_runs(), "a level-90 runner on the first site did not read as settled 100%%: %.2f" % sim.survival(3))
	sim.xp = hold_x
	sim.hp = hold_hp
	for fb in fed_box:
		sim.rig.erase(fb)                   # after the level-90 read (23 Oct): a gun the bot's run left dry reads 0% there too
	sim._surv_cache = {}
	# the balance gate's brakes stay off in the shell (8 Oct): the player's read is the lookout's full count, read fresh
	_check(not sim.fast_memo and sim.odds_runs_max == 0, "the shell's sim has the gate's brakes on: fast_memo %s, odds_runs_max %d" % [sim.fast_memo, sim.odds_runs_max])
	# and the odds key rounds the HP tenth: a rest to full that lands a hair under reads as the full one
	sim.hp = sim.max_hp() - 0.01
	var k_near: Array = sim._odds_key(3)
	sim.hp = sim.max_hp()
	_check(k_near == sim._odds_key(3), "a hair under full HP re-reads the odds")
	print("the playtest's five ok: HP, Locked, the toasts, the log line, a paper in the Lock-up; the odds settle over refreshes")


func _recycle_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	sim.loose_kit = []
	sim.hardcore = false
	var jacket: Dictionary = sim._plain("Armour", "Riot suit")
	jacket["affixes"] = [{"stat": "hp", "value": 33.0, "tier": 3}]
	jacket["rarity"] = 2
	sim.equipped["Armour"] = jacket
	var cls_before: String = sim.cls
	sim.words[3] = []
	sim.set_depth(3, 1)
	sim.hp = sim.max_hp()
	sim.insure_next = false
	sim.deploy(3)
	sim._kia()
	_check(sim.loose_kit.size() >= 1 and sim.loose_kit.any(func(e): return e["item"]["base"] == "Riot suit" and e["who"] == "the last %s" % cls_before and e["from"] == "runner"), "the dead runner's jacket did not go out on the estate: %s" % str(sim.loose_kit.map(func(e): return e["item"]["base"])))
	_check(str(sim.events.back()[1]).ends_with(Words.RECYCLE["listed"]) or sim.events.any(func(ev): return str(ev[1]).ends_with(Words.RECYCLE["listed"])), "the death's line does not say the kit will turn up")
	sim.loose_kit = sim.loose_kit.filter(func(e): return e["item"]["base"] == "Riot suit")   # the rest of the kit: the jacket's the one followed here
	# a unique sold to the Fence goes on the list too
	var u: Dictionary = Items.roll_unique(sim._unique_named("Lucky Cap"), sim.rng)
	sim.stash.append(u)
	sim.sell(u)
	_check(sim.loose_kit.any(func(e): return e["from"] == "fence" and e["item"].get("unique", "") == "Lucky Cap"), "the unique sold did not go out on the estate")
	# too soon: nothing on the first runs; then one of them is wearing it
	sim.hp = sim.max_hp()
	sim.deploy(3)
	var m: Dictionary = sim.mission
	_check(not m.has("wearing"), "the kit turned up on the very next run")
	sim.extract_now()
	sim.runs_total += Data.RECYCLE_RUNS
	sim.hp = sim.max_hp()
	sim.deploy(3)
	m = sim.mission
	if not m.has("wearing"):
		sim._maybe_wearing(m, true)          # the deploy's own roll may have put it on someone already
	_check(m.has("wearing") and m["wearing"]["item"]["base"] == "Riot suit", "nobody was wearing the jacket when forced: %s" % str(m.get("wearing", {})))
	_check(sim.events.any(func(ev): return str(ev[1]) == Words.RECYCLE["wearing"] % ["the last %s" % cls_before, "riot suit"]), "the wearing line is off: %s" % str(sim.events.back()[1]))
	var found_before: int = m["found"].size()
	sim._clear(m, m["t"])
	_check(m["found"].size() == found_before + 1 and m["found"].back()["base"] == "Riot suit" and m["found"].back()["affixes"][0]["value"] == 33.0 and not m.has("wearing"), "the jacket did not come off him with its affix: %s" % str(m["found"].back() if not m["found"].is_empty() else {}))
	_check(sim.events.any(func(ev): return str(ev[1]).begins_with("The riot suit came off him. The last")), "the off line is off: %s" % str(sim.events.back()[1]))
	sim.extract_now()
	_check(sim.stash.any(func(it): return it["base"] == "Riot suit" and it["affixes"].size() == 1 and it["affixes"][0]["value"] == 33.0), "the jacket did not come home")
	# the unique, the same way
	sim.hp = sim.max_hp()
	sim.deploy(3)
	m = sim.mission
	if not m.has("wearing"):
		sim._maybe_wearing(m, true)
	_check(m.has("wearing") and m["wearing"]["from"] == "fence", "the sold unique was not on anyone: %s" % str(m.get("wearing", {})))
	_check(sim.events.any(func(ev): return str(ev[1]) == Words.RECYCLE["has"] % "Lucky Cap"), "the has line is off: %s" % str(sim.events.back()[1]))
	sim._clear(m, m["t"])
	_check(not m["found"].is_empty() and m["found"].back().get("unique", "") == "Lucky Cap", "the unique did not come off him")
	sim.extract_now()
	_check(sim.loose_kit.is_empty() or not sim.loose_kit.any(func(e): return e["item"].get("unique", "") == "Lucky Cap"), "the unique stayed on the list after coming back")
	var d: Dictionary = sim.to_dict()
	sim.load_dict(d)
	_check(d.has("loose_kit"), "the list does not save")
	sim.load_dict(saved)
	print("the estate recycles ok: the dead runner's kit, the sold unique, too soon, worn, off him, home, saved")


## Money that goes off: every cash price and every cash income rises with the
## yard's hours, after a grace hour, to a ceiling; the notes don't move; the
## fence and the Played card say so.
func _inflation_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	sim.elapsed = 0.0
	_check(is_equal_approx(sim.inflation(), 1.0) and sim.inflation_pct() == 0, "prices rose in the first hour: %.2f" % sim.inflation())
	sim.elapsed = Data.INFLATION_GRACE_H * 3600.0
	_check(is_equal_approx(sim.inflation(), 1.0), "prices rose before the grace hour was out")
	var it: Dictionary = sim._plain("Primary", "Pipe shotgun")
	var p0: int = sim.price(it)
	var s0: int = sim.sell_price(it)
	var med_it: Dictionary = sim._plain(Data.MEDICAL, str(Data.BASES["Medical"][0]["name"]))
	var med0: int = sim.clinic_price(med_it)
	var ammo0: int = sim.ammo_price("shotgun")
	var ws0: int = sim.yard_pick_cost("bench", 4) if sim.yard_side("bench", 4) == "" else 0
	sim.hp = sim.max_hp() * 0.5
	var treat0: int = sim.treat_cost()
	sim.elapsed = (Data.INFLATION_GRACE_H + 10.0) * 3600.0
	var m: float = 1.0 + Data.INFLATION_RATE * 10.0
	_check(is_equal_approx(sim.inflation(), m), "ten hours past the grace reads %.2f, not %.2f" % [sim.inflation(), m])
	_check(sim.price(it) == int(round(p0 * m)) or absi(sim.price(it) - int(round(p0 * m))) <= 1, "the Fence's asking price did not rise: %d -> %d" % [p0, sim.price(it)])
	_check(absi(sim.sell_price(it) - int(round(s0 * m))) <= 1, "the Fence's paying price did not rise: %d -> %d" % [s0, sim.sell_price(it)])
	_check(absi(sim.clinic_price(med_it) - int(round(med0 * m))) <= 1, "meds did not rise")
	_check(absi(sim.ammo_price("shotgun") - int(round(ammo0 * m))) <= 1, "shells did not rise")
	# a standard box on the shelf costs what the box row charges for it; special rounds carry the markup
	for type in ["pistol", "shotgun", "rifle", "smg", "improvised"]:
		var box: Dictionary = sim._plain(Data.AMMO, sim.ammo_box(type)["name"])
		_check(sim.price(box) == sim.ammo_price(type), "%s on the shelf: %d, the box row: %d" % [type, sim.price(box), sim.ammo_price(type)])
	for b in Data.BASES[Data.AMMO]:
		if b.has("damage_pct"):
			var special: Dictionary = sim._plain(Data.AMMO, b["name"])
			_check(sim.price(special) > sim.ammo_price(str(b["type"])), "%s is no dearer than the plain box" % b["name"])
			break
	# and the shelf never stocks a standard box at all: the box row has those without end
	var plain_on_shelf := 0
	var specials := 0
	for k in range(40):
		sim.restock()
		for stocked in sim.market:
			if Items.is_ammo(stocked):
				if Items.base_of(stocked).has("damage_pct"):
					specials += 1
				elif stocked["affixes"].is_empty():
					plain_on_shelf += 1
	_check(plain_on_shelf == 0, "the shelf stocked a standard box %d times over forty restocks" % plain_on_shelf)
	_check(specials > 0 or sim.gear_tier() < 2, "forty restocks at gear tier %d put no special rounds on the shelf" % sim.gear_tier())
	# the Clinic with nothing picked: the rig's summary, and no button acting on something unpicked
	main.show_room(main.MEDIC)
	main._clinic.selected = {}
	main.refresh()
	var any_button := false
	for b in main._clinic._buttons:
		any_button = any_button or b.visible
	_check(not any_button, "the Clinic's empty panel shows a button: %s" % str(main._clinic._buttons.map(func(b): return b.text if b.visible else "")))
	_check_fit(main, "Clinic (nothing picked)")
	_check(ws0 == 0 or absi(sim.yard_pick_cost("bench", 4) - int(round(ws0 * m))) <= maxi(1, int(ws0 * m / 100000.0) * 1000 + 100), "the Pitch's prices did not rise: %d -> %d" % [ws0, sim.yard_pick_cost("bench", 4)])
	_check(absi(sim.treat_cost() - int(round(treat0 * m))) <= 2, "treatment did not rise: %d -> %d" % [treat0, sim.treat_cost()])
	_check(sim.boss_cost(3) == sim.boss_cost(3) and Data.CRAFT["bump"].has("notes"), "notes prices exist to hold")
	var c0: int = sim.craft_cost(it, "affixes")
	sim.elapsed = Data.INFLATION_GRACE_H * 3600.0
	var c_base: int = sim.craft_cost(it, "affixes")
	_check(c0 < 0 or absi(c0 - int(round(c_base * m))) <= 1, "the Bench's cash price did not rise: %d -> %d" % [c_base, c0])
	# the gangs carry today's money: a run's cash scales too
	sim.elapsed = (Data.INFLATION_GRACE_H + 10.0) * 3600.0
	sim.words[3] = []
	sim.set_depth(3, 1)
	sim.hp = sim.max_hp()
	sim.deploy(3)
	var mm: Dictionary = sim.mission
	var t: Dictionary = mm["t"].duplicate(true)
	t["cash"] = 100.0
	var cash_before: float = mm["cash"]
	sim._kill(mm, t)
	_check(mm["cash"] - cash_before >= 100.0 * 0.5 * m * 0.99, "a kill's cash did not carry today's money: %.0f for a gang carrying 100 at ×%.2f" % [mm["cash"] - cash_before, m])
	sim.extract_now()
	# the ceiling
	sim.elapsed = 100000.0 * 3600.0
	_check(is_equal_approx(sim.inflation(), Data.INFLATION_CAP), "prices did not settle at the ceiling: %.2f" % sim.inflation())
	# the screens
	sim.elapsed = (Data.INFLATION_GRACE_H + 10.0) * 3600.0
	main.show_room(main.OVERVIEW)
	_check_fit(main, "The Pitch (prices up)")
	main.show_room(main.MARKET)
	main._fence.selected = {}
	main.refresh()
	_check(main._fence._left_lines[0].text.begins_with("Prices up %d%%" % sim.inflation_pct()), "the Fence does not say prices are up: %s" % main._fence._left_lines[0].text)
	_check_fit(main, "Fence (prices up)")
	sim.load_dict(saved)
	print("money that goes off ok: the grace hour, the rate, every cash price, the ceiling, the Fence's line")


## The late cash sinks: call-ins priced by depth and by the words on the site;
## insurance, the Fence holding the paper on the kit for a run.
func _sink_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	_finish_campaign(sim)
	sim.atlas = {}
	sim.words[3] = []
	sim.set_depth(3, 1)
	# the Radio's crafts (9 Oct): notes by the site's depth, less the map's Good reception and the Yard's Scanner
	sim.best_depth[3] = 5
	sim.set_depth(3, 4)
	var yf: float = 0.75 if sim.yard_has("scanner") else 1.0
	_check(sim.word_craft_cost(3, "retune") == maxi(1, int(ceil(8.0 * yf))) and sim.word_craft_cost(3, "call") == maxi(1, int(ceil(32.0 * yf))) and sim.word_craft_cost(3, "clear") == maxi(1, int(ceil(2.0 * yf))), "the crafts' prices are off at depth 4: retune %d, call %d, clear %d" % [sim.word_craft_cost(3, "retune"), sim.word_craft_cost(3, "call"), sim.word_craft_cost(3, "clear")])
	sim.atlas_points = 1
	_rank_to(sim, "good_reception")
	_check(sim.word_craft_cost(3, "call") == maxi(1, int(ceil(32.0 * yf * 0.85))), "Good reception did not take 15%% off: %d" % sim.word_craft_cost(3, "call"))
	sim.atlas = {}
	# insurance: priced on the kit by depth, paid at deploy, pays out on a death
	sim.set_depth(3, 2)
	var worth: int = sim.loadout_value()
	_check(worth > 0, "no kit worn to insure")
	var cost: int = sim.insure_cost(3)
	var quote: float = worth * sim.inflation() * Data.INSURE_RATE * 2
	_check(cost >= quote - 10 and cost <= quote + 10, "insurance at depth 2 is %d on £%d of kit at ×%.2f" % [cost, worth, sim.inflation()])
	sim.cash = float(cost) - 1.0
	_check(not sim.can_insure(3), "insurance took with the cash a pound short")
	sim.cash = float(cost) + 100.0
	sim.set_insure(true)
	main.show_room(main.MISSIONS)
	main._missions._pick_zone(1)
	_check_fit(main, "Runs (insured)")
	sim.deploy(3)
	_check(sim.mission["insured"] and is_equal_approx(sim.cash, 100.0) and not sim.insure_next, "the premium was not paid at deploy")
	var worn_ids := []
	for s in Data.SLOTS:
		if sim.equipped[s] != null:
			worn_ids.append(sim.equipped[s]["id"])
	var rig_n: int = sim.rig.size()
	var stash_n: int = sim.stash.size()
	sim.hardcore = false
	sim.mission["hp_start"] = sim.hp
	sim._kia()
	_check(sim.last_report["lost_value"] == 0, "the insured death reported kit lost")
	var back := 0
	for id in worn_ids:
		for it in sim.stash:
			if it["id"] == id:
				back += 1
				break
	_check(back == worn_ids.size() and sim.stash.size() == stash_n + worn_ids.size() + rig_n, "the insured kit did not come back to the stash: %d of %d, stash %d -> %d" % [back, worn_ids.size(), stash_n, sim.stash.size()])
	_check(sim.events.slice(-3).any(func(ev): return str(ev[1]).contains("turns up") or str(ev[1]).contains("held the paper")), "the payout had no line")
	# and without it, the kit goes
	sim.choose_runner(0)
	sim.deploy(3)
	_check(not sim.mission["insured"], "a run insured itself")
	sim.mission["hp_start"] = sim.hp
	stash_n = sim.stash.size()
	sim._kia()
	_check(sim.last_report["lost_value"] > 0 and sim.stash.size() == stash_n, "an uninsured death kept the kit")
	sim.choose_runner(0)
	main.refresh()
	_check_fit(main, "Runs (after)")
	sim.load_dict(saved)
	print("the late sinks ok: call-ins by depth and words, insurance paid and paid out")
	_damage_model_checks(main)


## The damage model: a hit split by type, each cut by their resist, dots
## both ways, chill and shock, armour for physical and resists for the rest.
func _damage_model_checks(main) -> void:
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	sim.equipped["Primary"] = sim._plain("Primary", "Army SMG")
	sim.equipped["Secondary"] = null
	for s in ["Helmet", "Armour", "Charm"]:
		sim.equipped[s] = null
	sim.rig = sim.rig.filter(func(x): return not Items.is_ammo(x) and not Items.is_mag(x))     # an incendiary box left in the rig feeds the gun (the review, 19 Oct); a magazine of them too (the fix round)
	var conv: Dictionary = sim.conversion()
	_check(is_equal_approx(conv["physical"], 1.0), "a plain gun is not all physical: %s (rig %s)" % [str(conv), str(sim.rig.map(func(x): return x["base"]))])
	var gun: Dictionary = sim.equipped["Primary"]
	gun["attachments"]["socket 1"] = sim._plain("Attachment", "Lighter fluid")
	sim._stats_dirty()
	gun["affixes"] = [{"stat": "fire_pct", "value": 20, "tier": 3}]
	sim._stats_dirty()
	conv = sim.conversion()
	_check(is_equal_approx(conv["fire"], 0.15) and is_equal_approx(conv["physical"], 0.85), "the fluid did not make 15%% fire: %s" % str(conv))
	var td: Dictionary = sim.type_dps()
	_check(is_equal_approx(td["fire"], sim.dps() * 0.15 * 1.2) and is_equal_approx(td["physical"], sim.dps() * 0.85), "type dps is off: %s against %.1f" % [str(td), sim.dps()])
	var t0 := {"dps": 10.0, "res": {"fire": 0.5}, "types": {"physical": 0.5, "fire": 0.5}}
	_check(is_equal_approx(sim.damage_rate(t0), td["physical"] + td["fire"] * 0.5), "their fire resist did not halve the fire share")
	_check(is_equal_approx(sim.damage_rate(t0, true), (td["physical"] + td["fire"] * 0.5) * (1.0 + Data.SHOCK)), "shocked did not take more")
	gun["affixes"] = [{"stat": "conv_fire_pct", "value": 60, "tier": 5}, {"stat": "conv_frost_pct", "value": 60, "tier": 5}]
	sim._stats_dirty()
	conv = sim.conversion()
	# 60 fire on the gun and 15 in the socket against 60 frost: shared out to the cap (31 Oct, the physical floor: was to
	# one, no physical left), a tenth physical
	_check(is_equal_approx(conv["fire"], Data.CONV_CAP * 75.0 / 135.0) and is_equal_approx(conv["frost"], Data.CONV_CAP * 60.0 / 135.0) and is_equal_approx(conv["physical"], 1.0 - Data.CONV_CAP), "over-conversion did not share out to the cap: %s" % str(conv))
	gun["affixes"] = []
	var armour: Dictionary = sim._plain("Armour", "Stab vest")
	armour["affixes"] = [{"stat": "fire_res", "value": 40, "tier": 5}, {"stat": "all_res", "value": 10, "tier": 3}]
	sim.equipped["Armour"] = armour
	var res_hold := {}
	for s in ["Helmet", "Rig", "Charm", "Gloves", "Backpack"]:     # gloves roll resists too now (act two (e)) (BUILD51-A)
		res_hold[s] = sim.equipped[s]
		sim.equipped[s] = null              # a rig rolls resists too now (12 Oct): only the coat's count here
	var tree_hold: Array = sim.tree.duplicate()
	sim.tree = sim.tree.filter(func(id): return not str(sim.node(str(id)).get("effect", "")).ends_with("_res"))     # BUILD51-A: the bot's web resists (Singed, 3% fire a node) aside: the coat's alone
	sim._stats_dirty()
	_check(is_equal_approx(sim.resist("fire"), 0.5) and is_equal_approx(sim.resist("shock"), 0.1) and is_equal_approx(sim.resist("physical"), 0.0), "resists do not add: fire %.2f shock %.2f" % [sim.resist("fire"), sim.resist("shock")])
	sim.tree = tree_hold
	sim._stats_dirty()
	for s in res_hold:
		sim.equipped[s] = res_hold[s]
	armour["affixes"].append({"stat": "fire_res", "value": 90, "tier": 5})
	_check(is_equal_approx(sim.resist("fire"), Data.RESIST_CAP / 100.0), "the resist cap did not hold: %.2f" % sim.resist("fire"))
	var mit: float = sim.mitigation()
	var expect: float = 10.0 * 0.5 * (1.0 - mit) + 10.0 * 0.5 * (1.0 - 0.75)
	_check(is_equal_approx(sim.incoming_rate(t0, 1), expect), "incoming by type is off: %.2f vs %.2f" % [sim.incoming_rate(t0, 1), expect])
	_check(is_equal_approx(sim.incoming_rate(t0, 1, true), expect * (1.0 - Data.CHILL)), "chilled did not slow their fire")
	sim.words[3] = []
	sim.set_depth(3, 1)
	var e: Dictionary = sim.effective(3)
	_check(e.has("types") and e.has("res") and is_equal_approx(e["types"]["physical"] + e["types"]["bleed"], 1.0) and e["types"]["bleed"] > 0.1, "the estate's fire is not mostly physical with some bleed: %s" % str(e["types"]))
	_finish_campaign(sim)
	sim.best_depth[3] = maxi(sim.best_depth[3], 2)
	sim.set_depth(3, 2)
	sim.words[3] = [{"w": "Burners", "t": 1}, {"w": "Jacketed", "t": 1}]
	e = sim.effective(3)
	_check(e["types"].get("fire", 0.0) >= 0.33 and e["res"]["fire"] >= 0.4, "Burners and Jacketed did not take: %s %s" % [str(e["types"]), str(e["res"])])
	sim.words[3] = [{"w": "Kitted out", "t": 1}]
	sim.best_depth[3] = 20
	sim.set_depth(3, 12)
	e = sim.effective(3)
	_check(e["res"]["bleed"] >= 0.25 + Data.RESIST_DEPTH_STEP * 4 and is_equal_approx(e["res"]["fire"], 0.25) and e["res"]["fire"] <= Data.RESIST_ENEMY_CAP, "Kitted out (tier I) at depth 12 is %s (the estate's own bleed grows, the rest stay as the word says)" % str(e["res"]))
	sim.words[3] = []
	sim.set_depth(3, 1)
	var dots := {}
	sim._dot_add(dots, "fire", 100.0, 100.0)
	_check(is_equal_approx(dots["fire"], 50.0), "a 100 fire hit did not leave a 50 burn: %s" % str(dots))
	var ticked: float = sim._dot_tick(dots, 1.0, {})
	_check(is_equal_approx(ticked, 12.5) and is_equal_approx(dots["fire"], 37.5), "the burn did not tick a quarter of the pool a second: %.1f" % ticked)
	for k in range(60):
		sim._dot_add(dots, "poison", 100.0, 100.0)
	var poison_cap: float = 100.0 * 0.8 * sim.dot_seconds("poison") * sim.dot_stacks("poison")
	_check(is_equal_approx(dots["poison"], poison_cap), "poison did not cap at its stacks: %.0f, not %.0f" % [dots["poison"], poison_cap])
	sim.set_depth(3, 2)
	sim.words[3] = [{"w": "Cutters", "t": 1}]
	sim.hp = sim.max_hp()
	sim.deploy(3)
	var m: Dictionary = sim.mission
	for k in range(6):
		sim.advance(0.5)
		if m["remaining"] <= 0:
			break
	_check((m.has("my_dots") and float(m["my_dots"].get("bleed", 0.0)) > 0.0) or m["remaining"] <= 0, "a cutters' gang left no bleed on you: %s" % str(m.get("my_dots", {})))
	if m["remaining"] > 0 and not sim.first_med().is_empty():
		var dressing: String = str(sim.first_med()["base"])
		sim.hp = sim.max_hp() * 0.6           # hurt, so the med goes in (a full runner keeps it: the fix round's flake, the regen had him full)
		var used: bool = sim.use_med(sim.first_med()["id"])
		m["t"]["dps"] = 0.0                   # the gang's hits off while it works (the fix round: a dry gun's longer fight re-opened the bleed before the read)
		var steps := 0
		for k in range(40):
			sim.advance(0.5)
			steps += 1
			if m["using"] == null:
				break
		_check(not m.get("my_dots", {}).has("bleed"), "the dressing did not stop the bleeding: %s used %s, %d steps, using %s, on you %s, remaining %d, on a run %s" % [dressing, str(used), steps, str(m.get("using", null) != null), str(m.get("my_dots", {})), int(m["remaining"]), str(sim.on_mission())])
	sim.extract_now()
	sim.words[3] = []
	sim.load_dict(saved)
	print("the damage model ok: conversion, type dps, their resists, shock, your resists and the cap, incoming by type, chill, the sites' types, the words, dots, a dressing")
	# every gun says what it takes, and the Lock-up's panel shows it
	for slot in ["Primary", "Secondary"]:
		for b in Data.BASES[slot]:
			var g: Dictionary = sim._plain(slot, b["name"])
			_check(Items.ammo_words(g).begins_with("Takes "), "%s does not say what it takes" % b["name"])
	_check(Items.ammo_words(sim._plain("Primary", "Pipe shotgun")) == "Takes shells", "a pipe shotgun takes %s" % Items.ammo_words(sim._plain("Primary", "Pipe shotgun")))
	_check(Items.ammo_words(sim._plain("Primary", "Nail gun")) == "Takes nails", "a nail gun takes %s" % Items.ammo_words(sim._plain("Primary", "Nail gun")))
	_check(Items.ammo_type(sim._plain("Primary", "Garage-built rifle")) == "rifle" and Items.base_of(sim._plain("Primary", "Garage-built rifle"))["type"] == "improvised", "the garage rifle's ammo and type are not apart")
	var shown: Dictionary = sim._plain("Primary", "Farmer's shotgun")
	sim.stash.append(shown)
	main.show_room(main.ARMOURY)
	main._armoury.selected = {"kind": "stash", "id": shown["id"]}
	main.refresh()
	_check(main._armoury._head._tail.text.to_lower().contains("takes shells") or main._armoury._head._tail.text.to_lower().contains("shotgun rounds"), "the Lock-up's panel does not say the shotgun takes shells: '%s'" % main._armoury._head._tail.text)
	_check_fit(main, "Armoury (ammo words)")
	sim.sell(shown)
	print("ammo words ok")


## The pool: a typed part counts on its type only; a unique's rule fires; worn weight is pace.
func _pool_checks(sim) -> void:
	var gun = sim.equipped["Primary"]
	var shotgun: Dictionary = sim._plain("Primary", "Farmer's shotgun")
	var rifle: Dictionary = sim._plain("Primary", "Stalking rifle")
	var choke := Items.roll(Data.ATTACHMENT, 1, sim.rng)
	choke["base"] = "Choke"
	choke["mount"] = "muzzle"
	choke["affixes"] = []
	shotgun["attachments"]["muzzle"] = choke
	rifle["attachments"]["muzzle"] = choke.duplicate(true)
	_check(Items.fitted_sum(shotgun, "damage_pct") >= 15.0, "a choke did not count on a shotgun")
	_check(Items.fitted_sum(rifle, "damage_pct") < 1.0, "a choke counted on a rifle")
	sim.equipped["Primary"] = Items.roll_unique(Data.UNIQUES[0], sim.rng)
	_check(sim.has_rule("grandads") and Items.full_name(sim.equipped["Primary"]) == "Grandad's Shotgun", "the unique's rule or name is wrong")
	# gear tiers run to 5: the Bank drops tier 5, and the Fence stocks what the open sites drop
	_check(Data.TIERS[Data.TIERS.size() - 1]["loot_tier"] == Data.CAMPAIGN_TIER, "the last site does not drop the campaign's top tier")
	var top := 0
	for slot in Data.SLOTS:
		for b in Data.BASES[slot]:
			top = maxi(top, int(b["tier"]))
	_check(top == Data.MAX_TIER, "no base at the top tier")
	_check(sim.gear_tier() <= Data.MAX_TIER and sim.gear_tier() >= 1, "gear_tier out of range")
	sim.equipped["Primary"] = gun
	var armour = sim.equipped["Armour"]
	sim.equipped["Armour"] = sim._plain("Armour", "Padded jacket")
	var pace0: float = sim.pace()
	sim.equipped["Armour"] = sim._plain("Armour", "Riot suit")
	_check(sim.pace() < pace0, "a riot suit did not slow the runner against a padded jacket")
	sim.equipped["Armour"] = armour
	print("pool checks ok")
	_ammo_checks(sim)


## Ammo: rounds come off the rig as the gun fires; dry means the secondary, then fists;
## a box bought at the Fence is a stack in the stash; a better grade adds damage.
func _ammo_checks(sim) -> void:
	if sim.on_mission():
		sim.extract_now()
	# the stash's rounds aside while these runs go out dry on purpose: the gate tops the rig up from it (16 Oct)
	var kept_ammo: Array = sim.stash.filter(func(x): return Items.is_ammo(x) or Items.is_mag(x))     # magazines too (BUILD50-T: the bot's camp kept a nail magazine, and the gate loaded it for the pistol-alone run)
	for it in kept_ammo:
		sim.stash.erase(it)
	var gun = sim.equipped["Primary"]
	var kept_rig: Array = sim.rig.duplicate()
	sim.rig = []
	sim.rig.append(_rmag(sim, Data.BASES[Data.AMMO][0]["name"]))     # nails
	sim.equipped["Primary"] = sim._plain("Primary", "Nail gun")
	var sec = sim.equipped["Secondary"]
	sim.equipped["Secondary"] = null
	var with_rounds: float = sim.dps()
	var before: int = sim.rounds_for(sim.equipped["Primary"])
	sim.set_depth(3, 1)
	sim.hp = sim.max_hp()
	sim.deploy(3)
	before = sim.rounds_for(sim.equipped["Primary"])     # as the gate left it: its top-up may pack the stash's magazines too
	sim.mission["t"]["dps"] = 0.0          # nothing coming back: the twenty seconds are about the rounds, not the runner's life
	for k in range(20):
		sim.advance(1.0)
	_check(sim.on_mission() and sim.rounds_for(sim.equipped["Primary"]) < before, "the nail gun fired twenty seconds and spent no rounds")
	# the secondary backing a live primary spends a third of its rate; alone, all of it
	sim.extract_now()
	sim.equipped["Secondary"] = sim._plain("Secondary", "Service pistol")
	sim.rig = _rmags(sim, "Nails", 4) + _rmags(sim, "Pistol rounds", 6)     # piles that outlast the thirty seconds, reloads and all
	var pistol0: int = sim.rounds_for(sim.equipped["Secondary"])
	sim.hp = sim.max_hp()
	sim.deploy(3)
	sim.mission["t"]["dps"] = 0.0
	sim.mission["t"]["hp"] = 100000.0          # a gang that stands the thirty seconds: a quick kill and a search fired nothing (19 Oct, the flaky check)
	sim.mission["target_hp"] = 100000.0
	for k in range(30):
		sim.advance(1.0)
	var backing: int = pistol0 - sim.rounds_for(sim.equipped["Secondary"])
	_check(backing > 0, "a pistol backing a live primary spent no rounds over thirty seconds (on a run %s, kills %d, gangs %d, primary rounds %d, searching %s)" % [str(sim.on_mission()), int(sim.mission.get("kills", 0)) if sim.on_mission() else -1, int(sim.mission.get("patrols", 0)) if sim.on_mission() else -1, sim.rounds_for(sim.equipped["Primary"]), str(sim.mission.get("searching", false)) if sim.on_mission() else "-"])
	sim.extract_now()
	for it in sim.stash.filter(func(x): return Items.is_ammo(x) or Items.is_mag(x)):
		sim.stash.erase(it)                     # what the runs brought home aside too: the gate would top the nail gun up
		kept_ammo.append(it)
	sim.rig = _rmags(sim, "Pistol rounds", 6)        # the nail gun dry: the pistol is the gun in hand
	pistol0 = sim.rounds_for(sim.equipped["Secondary"])
	sim.hp = sim.max_hp()
	sim.deploy(3)
	sim.mission["t"]["dps"] = 0.0
	sim.mission["t"]["hp"] = 100000.0          # as above: a gang that stands the thirty seconds (22 Oct: the web's fillers made the kill quicker, and a search fired nothing)
	sim.mission["target_hp"] = 100000.0
	for k in range(30):
		sim.advance(1.0)
	var alone: int = pistol0 - sim.rounds_for(sim.equipped["Secondary"])
	_check(alone > backing * 2, "the pistol in hand (%d rounds) fires no faster than backing (%d)" % [alone, backing])
	sim.equipped["Secondary"] = null
	sim.extract_now()
	sim.rig = []
	_check(sim.dps() < with_rounds * 0.5, "a gun with no rounds still fires: %.1f against %.1f" % [sim.dps(), with_rounds])
	sim.rig.append(_rmag(sim, "Hardened bolts"))
	_check(sim.dps() > with_rounds, "the better grade did not add damage")
	sim.cash += 1000.0
	while not sim.stash_room(1) and not sim.stash.is_empty():
		sim.sell(sim.stash[0])                 # room for the box
	# the box lands as a new stack, or tops up a shells stack already there
	var shells_before: int = sim.stash.reduce(func(a, it): return a + (int(it.get("rounds", 0)) if Items.is_ammo(it) and Items.ammo_type(it) == "shotgun" else 0), 0)
	var cash_before: float = sim.cash
	_check(sim.buy_ammo("shotgun"), "the Fence would not sell a box of shells (cash £%.0f, room %s)" % [sim.cash, str(sim.stash_room(1))])
	var shells_after: int = sim.stash.reduce(func(a, it): return a + (int(it.get("rounds", 0)) if Items.is_ammo(it) and Items.ammo_type(it) == "shotgun" else 0), 0)
	_check(shells_after > shells_before and sim.cash < cash_before, "a box from the Fence did not land in the stash: %d shells then %d" % [shells_before, shells_after])
	sim.sell(sim.stash.back())
	# the top-up at the gate (16 Oct): a gun's rounds in the stash go into the rig's room, the build's grade first; the
	# meds stay; a full rig takes nothing and the run still goes
	if sim.on_mission():
		sim.extract_now()
	sim.equipped["Primary"] = sim._plain("Primary", _base_of_type("shotgun"))
	var rig_kept = sim.equipped["Rig"]
	sim.equipped["Rig"] = sim._plain("Rig", "Chest rig")     # a rig with room (29 Oct: the camp's could be a two-pouch one)
	sim.rig = [sim._plain(Data.MEDICAL, "Bandage"), _rmag(sim, "Shells", 3)]
	var spare: Dictionary = sim._plain(Data.AMMO, "Shells")
	var slugs: Dictionary = sim._plain(Data.AMMO, "Slugs")
	var spare_mag: Dictionary = sim._plain(Data.MAGAZINE, "Shotgun magazine")
	sim.stash.append(spare)
	sim.stash.append(slugs)
	sim.stash.append(spare_mag)
	var rig_before: int = sim.rounds_for(sim.equipped["Primary"])
	var in_stash: int = int(spare["rounds"]) + int(slugs["rounds"])
	sim.hp = sim.max_hp()
	sim.deploy(3)
	var rig_after: int = sim.rounds_for(sim.equipped["Primary"])
	_check(sim.on_mission() and rig_after > rig_before, "the gate didn't top the rig up: %d rounds before, %d after, %d in the stash" % [rig_before, rig_after, in_stash])
	_check(sim.rig.any(func(x): return str(x["base"]) == "Bandage"), "the top-up pushed the meds out of the rig")
	_check(sim.rig.filter(func(x): return Items.is_mag(x)).size() == 1, "the gate packed a magazine past the one that went out: %s" % str(sim.rig.map(func(x): return str(x["base"]))))     # BUILD48 A (item 24, Matt's pick): was the better grade's magazine packed
	_check(sim.rig.any(func(x): return str(x.get("ammo", "")) == "Shells" and int(x["rounds"]) == 8), "the gate didn't fill the magazine of shells with its own grade: %s" % str(sim.rig.map(func(x): return [x.get("ammo", ""), x.get("rounds", 0)])))
	_check(sim.events.any(func(e): return str(e[1]).begins_with("Topped up:")) and sim.events.any(func(e): return str(e[1]).begins_with("Filled:")), "the top-up wasn't logged")
	sim.extract_now()
	for it in [spare, slugs]:
		sim.stash.erase(it)
	sim.rig = []
	while sim.rig_room(1):
		sim.rig.append(sim._plain(Data.MEDICAL, "Bandage"))
	var stash0: Array = sim.stash.duplicate()
	# room for what the fixture adds (31 Oct: the bot's run left the stash over full on another seed's camp - a bandage
	# swapped out for a magazine has nowhere to go); stash0 puts it back as it was
	sim.stash = sim.stash.filter(func(x): return not (Items.is_mag(x) or Items.is_ammo(x)) and str(x["slot"]) != "Primary")
	sim.stash.append(sim._plain(Data.AMMO, "Slugs"))
	for k in range(sim.med_capacity()):
		sim.stash.append(sim._plain(Data.MAGAZINE, "Shotgun magazine"))
	sim.hp = sim.max_hp()
	sim.deploy(3)
	# a rig full of bandages (29 Oct, the stall: heal, magazine, cure): the primary's first magazine goes in, a bandage out
	# for it - the gate never sends the gun out dry; no more magazines than that (BUILD48 A, item 24, Matt's pick: was the
	# magazines to their share, the bandages the rest)
	_check(sim.on_mission() and sim.rounds_for(sim.equipped["Primary"]) > 0 and sim.rig.filter(func(x): return Items.is_mag(x)).size() == 1
		and sim.rig.filter(func(x): return str(x["base"]) == "Bandage").size() == sim.med_capacity() - 1,
		"a full rig of bandages went out without the primary's magazines: %s" % str(sim.rig.map(func(x): return str(x["base"]))))
	sim.extract_now()
	sim.stash = stash0
	# the card's rounds-short read (16 Oct): ten shells against a site's fight is short; a rig of them isn't
	sim.rig = [_rmag(sim, "Shells", 5)]     # under its size (the three-stage review, tools 4: ten in an eight the game never reaches)
	var st_hold: Array = sim.stash.duplicate()
	sim.stash = sim.stash.filter(func(x): return not (Items.is_ammo(x) and str(Items.base_of(x)["type"]) == "shotgun") and not (Items.is_mag(x) and int(x.get("rounds", 0)) > 0))     # no box to fill from or pack, nor a loaded magazine (31 Oct, BUILD37 C: the camp's seed moved and one held 8)
	var rs0: Array = sim.rounds_short(3)
	sim.stash = st_hold
	_check(rs0.size() == 2 and int(rs0[0]) == 5 and int(rs0[1]) > 10, "five shells read as enough for the Parade: %s" % str(rs0))
	sim.rig = []
	for k in range(6):
		sim.rig.append(_rmag(sim, "Shells"))
	_check(sim.rounds_short(3).is_empty() or int(sim.rounds_short(3)[0]) > 10, "a rig of shells still reads short and unchanged: %s" % str(sim.rounds_short(3)))
	# two pouches free, magazines and boxes for the shotgun and one of each for the pistol: the pistol gets its magazine
	sim.rig = []
	while sim.rig_room(3):
		sim.rig.append(sim._plain(Data.MEDICAL, "Bandage"))
	var extra: Array = [sim._plain(Data.AMMO, "Shells"), sim._plain(Data.AMMO, "Slugs"), sim._plain(Data.AMMO, "Pistol rounds"),
		sim._plain(Data.MAGAZINE, "Shotgun magazine"), sim._plain(Data.MAGAZINE, "Shotgun magazine"), sim._plain(Data.MAGAZINE, "Shotgun magazine"), sim._plain(Data.MAGAZINE, "Pistol magazine")]
	sim.stash.append_array(extra)
	var cures_kept: Array = sim.stash.filter(func(x): return Items.is_cure(x))
	for it in cures_kept:
		sim.stash.erase(it)                   # HEAL, MAGAZINE, CURE (28 Oct, Matt): a cure would take the second pouch first
	sim.equipped["Secondary"] = sim._plain("Secondary", "Service pistol")
	sim._top_up()
	sim.stash.append_array(cures_kept)
	_check(sim.rounds_for(sim.equipped["Secondary"]) > 0, "the shotgun's magazines took every pouch and the pistol went without")
	for it in extra:
		sim.stash.erase(it)
	# the rig at the gate's three settings (23 Oct, parked item 4; 30 Oct, magazines as items): Leave it moves nothing in
	# (the magazines in it filled); Best grades only takes the best med alone, the magazines filled best grade first;
	# Fill up the magazines to their share, then the meds, the best first
	sim.rig = []
	var tu: Array = [sim._plain(Data.AMMO, "Shells"), sim._plain(Data.AMMO, "Slugs"), sim._plain(Data.MEDICAL, "Bandage"), sim._plain(Data.MEDICAL, "First aid kit"),
		sim._plain(Data.MAGAZINE, "Shotgun magazine"), sim._plain(Data.MAGAZINE, "Shotgun magazine")]
	sim.stash.append_array(tu)
	var stash_n: int = sim.stash.size()
	sim.set_top_up("leave")
	sim._top_up()
	_check(sim.rig.is_empty() and sim.stash.size() == stash_n, "Leave it moved something into the rig: %d" % sim.rig.size())
	sim.set_top_up("best")
	sim._top_up()
	_check(sim.rig.any(func(x): return str(x.get("ammo", "")) == "Slugs"), "Best grades only didn't fill with the top grade first: %s" % str(sim.rig.map(func(x): return [x["base"], x.get("ammo", "")])))
	_check(sim.rig.any(func(x): return str(x["base"]) == "First aid kit") and not sim.rig.any(func(x): return str(x["base"]) == "Bandage"), "Best grades only didn't take the best med alone: %s" % str(sim.rig.map(func(x): return x["base"])))
	_check(sim.events.any(func(e): return str(e[1]).begins_with("Topped up:") and str(e[1]).contains("med")), "the meds' top-up wasn't logged")
	for it in sim.rig.duplicate():
		sim.leave(int(it["id"]))
	sim.rig = []
	sim.set_top_up("fill")
	sim._top_up()
	# the magazines first, filled best grade first, into up to RIG_MAG_SHARE of the pouches, then the meds best first into
	# what's left (a kit takes two pouches, a bandage one): nothing left in the stash that would still fit
	var fill_bases: Array = sim.rig.map(func(x): return str(x.get("ammo", x["base"])))
	var left_fits: bool = sim.stash.any(func(x): return Items.is_medical(x) and sim.rig_room(Items.size(x)))
	var mag_pouches: int = sim.rig.filter(func(x): return Items.is_mag(x)).size()
	_check(fill_bases.has("Slugs") and mag_pouches >= 1 and mag_pouches <= ceili(sim.med_capacity() * Data.RIG_MAG_SHARE) and not left_fits and sim.rig.any(func(x): return Items.is_medical(x)), "Fill up took the wrong things for %d pouches: %s" % [sim.med_capacity(), str(fill_bases)])
	for it in tu:
		sim.stash.erase(it)
	sim.set_top_up("best")
	var td: Dictionary = sim.to_dict()
	var s_tu = Sim.new()
	s_tu.load_dict(td)
	_check(s_tu.top_up_mode == "best", "the rig's setting didn't save: '%s'" % s_tu.top_up_mode)
	sim.set_top_up("fill")
	for it in sim.rig.duplicate():
		sim.leave(int(it["id"]))
	sim.rig = []
	for it in tu:
		sim.stash.erase(it)
	sim.equipped["Secondary"] = null
	sim.stash.append_array(kept_ammo)
	sim.rig = kept_rig
	sim.equipped["Primary"] = gun
	sim.equipped["Secondary"] = sec
	sim.equipped["Rig"] = rig_kept
	print("ammo checks ok; the gate tops the rig up")


## The highest open tier whose estimated damage taken leaves half the HP.
func _pick_tier(sim) -> int:
	var best := 0
	for i in range(Data.TIERS.size()):
		if not sim.tier_open(i):
			continue
		if sim.survival(i) >= 0.8:
			best = i
	# the zone's boss, once its site is cleared and the odds hold with them in
	var b: Dictionary = sim.boss_of(best)
	if not b.is_empty() and sim.best_depth[best] > 0 and not sim.bosses_beaten[int(b["zone"])]:
		sim.arm_boss(best, true)
		if sim.survival(best) < 0.6:
			sim.arm_boss(best, false)
	return best


## Climb: when a tier reads safe, go a depth deeper on it.
func _climb(sim) -> void:
	for i in range(Data.TIERS.size()):
		if sim.tier_open(i) and sim.depth[i] <= sim.best_depth[i] and sim.survival(i) >= 0.9:
			sim.set_depth(i, sim.depth[i] + 1)


## Buy the Bench when the cash is there with £500 to spare; fit the best
## attachment the stash holds on every open mount of both guns.
func _bench(sim) -> void:
	for b in Data.YARD:
		for c in range(2):
			if sim.yard_side(b["key"], c) == "" and sim.can_yard_pick(b["key"], c, "a") and sim.cash >= sim.yard_pick_cost(b["key"], c) + 500:
				sim.yard_pick(b["key"], c, "a")
	for slot in ["Primary", "Secondary"]:
		var gun = sim.equipped[slot]
		if gun == null:
			continue
		for mount in gun["attachments"]:
			if not sim.mount_open(mount):
				continue
			var best: Array = sim.attachments_for(mount, str(Items.base_of(gun).get("type", "")))
			if best.is_empty():
				continue
			var cur = gun["attachments"][mount]
			if cur == null or Items.score(best[0]) > Items.score(cur):
				sim.fit(slot, best[0]["id"])


## Spend every free point: Marksmanship first, then Conditioning, then Fieldcraft.
func _train_tree(sim) -> void:
	var spent := true
	while sim.points_free() > 0 and spent:
		spent = false
		for b in sim.trees():
			for i in range(b["nodes"].size()):
				var id := "%s/%d" % [b["name"], i]
				if sim.can_train(id):
					sim.train_node(id)
					spent = true
					break
			if spent:
				break


## Fill the rig with bandages from the Medic Tent, taken through the sim.
func _restock_meds(sim) -> void:
	var gun = sim.equipped["Primary"]
	if gun != null and Items.mag_size(gun) > 0 and not Items.free_rounds(gun):
		# as the game packs (the three-stage review, tools 1: the pouch-era take of a box was always refused): magazines off
		# the shelf to the rig's share, boxes for them and the gate's box, then the gate's own packing and fill
		Bot._buy_mags(sim, gun, maxi(1, ceili(sim.med_capacity() * Data.RIG_MAG_SHARE)))
		var want: int = int(Items.base_of(gun)["rof"] * 240.0)
		var guard := 0
		while Bot._stash_rounds(sim, Items.ammo_type(gun)) < want and guard < 4:
			guard += 1
			if not sim.buy_ammo(Items.ammo_type(gun)):
				break
		sim.pack_rig("fill")
		sim._fill_mags()
	while sim.rig_room(1):
		var took := false
		for it in sim.stash:
			if Items.is_medical(it):
				took = sim.take(it["id"])
				break
		if took:
			continue
		if not _buy_off_shelf(sim, "Bandage"):
			return


## A med of that name off the Clinic's shelf, the game's way (31 Oct, the clean-up: the tests' buy_med went): one put on
## her shelf first when it isn't there (a fixture), then bought with buy_clinic - her price, the stash's room. True if bought.
func _buy_off_shelf(sim, med: String) -> bool:
	var pick: Dictionary = {}
	for it in sim.clinic:
		if str(it["base"]) == med:
			pick = it
			break
	var added := pick.is_empty()
	if added:
		pick = sim._plain(Data.MEDICAL, med)
		sim.clinic.append(pick)
	var ok: bool = sim.buy_clinic(int(pick["id"]))
	if not ok and added:
		sim.clinic.erase(pick)                 # a refused buy leaves the shelf as it was (31 Oct, the tools review)
	return ok


## Sell everything in the stash that isn't the best of its slot - a player's
## tidy-up, and what keeps the stash from filling.
func _sell_spares(sim) -> void:
	for it in sim.stash.duplicate():
		if Items.is_attachment(it) or Items.rig_item(it) or Items.is_ammo(it):     # a box is no rig item now (30 Oct)
			continue
		var best: Dictionary = Bot.best_in_stash(sim, it["slot"])
		if best.is_empty() or best["id"] != it["id"]:
			sim.sell(it)


## Buy the one market item that beats what's fitted by the most, if affordable.
func _buy_upgrade(sim) -> void:
	var pick := -1
	var gain := 0.0
	for i in range(sim.market.size()):
		var it: Dictionary = sim.market[i]
		if Items.is_attachment(it) or Items.rig_item(it) or Items.is_ammo(it):     # a box is no rig item now (30 Oct)
			continue
		var cur = sim.equipped[it["slot"]]
		var g: float = Items.score(it) - (Items.score(cur) if cur != null else 0.0)
		if g > gain and sim.cash >= sim.price(it) + 100:
			gain = g
			pick = i
	if pick >= 0:
		sim.buy(pick)
		for s in Data.SLOTS:
			sim.equip_best(s)


## Every label on whatever is showing has to fit: its text inside its box
## (a button's text with the button's margins), its box inside its parent top
## to bottom, and no two boxes with text on top of each other - except a
## label-and-value pair that shares a line by design, which is checked as a
## pair instead. Greenhorn's lesson: a screen that isn't measured clips.
## The grid's packing, checked: every footprint inside the columns, none
## overlapping, none across a page's edge, every one over a drawn outline;
## the outlines are the capacity or the reach, never padding.
func _check_grid(inv, cap: int, what: String) -> void:
	var placed: Dictionary = inv.placed()
	var taken := {}
	var reach := 0
	for id in placed:
		var r: Rect2i = placed[id]
		_check(r.position.x >= 0 and r.position.x + r.size.x <= inv.COLS, "%s: an item sits outside the columns: %s" % [what, str(r)])
		_check((r.position.y / inv.page_rows) == ((r.position.y + r.size.y - 1) / inv.page_rows), "%s: an item crosses a page edge: %s" % [what, str(r)])
		for dy in range(r.size.y):
			for dx in range(r.size.x):
				var c := Vector2i(r.position.x + dx, r.position.y + dy)
				_check(not taken.has(c), "%s: two items share cell %s" % [what, str(c)])
				taken[c] = true
		reach = maxi(reach, (r.position.y + r.size.y - 1) * inv.COLS + r.position.x + r.size.x)
	var want := maxi(cap, reach)
	var a_page: int = inv.page_rows * inv.COLS
	var on_page := clampi(want - inv.page * a_page, 0, a_page)
	_check(inv.outlines_shown() == on_page, "%s shows %d outlines for %d cells (reach %d, page %d)" % [what, inv.outlines_shown(), cap, reach, inv.page])
	# every visible cell's pixels lie over outlines: the item is on the container
	for k in range(inv._cells.size()):
		var c = inv._cells[k]
		if not c.visible:
			continue
		var r: Rect2i = placed.get(c.id, Rect2i())
		var top: int = inv.page * inv.page_rows
		var last: int = (r.position.y + r.size.y - 1 - top) * inv.COLS + r.position.x + r.size.x - 1
		_check(last < inv.outlines_shown(), "%s: %s is drawn past the last outline" % [what, str(r)])


## The run's pack as drawn (27 Oct, the grid): the bag's columns and exactly its cells as outlines on the page, every
## placed piece at its "pos" in its turned footprint, inside the bag and on no other's cell; the drawn cell its size.
func _check_pack_grid(inv, sim, what: String) -> void:
	var m: Dictionary = sim.mission
	sim.pack_layout(m)
	inv._shown = ""
	inv.show_items(sim, m["found"], sim.pack_used(m), sim.capacity(), "Pack")
	var w: int = sim.pack_w()
	var cap: int = sim.capacity()
	var top: int = inv.top_row
	var want := 0
	for row in range(inv._view_rows):
		for col in range(w):
			if (top + row) * w + col < cap:
				want += 1
	_check(inv.outlines_shown() == want, "%s shows %d outlines for the page's %d cells (%d across, %d in all)" % [what, inv.outlines_shown(), want, w, cap])
	var placed: Dictionary = inv.placed()
	var taken := {}
	for it in m["found"]:
		var r: Rect2i = placed.get(it["id"], Rect2i(-1, -1, 0, 0))
		if it.get("strapped", false):
			_check(r.position.y >= sim.pack_rows(), "%s: %s is strapped on but drawn in the pack: %s" % [what, it["base"], str(r)])
			continue
		_check(it.has("pos") and r.position == Vector2i(int(it["pos"][0]), int(it["pos"][1])) and r.size == inv.lies(it), "%s: %s drawn at %s, lying at %s" % [what, it["base"], str(r), str(it.get("pos"))])
		for dy in range(r.size.y):
			for dx in range(r.size.x):
				var c := Vector2i(r.position.x + dx, r.position.y + dy)
				_check(sim.pack_cell_in(c.x, c.y, w, cap) and not taken.has(c), "%s: %s at %s is off the bag or on another's cell" % [what, it["base"], str(c)])
				taken[c] = true
	for c in inv._cells:
		if c.visible:
			var r: Rect2i = placed.get(c.id, Rect2i())
			_check(c.size == Vector2(inv.cpx(r.size.x), inv.cpx(r.size.y)), "%s: a cell drawn %s for a %s footprint" % [what, str(c.size), str(r.size)])


## The pack as a grid (27 Oct, Matt: "true tetris"; the bag's own shape, turned pieces, a find with no place waits on
## the floor, the bot packs with the same packer). The Plastic bag is 5 by 3.
func _pack_grid_checks(sim) -> void:
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var by_hand_was: bool = sim.loot_by_hand
	sim.loot_by_hand = true
	sim.equipped["Backpack"] = sim._plain("Backpack", "Plastic bag")
	sim.hp = sim.max_hp()
	sim.deploy(0)
	var m: Dictionary = sim.mission
	m["crates"] = []                          # the search on: the floor's on screen
	m["found"] = []
	m["floor"] = []
	var w: int = sim.pack_w()
	var cap: int = sim.capacity()
	_check(w == 5 and cap >= 15, "the Plastic bag is not 5 across: %d across, %d cells" % [w, cap])
	var nid := [880000]
	var mk := func(slot: String, base: String) -> Dictionary:
		var it: Dictionary = sim._plain(slot, base)
		nid[0] += 1
		it["id"] = nid[0]
		return it
	# a rifle lies along the top row; a 3x3 finds no place in what's left of a 5x3 (two rows): to the floor
	var rifle: Dictionary = mk.call("Primary", "Old .303")
	sim._place_find(m, rifle)
	_check(rifle.get("pos", []) == [0, 0] and not rifle.get("rot", true), "the rifle didn't lie along the top: %s %s" % [str(rifle.get("pos")), str(rifle.get("rot"))])
	if cap == 15:
		var vest: Dictionary = mk.call("Armour", "Stab vest")
		sim._place_find(m, vest)
		_check(not m["found"].has(vest) and m["floor"].has(vest), "a 3x3 went into two rows of a 5x3 (cells free %d): the floor %d" % [cap - sim.pack_used(m), m["floor"].size()])
		_check(not sim.floor_fits(vest), "the floor says a 3x3 fits two rows")
		# two helmets side by side, then a 2x1 only fits turned, up the last column
		var h1: Dictionary = mk.call("Helmet", Data.BASES["Helmet"][0]["name"])
		var h2: Dictionary = mk.call("Helmet", Data.BASES["Helmet"][0]["name"])
		sim._place_find(m, h1)
		sim._place_find(m, h2)
		_check(h1.get("pos", []) == [0, 1] and h2.get("pos", []) == [2, 1], "the helmets didn't lie side by side: %s %s" % [str(h1.get("pos")), str(h2.get("pos"))])
		var pistol: Dictionary = mk.call("Secondary", Data.BASES["Secondary"][0]["name"])
		if Items.footprint(pistol) == Vector2i(2, 1):
			sim._place_find(m, pistol)
			_check(pistol.get("pos", []) == [4, 1] and pistol.get("rot", false), "a 2x1 didn't turn into the last column: %s %s" % [str(pistol.get("pos")), str(pistol.get("rot"))])
			_check(sim.pack_used(m) == cap, "the 5x3 isn't full: %d of %d" % [sim.pack_used(m), cap])
			# full: a drag onto a taken cell is refused; the pistol put down, a helmet moves into its place's column... no:
			# a helmet can't go where the pistol was (one column), so the move is refused there and allowed nowhere taken
			_check(not sim.pack_move(h1["id"], 3, 1, false), "a helmet moved onto another's cells")
			_check(sim.put_down(pistol["id"]) and m["floor"].has(pistol) and not pistol.has("pos"), "the pistol wasn't put down onto the floor")
			_check(sim.pack_move(h2["id"], 3, 1, false) and h2["pos"] == [3, 1], "a helmet didn't move a column right into the room made")
			_check(not sim.take_floor(pistol["id"], [3, 1, true]), "the pistol was taken onto a helmet's cells")
			_check(sim.take_floor(pistol["id"], [2, 1, true]) and pistol["pos"] == [2, 1] and pistol["rot"], "the pistol wasn't taken back where it was dropped, turned: %s" % str(pistol.get("pos")))
			# the save keeps where it all lies
			var d: Dictionary = JSON.parse_string(JSON.stringify(sim.to_dict()))
			var back = Sim.new()
			back.load_dict(d)
			var bf: Array = back.mission["found"].filter(func(x): return int(x["id"]) == int(h2["id"]))
			_check(bf.size() == 1 and bf[0]["pos"] == [3, 1] and typeof(bf[0]["pos"][0]) == TYPE_INT, "the save lost where the helmet lay: %s" % (str(bf[0].get("pos")) if bf.size() == 1 else "gone"))
			back.pack_layout(back.mission)
			_check(back.mission["found"].all(func(x): return x.has("pos")) and bf[0]["pos"] == [3, 1], "the loaded pack was repacked, not kept: %s" % str(bf[0].get("pos")))
			# a bigger bag put on mid-run: the pack repacked in its shape, every piece placed
			var school: Dictionary = mk.call("Backpack", "School bag")
			m["floor"].append(school)
			m["found"].erase(h1)
			m["floor"].append(h1)
			_check(sim.take_floor(school["id"]), "the school bag didn't fit the room made")
			_check(sim.can_equip_from_pack(school["id"]) and sim.equip_from_pack(school["id"]), "a bigger bag couldn't go on from the pack")
			_check(sim.pack_w() == 6 and m["found"].all(func(x): return x.has("pos") and not x.get("strapped", false)), "the pack wasn't repacked in the new bag's shape: %d across, %s" % [sim.pack_w(), str(m["found"].map(func(x): return x.get("pos")))])
			# a smaller bag that can't hold what's carried won't go on
			var tiny: Dictionary = mk.call("Backpack", "Plastic bag")
			m["found"].append(tiny)
			sim.pack_layout(m)
			for k in range(4):
				var j: Dictionary = mk.call("Helmet", Data.BASES["Helmet"][0]["name"])
				sim._place_find(m, j)
			# (1 Nov) it goes on: what it can't hold goes to the floor, the school bag with it, nothing strapped on
			var fl0: int = m["floor"].size()
			var pv: Dictionary = sim.wear_preview(tiny["id"])
			_check(sim.equip_from_pack(tiny["id"]) and m["floor"].size() == fl0 + pv["spill"].size() + (1 if pv["off"] != null else 0) and m["floor"].size() > fl0 and m["found"].all(func(x): return x.has("pos") and not x.get("strapped", false)), "a 5x3 over a pack it can't hold: its overflow not on the floor as said (%d down, %d said)" % [m["floor"].size() - fl0, pv["spill"].size()])
	# auto (the bot's packer): a full pack's upgrade takes the place of the cheapest that frees room for it, by shape
	sim.extract_now()
	sim.loot_by_hand = false
	sim.equipped["Backpack"] = sim._plain("Backpack", "Plastic bag")
	sim.equipped["Helmet"] = null
	sim.equipped["Armour"] = sim._plain("Armour", Data.BASES["Armour"].back()["name"])     # the vest below is junk beside it
	sim._dry_memo.clear()
	sim.deploy(0)
	m = sim.mission
	m["leave_full"] = true
	m["found"] = []
	var g := 0
	while sim.pack_used(m) < sim.capacity() and g < 40:
		var med: Dictionary = mk.call(Data.MEDICAL, Data.BASES[Data.MEDICAL][0]["name"])
		sim._place_find(m, med)
		g += 1
	_check(sim.pack_used(m) == sim.capacity() and m["found"].all(func(x): return x.has("pos")), "the bot's packer didn't fill the pack with 1x1s: %d of %d" % [sim.pack_used(m), sim.capacity()])
	var up: Dictionary = mk.call("Helmet", Data.BASES["Helmet"][0]["name"])
	_check(sim.is_upgrade(up), "the fixture: a helmet with none worn isn't an upgrade")
	var before: int = m["found"].size()
	sim._place_find(m, up)
	_check(not m["found"].has(up) and m["found"].size() == before, "a 2x2 swapped for a single 1x1: it can't lie in one cell")
	# a big piece of junk at the front: its place is room for the upgrade
	m["found"] = []
	var junk: Dictionary = mk.call("Armour", "Stab vest")
	junk["value"] = 0
	sim._place_find(m, junk)
	g = 0
	while sim.pack_used(m) < sim.capacity() and g < 40:
		var med2: Dictionary = mk.call(Data.MEDICAL, Data.BASES[Data.MEDICAL][0]["name"])
		med2["value"] = 100
		sim._place_find(m, med2)
		g += 1
	var up2: Dictionary = mk.call("Helmet", Data.BASES["Helmet"][0]["name"])
	sim._place_find(m, up2)
	_check(m["found"].has(up2) and not m["found"].has(junk) and up2.has("pos"), "the upgrade didn't take the junk vest's place")
	# a mythic with no room made: strapped on, carried, no place
	var myth: Dictionary = mk.call("Helmet", Data.BASES["Helmet"][0]["name"])
	myth["mythic"] = true
	for f in m["found"]:
		f["mythic"] = true                  # every piece kept: nothing to swap out
	sim._place_find(m, myth)
	_check(m["found"].has(myth) and myth.get("strapped", false) and not myth.has("pos"), "a mythic with no room wasn't strapped on")
	sim.extract_now()
	sim.loot_by_hand = by_hand_was
	sim.load_dict(saved)


## The floor all run (27 Oct, Matt; the canvas's "The floor, all run"): its row at one height from deploy to the door, the
## rig over it in a fight and under it in the search, the take under it; a selected piece turned by R or right-click
## where it lies, refused when it won't; Salvage half again at the Workshop.
## The whole pack on one screen (28 Oct, Matt died sorting a bag split over two pages): every bag's rows fit the grid's
## height, the cells shrinking to PACK_MIN_CELL; past that (the Removal Van) it scrolls - the wheel, the arrows, a held drag.
func _pack_one_screen_checks(main) -> void:
	var sim = main.sim
	var run = main._run
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var inv = run._inv
	var avail: float = inv.page_rows * inv.CELL + (inv.page_rows - 1) * inv.GAP
	for bag in Data.BASES["Backpack"]:
		sim.equipped["Backpack"] = sim._plain("Backpack", str(bag["name"]))
		sim.hp = sim.max_hp()
		sim.deploy(0)
		if not sim.on_mission():
			_check(false, "the fixture: no run with %s" % bag["name"])
			continue
		var m: Dictionary = sim.mission
		m["found"] = []
		main.show_room(main.MISSIONS)
		main.refresh()
		_check_pack_grid(inv, sim, "the pack (%s)" % bag["name"])
		_check(not inv.scrolls() and inv.top_row == 0 and inv.outlines_shown() == sim.capacity(), "%s isn't whole on one screen: %d of %d cells drawn, %d rows at %d px" % [bag["name"], inv.outlines_shown(), sim.capacity(), sim.pack_rows(), inv.pack_cell])
		_check(inv.pack_cell >= inv.PACK_MIN_CELL and sim.pack_rows() * (inv.pack_cell + inv.GAP) - inv.GAP <= avail + 0.5, "%s's rows overrun the grid: %d rows at %d px in %.0f" % [bag["name"], sim.pack_rows(), inv.pack_cell, avail])
		_check(not inv._page_label.visible, "%s shows a page count on one screen" % bag["name"])
		# a find drawn in its last row sits inside the grid's rect
		var hat: Dictionary = sim._plain("Helmet", "Hard hat")
		var fp: Vector2i = Items.footprint(hat)
		var w: int = sim.pack_w()
		var last_y: int = int((sim.capacity() - 1) / w) - fp.y + 1
		if sim.pack_free_at(m, hat, 0, last_y, false):
			sim._pack_put(m, hat, [0, last_y, false])
			main.refresh()
			var k: int = inv.cell_of(hat["id"])
			_check(k >= 0 and inv._cells[k].position.y + inv._cells[k].size.y <= avail + 0.5, "%s: a piece in the last row is off the screen" % bag["name"])
		# measured on the run, each bag (28 Oct, the tools review: after the loop the run had ended, and the fit read the Runs screen)
		_check(main.room == main.MISSIONS and sim.on_mission(), "the fixture: %s's fit isn't the run's" % bag["name"])
		_check_fit(main, "Run (%s, one screen)" % bag["name"])
		# the piece in hand at the pack's cell (28 Oct, the review: drawn at 64 over a shrunk pack, twice its ghost)
		var held: Control = inv.drag_preview(hat, false, inv.cell_px())
		var pic: Control = held.get_child(0)
		_check(inv._live_cell == inv.cell_px(), "%s: the piece in hand is drawn at %d, the pack at %d" % [bag["name"], inv._live_cell, inv.cell_px()])
		_check(Items.art(hat) == null or (pic is TextureRect and absf(pic.size.x - inv.cpx(fp.x)) < 0.5 and absf(pic.size.y - inv.cpx(fp.y)) < 0.5), "%s: the piece in hand is %s, its ghost %d x %d" % [bag["name"], str(pic.size), inv.cpx(fp.x), inv.cpx(fp.y)])
		held.free()
		sim.extract_now()
	# the scroll: a grid of two rows for a thirteen-row bag can't shrink that far, so it scrolls
	sim.equipped["Backpack"] = sim._plain("Backpack", "Special forces bergen")
	sim.deploy(0)
	sim.mission["found"] = []
	main.show_room(main.MISSIONS)
	inv.set_rows(2)
	inv._shown = ""
	main.refresh()
	_check(inv.scrolls() and inv.pack_cell == inv.PACK_MIN_CELL and inv._page_label.visible, "a pack past the smallest cell doesn't scroll: %d px, %d of %d rows" % [inv.pack_cell, inv._view_rows, inv._reach_rows])
	var wheel := InputEventMouseButton.new()
	wheel.button_index = MOUSE_BUTTON_WHEEL_DOWN
	wheel.pressed = true
	inv._gui_input(wheel)
	main.refresh()
	_check(inv.top_row == 1, "the wheel didn't scroll the pack a row: %d" % inv.top_row)
	_check_pack_grid(inv, sim, "the pack (scrolled)")
	# the wheel over a piece, and a drag held at the bottom edge repeating with no more mouse moves (the review)
	var piece: Dictionary = sim._plain("Helmet", "Hard hat")
	sim._pack_put(sim.mission, piece, [0, inv.top_row, false])
	main.refresh()
	var pk: int = inv.cell_of(piece["id"])
	_check(pk >= 0, "the fixture: the hat isn't drawn in the scrolled pack")
	if pk >= 0:
		inv._cell_input(wheel, pk)
		main.refresh()
		_check(inv.top_row == 2, "the wheel over a piece didn't scroll: %d" % inv.top_row)
	inv._edge_dir = 1
	inv._scroll_at = 0.0
	var row0: int = inv.top_row
	inv._edge_tick(1000.0)
	inv._edge_tick(1000.1)
	inv._edge_tick(1000.3)
	_check(inv.top_row == mini(row0 + 2, inv._reach_rows - inv._view_rows), "a held drag at the edge didn't repeat every %.2f s: %d from %d" % [inv.SCROLL_EVERY, inv.top_row, row0])
	inv._edge_dir = 0
	# the edge stops once the drag leaves the pack (28 Oct, the review: it ran on to the top or the bottom)
	var gr: Rect2 = inv._grid.get_global_rect()
	_check(inv.edge_held(gr.get_center()) and not inv.edge_held(gr.position + Vector2(gr.size.x + 40.0, -40.0)) and not inv.edge_held(gr.end + Vector2(0, 60)), "the held drag's edge reads the mouse off the pack as over it: %s %s %s in %s" % [str(inv.edge_held(gr.get_center())), str(inv.edge_held(gr.position + Vector2(gr.size.x + 40.0, -40.0))), str(inv.edge_held(gr.end + Vector2(0, 60))), str(gr)])
	inv.scroll_by(99)
	main.refresh()
	_check(inv.top_row == inv._reach_rows - inv._view_rows, "the scroll ran past the pack's end: %d" % inv.top_row)
	# the page count at the bottom is the last page, its › off (28 Oct, the review: "2/3" and a dead arrow)
	var last_pages: String = inv._page_label.text.get_slice("/", 1)
	_check(inv._page_label.text == "%s/%s" % [last_pages, last_pages] and inv._page_next.disabled and not inv._page_prev.disabled, "at the pack's bottom the count reads '%s', › %s" % [inv._page_label.text, "off" if inv._page_next.disabled else "live"])
	inv.scroll_by(-99)
	main.refresh()
	_check(inv._page_label.text.begins_with("1/") and inv._page_prev.disabled, "at the pack's top the count reads '%s'" % inv._page_label.text)
	var turns := 0
	while not inv._page_next.disabled and turns < 40:
		inv._turn(1)
		main.refresh()
		turns += 1
	_check(inv.top_row == inv._reach_rows - inv._view_rows and inv._page_label.text == "%s/%s" % [last_pages, last_pages] and turns == int(last_pages) - 1, "› a screen at a time didn't reach the last page in %s: %d turns, '%s', row %d" % [last_pages, turns, inv._page_label.text, inv.top_row])
	_check_fit(main, "Run (the pack scrolled)")
	inv.scroll_by(-99)
	inv.set_rows(inv.ROWS)
	inv._shown = ""
	sim.extract_now()
	# the Removal Van at the grid's own rows (the tools review): whole on a screen, or scrolling with › reaching its bottom
	var van: Dictionary = Items.roll_unique(sim._unique_named("The Removal Van"), sim.rng, -1, 1)
	sim.equipped["Backpack"] = van
	sim.hp = sim.max_hp()
	sim.deploy(0)
	_check(sim.on_mission() and sim.has_rule("removal_van"), "the fixture: no run with the Removal Van")
	if sim.on_mission():
		sim.mission["found"] = []
		main.show_room(main.MISSIONS)
		inv._shown = ""
		main.refresh()
		_check(inv.scrolls() == (inv._reach_rows > inv._view_rows) and (inv.scrolls() or inv.outlines_shown() == sim.capacity()), "the Removal Van's pack is neither whole nor scrolling: %d px, %d of %d rows, %d of %d cells" % [inv.pack_cell, inv._view_rows, inv._reach_rows, inv.outlines_shown(), sim.capacity()])
		var vt := 0
		while not inv._page_next.disabled and vt < 40:
			inv._turn(1)
			main.refresh()
			vt += 1
		var vp: String = inv._page_label.text.get_slice("/", 1)
		_check(inv.top_row == inv._reach_rows - inv._view_rows and inv._page_label.text == "%s/%s" % [vp, vp], "the Removal Van's › stopped short: row %d of %d, '%s'" % [inv.top_row, inv._reach_rows - inv._view_rows, inv._page_label.text])
		_check_fit(main, "Run (the Removal Van, scrolled)")
		inv.scroll_by(-99)
		sim.extract_now()
	sim.load_dict(saved)
	main.refresh()
	print("the pack on one screen ok: every bag whole, the cells shrunk to fit, the last row inside, the scroll past the smallest cell")


func _floor_all_run_checks(main) -> void:
	var sim = main.sim
	var run = main._run
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var by_hand_was: bool = sim.loot_by_hand
	# the geometry: the fight's rig over the floor, the take under it; the search's rig under it, over the buttons
	var floor_y: float = run.CRATES_Y + CratesPanel.FINDS_HEAD_Y
	_check(run.RIG_Y + run.RIG_ROOM + 4 <= floor_y and run.CRATES_Y + CratesPanel.HEIGHT + 4 <= run.TAKE_Y and run.RIG_SEARCH_Y + Pal.CELL <= run.BUTTON_Y,
		"the floor's row overlaps the rig or the take: rig %d-%d, floor %d-%d, take %d" % [run.RIG_Y, run.RIG_Y + run.RIG_ROOM, floor_y, run.CRATES_Y + CratesPanel.HEIGHT, run.TAKE_Y])
	sim.loot_by_hand = true
	sim.equipped["Backpack"] = sim._plain("Backpack", "Plastic bag")
	sim.hp = sim.max_hp()
	sim.deploy(0)
	var m: Dictionary = sim.mission
	m["found"] = []
	main.show_room(main.MISSIONS)
	var hat: Dictionary = sim._plain("Helmet", Data.BASES["Helmet"][0]["name"])
	m["floor"] = [hat]
	main.refresh()
	_check(not m["cleared"] and run._crates.visible and not run._crates._head.visible and not run._crates._tiles[0]["panel"].visible and run._crates._floor_ids.has(int(hat["id"])) and run._crates._finds_head.text.begins_with("ON THE FLOOR"),
		"the floor isn't on screen in the fight, or the crates' row is: '%s'" % run._crates._finds_head.text)
	_check(is_equal_approx(run._crates.position.y, run.CRATES_Y) and is_equal_approx(run._rig_y, run.RIG_Y), "the fight's floor or rig isn't where it sits: floor %.0f, rig %.0f" % [run._crates.position.y, run._rig_y])
	_check_fit(main, "Run (the floor in the fight)")
	# turned where it lies: a 2x1 at the top left, R picks it up a column; blocked below, refused
	var pistol: Dictionary = sim._plain("Secondary", Data.BASES["Secondary"][0]["name"])
	if Items.footprint(pistol) == Vector2i(2, 1):
		sim._place_find(m, pistol)
		_check(pistol.get("pos", []) == [0, 0] and not pistol.get("rot", true), "the fixture: the 2x1 isn't flat at the top left: %s" % str(pistol.get("pos")))
		main.refresh()
		run._inv.selected = int(pistol["id"])
		var ev := InputEventKey.new()
		ev.keycode = KEY_R
		ev.pressed = true
		run._inv._unhandled_key_input(ev)
		_check(pistol.get("rot", false) and pistol["pos"] == [0, 0], "R didn't turn the selected piece where it lies: %s %s" % [str(pistol.get("pos")), str(pistol.get("rot"))])
		run._inv._unhandled_key_input(ev)
		_check(not pistol.get("rot", true), "R didn't turn it back")
		var med: Dictionary = sim._plain(Data.MEDICAL, Data.BASES[Data.MEDICAL][0]["name"])
		sim._place_find(m, med)                  # the next cell along: [2, 0]; then one under the pistol's first cell
		var med2: Dictionary = sim._plain(Data.MEDICAL, Data.BASES[Data.MEDICAL][0]["name"])
		_check(sim.pack_move(int(med["id"]), 0, 1, false), "the fixture: a med won't go under the pistol")
		_check(not sim.pack_turn(int(pistol["id"])) and not pistol.get("rot", true), "a piece turned onto another's cell")
		# the right button: picks and turns (the cell's own input)
		sim.pack_move(int(med["id"]), 4, 2, false)
		main.refresh()
		run._inv.selected = -1
		var k: int = run._inv.cell_of(int(pistol["id"]))
		var rc := InputEventMouseButton.new()
		rc.button_index = MOUSE_BUTTON_RIGHT
		rc.pressed = true
		if k >= 0:
			run._inv._cell_input(rc, k)
		_check(run._inv.selected == int(pistol["id"]) and pistol.get("rot", false), "a right-click didn't pick the piece and turn it")
		m["found"].erase(med2)
	# Salvage: half again at the Workshop, nothing from a ditch
	sim.extract_now()
	var sal: String = Data.node_id_named("Stripping/Salvage")
	_set_cls(sim, "Scrapper")
	if not sim.tree.has(sal):
		sim.tree.append(sal)
	sim._rules_key = []
	var junk: Dictionary = sim._plain("Armour", "Riot suit")
	sim.stash.append(junk)
	var before: int = sim.scrap
	if sim.has_node("salvage") and sim.room_open("workshop"):
		_check(sim.scrap_item(int(junk["id"])) and sim.scrap == before + int(ceil(sim.scrap_of(junk) * Data.FX["node/salvage"])), "Salvage didn't pay half again at the Workshop: %d from %d" % [sim.scrap, before])
	else:
		_check(false, "the fixture: Salvage not on (%s) or the Workshop shut" % str(sim.has_node("salvage")))
	sim.loot_by_hand = by_hand_was
	sim.load_dict(saved)
	main.refresh()


## The deeds' fate read by the Bailiff and the Issue (27 Oct, Matt: "what can we do with the options we already have"):
## burned, his warrant's void; held, he seizes the deeds, not your kit, and keeps them if the run ends in his hands;
## sold, he drops them once when he's down; held deeds stay out of the Issue's pile.
func _deeds_bailiff_checks(sim, head_run: Callable) -> void:
	var deeds_of := func() -> Array: return sim.stash.filter(func(x): return Items.is_deeds(x))
	for d in deeds_of.call():
		sim.stash.erase(d)
	# burned: nothing seized, nothing taken from the fire
	sim.deeds_fate = "burned"
	var m: Dictionary = head_run.call("bailiff")
	sim._order_tick(m, m["t"], 0.1, "bailiff")
	_check(not bool(m.get("seize_on", true)) and is_equal_approx(sim.county_taken(m), 1.0), "the deeds burned, the Bailiff still seized: %s" % str(m.get("seized")))
	# held: the deeds seized, no cost to the fight; the chip says so; let go under half
	var deeds: Dictionary = sim._plain(Data.PAPER, "The deeds")
	deeds["deeds"] = true
	sim.extract_now()
	sim.stash.append(deeds)
	sim.deeds_fate = "held"
	m = head_run.call("bailiff")
	sim._order_tick(m, m["t"], 0.1, "bailiff")
	_check(str(m.get("seized", "")) == sim.DEEDS_SEIZED and bool(m["seize_on"]) and is_equal_approx(sim.county_taken(m), 1.0), "held, the Bailiff didn't take the deeds instead of your kit: %s, ×%.2f" % [str(m.get("seized")), sim.county_taken(m)])
	_check(sim.order_chips(true).any(func(c): return str(c[0]).contains("the deeds")), "the Seized chip doesn't name the deeds: %s" % str(sim.order_chips(true)))
	m["target_hp"] = 400.0
	sim._order_tick(m, m["t"], 0.1, "bailiff")
	sim.extract_now()
	_check(sim.stash.has(deeds) and sim.deeds_fate == "held", "the deeds let go under half weren't kept: %s" % sim.deeds_fate)
	# held, and the run ends in his hands: he keeps them, sold, for good
	m = head_run.call("bailiff")
	sim._order_tick(m, m["t"], 0.1, "bailiff")
	sim.extract_now()
	_check(not sim.stash.has(deeds) and sim.deeds_fate == "sold" and sim.deeds_back, "left in the Bailiff's hands, the deeds weren't his: fate %s, in the stash %s" % [sim.deeds_fate, str(sim.stash.has(deeds))])
	# a real Bailiff down (the review: down, the head's mech reads nothing): held, in one blow from over half - kept
	var bailiff_down := func() -> Dictionary:
		var mx: Dictionary = head_run.call("bailiff")
		mx["boss"] = sim._boss_entry({"name": "The Bailiff", "hp": 1000.0, "dps": 1.0, "zone": 0, "order": "truck_stop", "mech": "bailiff", "remix": true})
		mx["boss"]["started"] = true
		mx["target_hp"] = 1000.0
		sim._order_tick(mx, mx["t"], 0.1, "bailiff")
		sim._boss_down(mx, mx["t"])
		return mx
	var d1: Dictionary = sim._plain(Data.PAPER, "The deeds")
	d1["deeds"] = true
	sim.stash.append(d1)
	sim.deeds_fate = "held"
	sim.deeds_back = false
	m = bailiff_down.call()
	_check(str(m.get("seized", "")) == sim.DEEDS_SEIZED and not bool(m.get("seize_on", true)), "the Bailiff down still holds the deeds")
	sim.extract_now()
	_check(sim.stash.has(d1) and sim.deeds_fate == "held", "the Bailiff killed in one blow kept the held deeds: fate %s" % sim.deeds_fate)
	sim.stash.erase(d1)
	# sold (not to him): down, he drops them once
	sim.deeds_fate = "sold"
	m = bailiff_down.call()
	_check(m["found"].any(func(x): return Items.is_deeds(x)) and sim.deeds_fate == "" and sim.deeds_back, "the Bailiff down didn't drop the sold deeds: fate %s" % sim.deeds_fate)
	sim.extract_now()
	sim.stash = sim.stash.filter(func(x): return not Items.is_deeds(x))
	sim.deeds_fate = "sold"
	m = bailiff_down.call()
	_check(not m["found"].any(func(x): return Items.is_deeds(x)), "the Bailiff dropped the deeds a second time")
	sim.extract_now()
	# held deeds stay out of the Issue's pile, and are burned at home
	var d2: Dictionary = sim._plain(Data.PAPER, "The deeds")
	d2["deeds"] = true
	sim.stash.append(d2)
	_check(not sim._kit_held().has(d2), "the deeds count in the Issue's pile")
	sim.deeds_fate = "held"
	_check(sim.burn_deeds(int(d2["id"])) and not sim.stash.has(d2) and sim.deeds_fate == "burned", "burning the held deeds at home didn't")
	# the Radio's line for the fate: only the fate's own is said
	var heard0: Array = sim.heard.duplicate()
	var keys := {}
	for k in range(Words.RADIO.size()):
		var r: Dictionary = Words.RADIO[k]
		var key := "%s/%d" % [r["voice"], k]
		if str(r.get("deeds", "")) != "":
			keys[str(r["deeds"])] = key
		elif not (key in sim.heard):
			sim.heard.append(key)                 # every other line heard: the deeds' are next
	for f in keys:
		sim.heard.erase(keys[f])                  # said earlier in the smoke, as a fate came and went: unheard for the check
	for f in ["burned", "held", "sold"]:
		sim.deeds_fate = f
		_check(keys.has(f) and str(sim.radio_next().get("key", "")) == str(keys.get(f, "?")), "the Radio didn't say the deeds' %s line: %s" % [f, str(sim.radio_next())])
	sim.heard = heard0


## The body: a stash item dropped on its own slot's box is taken and equipped;
## on every other box it is refused; dragged off, the stash takes it back and
## the slot is empty. Every slot pair, with a plain item of each slot.
func _body_drops(main) -> void:
	var sim = main.sim
	while not sim.stash_room(30) and not sim.stash.is_empty():
		sim.sell(sim.stash[0])                 # room for the swaps, both ways: the run may have filled it
	_check(sim.stash_room(30), "no room could be made in the stash: %d of %d" % [sim.stash_used(), sim.stash_cap()])
	main.show_room(main.ARMOURY)
	var body = main._armoury._body
	for slot in Data.SLOTS:
		var it: Dictionary = sim._plain(slot, Data.BASES[slot][0]["name"])
		sim.stash.append(it)
		main.refresh()
		var data := {"id": it["id"], "src": "stash"}
		for other in Data.SLOTS:
			var ok: bool = body._can_drop(Vector2.ZERO, data, other)
			_check(ok == (other == slot), "a %s dropped on the %s box was %s" % [slot.to_lower(), other.to_lower(), "taken" if ok else "refused"])
		var was = sim.equipped[slot]
		var stash_n: int = sim.stash.size()
		var over: int = sim.rig_overflow(it).size() if slot == "Rig" else 0     # a smaller rig's overflow back to the stash (30 Oct)
		body._drop(Vector2.ZERO, data, slot)
		_check(sim.equipped[slot] != null and sim.equipped[slot]["id"] == it["id"], "a drop on the %s box did not equip" % slot.to_lower())
		_check(sim.stash.size() == stash_n - (1 if was == null else 0) + over, "the swap out of the %s box did not return the old item to the stash" % slot.to_lower())
		_check(main._armoury.selected.get("slot", "") == slot, "the selection did not follow the drop into the %s box" % slot.to_lower())
		main.refresh()
		_check_fit(main, "Armoury (body drop %s)" % slot.to_lower())
		# off again: the stash takes a "body" drop
		_check(main._armoury._inv._can_drop_data(Vector2.ZERO, {"id": it["id"], "src": "body", "slot": slot}), "the stash refused the %s dragged off the body" % slot.to_lower())
		main._armoury._inv._drop_data(Vector2.ZERO, {"id": it["id"], "src": "body", "slot": slot})
		_check(sim.equipped[slot] == null, "dragging the %s off the body did not unequip it" % slot.to_lower())
		_check(main._armoury.selected.get("kind", "") == "stash" and main._armoury.selected.get("id", -1) == it["id"], "the selection did not follow the %s back to the stash" % slot.to_lower())
		main.refresh()
		_check_fit(main, "Armoury (body empty %s)" % slot.to_lower())
		if was != null:
			sim.equip_item(was["id"])
		sim.sell(it)
	# a drop needs room for what comes off: a full stash refuses the swap
	var heavy: Dictionary = sim._plain("Armour", "Riot suit")
	var light: Dictionary = sim._plain("Armour", "Stab vest")
	var old = sim.equipped["Armour"]
	while not sim.stash_room(30) and not sim.stash.is_empty():
		sim.sell(sim.stash[0])
	sim.stash.append(heavy)
	_check(sim.equip_item(heavy["id"]), "the riot suit did not go on for the room test")
	sim.stash.append(light)
	var filler := []
	while sim.stash_used() + Items.size(heavy) - Items.size(light) <= sim.stash_cap():
		var f: Dictionary = sim._plain("Ammo", "Nails")
		filler.append(f)
		sim.stash.append(f)
	_check(not body._can_drop(Vector2.ZERO, {"id": light["id"], "src": "stash"}, "Armour"), "a swap with no stash room for what comes off was allowed")
	for f in filler:
		sim.stash.erase(f)
	_check(body._can_drop(Vector2.ZERO, {"id": light["id"], "src": "stash"}, "Armour"), "a swap with stash room was refused")
	sim.stash.erase(light)
	sim.equipped["Armour"] = old
	print("body drag and drop ok: every slot pair")


## A chip row's words, the shown chips only.
func _chip_texts(ch) -> Array:
	var out := []
	for k in range(ch._panels.size()):
		if ch._panels[k].visible:
			out.append(ch._labels[k].text)
	return out


## The Stats sheet's geometry (10 Oct): every part inside the room and apart from the others; each row, bar and tile
## inside its part; the band's words inside the band.
func _stats_layout(main, where: String) -> int:
	var bad := 0
	var st = main._stats
	var room := Rect2(Vector2.ZERO, st.size)
	var rects := {}
	for k in st.cards:
		var p: Panel = st.cards[k]["panel"]
		rects[k] = Rect2(p.position, p.size)
		if not room.encloses(rects[k]):
			push_error("%s: the sheet's %s leaves the room (%s)" % [where, k, str(rects[k])])
			bad += 1
	for a in rects:
		for b in rects:
			if str(a) < str(b) and rects[a].intersects(rects[b]):
				push_error("%s: the sheet's %s and %s overlap" % [where, a, b])
				bad += 1
		var band_r := Rect2(st.band.position, st.band.size)
		if band_r.intersects(rects[a]):
			push_error("%s: the sheet's %s runs into the band" % [where, a])
			bad += 1
	for k in st.cards:
		var c: Dictionary = st.cards[k]
		var inner: Rect2 = rects[k].grow(-1.0)
		var parts: Array = []
		for key in c.keys():
			var v = c[key]
			if v is Control and v != c["panel"] and v.visible and v.get_parent() == st:
				parts.append(v)
			elif v is Array:
				for e in v:
					if e is Dictionary:
						for e2 in e.values():
							if e2 is Control and e2.get_parent() == st and e2.visible:
								parts.append(e2)
		for n in parts:
			var r := Rect2(n.position, n.size)
			if n is Label and (n as Label).text == "":
				continue
			if not inner.encloses(r) and not (n == c.get("edge")):
				push_error("%s: the sheet's %s has a piece outside it: %s %s" % [where, k, n.name, str(r)])
				bad += 1
	for l in [st.band.kicker, st.band.title, st.band.headline, st.band.unit]:
		if l.text != "" and (l.position.y < 0.0 or l.position.y + l.size.y > st.band.size.y + 0.5):
			push_error("%s: the sheet's band word '%s' leaves the band" % [where, l.text])
			bad += 1
	var t_r := Rect2(st.band.title.position, Vector2(UI.text_width(st.band.title, st.band.title.text), st.band.title.size.y))
	var h_r := Rect2(st.band.headline.position, Vector2(UI.text_width(st.band.headline, st.band.headline.text), st.band.headline.size.y))
	if t_r.intersects(h_r):
		push_error("%s: the sheet's band title and headline overlap" % where)
		bad += 1
	return bad


## The points free across the web (the skill web, 3 Nov): the runner's and the ring's.
func _web_free(sim) -> int:
	return sim.points_free() + sim.paragon_free()


func _check_fit(main, where: String) -> void:
	var bad := 0
	for k in range(main._cards.size()):
		var c = main._cards[k]
		if c.visible:
			bad += _check_nodes(c.text_nodes(), c.line_pairs(), "%s card %d" % [where, k])
	if main.room == main.MISSIONS and main.sim.on_mission() and not main.sim.unwatched():     # a repeat's run (29 Oct): the Map stays
		bad += _check_nodes(main._run.text_nodes(), main._run.line_pairs(), where + " run screen")
	elif main.room == main.MISSIONS:
		bad += _check_nodes(main._missions.text_nodes(), main._missions.line_pairs(), where + " screen")
	elif main.room == main.COMMS:
		bad += _check_nodes(main._radio.text_nodes(), main._radio.line_pairs(), where + " screen")
	elif main.room == main.WORKSHOP:
		bad += _check_nodes(main._workshop.text_nodes(), main._workshop.line_pairs(), where + " screen")
	elif main.room == main.BARRACKS:
		bad += _check_nodes(main._barracks.text_nodes(), main._barracks.line_pairs(), where + " screen")
	elif main.room == main.MARKET:
		bad += _check_nodes(main._fence.text_nodes(), main._fence.line_pairs(), where + " screen")
		_check(main._fence.face_clear(), where + ": the Fence's face is under something")
	elif main.room == main.MEDIC:
		bad += _check_nodes(main._clinic.text_nodes(), main._clinic.line_pairs(), where + " screen")
		_check(main._clinic.face_clear(), where + ": the medic's face is under something")
	elif main.room == main.RUNNER:
		bad += _check_nodes(main._stats.text_nodes(), [], where + " screen")
		bad += _stats_layout(main, where)
	elif main.room == main.ARMOURY:
		bad += _check_nodes(main._armoury.text_nodes(), main._armoury.line_pairs() if main._armoury.has_method("line_pairs") else [], where + " screen")
		_check_grid(main._armoury._inv, main.sim.tab_cap(main._armoury._inv.tab), where + " stash grid")
		_check(main._armoury._containers.rig_inside(), "%s: the rig (%.0f px pouches) runs out of its room" % [where, main._armoury._containers.rig_cell()])
		# the body's boxes: inside the panel, none overlapping, and the item cell inside its box
		var body = main._armoury._body
		for a in Data.SLOTS:
			var ra: Rect2 = body.box_rect(a)
			_check(Rect2(Vector2.ZERO, body.size).encloses(ra), "%s: the %s box leaves the body panel" % [where, a])
			var cell = body._boxes[a]["cell"]
			if cell.visible:
				_check(Rect2(Vector2.ZERO, ra.size).encloses(Rect2(cell.position, cell.size)), "%s: the %s in its box overflows it" % [where, a])
			for b in Data.SLOTS:
				if a < b:
					_check(not ra.intersects(body.box_rect(b)), "%s: the %s and %s boxes overlap" % [where, a, b])
	if main.room == main.OVERVIEW and main._yard_tree.visible:
		bad += _check_nodes(main._yard_tree.text_nodes(), main._yard_tree.line_pairs(), where + " yard tree")
		# the Pitch's cards (28 Oct): inside the room, none on another
		var yt = main._yard_tree
		for a_i in range(yt.cards.size()):
			var ra: Rect2 = Rect2(yt.cards[a_i]["button"].position, yt.cards[a_i]["button"].size)     # in the room's own space
			if not Rect2(Vector2.ZERO, yt.size).grow(1.0).encloses(ra):
				push_error("%s: the Pitch's %s card runs out of the room: %s in %s" % [where, yt.cards[a_i]["key"], str(ra), str(yt.get_global_rect())])
				bad += 1
			for b_i in range(a_i + 1, yt.cards.size()):
				if ra.intersects(Rect2(yt.cards[b_i]["button"].position, yt.cards[b_i]["button"].size)):
					push_error("%s: the Pitch's %s and %s cards overlap" % [where, yt.cards[a_i]["key"], yt.cards[b_i]["key"]])
					bad += 1
	var rail_nodes := []
	for name in main.ROOMS:
		var b = main._rail_buttons[name]
		rail_nodes.append_array(b.text_nodes())
		if b.badge_gap() < 8.0:
			push_error("rail %s: badge overlaps the name" % name)
			bad += 1
		if b._glyph.texture == null:
			var gname: String = b.GLYPH_OF.get(name, "")
			if gname == "" or FileAccess.file_exists(("res://art/%s.png" if gname.contains("/") else "res://art/ui/%s.png") % gname):     # the loader's own rule (13 Oct, the rail's in art/rail)
				push_error("rail %s: no glyph" % name)
				bad += 1                         # a glyph named and painted but not shown is a bug; one not yet painted is an art gap (stats.png, 9 Oct)
		if b._rule.visible == b.last:
			# the last row has no hairline under it (8 Oct, Matt: a line past the Radio); the rest have one
			push_error("rail %s: the hairline is %s on the %s row" % [name, "on" if b._rule.visible else "off", "last" if b.last else "a middle"])
			bad += 1
	bad += _check_nodes(rail_nodes, [], where + " rail")
	if main._away.visible:
		bad += _check_nodes(main._away.text_nodes(), [], where + " away card")     # the runner away (29 Oct)
	# the rail runs to the log's bottom (8 Oct, Matt: "the rail should span to the bottom of the log bar")
	var rail_end: float = main._rail.position.y + main._rail_panel.size.y
	var log_end: float = main._events.position.y + Pal.EVENTS_H
	if main._events.position.y > 0.0 and absf(rail_end - log_end) > 1.0:      # once laid out (the smoke's shell never is: the log sits at 0)
		push_error("%s: the rail ends at %.0f, the log at %.0f" % [where, rail_end, log_end])
		bad += 1
	bad += _check_nodes(main._top_labels.values(), [], where + " top bar")
	bad += _check_nodes([main._prev_time, main._prev_label], [], where + " log (the line before)")
	var cur: Label = main._event_labels[0]
	if main._prev_label.text != "" and main._prev_time.position.x < cur.position.x + ceilf(UI.text_width(cur, cur.text)) + main.PREV_GAP - 0.5:
		push_error("%s: the line before runs into the latest" % where)
		bad += 1
	# the log line starts just after its time (8 Oct: left-justified)
	var et: Label = main._event_times[0]
	if et.text != "" and absf(main._event_labels[0].position.x - (20 + ceilf(UI.text_width(et, et.text)) + 16)) > 0.5:
		push_error("%s: the log line sits apart from its time" % where)
		bad += 1
	bad += _check_nodes([main._top_caption], [], where + " top bar caption")
	# the purse (10 Oct, Bar-C): left to right the place, notes, scrap, the salvage found, cash, each glyph before its
	# figure, none on the next, and the lot clear of the HP, XP and damage
	var purse_from := 0.0
	for k in ["hp", "xp", "dps"]:
		var lk: Label = main._top_labels[k]
		purse_from = maxf(purse_from, maxf(main._top_lines[k][0].position.x + main._top_lines[k][0].size.x, lk.position.x + UI.text_width(lk, lk.text)))
	for k in ["where", "notes", "scrap", "copper", "steel", "army", "cash"]:
		var g: TextureRect = main._top_glyphs[k]
		if not g.visible:
			continue
		if g.position.x < purse_from + 8.0:
			push_error("%s: the top bar's %s runs into what's before it (%.0f < %.0f)" % [where, k, g.position.x, purse_from + 8.0])
			bad += 1
		var pl: Label = main._top_labels[k]
		purse_from = (pl.position.x + pl.size.x) if pl.visible else g.position.x + g.size.x
		if pl.visible and g.position.x + g.size.x > pl.position.x + pl.size.x - UI.text_width(pl, pl.text) + 0.5:
			push_error("%s: the top bar's %s glyph sits on its figure" % [where, k])
			bad += 1
	for k in main._top_glyphs:
		if main._top_glyphs[k].texture == null:
			push_error("%s: the top bar's %s glyph is missing" % [where, k])
			bad += 1
	# LEVEL before the figure (Matt, 8 Oct: "1 LEVEL" read wrong), the purse's glyphs before their figures
	var lvl: Label = main._top_labels["level"]
	if lvl.position.x < main._top_caption.position.x + UI.text_width(main._top_caption, main._top_caption.text) + 4.0:
		push_error("%s: the level's figure sits on LEVEL" % where)
		bad += 1
	# the three lines under the runner's figures read the same (Matt, 8 Oct): one width, one row
	for k in ["hp", "xp", "dps"]:
		if not main._top_lines.has(k) or main._top_lines[k][0].size.x != main._top_lines["hp"][0].size.x or main._top_lines[k][0].position.y != main._top_lines["hp"][0].position.y:
			push_error("%s: the top bar's %s line is not the HP line's" % [where, k])
			bad += 1
	_check(main._top_labels["dps"].text.ends_with(" dmg/s") and main._top_labels["xp"].position.x > main._top_labels["hp"].position.x and main._top_labels["dps"].position.x > main._top_labels["xp"].position.x,     # HP, XP, then damage (8 Oct)
			"%s: the top bar's dmg/s is off: '%s'" % [where, main._top_labels["dps"].text])
	if main._menu.visible:
		bad += _check_nodes(main._menu.text_nodes(), [], where + " menu")
		var pr: Rect2 = main._menu.panel_rect()
		var mn = main._menu
		var foot: float = mn.PAD if mn.shape() == "card" else 0.0
		for i in range(mn._items.size()):
			var b = mn._rows[i]
			_check(b.position.y + b.size.y + foot <= mn._panel.size.y + 0.5, "%s menu: row %d runs off the panel" % [where, i])
			_check(b.position.x + b.size.x <= mn._panel.size.x + 0.5, "%s menu: row %d runs off the panel's side" % [where, i])
			# a row's stamp carries a glyph that exists when the item brings one (the menus' line drawings, 8 Oct)
			if str(mn._items[i].get("glyph", "")) != "":
				_check(mn._glyphs[i].visible and mn._glyphs[i].texture != null and mn._stamps[i].visible, "%s menu: row %d's glyph %s is missing" % [where, i, mn._items[i]["glyph"]])
				_check(mn._names[i].position.x >= mn.STAMP_X + mn.STAMP, "%s menu: row %d's name sits on its stamp" % [where, i])
		_check(pr.position.y >= 0.0 and pr.end.y <= 1080.0, "%s menu: the panel leaves the screen (%s)" % [where, pr])
		match mn.shape():
			"title":
				# the column: the wordmark at its head, the rows under it, the foot under them, all inside the column
				var vs: Vector2 = mn.get_viewport_rect().size if mn.is_inside_tree() else Vector2(1920, 1080)      # as the menu lays itself out
				var x0: float = floorf((vs.x - 1920.0) / 2.0)
				_check(pr.position.x >= x0 + mn.COLUMN_X - 0.5 and pr.end.x <= x0 + mn.COLUMN_W + 0.5, "%s menu: the title's rows leave the column (%s)" % [where, pr])
				_check(not mn._wordmark.visible or mn._wordmark.position.y + mn._wordmark.size.y <= pr.position.y, "%s menu: the wordmark runs into the rows" % where)
				_check(not mn._wordmark.visible or mn._wordmark.position.x + mn._wordmark.size.x <= x0 + mn.COLUMN_W + 0.5, "%s menu: the wordmark leaves the column" % where)
				_check(mn._foot_left.visible and mn._foot_left.position.y >= pr.end.y, "%s menu: the foot runs into the rows" % where)
				_check(not mn._title.visible and mn._stamps[0].visible, "%s menu: the title shows its heading, or no stamps" % where)
				# the wordmark is drawn at the painting's own 3x, whole pixels (the 29 Oct wordmark, 167 x 88: 501 x 264)
				_check(typeof(mn.WORDMARK_SCALE) == TYPE_INT and mn.WORDMARK_SCALE == 3 and (not mn._wordmark.visible or mn._wordmark.size == mn._wordmark.texture.get_size() * mn.WORDMARK_SCALE), "%s menu: the wordmark is not drawn at %dx (%s)" % [where, mn.WORDMARK_SCALE, str(mn._wordmark.size)])
				# the wordmark loads wherever the file is (the editor, a pack): the Deck's builds had none (8 Oct)
				_check(not FileAccess.file_exists(mn.WORDMARK_ART) or (mn._wordmark.visible and mn._wordmark.texture != null and mn._wordmark.texture.get_size() == Vector2(167, 88)), "%s menu: the wordmark did not load from %s (%s)" % [where, mn.WORDMARK_ART, str(mn._wordmark.texture.get_size()) if mn._wordmark.texture != null else "null"])
			"drawer":
				# the drawer is the rail's rect exactly, its kicker up, names only
				var rail := Rect2(main._rail.position, Vector2(Pal.RAIL_W, main._rail_panel.size.y))     # the rail unfolded's, folded or not (15 Oct)
				_check(pr.is_equal_approx(rail), "%s menu: the drawer is not the rail's rect (%s vs %s)" % [where, pr, rail])
				_check(mn._kicker.visible and mn._kicker.text.begins_with("PAUSED"), "%s menu: the drawer's kicker is '%s'" % [where, mn._kicker.text])
				_check(mn._details.size() > 0 and mn._details.all(func(dl): return dl.text == ""), "%s menu: the drawer's rows carry details" % where)
			_:
				_check(mn._title.visible, "%s menu: the card has no heading" % where)
	bad += _check_nodes(main._juice.text_nodes(), [], where + " toasts")
	# and the sweep: every label showing anywhere, whether or not its screen
	# lists it - a label the lists miss is the one that trails off in play
	var all_labels := []
	_labels_under(main, all_labels)
	bad += _check_widths(all_labels, where + " (sweep)")
	bad += _check_buttons_clear(main, all_labels, where + " (sweep)")
	_misfits += bad


## No button over a label's text beside it in the same panel (the Bench's
## upgrade button clipped the words above it). Same parent only: headless,
## panels placed by the shell's layout can still be at their birth positions,
## so rects across panels don't compare.
func _check_buttons_clear(main, labels: Array, where: String) -> int:
	var UI_v = load("res://scripts/ui/ui.gd")
	var buttons := []
	_buttons_under(main, buttons)
	var bad := 0
	for b in buttons:
		var br := Rect2(b.position, b.size)
		for l in labels:
			if l is Button or l.get_parent() != b.get_parent():
				continue
			if l.has_meta("over_art") and l.get_index() > b.get_index():
				continue                         # a caption drawn over an item's art on purpose (the loadout's cards)
			var x: Rect2 = br.intersection(Rect2(l.position, l.size).intersection(_text_rect_local(l, UI_v)))
			if x.size.x > 2.0 and x.size.y > 2.0:
				push_error("%s: the button '%s' sits on '%s' (%.0f × %.0f px)" % [where, b.text, l.text, x.size.x, x.size.y])
				bad += 1
	return bad


## A label's text rect in its parent's space: its width at its alignment, the font's height centred.
static func _text_rect_local(n: Control, UI_v) -> Rect2:
	var tw: float = UI_v.text_width(n, n.text)
	var f: Font = n.get_theme_font("font")
	var th: float = f.get_height(n.get_theme_font_size("font_size"))
	var x := n.position.x
	if n.horizontal_alignment == HORIZONTAL_ALIGNMENT_RIGHT:
		x = n.position.x + n.size.x - tw
	elif n.horizontal_alignment == HORIZONTAL_ALIGNMENT_CENTER:
		x = n.position.x + (n.size.x - tw) / 2.0
	return Rect2(x, n.position.y + (n.size.y - th) / 2.0, tw, th)


static func _buttons_under(n: Node, out: Array) -> void:
	if n is CanvasItem and not n.visible:
		return
	if n is Button:
		out.append(n)
	for c in n.get_children():
		_buttons_under(c, out)


## Width alone: the text fits its box. (A menu over a room puts its words over
## the room's, so the sweep doesn't judge overlap.)
func _check_widths(nodes: Array, where: String) -> int:
	var UI_v = load("res://scripts/ui/ui.gd")
	var bad := 0
	for n in nodes:
		var w: float = UI_v.text_width(n, n.text) + (32.0 if n is Button else 0.0)
		if w > n.size.x + 0.5:
			push_error("%s: '%s' needs %.0f px, has %.0f (%s)" % [where, n.text, w, n.size.x, _chain(n)])
			bad += 1
		if UI_v.dots(n.text) != n.text:
			push_error("%s: '%s' wants a capital after the · (the caps pass, 27 Oct) (%s)" % [where, n.text, _chain(n)])
			bad += 1
	return bad


## A node's parents' scripts and names, for a sweep error to say which label it was.
static func _chain(n: Node) -> String:
	var parts := []
	var q = n
	while q != null and parts.size() < 5:
		var sc = q.get_script()
		parts.append((sc.resource_path.get_file().get_basename() if sc != null else q.get_class()) + ("" if q.name.begins_with("@") else ":" + q.name))
		q = q.get_parent()
	return " < ".join(parts)


## Every single-line Label under n that's showing, with text.
static func _labels_under(n: Node, out: Array) -> void:
	if n is CanvasItem and not n.visible:
		return
	if n is Label and n.text != "" and n.autowrap_mode == TextServer.AUTOWRAP_OFF:
		out.append(n)
	elif n is Button and n.text != "" and n.icon == null:
		out.append(n)
	for c in n.get_children():
		_labels_under(c, out)


## Visible up the chain of controls (headless, the window itself reports hidden).
static func _showing(n: Node) -> bool:
	var p = n
	while p is CanvasItem:
		if not p.visible:
			return false
		p = p.get_parent()
	return true


## A control's position on screen, summing positions up the chain (this UI never scales).
static func _screen_pos(n: Node) -> Vector2:
	var p := Vector2.ZERO
	var q = n
	while q is Control:
		p += q.position
		q = q.get_parent()
	return p


## Where a label's text sits on screen: its width at its alignment, its box's height.
static func _text_rect(n: Control, UI_v) -> Rect2:
	# positions are walked up by hand: headless, a child's cached global
	# transform can lag a parent that moved since the last frame
	var r := Rect2(_screen_pos(n), n.size)
	if n is Button:
		return r                          # a button's background covers whatever is under it
	var tw: float = UI_v.text_width(n, n.text)
	# the text's own height, centred in the box: a descender past the box's
	# edge is drawn there whether the box ends or not
	var f: Font = n.get_theme_font("font")
	var th: float = f.get_height(n.get_theme_font_size("font_size"))
	var x := r.position.x
	var align: int = HORIZONTAL_ALIGNMENT_CENTER if n is Button else n.horizontal_alignment
	if align == HORIZONTAL_ALIGNMENT_RIGHT:
		x = r.position.x + r.size.x - tw
	elif align == HORIZONTAL_ALIGNMENT_CENTER:
		x = r.position.x + (r.size.x - tw) / 2.0
	return Rect2(x, r.position.y + (r.size.y - th) / 2.0, tw, th)


## The checks for one set of nodes. `pairs` are [label, value] that share a
## line: their widths are added. Returns how many failed.
func _check_nodes(nodes: Array, pairs: Array, where: String) -> int:
	var UI_v = load("res://scripts/ui/ui.gd")
	var bad := 0
	for pair in pairs:
		if pair[0].text == "" or pair[1].text == "":
			continue
		var w: float = UI_v.text_width(pair[0], pair[0].text) + 16 + UI_v.text_width(pair[1], pair[1].text)
		if w > maxf(pair[0].size.x, pair[1].size.x) + 0.5:
			push_error("%s: line '%s' + '%s' needs %.0f px, has %.0f" % [where, pair[0].text, pair[1].text, w, maxf(pair[0].size.x, pair[1].size.x)])
			bad += 1
	var live := []
	for n in nodes:
		if not (n is Control) or n.text == "" or not _showing(n):
			continue
		live.append(n)
		if n.text.contains("£"):
			push_error("%s: '%s' shows pounds; everything is paid in tins (13 Oct)" % [where, n.text])
			bad += 1
		# a code name in the words (19 Oct: a rename caught "3 n_ready" in the Fence's band)
		if _code_word.search(n.text) != null:
			push_error("%s: '%s' shows a code name" % [where, n.text])
			bad += 1
		# "the Yard" is back as the Pitch's tree of works (18 Oct, Matt's call 3); the Pitch stays the place
		var room := 32.0 if n is Button else 0.0
		var w: float = UI_v.text_width(n, n.text) + room
		if w > n.size.x + 0.5:
			push_error("%s: '%s' needs %.0f px, has %.0f" % [where, n.text, w, n.size.x])
			bad += 1
		var parent = n.get_parent()
		if parent is Control:
			var row := _text_rect(n, UI_v)
			var pr := Rect2(_screen_pos(parent), parent.size)
			if row.position.y < pr.position.y - 4.0 or row.end.y > pr.end.y + 4.0:
				push_error("%s: '%s' runs out of its box top to bottom" % [where, n.text])
				bad += 1
	# no text on top of any other text: the rect each label's text occupies,
	# from its alignment, not its box - a headline and its unit share a box
	for i in range(live.size()):
		for j in range(i + 1, live.size()):
			var a = live[i]
			var b = live[j]
			if a.is_ancestor_of(b) or b.is_ancestor_of(a):
				continue
			var x: Rect2 = _text_rect(a, UI_v).intersection(_text_rect(b, UI_v))
			# a font's height carries a few px of line spacing past the glyphs
			if x.size.x > 2.0 and x.size.y > 6.0:
				push_error("%s: '%s' sits on '%s' (%.0f × %.0f px)" % [where, a.text, b.text, x.size.x, x.size.y])
				bad += 1
	return bad


func _hours(s: float) -> String:
	return "%.1f h" % (s / 3600.0)


## The Yard as option A: Elements and Finds cards with the figures nowhere else
## showed; the works on one card; the Runs cards say what a site fires and what
## you resist; the Radio's cards carry the words as chips and the odds.
## 27: quantity is how much, not how good; it reaches searches; the dog adds quality.
func _loot_roll_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	# quantity reaches searches: +100% quantity doubles what a search brings, carried as a fraction
	var hold_pack = sim.equipped["Backpack"]
	var heavy: Dictionary = sim._plain("Backpack", Data.BASES["Backpack"][0]["name"])
	heavy["affixes"] = [{"stat": "loot_pct", "value": 100, "tier": 5}]
	sim.equipped["Backpack"] = heavy
	var hold_tree: Array = sim.tree.duplicate()
	sim.tree = sim.tree.filter(func(id): return not str(id).begins_with("The Rat Man/"))     # no Rat's share eating the bonus
	var q: float = sim.loot_bonus()
	_check(q >= 1.0, "a +100%% quantity pack reads %.2f" % q)
	sim.deploy(3)
	var m: Dictionary = sim.mission
	m["remaining"] = 0
	m["cleared"] = true
	m["patrol_timer"] = -1e9              # no gang
	var found0: int = int(m.get("finds", 0))
	var searches0: int = m["searches"]
	for k in range(400):
		sim.advance(1.0)
		if not sim.on_mission() or m["searches"] - searches0 >= 3:
			break                        # three searches, however slow this runner's are (Never there doubles them)
	if sim.on_mission():
		var per_search: float = float(int(m.get("finds", 0)) - found0) / maxf(1.0, float(m["searches"] - searches0))
		var base_finds: int = 1 + (1 if sim.has_node("scavenger") or sim.has_node("quiet_hands") else 0) + (1 if sim.yard_has("a_dog") else 0) + (2 if sim.yard_has("pack") else 0) + (1 if sim.has_rule("postman") else 0)
		_check(m["searches"] - searches0 >= 2 and per_search >= float(base_finds) + floorf(q) - 0.6, "with +%.0f%% quantity a search brings %.2f, base %d" % [q * 100.0, per_search, base_finds])
		sim.extract_now()
	# the dog adds quality
	var hold_k: Array = sim.yard_picks.get("kennel", []).duplicate()
	_yard_ids(sim, ["a_dog", "good_nose"], "")
	var r0: float = sim.rarity_bonus()
	_yard_ids(sim, ["a_dog", "good_nose"], "good_nose")
	_check(is_equal_approx(sim.rarity_bonus(), r0 + 0.05), "a good nose did not add 5%% quality: %.3f then %.3f" % [r0, sim.rarity_bonus()])
	sim.yard_picks["kennel"] = hold_k
	sim._yard_changed("kennel")
	# quantity is out of the rarity roll: Rat's share no longer moves the quality figure the roll reads
	var rat := "The Rat Man/9"
	var rar_before: float = sim.rarity_bonus()
	if not sim.tree.has(rat):
		sim.tree.append(rat)
	_check(is_equal_approx(sim.rarity_bonus(), rar_before) and sim.loot_bonus() < q, "Rat's share moved quality (%.3f → %.3f) or not quantity" % [rar_before, sim.rarity_bonus()])
	# a rarity node a class: the Doorman's and the Paramedic's trees carry one now
	for t in ["Muscle", "Triage"]:
		_check(Data.tree_named(t)["nodes"].any(func(n): return n.get("effect", "") == "rarity"), "%s has no loot quality node" % t)
	_check(Data.AFFIXES.any(func(a): return a["stat"] == "rarity_pct" and "Backpack" in a["slots"]), "no loot quality affix rolls on a backpack")
	sim.equipped["Backpack"] = hold_pack
	sim.tree = hold_tree
	sim.load_dict(saved)
	main.refresh()
	print("the loot roll ok: quantity reaches searches, the dog adds quality, quantity is out of the rarity roll")
	_crates_checks(main)
