## The Map's paint and the odds (19 Oct, Matt: the Map lagged after Glasses): a paint works the odds' key once, a
## button asked for the look it has is left alone, and Glasses' sixty runs show their number at twenty-four.
func _odds_paint_checks(main) -> void:
	var sim = main.sim
	main.show_room(main.MISSIONS)
	main._missions._shown = ""
	sim.prof["key_common"] = 0
	main.refresh()
	_check(int(sim.prof["key_common"]) <= 2, "a paint of the Map worked the odds' key %d times (once, in its scope)" % int(sim.prof["key_common"]))
	_check(sim._scope == 0, "the paint left its odds scope open")
	# a button's look, once
	var b := Button.new()
	main.add_child(b)
	UI.style_button(b, false, "good")
	var sb = b.get_theme_stylebox("normal")
	UI.style_button(b, false, "good")
	_check(b.get_theme_stylebox("normal") == sb, "the same look asked again restyled the button")
	UI.style_button(b, true)
	_check(b.get_theme_stylebox("normal") != sb, "a new look didn't restyle the button")
	var other := StyleBoxFlat.new()
	b.add_theme_stylebox_override("normal", other)
	UI.style_button(b, true)
	_check(b.get_theme_stylebox("normal") != other, "a button restyled by hand kept the hand's look when asked for its old one")
	b.queue_free()
	# Glasses: the number at twenty-four, the rest read behind it
	var s = Sim.new()
	s.start()
	s.mythics_on = false
	_open_camp(s)
	s.yard_picks["lookout"] = ["b", "", "", "", ""]
	s._yard_dirty = true
	if s.yard_has("glasses"):
		s.odds_budget = 1
		var i := 0
		for k in range(Data.ODDS_RUNS):
			s.survival(i)
		var c: Array = s._surv_cache.get(i, [])
		var bailed: bool = not c.is_empty() and int(c[2]) >= s.odds_runs()     # an early settle (all alive or all dead) reads whole
		_check(s.odds_ready(i), "Glasses: the odds didn't show at %d runs" % Data.ODDS_RUNS)
		_check(bailed or not s.odds_settled(i), "Glasses: the odds read whole at %d of %d" % [Data.ODDS_RUNS, s.odds_runs()])
	else:
		_check(false, "the fixture: no Glasses from the Lookout's first pick")
	print("the odds' paint ok: the key once a paint, a button's look once, Glasses' number at %d runs" % Data.ODDS_RUNS)


## The campaign's pace (19 Oct, Matt): gear to wear at 2 x the site's level - 2, and each site first opens at that
## less one, so a runner arrives at its drops' level, a level under at worst; a cleared site stays open to a new runner.
func _site_gate_checks(main) -> void:
	var want := {1: 1, 2: 2, 3: 4, 4: 6, 5: 8, 6: 10, 7: 12, 8: 14, 9: 16}
	for lv in want:
		_check(Sim.wear_of(lv) == int(want[lv]), "items of level %d wear at %d, not %d" % [lv, Sim.wear_of(lv), int(want[lv])])
	var s = Sim.new()
	s.start()
	s.mythics_on = false
	var parade := 4
	var retail := 5
	_check(Data.TIERS[parade]["name"] == "The Parade" and Data.TIERS[retail]["name"] == "The Retail Park", "the fixture: the Parade and the Retail Park moved")
	for i in range(Data.OUTSKIRTS_SITES + 1):
		s.best_depth[i] = 1
	s.bosses_beaten[0] = true
	s.xp = 0.0
	_check(s.site_gate(retail) == Sim.wear_of(Sim.lv_at(retail, 1)) - 1 and s.site_gate(retail) > 1, "the Retail Park's gate reads %d" % s.site_gate(retail))
	s.best_depth[parade] = 1
	_check(not s.tier_open(retail) and s.level_gated(retail), "the Retail Park opened to a level-1 runner")
	s.xp = Data.xp_for_level(s.site_gate(retail))
	_check(s.tier_open(retail), "the Retail Park stayed shut at its gate's level %d" % s.site_gate(retail))
	s.best_depth[retail] = 1
	s.xp = 0.0
	_check(s.tier_open(retail), "a cleared site shut on a new runner")
	# every campaign site's gate: its drops' level less one
	for i in range(Data.TIERS.size()):
		_check(s.site_gate(i) == maxi(1, Sim.wear_of(Sim.lv_at(i, 1)) - 1), "%s opens at %d" % [Data.TIERS[i]["name"], s.site_gate(i)])
	# the Map says so
	var keep = main.sim
	s.best_depth[retail] = 0
	main.sim = s
	main.show_room(main.MISSIONS)
	main._missions.select(retail)
	main.refresh()
	var said := " | ".join(_texts(main._missions))
	_check(said.contains("Opens at level %d" % s.site_gate(retail)), "the Map doesn't say the Retail Park opens at level %d: %s" % [s.site_gate(retail), said.left(300)])
	_check_fit(main, "the Map (a site shut for the level)")
	# a zone shut till its first site's level (19 Oct, Matt: "keep a zone locked until the level cap is hit and note it
	# on the zone of the map"): the Estate done, the Town at its gate
	for i in Data.ZONES[1]["tiers"]:
		s.best_depth[i] = 1
	s.bosses_beaten[1] = true
	var tg: int = s.zone_gate(2)
	s.xp = Data.xp_for_level(tg - 1)
	s.cls = "Scrapper"
	s.runs_total = maxi(1, s.runs_total)
	_check(tg > 1 and not s.zone_open(2) and s.zone_level_shut(2) and Data.ZONES[2]["tiers"].all(func(i): return not s.tier_open(i)), "the Town opened under its level %d" % tg)
	_check(s.next_words() == Words.NEXT["level"] % tg, "what's next doesn't say the Town's level: '%s'" % s.next_words())
	main.sim = s
	main._missions._map._shown = ""
	main.refresh()
	var town_st: String = main._missions._map._zone_names[2][1].text
	_check(town_st.to_lower().contains("level %d" % tg), "the Map's Town doesn't say level %d: '%s'" % [tg, town_st])
	_check_fit(main, "the Map (a zone shut for the level)")
	s.xp = Data.xp_for_level(tg)
	_check(s.zone_open(2) and s.tier_open(int(Data.ZONES[2]["tiers"][0])), "the Town stayed shut at level %d" % tg)
	s.best_depth[int(Data.ZONES[2]["tiers"][0])] = 1
	s.xp = 0.0
	_check(s.zone_open(2), "a zone with a site cleared shut on a new runner")
	main.sim = keep
	main._missions._shown = ""
	main.refresh()
	print("the campaign's pace ok: wear at 2 x - 2, each site open at its drops' level less one, the Map says so")


## The gates for how play feels (19 Oct): one reader for the bot's chronicle and the player's record, judged alike.
func _feel_gate_checks() -> void:
	var Feel = load("res://tools/feel_gates.gd")
	var ch: Array = [
		{"k": "clear", "first": true, "site": "The Parade", "site_level": 2, "depth": 1, "lv": 2},
		{"k": "clear", "first": true, "site": "The Barracks", "site_level": 9, "depth": 1, "lv": 12},
		{"k": "run", "cash": 1000, "gear": 4, "gear_wearable": 1, "outcome": "Back"},
		{"k": "open", "room": "clinic"},
		{"k": "run", "cash": 1000, "gear": 0, "gear_wearable": 0, "wounded": true, "outcome": "Back"},
		{"k": "run", "cash": 1000, "gear": 4, "gear_wearable": 1, "outcome": "Back", "away": true},
		{"k": "contract", "pay": "cash", "amount": 5000},
		{"k": "contract", "pay": "notes", "amount": 99},
	]
	var f: Dictionary = Feel.read(ch)
	_check(f["runs"] == 2 and f["wound_runs"] == 1 and f["gear"] == 4 and f["wearable"] == 1 and f["wounded"] == 1, "the feel read is off: %s" % str(f))
	var bot_f: Dictionary = Feel.read(ch, true)
	_check(bot_f["runs"] == 3 and bot_f["gear"] == 8, "the bot's away hours weren't counted: %s" % str(bot_f))
	var rows: Array = Feel.rows(f)
	var by := {}
	for r in rows:
		by[r[0]] = r[3]
	_check(by.get("Level on entry") == false and by.get("Gear to wear") == false and not by.has("Contracts against runs") and by.get("Deaths") == null, "the feel gates judged it wrong: %s" % str(by))
	var empty: Array = Feel.rows(Feel.read([]))
	_check(empty.all(func(r): return r[3] == null), "an empty record was judged: %s" % str(empty.map(func(r): return r[3])))
	print("the feel gates ok: one reader, the entries, the wearable share, wounds, deaths")


## The drawn Map (19 Oct, Matt's pick B): a pin picked shows its card; a shut zone's pins take no click and carry no
## names; with every zone and every order's place open, no two names on the map cross, and all of them sit inside it.
func _map_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var M = main._missions
	var mv = M._map
	main.show_room(main.MISSIONS)
	# a fresh camp: the Outskirts open, the rest shut
	var s = Sim.new()
	s.start()
	s.mythics_on = false
	main.sim = s
	main.refresh()
	var click := func(at: Vector2) -> void:
		var ev := InputEventMouseButton.new()
		ev.button_index = MOUSE_BUTTON_LEFT
		ev.pressed = true
		ev.position = at
		mv._gui_input(ev)
	click.call(mv.pin_at(1))
	main.refresh()
	_check(M.selected == 1 and M._cols[0]["card"].title.text == str(Data.TIERS[1]["name"]), "a pin picked didn't show its card: selected %d, the card '%s'" % [M.selected, M._cols[0]["card"].title.text])
	click.call(mv.pin_at(10))
	main.refresh()
	_check(M.selected == 1, "a shut zone's pin took the click")
	# a zone not yet known (20 Oct, Matt): its name and its sites' scrambled like the radio's traffic, no "Locked"
	_check(mv._pin_labels[10].text == Fmt.scramble(str(Data.TIERS[10]["name"])) and mv._pin_labels[1].text == str(Data.TIERS[1]["name"]), "a shut zone's pins read '%s', an open one's '%s'" % [mv._pin_labels[10].text, mv._pin_labels[1].text])
	_check(mv._zone_names[1][0].text == Fmt.scramble(str(Data.ZONES[1]["name"])) and not mv._zone_names[1][1].text.contains("Locked") and mv._zone_names[1][1].text != "", "a shut zone reads '%s' / '%s'" % [mv._zone_names[1][0].text, mv._zone_names[1][1].text])
	for zl in mv._zone_names:
		_check(not zl[1].text.contains("Locked"), "a zone still says Locked: '%s'" % zl[1].text)
	_check_fit(main, "the Map (a fresh camp)")
	# the scrambled names cross nothing, on the map and inside it (the review: the glyphs run wider)
	var fboxes: Array = []
	for l in mv.land_nodes():     # every name on the land, panned off the view or not (BUILD51-U)
		if l.visible and l.text != "":
			var fw: float = UI.text_width(l, l.text)
			var fx: float = l.position.x + ((l.size.x - fw) / 2.0 if l.horizontal_alignment == HORIZONTAL_ALIGNMENT_CENTER else (l.size.x - fw if l.horizontal_alignment == HORIZONTAL_ALIGNMENT_RIGHT else 0.0))
			fboxes.append([l.text, Rect2(fx, l.position.y, fw, l.size.y)])
	var fcross: Array = []
	for a2 in range(fboxes.size()):
		if not Rect2(Vector2.ZERO, mv.size).encloses(fboxes[a2][1]):
			fcross.append(fboxes[a2][0] + " (off the map)")
		for b2 in range(a2 + 1, fboxes.size()):
			if fboxes[a2][1].grow(-1.0).intersects(fboxes[b2][1].grow(-1.0)):
				fcross.append("%s / %s" % [fboxes[a2][0], fboxes[b2][0]])
	_check(fcross.is_empty(), "a fresh camp's names cross on the Map: %s" % ", ".join(fcross))
	# nothing else names what isn't known: what's next, the shelf's gaps, the Yard's columns
	var shut_names: Array = []
	for z in range(1, Data.ZONES.size()):
		shut_names.append(str(Data.ZONES[z]["name"]))
		for t in Data.ZONES[z]["tiers"]:
			shut_names.append(str(Data.TIERS[int(t)]["name"]))
	var said_fresh: Array = [s.next_words(), s.next_words(true)]
	for c in s.shelf_chase():
		if not c["found"] and not c["known"]:
			continue
		said_fresh.append(str(c["where"]))
	for col in range(Data.YARD_COLS):
		said_fresh.append(Data.yard_gate(col))
	var named: Array = []
	for t in said_fresh:
		for nm in shut_names:
			if str(t).contains(nm) and not (nm == "The Town" and str(t) == Data.yard_gate(1)):
				named.append("%s in '%s'" % [nm, t])
	_check(named.is_empty(), "a fresh camp is told what it hasn't found: %s" % ", ".join(named.slice(0, 4)))
	# a pin's name is the name only, sitting on its own pin (19 Oct, Matt); the key small and packed
	for i in range(Data.TIERS.size()):
		var pl: Label = mv._pin_labels[i]
		if not pl.visible:
			continue
		var want_nm: String = str(Data.TIERS[i]["name"]) if mv.sim.zone_open(int(Data.TIERS[i]["zone"])) else Fmt.scramble(str(Data.TIERS[i]["name"]))
		_check(pl.text == want_nm, "a pin's name carries more than the name: '%s'" % pl.text)
		var side: int = int(mv.SITE_LABEL[i])
		if side == mv.BELOW or side == mv.ABOVE:
			var cx: float = pl.position.x + pl.size.x / 2.0
			var room_l: bool = pl.position.x <= 4.5 or pl.position.x + pl.size.x >= mv.size.x - 4.5
			_check(absf(cx - mv.pin_at(i).x) < 2.0 or (room_l and Rect2(pl.position, pl.size).grow_individual(0, 0, 0, 0).has_point(Vector2(mv.pin_at(i).x, pl.position.y + 1)) or (room_l and absf(pl.position.x - 4.0) < 0.5)), "%s's name sits off its pin: %.0f against %.0f" % [Data.TIERS[i]["name"], cx, mv.pin_at(i).x])
	# the cloud over all but the open zones (19 Oct, Matt): under every word, its mask white on an open zone's pin,
	# black on a shut one's and on the land between
	if mv._clouds != null:
		_check(mv._clouds.get_index() < mv._zone_names[0][0].get_index() and mv._clouds.mouse_filter == Control.MOUSE_FILTER_IGNORE and mv._clouds.size == mv.size, "the cloud sits over the words or takes the clicks")
		var base: Vector2 = mv.size / mv.land_k()     # the mask's cut at today's map's size, read by UV (BUILD51-U)
		var mk: Image = mv.cloud_mask("1000", base)
		var ps: Vector2 = mv.paint_size()             # points in the painting's pixels (BUILD52: the redrawn Map, its places from data)
		var at_px := func(p: Vector2) -> float:
			return mk.get_pixel(int(p.x * base.x / ps.x / mv.MASK_DIV), int(p.y * base.y / ps.y / mv.MASK_DIV)).r
		var river := Vector2(520, 200)                  # between the Town and the City: no zone's (BUILD52; the moor's before)
		_check(at_px.call(mv.pin_at(0) / mv.PX) > 0.5 and at_px.call(mv.pin_at(10) / mv.PX) < 0.5 and at_px.call(river) < 0.5, "the cloud's mask is off: the Allotments %.1f, the Hospital %.1f, the river %.1f" % [at_px.call(mv.pin_at(0) / mv.PX), at_px.call(mv.pin_at(10) / mv.PX), at_px.call(river)])
		# with the City open too, nothing's left clouded: the moor and the motorway strip clear with it (20 Oct, Matt)
		var mk3: Image = mv.cloud_mask("1110", base)
		var all_open: Image = mv.cloud_mask("1111", base)
		var lit := 0
		for yy in range(all_open.get_height()):
			for xx in range(all_open.get_width()):
				lit += 1 if all_open.get_pixel(xx, yy).r > 0.5 else 0
		var mk3_at := func(p: Vector2) -> float:
			return mk3.get_pixel(int(p.x * base.x / ps.x / mv.MASK_DIV), int(p.y * base.y / ps.y / mv.MASK_DIV)).r
		_check(lit == all_open.get_width() * all_open.get_height() and mk3_at.call(river) < 0.5,
			"with every zone open %d of %d cells clear; the river before the City %.1f" % [lit, all_open.get_width() * all_open.get_height(), mk3_at.call(river)])
