	_check(sim.night_next() and sim.night_link() == 2, "a loaded night's next link didn't set off")
	sim.mission["night_home"] = true
	sim.extract_now()
	sim.night_rules = []
	sim.night_floor = Data.NIGHT_FLOOR
	print("n50 save ok")


