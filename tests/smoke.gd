			g10 += 1
		var d10 = JSON.parse_string(JSON.stringify(sim.to_dict()))
		var t10 = Sim.new()
		t10.load_dict(d10)
		var refill_on: bool = t10.on_mission() and t10.refill_now("Primary") > 0.0
		var gk := 0
		while t10.on_mission() and t10.refill_now("Primary") > 0.0 and gk < 60:
