	for k in range(int(Data.ORDER_PRINT_EVERY / 0.5) + 1):
		sim._order_tick(m, m["t"], 0.5, "treasurer")
	_check(float(m.get("shield", 0.0)) > 0.0 and int(m.get("printed", 0)) >= 1, "the Treasurer: shield %.0f, printed %d" % [float(m.get("shield", 0.0)), int(m.get("printed", 0))])
	if sim.on_mission():
		sim.extract_now()
	# the remix: nothing before the Treasurer (tools3)
	_check(not sim.county_done(), "the County done before the Treasurer")
	for k in range(20):
		var sg0 := {"id": 0, "site": 4, "zone": 1, "depth": 1, "head": true}
		sim._remix(sg0, 0)
		_check(not sg0.has("county") and not sg0.has("county_head"), "the remix laid a signal on the County before the Treasurer")
	var ser_r: int = sim.issued_serial
	sim._remix_issued(sim.reach + 5)
	_check(sim.issued_serial == ser_r, "the remix brought issued kit before the Treasurer")
	# the remix: the Treasurer down, signals on the County's places, its heads away from home
	sim.order_beaten["treasury"] = 1
	_check(sim.county_done(), "the Treasurer down and the County not done")
	var on_county := false
	var away := false
	for k in range(60):
		var sg := {"id": 0, "site": 4, "zone": 1, "depth": 1, "head": true}
		sim._remix(sg, 0)
		if sg.has("county"):
			on_county = true
			_check(sim.signal_place(sg) == str(Data.county(str(sg["county"]))["place"]) and int(sg["site"]) == int(Data.county(str(sg["county"]))["site"]), "a remixed signal's place: %s" % sim.signal_place(sg))
		if sg.has("county_head"):
			away = true
	_check(on_county and away, "sixty remixed signals: on the County %s, a head away %s" % [on_county, away])
	# a remixed signal on a County place sets off and names its zone (the review: its "Out to" line read a key it hasn't)
	for k in range(60):
		var sg2 := {"id": 900 + k, "site": 4, "zone": 1, "depth": 1, "codes": [], "papers": [], "head": false, "convoy": false, "line": 0, "grade": 0}
		sim._remix(sg2, 0)
		if sg2.has("county") and not sg2.has("county_head"):
			if sim.on_mission():
				sim.extract_now()
			sim.hp = sim.max_hp()
			var sig_hold: Array = sim.signals.duplicate(true)
			sim.signals = [sg2]
			_check(sim.deploy_signal(0) and sim.on_mission(), "a remixed County signal would not set off")
			var outs2: Array = sim.events.filter(func(line): return str(line[1]).begins_with("Out to"))
			var zone_of: String = str(Data.COUNTY_ZONES[int(Data.county(str(sg2["county"]))["cz"])]["name"]).trim_prefix("The ")
			_check(not outs2.is_empty() and str(outs2.back()[1]).contains(zone_of), "a remixed County signal's log: '%s'" % (str(outs2.back()[1]) if not outs2.is_empty() else ""))
			if sim.on_mission():
				sim.extract_now()
			sim.signals = sig_hold
			break
	# a burn at the price cap still burns (the review: both multipliers read ×4 there)
	var circ_cap_hold: float = sim.circulation
	var cash_cap_hold: float = sim.cash
	var was_issued: bool = sim.issued
	sim.issued = true
	sim.circulation = Data.FIAT_CIRC_SPAN * (Data.FIAT_CIRC_CAP - 1.0) * 3.0
	sim.cash = 1e12
	_check(sim.burn_moves() and sim.can_burn(), "no burn at the price cap: circulation %.0f" % sim.circulation)
	sim.issued = was_issued
	sim.circulation = circ_cap_hold
	sim.cash = cash_cap_hold
	main._missions.set_county(false)
	sim.load_dict(hold)
	main.refresh()
	_check(not main._missions._county_btn.visible and not main._missions._county.visible, "the County's button stayed up on a camp before the Issue")
	# the County's own fight art (26 Oct): a run on a place reads its pair once drawn, and its wall hides the duck
	var RV = load("res://scripts/ui/run_view.gd")
	_check(RV.county_gang({"signal": {"order": "truck_stop"}}) == "the_motorway" and RV.county_gang({"signal": {"county": "treasury", "zone": 1}}) == "" and RV.county_gang({}) == "", "the County's crew key: '%s'" % RV.county_gang({"signal": {"order": "truck_stop"}}))
	_check(RV.county_key({"signal": {"order": "truck_stop"}}) == "the_truck_stop" and RV.county_key({"signal": {"county": "manor"}}) == "the_manor" and RV.county_key({}) == "", "the run's County place key: '%s'" % RV.county_key({"signal": {"order": "truck_stop"}}))
	for c in Data.COUNTY:
		var pk: String = RV.site_key(str(c["place"]))
		if RV._pair_in(RV.COUNTY_DIR, pk):
			_check(RV.tex_from(pk + "_plate") == RV.COUNTY_DIR and RV.tex_from(pk + "_cover") == RV.COUNTY_DIR, "%s's pair isn't read from art/fight_county" % c["place"])
			_check(RV.cover_reaches(RV.tex(pk + "_cover")), "%s's wall doesn't reach the frame's foot at the full duck" % c["place"])
	print("the County ok: four zones of three, issued kit wanted, places in turn, the heads' fights, the board, the remix")


## A run picked clean with the next gang after the clock comes home on its own, pack and all (Matt, 26 Oct; the first
## review's 2(a)); with time for a gang, it stays out.
func _picked_clean_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var hold: Dictionary = sim.to_dict()
	for late in [true, false]:
		sim.hp = sim.max_hp()
		sim.deploy(0)
		if sim.mission == null:
			_check(false, "the picked-clean check couldn't deploy")
			break
		var m: Dictionary = sim.mission
		m["remaining"] = 0
		m["cleared"] = true
		m["clock"] = 1e6
		sim.advance(0.1)
		if sim.mission == null or not m.has("crates"):
			_check(false, "the picked-clean check's run has no crates")
			break
		m["crate_i"] = m["crates"].size()
		m["patrol_timer"] = 0.0
		m["clock"] = 0.5 if late else 1e6
		var found_n: int = m["found"].size()
		sim.advance(0.2)
		if late:
			_check(sim.mission == null and sim.events.any(func(line): return str(line).contains("home with the pack")), "a picked-clean run with no gang before time's up didn't come home (pack %d)" % found_n)
		else:
			_check(sim.mission != null and not sim.nothing_left(sim.mission), "a picked-clean run with a gang to come went home early")
			sim.extract_now()
	sim.load_dict(hold)
	main.refresh()
	print("picked clean ok: home on its own when nothing comes before time's up, out when a gang will")


## Esc shuts the overlay on top before it pauses (the first review's 18): the collection, the rules, the Radio's book,
## a build code's plan; with nothing open it pauses.
func _esc_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var esc := InputEventKey.new()
	esc.keycode = KEY_ESCAPE
	esc.pressed = true
	var press_esc := func():
		main._overlay_closed = -1
		main._unhandled_input(esc)
	main.show_room(main.RUNNER)
	main.refresh()
	main._stats.show_collection()
	press_esc.call()
	_check(main._stats.collection_panel == null and not main._menu.visible, "Esc over the collection: still open %s, the pause up %s" % [main._stats.collection_panel != null, main._menu.visible])
	main.show_room(main.ARMOURY)
	main.refresh()
	main._armoury.open_rules()
	press_esc.call()
	_check(not main._armoury.rules_panel.visible and not main._menu.visible, "Esc over the loot rules: still open %s, the pause up %s" % [main._armoury.rules_panel.visible, main._menu.visible])
	main.show_room(main.COMMS)
	main.refresh()
	main._radio.open_book("filter")
	if main._radio.book_kind != "":
		press_esc.call()
		_check(main._radio.book_kind == "" and not main._menu.visible, "Esc over the Radio's book: '%s', the pause up %s" % [main._radio.book_kind, main._menu.visible])
	if main._menu.visible:
		main._menu.close()
	main.show_room(main.BARRACKS)
	main.refresh()
	main._barracks.pending_build = {"plan": true}
	press_esc.call()
	_check(main._barracks.pending_build.is_empty() and not main._menu.visible, "Esc over a build code's plan didn't cancel it, or paused")
	main.show_room(main.MISSIONS)
	main.refresh()
	main._missions._skill_pick.open(sim)
	main._missions._skill_pick.visible = true
	press_esc.call()
	_check(not main._missions._skill_pick.visible and not main._menu.visible, "Esc over the skill picker: still open %s, the pause up %s" % [main._missions._skill_pick.visible, main._menu.visible])
	main._missions._came_open = true
	main._missions._came.visible = true
	press_esc.call()
	_check(not main._missions._came_open and not main._menu.visible, "Esc over the came-back card didn't shut it, or paused")
	# nothing open: Esc pauses, and Esc again closes the pause
	press_esc.call()
	_check(main._menu.visible, "Esc with nothing open didn't pause")
	press_esc.call()
	_check(not main._menu.visible, "Esc didn't close the pause")
	main.show_room(main.MISSIONS)
	main.refresh()
	print("Esc ok: the collection, the rules, the book and a code's plan shut first; then the pause")




## The exploits (Matt, 27 Oct, docs/design/pinnacle_and_exploits.md): each on with its two nodes and its unique, off a
## piece short or with the balance's switch, and what it does.
func _exploit_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var hold: Dictionary = sim.to_dict()
	Sim.exploits_off = false
	for key in Data.EXPLOITS:
		var x: Dictionary = Data.EXPLOITS[key]
		var u: Dictionary = {}
		for uu in Data.UNIQUES:
			if str(uu.get("rule", "")) == str(x["rule"]):
				u = uu
		_check(not u.is_empty(), "%s: no unique has its rule %s" % [key, x["rule"]])
		if u.is_empty():
			continue
		sim.load_dict(hold)
		sim.cls = str(x["class"])
		var ids: Array = x["nodes"].map(func(pth): return Data.node_id_named(str(pth)))
		_check(not ids.has(""), "%s names a node the web hasn't: %s" % [key, str(x["nodes"])])
		for id in ids:
			if not sim.tree.has(id):
				sim.tree.append(id)
		sim.equipped[str(u["slot"])] = Items.roll_unique(u, sim.rng)
		sim._dry_memo.clear()
		_check(sim.exploit_on(key), "%s isn't on with its nodes and %s" % [key, u["name"]])
		var others: Array = Data.EXPLOITS.keys().filter(func(k2): return k2 != key and sim.exploit_on(str(k2)))
		_check(others.is_empty(), "%s turns on another: %s" % [key, str(others)])
		Sim.exploits_off = true
		_check(not sim.exploit_on(key), "%s is on with the balance's switch off" % key)
		Sim.exploits_off = false
		sim._dry_memo.clear()
		sim.tree.erase(ids[0])
		sim._dry_memo.clear()
		_check(not sim.exploit_on(key), "%s is on without %s" % [key, x["nodes"][0]])
		sim.tree.append(ids[0])
		var worn = sim.equipped[str(u["slot"])]
		sim.equipped[str(u["slot"])] = null
		sim._dry_memo.clear()
		_check(not sim.exploit_on(key), "%s is on without %s" % [key, u["name"]])
		sim.equipped[str(u["slot"])] = worn
		sim._dry_memo.clear()
		# what it does
		if x.has("grow") and key != "bad_blood":
			var m := {}
			for k in range(5):
				sim._exploit_grow(m, key)
			_check(is_equal_approx(Sim.exploit_x(m), pow(float(x["grow"]), 5.0)), "%s doesn't run away: x%.2f after five" % [key, Sim.exploit_x(m)])
		if key == "overdrawn":
			_check(is_equal_approx(sim.skill_cooldown("smoke"), Data.EXPLOIT_CD) and sim.skill_cost_mult() == 0.0, "Overdrawn: a skill's cooldown %.2f, its cost x%.2f" % [sim.skill_cooldown("smoke"), sim.skill_cost_mult()])
		if key == "second_opinion":
			sim.hp = sim.max_hp()
			sim.deploy(0)
			if sim.mission != null:
				var med: Dictionary = sim._plain(Data.MEDICAL, "First aid kit")
				sim.rig.append(med)
				for k in range(3):
					sim.mission["using"] = null
					sim.hp = sim.max_hp() * 0.3
					sim.use_med(int(med["id"]))
				_check(sim.rig.has(med), "Second opinion spent its med")
				sim.extract_now()
	sim.load_dict(hold)
	Sim.exploits_off = true
	main.refresh()
	print("the exploits ok: each on with its three pieces, off a piece short or switched off, each running away")

