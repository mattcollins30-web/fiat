## The reviewer on m32c (31 Oct): the shared pool read in the fight's order, the rig card's one list and its mass nouns,
## the room a leaving magazine frees, the secondary's reload taken, the one grouping, the grenades alone.
func _fix32d_checks(main) -> void:
	var sim = main.sim
	sim.gate_box_always = false
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var smg_name: String = _base_of_type("smg")
	sim.equipped["Primary"] = sim._plain("Primary", smg_name)
	sim.equipped["Secondary"] = sim._plain("Secondary", "Machine pistol")
	sim.equipped["Rig"] = sim._plain("Rig", "Chest rig")
	sim.stash = sim.stash.filter(func(x): return not Items.is_ammo(x))
	# 2: the read's split is the fight's - the better grade, made last, still the primary's; the secondary the next
	var plain_m: Dictionary = _mag_full(sim, "SMG magazine", "SMG rounds")
	var good_m: Dictionary = _mag_full(sim, "SMG magazine", "SMG hollow point")
	sim.rig = [plain_m, good_m]
	var read_s: Array = sim._mags_read(sim.equipped["Secondary"], "Secondary")
	sim.set_top_up("leave")
	sim.hp = sim.max_hp()
	sim.deploy(3)
	if sim.on_mission():
		var m: Dictionary = sim.mission
		m["remaining"] = 5
		m["target_hp"] = 1e9
		m["t"]["dps"] = 0.0
		m["clock"] = 1e6
		sim._tick(0.1)
		_check(read_s.size() == 1 and is_same(read_s[0], sim.mag_in("Secondary")) and is_same(good_m, sim.mag_in("Primary")), "the read gives the secondary %s, the fight %s" % [str(read_s.map(func(x): return x["ammo"])), str(sim.mag_in("Secondary").get("ammo", ""))])
		# 8: the primary spent, the secondary reloading into the type's last: the primary takes it, the reload stopped
		good_m["rounds"] = 0
		m["mag_in"].erase("Primary")
		m["mag_in"].erase("Secondary")
		m["reload_t"]["Secondary"] = 5.0
		m["reload_to"]["Secondary"] = int(plain_m["id"])
		sim._tick(0.1)
		_check(is_same(sim.mag_in("Primary"), plain_m) and not m["reload_to"].has("Secondary") and not m["reload_t"].has("Secondary"), "the secondary's reload kept the type's last: the primary's %s, the secondary's reload %s" % [str(sim.mag_in("Primary").get("id", -1)), str(m["reload_to"].get("Secondary", -1))])
		sim.extract_now()
	else:
		_check(false, "the fixture: no run for the shared pool's order")
	sim.set_top_up("fill")
	sim.equipped["Secondary"] = null
	# 5, 6, 10: the rig card's meds one list, mass nouns their own plural; grenades alone their own line
	sim.equipped["Primary"] = sim._plain("Primary", "Pump shotgun")
	var cure: Dictionary = {}
	for b in Data.BASES[Data.MEDICAL]:
		if cure.is_empty() and str(b.get("cure", "")) == "bleed":
			cure = sim._plain(Data.MEDICAL, str(b["name"]))
	sim.rig = [sim._plain(Data.MEDICAL, "Bandage"), sim._plain(Data.MEDICAL, "Painkillers"), sim._plain(Data.MEDICAL, "Painkillers"), sim._plain(Data.MEDICAL, "Burn gel"), sim._plain(Data.MEDICAL, "Burn gel"), cure]
	var lines: Array = sim.rig_card_lines().map(func(l): return str(l[0]))
	_check(lines.has("Meds: a bandage, 2 painkillers, 2 cures for burns and a cure for bleed"), "the rig card's meds: %s" % str(lines))
	var th: Array = sim._things([sim._plain(Data.MEDICAL, "Burn gel"), sim._plain(Data.MEDICAL, "Burn gel"), sim._plain(Data.MEDICAL, "Activated charcoal"), sim._plain(Data.MEDICAL, "Activated charcoal")])
	_check(Words.things_list(th[0], th[1]) == "2 tubes of burn gel and 2 packets of activated charcoal", "a list's mass nouns: '%s'" % Words.things_list(th[0], th[1]))
	sim.rig = [sim._plain(Data.GRENADE, "Nail bomb")]
	lines = sim.rig_card_lines().map(func(l): return str(l[0]))
	_check(lines.has("Grenades: 1") and not lines.any(func(l): return str(l).begins_with("Meds: ")), "no meds and a grenade: %s" % str(lines))
	# 9: one grouping, the screens' and the words'
	_check(Fmt.group(-12345) == "−12,345" and Words.group(1234567) == "1,234,567" and Words.count_of(2500, "round") == "2,500 rounds", "the grouping: '%s' '%s'" % [Fmt.group(-12345), Words.group(1234567)])
	# 7: a magazine fitted from a full pack frees its own cells for the heal that makes its room
	sim.equipped["Rig"] = sim._plain("Rig", "Bum bag")
	sim.rig = []
	while sim.rig_room(1):
		sim.rig.append(sim._plain(Data.MEDICAL, "Bandage"))
	sim.set_top_up("leave")
	sim.stash = sim.stash.filter(func(x): return not Items.is_ammo(x))
	sim.hp = sim.max_hp()
	sim.deploy(3)
	if sim.on_mission():
		var m7: Dictionary = sim.mission
		m7["remaining"] = 5
		m7["target_hp"] = 1e9
		m7["t"]["dps"] = 0.0
		m7["clock"] = 1e6
		var mz: Dictionary = sim._plain(Data.MAGAZINE, "Shotgun magazine")
		var bx: Dictionary = sim._plain(Data.AMMO, "Shells")
		m7["found"] = m7["found"].filter(func(x): return Items.is_deeds(x))
		m7["found"].append_array([bx, mz])
		sim._pack_settle(m7)
		var guard := 0
		while not sim.pack_spot(m7, sim._plain(Data.MEDICAL, "Bandage")).is_empty() and guard < 200:
			var f: Dictionary = sim._plain(Data.MEDICAL, "Bandage")
			sim._pack_put(m7, f, sim.pack_spot(m7, f))
			guard += 1
		_check(sim.pack_spot(m7, sim._plain(Data.MEDICAL, "Bandage")).is_empty(), "the fixture: the pack isn't full")
		# BUILD51-A: no heal leaves the rig while a gang's on you - the magazine goes in the quiet between gangs, then refills
		sim._tick(0.1)
		m7["remaining"] = 0
		sim._gang_arrives(m7)
		m7["remaining"] = 5
		sim._tick(0.1)
		_check(sim.rig.has(mz) and float(m7.get("refill", {}).get("shotgun", {}).get("t", 0.0)) > 0.0, "a magazine from a full pack: in the rig %s, refilling %s" % [str(sim.rig.has(mz)), str(m7.get("refill", {}))])
		sim.extract_now()
	else:
		_check(false, "the fixture: no run for the full pack")
	sim.set_top_up("fill")
	# the reviewer's last three. 1: "Best grades only" reads the stash's best before the fill - a part-spent magazine of
	# slugs keeps its slugs, never mixed, and the stash's shells fill the empty ones and go as the box
	sim.equipped["Primary"] = sim._plain("Primary", "Pump shotgun")
	sim.equipped["Secondary"] = null
	sim.equipped["Rig"] = sim._plain("Rig", "Chest rig")
	var sl3: Dictionary = _mag_full(sim, "Shotgun magazine", "Slugs")
	sl3["rounds"] = 3
	sim.rig = [sl3, sim._plain(Data.MAGAZINE, "Shotgun magazine"), sim._plain(Data.MAGAZINE, "Shotgun magazine")]
	sim.stash = sim.stash.filter(func(x): return not Items.is_ammo(x) and not Items.is_mag(x))
	var sh300: Dictionary = sim._plain(Data.AMMO, "Shells")
	Items.set_stack(sh300, 300)
	sim.stash.append(sh300)
	sim.set_top_up("best")
	sim.hp = sim.max_hp()
	sim.deploy(3)
	if sim.on_mission():
		var fl: Array = sim.rig.filter(func(x): return Items.is_mag(x)).map(func(x): return [str(x.get("ammo", "")), int(x.get("rounds", 0))])
		var bxs: Array = sim.mission["found"].filter(func(x): return x.get("carried", false)).map(func(b): return [str(b["base"]), int(b["rounds"])])
		_check(fl.has(["Slugs", 3]) and fl.filter(func(x): return x == ["Shells", 8]).size() == 2 and bxs.size() == 1 and str(bxs[0][0]) == "Shells", "Best grades only with a part-spent magazine of slugs: the rig %s, the box %s" % [str(fl), str(bxs)])
		sim.extract_now()
	else:
		_check(false, "the fixture: no run for the slugs in the rig")
	sim.set_top_up("fill")
	# 2: the shared pool with a build's element: the primary its element's grade, the secondary the best of the rest
	# without it - the read as the fight
	sim.equipped["Primary"] = sim._plain("Primary", smg_name)
	sim.equipped["Secondary"] = sim._plain("Secondary", "Machine pistol")
	var h1: Dictionary = _mag_full(sim, "SMG magazine", "SMG hollow point")
	var h2: Dictionary = _mag_full(sim, "SMG magazine", "SMG hollow point")
	var bl: Dictionary = _mag_full(sim, "SMG magazine", "Belt links")
	sim.rig = [h1, h2, bl]
	sim.stash = sim.stash.filter(func(x): return not Items.is_ammo(x))
	var force_els := func():
		sim._els_key = hash([sim.tree, sim.cls])     # build_elements's key
		sim._els = ["bleed"]
	force_els.call()
	var rp: Array = sim._mags_read(sim.equipped["Primary"], "Primary")
	var rsd: Array = sim._mags_read(sim.equipped["Secondary"], "Secondary")
	sim.set_top_up("leave")
	sim.hp = sim.max_hp()
	sim.deploy(3)
	if sim.on_mission():
		force_els.call()
		var me: Dictionary = sim.mission
		me["remaining"] = 5
		me["target_hp"] = 1e9
		me["t"]["dps"] = 0.0
		me["clock"] = 1e6
		me.erase("mag_in")
		me.erase("fire_x")
		force_els.call()
		sim._tick(0.1)
		_check(rsd.size() == 1 and is_same(rsd[0], bl) and is_same(sim.mag_in("Secondary"), bl) and str(sim.mag_in("Primary").get("ammo", "")) == "SMG hollow point" and str(rp[0].get("ammo", "")) == "SMG hollow point" and not rp.has(bl), "a bleed build's shared pool: the read's secondary %s, the fight's %s; the read's primary %s, the fight's %s" % [str(rsd.map(func(x): return x["ammo"])), str(sim.mag_in("Secondary").get("ammo", "")), str(rp.map(func(x): return x["ammo"])), str(sim.mag_in("Primary").get("ammo", ""))])
		sim.extract_now()
	else:
		_check(false, "the fixture: no run for the bleed build's pool")
	sim._els_key = -1
	sim.set_top_up("fill")
	sim.equipped["Secondary"] = null
	# 3: one of a mass noun
	var th1: Array = sim._things([sim._plain(Data.MEDICAL, "Burn gel"), sim._plain(Data.MEDICAL, "Activated charcoal")])
	_check(Words.things_list(th1[0], th1[1]) == "a tube of burn gel and a packet of activated charcoal", "one of a mass noun: '%s'" % Words.things_list(th1[0], th1[1]))
	sim.load_dict(saved)
	main.refresh()
	print("fix32d ok: the pool's order, the reload taken, the rig card's list and plurals, the grenades, the grouping, the full pack")


## BUILD37 G (31 Oct, the designer's calls on the game's loose ends): the Mint paying on a clear only, the City's T4
## heavies across their zone, an expedition's average return at about x1.2. (The Manual's third element and the meters'
## share went with the skill web, 3 Nov.)
func _b37g_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	sim.core_gates = false
	# 1 (the Manual's third element) went with the skill web (3 Nov): every element is on the runner's own web
	# 2: the Mint pays on a clear only - a bail and a time-out bring nothing from it
	sim.rebuilt = {"mint": 1}
	sim.hp = sim.max_hp()
	var mint: float = sim.mint_tins()
	_check(mint > 0.0, "the fixture: the Mint pays nothing built")
	var outs := {}
	for how in ["clear", "bail", "time_out"]:
		sim.hp = sim.max_hp()
		sim.deploy(3)
		if not sim.on_mission():
			_check(false, "the fixture: no run for the Mint's %s" % how)
			continue
		var m: Dictionary = sim.mission
		m["cash"] = 0.0
		m["found"] = []
		match how:
			"clear":
				m["cleared"] = true
				m["remaining"] = 0
				m.erase("boss")
				sim.extract_now()
			"bail":
				sim._bail(m)
			"time_out":
				sim._time_out(m)
		outs[how] = float(m["cash"])
	_check(absf(float(outs.get("clear", 0.0)) - mint) <= mint * 0.01 and float(outs.get("bail", 1e9)) < mint * 0.01 and float(outs.get("time_out", 1e9)) < mint * 0.01,
		"the Mint's %.0f: a clear brought %.0f, a bail %.0f, a time-out %.0f" % [mint, float(outs.get("clear", -1.0)), float(outs.get("bail", -1.0)), float(outs.get("time_out", -1.0))])
	sim.load_dict(saved)
	# 3: the City's T4 heavies: at their own site at no less than their own-share draw (b37's rate: the fix round, the
	# designer's call - keep the home rate, add the zone), at every other City site, never off the City or the shelf
	var zr := RandomNumberGenerator.new()
	zr.seed = 37
	var city: Array = Data.TIERS.filter(func(t): return int(t["zone"]) == 3)
	var off_site: String = str(Data.TIERS.filter(func(t): return int(t["zone"]) != 3)[0]["name"])
	var zone_kit := {"Stab plates": "The Barracks", "Medic's harness": "The Hospital", "Cargo frame": "The Services"}     # the designer's three (31 Oct), named here so a base dropped from ZONE_KIT goes red
	var b37_rate := {"Stab plates": 0.400, "Medic's harness": 0.441, "Cargo frame": 0.416}     # each at its home in b37 (the game review's probe, 31 Oct): kept, less a noise margin
	var margin := 0.03                       # about 4 sd at 4,000 rolls
	for nm in zone_kit:
		var slot := ""
		for sl in ["Armour", "Rig", "Backpack"]:
			if not Items.base_named(sl, nm).is_empty():
				slot = sl
		var home: String = zone_kit[nm]
		var counts := {}
		var n_roll := 4000
		for t in city:
			var n := 0
			for k in range(n_roll):
				if str(Items.roll(slot, 4, zr, 0.0, false, false, str(t["name"]), str(t["drops"].get("type", "")))["base"]) == nm:
					n += 1
			counts[t["name"]] = n
		var stray := 0
		for k in range(2000):
			for st in [off_site, ""]:
				if str(Items.roll(slot, 4, zr, 0.0, false, false, st)["base"]) == nm:
					stray += 1
		var away: Array = city.filter(func(t): return t["name"] != home).map(func(t): return int(counts[t["name"]]))
		var lo: int = away.min() if not away.is_empty() else 0
		var home_rate: float = float(counts.get(home, 0)) / n_roll
		_check(city.size() >= 3 and Items.exclusive_to(nm) == home and home_rate >= float(b37_rate[nm]) - margin and lo > 0 and stray == 0,
			"%s across the City: %s (home %s at %.1f%%, b37's %.1f%% less %.0f), %d off it" % [nm, str(counts), home, 100.0 * home_rate, 100.0 * float(b37_rate[nm]), 100.0 * margin, stray])
	# 4: an average expedition (the designer's call, 31 Oct): at the bot's risk, with the hands the bot sends (a pool of six
	# rolled as the game rolls it, the best two by rarity and tier), its bad rolls and hold-ups (ransomed) in, about x1.2
	# its cargo's shipped worth home before wages, at every far place - through the game's own roll, home and ransom
	sim.cash = 1e12
	var rng_state: int = sim.rng.state
	sim.rng.seed = 37                         # one fixed draw: the band is the rule, not the dice (put back after)
	var avg_worth := 20000.0
	var per_place := 100
	var tot_in := 0.0
	var tot_out := 0.0
	var held_n := 0
	var bad_n := 0
	var by_place: Array = []
	var crew: Array = []
	for p in range(Data.EXP_PLACES.size()):
		var p_in := 0.0
		for k in range(per_place):
			if k % 10 == 0:
				for h in crew:
					sim.hands.erase(h)
				var pool: Array = []
				for j in range(6):
					pool.append(sim._roll_hand(false))
				pool.sort_custom(func(x, y): return int(x["rarity"]) * 10 + int(x["tier"]) > int(y["rarity"]) * 10 + int(y["tier"]))     # the bot's pick (bot.gd _exp_send)
				crew = pool.slice(0, 2)
				sim.hands.append_array(crew)
			var hs: Array = crew.map(func(h): return int(h["id"]))
			var ex := {"id": 990000 + p * 1000 + k, "place": p, "lead": "", "hands": hs, "cargo": [], "worth": avg_worth, "odds": 1.0, "risk": Bot.EXP_RISK_AT,
				"hold": sim.exp_hold_chance(p, hs, Bot.EXP_RISK_AT), "quota": false, "t0": 0.0, "dur": 1.0, "slot": "Primary", "state": "out",
				"res": {}, "seen": false, "wages": 0, "lead_lv": 1, "xp_run": 0.0, "quota_worth": 0.0}
			sim.expeditions.append(ex)
			sim._exp_resolve(ex)
			bad_n += 1 if bool(ex["res"].get("bad", false)) else 0
			var paid := 0.0
			if str(ex["state"]) == "held":
				held_n += 1
				var c0: float = sim.cash
				sim.exp_pay(int(ex["id"]))
				paid = c0 - sim.cash
			p_in += float(ex["res"].get("total", 0.0)) - paid
			sim.expeditions.erase(ex)
		tot_in += p_in
		tot_out += per_place * avg_worth
		by_place.append("%s x%.2f" % [str(Data.EXP_PLACES[p]["short"]), p_in / (per_place * avg_worth)])
	sim.rng.state = rng_state
	var avg_r: float = tot_in / tot_out
	_check(avg_r >= 1.1 and avg_r <= 1.3 and bad_n > 0 and held_n > 0, "an average expedition with the bot's hands brings x%.2f home (%d bad rolls, %d held of %d; %s), not about x1.2" % [avg_r, bad_n, held_n, per_place * Data.EXP_PLACES.size(), ", ".join(by_place)])
	print("expeditions: the average x%.2f with the bot's hands (%d bad, %d held; %s)" % [avg_r, bad_n, held_n, ", ".join(by_place)])
	sim.load_dict(saved)
	# 5 (the meters' share) went with the skill web (3 Nov): no element meters
	main.refresh()
	print("b37g ok: the Mint on clears, the City's heavies, the expeditions' x1.2")


## FIX37 (31 Oct, the three-stage review of round 37): a hardcore death past the Quartermaster logs no next runner; the
## death card's paragon chip is what the death took. (Its element-lift checks went with the skill web, 3 Nov.)
func _fix37g_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	# (the lift's web, key, panel and bot went with the skill web, 3 Nov: no two-elements cap to lift)
	# a hardcore death past the Quartermaster: no "next runner" line, and none for the paragon past 50
	var qm_zone := -1
	for b in Data.BOSSES:
		if str(b["name"]) == "The Quartermaster":
			qm_zone = int(b["zone"])
	for lv in [30, Data.MAX_LEVEL + 3]:
		sim.bosses_beaten[qm_zone] = true
		sim.hardcore = true
		sim.camp_lost = false
		sim.xp = Data.xp_for_level(lv) + (100.0 if lv < Data.MAX_LEVEL else 0.0)     # some XP towards the next, so a line would be due (BUILD41: none when nothing's lost)
		sim.paragon_xp = Data.xp_for_level(Data.MAX_LEVEL + 3) - Data.xp_for_level(Data.MAX_LEVEL) + 100.0 if lv > Data.MAX_LEVEL else 0.0
		var ev0: int = sim.events_total
		sim.deploy(3)
		sim.mission["hp_start"] = sim.hp
		sim._kia()
		var said_new: Array = _said(sim).slice(-(sim.events_total - ev0)) if sim.events_total > ev0 else []
		var next_line: bool = said_new.any(func(x): return str(x).begins_with("The XP towards"))
		_check(sim.camp_lost and not next_line, "a hardcore death at level %d past the Quartermaster still logs a next runner or the paragon: %s" % [lv, str(said_new)])
		sim.load_dict(saved)
	# the death card past 50 with no paragon: no paragon chip; below 50 with the crew's paragon: "Paragon" kept
	sim.hardcore = false
	sim.bosses_beaten[qm_zone] = true
	sim.xp = Data.xp_for_level(Data.MAX_LEVEL)
	sim.paragon_xp = 0.0
	sim.deploy(3)
	sim.mission["hp_start"] = sim.hp
	sim._kia()
	main.show_room(main.MISSIONS)
	main.refresh()
	var ms = main._missions
	var chips: Array = []
	for k in range(ms._pick_lost.shown()):
		chips.append(ms._pick_lost.words(k))
	_check(ms._pick.visible and not chips.any(func(c): return str(c).to_lower().contains("paragon")) and ms._pick_kicker.text.to_lower().contains("still level %d" % Data.MAX_LEVEL), "a death at 50 with no paragon: '%s', %s" % [ms._pick_kicker.text, str(chips)])
	sim.load_dict(saved)
	main.refresh()
	# the death card at 50 with part of a paragon level: "XP towards paragon 1" (BUILD41), fitted
	sim.hardcore = false
	sim.bosses_beaten[qm_zone] = true
	sim.xp = Data.xp_for_level(Data.MAX_LEVEL)
	sim.paragon_xp = 0.5 * (Data.xp_for_level(Data.MAX_LEVEL + 1) - Data.xp_for_level(Data.MAX_LEVEL))
	sim.deploy(3)
	sim.mission["hp_start"] = sim.hp
	sim._kia()
	main.show_room(main.MISSIONS)
	main.refresh()
	chips = []
	for k in range(ms._pick_lost.shown()):
		chips.append(ms._pick_lost.words(k))
	_check((chips.has("XP towards paragon 1") or chips.has("Paragon XP")) and not chips.has("Paragon levels"), "a death at 50 with part of a paragon level: %s" % str(chips))
	_check_fit(main, "The Map (a death at 50, part of a paragon level)")
	sim.load_dict(saved)
	main.refresh()
	print("fix37g ok: hardcore, the card's paragon")


## PROBE33's levers (31 Oct, the designer's call): the gate's refill box kept at one box (pinned), the slings' damage back, less built-in bleed on the late melee bases, the bot's element weight halved and the rounds' conversion
## counted.
## The twelve one-save reads (tools/balance.bat's list), [class, element].
const B34_BUILDS := [["Drifter", "fire"], ["Drifter", "bleed"], ["Poacher", "poison"], ["Poacher", "frost"], ["Doorman", "bleed"], ["Doorman", "physical"],
	["Scrapper", "shock"], ["Scrapper", "fire"], ["Paramedic", "shock"], ["Paramedic", "frost"], ["Recruit", "physical"], ["Recruit", "poison"]]


## A one-save read's camp at its class's opening (BUILD34 phase 1): from a new game as the Poacher, levelled to `lv` with
## the bot spending its points as the read does (`as_played` for the as-played reads), then every class opened. The bot
## is set up as tests/balance.gd's _gate sets it.
func _b34_camp(cls: String, el: String, lv: int, played := false) -> Array:
	var w = Sim.new()
	w.start()
	if w.cls != "Poacher":
		w.set_class("Poacher")
	var b = Bot.new()
	b.cls = "Poacher"
	b.element = el if cls == "Poacher" else str(Bot.CREW_BUILDS.get("Poacher", ""))
	b.target_cls = cls
	b.target_el = el
	b.as_played = played
	for l in range(2, lv + 1):
		w.xp = Data.xp_for_level(l)
		w.best_level = maxi(w.best_level, l)
		w.training_points = maxi(int(w.training_points), l - 1)
		b._train_tree(w)
	for z in range(w.bosses_beaten.size()):
		w.bosses_beaten[z] = true
	w.story_beat = maxi(int(w.story_beat), 1)        # the Drifter's opening
	return [w, b]


## The Fence's primary (31 Oct, the designer): every restock leaves a primary of the zone's gear tier on the shelf - one
## plain one added when the roll left none; a shelf that rolled one is left as rolled. Fresh camps at three zones, the
## restock repeated till a shelf without one turns up (and one with one).
func _p35_shelf_checks() -> void:
	var added := 0
	var kept := 0
	var off: Array = []
	for z in [1, 3, 5]:
		var w = Sim.new()
		w.start()
		for i in range(Data.TIERS.size()):
			if i <= z * 2:
				w.best_depth[i] = 1
		for k in range(mini(z, w.bosses_beaten.size())):
			w.bosses_beaten[k] = true
		w.xp = Data.xp_for_level(5 + z * 4)
		var t: int = w.best_tier_open()
		var n_was: int = w.market_stock()
		for rep in range(40):
			w._restock_market()                  # the rolled shelf is market[0, n_was); the guarantee's after it
			if not w.market.any(func(it): return str(it["slot"]) == "Primary" and int(it["tier"]) == t):
				off.append("zone %d T%d: no primary of the tier after a restock" % [z, t])
			var rolled_one: bool = w.market.slice(0, n_was).any(func(it): return str(it["slot"]) == "Primary" and int(it["tier"]) == t)
			if rolled_one:
				kept += 1
				if w.market.filter(func(it): return str(it["slot"]) == "Primary" and int(it["tier"]) == t).size() != w.market.slice(0, n_was).filter(func(it): return str(it["slot"]) == "Primary" and int(it["tier"]) == t).size():
					off.append("zone %d: a shelf that rolled a T%d primary got another" % [z, t])
			else:
				added += 1
				var extra: Array = w.market.slice(n_was).filter(func(it): return str(it["slot"]) == "Primary")
				if extra.size() != 1 or int(extra[0]["tier"]) != t or int(extra[0]["rarity"]) != 0 or not extra[0]["affixes"].is_empty() or Items.base_of(extra[0]).get("start", false):
					off.append("zone %d: the added primary isn't one plain T%d: %s" % [z, t, str(extra.map(func(x): return [x["base"], x["tier"], x["rarity"]]))])
	# a deep tier (past the campaign's): an empty shelf gets one plain primary of it, its level the tier's
	var wd = Sim.new()
	wd.start()
	wd.market = []
	wd._shelf_primary(7)
	var deep: Array = wd.market.filter(func(it): return str(it["slot"]) == "Primary")
	_check(deep.size() == 1 and int(deep[0]["tier"]) == 7 and int(deep[0]["ilvl"]) == 7 and int(deep[0]["rarity"]) == 0 and deep[0]["affixes"].is_empty(),
		"the deep shelf's primary: %s" % str(deep.map(func(x): return [x["base"], x["tier"], x.get("ilvl", -1), x["rarity"]])))
	_check(off.is_empty() and added > 0 and kept > 0, "the Fence's primary at the zone's tier: %s (%d shelves topped up, %d rolled their own)" % ["; ".join(off), added, kept])
	print("p35 shelf ok: %d shelves got a plain primary of the zone's tier, %d that rolled one were left as rolled" % [added, kept])


## The physical floor (31 Oct, the designer: the Recruit as played opened physical at 2.47 h and earned no physical point
## in 16 h - the camp's Rat Man conversion, 75%, his own Tear gas, 15%, and a socket or affix past it converted every hit):
## the Recruit with the Rat Man's conversions and Tear gas in, a converting affix on top - a tenth of every hit stays
## physical. (Knuckles' meter went with the skill web, 3 Nov.)
func _p35_floor_checks() -> void:
	var w = Sim.new()
	w.start()
	w.set_class("Recruit")
	w.core_gates = false
	var tear: String = Bot.joint_halves("Recruit", "poison")[0]
	for path in ["The Rat Man/Under the sink", "The Rat Man/Council issue"]:
		_walk(w, Data.node_id_named(path))
	_walk(w, tear)
	var gun: Dictionary = w._plain("Primary", "Stalking rifle")
	gun["affixes"] = [{"stat": "conv_poison_pct", "value": 20, "tier": 3}]
	w.equipped["Primary"] = gun
	w._dry_memo.clear()
	var conv: Dictionary = w.conversion()
	var raw: float = w.tree_sum("conv_poison_pct") + 20.0
	_check(w.cls == "Recruit" and w.tree.has(tear) and raw >= 100.0, "the fixture: the Recruit with Tear gas in, %.0f%% poison before the cap (%s)" % [raw, str(w.tree)])
	_check(float(conv["physical"]) >= 0.1 - 0.0001 and float(conv["poison"]) <= Data.CONV_CAP + 0.0001, "the Recruit's hits kept no physical floor: %s" % str(conv))
	# the bot's gun compare reads the floor as the game does: a physical build's share of a fully converted gun is a tenth
	var kb = Bot.new()
	kb.element = "physical"
	var conv_gun: Dictionary = w._plain("Primary", "Stalking rifle")
	conv_gun["affixes"] = [{"stat": "conv_poison_pct", "value": 120, "tier": 5}]
	_check(is_equal_approx(kb._elem_share(conv_gun, null), 1.0 - Data.CONV_CAP), "the bot's physical share of a fully converted gun reads %.2f, not the floor's %.2f" % [kb._elem_share(conv_gun, null), 1.0 - Data.CONV_CAP])
	kb.element = "poison"
	_check(is_equal_approx(kb._elem_share(conv_gun, null), Data.CONV_CAP), "the bot's poison share of a 120%% poison gun reads %.2f, past the cap %.2f" % [kb._elem_share(conv_gun, null), Data.CONV_CAP])
	print("p35 floor ok: the Recruit keeps %.0f%% physical with %.0f%% poison behind it" % [float(conv["physical"]) * 100.0, raw])


## The melee bleed cut (31 Oct, the designer, after PROBE33: the Doorman went melee on the axes' bleed and stayed): the
## axes 25 to 15 (the Hatchet with them), every melee base at 30-40% to 20, the blade parts halved; no melee base at 30 or over, no part over 8.
func _b34_bleed_checks() -> void:
	var want := {"Primary": {"Fire axe": 15, "Felling axe": 15, "Machete": 20, "Billhook": 20, "Bike chain": 20, "Meat cleaver": 20, "Cavalry sabre": 20},
		"Secondary": {"Knife": 20, "Screwdriver": 20, "Commando dagger": 20, "Hatchet": 15}, Data.ATTACHMENT: {"Nails through it": 8, "A blade on it": 5}}
	var off: Array = []
	for sl in want:
		for nm in want[sl]:
			var b: Dictionary = Items.base_named(str(sl), str(nm))
			if b.is_empty() or int(b.get("conv_bleed_pct", -1)) != int(want[sl][nm]):
				off.append("%s %s" % [nm, str(b.get("conv_bleed_pct", "missing"))])
	for sl in ["Primary", "Secondary"]:
		for b in Data.BASES[sl]:
			if str(b.get("type", "")) == "melee" and int(b.get("conv_bleed_pct", 0)) >= 30:
				off.append("%s %d, 30 or over" % [b["name"], int(b["conv_bleed_pct"])])
	for a in Data.ATTACHMENTS:
		if str(a.get("mount", "")) == "business end" and int(a.get("conv_bleed_pct", 0)) > 8:
			off.append("%s %d over 8" % [a["name"], int(a["conv_bleed_pct"])])
	_check(off.is_empty(), "the melee bleed isn't the designer's cut: %s" % ", ".join(off))
	print("b34 bleed ok: the axes 15, no melee base at 30 or over, the blade parts 8 and 5")


