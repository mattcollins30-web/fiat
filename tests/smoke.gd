	var b0 := {"p": 0.0, "x": {"Poacher": 1000.0, "Doorman": 200.0}, "r": "Poacher"}
	var x1: Dictionary = Bal.xp_split(b0, {"p": 40.0, "x": {"Poacher": 1300.0, "Doorman": 250.0}, "r": "Poacher"}, [{"k": "signal_done", "story": false}, {"k": "run"}], false)
	_check(is_equal_approx(float(x1.get("signals", 0.0)), 340.0) and is_equal_approx(float(x1.get("expeditions", 0.0)), 50.0) and x1.size() == 2, "a signal's step: %s" % str(x1))
	_check(Bal.xp_split(b0, {"p": 0.0, "x": {"Poacher": 1100.0, "Doorman": 200.0}, "r": "Poacher"}, [{"k": "run"}, {"k": "signal_done", "story": true}], false).has("kev"), "Kev's story signal didn't read kev")
	_check(Bal.xp_split(b0, {"p": 0.0, "x": {"Poacher": 1100.0, "Doorman": 200.0}, "r": "Poacher"}, [{"k": "run"}, {"k": "county_done", "key": "c1"}], false).keys() == ["county"], "a County place's step didn't read county")
	_check(Bal.xp_split(b0, {"p": 0.0, "x": {"Poacher": 1100.0, "Doorman": 200.0}, "r": "Poacher"}, [{"k": "run"}, {"k": "order_done", "key": "mint"}], false).keys() == ["mint"], "the Mint's step didn't read mint")
	_check(Bal.xp_split(b0, {"p": 0.0, "x": {"Poacher": 1100.0, "Doorman": 200.0}, "r": "Poacher"}, [{"k": "run"}], true).keys() == ["repeats"], "a repeat's step didn't read repeats")
	_check(Bal.xp_split(b0, {"p": 0.0, "x": {"Poacher": 1100.0, "Doorman": 200.0}, "r": "Poacher"}, [{"k": "run"}], false).keys() == ["sites"], "a site's run didn't read sites")
	var lv5: float = Data.xp_for_level(5)
	var lv20: float = Data.xp_for_level(20)
	var xs: Dictionary = Bal.xp_split({"p": 0.0, "x": {"Poacher": lv20, "Doorman": lv5}, "r": "Poacher"}, {"p": 0.0, "x": {"Poacher": lv20, "Doorman": lv20 + 30.0}, "r": "Doorman"},
		[{"k": "swap", "from": "Poacher", "to": "Doorman", "level": 20}, {"k": "run"}], false)
	_check(is_equal_approx(float(xs.get("lift", 0.0)), lv20 - lv5) and is_equal_approx(float(xs.get("sites", 0.0)), 30.0), "a swap's floor and the run after it: %s" % str(xs))
	var xd: Dictionary = Bal.xp_split(b0, {"p": 0.0, "x": {"Poacher": 0.0, "Doorman": 200.0}, "r": "Poacher"}, [{"k": "run"}], false)
	_check(is_equal_approx(float(xd.get("lost", 0.0)), 1000.0) and not xd.has("sites"), "a death's XP lost: %s" % str(xd))
	# the HOUR row: the window's figures, then a fresh window
	var w = Sim.new()
	w.start()
	w.elapsed = 3.0 * 3600.0
	w.cash_in = 5000.0
	var g := {"deaths": 3}
	var lg := {"xp": {"sites": 120.0, "signals": 30.4}, "cash_from": 1500.0, "deaths_from": 1, "county_n": 0, "county": [[2.5, "c1"]], "issue_at": 2.2}
	var row: Dictionary = Bal.long_row(w, str(w.cls), g, lg, 3.0, false)
	_check(int(row["earned"]) == 3500 and int(row["deaths_h"]) == 2 and int(row["xp"]["sites"]) == 120 and row["county_new"] == ["c1"] and float(row["issue_at"]) == 2.2 and int(row["reach"]) == int(w.reach),
		"the HOUR row: %s" % str(row))
	var row2: Dictionary = Bal.long_row(w, str(w.cls), g, lg, 4.0, false)
	_check(row2["xp"].is_empty() and int(row2["earned"]) == 0 and int(row2["deaths_h"]) == 0 and row2["county_new"].is_empty(), "the next HOUR row didn't start a fresh window: %s" % str(row2))
	# the summary: three long reads from fixture lines
	var mk := func(build: String, el: String, h20_reach: int, h20_par: int, lv50: float, county: Array, with_h20: bool) -> String:
		var ls: Array = []
		for h in range(1, 25):
			ls.append("HOUR " + JSON.stringify({"h": float(h), "at": float(h), "end": false, "level": mini(50, 10 + h * 2), "runner_level": mini(50, 10 + h * 2), "reach": h20_reach - 20 + h,
				"paragon": maxi(0, h20_par - 20 + h), "paragon_free": 0, "cash": 1000.0 * h, "earned": 100.0 * h, "xp": {"sites": 10.0, "signals": 30.0, "lift": 500.0}, "deaths": 0, "deaths_h": 0, "issue_at": 9.5, "county": 0, "county_new": []}))
			if h == 20 and with_h20:
				ls.append("H20 " + JSON.stringify({"at": 20.01, "snap_h": 20.0, "end": false, "save": "res://docs/balance/pass/x-h20.save", "class": build, "level": 50, "reach": h20_reach, "paragon": h20_par}))
		ls.append("HOUR " + JSON.stringify({"h": 24.0, "at": 24.0, "end": true, "level": 50, "runner_level": 50, "reach": h20_reach + 4, "paragon": h20_par + 4, "cash": 1.0, "earned": 0.0, "xp": {}, "deaths": 0, "deaths_h": 0, "issue_at": 9.5, "county": 3}))
		ls.append("GATES " + JSON.stringify({"build": "%s as %s" % [build, el], "class": build, "element": el, "hours": 24.0, "elapsed_h": 24.0, "lv50_at": lv50, "issue_at": 9.5,
			"county_firsts": county, "deaths_after_qm": 2, "long": true}))
		return "\n".join(ls)
	var reads: Array = []
	for f in [["Poacher", "poison", 40, 2, 13.0, [[10.0, "c1"], [23.5, "c2"], [24.5, "c3"]], true], ["Doorman", "bleed", 50, 4, 15.0, [], true], ["Drifter", "fire", 70, 9, 30.0, [], false]]:
		var r: Dictionary = Sum.long_parse(mk.call(f[0], f[1], f[2], f[3], f[4], f[5], f[6]))
		r["name"] = "long-%s-%s" % [f[0], f[1]]
		reads.append(r)
	_check(reads[0]["hours"].size() == 25 and int(reads[0]["h20"].get("reach", 0)) == 40 and reads[2]["h20"].is_empty() and str(reads[0]["gates"].get("build", "")) == "Poacher as poison",
		"the long read's lines parsed: %d HOUR, h20 %s" % [reads[0]["hours"].size(), str(reads[0]["h20"])])
	# the camp: the median of the H20 lines, a read without one at its last row (the Drifter's end: reach 74, paragon 13)
	var camp: Dictionary = Sum.long_camp(reads)
	_check(int(camp.get("n", 0)) == 3 and int(camp["reach"]) == 50 and int(camp["paragon"]) == 4 and int(camp["level"]) == 50, "the camp from the reads: %s" % str(camp))
	var sec: Array = Sum.long_section(reads, [{"build": "Poacher-poison", "won": 15, "of": 15, "level0": 50, "reach0": 55, "gauntlet": []}], [{"build": "Poacher-poison", "long": "h20", "won": 9, "of": 15, "level0": 50, "reach0": 50, "gauntlet": []}])
	var text := "\n".join(sec)
	_check(text.contains("The standard camp, from the reads: reach 50, paragon 4"), "the section's camp line: %s" % text)
	# gate 8 on the 24 h reads: median 15 h, in the window - judged, green; a read short of 24 h that never got there: not judged
	_check(text.contains("Gate 8 on these reads: the median read 15.0 h (0 of 3 reads never): GREEN"), "gate 8 on 24 h reads: %s" % text)
	var g8: Array = Sum.retirement_row([{"build": "a", "hours": 24.0, "elapsed_h": 24.0, "lv50_at": 13.0}, {"build": "b", "hours": 24.0, "elapsed_h": 10.0, "lv50_at": -1.0}])
	_check(g8[3] == null and str(g8[2]).contains("not judged"), "gate 8 judged a read short of the window: %s" % str(g8))
	_check(Sum.retirement_row([{"build": "a", "hours": 24.0, "elapsed_h": 24.0, "lv50_at": 6.0}])[3] == false, "gate 8 passed a read before hour 8")
	# the table: the hours' cells, the County by hour 24 (24.5's not), level 50's word, the deaths after the Quartermaster
	var prow: Array = sec.filter(func(l): return str(l).begins_with("| Poacher as poison |"))
	_check(prow.size() == 1 and str(prow[0]).contains("| 13.0 h (in the window) |") and str(prow[0]).contains("| 2 of %d |" % Data.COUNTY.size()) and str(prow[0]).contains("| 28 · 8000 / 800 |")
		and str(prow[0]).contains("| 44 · 24 k / 2400 |") and str(prow[0]).contains("| 9.5 h |"), "the Poacher's long row: %s" % str(prow))
	_check(sec.any(func(l): return str(l).begins_with("| Drifter as fire |") and str(l).contains("30.0 h (late)")), "the Drifter's level 50 wasn't read late")
	_check(sec.any(func(l): return str(l) == "- Poacher as poison: signals 75%, sites 25%"), "XP by source (the floor left out): %s" % str(sec.filter(func(l): return str(l).begins_with("- "))))
	_check(sec.any(func(l): return str(l).begins_with("| G1 |") and str(l).contains("1 of 1 builds")) and sec.any(func(l): return str(l).begins_with("| G2 |") and str(l).contains("0 of 1 builds")),
		"the two gauntlets' rows: %s" % str(sec.filter(func(l): return str(l).begins_with("| G"))))
	_check(Sum.is_h20_gauntlet({"long": "h20"}) and Sum.is_h20_gauntlet({"build": "h20-Poacher-poison", "error": "no GAUNTLET line"}) and not Sum.is_h20_gauntlet({"long": "end", "build": "Poacher-poison"}),
		"the hour-20 gauntlet's reads aren't told from the end state's")
	# the review (1 Nov): a long read with no GATES line is judged by gate 8 off its HOUR lines, not dropped
	var killed: Dictionary = Sum.long_parse("\n".join(range(1, 13).map(func(h): return "HOUR " + JSON.stringify({"h": float(h), "at": float(h), "end": false, "runner_level": 30 + h * 2, "level": 30 + h * 2, "reach": h, "cash": 1.0, "earned": 1.0, "xp": {}}))))
	killed["name"] = "long-Recruit-physical"
	var stub: Dictionary = Sum.long_gate8_read(killed)
	_check(str(stub.get("element", "")) == "physical" and is_equal_approx(float(stub["lv50_at"]), 10.0) and is_equal_approx(float(stub["elapsed_h"]), 12.0), "the killed read's gate 8 stub: %s" % str(stub))
	var sec_k: Array = Sum.long_section(reads + [killed], [], [])
	_check("\n".join(sec_k).contains("Gate 8 on these reads: the median read 14.0 h (0 of 4 reads never): GREEN"), "gate 8 dropped the read with no GATES line: %s" % str(sec_k.filter(func(l): return str(l).begins_with("Gate 8"))))
	# and a pass whose long reads all lack a GATES line still writes its summary: the header and the section
	_check(not Sum.summary_aborts([], {}, [killed]) and Sum.summary_aborts([], {}, []), "the summary aborts on a long pass with no GATES line")
	var lo: Array = Sum.long_only_summary([killed], ["long-Recruit-physical: killed: it ran past its minutes"], [], [])
	_check(str(lo[0]) == "# Balance summary" and lo.has("## Long reads") and lo.any(func(l): return str(l).contains("killed: it ran past its minutes")) and lo.any(func(l): return str(l).begins_with("| Recruit as physical (no GATES line) |")),
		"the long-only summary: %s" % str(lo.slice(0, 8)))
	# an hour one step passed with the hour before is marked
	var ss: Dictionary = Sum.long_parse("HOUR " + JSON.stringify({"h": 8.0, "at": 9.2, "end": false, "reach": 7, "cash": 5.0, "earned": 0.0, "same_step": true}))
	ss["name"] = "long-Doorman-bleed"
	_check(Sum.long_section([ss], [], []).any(func(l): return str(l).contains("| 7 · 5 / 0 (same step) |")), "an hour from the same step wasn't marked")
	# balance.bat's branch (it can't run here): the flag taken, the six reads at 480 minutes as long reads, the wait, the two gauntlets
	var bat: String = FileAccess.get_file_as_string("res://tools/balance.bat")
	_check(bat.contains("if /i not \"%~3\"==\"long\" goto badflag") and bat.contains("if /i \"%~3\"==\"long\" goto long_reads") and bat.contains("tools\\balance_read.bat long-%%B-%%A 480 %HOURS% one %%B %%A 0 long")
		and bat.contains("call :waitfor \"long-*.done\" 6 3300") and bat.contains("gauntlet-long-%%B-%%A 60 0 gauntlet %%B %%A long") and bat.contains("gauntlet-h20-%%B-%%A 60 0 gauntlet %%B %%A h20")
		and bat.count("\n") == bat.count("\r\n"), "balance.bat's long branch: the flag, the reads, the wait, the gauntlets, or its CRLF")
	print("long38 ok: XP by source, the HOUR window, the saves' paths, the summary's Long reads, the camp, gate 8")


func _fix33_checks(main) -> void:
	var sim = main.sim
	sim.gate_box_always = false
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	# 1: 1000 rifle rounds in the stash: the gate packs one box of them, 400; 1000 shells, 150; the read the same (the
	# designer's call after PROBE33: 0.10.2's size kept)
	sim.equipped["Rig"] = sim._plain("Rig", "Chest rig")
	sim.equipped["Secondary"] = null
	sim.set_top_up("fill")
	for case in [["Stalking rifle", "Rifle magazine", "Rifle rounds", 400], ["Pump shotgun", "Shotgun magazine", "Shells", 150]]:
		var gun: Dictionary = sim._plain("Primary", str(case[0]))
		sim.equipped["Primary"] = gun
		sim.rig = [_mag_full(sim, str(case[1]), str(case[2]))]
		sim.stash = sim.stash.filter(func(x): return not Items.is_ammo(x) and not Items.is_mag(x))
		while not sim.stash_room(10) and not sim.stash.is_empty():
			sim.stash.pop_front()
		var left := 1000
		while left > 0:
			var b: Dictionary = sim._plain(Data.AMMO, str(case[2]))
			Items.set_stack(b, mini(left, int(Items.base_of(b)["rounds"])))
			left -= int(b["rounds"])
			sim.stash.append(b)
		var want: int = int(case[3])                 # one box of the grade (0.10.2's size, the designer's call): pinned literal
		_check(int(Items.base_named(Data.AMMO, str(case[2]))["rounds"]) == want, "the fixture: a box of %s isn't %d" % [case[2], want])
		var rd: Array = sim._gate_boxes(true).map(func(x): return int(x["rounds"]))
		sim.hp = sim.max_hp()
		sim.deploy(3)
		if sim.on_mission():
			var out: Array = sim.mission["found"].filter(func(x): return x.get("carried", false)).map(func(x): return int(x["rounds"]))
			_check(out == [want] and rd == [want] and sim._rounds_in_stash(str(case[2])) == 1000 - want, "the %s's gate box: %s packed, the read %s, want %d (one box)" % [case[0], str(out), str(rd), want])
			sim.extract_now()
		else:
			_check(false, "the fixture: no run for the %s's box" % case[0])
	# 2: each sling's damage: the dps read (the fight's own) and the card
	var gun2: Dictionary = sim._plain("Primary", "Pump shotgun")
	sim.equipped["Primary"] = gun2
	sim.rig = [_mag_full(sim, "Shotgun magazine", "Shells")]
	gun2["attachments"]["sling"] = null
	sim._dry_memo.clear()
	var d0: float = float(sim._gun_dps()[0])
	var f0: float = Items.fitted_sum(gun2, "damage_pct")
	main.show_room(main.ARMOURY)
	for case in [["Rope sling", 8], ["Webbing sling", 10], ["Leather sling", 12], ["Two-point sling", 15]]:
		gun2["attachments"]["sling"] = sim._plain(Data.ATTACHMENT, str(case[0]))
		sim._dry_memo.clear()
		var d1: float = float(sim._gun_dps()[0])
		var want_x: float = (1.0 + (f0 + float(case[1])) / 100.0) / (1.0 + f0 / 100.0)
		_check(d0 > 0.0 and absf(d1 / d0 - want_x) < 0.001, "the %s's damage in the read: x%.3f, want x%.3f" % [case[0], d1 / maxf(d0, 0.001), want_x])
		var sl: Dictionary = sim._plain(Data.ATTACHMENT, str(case[0]))
		sim.stash.append(sl)
		main._armoury.selected = {"kind": "stash", "id": sl["id"]}
		main.refresh()
		var tails: Array = main._armoury._pick._heads[0]._tail_chips.text_nodes().map(func(l): return str(l.text))
		_check(tails.has("+%d%% dmg" % int(case[1])) and tails.has("While the primary reloads"), "the %s's card: %s" % [case[0], str(tails)])
		_check_fit(main, "Kit (%s)" % case[0])
		sim.stash.erase(sl)
	gun2["attachments"]["sling"] = null
	# 3: the late melee bases' built-in bleed
	var bleeds := {}
	for nm in ["Court sword", "Cavalry sabre", "Bayonet on a stick", "Collier's pick", "Rescue axe"]:
		bleeds[nm] = int(Items.base_named("Primary", nm).get("conv_bleed_pct", -1))
	_check(bleeds == {"Court sword": 20, "Cavalry sabre": 20, "Bayonet on a stick": 15, "Collier's pick": 10, "Rescue axe": 15}, "the late melee bases' bleed: %s" % str(bleeds))
	# 4: the bot's compare: a hollow-point SMG against the Bayonet - the rounds' bleed counted, the element weighed once
	var bot = Bot.new()
	bot.element = "bleed"
	var smg: Dictionary = sim._plain("Primary", _base_of_type("smg"))
	sim.equipped["Primary"] = smg
	sim.rig = [_mag_full(sim, "SMG magazine", "SMG hollow point")]
	var bay: Dictionary = sim._plain("Primary", "Bayonet on a stick")
	var hp_bleed: float = float(Items.base_named(Data.AMMO, "SMG hollow point").get("conv_bleed_pct", 0)) / 100.0
	var s_smg: float = bot._elem_share(smg, sim)
	var s_bay: float = bot._elem_share(bay, sim)
	_check(hp_bleed > 0.0 and is_equal_approx(s_smg, hp_bleed) and is_equal_approx(s_bay, 0.15), "the bot's bleed shares: the SMG %.2f (its rounds' %.2f), the Bayonet %.2f" % [s_smg, hp_bleed, s_bay])
	_check(is_equal_approx(bot._elem_score(smg, sim), Items.score(smg) * (1.0 + s_smg)) and is_equal_approx(bot._elem_score(bay, sim), Items.score(bay) * 1.15), "the bot's element weight: the SMG %.1f (score %.1f), the Bayonet %.1f (score %.1f)" % [bot._elem_score(smg, sim), Items.score(smg), bot._elem_score(bay, sim), Items.score(bay)])
	# the worn gun and a spare of it read the same share off the rig's rounds (the reviewer: the spare read the plainer grade)
	bot.element = "frost"
	var ar_w: Dictionary = sim._plain("Primary", "AR-pattern rifle")
	var ar_s: Dictionary = sim._plain("Primary", "AR-pattern rifle")
	sim.equipped["Primary"] = ar_w
	sim.stash.append(ar_s)
	sim.rig = [_mag_full(sim, "Rifle magazine", "Salted rounds"), _mag_full(sim, "Rifle magazine", "Depot rounds")]
	sim._els_key = hash([sim.tree, sim.cls])     # build_elements's key
	sim._els = ["frost"]
	var sw: float = bot._elem_share(ar_w, sim)
	var ss: float = bot._elem_share(ar_s, sim)
	_check(is_equal_approx(sw, 0.30) and is_equal_approx(ss, sw) and is_equal_approx(bot._elem_score(ar_w, sim), bot._elem_score(ar_s, sim)), "the worn gun and its spare: shares %.2f / %.2f, scores %.1f / %.1f" % [sw, ss, bot._elem_score(ar_w, sim), bot._elem_score(ar_s, sim)])
	# the physical build's share: one grade fires at a time, so mixed magazines count the most converting one, not each
	# element's best summed (the reviewer: hollow point's bleed 20 and incendiary's fire 30 read as 50)
	bot.element = "physical"
	sim.equipped["Primary"] = smg
	sim.rig = [_mag_full(sim, "SMG magazine", "SMG hollow point"), _mag_full(sim, "SMG magazine", "Incendiary SMG rounds")]
	var own_conv := 0.0
	for el in Data.ELEMENTS:
		own_conv += float(Items.base_of(smg).get("conv_%s_pct" % el, 0))
	var sp: float = bot._elem_share(smg, sim)
	_check(is_equal_approx(sp, maxf(0.0, 1.0 - (own_conv + 30.0) / 100.0)), "the physical share with mixed magazines: %.2f, want %.2f (the most converting magazine, not the sum)" % [sp, maxf(0.0, 1.0 - (own_conv + 30.0) / 100.0)])
	sim._els_key = -1
	sim.load_dict(saved)
	main.refresh()
	print("fix33 ok: the box kept at one, the slings' damage, the melee's bleed, the bot's compare")


## BUILD37 E (31 Oct, the designer's calls on PROBE36): the endgame. A death past the Quartermaster keeps the level,
## and its words say so; a percent line stops growing at PCT_LINE_TOP (the card's figures too); worth grows at
## WORTH_GROW; a word's pool and drops stop at WORD_POOL_POW_TOP; the paragon's rows add.
func _endgame37_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	var qm_zone := -1
	for b in Data.BOSSES:
		if str(b["name"]) == "The Quartermaster":
			qm_zone = int(b["zone"])
	_check(qm_zone >= 0 and qm_zone < sim.bosses_beaten.size(), "the Quartermaster's zone isn't on the board: %d" % qm_zone)
	var into: float = 0.5 * (Data.xp_for_level(31) - Data.xp_for_level(30))
	# 1. before the Quartermaster: back to level 1, as before
	sim.bosses_beaten[qm_zone] = false
	sim.xp = Data.xp_for_level(30) + into
	sim.hardcore = false
	sim.deploy(3)
	sim.mission["hp_start"] = sim.hp
	sim._kia()
	_check(sim.level() == 1 and is_zero_approx(sim.xp), "a death before the Quartermaster: level %d, %.0f XP (want 1, 0)" % [sim.level(), sim.xp])
	sim.choose_runner(0)
	# past him: the level kept, the XP into it gone, the log and the pick card saying so
	sim.bosses_beaten[qm_zone] = true
	sim.xp = Data.xp_for_level(30) + into
	sim.deploy(3)
	sim.mission["hp_start"] = sim.hp
	sim._kia()
	_check(sim.level() == 30 and is_equal_approx(sim.xp, Data.xp_for_level(30)), "a death past the Quartermaster at level 30: level %d, %.0f XP (want 30, %.0f)" % [sim.level(), sim.xp, Data.xp_for_level(30)])
	var logged := false
	for e in sim.events:
		logged = logged or str(e[1]) == Words.YARD["level_kept"] % [31, 30]
	_check(logged, "the log doesn't say the next runner starts at level 30")
	main.show_room(main.MISSIONS)
	main.refresh()
	var ms = main._missions
	var chips: Array = []
	for k in range(ms._pick_lost.shown()):
		chips.append(ms._pick_lost.words(k))
	_check(ms._pick.visible and ms._pick_kicker.text.to_lower().contains("still level 30") and not ms._pick_kicker.text.contains("level 1 ") and not ms._pick_kicker.text.ends_with("level 1"), "the pick past the Quartermaster: '%s'" % ms._pick_kicker.text)
	_check(chips.has("XP towards level 31") or chips.has("The level's XP"), "the pick's lost chips past the Quartermaster: %s" % str(chips))
	_check(not chips.has("The levels") and not chips.has("The %s's levels" % sim.cls), "the pick still says the levels went: %s" % str(chips))
	_check_fit(main, "The Map (a death past the Quartermaster)")
	sim.choose_runner(0)
	# past 50: the level stays at 50 and the paragon levels too (1 Nov); the card says the paragon's kept, not the levels gone
	sim.xp = Data.xp_for_level(Data.MAX_LEVEL + 3)
	sim.paragon_xp = Data.xp_for_level(Data.MAX_LEVEL + 3) - Data.xp_for_level(Data.MAX_LEVEL)     # 3 paragon levels (31 Oct: the card's chip is what was really lost)
	sim.deploy(3)
	sim.mission["hp_start"] = sim.hp
	sim._kia()
	_check(sim.level() == Data.MAX_LEVEL and is_equal_approx(sim.xp, Data.xp_for_level(Data.MAX_LEVEL)), "a death past 50: level %d" % sim.level())
	main.refresh()
	chips = []
	for k in range(ms._pick_lost.shown()):
		chips.append(ms._pick_lost.words(k))
	_check(ms._pick_kicker.text.to_lower().contains("still level %d" % Data.MAX_LEVEL) and not ms._pick_kicker.text.to_lower().contains("paragon") and (chips.has("Paragon 3") or chips.has("Paragon")) and not chips.has("Paragon levels") and not chips.has("The levels"), "the pick past 50: '%s', %s" % [ms._pick_kicker.text, str(chips)])
	_check_fit(main, "The Map (a death past 50)")
	sim.load_dict(saved)
	main.refresh()
	# 3. a percent line stops at PCT_LINE_TOP; a flat line and a base grow on; the Workshop's tier figures follow
	var top: int = Data.PCT_LINE_TOP
	_check(is_equal_approx(Items.affix_mult("damage_pct", top + 15), Items.ilvl_mult(top)) and Items.affix_mult("damage_pct", top) > Items.affix_mult("damage_pct", Data.ILVL_FROM), "a percent line past item level %d: ×%.3f, at it ×%.3f" % [top, Items.affix_mult("damage_pct", top + 15), Items.ilvl_mult(top)])
	_check(Items.affix_mult("hp", top + 15) > Items.affix_mult("hp", top) * 1.5, "a flat line stopped growing past item level %d" % top)
	var vest: Dictionary = sim._plain("Armour", "Work jacket")
	vest["affixes"] = [{"stat": "damage_pct", "value": 10, "tier": 1}, {"stat": "hp", "value": 10, "tier": 1}]
	vest["ilvl"] = top
	var ws = main._workshop
	var f_top: Array = ws.tier_figures(vest, 0)
	var h_top: Array = ws.tier_figures(vest, 1)
	vest["ilvl"] = top + 15
	_check(ws.tier_figures(vest, 0) == f_top and int(ws.tier_figures(vest, 1)[1]) > int(h_top[1]), "the Workshop's figures past item level %d: %s against %s, hp %s against %s" % [top, str(ws.tier_figures(vest, 0)), str(f_top), str(ws.tier_figures(vest, 1)), str(h_top)])
	var rolled: Dictionary = Items.roll_affix({"stat": "damage_pct", "min": 10, "max": 10}, top + 15, sim.rng, 1)
	_check(int(rolled["value"]) == int(round(10.0 * Items.ilvl_mult(top))), "a percent line rolled at item level %d: %d" % [top + 15, int(rolled["value"])])
	# 5. worth past item level 20 at WORTH_GROW a level: the sale and the shelf follow
	var gun: Dictionary = sim._plain("Primary", "Pump shotgun")
	gun["affixes"] = []
	gun["ilvl"] = Data.ILVL_GROW_FROM
	var w0: float = Items.worth(gun)
	var s0: float = float(sim.sell_price(gun))
	var p0: float = float(sim.price(gun))
	gun["ilvl"] = Data.ILVL_GROW_FROM + 30
	var k30: float = pow(1.0 + Data.WORTH_GROW, 30.0)
	_check(w0 > 0.0 and is_equal_approx(Items.worth(gun) / w0, k30), "an item's worth 30 levels past %d: ×%.3f, want ×%.3f" % [Data.ILVL_GROW_FROM, Items.worth(gun) / maxf(w0, 0.001), k30])
	_check(absf(float(sim.sell_price(gun)) / s0 - k30) < 0.02 and absf(float(sim.price(gun)) / p0 - k30) < 0.02, "the Fence's sale and shelf don't follow the worth: ×%.3f, ×%.3f" % [float(sim.sell_price(gun)) / s0, float(sim.price(gun)) / p0])
	# 6. a word's pool and drops stop at WORD_POOL_POW_TOP; its XP grows on
	var e2: Dictionary = sim.word_effect("Full house", 2)
	var e4: Dictionary = sim.word_effect("Full house", 4)
	_check(is_equal_approx(float(e2["pool"]), pow(3.0, Data.WORD_POOL_POW_TOP)) and is_equal_approx(float(e4["pool"]), float(e2["pool"])) and is_equal_approx(float(e4["drop"]), float(e2["drop"])), "Full house's pool and drops past tier II: pool %.2f / %.2f, drops %.2f / %.2f" % [float(e2["pool"]), float(e4["pool"]), float(e2["drop"]), float(e4["drop"])])
	_check(float(e4["xp"]) > float(e2["xp"]) * 1.5, "Full house's XP stopped growing with the tier: %.2f / %.2f" % [float(e2["xp"]), float(e4["xp"])])
	# 7. the paragon's rows add: 10 points of damage +20%, not 1.02^10; the board's words don't say compounding
	var pg_saved: Dictionary = sim.to_dict()
	sim.xp = Data.xp_for_level(Data.MAX_LEVEL)
	sim.paragon_xp = Data.xp_for_level(Data.MAX_LEVEL + 12) - Data.xp_for_level(Data.MAX_LEVEL)
	sim.ring = {}
	var added := 0
	for k in range(10):
		added += 1 if sim.paragon_add("damage") else 0
	var pct_d: float = float(Data.paragon_row("damage")["pct"]) / 100.0
	_check(added == 10 and is_equal_approx(sim.paragon_mult("damage"), 1.0 + pct_d * 10.0), "the paragon's damage row at 10 points: ×%.4f, want ×%.4f (adding)" % [sim.paragon_mult("damage"), 1.0 + pct_d * 10.0])
	for r in Data.PARAGON_BOARD:
		_check(not str(r["words"]).contains("compound"), "the paragon board's %s row still says it compounds: %s" % [r["name"], r["words"]])
	sim.load_dict(pg_saved)
	sim.load_dict(saved)
	main.refresh()
	print("endgame37 ok: the death past the Quartermaster, the percent lines' top, the worth, the words' pool, the paragon adding")


## A gun's rounds in the rig for the older checks (30 Oct, magazines as items: rounds never go in the rig as a box): a
## standard magazine of the grade's type loaded with `n` of it - by default full, its real size against the gun it feeds
## in `s` (the fix round, the review's 13). A check that wants a pile spends several (_rmags) or a box in the pack.
func _rmag(s, grade: String, n := -1) -> Dictionary:
	var ty: String = str(Items.base_named(Data.AMMO, grade)["type"])
	var mg: Dictionary = s._plain(Data.MAGAZINE, str(Items.standard_mag(ty)["name"]))
	mg["ammo"] = grade
	mg["rounds"] = n if n >= 0 else Items.mag_cap(mg, s.mag_gun(mg))
	return mg


## `k` full magazines of a grade (the fix round): a pile that reloads as the fight does.
func _rmags(s, grade: String, k: int) -> Array:
	var out: Array = []
	for i in range(k):
		out.append(_rmag(s, grade))
	return out


## A magazine of this base loaded full with a grade (30 Oct, magazines as items): full against the gun it feeds in `s`.
func _mag_full(s, base: String, grade: String) -> Dictionary:
	var mg: Dictionary = s._plain(Data.MAGAZINE, base)
	mg["ammo"] = grade
	mg["rounds"] = Items.mag_cap(mg, s.mag_gun(mg))
	return mg


## The third review's fixes (28 Oct): each with the check that would have caught it - the Issue counting what's held on
## the exchange, a kit's pouches worn, her rolled meds' level, supplies never a paper or a mythic, a found box in the
## try-on, the belt's pouch, the rig packed HEAL, MAGAZINE, CURE by the gate and the bot alike, the bot's shelf, its
## exchange, its Pitch lines, its element swap; supplies waiting flagged.
func _review28_checks(main) -> void:
	var fresh := func():
		var f = Sim.new()
		f.start()
		f.mythics_on = false
		f.unlock_all()
		f.set_class("Poacher")
		return f
	# the Issue: scrap, salvage and materials held join the pile at their exchange worth (A2, Matt)
	var s = fresh.call()
	s.cash = 4.0e6
	var p0: Dictionary = s.issue_preview()
	s.scrap = 5000
	s.salvage["steel"] = 60
	s.materials["glass"] = 25
	var w: float = 5000.0 * s.exchange_worth("scrap") + 60.0 * s.exchange_worth("steel") + 25.0 * s.exchange_worth("glass")
	_check(is_equal_approx(s.exchange_held_worth(), w), "what's held on the exchange is worth %.0f, not %.0f" % [s.exchange_held_worth(), w])
	var p1: Dictionary = s.issue_preview()
	_check(absf(float(p1["held"]) - float(p0["held"]) - w) < 1.0 and float(p1["fiat"]) < float(p0["fiat"]), "the Issue's preview doesn't count the scrap and salvage held: held %.0f from %.0f, fiat %.0f from %.0f" % [p1["held"], p0["held"], p1["fiat"], p0["fiat"]])
	s.issue()
	_check(s.issued and absi(int(s.issue_moment["stash"]) - int(round(float(p1["held"])))) <= 1 and absf(s.cash - float(p1["fiat"])) < 1.0, "the Issue didn't convert what its preview said: %s against %s" % [str(s.issue_moment), str(p1)])
	# a kit's rig of three magazines worn, filled from one box (A3; 30 Oct, magazines as items)
	s = fresh.call()
	s.equipped["Primary"] = s._plain("Primary", _base_of_type("smg"))
	s.equipped["Secondary"] = null
	s.equipped["Rig"] = s._plain("Rig", "Chest rig")
	s.rig = []
	for k in range(3):
		s.rig.append(_mag_full(s, "SMG magazine", "SMG rounds"))
	s.loadout_save(0)
	s.rig = []
	var box: Dictionary = s._plain(Data.AMMO, "SMG rounds")
	Items.set_stack(box, 600)
	s.stash = [box]
	for k in range(3):
		s.stash.append(s._plain(Data.MAGAZINE, "SMG magazine"))
	_check(s.loadout_wear(0), "the fixture: the kit wouldn't wear")
	var smg_mags: Array = s.rig.filter(func(x): return str(x["base"]) == "SMG magazine")
	var log_worn: bool = s.events.any(func(ev): return str(ev[1]) == Words.LOADOUTS["worn"] % 1)
	_check(smg_mags.size() == 3 and smg_mags.all(func(x): return int(x["rounds"]) == 30) and int(box["rounds"]) == 600 - 90 and log_worn, "a kit of three magazines worn from one box: %d magazines, %d left in the box, worn said %s" % [smg_mags.size(), int(box["rounds"]), str(log_worn)])
	# her Magic and Rare meds at their bases' tier (A4)
	s = fresh.call()
	s.supplies_in = int(Data.CLINIC_STEPS[Data.CLINIC_STEPS.size() - 1]["need"])
	s.xp = Data.xp_for_level(30)
	s.best_level = 30
	var rolled: Array = []
	for k in range(30):
		s._restock_clinic()
		rolled.append_array(s.clinic.filter(func(x): return int(x["rarity"]) > 0))
	_check(not rolled.is_empty() and rolled.all(func(x): return Items.ilvl(x) == int(Items.base_of(x)["tier"])) and rolled.any(func(x): return Items.ilvl(x) > 1), "her rolled meds' level isn't their tier: %s" % str(rolled.slice(0, 4).map(func(x): return [x["base"], Items.ilvl(x)])))
	# supplies never take a paper's place, nor a mythic's (A5)
	var hosp: int = -1
	for i in range(Data.TIERS.size()):
		if Data.TIERS[i]["name"] == "The Hospital":
			hosp = i
	var cab: Dictionary = Sim.crate_def("medicine")
	var on_paper := 0
	var on_armour := 0
	for k in range(200):
		if s._supplies_take(Data.PAPER, false, false, Data.TIERS[hosp], cab):
			on_paper += 1
		if s._supplies_take("Armour", false, false, Data.TIERS[hosp], cab):
			on_armour += 1
	_check(on_paper == 0 and on_armour > 0, "supplies took a paper's place %d times in 200 (another's %d)" % [on_paper, on_armour])
	var sr = _fresh_run(0)
	if sr == null:
		_check(false, "the fixture: no run for the mythic and the supplies")
	else:
		sr.mythics_on = true
		var probe := RandomNumberGenerator.new()
		var hit_seed := -1
		for sd in range(400000):
			probe.seed = sd
			if probe.randi_range(1, Data.MYTHIC_ODDS_IN) == 1:
				hit_seed = sd
				break
		_check(hit_seed >= 0, "the fixture: no mythic seed")
		var myths := 0
		var tries := 0
		for k in range(40):
			sr.mythic_rng.seed = hit_seed
			var f: Dictionary = sr._find(sr.mission, sr.effective(hosp), false, cab, true)
			if f.is_empty():
				continue
			tries += 1
			if f["it"].get("mythic", false):
				myths += 1
		_check(tries > 0 and myths == tries, "a mythic rolled was lost to supplies: %d of %d finds" % [myths, tries])
		# a box found out there is the try-on's feed (B4; 30 Oct: it refills a magazine by hand, the playtest's item 4)
		var found_box: Dictionary = sr._plain(Data.AMMO, "Rifle rounds")
		sr.mission["found"].append(found_box)
		_check(sr._rounds_held().has(found_box), "a box found on the run doesn't count as the try-on's feed")
		sr.extract_now()
	# the belt (B6; 30 Oct, magazines as items): a magazine's size is the gun's - the belt-fed's own 100 in a standard SMG
	# magazine, Belt links no size of their own
	var belt_gun: Dictionary = s._plain("Primary", "Belt-fed SMG")
	var sm: Dictionary = s._plain(Data.MAGAZINE, "SMG magazine")
	_check(Items.mag_cap(sm, belt_gun) == 100 and Items.mag_cap(s._plain(Data.MAGAZINE, "Belt box"), belt_gun) == 250 and not Items.base_named(Data.AMMO, "Belt links").has("mag"), "the belt-fed's magazines: %d standard, %d belt box" % [Items.mag_cap(sm, belt_gun), Items.mag_cap(s._plain(Data.MAGAZINE, "Belt box"), belt_gun)])
	# the rig packs HEAL, MAGAZINE, CURE (Matt): a Bum bag out of a stash of heals, rounds and cures, by the gate and
	# by the bot alike
	var bt = Bot.new()
	for who in ["gate", "bot"]:
		s = fresh.call()
		s.cash = 0.0
		s.equipped["Primary"] = s._plain("Primary", _base_of_type("smg"))
		s.equipped["Secondary"] = null
		s.equipped["Rig"] = s._plain("Rig", "Bum bag")
		s.rig = []
		var els: Array = s.zone_elements(s.front_tier())
		var st: Array = [s._plain(Data.MEDICAL, "Bandage"), s._plain(Data.MEDICAL, "Bandage"), s._plain(Data.MEDICAL, "Bandage"), s._plain(Data.AMMO, "SMG rounds"),
			s._plain(Data.MAGAZINE, "SMG magazine"), s._plain(Data.MAGAZINE, "SMG magazine"), s._plain(Data.MAGAZINE, "SMG magazine")]
		for b in Data.BASES[Data.MEDICAL]:
			if els.has(str(b.get("cure", ""))):
				st.append(s._plain(Data.MEDICAL, str(b["name"])))
				st.append(s._plain(Data.MEDICAL, str(b["name"])))
		s.stash = st
		_check(not els.is_empty() and s.med_capacity() == 3, "the fixture: the front throws %s, the bag holds %d" % [str(els), s.med_capacity()])
		if who == "gate":
			s._top_up()
		else:
			bt._restock_meds(s)
		var heals: int = s.rig.filter(func(x): return Items.is_heal(x)).size()
		var mags: int = s.rig.filter(func(x): return Items.is_mag(x)).size()
		var cures: int = s.rig.filter(func(x): return Items.is_cure(x)).size()
		_check(heals == 1 and mags == 1 and cures == 1, "the %s packed a Bum bag with %d heals, %d magazines, %d cures (a heal, a magazine, a cure)" % [who, heals, mags, cures])
		# a Fishing vest and a Chest rig: a heal always; the magazines to their share, the secondary's of another type its pouch
		for rig_name in ["Fishing vest", "Chest rig"]:
			s.equipped["Rig"] = s._plain("Rig", rig_name)
			var pistols: Array = Data.BASES["Secondary"].filter(func(b): return Items.ammo_type(s._plain("Secondary", str(b["name"]))) == "pistol" and not Items.free_rounds(s._plain("Secondary", str(b["name"]))))
			s.equipped["Secondary"] = s._plain("Secondary", str(pistols[0]["name"]))
			s.rig = []
			var st2: Array = st.duplicate()
			for k in range(4):
				st2.append(s._plain(Data.MEDICAL, "Bandage"))
			var smg_box: Dictionary = s._plain(Data.AMMO, "SMG rounds")
			st2.append(smg_box)
			st2.append(s._plain(Data.AMMO, "Pistol rounds"))
			for k in range(6):
				st2.append(s._plain(Data.MAGAZINE, "SMG magazine"))
			st2.append(s._plain(Data.MAGAZINE, "Pistol magazine"))
			s.stash = st2
			if who == "gate":
				s._top_up()
			else:
				bt._restock_meds(s)
			var share: int = ceili(s.med_capacity() * Data.RIG_MAG_SHARE)
			var ammo_n: int = s.rig.filter(func(x): return Items.is_mag(x)).size()
			var pistol_n: int = s.rig.filter(func(x): return Items.is_mag(x) and Items.mag_type(x) == "pistol").size()
			_check(s.rig.any(func(x): return Items.is_heal(x)) and ammo_n <= share and ammo_n >= 1 and pistol_n == (1 if share >= 2 else 0) and s.rig_used() == s.med_capacity(), "the %s packed a %s: %d heals, %d magazines (share %d, %d the pistol's), %d of %d used" % [who, rig_name, s.rig.filter(func(x): return Items.is_heal(x)).size(), ammo_n, share, pistol_n, s.rig_used(), s.med_capacity()])
		s.equipped["Secondary"] = null
		# a rig full of last run's heals and cures, the primary's rounds only in the stash (30 Oct, review30 refactor 3:
		# the gate's packer the only one): the gate and the bot alike pack the primary's first pouch, the same rig, and
		# the run goes out with rounds in the gun (once, beside the bot's turn)
		if who == "gate":
			continue
		var rigs: Array = []
		for packer in ["gate", "bot"]:
			s = fresh.call()
			s.cash = 0.0
			s.equipped["Primary"] = s._plain("Primary", _base_of_type("smg"))
			s.equipped["Secondary"] = null
			s.equipped["Rig"] = s._plain("Rig", "Chest rig")
			s.rig = [s._plain(Data.MEDICAL, "Bandage")]
			for b in Data.BASES[Data.MEDICAL]:
				if b.has("cure") and s.rig_room(1):
					s.rig.append(s._plain(Data.MEDICAL, str(b["name"])))
			while s.rig_room(1):
				s.rig.append(s._plain(Data.MEDICAL, "Bandage"))
			var full_n: int = s.rig.size()
			var had_cures: bool = s.rig.any(func(x): return Items.is_cure(x))
			s.stash = [s._plain(Data.AMMO, "SMG rounds"), s._plain(Data.AMMO, "SMG rounds"), s._plain(Data.AMMO, "SMG rounds"), s._plain(Data.MAGAZINE, "SMG magazine"), s._plain(Data.MAGAZINE, "SMG magazine")]
			var gun: Dictionary = s.equipped["Primary"]
			_check(full_n >= 4 and had_cures and not s.rig_room(1) and s.rounds_for(gun) == 0, "the fixture: a rig of %d, cures %s, full %s, %d rounds in it" % [full_n, str(had_cures), str(not s.rig_room(1)), s.rounds_for(gun)])
			if packer == "gate":
				s._top_up()
			else:
				bt._restock_meds(s)
			rigs.append(s.rig.map(func(x): return str(x["base"]) + "/" + str(x.get("rounds", 0))))
			_check(s.rounds_for(gun) > 0 and s.rig.any(func(x): return Items.is_heal(x)), "the %s packed a full rig of heals and cures with %d rounds for the primary: %s" % [packer, s.rounds_for(gun), str(rigs.back())])
			if packer == "bot":
				_check(rigs[0] == rigs[1], "the bot packed its own rig, not the gate's: the gate %s, the bot %s" % [str(rigs[0]), str(rigs[1])])
				s.hp = s.max_hp()
				s.deploy(0)
				_check(s.on_mission() and s.rounds_for(gun) > 0, "the bot's run went out with %d rounds for the primary (on a run %s)" % [s.rounds_for(gun), str(s.on_mission())])
				if s.on_mission():
					s.extract_now()
				# the stash without them too: the bot buys the dry primary's magazines off the Fence's shelf and their box with the
				# rig full, the packer makes room
				s.rig = s.rig.filter(func(x): return not Items.is_mag(x))
				while s.rig_room(1):
					s.rig.append(s._plain(Data.MEDICAL, "Bandage"))
				s.stash = []
				s.cash = 1.0e5
				s._restock_market()
				bt._restock_meds(s)
				_check(s.rounds_for(gun) > 0, "the bot bought no rounds for a dry primary with the rig full: %s" % str(s.rig.map(func(x): return x["base"])))
	# the bot buys off her shelf as the player does (B3): the cheapest heal that fits, a cure for the front, nothing off it
	s = fresh.call()
	s.cash = 1.0e5
	s._restock_clinic()
	var cheapest := {}
	for it in s.clinic:
		if Items.is_heal(it) and Items.size(it) <= 1 and (cheapest.is_empty() or s.clinic_price(it) < s.clinic_price(cheapest)):
			cheapest = it
	var shelf_n: int = s.clinic.size()
	_check(not cheapest.is_empty() and bt._buy_shelf_heal(s, 1) and s.stash.has(cheapest) and not s.clinic.has(cheapest) and s.clinic.size() == shelf_n - 1, "the bot didn't buy her cheapest one-pouch heal off the shelf")
	s.clinic = s.clinic.filter(func(x): return not Items.is_cure(x))
	s.stash = s.stash.filter(func(x): return not Items.is_cure(x))
	s.rig = []
	bt._stock_cures(s)
	_check(not s.stash.any(func(x): return Items.is_cure(x)), "the bot bought a cure her shelf hasn't got")
	s.clinic = s.clinic.filter(func(x): return not Items.is_heal(x))
	_check(not bt._buy_shelf_heal(s, 3), "the bot bought a heal off an empty shelf")
	# her spares: three cures of each kept
	s.stash = []
	for k in range(5):
		s.stash.append(s._plain(Data.MEDICAL, "Activated charcoal"))
	bt._sell_spares(s)
	_check(s.stash.filter(func(x): return str(x["base"]) == "Activated charcoal").size() == 3, "the bot's spares kept %d cures of a kind, not three" % s.stash.filter(func(x): return str(x["base"]) == "Activated charcoal").size())
	# the bot's Pitch: its own line first (BOT_LINE), and the exchange buys only what that line's next step wants (D4)
	s = fresh.call()
	s.yard_open = Data.YARD_COLS
	s.cash = 1.0e7
	s.salvage = {"copper": 0, "steel": 0, "army": 0}
	for yb in Data.YARD:
		s.yard_picks[yb["key"]] = ["", "", "", "", ""]
	s._yard_dirty = true
	bt._build_yard(s)
	var built: Array = []
	for yb in Data.YARD:
		for c in range(yb["picks"].size()):
			for sd in ["a", "b"]:
				if s.yard_built_side(yb["key"], c, sd):
					built.append([yb["key"], c, sd])
	_check(built.size() == 1 and str(built[0][2]) == str(Bot.BOT_LINE.get(built[0][0], "a")) and int(built[0][1]) == 0, "the bot's first Pitch pick isn't its own line's first step: %s" % str(built))
	var bench_kind: String = Data.yard_building("bench")["salvage"]
	s.salvage[bench_kind] = 1                 # held: on the exchange's board
	for yb in Data.YARD:
		s.yard_picks[yb["key"]] = ["", "", "", "", ""]
	var other: String = "b" if Bot.BOT_LINE.get("bench", "a") == "a" else "a"
	s.yard_picks["bench"] = [other, other, other, other, ""]
	s._yard_dirty = true
	_check(s.yard_pick_block("bench", 4, other).begins_with("Wants"), "the fixture: the bench's other line doesn't want salvage: '%s'" % s.yard_pick_block("bench", 4, other))
	bt._exchange_short(s)
	_check(s.exchange_offered().has(bench_kind) and int(s.salvage.get(bench_kind, 0)) == 1, "the bot bought %d %s for a line it won't build yet" % [int(s.salvage.get(bench_kind, 0)) - 1, bench_kind])
	var own: String = Bot.BOT_LINE.get("bench", "a")
	s.yard_picks["bench"] = [own, own, own, own, ""]
	s._yard_dirty = true
	var cash_x: float = s.cash
	bt._exchange_short(s)
	_check(int(s.salvage.get(bench_kind, 0)) == Data.YARD_PICK_SALVAGE and s.cash < cash_x and s.cash >= bt._reserve(s) + s.yard_pick_cost("bench", 4), "the bot's exchange for its own line's fifth step: %d %s, £%.0f from £%.0f" % [int(s.salvage.get(bench_kind, 0)), bench_kind, s.cash, cash_x])
	# (the bot's element swap, A6/D3, went with the skill web, 3 Nov: no elements to open or close)
	# supplies waiting: What's next says so, ahead of the sites (Matt: as a ready contract did)
	s = fresh.call()
	s.runs_total = 5
	var sp: Dictionary = s._plain(Data.SUPPLIES, "Medical supplies")
	Items.set_stack(sp, 3)
	s.stash.append(sp)
	_check(s.can_hand_in() and s.next_words() == Words.NEXT["supplies"] and s.next_words(true) == Words.NEXT_SHORT["supplies"], "What's next doesn't point at the supplies: '%s'" % s.next_words())
	s.hand_in_supplies()
	_check(s.next_words() != Words.NEXT["supplies"], "What's next still points at supplies handed in")
	# a save that still carries the contracts loads (the tools review's B15)
	var old_d: Dictionary = s.to_dict()
	old_d["contracts"] = [{"kind": "scrap", "pay": "notes", "amount": 3}]
	var s4 = Sim.new()
	s4.load_dict(old_d)
	_check(is_equal_approx(s4.cash, s.cash) and s4.supplies_in == s.supplies_in, "a save carrying the old contracts didn't load")
	print("the third review's fixes ok: the Issue's pile, a kit's pouches, her meds' level, supplies and papers and mythics, the found box, the belt, HEAL MAGAZINE CURE, the bot's shelf, Pitch, exchange and element, supplies flagged")
	_review28_ui_checks(main)


## The third review's screen fixes (28 Oct): Training's reset, a rig cell's words, the standings' opener, a cure's
## cell, supplies on the rail, a box dropped on the rig, the element names.
func _review28_ui_checks(main) -> void:
	var sim = main.sim
	if sim.on_mission():
		sim.extract_now()
	var saved: Dictionary = sim.to_dict()
	# Training's class reset off with only the camp's nodes, and the clipboard left alone (A1)
	sim.tree = sim.tree.filter(func(id): return sim.is_ring(str(id)))
	sim._ensure_start(false)
	main.show_room(main.BARRACKS)
	var bk = main._barracks
	bk.selected = ""
	bk._shown = ""
	main.refresh()
	_check(bk._respec.disabled and not sim.can_respec(), "Training's reset is live with only the camp's nodes: '%s'" % bk._respec.text)
	bk.copied = "smoke: keep"                 # the barracks' test clipboard (the fix round, 30 Oct: the smoke never writes Matt's)
