## The radio line (13 Oct, Matt; mockup C): the top bar's second row, the rooms under it at their full height, the words
## scrolling and never stopping, a line just heard next, no speaker's name anywhere, a press opening the Radio.
func _radio_line_checks(main) -> void:
	var sim = main.sim
	var rl = main._radio_line
	main.layout(Vector2(1920, 1080))             # the shell lays out on a resize; headless has none
	var top: float = Pal.TOP_H + Pal.RADIO_H
	_check(rl.visible and is_equal_approx(rl.position.y, Pal.TOP_H) and is_equal_approx(rl.size.y, Pal.RADIO_H) and main._top.size.y >= top, "the radio line is not the top bar's second row: y %.0f h %.0f" % [rl.position.y, rl.size.y])
	var room_end: float = main._grid.position.y + Pal.ROOM_H
	_check(main._rail.position.y >= top and main._grid.position.y >= top and room_end + Pal.LOG_GAP <= main._events.position.y + 0.5 and main._events.position.y + Pal.EVENTS_H <= 1080.0 - Pal.BOTTOM + 0.5, "the rooms don't fit under the radio line: grid %.0f, room end %.0f, log %.0f" % [main._grid.position.y, room_end, main._events.position.y])
	rl.step(0.0)
	_check(not rl._items.is_empty(), "the radio line plays nothing")
	var x0: float = rl._items[0]["label"].position.x
	rl.step(10.0)
	_check(is_equal_approx(rl._items[0]["label"].position.x, x0 - 10.0), "the radio line does not move")
	for it in rl._items:
		_check(it["label"].size.y <= Pal.RADIO_H, "a radio word runs out of its row")
	# a line just heard jumps the queue: the next line on the strip is it, not the turn through what's been heard
	var saved_events: Array = sim.events.duplicate(true)
	main.refresh()                               # the shell's count of lines seen in step with this camp's (a load before can leave it ahead)
	rl._queue.clear()                            # lines the smoke's own runs heard wait their turn ahead of the probe: first heard, first played
	var heard_line := "Probe on the air, testing."
	sim.log_event(Words.RADIO_LEAD + heard_line)
	main.refresh()
	var tail: Label = rl._items.back()["label"]
	var added := ""
	for k in range(4000):
		rl.step(10.0)
		if rl._items.back()["label"] != tail:
			added = rl._items.back()["label"].text
			break
	_check(added == heard_line, "a line just heard was not next on the radio line: '%s'" % added)
	sim.events = saved_events
	# a room's "before" line stops in the turn once its room is open (13 Oct, Matt: the Clinic saved, the bag still asked for)
	var heard0: Array = sim.heard.duplicate()
	var unlocked0: Array = sim.unlocked.duplicate()
	var bag_k: int = -1
	for k in range(Words.RADIO.size()):
		if str(Words.RADIO[k].get("gate", "")) == "The Gamekeeper/before":
			bag_k = k
	_check(bag_k >= 0, "the Gamekeeper's before line is gone from the radio's lines")
	var bag_text: String = str(Words.RADIO[bag_k]["text"]) if bag_k >= 0 else ""
	sim.heard = ["%s/%d" % [Words.RADIO[maxi(0, bag_k)]["voice"], bag_k]] + heard0.filter(func(h): return not str(h).ends_with("/%d" % bag_k))
	rl._queue.clear()
	for shut in [true, false]:
		if shut:
			sim.unlocked = unlocked0.filter(func(r): return r != "clinic")
		else:
			sim.unlocked = unlocked0 + (["clinic"] if not ("clinic" in unlocked0) else [])
		var played := []
		for n in range(sim.heard.size() * 2 + 2):
			played.append(rl._next_line())
		_check(played.has(bag_text) == shut, "the bag's line %s with the Clinic %s" % ["plays" if not shut else "never plays", "open" if not shut else "shut"])
	# one line heard (a fresh camp: the medic's), it never runs twice running - the loop's latest fills in (21 Oct,
	# Matt's playtest); and a heard line pushed, then its turn, is the same
	sim.unlocked = unlocked0.filter(func(r): return r != "clinic")
	sim.heard = ["%s/%d" % [Words.RADIO[maxi(0, bag_k)]["voice"], bag_k]]
	rl._queue.clear()
	rl._last = ""
	var solo := []
	for n in range(8):
		solo.append(rl._next_line())
	var twice := false
	for n in range(1, solo.size()):
		if solo[n] == solo[n - 1]:
			twice = true
	_check(not twice and solo.has(bag_text) and solo.has(str(Words.RADIO[0]["text"])), "one line heard runs back to back on the radio line: %s" % str(solo.map(func(x): return str(x).left(20))))
	rl.push(bag_text)
	var pushed: String = rl._next_line()
	var after_push: String = rl._next_line()
	_check(pushed == bag_text and after_push != bag_text, "a heard line pushed, then its turn, ran twice running")
	# the loop stopped stays stopped (19 Oct, Matt: it said so, then played straight on): its latest heard only, and
	# none of it in the traffic
	var stop_k: int = -1
	var loop_ks: Array = []
	for k in range(Words.RADIO.size()):
		if str(Words.RADIO[k]["voice"]) == "loop" and not Words.RADIO[k].has("lorries"):
			loop_ks.append(k)
			if Words.RADIO[k].get("stopped", false):
				stop_k = k
	_check(stop_k >= 0, "the loop has no stopped line")
	var kev_k: int = Words.RADIO.find(Words.RADIO.filter(func(r): return str(r["voice"]) == "kev")[0])
	sim.heard = loop_ks.map(func(k): return "loop/%d" % k) + ["kev/%d" % kev_k]
	rl._queue.clear()
	var after_stop := []
	for n in range(12):
		after_stop.append(rl._next_line())
	var stop_text: String = str(Words.RADIO[maxi(0, stop_k)]["text"])
	_check(after_stop.all(func(x): return x == stop_text or x == str(Words.RADIO[kev_k]["text"])) and after_stop.has(stop_text), "the loop played on after it stopped: %s" % str(after_stop))
	sim.unlocked = unlocked0 + (["radio"] if not ("radio" in unlocked0) else [])
	var RLv := preload("res://scripts/ui/radio_line.gd")
	var heard_loop := false
	rl._since_garble = 0
	for n in range(240):
		var parts: Array = rl.next_parts()
		if parts.any(func(p): return p[1] == RLv.GARBLE) and parts.any(func(p): return p[1] == RLv.VOICE["loop"]):
			heard_loop = true             # a word of the loop's through the traffic
	_check(not heard_loop, "the loop came through the traffic after it stopped")
	sim.heard = heard0
	sim.unlocked = unlocked0
	# a colour a voice, and the traffic (16 Oct, item 6): Kev's line in Kev's colour; before the Radio a line in five
	# is all glyphs, after it one in twelve with a word or two through in its voice's colour; every glyph in Inter
	var RL := preload("res://scripts/ui/radio_line.gd")
	var kev_text := ""
	for r in Words.RADIO:
		if str(r["voice"]) == "kev" and kev_text == "":
			kev_text = str(r["text"])
	rl._queue.clear()
	rl.push(kev_text)
	var kev_parts: Array = rl.next_parts()
	_check(kev_parts.size() == 1 and kev_parts[0][0] == kev_text and kev_parts[0][1] == RL.VOICE["kev"], "Kev's line isn't in Kev's colour: %s" % str(kev_parts))
	# each voice reads against the panel (WCAG 4.5:1); the traffic's grey is meant dim, but not lost (3:1)
	var lum := func(c: Color) -> float:
		var ch := [c.r, c.g, c.b].map(func(x): return x / 12.92 if x <= 0.03928 else pow((x + 0.055) / 1.055, 2.4))
		return 0.2126 * ch[0] + 0.7152 * ch[1] + 0.0722 * ch[2]
	var bg: float = lum.call(Pal.PANEL)
	for v in RL.VOICE:
		var ratio: float = (float(lum.call(RL.VOICE[v])) + 0.05) / (bg + 0.05)
		_check(ratio >= 4.5, "%s's colour on the radio line is %.1f:1 against the panel" % [v, ratio])
	var g_ratio: float = (float(lum.call(RL.GARBLE)) + 0.05) / (bg + 0.05)
	_check(g_ratio >= 3.0, "the traffic's grey is %.1f:1 against the panel" % g_ratio)
	var inter: Font = load("res://fonts/Inter-Medium.ttf")
	var missing := ""
	for ch in RL.GARBLE_GLYPHS:
		if not inter.has_char(ch.unicode_at(0)):
			missing += ch
	_check(missing == "", "garble glyphs Inter can't draw: %s" % missing)
	for open in [false, true]:
		sim.unlocked = unlocked0.filter(func(r): return r != "radio") + (["radio"] if open else [])
		rl._since_garble = 0
		var garbled := 0
		var through := 0
		var stray := ""
		for n in range(60):
			var parts: Array = rl.next_parts()
			var g: bool = parts.any(func(p): return p[1] == RL.GARBLE)
			if g:
				garbled += 1
				for p in parts:
					if p[1] == RL.GARBLE:
						for ch in str(p[0]):
							if ch != " " and not RL.GARBLE_GLYPHS.contains(ch):
								stray += ch
					else:
						through += 1
						var known: bool = Words.RADIO_TRAFFIC.any(func(t): return (" " + str(t["text"]) + " ").contains(" " + str(p[0]) + " "))
						_check(known, "a word through the traffic isn't the traffic's: '%s'" % p[0])
		var want: int = floori(60.0 / (RL.GARBLE_EVERY_OPEN if open else RL.GARBLE_EVERY))
		_check(garbled == want and stray == "" and ((through >= garbled) if open else (through == 0)), "the traffic with the Radio %s: %d garbled of 60 (want %d), %d words through, stray '%s'" % ["open" if open else "shut", garbled, want, through, stray])
	sim.unlocked = unlocked0
	rl._queue.clear()
	# a press - a real click through the strip's input - opens the Radio
	var was: String = main.room
	var click := InputEventMouseButton.new()
	click.button_index = MOUSE_BUTTON_LEFT
	click.pressed = true
	rl._gui_input(click)
	_check(main.room == main.COMMS, "a click on the radio line did not open the Radio")
	main.show_room(was)
	main.refresh()
	# a new camp starts the strip clean
	rl.push("Last camp's line.")
	rl.set_sim(null)
	_check(rl._queue.is_empty() and rl._items.is_empty(), "a new camp's radio line kept the last one's")
	rl.set_sim(sim)
	_check_fit(main, "the radio line")
	print("radio line ok: the second row, the rooms under it, it moves, a line just heard next, no names, a press opens the Radio")


## Codes, not words (13 Oct, Matt): every paper that carries a code says where it's written, first; the Radio and the
## Runs cards say codes, never words (the Fence's word in the right ear is his own); the rail's glyphs and the tin load.
func _codes_checks(main) -> void:
	var sim = main.sim
	for w in Data.WORDS:
		if w.has("paper"):
			var line: String = Words.item_words(str(w["paper"]))
			_check(line.begins_with("A code "), "%s doesn't say where its code is: '%s'" % [w["paper"], line])
	var re := RegEx.new()
	re.compile("(?i)\\bwords?\\b")
	# off the air and on it (the review: the campaign's Radio is the quiet view; the codes show once the depths open)
	var saved: Dictionary = sim.to_dict()
	for on_air in [false, true]:
		if on_air:
			_finish_campaign(sim)
			sim.best_depth[3] = maxi(sim.best_depth[3], 9)
			sim.set_depth(3, 9)
			sim.words[3] = []
			sim.sealed[3] = false
			sim.notes = 100000
			sim.word_craft(3, "tune")
			sim.word_craft(3, "tune")
			_check(sim.juiceable(3) and not sim.words[3].is_empty(), "the codes' check found no site on the air")
			main._radio.selected = 3
			main._radio.view = "air"
		for room in [main.COMMS, main.MISSIONS]:
			main.show_room(room)
			main.refresh()
			var labels := []
			_labels_under(main._radio if room == main.COMMS else main._missions, labels)
			for l in labels:
				_check(re.search(str(l.text)) == null, "%s%s still says word: '%s'" % [room, " (on the air)" if on_air else "", l.text])
			_check_fit(main, "%s (codes%s)" % [room, ", on the air" if on_air else ""])
	sim.load_dict(saved)
	main.refresh()
	for g in main._rail_buttons.values():
		_check(g._glyph.texture != null and not UI.glyph_mono(g.GLYPH_OF[g.room]), "the rail's %s glyph is missing or a line drawing" % g.room)
	_check(main._top_glyphs["cash"].texture != null and not UI.glyph_mono("tins"), "the top bar's tin is missing")
	print("codes ok: the papers say where, no word on the Radio or the cards, the rail's glyphs and the tin")


## The gates (13 Oct, Matt; docs/design/campaign_gates.md): a fresh camp's Clinic, Fence, Yard, Radio and Workshop shut -
## the rail says Shut and won't open them, the sim won't do their jobs; each head drops his thing, home it opens his
## room with a line on the radio before and after; the deeds off the Manager, not the Bank; a death that loses the
## thing brings it back next time; a save from before keeps its rooms; a move keeps them.
func _gates_checks(main) -> void:
	var sim = main.sim
	_check(sim.unlocked.is_empty(), "a fresh camp has rooms open: %s" % str(sim.unlocked))
	main.refresh()
	_check(main.room == main.MISSIONS, "a fresh camp starts in a shut Yard: %s" % main.room)
	for name in [main.MEDIC, main.MARKET, main.OVERVIEW, main.COMMS, main.WORKSHOP]:
		var b = main._rail_buttons[name]
		_check(b.disabled and not b._badge.visible and Fmt.scramble(name).begins_with(b._name.text) and b._name.text != name, "the rail's %s isn't shut and scrambled: '%s'" % [name, b._name.text])     # no "Shut" (20 Oct, Matt)
		main.show_room(name)
		_check(main.room == main.MISSIONS, "a shut %s opened" % name)
	for name in [main.RUNNER, main.ARMOURY, main.MISSIONS, main.BARRACKS]:
		_check(not main._rail_buttons[name].disabled, "%s is shut on a fresh camp" % name)
	_check_fit(main, "the Map (a fresh camp, the rooms shut)")
	sim.hp = sim.max_hp() * 0.5
	sim.cash = 100000.0
	var spare: Dictionary = sim._plain("Helmet", "Hard hat")
	sim.stash_put(spare)
	_check(not sim.can_heal() and not sim.sell(spare) and not sim.buy(0) and not sim.can_word_craft(3, "tune") and sim.yard_pick_block("bench", 0, "a") == "The Yard opens with the Manager's deeds" and not sim.can_craft(spare["id"], "affixes"), "a shut room's job was done")
	# the Yard open before the rooms its buildings serve: those wait on their rooms (the review)
	sim.unlocked = ["yard"]
	_check(sim.yard_pick_block("clinic", 0, "a").begins_with("Opens with") and sim.yard_pick_block("bench", 0, "a").begins_with("Opens with") and not sim.yard_pick_block("stash", 0, "a").begins_with("Opens with"), "a building for a shut room could be built: %s" % sim.yard_pick_block("clinic", 0, "a"))
	sim.unlocked = []
	# each head: his site open says the line before; down, his thing in the pack; home, the room and the line after
	for b in Data.BOSSES:
		var bt: int = int(b["tier"])
		for i in range(bt + 1):
			sim.best_depth[i] = maxi(sim.best_depth[i], 1)
		for z in range(int(b["zone"])):
			sim.bosses_beaten[z] = true
		var before_heard: int = sim.heard.size()
		sim.runs_total = 1
		sim._radio_after_run()
		var said_before: bool = sim.heard.size() > before_heard and str(sim.events.back()[1]).begins_with(Words.RADIO_LEAD)
		_check(said_before or b["opens"].is_empty(), "%s's line before wasn't said with his site open" % b["name"])     # a head who opens no room (the Carpet Man, 24 Oct) has his class instead
		sim.hp = sim.max_hp()
		sim.boss_armed[bt] = true
		sim.deploy(bt)
		sim.mission["cleared"] = true
		_check(sim.on_mission() and sim.mission.has("boss") and str(sim.mission["boss"]["name"]) == str(b["name"]), "%s didn't come out" % b["name"])
		if not (sim.on_mission() and sim.mission.has("boss")):
			continue
		var heard_before: int = sim.heard.size()
		sim._boss_down(sim.mission, sim.mission["t"])
		for room in b["opens"]:
			_check(sim.room_open(str(room)), "%s's %s didn't open the %s at the drop" % [b["name"], b["opens"][room], room])
		var things: Array = sim.mission["found"].filter(func(it): return Items.opens(it) != "")
		_check(things.size() == b["opens"].size(), "%s's things in the pack: %d of %d (the deeds, and the keepsakes since 15 Oct)" % [b["name"], things.size(), b["opens"].size()])
		for th in things:
			_check(Items.is_deeds(th) or str(th["base"]) in sim.keepsakes, "%s's %s isn't a keepsake" % [b["name"], th["base"]])
		sim.extract_now()
		_check(sim.heard.size() > heard_before or b["opens"].is_empty(), "%s's line after wasn't said" % b["name"])
		var opened_cls: Array = Words.CLASS_UNLOCK.keys().filter(func(nm): return sim.class_open(nm))
		_check(sim.events.any(func(e): return opened_cls.any(func(nm): return str(e[1]) == str(Words.CLASS_UNLOCK[nm]["line"]))) or b["zone"] > 3, "%s down: no class's arrival said (%s open)" % [b["name"], str(opened_cls)])
	_check(sim.unlocked.size() == Data.ROOMS_SHUT.size() and sim.stash.any(func(it): return Items.is_deeds(it)), "not every room opened, or the deeds didn't come home: %s" % str(sim.unlocked))
	_check(sim.stash.all(func(it): return Items.opens(it) == "" or Items.is_deeds(it)), "a head's thing other than the deeds was stashed")
	main.refresh()
	for name in [main.MEDIC, main.MARKET, main.OVERVIEW, main.COMMS, main.WORKSHOP]:
		_check(not main._rail_buttons[name].disabled and main._rail_buttons[name]._name.text == name, "the rail's %s is still shut or scrambled: '%s'" % [name, main._rail_buttons[name]._name.text])
	# a save from before the gates keeps every room; a save with them keeps what it has; a move keeps them
	var d: Dictionary = sim.to_dict()
	d.erase("unlocked")
	var old = load("res://scripts/sim/sim.gd").new()
	old.load_dict(d)
	_check(old.unlocked.size() == Data.ROOMS_SHUT.size(), "a save from before the gates lost its rooms")
	var fresh = load("res://scripts/sim/sim.gd").new()
	fresh.start()
	fresh.unlocked = ["clinic"]
	var back = load("res://scripts/sim/sim.gd").new()
	back.load_dict(fresh.to_dict())
	_check(back.unlocked == ["clinic"], "the rooms opened didn't survive a save: %s" % str(back.unlocked))
	_check(not ("The vet's bag" in sim.book_pages()) and not ("The deeds" in sim.book_pages()), "a head's thing is a page in the drawer")
	# the ammo trap (13 Oct): with the Fence shut, a gun with no rounds to hand is no upgrade, and one with them is read fed;
	# a gun found while it's shut comes with a box of its own rounds
	var dry = load("res://scripts/sim/sim.gd").new()
	dry.start()
	_set_cls(dry, "Doorman")
	var rifle: Dictionary = dry._plain("Primary", "Garage-built rifle")
	dry.stash_put(rifle)
	_check(dry.compare(rifle) != 1, "a rifle with no rounds anywhere reads better than the fed nail gun")
	var box: Dictionary = dry.ammo_box(Items.ammo_type(rifle))
	dry.stash_put(dry._plain(Data.AMMO, str(box["name"])))
	_check(dry.compare(rifle) == 1, "a rifle with its rounds in the stash doesn't read better than the nail gun: %d" % dry.compare(rifle))
	_check(dry.equip_best("Primary") and dry.equipped["Primary"]["id"] == rifle["id"] and dry.has_rounds(rifle), "Equip if better put the rifle on without its rounds in the rig")
	dry.hp = dry.max_hp()
	var bags: Array = Data.BASES["Backpack"].duplicate()
	bags.sort_custom(func(x, y): return float(x.get("cells", x.get("capacity", 0))) > float(y.get("cells", y.get("capacity", 0))))
	dry.equipped["Backpack"] = dry._plain("Backpack", str(bags[0]["name"]))     # room for the box: a full pack passes it over (19 Oct, a flake)
	dry.deploy(0)
	var guns := 0
	var boxed := true
	for k in range(400):
		var before: Array = dry.mission["found"].duplicate()
		dry.mission["found"] = []
		var worn_ids: Array = ["Primary", "Secondary"].map(func(sl): return int(dry.equipped[sl]["id"]) if dry.equipped[sl] != null else -1)
		dry._find(dry.mission, dry.mission["t"])
		for f in dry.mission["found"]:
			if int(f["id"]) in worn_ids:
				continue                       # the gun a find swapped off him: his own, not a find (a flake, 25 Oct)
			if (f["slot"] == "Primary" or f["slot"] == "Secondary") and not (Items.ammo_type(f) in ["", "none"]):
				guns += 1
				boxed = boxed and dry.mission["found"].any(func(x): return Items.is_ammo(x) and Items.base_of(x)["type"] == Items.ammo_type(f))
		dry.mission["found"] = before
	_check(guns > 0 and boxed, "a gun found with the Fence shut came without its rounds (%d guns, pack %d of %d)" % [guns, dry.pack_used(dry.mission), dry.capacity()])
	dry.extract_now()
	print("gates ok: shut on a fresh camp, the rail, the jobs, each head's thing, the lines, the deeds off the Manager, saves")
	main.new_game()                              # the rest of the smoke starts from a fresh camp, as it always did
	main.sim.mythics_on = false            # the smoke's camps find no mythics on their own (17 Oct: a full pack keeps one now - a bot's Bomb Disposal Suit stopped the clock, its moment held the game); the mythics' own checks make theirs
	_open_camp(main.sim)


## The smoke's camps as they were before the gates (13 Oct): every room open, and the Outskirts' head counted down, so
## the Estate waits only on the Outskirts' sites as the older checks expect. The gates' own check runs on a shut camp.
func _open_camp(sim) -> void:
	sim.unlock_all()
	sim.bosses_beaten[0] = true


## The rooms' first-visit cards (14 Oct, docs/design/room_intros.md).
func _room_intro_checks(main) -> void:
	var sim = main.sim
	var room0: String = main.room
	_check(main.ROOM_INTRO_KEY.size() == main.ROOMS.size() and Words.ROOM_INTROS.size() == main.ROOMS.size(), "a room has no card, or a card no room")
	# every card: its lines and tiles, its words inside their boxes, its art
	var arts := 0
	var strips := 0
	var owns := 0
	for k in Words.ROOM_INTROS.keys():
		var d_in: Dictionary = Words.ROOM_INTROS[k]
		var c = main.RoomIntro.new(k)
		main.add_child(c)
		c._place(Vector2(1920, 1080))
		_check(d_in["lines"].size() >= 1 and d_in["lines"].size() <= c._lines.size() and d_in["tiles"].size() == 3, "%s's card has %d lines and %d tiles" % [k, d_in["lines"].size(), d_in["tiles"].size()])
		if c._art.texture != null:
			arts += 1
		for l in c._lines:
			l.modulate.a = 1.0
		_check(_check_nodes(c.text_nodes(), [], "%s's card" % k) == 0, "%s's card has words out of their boxes" % k)
		_check(c._kicker.position.x + UI.text_width(c._title, c._title.text) <= c._card.size.x - c.PAD, "%s's card's title runs off it" % k)
		# the boxes' strips (18 Oct, option C): the words under the strip, the boxes clear of the last line and of the foot,
		# the card inside a 1080 screen; a strip made is a strip shown
		var last_line: Control = c._lines[c._lines.size() - 1]
		for ti in range(c._tiles.size()):
			var t: Array = c._tiles[ti]
			_check(t[1].position.y >= c.STRIP_H, "%s's box %d has its heading over its strip" % [k, ti + 1])
			_check(t[2].position.y + t[2].size.y <= t[0].size.y, "%s's box %d has its words out of the box" % [k, ti + 1])
			_check(t[0].position.y >= last_line.position.y + last_line.size.y, "%s's box %d sits over the card's lines" % [k, ti + 1])
			_check(t[0].position.y + t[0].size.y <= c._hint.position.y and t[0].position.y + t[0].size.y <= c._go_on.position.y, "%s's box %d runs into the card's foot" % [k, ti + 1])
			if t[3].texture != null:
				strips += 1
				var reg: Rect2 = (t[3].texture as AtlasTexture).region
				var src: Texture2D = (t[3].texture as AtlasTexture).atlas
				_check(reg.position.x >= 0 and reg.position.y >= 0 and reg.end.x <= src.get_width() + 0.5 and reg.end.y <= src.get_height() + 0.5, "%s's box %d cuts its strip off the edge of its art" % [k, ti + 1])
				_check(absf(reg.size.x / reg.size.y - t[3].size.x / t[3].size.y) < 0.05, "%s's box %d's strip is stretched" % [k, ti + 1])
				# its own picture when made (19 Oct): that's the atlas, cut across its middle
				var own_pic = c.art_texture("room_boxes/%s_%d" % [k, ti + 1])
				if own_pic != null:
					owns += 1
					_check(src == own_pic and absf(reg.get_center().y - src.get_height() / 2.0) <= 1.0, "%s's box %d doesn't show its own picture across the middle" % [k, ti + 1])
		_check(c._card.position.y >= 0 and c._card.position.y + c._card.size.y <= 1080, "%s's card doesn't fit a 1080 screen" % k)
		c.finish()
	print("room cards: %d of %d have their art; %d of 27 boxes have their strip, %d their own picture" % [arts, Words.ROOM_INTROS.size(), strips, owns])
	_check(strips == 27 or arts < Words.ROOM_INTROS.size(), "only %d of the 27 boxes show a strip" % strips)
	# Go on is a button of its own: it lights under the mouse and takes the click, once (Matt: "no visual register")
	var gc = main.RoomIntro.new("clinic")
	main.add_child(gc)
	gc._place(Vector2(1920, 1080))
	gc._process(0.01)
	_check(gc._go_on.mouse_filter == Control.MOUSE_FILTER_STOP and gc._go_on.pressed.is_connected(gc.advance), "Go on doesn't take its own clicks")
	var on_btn := InputEventMouseButton.new()
	on_btn.button_index = MOUSE_BUTTON_LEFT
	on_btn.pressed = true
	on_btn.position = gc._go_on.get_global_rect().get_center()
	gc._input(on_btn)
	_check(gc.shown == 1, "a press on Go on was taken by the card as well as the button")
	gc._go_on.pressed.emit()
	_check(gc.shown == 2, "Go on's press didn't move the card on")
	on_btn.position = Vector2(gc._card.position.x + 60, gc._card.position.y + 60)
	gc._input(on_btn)
	_check(gc.shown == 3, "a click on the card away from Go on didn't move it on")
	gc.finish()
	# the takes: a cue a line, in order, inside the take; the lines come up as they're said
	var voiced := 0
	for k in Words.ROOM_INTROS.keys():
		var d_in: Dictionary = Words.ROOM_INTROS[k]
		_check(d_in.has("cues") and d_in["cues"].size() == d_in["lines"].size(), "%s's card's cues aren't one a line" % k)
		for i in range(1, d_in.get("cues", []).size()):
			_check(float(d_in["cues"][i]) > float(d_in["cues"][i - 1]), "%s's card's cues go backwards" % k)
		var c = main.RoomIntro.new(k)
		if c.voiced():
			voiced += 1
			_check(float(d_in["cues"].back()) < c._vlen, "%s's last cue is past its take (%.1f s)" % [k, c._vlen])
			c._process(0.05)
			_check(c.shown == 1, "%s's first line isn't up as it's said" % k)
			if d_in["lines"].size() > 1:
				c._process(float(d_in["cues"][1]) - 0.3)
				_check(c.shown == 1, "%s's second line came up before it's said" % k)
				c._process(0.4)
				_check(c.shown == 2, "%s's second line didn't come up as it's said" % k)
		c.free()
	print("room cards: %d of %d have their take" % [voiced, Words.ROOM_INTROS.size()])
	# a class's card when it opens (25 Oct, Matt: every unlock a story beat): its lines fit, its tiles are Training's
	# card lines, its face and place drawn; once a class, back at camp, then Training
	var RI = load("res://scripts/ui/room_intro.gd")
	for c in Data.CLASSES:
		var cn: String = str(c["name"])
		if not Words.CLASS_CARDS.has(cn):
			continue
		var cc = RI.new("class:" + cn)
		main.add_child(cc)
		cc._process(0.01)
		for l in cc._lines:
			_check(UI.text_width(l, l.text) <= l.size.x + 0.5, "%s's card line runs off: '%s'" % [cn, l.text])
		var shorts: Array = c.get("short", []).map(func(x): return str(x[0]))
		for k in range(mini(3, shorts.size())):
			_check(cc._tiles[k][2].text == shorts[k], "%s's tile %d reads '%s', not Training's '%s'" % [cn, k + 1, cc._tiles[k][2].text, shorts[k]])
		for tl in cc._tiles:
			_check(UI.text_width(tl[2], tl[2].text) <= tl[2].size.x + 0.5, "%s's tile runs off: '%s'" % [cn, tl[2].text])
		_check(cc._face.visible and cc._art.texture != null and cc._go_on.text == Words.CLASS_CARD["go"], "%s's card has no face, no place or the wrong button" % cn)
		cc.free()
	var met_was: Array = sim.met.duplicate()
	sim.met = sim.met.filter(func(x): return not str(x).begins_with("class:"))
	if sim.on_mission():
		sim.extract_now()
	var seen_cls: Array = []
	for n in range(6):
		var due: String = main.class_card_due()
		if due == "":
			break
		main.show_class_card(due)
		_check(main._room_card != null and main._room_card.key == "class:" + due, "%s's card didn't come up" % due)
		if n == 0:
			_check_fit(main, "a class's card (%s)" % due)
		seen_cls.append(due)
		if main._room_card != null:
			main._room_card.finish()
	var open_n: int = Words.CLASS_CARDS.keys().filter(func(x): return sim.class_open(str(x))).size()
	_check(seen_cls.size() == open_n and open_n > 0 and main.room == main.BARRACKS, "the class cards: %s of %d open, then the room %s" % [str(seen_cls), open_n, main.room])
	_check(main.class_card_due() == "", "a class's card came up twice")
	# with the rooms' intros off, a class's card still comes (Matt, 25 Oct: a story beat, not a tutorial)
	var ri_was: bool = main.room_intros
	var intro_was: bool = main.intro
	var one: String = str(seen_cls[0]) if not seen_cls.is_empty() else ""
	if one != "":
		var met2: Array = sim.met.duplicate()
		sim.met.erase("class:" + one)
		if not ("air" in sim.met):
			sim.met.append("air")              # On the air had its turn: the class's card is what's tested
		main.room_intros = false
		main.intro = true
		main.refresh()
		_check(main._room_card != null and main._room_card.key == "class:" + one, "with the rooms' intros off, %s's card didn't come" % one)
		if main._room_card != null:
			main._room_card.finish()
		if main._opening != null and is_instance_valid(main._opening):
			main._opening.finish()
		sim.met = met2
	main.room_intros = ri_was
	main.intro = intro_was
	sim.met = met_was
	# the tests' camps (intro off) never see one
	sim.met = ["air"]                          # every room open here: On the air (the Radio's) has had its turn
	for cn2 in Words.CLASS_CARDS:
		sim.met.append("class:" + cn2)         # and every class's card met, so the rooms' cards are what's tested here
	main.show_room(main.ARMOURY)
	_check(main._room_card == null, "a room's card came up with the intros off")
	# a first visit: the card, the room met, the game held
	main.intro = true
	main.show_room(main.RUNNER)
	main.show_room(main.ARMOURY)
	var card = main._room_card
	_check(card != null and card.key == "stats", "a first visit to Stats brought no card (or the wrong one): %s" % (card.key if card != null else "none"))
	_check("stats" in sim.met, "the card's room wasn't counted met")
	var t0: float = sim.elapsed
	main._process(0.5)
	_check(is_equal_approx(sim.elapsed, t0), "the game ran under a room's card")
	if card != null:
		card._process(0.01)
		_check(card.shown == 1, "the card's first line isn't up at once: %d" % card.shown)

		while card.shown < card.total():
			card.advance()
		_check(card.shown == card.total() and main._room_card == card, "a press closed the card before its lines were up")
		card.advance()
	_check(main._room_card != null and main._room_card.key == "kit", "after Stats' card, the Kit's (where the player went) didn't follow")
	if main._room_card != null:
		main._room_card.finish()
	_check(main._room_card == null, "the card didn't let go")
	main._process(0.5)
	_check(sim.elapsed > t0, "the game didn't run on after the card")
	# met: no card the second time; the top bar's ? brings it back; Esc closes it
	main.show_room(main.RUNNER)
	_check(main._room_card == null, "a met room's card came up again")
	main._help_btn.pressed.emit()
	_check(main._room_card != null and main._room_card.key == "stats", "the ? didn't bring the room's card back")
	var esc := InputEventKey.new()
	esc.keycode = KEY_ESCAPE
	esc.pressed = true
	if main._room_card != null:
		main._room_card._input(esc)
	_check(main._room_card == null, "Esc didn't close the card")
	main._unhandled_input(esc)
	_check(not main._menu.visible, "the Esc that shut a room's card opened the pause too")
	if main._menu.visible:
		main._menu.close()
	var head_w: float = UI.text_width(main._rail_head, main._rail_head.text)
	_check(main._help_btn.position.x >= main._rail_head.position.x + head_w + 16 and main._help_btn.position.x + main._help_btn.size.x <= Pal.RAIL_W, "the ? isn't clear of the rail's heading, inside the rail")
	# not over a menu: it waits till the menu's gone
	sim.met.erase("kit")
	main.show_pause()
	main.show_room(main.ARMOURY)
	_check(main._room_card == null, "a room's card came up over the pause")
	main._menu.close()
	main.refresh()
	_check(main._room_card != null and main._room_card.key == "kit", "the card didn't come up once the menu went")
	if main._room_card != null:
		main._room_card.finish()
	# a save from before the cards has met what it has open
	var d: Dictionary = sim.to_dict()
	d.erase("met")
	sim.load_dict(d)
	var all_in := true
	for k in Words.ROOM_INTRO_FIRST + sim.unlocked:
		all_in = all_in and (k in sim.met)
	_check(all_in, "an old save's open rooms weren't counted met: %s" % str(sim.met))
	_check(sim.to_dict().has("met"), "the save doesn't keep the rooms met")
	for cn3 in Words.CLASS_CARDS:
		if not ("class:" + cn3) in sim.met:
			sim.met.append("class:" + cn3)     # the classes' cards had their turn above: On the air's and the opening's tested alone
	# a new camp: the opening alone, the Map's card only once it's done (14 Oct, Matt: the Map's take under the opening)
	var old_sim = main.sim
	main.new_game()
	main.sim.mythics_on = false            # the smoke's camps find no mythics on their own (17 Oct: a full pack keeps one now - a bot's Bomb Disposal Suit stopped the clock, its moment held the game); the mythics' own checks make theirs
	_check(main._opening != null and main._room_card == null, "a room's card came up with the opening on a new camp")
	if main._opening != null:
		main._opening.finish()
	_check(main._room_card != null and main._room_card.key == "map", "the Map's card didn't follow the opening")
	if main._room_card != null:
		main._room_card.finish()
	main.sim = old_sim
	main.save_game()
	sim = main.sim
	# On the air: the Radio open at home with neither it nor its card met - Kev's scenes, once; not on a run; never for
	# a save that's met the Radio (it had the set before they were made)
	var met0: Array = sim.met.duplicate()
	var unlocked0: Array = sim.unlocked.duplicate()
	sim.met = sim.met.filter(func(x): return x != "air" and x != "radio")
	if not ("radio" in sim.unlocked):
		sim.unlocked.append("radio")
	if sim.on_mission():
		sim.extract_now()
	main.refresh()
	_check(main._opening != null and main._opening.scenes == Words.AIR_SCENES and "air" in sim.met, "the Radio open at home didn't play On the air")
	var t_air: float = sim.elapsed
	main._process(0.5)
	_check(is_equal_approx(sim.elapsed, t_air), "the game ran under On the air")
	if main._opening != null:
		main._opening.finish()
	if main._room_card != null:
		main._room_card.finish()
	main.refresh()
	_check(main._opening == null, "On the air came back after it was done")
	sim.met = sim.met.filter(func(x): return x != "air")
	sim.met.append("radio")
	main.refresh()
	_check(main._opening == null, "On the air played for a camp that had met the Radio")
	sim.met = sim.met.filter(func(x): return x != "radio")
	sim.hp = sim.max_hp()
	sim.deploy(0)
	main.refresh()
	_check(main._opening == null, "On the air played on a run")
	sim.extract_now()
	if main._opening != null:
		main._opening.finish()
	if main._room_card != null:
		main._room_card.finish()
	sim.met = met0
	sim.unlocked = unlocked0
	main.intro = false
	main.show_room(room0)
	print("room cards ok: each fits, a first visit, held and let go, met once, the ?, Esc, not over a menu, old saves, after the opening, On the air")


## The words (18 Oct, the language pass, docs/language/style_guide.md): the mechanics lines in the data say each thing
## by its one name and with figures; every room, every label showing, has no depth (Matt's call: levels only), no
## camp, no Boss, no letter-spaced kicker, no format code left unfilled, no spaced hyphen.
const WORDS_BANNED := ["cash", "operator", "boss", "health", "ammo", "faster", "cache", "dots", "first shot", "first hit",
		"quarter", "a third", "a fifth", "a tenth", "half again", "depth", "camp", "one head"]
const WORDS_SCREEN_BANNED := ["depth", "camp", "Boss", "pouchs", "1 finds", " - ", "damage/s", "Gear level", "loadout", "Loadout"]     # 25 Oct, the review: the style guide's slips
func _words_checks(main) -> void:
	var rx := RegEx.new()
	rx.compile("(?i)\\b(" + "|".join(WORDS_BANNED) + ")\\b")
	var lines := []                         # [where, text]
	for t in Data.TREES + Data.ELEMENT_TREES:
		for nd in t["nodes"]:
			if nd.has("words"):
				lines.append(["%s / %s" % [t["name"], nd["name"]], str(nd["words"])])
	for u in Data.UNIQUES:
		for k in ["words", "short"]:
			if u.has(k):
				lines.append([str(u["name"]), str(u[k])])
	for a in Data.AFFIXES:
		lines.append([str(a["stat"]), str(a["label"])])
	for y in Data.YARD:
		if y.has("words"):
			lines.append([str(y.get("name", "")), str(y["words"])])
	for at in Data.ATLAS:
		if at.has("sentence"):
			lines.append([str(at.get("name", "")), str(at["sentence"])])
	for l in lines:
		var m := rx.search(l[1])
		_check(m == null, "the mechanics line of %s says \"%s\": %s" % [l[0], m.get_string() if m != null else "", l[1]])
	var sim = main.sim
	var was: String = main.room
	sim.unlock_all()
	var kicker := RegEx.new()
	kicker.compile("^([A-Z] ){3,}[A-Z]")
	var fmt := RegEx.new()
	fmt.compile("%[-0-9.]*[sdf]")
	for r in main.ROOMS:
		main.show_room(r)
		main.refresh()
		for n in main.find_children("*", "Control", true, false):
			if not (n is Label or n is Button) or not _shown(n):     # 20 Oct: is_visible_in_tree is false out of the tree, so this sweep read nothing
				continue
			var t: String = n.text
			if t == "":
				continue
			for b in WORDS_SCREEN_BANNED:
				var hit: bool = (t.find(b) >= 0) if b == "Boss" or b.begins_with(" ") or b.contains(" ") else (t.to_lower().find(b) >= 0)
				_check(not hit, "%s shows \"%s\" (%s): %s" % [r, b, n.name, t])
			_check(kicker.search(t) == null, "%s has a letter-spaced kicker: %s" % [r, t])
			_check(fmt.search(t) == null, "%s shows an unfilled format code: %s" % [r, t])
	# the decoder with two papers in: the note says what decrypting does, not "Put three papers in" (18 Oct: a words
	# change once broke the match; decrypt_block and the Radio share Sim.DECRYPT_NEEDS_PAPERS now)
	if sim.campaign_done() and sim.signals.size() < Data.SIGNALS_HELD:
		main.show_room(main.COMMS)
		main._radio.chosen = []
		main._radio._shown = ""
		main.refresh()
		_check(sim.decrypt_block([]) == sim.DECRYPT_NEEDS_PAPERS and main._radio._decrypt_note.text.begins_with("Decrypting"), "none in, the decoder note reads '%s'" % main._radio._decrypt_note.text)
		# one paper in (20 Oct): the decoder says Faint, the empty slots are optional, and it reads under the reach
		var plain: Array = sim.signal_papers().filter(func(x): return sim.story_of(x) < 0)
		var reach_ui: int = sim.reach
		sim.reach = 20                        # past the first reach, where a faint band can't go under it
		if not plain.is_empty():
			main._radio.chosen = [int(plain[0]["id"])]
			main._radio._shown = ""
			main.refresh()
			var rd = main._radio
			_check(rd._make_head.text.contains("FAINT") and rd._slots[1]["n"].text.contains("optional") and rd._slots[2]["n"].text.contains("optional")
				and rd._make_sub2.text.begins_with("Never moves your reach") and rd._decrypt.text == "Decrypt · 1 paper" and not rd._decrypt.disabled,
				"one paper in, the decoder reads '%s' / '%s' / '%s' / '%s'" % [rd._make_head.text, rd._slots[1]["n"].text, rd._make_sub2.text, rd._decrypt.text])
		sim.reach = reach_ui
		main._radio.chosen = []
	main.show_room(was)
	main.refresh()


## Watch rota and Second dog do their own things (18 Oct, Matt on Q4: they copied Tripwires and A dog): the rota only
## at night, the second dog in the search time, not the finds.
func _yard_own_checks(sim) -> void:
	var el0: float = sim.elapsed
	var picks0: Dictionary = sim.yard_picks.duplicate(true)
	var t: Dictionary = sim.effective(3)
	sim.elapsed = 3600.0 * 5.0               # 14:00, day
	var day0: float = sim.yard_patrol()
	_yard_set(sim, "lookout", 3, "b")
	_check(sim.yard_has("watch_rota") and is_equal_approx(sim.yard_patrol(), day0), "the Watch rota changed a day's gangs")
	sim.elapsed = 3600.0 * 14.0              # 23:00, night
	_check(sim.is_night() and is_equal_approx(sim.yard_patrol(), day0 * Data.FX["yard/watch_rota"]), "the Watch rota did not hold a night's gangs back: %.3f of %.3f" % [sim.yard_patrol(), day0])
	var s0: float = sim.search_s(t)
	_yard_set(sim, "kennel", 2, "b")
	_check(sim.yard_has("second_dog") and is_equal_approx(sim.search_s(t), s0 * Data.FX["yard/second_dog"]), "the Second dog did not quicken the search: %.2f from %.2f" % [sim.search_s(t), s0])
	# the wound reads its real cut (Q7): Physio takes a third off
	var w0: Dictionary = sim.wounds.duplicate(true)
	sim.wounds = {"legs": {"stat": "pace", "what": "a bad ankle", "from": "The Parade", "hp_pct": 20}}
	_check(sim.wound_pct() == Data.WOUND_PCT, "a wound reads %d%%, not %d%%" % [sim.wound_pct(), Data.WOUND_PCT])
	_yard_set(sim, "clinic", 2, "b")         # Physio: the Clinic's third column, side b
	_check(not sim.yard_has("physio") or sim.wound_pct() == int(round(Data.WOUND_PCT * 2.0 / 3.0)), "with Physio a wound reads %d%%" % sim.wound_pct())
	sim.wounds = w0
	sim.yard_picks = picks0
	sim._yard_dirty = true
	sim.elapsed = el0
	# the Weather set halves Fog's one fewer to one, not none (Q6)
	_check(int(sim._softened({"contact": -1}, 0.5)["contact"]) == -1 and int(sim._softened({"contact": 2}, 0.5)["contact"]) == 1, "the Weather set rounds a gang's one to nothing")
	# the Spare Key spends no rounds (Q5)
	var key_it: Dictionary = Items.roll_unique(sim._unique_named("The Spare Key"), sim.rng)
	_check(Items.free_rounds(key_it) and Items.ammo_words(key_it) == "Takes no rounds" and sim.has_rounds(key_it), "the Spare Key wants rounds")


## The rebuild (18 Oct, docs/design/rebuild.md; Matt: "go with your picks and build it up - no balance yet"): shut till
## Kev's story is done; a place's costs, ranks and what it does; materials home whatever happens and through a move and
## a save; the order's pinnacles open on their rebuild, run as signals, drop their things; the town view and the order
## tab fit, every chip shown.
func _rebuild_checks(main) -> void:
	var s = Sim.new()
	s.start()
	s.mythics_on = false
	_open_camp(s)
	for z in range(Data.ZONES.size()):
		s.bosses_beaten[z] = true
		for i in Data.ZONES[z]["tiers"]:
			s.best_depth[i] = 1
	_check(s.campaign_done(), "the fixture: the campaign is not done")
	_check(not s.rebuild_open() and s.rebuild_block("substation") == "After Kev's story", "the rebuild opens before Kev's story: '%s'" % s.rebuild_block("substation"))
	s.story_beat = Data.STORY_BEATS.size()
	var c1: Dictionary = s.rebuild_cost("substation")
	_check(c1 == {"copper_wire": 20, "cable_drums": 10}, "the substation's first build wants %s" % str(c1))
	_check(s.rebuild_block("substation").begins_with("Short of"), "the substation builds with nothing held")
	s.materials = {"copper_wire": 100, "cable_drums": 100, "paving": 100, "glass": 100, "ledgers": 200, "army_kit": 100, "fuses": 50}
	var rest0: float = s.rest_rate()
	var med0: int = s.med_price(Items.base_named(Data.MEDICAL, "Bandage"))
	var stock0: int = s.market_stock()
	var paper0: float = s.paper_odds(8)
	_check(s.rebuild_place("substation") and s.rebuild_rank("substation") == 1 and s.town_worth() == 1 and int(s.materials["copper_wire"]) == 80 and int(s.materials["cable_drums"]) == 90,
		"the substation's build: rank %d, worth %d, %s" % [s.rebuild_rank("substation"), s.town_worth(), str(s.materials)])
	_check(s.order_open("grid") and not s.order_open("archive") and s.town_stat("night_feet") == 1.0, "the substation did not open the Grid, or keep night's pace")
	var c2: Dictionary = s.rebuild_cost("substation")
	_check(int(c2.get("fuses", 0)) == Data.REBUILD_FUSES and int(c2["copper_wire"]) == int(round(20 * Data.REBUILD_GROWTH)) and not c2.has("grid_key"), "rank 2 wants %s" % str(c2))
	s.rebuild_place("substation")
	var c3: Dictionary = s.rebuild_cost("substation")
	_check(int(c3.get("grid_key", 0)) == 1 and int(c3["fuses"]) == 2 * Data.REBUILD_FUSES, "rank 3 wants %s" % str(c3))
	_check(s.rebuild_block("substation") == "Short of the Grid's key", "rank 3 without the Grid's key: '%s'" % s.rebuild_block("substation"))
	var cm: Dictionary = s.rebuild_cost("mint")
	_check(int(cm.get("grid_key", 0)) == 1 and int(cm.get("fuses", 0)) == 5, "the mint's first build wants %s" % str(cm))
	for k in ["pumping", "library", "market_hall"]:
		_check(s.rebuild_place(k), "%s would not build: %s" % [k, s.rebuild_block(k)])
	_check(is_equal_approx(s.rest_rate(), rest0 * 1.5), "the pumping station's rest: %.3f from %.3f" % [s.rest_rate(), rest0])
	_check(s.med_price(Items.base_named(Data.MEDICAL, "Bandage")) < med0 or med0 <= 5, "the pumping station left the Clinic's prices")
	_check(s.market_stock() == stock0 + 1, "the market hall's shelf: %d from %d" % [s.market_stock(), stock0])
	_check(is_equal_approx(s.paper_odds(8), paper0 * 1.25), "the library's papers: %.4f from %.4f" % [s.paper_odds(8), paper0])
	_check(s.mint_tins() == 0.0, "the town pays before the mint")
	s.key_items["grid_key"] = 1
	_check(s.rebuild_place("mint") and int(s.key_items.get("grid_key", 0)) == 0 and s.mint_tins() > 0.0 and s.order_open("mint"), "the mint: %s, %.1f tins" % [s.rebuild_block("mint"), s.mint_tins()])
	var tins: float = s.mint_tins()
	s.key_items["fiat_note"] = 1
	_check(is_equal_approx(s.mint_tins(), tins), "the FIAT note still doubles the mint: the Issue is its job now (25 Oct)")
	for k in ["substation", "pumping", "bus_depot", "library", "market_hall", "mint"]:
		_check(not s.rebuild_words(k, 1).is_empty(), "%s has no words" % k)
	# materials: a head's handful and the run's roll home, death included
	var m := {"tier": 3, "kills": 1, "materials": {"glass": 2}, "found": []}
	var g0: int = s.held_of("glass")
	s._bank_materials(m)
	_check(s.held_of("glass") == g0 + 2, "the run's materials did not come home: %d from %d" % [s.held_of("glass"), g0])
	_check(Data.SITE_MATERIAL.size() == Data.TIERS.size() and s.material_at(0) == "" and s.material_at(3) == "copper_wire" and s.material_odds(0) == 0.0 and is_equal_approx(s.material_odds(3), Data.MATERIAL_RUN), "the sites' materials are off")
	# a signal brings its crew's area's two, the one held fewer of the likelier (20 Oct, Matt: flooded in some, none of others)
	var mat_was: Dictionary = s.materials.duplicate()
	s.materials["copper_wire"] = 14
	s.materials["paving"] = 3
	var msg := {"id": 999, "site": 9, "zone": 1, "depth": 4, "codes": [], "papers": [], "head": false, "convoy": false, "line": 0}
	s._sig_on(msg)
	var split: Dictionary = s.material_split(9)
	s._sig_off()
	_check(split.size() == 2 and split.has("paving") and split.has("copper_wire") and float(split["paving"]) > float(split["copper_wire"]) and is_equal_approx(float(split["paving"]) + float(split["copper_wire"]), 1.0),
		"a signal with the Estate's crew on the Services brings %s" % str(split))
	var tally := {}
	s._sig_on(msg)
	for n in range(400):
		var mk: String = s.material_at(9)
		tally[mk] = int(tally.get(mk, 0)) + 1
	s._sig_off()
	_check(int(tally.get("paving", 0)) > int(tally.get("copper_wire", 0)) and tally.size() == 2, "400 rolls of the Estate's two: %s" % str(tally))
	s.materials = mat_was
	s.deploy(3)
	_check(s.mission != null, "the fixture: no run to die on")
	if s.mission != null:
		s.mission["materials"] = {"paving": 3}
		var p0: int = s.held_of("paving")
		s._kia()
		_check(s.held_of("paving") == p0 + 3, "a death cost the run's materials: %d from %d" % [s.held_of("paving"), p0])
	# the save and the move keep it
	var d: Dictionary = s.to_dict()
	var s2 = Sim.new()
	s2.load_dict(JSON.parse_string(JSON.stringify(d)))
	_check(s2.rebuilt == s.rebuilt and s2.materials == s.materials and s2.key_items == s.key_items and s2.town_worth() == s.town_worth(), "the save lost the rebuild: %s / %s" % [str(s2.rebuilt), str(s2.materials)])
	# the order: a pinnacle as a signal, its head its own, its drops home
	s.reach = 20
	var lv: int = s.order_level("grid")
	_check(int(s.order_beaten.get("grid", 0)) == 0 and lv == int(Data.pinnacle("grid")["level"]), "the Grid's first level %d, not its set %d" % [lv, int(Data.pinnacle("grid")["level"])])     # a set level for the first win (26 Oct)
	_check(int(s.order_beaten.get("archive", 0)) == 0 and s.order_level("archive") == int(Data.pinnacle("archive")["level"]), "the Archive's first level %d, not its set 40" % s.order_level("archive"))
	var e: Dictionary = s.order_read("grid")
	_check(e.has("boss") and str(e["boss"].get("order", "")) == "grid" and str(e["boss"]["name"]) == "The Lineman" and e["name"] == "The Grid" and int(e["level"]) == lv, "the Grid reads %s" % str(e.get("boss", {})))
	_check(s._sig.is_empty() and s.order_block("archive").begins_with("Rebuild the library") == false, "the read left the Grid on its site, or the Archive shut")
	s.hp = s.max_hp()
	s.wounds = {}
	_check(s.deploy_order("grid") and s.mission != null and s.mission["signal"].get("order", "") == "grid" and s.mission.has("boss"), "the Grid would not set off: %s" % s.order_block("grid"))
	if s.mission != null:
		var reach0: int = s.reach
		var mm: Dictionary = s.mission
		mm["remaining"] = 0
		mm["cleared"] = true
		s._boss_down(mm, mm["t"])
		_check(mm["found"].any(func(x): return x.get("unique", "") in ["The Lineman's Lamp", "The Lineman's Tool Bag"]), "the Lineman's first kill dropped neither the Lamp nor the Tool Bag")      # two uniques now, one picked (24 Oct)
		s.extract_now()
		_check(s.mission == null and int(s.order_beaten.get("grid", 0)) == 1 and s.held_of("grid_key") == 1 and s.reach == reach0 and s._sig.is_empty(), "the Grid's win: beaten %d, key %d, reach %d from %d" % [int(s.order_beaten.get("grid", 0)), s.held_of("grid_key"), s.reach, reach0])
		_check(s.order_level("grid") == int(Data.pinnacle("grid")["again"]), "the Grid after a win isn't on its ladder (%d): %d" % [int(Data.pinnacle("grid")["again"]), s.order_level("grid")])
		s.reach = 140
		_check(s.order_level("grid") == int(Data.pinnacle("grid")["again"]), "the Grid after a win follows the reach: %d at reach 140" % s.order_level("grid"))     # a set ladder (Matt, 27 Oct)
		s.order_beaten["grid"] = 3
		_check(s.order_level("grid") == int(Data.pinnacle("grid")["again"]) + 2 * Data.ORDER_AGAIN_STEP, "the Grid's third win isn't two steps up its ladder: %d" % s.order_level("grid"))
		var last_county: int = Data.COUNTY.map(func(c): return int(c["level"])).max()
		_check(["grid", "archive", "mint"].all(func(k): return int(Data.pinnacle(k)["again"]) > last_county), "an order's ladder starts under the County's top (%d)" % last_county)
		s.order_beaten["grid"] = 1
		# on its ladder the head is softer, the first win as tuned (Matt, 27 Oct)
		var e_g: Dictionary = s.effective(int(Data.pinnacle("grid")["site"]))
		var h_again: Dictionary = s.order_head("grid", e_g)
		s.order_beaten["grid"] = 0
		var h_first: Dictionary = s.order_head("grid", e_g)
		s.order_beaten["grid"] = 1
		_check(is_equal_approx(float(h_again["hp"]) / float(h_first["hp"]), Data.ORDER_AGAIN_SOFT) and is_equal_approx(float(h_again["dps"]) / float(h_first["dps"]), Data.ORDER_AGAIN_SOFT), "the Grid's head on its ladder isn't x%.1f: HP %.0f against %.0f" % [Data.ORDER_AGAIN_SOFT, float(h_again["hp"]), float(h_first["hp"])])
		s.reach = 20
		_check(s.best_dig.is_empty() or str(s.best_dig.get("site", "")) != "The Grid", "the Grid's win set the best signal: %s" % str(s.best_dig))
	# the order's odds read leaves the host site's own read where it was (the review)
	var host: int = int(Data.pinnacle("grid")["site"])
	var cache0 = s._surv_cache.get(host, null)
	s.odds_frame_start()
	s.order_odds("grid")
	_check(s._surv_cache.get(host, null) == cache0 and s._sig.is_empty(), "the Grid's odds read moved the Services' own")
	# an order run saved mid-run and loaded finishes as the order's (the review)
	var depth0: int = int(s.depth[host])
	s.hp = s.max_hp()
	if s.deploy_order("grid"):
		var s3 = Sim.new()
		s3.load_dict(JSON.parse_string(JSON.stringify(s.to_dict())))
		_check(s3._sig.get("order", "") == "grid" and str(s3.mission["boss"].get("order", "")) == "grid", "a loaded order run lost its order")
		var b3: int = int(s3.order_beaten.get("grid", 0))
		var m3: Dictionary = s3.mission
		m3["remaining"] = 0
		m3["cleared"] = true
		s3._boss_down(m3, m3["t"])
		s3.extract_now()
		_check(int(s3.order_beaten.get("grid", 0)) == b3 + 1 and s3._sig.is_empty() and int(s3.depth[host]) == depth0 and not s3.boss_armed.get(host, false), "a loaded order run did not finish as the order's: beaten %d, depth %d" % [int(s3.order_beaten.get("grid", 0)), int(s3.depth[host])])
		# and one lost to a death: nothing beaten, the site put back
		var b4: int = int(s.order_beaten.get("grid", 0))
		s._kia()
		_check(int(s.order_beaten.get("grid", 0)) == b4 and s._sig.is_empty() and int(s.depth[host]) == depth0 and s.events.any(func(ev): return str(ev[1]) == Words.REBUILD["order_lost"] % "The Lineman"), "a death on the Grid: beaten %d, depth %d" % [int(s.order_beaten.get("grid", 0)), int(s.depth[host])])
	else:
		_check(false, "the fixture: the Grid would not set off again: %s" % s.order_block("grid"))
	# the shelf waits for the order's uniques
	_check(s.shelf_chase().any(func(x): return x["name"] == "The Issuer's Robes"), "the shelf does not wait for the order's uniques")
	# the screens: the town view and the order tab, shut and open, fit and show every chip
	var sim = main.sim
	var saved: Dictionary = sim.to_dict()
	var was: String = main.room
	sim.unlock_all()
	for z in range(Data.ZONES.size()):
		sim.bosses_beaten[z] = true
		for i in Data.ZONES[z]["tiers"]:
			sim.best_depth[i] = maxi(1, sim.best_depth[i])
	main.show_room(main.COMMS)
	sim.story_beat = 0
	main._radio._pick_view("town")
	main.refresh()
	_check(main._radio.view == "town" and main._radio._town.visible and main._radio._views.size() == 4, "the Radio's town view did not open")
	_check(main._radio._town.card("substation")["note"].text == "After Kev's story", "the town before Kev's story: '%s'" % main._radio._town.card("substation")["note"].text)
	_check_fit(main, "Radio town (shut)")
	sim.story_beat = Data.STORY_BEATS.size()
	sim.materials = {"copper_wire": 999, "cable_drums": 999, "paving": 999, "glass": 999, "ledgers": 999, "army_kit": 999, "fuses": 999}
	sim.key_items = {"grid_key": 3, "ledger_seal": 3, "fiat_note": 1}
	sim.rebuilt = {"substation": 4, "library": 2}
	main._radio._town._shown = ""
	main.refresh()
	var tw = main._radio._town
	for c in tw._cards:
		_check(c["chips"].shown() == int(c["items"]), "%s shows %d of its %d wants" % [c["key"], c["chips"].shown(), int(c["items"])])
	_check(tw.card("pumping")["button"].visible and tw.card("substation")["button"].text.contains("rank 5"), "the town's Rebuild buttons are off: '%s'" % tw.card("substation")["button"].text)
	_check_fit(main, "Radio town (built)")
	# the caps pass (19 Oct, Matt): every card's name whole and capitalised, its rank in sentence case, a name after
	# the dot capitalised ("Opens the Grid · The Lineman")
	for c in tw._cards:
		var nm_r: String = str(Data.rebuild(c["key"])["name"])
		_check(c["name"].text == nm_r, "a town card's name is cut: '%s' for '%s'" % [c["name"].text, nm_r])
		_check(c["rank"].text == "Not built" or c["rank"].text.begins_with("Rank "), "a town card's rank is not sentence case: '%s'" % c["rank"].text)
		var after_dot: String = c["opens"].text.get_slice(" · ", 1) if c["opens"].text.contains(" · ") else ""
		_check(after_dot == "" or after_dot.substr(0, 1) == after_dot.substr(0, 1).to_upper(), "a name after the dot is lower case: '%s'" % c["opens"].text)
		for ch in c["chips"].text_nodes():
			_check(ch.text == "" or ch.text.substr(0, 1) == ch.text.substr(0, 1).to_upper(), "a want's chip starts lower case: '%s'" % ch.text)
	tw.card("pumping")["button"].pressed.emit()
	_check(sim.rebuild_rank("pumping") == 1, "Rebuild on the card did not build")
	# with the runner out: the cards say so, and fit (the review)
	sim.hp = sim.max_hp()
	sim.deploy(3)
	tw._shown = ""
	main.refresh()
	_check(sim.mission == null or tw.card("bus_depot")["note"].text == "The runner is out", "the town with the runner out: '%s'" % tw.card("bus_depot")["note"].text)
	_check_fit(main, "Radio town (runner out)")
	if sim.mission != null:
		sim.extract_now()
		if sim.mission != null:
			sim._kia()
	main._radio._pick_view("air")
	main.show_room(main.MISSIONS)
	main.refresh()
	var od = main._missions._order
	var mv = main._missions._map
	_check(mv._order_labels["grid"].visible and not mv._order_labels["mint"].visible, "the Map's order pins: the Grid's %s, the Mint's %s (shut till its rebuild)" % [str(mv._order_labels["grid"].visible), str(mv._order_labels["mint"].visible)])
	main._missions.select_order("grid")
	main.refresh()
	_check(main._missions.order_key == "grid" and od.visible and od.col("grid")["panel"].visible and not od.col("archive")["panel"].visible and is_equal_approx(od.col("grid")["panel"].position.x, main._missions.CARD_X), "the Grid's pin did not show its card at the right")
	_check(od.col("grid")["button"].visible, "the Grid's card has no Go")
	# the order's places their own pictures (19 Oct): the card shows it, and its head's face and poses are there
	var UIv := load("res://scripts/ui/ui.gd")
	var PeopleV := load("res://scripts/ui/people.gd")
	for p in Data.PINNACLES:
		var own_t = UIv.place_texture(str(p["place"]))
		_check(str(p["art"]) == str(p["place"]) and od.col(str(p["key"]))["art"].texture == own_t, "%s's card doesn't show its own place" % p["place"])
		if own_t != null:
			_check(PeopleV.portrait(str(p["who"])) != null, "%s has a place but no face" % p["who"])
	_check_fit(main, "Map order")
	# an order's place in a shut zone (20 Oct, Matt: "the grid, archive and mint also need to be encoded"): its names
	# scrambled on the Map, its card and the Town's rebuild card, and its pin doesn't pick, as a shut zone's pins don't
	var beat2: bool = sim.bosses_beaten[2]
	sim.bosses_beaten[2] = false
	_check(not sim.zone_open(3) and sim.order_open("grid") and not sim.order_known("grid"), "the fixture couldn't shut the City under an open Grid")
	mv._shown = ""
	od._shown = ""
	main.refresh()
	var grid_p: Dictionary = Data.pinnacle("grid")
	_check(main._missions.order_key == "", "the Grid stayed picked with the City shut: the title '%s'" % main._missions._title.text)
